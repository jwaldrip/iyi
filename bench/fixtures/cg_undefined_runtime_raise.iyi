# A refusal fixture. Nothing defines `__crystal_raise` here, and the oracle is run
# with --prelude=empty, where it has no `__crystal_raise` to call. The port must
# refuse with the same text and status. Checked by
# bench/selfhost_codegen_exercise.sh (section 3b2), not compared as IR.
fun test_undefined_crystal_raise(n : Int32) : Int32
  __crystal_raise(n)
  n
end
