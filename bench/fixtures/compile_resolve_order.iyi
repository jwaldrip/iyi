import resolve_order_a
import resolve_order_b

# Both modules define ResolveOrderService#value. The later import in the load order
# is the definition the program runs, so this exits 20. Reversing the load order
# runs 10 instead.
fun main(argc : Int32, argv : Pointer(Pointer(UInt8))) : Int32
  s = ResolveOrderService.new
  s.value
end
