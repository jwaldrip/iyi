source_filename = "decimal_float.iyi"
target triple = "x86_64-unknown-linux-gnu"
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
; decimal floating-point constants are read and printed back as their bit patterns
@half = internal global double 5.000000e-01
@single = internal global float 1.500000e+00
@plain = internal global double 2.25
@negative = internal global double -1.500000e+00
define external iyicc double @one_and_a_half() {
entry:
  ret double 1.500000e+00
}
