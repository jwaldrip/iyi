source_filename = "llvm_float.iyi"
target triple = "x86_64-unknown-linux-gnu"
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
; LLVM writes a float constant as the double of the same value: each is read as the float's own 32 bits
@lowest = internal global float 0xC7EFFFFFE0000000
@one_and_a_half = internal global float 0x3FF8000000000000
@infinite = internal global float 0x7FF0000000000000
@not_a_number = internal global float 0x7FF8000000000000
@smallest = internal global float 0x36A0000000000000
@own_form = internal global float 0x3fc00000
@double_kept = internal global double 0xC7EFFFFFE0000000
define external iyicc float @four() {
entry:
  %sum = fadd float 0x3FF8000000000000, 0x4004000000000000
  ret float %sum
}
