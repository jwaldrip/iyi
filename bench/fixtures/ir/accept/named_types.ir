source_filename = "named_types.iyi"
target triple = "x86_64-unknown-linux-gnu"
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
; A named type is written only when the module mentions it: LLVM writes a module that way, and the
; lowering's text is compared with LLVM's. The first two are mentioned by nothing.
%Unused = type { i32, i8 }
%UnusedOpaque = type opaque
%Nested = type { i64 }
%ByGlobal = type { i32, %Nested }
%ByInitializer = type { i32 }
%ByAttribute = type { i64, i64, i64 }
%ByParameter = type { i64, i64, i64 }
%ByGep = type { i8, i64 }
%ByAlloca = type { i16 }
@held = internal global %ByGlobal zeroinitializer
@pointer = internal global ptr getelementptr inbounds (%ByInitializer, ptr @held, i64 0, i32 0)
declare external void @fill(sret(%ByAttribute) ptr, i64)
define internal i64 @walk(byval(%ByParameter) ptr %p) {
entry:
  %slot = alloca %ByAlloca, align 2
  %field = getelementptr %ByGep, ptr %p, i64 0, i32 1
  %value = load i64, ptr %field, align 8
  ret i64 %value
}
