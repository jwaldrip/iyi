; iyi-ir 1
; expect: cc-lowered
source_filename = "bad"
target triple = "x86_64-unknown-linux-gnu"
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
%Big = type { i64, i64, i64 }
declare external i64 @sumbig(%Big)
define i64 @main(ptr %p) {
entry:
  %b = load %Big, ptr %p, align 8
  %r = call i64 (%Big) @sumbig(%Big %b)
  ret i64 %r
}
