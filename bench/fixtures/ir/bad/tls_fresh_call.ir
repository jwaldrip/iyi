; iyi-ir 1
; expect: tls-fresh
module "bad"
target triple = "x86_64-unknown-linux-gnu"
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
@tls = external thread_local(localexec) global i32
declare external iyicc i32 @g()
define internal iyicc i32 @f() {
entry:
  %a = threadlocaladdr ptr @tls
  %c = call iyicc i32 () @g()
  %v = load i32, ptr %a, align 4
  ret i32 %v
}

