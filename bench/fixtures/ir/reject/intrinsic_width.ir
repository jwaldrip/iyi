; iyi-ir 1
; reject: unknown intrinsic
source_filename = "reject"
target triple = "x86_64-unknown-linux-gnu"
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
define internal iyicc i32 @f(i32 %a) {
entry:
  %r = intrinsic llvm.sadd.with.overflow.i7(i32 %a, i32 %a)
  ret i32 0
}

