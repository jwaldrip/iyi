; iyi-ir 1
source_filename = "unwind"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
declare external i32 @putchar(i32)

declare external i32 @never_named(ptr)

define internal iyicc i32 @work() {
entry:
  %0 = call i32 (i32) @putchar(i32 101)
  br label %invoke_out
invoke_out:
  br label %exit
exit:
  %1 = phi i32 [ 7, label %invoke_out ]
  %2 = call i32 (i32) @putchar(i32 100)
  ret i32 %1
}

define internal iyicc i32 @joined() {
entry:
  %0 = call i32 (i32) @putchar(i32 97)
  br label %ok
ok:
  br label %join
join:
  %1 = phi i32 [ %0, label %ok ]
  ret i32 %1
}

