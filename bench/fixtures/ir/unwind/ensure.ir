; iyi-ir 1
source_filename = "unwind"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
declare external i32 @putchar(i32)

declare external i32 @personality(...)

declare external void @reraise(ptr)

declare external i32 @never_named(ptr)

define internal iyicc i32 @work() personality @personality {
entry:
  %0 = invoke i32 (i32) @putchar(i32 101) to label %invoke_out unwind label %rescue
invoke_out:
  br label %exit
rescue:
  %1 = landingpad { ptr, i32 } personality ptr @personality cleanup
  %2 = extractvalue { ptr, i32 } %1, 0
  %3 = call i32 (i32) @putchar(i32 100)
  call void (ptr) @reraise(ptr %2)
  unreachable
exit:
  %4 = phi i32 [ 7, label %invoke_out ]
  %5 = call i32 (i32) @putchar(i32 100)
  ret i32 %4
}

define internal iyicc i32 @joined() personality @personality {
entry:
  %0 = invoke i32 (i32) @putchar(i32 97) to label %ok unwind label %pad
ok:
  br label %join
pad:
  %1 = landingpad { ptr, i32 } personality ptr @personality cleanup
  br label %join
join:
  %2 = phi i32 [ %0, label %ok ], [ 0, label %pad ]
  ret i32 %2
}

define internal iyicc i32 @shared(i1 %c) personality @personality {
entry:
  br i1 %c, label %a, label %next
a:
  %0 = invoke i32 (i32) @putchar(i32 98) to label %next unwind label %pad
pad:
  %1 = landingpad { ptr, i32 } personality ptr @personality cleanup
  unreachable
next:
  ret i32 1
}

define internal iyicc i32 @twice() personality @personality {
entry:
  %0 = invoke i32 (i32) @putchar(i32 99) to label %invoke_out unwind label %rescue
invoke_out:
  %1 = invoke i32 (i32) @putchar(i32 100) to label %invoke_out1 unwind label %rescue
invoke_out1:
  ret i32 %1
rescue:
  %2 = landingpad { ptr, i32 } personality ptr @personality cleanup
  unreachable
}

define internal iyicc i32 @phi_first() personality @personality {
entry:
  %0 = invoke i32 (i32) @putchar(i32 102) to label %after unwind label %pad
after:
  %1 = phi i32 [ %0, label %entry ]
  ret i32 %1
pad:
  %2 = landingpad { ptr, i32 } personality ptr @personality cleanup
  unreachable
}

