; iyi-ir 1
source_filename = "pad_reachable"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
declare external i32 @personality(...)

define internal iyicc void @f() personality @personality {
entry:
  br label %pad
pad:
  %0 = landingpad { ptr, i32 } personality ptr @personality cleanup
  ret void
}

