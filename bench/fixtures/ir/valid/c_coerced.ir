; iyi-ir 1
source_filename = "c_coerced"
target triple = "x86_64-unknown-linux-gnu"
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
%Big = type { i64, i64, i64 }
declare external void @fill(sret(%Big) ptr, i64)

define internal [2 x i64] @mkpair(i64 %a, i64 %b) {
entry:
  %x = insertvalue [2 x i64] zeroinitializer, i64 %a, 0
  %y = insertvalue [2 x i64] %x, i64 %b, 1
  ret [2 x i64] %y
}

define internal i64 @addpair([2 x i64] %p) {
entry:
  %a = extractvalue [2 x i64] %p, 0
  %b = extractvalue [2 x i64] %p, 1
  %s = add i64 %a, %b
  ret i64 %s
}

define internal { i64, i64 } @mkliteral(i64 %a) {
entry:
  %x = insertvalue { i64, i64 } zeroinitializer, i64 %a, 0
  ret { i64, i64 } %x
}

define internal [4 x float] @mkhfa(float %a, float %b) {
entry:
  %x = insertvalue [4 x float] zeroinitializer, float %a, 0
  %y = insertvalue [4 x float] %x, float %b, 1
  ret [4 x float] %y
}

define internal i64 @sumbig(byval(%Big) ptr %p) {
entry:
  %f = getelementptr %Big, ptr %p, i64 0, i32 2
  %v = load i64, ptr %f, align 8
  ret i64 %v
}

define internal void @fillbig(sret(%Big) ptr %out, i64 %v) {
entry:
  %p = getelementptr %Big, ptr %out, i64 0, i32 0
  store i64 %v, ptr %p, align 8
  ret void
}

define internal iyicc %Big @mkbig(i64 %v) {
entry:
  %x = insertvalue %Big zeroinitializer, i64 %v, 0
  ret %Big %x
}

define external i32 @main() {
entry:
  %pair = call [2 x i64] (i64, i64) @mkpair(i64 3, i64 4)
  %psum = call i64 ([2 x i64]) @addpair([2 x i64] %pair)
  %lit = call { i64, i64 } (i64) @mkliteral(i64 5)
  %hfa = call [4 x float] (float, float) @mkhfa(float 0x3fc00000, float 0x40200000)
  %buf = alloca %Big, align 8
  call void (ptr, i64) @fillbig(sret(%Big) ptr %buf, i64 9)
  %sum = call i64 (ptr) @sumbig(byval(%Big) ptr %buf)
  %big = call iyicc %Big (i64) @mkbig(i64 %psum)
  %r = trunc i64 %sum to i32
  ret i32 %r
}

