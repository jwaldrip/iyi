  %84 = intrinsic llvm.cttz.i32(i32 2, i1 true)
  %85 = intrinsic llvm.cttz.i64(i64 2, i1 true)
  %86 = intrinsic llvm.cttz.i128(i128 2, i1 true)
  %87 = intrinsic llvm.bswap.i16(i16 2)
  %88 = intrinsic llvm.bswap.i32(i32 2)
  %89 = intrinsic llvm.bswap.i64(i64 2)
  %90 = intrinsic llvm.bswap.i128(i128 2)
  %91 = intrinsic llvm.fshl.i8(i8 2, i8 2, i8 2)
  %92 = intrinsic llvm.fshl.i16(i16 2, i16 2, i16 2)
  %93 = intrinsic llvm.fshl.i32(i32 2, i32 2, i32 2)
