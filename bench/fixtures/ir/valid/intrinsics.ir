; iyi-ir 1
source_filename = "intrinsics"
target triple = "x86_64-unknown-linux-gnu"
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
define external iyicc void @every(ptr %p) {
entry:
  intrinsic llvm.memcpy.p0.p0.i8(ptr %p, ptr %p, i8 2, i1 true)
  intrinsic llvm.memcpy.p0.p0.i16(ptr %p, ptr %p, i16 2, i1 true)
  intrinsic llvm.memcpy.p0.p0.i32(ptr %p, ptr %p, i32 2, i1 true)
