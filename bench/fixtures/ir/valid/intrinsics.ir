  %95 = intrinsic llvm.fshl.i128(i128 2, i128 2, i128 2)
  %96 = intrinsic llvm.fshr.i8(i8 2, i8 2, i8 2)
  %97 = intrinsic llvm.fshr.i16(i16 2, i16 2, i16 2)
  %98 = intrinsic llvm.fshr.i32(i32 2, i32 2, i32 2)
  %99 = intrinsic llvm.fshr.i64(i64 2, i64 2, i64 2)
  %100 = intrinsic llvm.fshr.i128(i128 2, i128 2, i128 2)
