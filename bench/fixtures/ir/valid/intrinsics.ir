  %14 = intrinsic llvm.ssub.with.overflow.i128(i128 2, i128 2)
  %15 = intrinsic llvm.usub.with.overflow.i8(i8 2, i8 2)
  %16 = intrinsic llvm.usub.with.overflow.i16(i16 2, i16 2)
  %17 = intrinsic llvm.usub.with.overflow.i32(i32 2, i32 2)
  %18 = intrinsic llvm.usub.with.overflow.i64(i64 2, i64 2)
  %19 = intrinsic llvm.usub.with.overflow.i128(i128 2, i128 2)
  %20 = intrinsic llvm.smul.with.overflow.i8(i8 2, i8 2)
  %21 = intrinsic llvm.smul.with.overflow.i16(i16 2, i16 2)
  %22 = intrinsic llvm.smul.with.overflow.i32(i32 2, i32 2)
  %23 = intrinsic llvm.smul.with.overflow.i64(i64 2, i64 2)
  %24 = intrinsic llvm.smul.with.overflow.i128(i128 2, i128 2)
  %25 = intrinsic llvm.umul.with.overflow.i8(i8 2, i8 2)
