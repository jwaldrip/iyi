  %1 = intrinsic llvm.sadd.with.overflow.i16(i16 2, i16 2)
  %2 = intrinsic llvm.sadd.with.overflow.i32(i32 2, i32 2)
  %3 = intrinsic llvm.sadd.with.overflow.i64(i64 2, i64 2)
  %4 = intrinsic llvm.sadd.with.overflow.i128(i128 2, i128 2)
  %5 = intrinsic llvm.uadd.with.overflow.i8(i8 2, i8 2)
  %6 = intrinsic llvm.uadd.with.overflow.i16(i16 2, i16 2)
  %7 = intrinsic llvm.uadd.with.overflow.i32(i32 2, i32 2)
  %8 = intrinsic llvm.uadd.with.overflow.i64(i64 2, i64 2)
