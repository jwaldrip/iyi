  %28 = intrinsic llvm.umul.with.overflow.i64(i64 2, i64 2)
  %29 = intrinsic llvm.umul.with.overflow.i128(i128 2, i128 2)
  %30 = intrinsic llvm.sqrt.f32(float 0x3fc00000)
  %31 = intrinsic llvm.sqrt.f64(double 0x3ff8000000000000)
  %32 = intrinsic llvm.fabs.f32(float 0x3fc00000)
  %33 = intrinsic llvm.fabs.f64(double 0x3ff8000000000000)
  %34 = intrinsic llvm.sin.f32(float 0x3fc00000)
