  %74 = intrinsic llvm.ctpop.i32(i32 2)
  %75 = intrinsic llvm.ctpop.i64(i64 2)
  %76 = intrinsic llvm.ctpop.i128(i128 2)
  %77 = intrinsic llvm.ctlz.i8(i8 2, i1 true)
