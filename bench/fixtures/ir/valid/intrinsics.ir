  %48 = intrinsic llvm.pow.f32(float 0x3fc00000, float 0x3fc00000)
  %49 = intrinsic llvm.pow.f64(double 0x3ff8000000000000, double 0x3ff8000000000000)
  %50 = intrinsic llvm.powi.f32.i32(float 0x3fc00000, i32 2)
  %51 = intrinsic llvm.powi.f64.i32(double 0x3ff8000000000000, i32 2)
  %52 = intrinsic llvm.floor.f32(float 0x3fc00000)
  %53 = intrinsic llvm.floor.f64(double 0x3ff8000000000000)
  %54 = intrinsic llvm.ceil.f32(float 0x3fc00000)
  %55 = intrinsic llvm.ceil.f64(double 0x3ff8000000000000)
