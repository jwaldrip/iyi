lib LibC
  fun exit(status : Int32) : NoReturn
end

# An exhaustive `case ... in` over a plain enum (S6), run with a value outside its members. Hosted replaces the
# case's Unreachable else with a call to `raise` with the message "Unhandled case: enum value outside of defined enum
# members" (cleanup_transformer.cr:341-359). This program defines `raise` itself, so the prelude-empty oracle has a
# target for that call: the status is 9 when the replacement is taken. The enum defines the comparisons its member
# patterns use (the empty prelude does not provide them).

def raise(message : String) : NoReturn
  LibC.exit(9)
end

enum Level
  Debug
  Info

  def ==(other : Level) : Bool
    value == other.value
  end

  def ===(other : Level) : Bool
    value == other.value
  end
end

def code(l : Level) : Int32
  case l
  in Level::Debug then 1
  in Level::Info  then 2
  end
end

LibC.exit(code(Level.new(7)))
