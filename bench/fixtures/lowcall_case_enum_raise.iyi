# An exhaustive `case ... in` over a plain enum (S6), run with a value outside its members. Hosted replaces the
# case's Unreachable else with `raise "Unhandled case: enum value outside of defined enum members"`
# (cleanup_transformer.cr:341-359), because `Level.new(7)` can produce a value no branch covers. The program prints
# the first label, then raises, so its status and stdout are what the gate compares.

enum Level
  Debug
  Info
end

def label(l : Level) : String
  case l
  in Level::Debug then "quiet"
  in Level::Info  then "ordinary"
  end
end

puts label(Level::Info)
puts label(Level.new(7))
puts "not reached"
