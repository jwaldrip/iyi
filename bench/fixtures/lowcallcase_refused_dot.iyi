# An exhaustive `case ... in` with a `.foo?` pattern (S6): the pattern stays refused by name in the semantic pass
# (hosted exhaustiveness_checker.cr EnumMemberNamePattern).

enum Level
  Debug
  Info
end

def label(l : Level) : String
  case l
  in .debug? then "quiet"
  in .info?  then "ordinary"
  end
end

puts label(Level::Info)
