lib LibC
  fun exit(status : Int32) : NoReturn
end

# An exhaustive `case ... in` with a `.foo?` pattern (S6): the pattern stays refused by name in the semantic pass
# (hosted exhaustiveness_checker.cr EnumMemberNamePattern).

enum Level
  Debug
  Info
end

def label(l : Level) : Int32
  case l
  in .debug? then 1
  in .info?  then 2
  end
end

LibC.exit(label(Level::Info))
