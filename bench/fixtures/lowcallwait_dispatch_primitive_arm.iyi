lib LibC
  fun exit(status : Int32) : NoReturn
end

def pick(x : Int32) : Int32 | Nil
  x > 3 ? 42 : nil
end

# A primitive arm reached by an implicit dispatch has no self to pass. It is refused by
# name, never with the BUG raise (call.iyi codegen_dispatch). Hosted cannot compile it
# either, so this fixture is only ever lowered by the port.
class K
  @[Primitive(:unchecked_convert)]
  def self.one(value : Int32) : Int32
  end

  def self.one(value : Nil) : Int32
    7
  end

  def self.g(b : Int32 | Nil) : Int32
    one(b)
  end
end

LibC.exit(K.g(pick(4)))
