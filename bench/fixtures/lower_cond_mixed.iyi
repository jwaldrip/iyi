@[Unsafe("calls C exit to report mixed-union truthiness")]
lib LibC
  fun exit(status : Int32) : NoReturn
end

alias Choice = Int32 | Bool | Nil | Pointer(Int32)

def truth(value : Choice) : Int32
  value ? 1 : 0
end

def choose(index : Int32, pointer : Pointer(Int32)) : Choice
  if index == 0
    nil
  elsif index == 1
    false
  elsif index == 2
    nil.as(Pointer(Int32))
  elsif index == 3
    0
  elsif index == 4
    true
  else
    pointer
  end
end

slot = 42
pointer = pointerof(slot)
result = truth(choose(0, pointer))
result = result &+ truth(choose(1, pointer))
result = result &+ truth(choose(2, pointer))
result = result &+ truth(choose(3, pointer))
result = result &+ truth(choose(4, pointer))
result = result &+ truth(choose(5, pointer))
LibC.exit(result &* 14)
