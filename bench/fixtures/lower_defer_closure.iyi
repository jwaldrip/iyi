lib LibC
  fun malloc(size : UInt64) : Void*
  fun free(ptr : Void*) : Nil
  fun exit(status : Int32) : NoReturn
end

def deferred(flag : Bool) : Int32
  value = 11
  defer { value = value &+ 1 }
  i = 0
  while i < 1000
    ptr = LibC.malloc(64_u64)
    LibC.free(ptr)
    i = i &+ 1
  end
  return value if flag
  value
end

LibC.exit(deferred(true) &- 11)
