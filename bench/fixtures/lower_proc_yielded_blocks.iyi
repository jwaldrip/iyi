@[Unsafe("reports proc control-flow failures through the process exit status")]
lib LibC
  fun exit(status : Int32) : NoReturn
end

def once(value : Int32, &)
  yield value
end

def twice(value : Int32, &)
  first = yield value
  second = yield(value &+ 1)
  first &+ second
end

def keep_int(&block : Int32 -> Int32) : Proc(Int32, Int32)
  block
end

def keep_nil(&block : Bool -> Nil) : Proc(Bool, Nil)
  block
end

def keep_any(&block : Int32 -> U) : Proc(Int32, U) forall U
  block
end

def captured_reader : Proc(Int32)
  value = 40
  -> {
    first = once(2) { |value| value &+ 5 }
    second = once(3) { |value| value &+ 6 }
    value &+ first &+ second
  }
end

def captured_counter : Proc(Int32)
  count = 10
  -> {
    twice(1) { |delta| count = count &+ delta }
    count
  }
end

class Counter
  def initialize(@value : Int32)
  end

  def reader : Proc(Int32)
    -> { once(3) { |delta| @value &+ delta } }
  end
end

plain = ->(value : Int32) {
  result = once(5) do |value|
    local = value &+ 3
    once(local) { |inner| inner &+ 1 }
  end
  result &+ value
}
LibC.exit(1) unless plain.call(7) == 16
LibC.exit(2) unless captured_reader.call == 56
counter = captured_counter
LibC.exit(3) unless counter.call == 13
LibC.exit(4) unless counter.call == 16
LibC.exit(5) unless Counter.new(20).reader.call == 23

next_value = -> { twice(1) { |value| next value &+ 4 } }
LibC.exit(6) unless next_value.call == 11
break_value = -> { twice(1) { |value| break value &+ 5 } }
LibC.exit(7) unless break_value.call == 6
return_value = -> {
  once(4) { |value| return value &+ 3 }
  99
}
LibC.exit(8) unless return_value.call == 7
only_return = -> { once(4) { |value| return value &+ 3 } }
LibC.exit(9) unless only_return.call == 7

flag = 0
nil_writer = -> { once(1) { |value| flag = flag &+ value }; nil }
result = nil_writer.call
LibC.exit(10) unless flag == 1
LibC.exit(11) if result

calls = 0
saved_next = keep_int do |value|
  calls = calls &+ 1
  next value &+ 10 if value == 1
  value &+ 20
end
LibC.exit(12) unless saved_next.call(1) == 11
LibC.exit(13) unless saved_next.call(2) == 22 && calls == 2

saved_only_next = keep_int { |value| next value &+ 30 }
LibC.exit(14) unless saved_only_next.call(1) == 31

saved_nil = keep_nil do |stop|
  next if stop
  calls = calls &+ 1
  nil
end
saved_nil.call(true)
LibC.exit(15) unless calls == 2
saved_nil.call(false)
LibC.exit(16) unless calls == 3

saved_loop = keep_int do |limit|
  value = 0
  while value < limit
    value = value &+ 1
    next
  end
  next value
end
LibC.exit(17) unless saved_loop.call(3) == 3

cleanups = 0
saved_defer = keep_int do |value|
  defer {cleanups = cleanups &+ 1}
  next value &+ 1
end
LibC.exit(18) unless saved_defer.call(4) == 5 && cleanups == 1

loop_f = keep_int { |value| value }
i = 0
while i < 2
  loop_f = keep_int { |value| next value &+ 1 if value > 0; value }
  i = i &+ 1
end
LibC.exit(19) unless loop_f.call(1) == 2 && i == 2

nested_f = once(2) { |outer| keep_int { |value| next value &+ 7 } }
LibC.exit(20) unless nested_f.call(1) == 8

any_f = keep_any { |value| next value &+ 1 }
LibC.exit(21) unless any_f.call(1) == 2

halt = -> { once(3) { |value| code = LibC.exit(value &- 3) } }
halt.call
