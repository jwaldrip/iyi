# The `headed` census (gc_layouts.cr 204-223):
# - a plain class is headless (0)
# - a class whose virtual type was made (`@b : Base` with a subclass) and its subclass are headed (1)
# - members of a ReferenceUnionType (`Alpha | Beta`) and their subclasses are headed (1)
# - a leaf class in a NilableType (`Leaf?`) is headless (0)
# - members of a NilableReferenceUnionType (`Gamma | Delta | Nil`) are headed (1)
class Plain
end

class Base
end

class Sub < Base
end

class Holder
  @b : Base

  def initialize(@b : Base)
  end
end

class Alpha
end

class AlphaSub < Alpha
end

class Beta
end

class Leaf
end

class Gamma
end

class Delta
end

