# Program-defined allocator selection for pointerful Pointer(Pointer(UInt8)).malloc:
# both __crystal_malloc64 and __crystal_malloc_atomic64 are defined; Pointer(UInt8) has
# inner pointers so Pointer(Pointer(UInt8)).malloc must call __crystal_malloc64 (exit 5).
lib LibC
  fun exit(status : Int32) : NoReturn
end

fun __crystal_malloc64(size : UInt64) : Void*
  LibC.exit(5)
end

fun __crystal_malloc_atomic64(size : UInt64) : Void*
  LibC.exit(3)
end

Pointer(Pointer(UInt8)).malloc(2_u64)
LibC.exit(7)
