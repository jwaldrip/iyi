lib LibC
  fun exit(status : Int32) : NoReturn
  fun getpid : Int32
end

def pick_named_member(tuple : NamedTuple(first: Int64, second: Int32)) : Int32
  tuple[:second]
end

if LibC.getpid == -1
  tuple = uninitialized NamedTuple(first: Int64, second: Int32)
  LibC.exit(pick_named_member(tuple))
end
LibC.exit(0)
