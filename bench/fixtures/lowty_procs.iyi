# type: Proc(Int32, Nil)
# type: Proc(Tuple(Int32, Bool), Int32)
# type: Proc(Int32, Tuple(Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64))
