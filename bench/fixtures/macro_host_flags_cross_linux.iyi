# target: x86_64-unknown-linux-gnu
# The host's flags against a Linux target: on a darwin host the two sets differ, so an answer taken from the
# target's set is caught there.
macro host_probe
  {% if flag?(:darwin) %}target-darwin{% end %}
  {% if flag?(:linux) %}target-linux{% end %}
  {% if host_flag?(:darwin) %}host-darwin{% end %}
  {% if host_flag?(:linux) %}host-linux{% end %}
  {% if host_flag?(:aarch64) %}host-aarch64{% end %}
  {% if host_flag?(:x86_64) %}host-x86_64{% end %}
end

host_probe
