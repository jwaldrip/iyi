; iyi-ir 1
module "asm_explicit"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
declare external i32 @printf(ptr, ...)
@fmt = private constant [5 x i8] c"%ld\0A\00"

; The input is pinned to x3 and the template reads it there; the output takes any free register.
define internal i64 @addfive(i64 %x) {
entry:
  %r = call i64 (i64) asm "add $0, x3, #5", "=r,{x3}"(i64 %x)
  ret i64 %r
}

define i32 @main() {
entry:
  %v = call i64 (i64) @addfive(i64 10)
  %p = call i32 (ptr, ...) @printf(ptr @fmt, i64 %v)
  ret i32 0
}
