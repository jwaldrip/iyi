; iyi-ir 1
module "asm_naked_addimm"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
declare external i32 @printf(ptr, ...)
@fmt = private constant [5 x i8] c"%ld\0A\00"

; The argument arrives in x0, where the template adds seven to it and returns. Nothing is bound for it.
define internal i64 @addimm(i64 %a) [naked] {
entry:
  call void () asm sideeffect "add x0, x0, #7; ret", ""()
  unreachable
}

define i32 @main() {
entry:
  %v = call i64 (i64) @addimm(i64 30)
  %r = call i32 (ptr, ...) @printf(ptr @fmt, i64 %v)
  ret i32 0
}
