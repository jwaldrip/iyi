; iyi-ir 1
module "asm_naked_const"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
declare external i32 @printf(ptr, ...)
@fmt = private constant [5 x i8] c"%ld\0A\00"

; A naked function: its body is the template alone, with no prologue, epilogue or frame. The native assembler reads
; `;` as a statement separator; the hosted compiler's LLVM does not, so its twin separates the lines with newlines.
define internal i64 @const42() [naked] {
entry:
  call void () asm sideeffect "mov x0, #42; ret", ""()
  unreachable
}

define i32 @main() {
entry:
  %v = call i64 () @const42()
  %r = call i32 (ptr, ...) @printf(ptr @fmt, i64 %v)
  ret i32 0
}
