; iyi-ir 1
module "asm_naked_pair"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
declare external i32 @printf(ptr, ...)
@fmt = private constant [5 x i8] c"%ld\0A\00"

; The context-switch shape: a pre-indexed stp saves the callee-saved pair, a post-indexed ldp restores it.
define internal i64 @pair(i64 %a, i64 %b) [naked] {
entry:
  call void () asm sideeffect "stp x19, x20, [sp, #-16]!; mov x19, x0; mov x20, x1; add x0, x19, #1; ldp x19, x20, [sp], #16; ret", "~{x19},~{x20}"()
  unreachable
}

define i32 @main() {
entry:
  %v = call i64 (i64, i64) @pair(i64 3, i64 4)
  %r = call i32 (ptr, ...) @printf(ptr @fmt, i64 %v)
  ret i32 0
}
