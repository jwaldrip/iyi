; iyi-ir 1
module "asm_yield"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
declare external i32 @printf(ptr, ...)
@fmt = private constant [5 x i8] c"%ld\0A\00"

; An inline asm statement in an ordinary function: no operands, no result.
define internal void @spin() {
entry:
  call void () asm sideeffect "yield", ""()
  ret void
}

define i32 @main() {
entry:
  call void () @spin()
  %r = call i32 (ptr, ...) @printf(ptr @fmt, i64 1)
  ret i32 0
}
