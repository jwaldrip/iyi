; iyi-ir 1
module "atomics"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
declare external i32 @printf(ptr, ...)
@fmt = private constant [17 x i8] c"%ld %ld %ld %d %ld\0A\00"
@cell = internal global i64 5, align 8
@flag = internal global i32 0, align 4

define i32 @main() {
entry:
  %a = load i64, ptr @cell, align 8 atomic acquire
  %b = add i64 %a, 2
  store i64 %b, ptr @cell, align 8 atomic release
  %c = load i64, ptr @cell, align 8 atomic seq_cst
  %old = atomicrmw add ptr @cell, i64 3, align 8 seq_cst
  %now = load i64, ptr @cell, align 8 atomic monotonic
  %pair = cmpxchg ptr @cell, i64 %now, i64 40, align 8 seq_cst acquire
  %prev = extractvalue { i64, i1 } %pair, 0
  %won = extractvalue { i64, i1 } %pair, 1
  %wonw = zext i1 %won to i32
  store i32 1, ptr @flag, align 4 atomic release
  fence seq_cst
  fence acquire
  %fin = load i64, ptr @cell, align 8 atomic acquire
  %r = call i32 (ptr, ...) @printf(ptr @fmt, i64 %c, i64 %old, i64 %prev, i32 %wonw, i64 %fin)
  ret i32 0
}
