; iyi-ir 1
module "jump_dense"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
declare external i32 @printf(ptr, ...)
@fmt = private constant [13 x i8] c"%d %d %d %d\0A\00"

; Ten dense cases, 0 through 9: a jump table of ten entries. The default takes -1 and 10.
define internal i32 @dense(i32 %n) {
entry:
  switch i32 %n, label %dflt [ i32 0, label %c0, i32 1, label %c1, i32 2, label %c2, i32 3, label %c3, i32 4, label %c4, i32 5, label %c5, i32 6, label %c6, i32 7, label %c7, i32 8, label %c8, i32 9, label %c9 ]
c0:
  ret i32 100
c1:
  ret i32 111
c2:
  ret i32 122
c3:
  ret i32 133
c4:
  ret i32 144
c5:
  ret i32 155
c6:
  ret i32 166
c7:
  ret i32 177
c8:
  ret i32 188
c9:
  ret i32 199
dflt:
  ret i32 -1
}

define i32 @main() {
entry:
  %a = call i32 (i32) @dense(i32 3)
  %b = call i32 (i32) @dense(i32 9)
  %c = call i32 (i32) @dense(i32 10)
  %d = call i32 (i32) @dense(i32 -1)
  %r = call i32 (ptr, ...) @printf(ptr @fmt, i32 %a, i32 %b, i32 %c, i32 %d)
  ret i32 0
}
