; iyi-ir 1
module "jump_holes"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
declare external i32 @printf(ptr, ...)
@fmt = private constant [16 x i8] c"%d %d %d %d %d\0A\00"

; Eight cases over the range 0 through 10: 2, 5 and 7 are holes, and their table entries take the default.
define internal i32 @holes(i32 %n) {
entry:
  switch i32 %n, label %dflt [ i32 0, label %h0, i32 1, label %h1, i32 3, label %h3, i32 4, label %h4, i32 6, label %h6, i32 8, label %h8, i32 9, label %h9, i32 10, label %h10 ]
h0:
  ret i32 1000
h1:
  ret i32 1001
h3:
  ret i32 1003
h4:
  ret i32 1004
h6:
  ret i32 1006
h8:
  ret i32 1008
h9:
  ret i32 1009
h10:
  ret i32 1010
dflt:
  ret i32 -7
}

define i32 @main() {
entry:
  %a = call i32 (i32) @holes(i32 2)
  %b = call i32 (i32) @holes(i32 3)
  %c = call i32 (i32) @holes(i32 7)
  %d = call i32 (i32) @holes(i32 10)
  %e = call i32 (i32) @holes(i32 11)
  %r = call i32 (ptr, ...) @printf(ptr @fmt, i32 %a, i32 %b, i32 %c, i32 %d, i32 %e)
  ret i32 0
}
