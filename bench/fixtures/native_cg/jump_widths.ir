; iyi-ir 1
module "jump_widths"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
declare external i32 @printf(ptr, ...)
@fmt = private constant [4 x i8] c"%d\0A\00"

; i8, signed range starting below zero: -5 through 4.
define internal i32 @neg8(i8 %n) {
entry:
  switch i8 %n, label %dflt [ i8 -5, label %p0, i8 -4, label %p1, i8 -3, label %p2, i8 -2, label %p3, i8 -1, label %p4, i8 0, label %p5, i8 1, label %p6, i8 2, label %p7, i8 3, label %p8, i8 4, label %p9 ]
p0:
  ret i32 450
p1:
  ret i32 460
p2:
  ret i32 470
p3:
  ret i32 480
p4:
  ret i32 490
p5:
  ret i32 500
p6:
  ret i32 510
p7:
  ret i32 520
p8:
  ret i32 530
p9:
  ret i32 540
dflt:
  ret i32 -1
}

; i16, signed range starting below zero: -4 through 5.
define internal i32 @neg16(i16 %n) {
entry:
  switch i16 %n, label %dflt [ i16 -4, label %q0, i16 -3, label %q1, i16 -2, label %q2, i16 -1, label %q3, i16 0, label %q4, i16 1, label %q5, i16 2, label %q6, i16 3, label %q7, i16 4, label %q8, i16 5, label %q9 ]
q0:
  ret i32 560
q1:
  ret i32 570
q2:
  ret i32 580
q3:
  ret i32 590
q4:
  ret i32 600
q5:
  ret i32 610
q6:
  ret i32 620
q7:
  ret i32 630
q8:
  ret i32 640
q9:
  ret i32 650
dflt:
  ret i32 -2
}

; i64, a range starting far from zero: 2^33 through 2^33 + 5.
define internal i32 @far64(i64 %n) {
entry:
  switch i64 %n, label %dflt [ i64 8589934592, label %r0, i64 8589934593, label %r1, i64 8589934594, label %r2, i64 8589934595, label %r3, i64 8589934596, label %r4, i64 8589934597, label %r5 ]
r0:
  ret i32 1
r1:
  ret i32 8
r2:
  ret i32 15
r3:
  ret i32 22
r4:
  ret i32 29
r5:
  ret i32 36
dflt:
  ret i32 -3
}

; i32, signed range starting below zero: -3 through 6.
define internal i32 @neg32(i32 %n) {
entry:
  switch i32 %n, label %dflt [ i32 -3, label %s0, i32 -2, label %s1, i32 -1, label %s2, i32 0, label %s3, i32 1, label %s4, i32 2, label %s5, i32 3, label %s6, i32 4, label %s7, i32 5, label %s8, i32 6, label %s9 ]
s0:
  ret i32 91
s1:
  ret i32 94
s2:
  ret i32 97
s3:
  ret i32 100
s4:
  ret i32 103
s5:
  ret i32 106
s6:
  ret i32 109
s7:
  ret i32 112
s8:
  ret i32 115
s9:
  ret i32 118
dflt:
  ret i32 -4
}

define i32 @main() {
entry:
  %a0 = call i32 (i8) @neg8(i8 -5)
  %a1 = call i32 (i8) @neg8(i8 4)
  %a2 = call i32 (i8) @neg8(i8 5)
  %a3 = call i32 (i8) @neg8(i8 -6)
  %b0 = call i32 (i16) @neg16(i16 -4)
  %b1 = call i32 (i16) @neg16(i16 5)
  %b2 = call i32 (i16) @neg16(i16 6)
  %c0 = call i32 (i64) @far64(i64 8589934592)
  %c1 = call i32 (i64) @far64(i64 8589934597)
  %c2 = call i32 (i64) @far64(i64 8589934591)
  %d0 = call i32 (i32) @neg32(i32 -3)
  %d1 = call i32 (i32) @neg32(i32 6)
  %d2 = call i32 (i32) @neg32(i32 7)
  %r0 = call i32 (ptr, ...) @printf(ptr @fmt, i32 %a0)
  %r1 = call i32 (ptr, ...) @printf(ptr @fmt, i32 %a1)
  %r2 = call i32 (ptr, ...) @printf(ptr @fmt, i32 %a2)
  %r3 = call i32 (ptr, ...) @printf(ptr @fmt, i32 %a3)
  %r4 = call i32 (ptr, ...) @printf(ptr @fmt, i32 %b0)
  %r5 = call i32 (ptr, ...) @printf(ptr @fmt, i32 %b1)
  %r6 = call i32 (ptr, ...) @printf(ptr @fmt, i32 %b2)
  %r7 = call i32 (ptr, ...) @printf(ptr @fmt, i32 %c0)
  %r8 = call i32 (ptr, ...) @printf(ptr @fmt, i32 %c1)
  %r9 = call i32 (ptr, ...) @printf(ptr @fmt, i32 %c2)
  %s0 = call i32 (ptr, ...) @printf(ptr @fmt, i32 %d0)
  %s1 = call i32 (ptr, ...) @printf(ptr @fmt, i32 %d1)
  %s2 = call i32 (ptr, ...) @printf(ptr @fmt, i32 %d2)
  ret i32 0
}
