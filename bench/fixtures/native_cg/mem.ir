; iyi-ir 1
module "mem"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
declare external i32 @printf(ptr, ...)
declare external void @__iyi_native_memcpy(ptr, ptr, i64)
declare external void @__iyi_native_memmove(ptr, ptr, i64)
declare external void @__iyi_native_memset(ptr, i64, i64)
@fmt = private constant [19 x i8] c"%d %d %d %d %d %d\0A\00"

; Inline for lengths up to 64 bytes: a copy, an overlapping move (the source bytes are read before any is written),
; and a set. Beyond 64 bytes the helpers are called (rt_stub.c stands in for the runtime-helpers slice). The big
; array's two results are read back after the helper calls.
define i32 @main() {
entry:
  %src = alloca [16 x i8], align 8
  %dst = alloca [16 x i8], align 8
  %big = alloca [100 x i8], align 8
  %big2 = alloca [100 x i8], align 8
  store i64 1, ptr %src, align 8
  %s8 = getelementptr i8, ptr %src, i64 8
  store i64 2, ptr %s8, align 8
  intrinsic llvm.memcpy.p0.p0.i64(ptr %dst, ptr %src, i64 16, i1 false)
  %d4 = getelementptr i8, ptr %dst, i64 4
  intrinsic llvm.memmove.p0.p0.i64(ptr %d4, ptr %dst, i64 8, i1 false)
  %d12 = getelementptr i8, ptr %dst, i64 12
  intrinsic llvm.memset.p0.i64(ptr %d12, i8 9, i64 4, i1 false)
  %v0 = load i8, ptr %dst, align 1
  %p4 = getelementptr i8, ptr %dst, i64 4
  %v4 = load i8, ptr %p4, align 1
  %p8 = getelementptr i8, ptr %dst, i64 8
  %v8 = load i8, ptr %p8, align 1
  %v12 = load i8, ptr %d12, align 1
  intrinsic llvm.memset.p0.i64(ptr %big, i8 5, i64 100, i1 false)
  store i8 7, ptr %big, align 1
  %big1 = getelementptr i8, ptr %big, i64 1
  intrinsic llvm.memmove.p0.p0.i64(ptr %big1, ptr %big, i64 99, i1 false)
  %b2p = getelementptr i8, ptr %big, i64 2
  %vb2 = load i8, ptr %b2p, align 1
  intrinsic llvm.memcpy.p0.p0.i64(ptr %big2, ptr %big, i64 100, i1 false)
  %c1p = getelementptr i8, ptr %big2, i64 1
  %vc1 = load i8, ptr %c1p, align 1
  %w0 = zext i8 %v0 to i32
  %w4 = zext i8 %v4 to i32
  %w8 = zext i8 %v8 to i32
  %w12 = zext i8 %v12 to i32
  %wb2 = zext i8 %vb2 to i32
  %wc1 = zext i8 %vc1 to i32
  %r = call i32 (ptr, ...) @printf(ptr @fmt, i32 %w0, i32 %w4, i32 %w8, i32 %w12, i32 %wb2, i32 %wc1)
  ret i32 0
}
