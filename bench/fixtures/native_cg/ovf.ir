; iyi-ir 1
module "ovf"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
declare external i32 @printf(ptr, ...)
@fmt = private constant [43 x i8] c"%d %d %d %d %d %d %d %d %d %d %d %d %d %d\0A\00"

; The overflow family at 8, 16, 32 and 64 bits, signed and unsigned. Each result is its value and its flag.
define i32 @main() {
entry:
  %s1 = intrinsic llvm.sadd.with.overflow.i8(i8 100, i8 100)
  %v1 = extractvalue { i8, i1 } %s1, 0
  %f1 = extractvalue { i8, i1 } %s1, 1
  %v1w = sext i8 %v1 to i32
  %f1w = zext i1 %f1 to i32
  %s2 = intrinsic llvm.uadd.with.overflow.i8(i8 -56, i8 100)
  %v2 = extractvalue { i8, i1 } %s2, 0
  %f2 = extractvalue { i8, i1 } %s2, 1
  %v2w = zext i8 %v2 to i32
  %f2w = zext i1 %f2 to i32
  %s3 = intrinsic llvm.ssub.with.overflow.i16(i16 30000, i16 -10000)
  %v3 = extractvalue { i16, i1 } %s3, 0
  %f3 = extractvalue { i16, i1 } %s3, 1
  %v3w = sext i16 %v3 to i32
  %f3w = zext i1 %f3 to i32
  %s4 = intrinsic llvm.usub.with.overflow.i16(i16 5, i16 7)
  %v4 = extractvalue { i16, i1 } %s4, 0
  %f4 = extractvalue { i16, i1 } %s4, 1
  %v4w = sext i16 %v4 to i32
  %f4w = zext i1 %f4 to i32
  %s5 = intrinsic llvm.smul.with.overflow.i32(i32 70000, i32 70000)
  %v5 = extractvalue { i32, i1 } %s5, 0
  %f5 = extractvalue { i32, i1 } %s5, 1
  %f5w = zext i1 %f5 to i32
  %s6 = intrinsic llvm.umul.with.overflow.i64(i64 4294967296, i64 4294967296)
  %v6 = extractvalue { i64, i1 } %s6, 0
  %f6 = extractvalue { i64, i1 } %s6, 1
  %v6t = trunc i64 %v6 to i32
  %f6w = zext i1 %f6 to i32
  %s7 = intrinsic llvm.sadd.with.overflow.i32(i32 5, i32 7)
  %v7 = extractvalue { i32, i1 } %s7, 0
  %f7 = extractvalue { i32, i1 } %s7, 1
  %f7w = zext i1 %f7 to i32
  %r = call i32 (ptr, ...) @printf(ptr @fmt, i32 %v1w, i32 %f1w, i32 %v2w, i32 %f2w, i32 %v3w, i32 %f3w, i32 %v4w, i32 %f4w, i32 %v5, i32 %f5w, i32 %v6t, i32 %f6w, i32 %v7, i32 %f7w)
  ret i32 0
}
