; iyi-ir 1
module "structs"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
declare external i32 @printf(ptr, ...)
@fmt = private constant [9 x i8] c"%d %d %d\0A\00"
%Big = type { i64, i64, i64 }

; A homogeneous floating-point aggregate of two doubles: d0 and d1, both ways.
define internal [2 x double] @mkhfa2(double %a, double %b) {
entry:
  %x = insertvalue [2 x double] zeroinitializer, double %a, 0
  %y = insertvalue [2 x double] %x, double %b, 1
  ret [2 x double] %y
}

define internal double @sumhfa2([2 x double] %h) {
entry:
  %a = extractvalue [2 x double] %h, 0
  %b = extractvalue [2 x double] %h, 1
  %s = fadd double %a, %b
  ret double %s
}

; A literal struct of two words, returned in x0 and x1.
define internal { i64, i64 } @mkpair2(i64 %a, i64 %b) {
entry:
  %x = insertvalue { i64, i64 } zeroinitializer, i64 %a, 0
  %y = insertvalue { i64, i64 } %x, i64 %b, 1
  ret { i64, i64 } %y
}

define internal i64 @pairsum2({ i64, i64 } %p) {
entry:
  %a = extractvalue { i64, i64 } %p, 0
  %b = extractvalue { i64, i64 } %p, 1
  %s = add i64 %a, %b
  ret i64 %s
}

; A structure over sixteen bytes: passed by reference, the caller's copy.
define internal i64 @sumbig(ptr %p) {
entry:
  %f0 = getelementptr %Big, ptr %p, i64 0, i32 0
  %f1 = getelementptr %Big, ptr %p, i64 0, i32 1
  %f2 = getelementptr %Big, ptr %p, i64 0, i32 2
  %v0 = load i64, ptr %f0, align 8
  %v1 = load i64, ptr %f1, align 8
  %v2 = load i64, ptr %f2, align 8
  %s1 = add i64 %v0, %v1
  %s2 = add i64 %s1, %v2
  ret i64 %s2
}

define i32 @main() {
entry:
  %h = call [2 x double] (double, double) @mkhfa2(double 0x3ff8000000000000, double 0x4004000000000000)
  %hs = call double ([2 x double]) @sumhfa2([2 x double] %h)
  %hi = fptosi double %hs to i32
  %p = call { i64, i64 } (i64, i64) @mkpair2(i64 7, i64 8)
  %ps = call i64 ({ i64, i64 }) @pairsum2({ i64, i64 } %p)
  %pi = trunc i64 %ps to i32
  %big = alloca %Big, align 8
  %g0 = getelementptr %Big, ptr %big, i64 0, i32 0
  store i64 1, ptr %g0, align 8
  %g1 = getelementptr %Big, ptr %big, i64 0, i32 1
  store i64 2, ptr %g1, align 8
  %g2 = getelementptr %Big, ptr %big, i64 0, i32 2
  store i64 3, ptr %g2, align 8
  %bs = call i64 (ptr) @sumbig(ptr %big)
  %bi = trunc i64 %bs to i32
  %r = call i32 (ptr, ...) @printf(ptr @fmt, i32 %hi, i32 %pi, i32 %bi)
  ret i32 0
}
