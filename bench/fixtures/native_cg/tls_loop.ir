; iyi-ir 1
module "tls_loop"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
declare external i32 @printf(ptr, ...)
@fmt = private constant [9 x i8] c"%ld %ld\0A\00"
@acc = internal thread_local(localexec) global i64 0, align 8

; Adds `by` to the thread-local and returns the new total: it touches the same variable the loop reads.
define internal i64 @bump(i64 %by) {
entry:
  %p = threadlocaladdr ptr @acc
  %v = load i64, ptr %p, align 8
  %n = add i64 %v, %by
  store i64 %n, ptr %p, align 8
  ret i64 %n
}

define i32 @main() {
entry:
  br label %loop
loop:
  %i = phi i64 [ 0, label %entry ], [ %inext, label %loop ]
  %total = phi i64 [ 0, label %entry ], [ %tnext, label %loop ]
  %p = threadlocaladdr ptr @acc
  %seen = load i64, ptr %p, align 8
  %bumped = call i64 (i64) @bump(i64 %i)
  %tnext = add i64 %total, %seen
  %inext = add i64 %i, 1
  %more = icmp slt i64 %inext, 5
  br i1 %more, label %loop, label %exit
exit:
  %q = threadlocaladdr ptr @acc
  %final = load i64, ptr %q, align 8
  %r = call i32 (ptr, ...) @printf(ptr @fmt, i64 %tnext, i64 %final)
  ret i32 0
}
