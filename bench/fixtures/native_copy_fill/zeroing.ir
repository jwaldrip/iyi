; iyi-ir 1
module "zeroing"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
declare external i32 @printf(ptr, ...)
@fmt = private constant [5 x i8] c"%ld\0A\00"
%Point = type { i64, i64 }

define internal void @clear_point(ptr %cell) {
entry:
  intrinsic llvm.memset.p0.i64(ptr %cell, i8 0, i64 ptrtoint (ptr getelementptr (%Point, ptr null, i32 1) to i64), i1 false)
  ret void
}

define i32 @main() {
entry:
  %cell = alloca %Point, align 8
  %second = getelementptr %Point, ptr %cell, i64 0, i32 1
  store i64 7, ptr %cell, align 8
  store i64 9, ptr %second, align 8
  call void (ptr) @clear_point(ptr %cell)
  %a = load i64, ptr %cell, align 8
  %b = load i64, ptr %second, align 8
  %pa = call i32 (ptr, ...) @printf(ptr @fmt, i64 %a)
  %pb = call i32 (ptr, ...) @printf(ptr @fmt, i64 %b)
  ret i32 0
}
