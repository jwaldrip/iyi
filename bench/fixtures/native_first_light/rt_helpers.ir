@fmt_show = private constant [11 x i8] c"%lld %llu\0A\00"
@fmt_byte = private constant [4 x i8] c"%d \00"
@fmt_nl = private constant [2 x i8] c"\0A\00"

; Prints the high half of a 128-bit value as a signed number and the low half as unsigned.
define internal void @show(i128 %x) {
entry:
  %h = lshr i128 %x, 64
  %hi = trunc i128 %h to i64
  %lo = trunc i128 %x to i64
  %r = call i32 (ptr, ...) @printf(ptr @fmt_show, i64 %hi, i64 %lo)
  ret void
}

; Prints the 32 bytes at p, one per field, then a newline.
