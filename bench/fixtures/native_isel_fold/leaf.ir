  %s8 = add i64 %s7, %v9
  %s9 = add i64 %s8, %v10
  %s10 = add i64 %s9, %v11
  %s11 = add i64 %s10, %v12
  %s12 = add i64 %s11, %v13
  %s13 = add i64 %s12, %v14
  %s14 = add i64 %s13, %v15
  %s15 = add i64 %s14, %v16
  %s16 = add i64 %s15, %v17
  %s17 = add i64 %s16, %v18
  %s18 = add i64 %s17, %v19
  %s19 = add i64 %s18, %v20
  ret i64 %s19
}
define internal i64 @nonleaf(i64 %x) {
entry:
  %v = call i64 (i64) @plain_leaf(i64 %x)
  ret i64 %v
}
define i32 @main() {
entry:
  %a = call i64 (i64) @plain_leaf(i64 5)
  %b = call i64 () @slot_caller()
  %c = call i64 (i64, i64, i64, i64, i64, i64, i64, i64, i64) @stack_arg(i64 1, i64 2, i64 3, i64 4, i64 5, i64 6, i64 7, i64 8, i64 9)
  %d = call i64 (i64) @asm_leaf(i64 7)
  %e = call i64 (i64) @saved_leaf(i64 1)
  %f = call i64 (i64) @nonleaf(i64 5)
  %p0 = call i32 (ptr, ...) @printf(ptr @fmt, i64 %a)
  %p1 = call i32 (ptr, ...) @printf(ptr @fmt, i64 %b)
  %p2 = call i32 (ptr, ...) @printf(ptr @fmt, i64 %c)
  %p3 = call i32 (ptr, ...) @printf(ptr @fmt, i64 %d)
  %p4 = call i32 (ptr, ...) @printf(ptr @fmt, i64 %e)
  %p5 = call i32 (ptr, ...) @printf(ptr @fmt, i64 %f)
