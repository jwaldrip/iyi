  %v7 = add i64 %x, 7
  %v8 = add i64 %x, 8
  %v9 = add i64 %x, 9
  %v10 = add i64 %x, 10
  %v11 = add i64 %x, 11
  %v12 = add i64 %x, 12
  %v13 = add i64 %x, 13
  %v14 = add i64 %x, 14
  %v15 = add i64 %x, 15
  %v16 = add i64 %x, 16
  %v17 = add i64 %x, 17
  %v18 = add i64 %x, 18
  %v19 = add i64 %x, 19
  %v20 = add i64 %x, 20
  %s1 = add i64 %v1, %v2
  %s2 = add i64 %s1, %v3
  %s3 = add i64 %s2, %v4
  %s4 = add i64 %s3, %v5
  %s5 = add i64 %s4, %v6
