define internal i64 @plain_leaf(i64 %x) {
entry:
  %r = add i64 %x, 3
  ret i64 %r
}
define internal i64 @slot_leaf(i64 %x) {
entry:
  %slot = alloca i64, align 8
  store i64 %x, ptr %slot, align 8
  %v = load i64, ptr %slot, align 8
  ret i64 %v
}
define internal i64 @slot_caller() {
entry:
  %guard = alloca i64, align 8
  store i64 777, ptr %guard, align 8
  %v = call i64 (i64) @slot_leaf(i64 31)
  %saved = load i64, ptr %guard, align 8
  %sum = add i64 %saved, %v
  ret i64 %sum
}
define internal i64 @stack_arg(i64 %a0, i64 %a1, i64 %a2, i64 %a3, i64 %a4, i64 %a5, i64 %a6, i64 %a7, i64 %a8) {
entry:
  ret i64 %a8
}
define internal i64 @asm_leaf(i64 %x) {
entry:
  call void () asm sideeffect "nop", ""()
  %r = add i64 %x, 1
  ret i64 %r
}
define internal i64 @saved_leaf(i64 %x) {
