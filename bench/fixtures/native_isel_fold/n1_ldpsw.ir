; iyi-ir 1
module "n1_ldpsw"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
declare external i32 @printf(ptr, ...)
@fmt = private constant [5 x i8] c"%ld\0A\00"

define internal i64 @load_signed_pair(ptr %base) {
entry:
  %p = getelementptr i32, ptr %base, i64 1
  %a = load i32, ptr %base, align 4
  %b = load i32, ptr %p, align 4
  %x = sext i32 %a to i64
  %y = sext i32 %b to i64
  %r = add i64 %x, %y
  ret i64 %r
}
define internal i64 @load_64_pair(ptr %base) {
entry:
  %p = getelementptr i64, ptr %base, i64 1
  %a = load i64, ptr %base, align 8
  %b = load i64, ptr %p, align 8
  %r = sub i64 %a, %b
  ret i64 %r
}
define i32 @main() {
entry:
  %narrow = alloca [2 x i32], align 4
  %wide = alloca [2 x i64], align 8
  %n1 = getelementptr i32, ptr %narrow, i64 1
  %w1 = getelementptr i64, ptr %wide, i64 1
  store i32 -2147483648, ptr %narrow, align 4
  store i32 -1, ptr %n1, align 4
  store i64 -9, ptr %wide, align 8
  store i64 4, ptr %w1, align 8
  %a = call i64 (ptr) @load_signed_pair(ptr %narrow)
  %b = call i64 (ptr) @load_64_pair(ptr %wide)
  %p0 = call i32 (ptr, ...) @printf(ptr @fmt, i64 %a)
  %p1 = call i32 (ptr, ...) @printf(ptr @fmt, i64 %b)
  ret i32 0
}
