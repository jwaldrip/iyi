; iyi-ir 1
module "n1_sign_branch"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
declare external i32 @printf(ptr, ...)
@fmt = private constant [5 x i8] c"%ld\0A\00"

define internal i64 @slt_zero(i64 %x) {
entry:
  %c = icmp slt i64 %x, 0
  br i1 %c, label %yes, label %no
yes:
  ret i64 1
no:
  ret i64 0
}
define internal i64 @sge_zero(i64 %x) {
entry:
  %c = icmp sge i64 %x, 0
  br i1 %c, label %yes, label %no
yes:
  ret i64 1
no:
  ret i64 0
}
define internal i64 @sgt_negative_one(i64 %x) {
entry:
  %c = icmp sgt i64 %x, -1
  br i1 %c, label %yes, label %no
yes:
  ret i64 1
no:
  ret i64 0
}
define internal i64 @sle_negative_one(i64 %x) {
entry:
  %c = icmp sle i64 %x, -1
  br i1 %c, label %yes, label %no
yes:
  ret i64 1
no:
  ret i64 0
}
define internal i64 @slt_narrow(i8 %x) {
entry:
  %c = icmp slt i8 %x, 0
  br i1 %c, label %yes, label %no
yes:
  ret i64 1
no:
  ret i64 0
}
define internal i64 @shared_sign(i64 %x) {
entry:
  %c = icmp slt i64 %x, 0
  %v = zext i1 %c to i64
  br i1 %c, label %yes, label %no
yes:
  ret i64 %v
no:
  ret i64 3
}
define i32 @main() {
entry:
  %a = call i64 (i64) @slt_zero(i64 2147483648)
  %b = call i64 (i64) @slt_zero(i64 -4294967296)
  %c = call i64 (i64) @sge_zero(i64 0)
  %d = call i64 (i64) @sge_zero(i64 -1)
  %e = call i64 (i64) @sgt_negative_one(i64 0)
  %f = call i64 (i64) @sgt_negative_one(i64 -1)
  %g = call i64 (i64) @sle_negative_one(i64 -1)
  %h = call i64 (i64) @sle_negative_one(i64 0)
  %i = call i64 (i8) @slt_narrow(i8 -1)
  %j = call i64 (i8) @slt_narrow(i8 127)
  %k = call i64 (i64) @shared_sign(i64 -1)
  %l = call i64 (i64) @shared_sign(i64 0)
  %p0 = call i32 (ptr, ...) @printf(ptr @fmt, i64 %a)
  %p1 = call i32 (ptr, ...) @printf(ptr @fmt, i64 %b)
  %p2 = call i32 (ptr, ...) @printf(ptr @fmt, i64 %c)
  %p3 = call i32 (ptr, ...) @printf(ptr @fmt, i64 %d)
  %p4 = call i32 (ptr, ...) @printf(ptr @fmt, i64 %e)
  %p5 = call i32 (ptr, ...) @printf(ptr @fmt, i64 %f)
  %p6 = call i32 (ptr, ...) @printf(ptr @fmt, i64 %g)
  %p7 = call i32 (ptr, ...) @printf(ptr @fmt, i64 %h)
  %p8 = call i32 (ptr, ...) @printf(ptr @fmt, i64 %i)
  %p9 = call i32 (ptr, ...) @printf(ptr @fmt, i64 %j)
  %p10 = call i32 (ptr, ...) @printf(ptr @fmt, i64 %k)
  %p11 = call i32 (ptr, ...) @printf(ptr @fmt, i64 %l)
  ret i32 0
}
