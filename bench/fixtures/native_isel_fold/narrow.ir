; iyi-ir 1
module "narrow"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
declare external i32 @printf(ptr, ...)
@fmt = private constant [5 x i8] c"%ld\0A\00"

define internal i64 @sadd32(i32 %a, i32 %b) {
entry:
  %pair = intrinsic llvm.sadd.with.overflow.i32(i32 %a, i32 %b)
  %value = extractvalue { i32, i1 } %pair, 0
  %flag = extractvalue { i32, i1 } %pair, 1
  br i1 %flag, label %overflow, label %ok
overflow:
  ret i64 -131
ok:
  %wide = sext i32 %value to i64
  ret i64 %wide
}

define internal i64 @ssub32(i32 %a, i32 %b) {
entry:
  %pair = intrinsic llvm.ssub.with.overflow.i32(i32 %a, i32 %b)
  %value = extractvalue { i32, i1 } %pair, 0
  %flag = extractvalue { i32, i1 } %pair, 1
  br i1 %flag, label %overflow, label %ok
overflow:
  ret i64 -132
ok:
  %wide = sext i32 %value to i64
  ret i64 %wide
}

define internal i64 @wrap_add32(i32 %a, i32 %b) {
entry:
  %r = add i32 %a, %b
  %wide = sext i32 %r to i64
  ret i64 %wide
}

define internal i64 @wrap_sub32(i32 %a, i32 %b) {
entry:
  %r = sub i32 %a, %b
  %wide = sext i32 %r to i64
  ret i64 %wide
}

define internal i64 @nsw_add32(i32 %a, i32 %b) {
entry:
  %r = add nsw i32 %a, %b
  %wide = sext i32 %r to i64
  ret i64 %wide
}

define internal i64 @nsw_mul16(i16 %a, i16 %b) {
entry:
  %r = mul nsw i16 %a, %b
  %wide = sext i16 %r to i64
  ret i64 %wide
}

define internal i64 @nsw_sub8(i8 %a, i8 %b) {
entry:
  %r = sub nsw i8 %a, %b
  %wide = sext i8 %r to i64
  ret i64 %wide
}

define internal i64 @udiv3(i32 %a) {
entry:
  %q = udiv i32 %a, 3
  %wide = zext i32 %q to i64
  ret i64 %wide
}

define internal i64 @udiv1(i32 %a) {
entry:
  %q = udiv i32 %a, 1
  %wide = sext i32 %q to i64
  ret i64 %wide
}

define internal i64 @urem7(i32 %a) {
entry:
  %r = urem i32 %a, 7
  %wide = zext i32 %r to i64
  ret i64 %wide
}

define i32 @main() {
entry:
  %p0 = call i64 (i32, i32) @sadd32(i32 2147483647, i32 1)
  %p1 = call i64 (i32, i32) @ssub32(i32 -2147483648, i32 1)
  %p2 = call i64 (i32, i32) @sadd32(i32 -5, i32 3)
  %p3 = call i64 (i32, i32) @sadd32(i32 2147483646, i32 1)
  %p4 = call i64 (i32, i32) @ssub32(i32 -2147483647, i32 1)
  %p5 = call i64 (i32, i32) @ssub32(i32 0, i32 -2147483648)
  %p6 = call i64 (i32, i32) @wrap_add32(i32 2147483647, i32 1)
  %p7 = call i64 (i32, i32) @wrap_sub32(i32 -2147483648, i32 1)
  %p8 = call i64 (i32, i32) @wrap_add32(i32 -1, i32 1)
  %p9 = call i64 (i32, i32) @nsw_add32(i32 -5, i32 3)
  %p10 = call i64 (i32, i32) @nsw_add32(i32 1000, i32 2000)
  %p11 = call i64 (i16, i16) @nsw_mul16(i16 300, i16 100)
  %p12 = call i64 (i16, i16) @nsw_mul16(i16 -200, i16 150)
  %p13 = call i64 (i8, i8) @nsw_sub8(i8 -100, i8 27)
  %p14 = call i64 (i8, i8) @nsw_sub8(i8 100, i8 -27)
  %p15 = call i64 (i32) @udiv3(i32 -1)
  %p16 = call i64 (i32) @udiv1(i32 -1)
  %p17 = call i64 (i32) @urem7(i32 -1)
  %p18 = call i64 (i32) @urem7(i32 10)
  %q0 = call i32 (ptr, ...) @printf(ptr @fmt, i64 %p0)
  %q1 = call i32 (ptr, ...) @printf(ptr @fmt, i64 %p1)
  %q2 = call i32 (ptr, ...) @printf(ptr @fmt, i64 %p2)
  %q3 = call i32 (ptr, ...) @printf(ptr @fmt, i64 %p3)
  %q4 = call i32 (ptr, ...) @printf(ptr @fmt, i64 %p4)
  %q5 = call i32 (ptr, ...) @printf(ptr @fmt, i64 %p5)
  %q6 = call i32 (ptr, ...) @printf(ptr @fmt, i64 %p6)
  %q7 = call i32 (ptr, ...) @printf(ptr @fmt, i64 %p7)
  %q8 = call i32 (ptr, ...) @printf(ptr @fmt, i64 %p8)
  %q9 = call i32 (ptr, ...) @printf(ptr @fmt, i64 %p9)
  %q10 = call i32 (ptr, ...) @printf(ptr @fmt, i64 %p10)
  %q11 = call i32 (ptr, ...) @printf(ptr @fmt, i64 %p11)
  %q12 = call i32 (ptr, ...) @printf(ptr @fmt, i64 %p12)
  %q13 = call i32 (ptr, ...) @printf(ptr @fmt, i64 %p13)
  %q14 = call i32 (ptr, ...) @printf(ptr @fmt, i64 %p14)
  %q15 = call i32 (ptr, ...) @printf(ptr @fmt, i64 %p15)
  %q16 = call i32 (ptr, ...) @printf(ptr @fmt, i64 %p16)
  %q17 = call i32 (ptr, ...) @printf(ptr @fmt, i64 %p17)
  %q18 = call i32 (ptr, ...) @printf(ptr @fmt, i64 %p18)
  ret i32 0
}
