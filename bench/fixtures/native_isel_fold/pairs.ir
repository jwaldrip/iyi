; iyi-ir 1
module "pairs"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
declare external i32 @printf(ptr, ...)
@fmt = private constant [5 x i8] c"%ld\0A\00"

define internal i64 @load_pair(ptr %base) {
entry:
  %p = getelementptr i64, ptr %base, i64 1
  %a = load i64, ptr %base, align 8
  %b = load i64, ptr %p, align 8
  %r = add i64 %a, %b
  ret i64 %r
}
define internal void @store_pair(ptr %base, i64 %a, i64 %b) {
entry:
  %p = getelementptr i64, ptr %base, i64 1
  store i64 %a, ptr %base, align 8
  store i64 %b, ptr %p, align 8
  ret void
}
define internal i64 @interleaved(ptr %base) {
entry:
  %a = load i64, ptr %base, align 8
  %p = getelementptr i64, ptr %base, i64 1
  %b = load i64, ptr %p, align 8
  %r = add i64 %a, %b
  ret i64 %r
}
define internal i64 @reverse_pair(ptr %base) {
entry:
  %p = getelementptr i64, ptr %base, i64 1
  %a = load i64, ptr %p, align 8
  %b = load i64, ptr %base, align 8
  %r = sub i64 %a, %b
  ret i64 %r
}
define internal i64 @load_gap(ptr %base) {
entry:
  %p = getelementptr i64, ptr %base, i64 2
  %a = load i64, ptr %base, align 8
  %b = load i64, ptr %p, align 8
  %r = add i64 %a, %b
  ret i64 %r
}
define internal i64 @different_bases(ptr %a, ptr %b) {
entry:
  %x = load i64, ptr %a, align 8
  %y = load i64, ptr %b, align 8
  %r = add i64 %x, %y
  ret i64 %r
}
define internal i64 @narrow_pair(ptr %base) {
entry:
  %p = getelementptr i32, ptr %base, i64 1
  %a = load i32, ptr %base, align 4
  %b = load i32, ptr %p, align 4
  %x = sext i32 %a to i64
  %y = sext i32 %b to i64
  %r = add i64 %x, %y
  ret i64 %r
}
define internal i64 @float_pair(ptr %base) {
entry:
  %p = getelementptr double, ptr %base, i64 1
  %a = load double, ptr %base, align 8
  %b = load double, ptr %p, align 8
  %r = fadd double %a, %b
  %v = fptosi double %r to i64
  ret i64 %v
}
define i32 @main() {
entry:
  %values = alloca [4 x i64], align 8
  %narrow = alloca [2 x i32], align 4
  %floats = alloca [2 x double], align 8
  %p2 = getelementptr i64, ptr %values, i64 2
  %n1 = getelementptr i32, ptr %narrow, i64 1
  %f1 = getelementptr double, ptr %floats, i64 1
  call void (ptr, i64, i64) @store_pair(ptr %values, i64 5, i64 7)
  store i64 19, ptr %p2, align 8
  store i32 -2147483648, ptr %narrow, align 4
  store i32 -1, ptr %n1, align 4
  store double 2.000000e+00, ptr %floats, align 8
  store double 3.000000e+00, ptr %f1, align 8
  %a = call i64 (ptr) @load_pair(ptr %values)
  %b = call i64 (ptr) @interleaved(ptr %values)
  %c = call i64 (ptr) @reverse_pair(ptr %values)
  %d = call i64 (ptr) @load_gap(ptr %values)
  %e = call i64 (ptr, ptr) @different_bases(ptr %values, ptr %p2)
  %f = call i64 (ptr) @narrow_pair(ptr %narrow)
  %g = call i64 (ptr) @float_pair(ptr %floats)
  %p0 = call i32 (ptr, ...) @printf(ptr @fmt, i64 %a)
  %p1 = call i32 (ptr, ...) @printf(ptr @fmt, i64 %b)
  %p3 = call i32 (ptr, ...) @printf(ptr @fmt, i64 %c)
  %p4 = call i32 (ptr, ...) @printf(ptr @fmt, i64 %d)
  %p5 = call i32 (ptr, ...) @printf(ptr @fmt, i64 %e)
  %p6 = call i32 (ptr, ...) @printf(ptr @fmt, i64 %f)
  %p7 = call i32 (ptr, ...) @printf(ptr @fmt, i64 %g)
  ret i32 0
}
