module l1_contract

import compiler/native/mir::{MBlock, MFunction, MInst, MOp}
import compiler/native/mir_clean::{elide_fallthrough}
import compiler/native/aarch64/regs::{cond_eq, cond_ne}
import std/env::{ENV}

def ins(op : MOp) : MInst
  MInst.new(op.value.to_i32)
end

def require_case(ok : Bool, name : String) : Nil
  raise "L1 contract: #{name}" unless ok
end

def blocks(name : String, count : Int32) : MFunction
  fn = MFunction.new(name)
  i = 0
  while i < count
    fn.blocks << MBlock.new(i, "b#{i}")
    i = i + 1
  end
  fn
end

def branch(op : MOp, target : Int32) : MInst
  inst = ins(op)
  inst.target = target
  inst
end

def fallthrough_empty(enabled : Bool) : Nil
  fn = blocks("l1_fallthrough_empty", 4)
  fn.blocks[0].insts << branch(MOp::B, 3)
  fn.blocks[3].insts << ins(MOp::Ret)
  require_case(elide_fallthrough(fn) == (enabled ? 1 : 0), "fallthrough empty count")
  require_case(fn.blocks[0].insts.size == (enabled ? 0 : 1), "fallthrough empty")

  fn = blocks("l1_invert_empty", 5)
  cond = branch(MOp::Bcond, 3)
  cond.cond = cond_ne
  fn.blocks[0].insts << cond
  fn.blocks[0].insts << branch(MOp::B, 4)
  fn.blocks[3].insts << ins(MOp::Ret)
  fn.blocks[4].insts << ins(MOp::Ret)
  require_case(elide_fallthrough(fn) == (enabled ? 1 : 0), "invert empty count")
  require_case(cond.target == (enabled ? 4 : 3), "invert empty target")
  require_case(cond.cond == (enabled ? cond_eq : cond_ne), "invert empty condition")
  require_case(fn.blocks[0].insts.size == (enabled ? 1 : 2), "invert empty branch")
end

def branch_to_next(enabled : Bool) : Nil
  [MOp::Bcond, MOp::Cbz, MOp::Cbnz, MOp::Tbz, MOp::Tbnz].each do |op|
    fn = blocks("l1_branch_to_next", 4)
    fn.blocks[0].insts << branch(op, 3)
    fn.blocks[3].insts << ins(MOp::Ret)
    require_case(elide_fallthrough(fn) == (enabled ? 1 : 0), "conditional #{op}")
    require_case(fn.blocks[0].insts.size == (enabled ? 0 : 1), "conditional target #{op}")
  end
end

def nonempty_between : Nil
  [MOp::MovImm, MOp::BrTable, MOp::Label, MOp::InlineAsm].each do |op|
    fn = blocks("l1_nonempty_between", 3)
    fn.blocks[0].insts << branch(MOp::B, 2)
    fn.blocks[1].insts << ins(op)
    fn.blocks[2].insts << ins(MOp::Ret)
    require_case(elide_fallthrough(fn) == 0, "nonempty count #{op}")
    require_case(fn.blocks[0].insts.size == 1, "nonempty barrier #{op}")
  end
  [MOp::BrTable, MOp::AddrTable, MOp::Label, MOp::InlineAsm].each do |op|
    [MOp::B, MOp::Bcond].each do |branch_op|
      fn = blocks("l1_barrier_entry", 3)
      fn.blocks[0].insts << branch(branch_op, 1)
      fn.blocks[1].insts << ins(op)
      fn.blocks[2].insts << ins(MOp::Ret)
      require_case(elide_fallthrough(fn) == 0, "pseudo entry count #{op}")
      require_case(fn.blocks[0].insts.size == 1, "pseudo entry barrier #{op}")
    end
  end
end

enabled = ENV["IYI_NATIVE_MIR_CLEAN"]? != "0"
case Program.args[0]
when "fallthrough"
  fallthrough_empty(enabled)
when "branch"
  branch_to_next(enabled)
when "nonempty"
  nonempty_between
else
  raise "unknown L1 contract"
end
puts "L1 #{Program.args[0]} passed"
