module const_pressure

# Modular arithmetic keeps every value below one billion, so no operation overflows and the checksum is exact.
def step(x : Int64) : Int64
  (x * 1103515245_i64 + 12345_i64) % 1000000007_i64
end

def churn(n : Int64) : Int64
  a = 1_i64
  b = 2_i64
  c = 3_i64
  d = 4_i64
  e = 5_i64
  f = 6_i64
  g = 7_i64
  h = 8_i64
  i = 9_i64
  j = 10_i64
  k = 11_i64
  l = 12_i64
  m = 13_i64
  o = 14_i64
  p = 15_i64
  q = 16_i64
  count = 0_i64
  while count < n
    a = (step(a) + 636413622_i64) % 1000000007_i64
    b = (b * 3_i64 + a % 1000003_i64 + 265443576_i64) % 1000000007_i64
    c = (c + b % 999983_i64 + 40503_i64) % 1000000007_i64
    d = (d * 31_i64 + c + 123456789_i64) % 1000000007_i64
    e = (e + d % 65537_i64 + 99991_i64) % 1000000007_i64
    f = (f * 7_i64 + e % 524287_i64) % 1000000007_i64
    g = (g + f % 131071_i64 + 100000007_i64) % 1000000007_i64
    h = (h + g % 8191_i64 * 5_i64 + step(h)) % 1000000007_i64
    i = (i + h % 127_i64 + 777777_i64) % 1000000007_i64
    j = (j + i % 101_i64 + 333333333_i64) % 1000000007_i64
    k = (k + j % 97_i64 + 44444_i64) % 1000000007_i64
    l = (l + k % 89_i64 + 5555555_i64) % 1000000007_i64
    m = (m + l % 83_i64 + 66666666_i64) % 1000000007_i64
    o = (o + m % 79_i64 + 7777777_i64) % 1000000007_i64
    p = (p + o % 73_i64 + 88888888_i64) % 1000000007_i64
    q = (q + p % 71_i64 + 9999999_i64) % 1000000007_i64
    count = count + 1_i64
  end
  (a + b + c + d + e + f + g + h + i + j + k + l + m + o + p + q) % 1000000007_i64
end

puts churn(300_i64)
puts churn(7_i64)
