; iyi-ir 1
module "pointer_flag_fp"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
declare external i32 @printf(ptr, ...)
@fmt = private constant [5 x i8] c"%ld\0A\00"
@cells = internal global [2 x i64] zeroinitializer, align 8

define internal double @churn(double %a) {
entry:
  %r = fmul double %a, 0x4000000000000000
  ret double %r
}

; The address of an element is a pointer value. Its bits move into a floating-point register, which must not hold
; a pointer across the call to churn: the selector flags the value, and the collector's constraint is checked on it.
define i32 @main() {
entry:
  %g = getelementptr [2 x i64], ptr @cells, i64 0, i64 1
  %p = ptrtoint ptr %g to i64
  %d = bitcast i64 %p to double
  %c = call double (double) @churn(double 0x4000000000000000)
  %back = bitcast double %d to i64
  %same = icmp eq i64 %back, %p
  %ms = zext i1 %same to i64
  %cs = fptosi double %c to i64
  %p1 = call i32 (ptr, ...) @printf(ptr @fmt, i64 %ms)
  %p2 = call i32 (ptr, ...) @printf(ptr @fmt, i64 %cs)
  ret i32 0
}
