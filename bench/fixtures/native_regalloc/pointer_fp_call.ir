; iyi-ir 1
module "pointer_fp_call"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
declare external i32 @printf(ptr, ...)
@fmt = private constant [5 x i8] c"%ld\0A\00"
@cell = internal global i64 0, align 8

define internal double @churn(double %a) {
entry:
  %c1 = fmul double %a, 0x3ff0000000000000
  %c2 = fmul double %a, 0x4000000000000000
  %c3 = fmul double %a, 0x4008000000000000
  %c4 = fmul double %a, 0x4010000000000000
  %c5 = fmul double %a, 0x4014000000000000
  %c6 = fmul double %a, 0x4018000000000000
  %c7 = fmul double %a, 0x401c000000000000
  %c8 = fmul double %a, 0x4020000000000000
  %c9 = fmul double %a, 0x4022000000000000
  %c10 = fmul double %a, 0x4024000000000000
  %c11 = fmul double %a, 0x4026000000000000
  %c12 = fmul double %a, 0x4028000000000000
  %c13 = fmul double %a, 0x402a000000000000
  %c14 = fmul double %a, 0x402c000000000000
  %c15 = fmul double %a, 0x402e000000000000
  %c16 = fmul double %a, 0x4030000000000000
  %c17 = fmul double %a, 0x4031000000000000
  %c18 = fmul double %a, 0x4032000000000000
  %c19 = fmul double %a, 0x4033000000000000
  %c20 = fmul double %a, 0x4034000000000000
  %cs2 = fadd double %c1, %c2
  %cs3 = fadd double %cs2, %c3
  %cs4 = fadd double %cs3, %c4
  %cs5 = fadd double %cs4, %c5
  %cs6 = fadd double %cs5, %c6
  %cs7 = fadd double %cs6, %c7
  %cs8 = fadd double %cs7, %c8
  %cs9 = fadd double %cs8, %c9
  %cs10 = fadd double %cs9, %c10
  %cs11 = fadd double %cs10, %c11
  %cs12 = fadd double %cs11, %c12
  %cs13 = fadd double %cs12, %c13
  %cs14 = fadd double %cs13, %c14
  %cs15 = fadd double %cs14, %c15
  %cs16 = fadd double %cs15, %c16
  %cs17 = fadd double %cs16, %c17
  %cs18 = fadd double %cs17, %c18
  %cs19 = fadd double %cs18, %c19
  %cs20 = fadd double %cs19, %c20
  ret double %cs20
}

define i32 @main() {
entry:
  %p = ptrtoint ptr @cell to i64
  %d = bitcast i64 %p to double
  %c = call double (double) @churn(double 0x4000000000000000)
  %back = bitcast double %d to i64
  %same = icmp eq i64 %back, %p
  %ms = zext i1 %same to i64
  %cs = fptosi double %c to i64
  %p1 = call i32 (ptr, ...) @printf(ptr @fmt, i64 %ms)
  %p2 = call i32 (ptr, ...) @printf(ptr @fmt, i64 %cs)
  ret i32 0
}
