module pressure_fpr

import std/float

def fwork(x : Float64) : Float64
  f1 = x * 1.0
  f2 = x * 2.0
  f3 = x * 3.0
  f4 = x * 4.0
  f5 = x * 5.0
  f6 = x * 6.0
  f7 = x * 7.0
  f8 = x * 8.0
  f9 = x * 9.0
  f10 = x * 10.0
  f11 = x * 11.0
  f12 = x * 12.0
  f13 = x * 13.0
  f14 = x * 14.0
  f15 = x * 15.0
  f16 = x * 16.0
  f17 = x * 17.0
  f18 = x * 18.0
  f19 = x * 19.0
  f20 = x * 20.0
  f21 = x * 21.0
  f22 = x * 22.0
  f23 = x * 23.0
  f24 = x * 24.0
  f25 = x * 25.0
  f26 = x * 26.0
  f27 = x * 27.0
  f28 = x * 28.0
  f29 = x * 29.0
  f30 = x * 30.0
  f31 = x * 31.0
  f32 = x * 32.0
  f33 = x * 33.0
  f34 = x * 34.0
  f35 = x * 35.0
  f36 = x * 36.0
  s2 = f1 + f2
  s3 = s2 + f3
  s4 = s3 + f4
  s5 = s4 + f5
  s6 = s5 + f6
  s7 = s6 + f7
  s8 = s7 + f8
  s9 = s8 + f9
  s10 = s9 + f10
  s11 = s10 + f11
  s12 = s11 + f12
  s13 = s12 + f13
  s14 = s13 + f14
  s15 = s14 + f15
  s16 = s15 + f16
  s17 = s16 + f17
  s18 = s17 + f18
  s19 = s18 + f19
  s20 = s19 + f20
  s21 = s20 + f21
  s22 = s21 + f22
  s23 = s22 + f23
  s24 = s23 + f24
  s25 = s24 + f25
  s26 = s25 + f26
  s27 = s26 + f27
  s28 = s27 + f28
  s29 = s28 + f29
  s30 = s29 + f30
  s31 = s30 + f31
  s32 = s31 + f32
  s33 = s32 + f33
  s34 = s33 + f34
  s35 = s34 + f35
  s36 = s35 + f36
  s36
end

puts "#{fwork(2.0).to_i64}"
puts "#{fwork(-1.5).to_i64}"
