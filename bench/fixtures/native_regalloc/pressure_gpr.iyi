module pressure_gpr

def work(x : Int64) : Int64
  a1 = x + 1_i64
  a2 = x * 3_i64
  a3 = x + 5_i64
  a4 = x * 7_i64
  a5 = x + 11_i64
  a6 = x * 13_i64
  a7 = x + 17_i64
  a8 = x * 19_i64
  a9 = x + 23_i64
  a10 = x * 29_i64
  a11 = x + 31_i64
  a12 = x * 37_i64
  a13 = x + 41_i64
  a14 = x * 43_i64
  a15 = x + 47_i64
  a16 = x * 53_i64
  a17 = x + 59_i64
  a18 = x * 61_i64
  a19 = x + 67_i64
  a20 = x * 71_i64
  a21 = x + 2_i64
  a22 = x * 4_i64
  a23 = x + 6_i64
  a24 = x * 8_i64
  s2 = a1 + a2
  s3 = s2 + a3
  s4 = s3 + a4
  s5 = s4 + a5
  s6 = s5 + a6
  s7 = s6 + a7
  s8 = s7 + a8
  s9 = s8 + a9
  s10 = s9 + a10
  s11 = s10 + a11
  s12 = s11 + a12
  s13 = s12 + a13
  s14 = s13 + a14
  s15 = s14 + a15
  s16 = s15 + a16
  s17 = s16 + a17
  s18 = s17 + a18
  s19 = s18 + a19
  s20 = s19 + a20
  s21 = s20 + a21
  s22 = s21 + a22
  s23 = s22 + a23
  s24 = s23 + a24
  s24
end

puts "#{work(7_i64)}"
puts "#{work(-3_i64)}"
