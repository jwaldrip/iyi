module ra_a_hole_reuse

def holes(seed : Int64) : {Int64, Int64}
  h1 = seed * 2_i64
  h2 = seed * 3_i64
  h3 = seed * 4_i64
  h4 = seed * 5_i64
  h5 = seed * 6_i64
  h6 = seed * 7_i64
  h7 = seed * 8_i64
  h8 = seed * 9_i64
  h9 = seed * 10_i64
  h10 = seed * 11_i64
  q = seed * 3_i64
  b = seed + 11_i64
  a = seed * 7_i64
  result = a + b + h1 + h2 + h3 + h4 + h5 + h6 + h7 + h8 + h9 + h10
  if seed < 0_i64
    {a + 3_i64, q}
  else
    {result, q}
  end
end

positive = holes(4_i64)
puts "#{positive[0]}"
puts "#{positive[1]}"
negative = holes(-2_i64)
puts "#{negative[0]}"
puts "#{negative[1]}"
