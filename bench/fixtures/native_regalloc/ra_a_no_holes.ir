; iyi-ir 1
module "ra_a_no_holes"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
declare external i32 @printf(ptr, ...)
@fmt = private constant [5 x i8] c"%ld\0A\00"

define internal i64 @straight(i64 %x, i64 %y) {
entry:
  %a = mul i64 %x, 7
  %b = add i64 %y, 11
  %c = xor i64 %a, %b
  %d = mul i64 %c, 5
  %e = sub i64 %d, %x
  ret i64 %e
}

define i32 @main() {
entry:
  %a = call i64 (i64, i64) @straight(i64 3, i64 7)
  %b = call i64 (i64, i64) @straight(i64 -4, i64 2)
  %p1 = call i32 (ptr, ...) @printf(ptr @fmt, i64 %a)
  %p2 = call i32 (ptr, ...) @printf(ptr @fmt, i64 %b)
  ret i32 0
}
