abstract class D2Base
  abstract def value : Int32
end

class D2Case00 < D2Base
  def value : Int32
    0
  end
end

class D2Case01 < D2Base
  def value : Int32
    1
  end
end

class D2Case02 < D2Base
  def value : Int32
    2
  end
end

class D2Case03 < D2Base
  def value : Int32
    3
  end
end

class D2Case04 < D2Base
  def value : Int32
    4
  end
end

class D2Case05 < D2Base
  def value : Int32
    5
  end
end

class D2Case06 < D2Base
  def value : Int32
    6
  end
end

class D2Case07 < D2Base
  def value : Int32
    7
  end
end

class D2Case08 < D2Base
  def value : Int32
    8
  end
end

class D2Case09 < D2Base
  def value : Int32
    9
  end
end

class D2Case10 < D2Base
  def value : Int32
    10
  end
end

class D2Case11 < D2Base
  def value : Int32
    11
  end
end

class D2Case12 < D2Base
  def value : Int32
    12
  end
end

