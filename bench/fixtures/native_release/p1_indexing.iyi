import std/int

@[NoInline]
def byte_remainder(value : UInt8) : Nil
  remainder = (value & 127_u8) % 200_u8
  signed = remainder.unsafe_to_i8.to_i64
  unsigned = remainder.to_i64
  puts "byte-remainder signed=#{signed} unsigned=#{unsigned}"
  __iyi_exit(1) unless signed == 127_i64 && unsigned == 127_i64
end

@[NoInline]
def shift(values : Array(Int32)) : Int64
  i = 0
  total = 0_i64
  while i + 1 < values.size
    values[i] = values[i + 1]
    total = total + (i % 7).to_i64
    i = i + 1
  end
  total
end

# A bound that is nonnegative by its mask: the two tests of one refusal in
# either order must refuse the same inputs as the source says.
@[NoInline]
def pick(x : Int32, n : Int32) : Int32
  size = n & 2147483647
  if x < 0 || x >= size
    return -1
  end
  x
end

@[NoInline]
def pick_reversed(x : Int32, n : Int32) : Int32
  size = n & 2147483647
  if x >= size || x < 0
    return -1
  end
  x
end

@[NoInline]
def failure(values : Array(Int32), index : Int32, write : Bool) : Nil
  message = "no panic"
  group do |g|
    task = g.spawn do
      if write
        values[index] = 99
      else
        values[index]
      end
      0
    end
    result = task.value
    message = result.message if result.is_a?(Panicked)
    0
  end
  puts message
  expected = "index #{index} out of range for #{values.size} elements"
  __iyi_exit(1) unless message == expected
end

empty = [] of Int32
values = [10, 20, 30]
puts "negative-valid=#{values[-1]}"
puts "shift=#{shift(values)} values=#{values[0]},#{values[1]},#{values[2]}"
byte_remainder(127_u8)
puts "pick=#{pick(-1, 5)} #{pick(0, 5)} #{pick(4, 5)} #{pick(5, 5)} #{pick(999, 5)} #{pick(0, 0)} #{pick(-7, 0)}"
puts "pick-reversed=#{pick_reversed(-1, 5)} #{pick_reversed(0, 5)} #{pick_reversed(4, 5)} #{pick_reversed(5, 5)} #{pick_reversed(999, 5)} #{pick_reversed(0, 0)} #{pick_reversed(-7, 0)}"
[false, true].each do |write|
  failure(empty, -1, write)
  failure(empty, 0, write)
  failure(empty, 999, write)
  failure(values, -4, write)
  failure(values, 3, write)
  failure(values, 999, write)
end
