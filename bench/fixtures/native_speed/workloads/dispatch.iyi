abstract class DispatchBase
  abstract def value : Int32
end

class Dispatch00 < DispatchBase
  def value : Int32
    0
  end
end

class Dispatch01 < DispatchBase
  def value : Int32
    1
  end
end

class Dispatch02 < DispatchBase
  def value : Int32
    2
  end
end

class Dispatch03 < DispatchBase
  def value : Int32
    3
  end
end

class Dispatch04 < DispatchBase
  def value : Int32
    4
  end
end

class Dispatch05 < DispatchBase
  def value : Int32
    5
  end
end

class Dispatch06 < DispatchBase
  def value : Int32
    6
  end
end

class Dispatch07 < DispatchBase
  def value : Int32
    7
  end
end

class Dispatch08 < DispatchBase
  def value : Int32
    8
  end
end

class Dispatch09 < DispatchBase
  def value : Int32
    9
  end
end

class Dispatch10 < DispatchBase
  def value : Int32
    10
  end
end

class Dispatch11 < DispatchBase
  def value : Int32
    11
  end
end

class Dispatch12 < DispatchBase
  def value : Int32
    12
  end
end

class Dispatch13 < DispatchBase
  def value : Int32
    13
  end
end

class Dispatch14 < DispatchBase
  def value : Int32
    14
  end
end

