def make_dispatch(kind : Int32) : DispatchBase
  case kind
  when  0 then Dispatch00.new
  when  1 then Dispatch01.new
  when  2 then Dispatch02.new
  when  3 then Dispatch03.new
  when  4 then Dispatch04.new
  when  5 then Dispatch05.new
  when  6 then Dispatch06.new
  when  7 then Dispatch07.new
  when  8 then Dispatch08.new
  when  9 then Dispatch09.new
  when 10 then Dispatch10.new
  when 11 then Dispatch11.new
  when 12 then Dispatch12.new
  when 13 then Dispatch13.new
  when 14 then Dispatch14.new
  when 15 then Dispatch15.new
  when 16 then Dispatch16.new
  when 17 then Dispatch17.new
  when 18 then Dispatch18.new
  when 19 then Dispatch19.new
  when 20 then Dispatch20.new
  when 21 then Dispatch21.new
  when 22 then Dispatch22.new
  else         Dispatch23.new
  end
end

def run(seed : UInt64) : Int64
  entries = [] of DispatchBase
  state = seed
  index = 0
  while index < 4096
    state = ((state &* 1664525_u64) &+ 1013904223_u64) & 0xFFFFFFFF_u64
    entries << make_dispatch((state.unsafe_shr(16_u64) % 24_u64).to_i32)
    index = index + 1
  end
  sum = 0_i64
  pass = 0
  while pass < 60_000
    index = 0
    while index < entries.size
      sum = sum + entries[index].value.to_i64
      index = index + 1
    end
    pass = pass + 1
  end
  sum
end

puts "result=#{run(ARGC_UNSAFE.to_u64)}"
