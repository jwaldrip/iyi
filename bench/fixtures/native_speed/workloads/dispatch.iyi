class Dispatch20 < DispatchBase
  def value : Int32
    20
  end
end

class Dispatch21 < DispatchBase
  def value : Int32
    21
  end
end

class Dispatch22 < DispatchBase
  def value : Int32
    22
  end
end

class Dispatch23 < DispatchBase
  def value : Int32
    23
  end
