
def fannkuch(n : Int32) : Nil
  perm = Array(Int32).new(n, 0)
  perm1 = Array(Int32).new(n) { |index| index }
  count = Array(Int32).new(n, 0)
  max_flips = 0
  perm_count = 0
  checksum = 0
  r = n
  while true
    while r != 1
      count[r - 1] = r
      r = r - 1
    end
    i = 0
    while i < n
      perm[i] = perm1[i]
      i = i + 1
    end
    flips = 0
    k = perm[0]
    while k != 0
      k2 = (k + 1) // 2
      i = 0
      while i < k2
        t = perm[i]
        perm[i] = perm[k - i]
        perm[k - i] = t
        i = i + 1
      end
      flips = flips + 1
      k = perm[0]
    end
    max_flips = flips if flips > max_flips
    checksum = checksum + (perm_count % 2 == 0 ? flips : 0 - flips)
    while true
      if r == n
        puts "result=#{checksum}:#{max_flips}"
        return
      end
      perm0 = perm1[0]
      i = 0
      while i < r
        j = i + 1
        perm1[i] = perm1[j]
        i = j
      end
      perm1[r] = perm0
      count[r] = count[r] - 1
      break if count[r] > 0
      r = r + 1
    end
    perm_count = perm_count + 1
  end
end

fannkuch(10)
