
@[Unsafe("one arm of a measurement indexes the arrays' raw buffers")]
import std/math::{Math}

{% if flag?(:raw) %}
  alias Row = Pointer(Float64)
{% else %}
  alias Row = Array(Float64)
{% end %}

def view(values : Array(Float64)) : Row
  {% if flag?(:raw) %}
    values.to_unsafe
  {% else %}
    values
  {% end %}
end

def energy(x : Row, y : Row, z : Row, vx : Row, vy : Row, vz : Row, mass : Row) : Float64
  e = 0.0
  i = 0
  while i < 5
    e = e + 0.5 * mass[i] * (vx[i] * vx[i] + vy[i] * vy[i] + vz[i] * vz[i])
    j = i + 1
    while j < 5
      dx = x[i] - x[j]
      dy = y[i] - y[j]
      dz = z[i] - z[j]
      e = e - (mass[i] * mass[j]) / Math.sqrt(dx * dx + dy * dy + dz * dz)
      j = j + 1
    end
    i = i + 1
  end
  e
end

def advance(x : Row, y : Row, z : Row, vx : Row, vy : Row, vz : Row, mass : Row, dt : Float64) : Nil
  i = 0
  while i < 5
    j = i + 1
    while j < 5
      dx = x[i] - x[j]
      dy = y[i] - y[j]
      dz = z[i] - z[j]
      d2 = dx * dx + dy * dy + dz * dz
      mag = dt / (d2 * Math.sqrt(d2))
      vx[i] = vx[i] - dx * mass[j] * mag
      vy[i] = vy[i] - dy * mass[j] * mag
      vz[i] = vz[i] - dz * mass[j] * mag
      vx[j] = vx[j] + dx * mass[i] * mag
      vy[j] = vy[j] + dy * mass[i] * mag
      vz[j] = vz[j] + dz * mass[i] * mag
      j = j + 1
    end
    i = i + 1
  end
  i = 0
  while i < 5
    x[i] = x[i] + dt * vx[i]
    y[i] = y[i] + dt * vy[i]
    z[i] = z[i] + dt * vz[i]
    i = i + 1
  end
end

def run : Float64
  pi = 3.141592653589793
  solar = 4.0 * pi * pi
  days = 365.24
  x = [0.0, 4.84143144246472090e+00, 8.34336671824457987e+00, 1.28943695621391310e+01, 1.53796971148509165e+01]
  y = [0.0, -1.16032004402742839e+00, 4.12479856412430479e+00, -1.51111514016986312e+01, -2.59193146099879641e+01]
  z = [0.0, -1.03622044471123109e-01, -4.03523417114321381e-01, -2.23307578892655734e-01, 1.79258772950371181e-01]
  vx = [0.0, 1.66007664274403694e-03 * days, -2.76742510726862411e-03 * days, 2.96460137564761618e-03 * days, 2.68067772490389322e-03 * days]
  vy = [0.0, 7.69901118419740425e-03 * days, 4.99852801234917238e-03 * days, 2.37847173959480950e-03 * days, 1.62824170038242295e-03 * days]
  vz = [0.0, -6.90460016972063023e-05 * days, 2.30417297573763929e-05 * days, -2.96589568540237556e-05 * days, -9.51592254519715870e-05 * days]
  mass = [solar, 9.54791938424326609e-04 * solar, 2.85885980666130812e-04 * solar, 4.36624404335156298e-05 * solar, 5.15138902046611451e-05 * solar]
  px = 0.0
  py = 0.0
  pz = 0.0
  i = 0
  while i < 5
    px = px + vx[i] * mass[i]
    py = py + vy[i] * mass[i]
    pz = pz + vz[i] * mass[i]
    i = i + 1
  end
  vx[0] = 0.0 - px / solar
  vy[0] = 0.0 - py / solar
  vz[0] = 0.0 - pz / solar
  xs = view(x)
  ys = view(y)
  zs = view(z)
  vxs = view(vx)
  vys = view(vy)
  vzs = view(vz)
  masses = view(mass)
  step = 0
  while step < 2_000_000
    advance(xs, ys, zs, vxs, vys, vzs, masses, 0.01)
    step = step + 1
  end
  energy(xs, ys, zs, vxs, vys, vzs, masses)
end

puts "result=#{run}"
