@[Unsafe("builds strings from runtime-generated bytes")]
module native_speed_strcmp

def make_string(group : Int32, variant : Int32, seed : Int32) : String
  length = group % 48 + 1
  changed = (group + seed) % length
  String.new(length) do |bytes|
    i = 0
    while i < length
      byte = ((group + i + seed) % 26 + 65).to_u8
      byte = 90_u8 if variant >= 2 && i == changed
      bytes[i] = byte
      i = i + 1
    end
  end
end

def run(seed : Int32) : Int64
  strings = [] of String
  i = 0
  while i < 4096
    strings << make_string(i // 4, i % 4, seed)
    i = i + 1
  end
  sum = 0_i64
  pass = 0
  while pass < 10_000
    i = 0
    while i < strings.size
      offset = 1
      while offset <= 8
        sum = sum + 1_i64 if strings[i] == strings[(i + offset) & 4095]
        offset = offset + 1
      end
      i = i + 1
    end
    pass = pass + 1
  end
  sum
end

puts "result=#{run(ARGC_UNSAFE)}"
