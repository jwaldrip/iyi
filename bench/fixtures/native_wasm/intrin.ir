; iyi-ir 1
module "intrin"
target triple = "wasm32-wasi"
target datalayout = "e-m:e-p:32:32-p10:8:8-p20:8:8-i64:64-i128:128-n32:64-S128-ni:1:10:20"
declare external void @__iyi_print_i64(i64)

@src = global [8 x i8] c"ABCDEFGH"

define external i32 @main() {
entry:
  %a = alloca [16 x i8], align 8
  %b = alloca [16 x i8], align 8
  intrinsic llvm.memset.p0.i64(ptr %a, i8 5, i64 16, i1 false)
  intrinsic llvm.memcpy.p0.p0.i64(ptr %b, ptr %a, i64 16, i1 false)
  %p = getelementptr i8, ptr %b, i64 7
  store i8 9, ptr %p, align 1
  intrinsic llvm.memmove.p0.p0.i64(ptr %b, ptr %p, i64 4, i1 false)
  %l0 = load i8, ptr %b, align 1
  %l0x = zext i8 %l0 to i64
  call void (i64) @__iyi_print_i64(i64 %l0x)
  %l1 = getelementptr i8, ptr %b, i64 3
  %l1v = load i8, ptr %l1, align 1
  %l1x = zext i8 %l1v to i64
  call void (i64) @__iyi_print_i64(i64 %l1x)
  %l2 = getelementptr i8, ptr %b, i64 4
  %l2v = load i8, ptr %l2, align 1
  %l2x = zext i8 %l2v to i64
  call void (i64) @__iyi_print_i64(i64 %l2x)
  %g = alloca [8 x i8], align 8
  intrinsic llvm.memcpy.p0.p0.i32(ptr %g, ptr @src, i32 8, i1 false)
  %g3 = getelementptr i8, ptr %g, i64 3
  %g3v = load i8, ptr %g3, align 1
  %g3x = zext i8 %g3v to i64
  call void (i64) @__iyi_print_i64(i64 %g3x)
  ret i32 0
}
