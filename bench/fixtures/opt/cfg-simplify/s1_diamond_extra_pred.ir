; iyi-ir 1
source_filename = "s1_diamond_extra_pred"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
define internal i32 @diamond_extra_pred(i1 %c, i1 %d, i32 %x) {
entry:
  br i1 %c, label %head, label %other
head:
  br i1 %d, label %yes, label %no
yes:
  %a = add i32 %x, 1
  br label %join
no:
  %b = sub i32 %x, 1
  br label %join
other:
  %e = mul i32 %x, 2
  br label %join
join:
  %v = phi i32 [ %a, label %yes ], [ %b, label %no ], [ %e, label %other ]
  ret i32 %v
}
