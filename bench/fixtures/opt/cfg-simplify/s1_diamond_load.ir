; iyi-ir 1
source_filename = "s1_diamond_load"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
define internal i32 @diamond_load(i1 %c, ptr %p, i32 %x) {
entry:
  br i1 %c, label %yes, label %no
yes:
  %a = load i32, ptr %p, align 4
  br label %join
no:
  %b = add i32 %x, 1
  br label %join
join:
  %v = phi i32 [ %a, label %yes ], [ %b, label %no ]
  ret i32 %v
}
