; iyi-ir 1
source_filename = "s1_diamond_loop_header"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
define internal i32 @diamond_loop_header(i1 %c, i32 %x) {
entry:
  br i1 %c, label %loop, label %bypass
loop:
  %i = phi i32 [ %x, label %entry ], [ %next, label %latch ]
  %next = add i32 %i, 1
  %done = icmp sge i32 %next, 10
  br i1 %done, label %join, label %latch
latch:
  br label %loop
bypass:
  %b = add i32 %x, 1
  br label %join
join:
  %v = phi i32 [ %next, label %loop ], [ %b, label %bypass ]
  ret i32 %v
}
