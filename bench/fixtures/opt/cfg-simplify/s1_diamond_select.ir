; iyi-ir 1
source_filename = "s1_diamond_select"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
define internal i32 @diamond(i1 %c, i32 %x, i32 %y) {
entry:
  br i1 %c, label %yes, label %no
yes:
  %a = add i32 %x, 1
  %b = add i32 %a, 2
  br label %join
no:
  %d = sub i32 %y, 1
  %e = sub i32 %d, 2
  br label %join
join:
  %p = phi i32 [ %b, label %yes ], [ %e, label %no ]
  %q = phi i32 [ %a, label %yes ], [ %d, label %no ]
  %sum = add i32 %p, %q
  ret i32 %sum
}
