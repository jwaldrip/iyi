; iyi-ir 1
source_filename = "s1_diamond_three"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
define internal i32 @diamond_three(i1 %c, i32 %x) {
entry:
  br i1 %c, label %yes, label %no
yes:
  %a = add i32 %x, 1
  %b = add i32 %a, 2
  %d = add i32 %b, 3
  br label %join
no:
  %e = sub i32 %x, 1
  br label %join
join:
  %v = phi i32 [ %d, label %yes ], [ %e, label %no ]
  ret i32 %v
}
