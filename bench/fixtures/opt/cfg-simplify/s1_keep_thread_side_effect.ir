; iyi-ir 1
source_filename = "s1_keep_thread_side_effect"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
declare external i32 @observe()
define internal i32 @s1_keep_thread_side_effect(i1 %c, ptr %ptr) {
entry:
  br i1 %c, label %a, label %b
a:
  %loaded = load i32, ptr %ptr, align 4
  br label %join
b:
  br label %join
join:
  %p = phi i1 [ true, label %a ], [ false, label %b ]
  %x = call i32 () @observe()
  br i1 %p, label %yes, label %no
yes:
  ret i32 %x
no:
  ret i32 2
}
