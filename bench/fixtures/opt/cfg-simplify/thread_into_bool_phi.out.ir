; iyi-ir 1
source_filename = "thread_into_bool_phi"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
define internal i1 @thread_into_bool_phi(i1 %c, i1 %d) {
entry:
  %0 = select i1 %c, i1 true, i1 false
  br i1 %0, label %next, label %no
next:
  %q = phi i1 [ %d, label %entry ]
  ret i1 %q
no:
  %r = phi i1 [ false, label %entry ]
  ret i1 %r
}

