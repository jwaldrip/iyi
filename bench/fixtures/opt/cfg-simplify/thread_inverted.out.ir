; iyi-ir 1
source_filename = "thread_inverted"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
declare external void @raise_error()

define internal i32 @thread_inverted(i1 %c, i32 %x) {
entry:
  br i1 %c, label %then, label %else
then:
  br label %ok
else:
  br label %ok
ok:
  %r = add i32 %x, 1
  ret i32 %r
}
