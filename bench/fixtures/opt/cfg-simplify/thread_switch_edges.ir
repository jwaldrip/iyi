; iyi-ir 1
source_filename = "thread_switch_edges"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
define internal i32 @thread_switch_edges(i32 %x) {
entry:
  switch i32 %x, label %join [ i32 0, label %join ]
join:
  %p = phi i1 [ true, label %entry ]
  br i1 %p, label %yes, label %no
yes:
  ret i32 1
no:
  ret i32 2
}
