; iyi-ir 1
source_filename = "thread_two_phis"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
define internal i32 @thread_two_phis(i1 %c, i32 %x) {
entry:
  %k = add i32 %x, 1
  %0 = select i1 %c, i1 true, i1 false
  %1 = select i1 %c, i32 %k, i32 0
  br i1 %0, label %yes, label %no
yes:
  ret i32 %1
no:
  ret i32 0
}

