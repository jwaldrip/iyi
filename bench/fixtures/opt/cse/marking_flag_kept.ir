; iyi-ir 1
source_filename = "marking_flag_kept"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
@__iyi_marking = external global i8

define internal i8 @marking_flag_kept(ptr %slot, ptr %other) {
entry:
  %a = load i8, ptr @__iyi_marking, align 1
  %address = getelementptr i8, ptr @__iyi_marking, i64 0
  store ptr %address, ptr %slot, align 8
  %flag = load ptr, ptr %other, align 8
  %b = load i8, ptr %flag, align 1
  %c = load i8, ptr %flag, align 1
  %d = load i8, ptr @__iyi_marking, align 1
  %first = add i8 %a, %b
  %second = add i8 %c, %d
  %sum = add i8 %first, %second
  ret i8 %sum
}
