; iyi-ir 1
source_filename = "direct_bypass_keep"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
@header = internal global i64 0
@"Bypass:headed" = internal constant i8 1
@"Bypass:type_id" = internal constant i32 8
define internal ptr @"*IyiHeap::new_object"(i64 %size, i64 %tid, i1 %headed, i1 %atomic) {
entry:
  %h = shl i64 %tid, 32
  store i64 %h, ptr @header, align 8
  %p = getelementptr i8, ptr @header, i64 8
  ret ptr %p
}
define internal ptr @__iyi_new(i64 %size, i64 %tid, i64 %flags) {
entry:
  %p = call ptr (i64, i64, i1, i1) @"*IyiHeap::new_object"(i64 %size, i64 %tid, i1 true, i1 false)
  ret ptr %p
}
define internal i1 @dispatch(ptr %obj) {
entry:
  %header = getelementptr i8, ptr %obj, i64 -4
  %id = load i32, ptr %header, align 4
  %test = icmp eq i32 %id, 8
  ret i1 %test
}
define external i1 @main() {
entry:
  %p = call ptr (i64, i64, i1, i1) @"*IyiHeap::new_object"(i64 8, i64 8, i1 true, i1 false)
  %answer = call i1 (ptr) @dispatch(ptr %p)
  ret i1 %answer
}
