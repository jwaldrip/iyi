; iyi-ir 1
source_filename = "external_units"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
flag "external_units" = 1
@header = internal global i64 0
@"Dead:headed" = internal constant i8 1
@"Dead:type_id" = internal constant i32 8
define internal ptr @__iyi_new(i64 %size, i64 %tid, i64 %flags) {
entry:
  %h = shl i64 %tid, 32
  store i64 %h, ptr @header, align 8
  %p = getelementptr i8, ptr @header, i64 8
  ret ptr %p
}
define internal i1 @dispatch(ptr %obj) {
entry:
  %header = getelementptr i8, ptr %obj, i64 -4
  %id = load i32, ptr %header, align 4
  %test = icmp eq i32 %id, 8
  ret i1 %test
}
define external i32 @main() {
entry:
  %p = call ptr (i64, i64, i64) @__iyi_new(i64 8, i64 3, i64 1)
  %header = getelementptr i8, ptr %p, i64 -4
  %answer = call i1 (ptr) @dispatch(ptr %p)
  %extra = zext i1 %answer to i32
  %sum = add i32 3, %extra
  ret i32 %sum
}
