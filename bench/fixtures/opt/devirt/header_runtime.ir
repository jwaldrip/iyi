; iyi-ir 1
source_filename = "header_runtime"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
@header = internal global i64 0
define internal ptr @__iyi_new(i64 %size, i64 %tid, i64 %flags) {
entry:
  %h = shl i64 %tid, 32
  store i64 %h, ptr @header, align 8
  %p = getelementptr i8, ptr @header, i64 8
  ret ptr %p
}
define internal void @opaque_use(ptr %p) {
entry:
  ret void
}
define external i32 @main() {
entry:
  %p = call ptr (i64, i64, i64) @__iyi_new(i64 8, i64 3, i64 1)
  %header = getelementptr i8, ptr %p, i64 -4
  %first = load i32, ptr %header, align 4
  %low_address = getelementptr i8, ptr %p, i64 -8
  %low = load i32, ptr %low_address, align 4
  call void (ptr) @opaque_use(ptr %p)
  %second = load i32, ptr %header, align 4
  %same = icmp eq i32 %first, %second
  %other_half_zero = icmp eq i32 %low, 0
  %answer = and i1 %same, %other_half_zero
  %failed = xor i1 %answer, true
  %result = zext i1 %failed to i32
  ret i32 %result
}
