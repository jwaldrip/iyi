; iyi-ir 1
source_filename = "alloc_entry_keep"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
%Point = type { i64, i64 }
declare external void @sink(i64)
define internal i64 @take(i64 %size, i1 %headed) {
entry:
  %s = add i64 %size, 8
  %h = select i1 %headed, i64 %s, i64 %size
  ret i64 %h
}
define internal ptr @new_object(i64 %size, i64 %type_id, i1 %headed) {
entry:
  %q = call i64 (i64, i1) @take(i64 %size, i1 %headed)
  %p = inttoptr i64 %q to ptr
  ret ptr %p
}
define external ptr @__iyi_new(i64 %size, i64 %type_id, i64 %flags) {
entry:
  %a = and i64 %flags, 1
  %headed = icmp ne i64 %a, 0
  %p = call ptr (i64, i64, i1) @new_object(i64 %size, i64 %type_id, i1 %headed)
  ret ptr %p
}
define external i64 @fill(i64 %count) {
entry:
  br label %loop
loop:
  %i = phi i64 [ 0, label %entry ], [ %next, label %body ]
  %acc = phi i64 [ 0, label %entry ], [ %acc2, label %body ]
  %more = icmp ult i64 %i, %count
  br i1 %more, label %body, label %done
body:
  %p = call ptr (i64, i64, i64) @__iyi_new(i64 ptrtoint (ptr getelementptr (%Point, ptr null, i32 1) to i64), i64 69, i64 2)
  %v = ptrtoint ptr %p to i64
  %acc2 = add i64 %acc, %v
  %next = add i64 %i, 1
  br label %loop
done:
  ret i64 %acc
}
