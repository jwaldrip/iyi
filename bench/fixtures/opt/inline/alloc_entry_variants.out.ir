; iyi-ir 1
source_filename = "alloc_entry_variants"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
define external ptr @__iyi_malloc64(i64 %size) {
entry:
  %next = add i64 %size, 1
  %p = inttoptr i64 %next to ptr
  ret ptr %p
}

define external ptr @__iyi_malloc_atomic64(i64 %size) {
entry:
  %next = add i64 %size, 2
  %p = inttoptr i64 %next to ptr
  ret ptr %p
}

define external ptr @__iyi_realloc64(ptr %old, i64 %size) {
entry:
  %next = add i64 %size, 3
  %p = inttoptr i64 %next to ptr
  ret ptr %p
}

define external i64 @padding(i64 %x) {
entry:
  %a0 = add i64 %x, 1
  %a1 = add i64 %a0, 2
  %a2 = add i64 %a1, 3
  %a3 = add i64 %a2, 4
  %a4 = add i64 %a3, 5
  %a5 = add i64 %a4, 6
  %a6 = add i64 %a5, 7
  %a7 = add i64 %a6, 8
  %a8 = add i64 %a7, 9
  %a9 = add i64 %a8, 10
  %a10 = add i64 %a9, 11
  %a11 = add i64 %a10, 12
  ret i64 %a11
}

define external i64 @variant_use(i64 %size) {
entry:
  %0 = add i64 %size, 1
  %1 = inttoptr i64 %0 to ptr
  %2 = add i64 %size, 2
  %3 = inttoptr i64 %2 to ptr
  %resized = call ptr (ptr, i64) @__iyi_realloc64(ptr %1, i64 %size)
  %a = ptrtoint ptr %3 to i64
  %r = ptrtoint ptr %resized to i64
  %sum = add i64 %a, %r
  ret i64 %sum
}

