; iyi-ir 1
; Unsigned overflow produces canonical i1 flags 1 for true and 0 for false.
source_filename = "alloc_i1_overflow"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
define external ptr @__iyi_new(i64 %size, i64 %type_id, i64 %flags) {
entry:
  %flag = trunc i64 %flags to i8
  %with_carry = intrinsic llvm.uadd.with.overflow.i8(i8 -1, i8 %flag)
  %carry = extractvalue { i8, i1 } %with_carry, 1
  %without_carry = intrinsic llvm.uadd.with.overflow.i8(i8 0, i8 %flag)
  %no_carry = extractvalue { i8, i1 } %without_carry, 1
  %first = select i1 %carry, i64 8, i64 16
  %second = select i1 %no_carry, i64 32, i64 %first
  %address = add i64 %size, %second
  %p = inttoptr i64 %address to ptr
  ret ptr %p
}
define external i64 @padding(i64 %x) {
entry:
  %a0 = add i64 %x, 1
  %a1 = add i64 %a0, 2
  %a2 = add i64 %a1, 3
  %a3 = add i64 %a2, 4
  %a4 = add i64 %a3, 5
  %a5 = add i64 %a4, 6
  %a6 = add i64 %a5, 7
  %a7 = add i64 %a6, 8
  %a8 = add i64 %a7, 9
  %a9 = add i64 %a8, 10
  %a10 = add i64 %a9, 11
  %a11 = add i64 %a10, 12
  %a12 = add i64 %a11, 13
  %a13 = add i64 %a12, 14
  %a14 = add i64 %a13, 15
  %a15 = add i64 %a14, 16
  ret i64 %a15
}
define external ptr @overflow_use(i64 %size) {
entry:
  %p = call ptr (i64, i64, i64) @__iyi_new(i64 %size, i64 1, i64 1)
  ret ptr %p
}
