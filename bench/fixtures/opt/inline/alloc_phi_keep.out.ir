; iyi-ir 1
source_filename = "alloc_phi_keep"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
define external ptr @__iyi_new(i64 %size, i64 %type_id, i64 %flags) {
entry:
  %which = icmp eq i64 %size, 0
  br i1 %which, label %left, label %right
left:
  br label %join
right:
  br label %join
join:
  %address = phi i64 [ 16, label %left ], [ 32, label %right ]
  %p = inttoptr i64 %address to ptr
  ret ptr %p
}

define external i64 @padding(i64 %x) {
entry:
  %a0 = add i64 %x, 1
  %a1 = add i64 %a0, 2
  %a2 = add i64 %a1, 3
  %a3 = add i64 %a2, 4
  %a4 = add i64 %a3, 5
  %a5 = add i64 %a4, 6
  %a6 = add i64 %a5, 7
  %a7 = add i64 %a6, 8
  %a8 = add i64 %a7, 9
  %a9 = add i64 %a8, 10
  %a10 = add i64 %a9, 11
  %a11 = add i64 %a10, 12
  ret i64 %a11
}

define external ptr @phi_use(i64 %size) {
entry:
  %0 = icmp eq i64 %size, 0
  br i1 %0, label %left, label %right
left:
  br label %join
right:
  br label %join
join:
  %1 = phi i64 [ 16, label %left ], [ 32, label %right ]
  %2 = inttoptr i64 %1 to ptr
  ret ptr %2
}

