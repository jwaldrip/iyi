  call void (i64) @sink(i64 %x)
  call void (i64) @sink(i64 %x)
  call void (i64) @sink(i64 %x)
  call void (i64) @sink(i64 %x)
  call void (i64) @sink(i64 %x)
  call void (i64) @sink(i64 %x)
  call void (i64) @sink(i64 %x)
  call void (i64) @sink(i64 %x)
  call void (i64) @sink(i64 %x)
  call void (i64) @sink(i64 %x)
  ret void
}

define external ptr @recursive_use(i64 %size) {
entry:
  %0 = icmp eq i64 %size, 0
  br i1 %0, label %base, label %step
base:
  br label %inline.cont3
step:
  %1 = sub i64 %size, 1
  %2 = icmp eq i64 %1, 0
  br i1 %2, label %base5, label %step6
inline.cont3:
  %3 = phi i64 [ 1, label %base ], [ %7, label %inline.cont7 ]
  %4 = inttoptr i64 %3 to ptr
  ret ptr %4
base5:
  br label %inline.cont7
step6:
  %5 = sub i64 %1, 1
  %6 = call i64 (i64) @recursive(i64 %5)
  br label %inline.cont7
inline.cont7:
  %7 = phi i64 [ 1, label %base5 ], [ %6, label %step6 ]
  br label %inline.cont3
}

