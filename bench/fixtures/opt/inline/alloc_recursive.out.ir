; iyi-ir 1
source_filename = "alloc_recursive"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
declare external void @sink(i64)

define internal i64 @recursive(i64 %n) {
entry:
  %done = icmp eq i64 %n, 0
  br i1 %done, label %base, label %step
base:
  ret i64 1
step:
  %next = sub i64 %n, 1
  %result = call i64 (i64) @recursive(i64 %next)
  ret i64 %result
}

define external ptr @__iyi_new(i64 %size, i64 %type_id, i64 %flags) {
entry:
  %value = call i64 (i64) @recursive(i64 %size)
  %p = inttoptr i64 %value to ptr
  ret ptr %p
}

define external void @padding(i64 %x) {
entry:
  call void (i64) @sink(i64 %x)
  call void (i64) @sink(i64 %x)
  call void (i64) @sink(i64 %x)
  call void (i64) @sink(i64 %x)
  call void (i64) @sink(i64 %x)
