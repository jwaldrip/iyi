define external i64 @user(i64 %n) {
entry:
  br label %loop
loop:
  %i = phi i64 [ 0, label %entry ], [ %next, label %loop ]
  %s = phi i64 [ 0, label %entry ], [ %sum, label %loop ]
  %0 = mul i64 %i, 7
  %1 = add i64 %0, 2
  %2 = xor i64 %1, 9
  %sum = add i64 %s, %2
  %next = add i64 %i, 1
  %done = icmp eq i64 %next, %n
  br i1 %done, label %exit, label %loop
exit:
  ret i64 %sum
}

