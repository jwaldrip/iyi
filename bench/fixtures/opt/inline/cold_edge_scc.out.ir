; iyi-ir 1
source_filename = "cold_edge_scc"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
define internal i64 @b(i64 %x) {
entry:
  %neg = icmp slt i64 %x, 0
  br i1 %neg, label %bad, label %good
bad:
  %r = call i64 (i64) @a(i64 %x)
  unreachable
good:
  %v = add i64 %x, 1
  ret i64 %v
}

define internal i64 @a(i64 %x) {
entry:
  br label %entry1
entry1:
  %0 = icmp slt i64 %x, 0
  br i1 %0, label %bad, label %good
bad:
  %1 = call i64 (i64) @a(i64 %x)
  unreachable
good:
  %2 = add i64 %x, 1
  br label %inline.cont
inline.cont:
  %3 = phi i64 [ %2, label %good ]
  %w = mul i64 %3, 2
  ret i64 %w
}

define external i64 @outside(i64 %x) {
entry:
  br label %entry1
entry1:
  br label %entry12
entry12:
  %0 = icmp slt i64 %x, 0
  br i1 %0, label %bad, label %good
bad:
  %1 = call i64 (i64) @a(i64 %x)
  unreachable
good:
  %2 = add i64 %x, 1
  br label %inline.cont
inline.cont:
  %3 = phi i64 [ %2, label %good ]
  %4 = mul i64 %3, 2
  br label %inline.cont3
inline.cont3:
  %5 = phi i64 [ %4, label %inline.cont ]
  ret i64 %5
}

