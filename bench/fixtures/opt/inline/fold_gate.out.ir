define external i64 @gate_big(i64 %x, i1 %fast) {
entry:
  br i1 %fast, label %quick, label %slow
quick:
  ret i64 %x
slow:
  call void (i64) @sink(i64 %x)
  call void (i64) @sink(i64 %x)
  call void (i64) @sink(i64 %x)
  call void (i64) @sink(i64 %x)
  call void (i64) @sink(i64 %x)
  call void (i64) @sink(i64 %x)
  call void (i64) @sink(i64 %x)
  call void (i64) @sink(i64 %x)
  call void (i64) @sink(i64 %x)
  call void (i64) @sink(i64 %x)
  call void (i64) @sink(i64 %x)
  call void (i64) @sink(i64 %x)
  call void (i64) @sink(i64 %x)
  ret i64 %x
}

define external ptr @__iyi_new(i64 %size, i64 %type_id, i64 %flags) {
entry:
  %a = and i64 %flags, 2
  %fast = icmp ne i64 %a, 0
  %r = call i64 (i64, i1) @gate_big(i64 %size, i1 %fast)
  %p = inttoptr i64 %r to ptr
  ret ptr %p
}

define external i64 @fold_use(i64 %x) {
entry:
  %0 = inttoptr i64 %x to ptr
  %v = ptrtoint ptr %0 to i64
  ret i64 %v
}

define external i64 @fold_use_slow(i64 %x) {
entry:
  %0 = call i64 (i64, i1) @gate_big(i64 %x, i1 false)
  %1 = inttoptr i64 %0 to ptr
  %v = ptrtoint ptr %1 to i64
  ret i64 %v
}

