; iyi-ir 1
source_filename = "i1_hot_loop"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
declare external void @sink()
define internal i64 @work(i64 %x) {
entry:
  call void () @sink()
  call void () @sink()
  call void () @sink()
  call void () @sink()
  call void () @sink()
  %a1 = add i64 %x, 1
  %a2 = add i64 %a1, 2
  %a3 = add i64 %a2, 3
  %a4 = add i64 %a3, 4
  %a5 = add i64 %a4, 5
  %a6 = add i64 %a5, 6
  %a7 = add i64 %a6, 7
  %a8 = add i64 %a7, 8
  %a9 = add i64 %a8, 9
  ret i64 %a9
}
define external i64 @loop3(i64 %n) {
entry:
  br label %head
head:
  %i = phi i64 [ 0, label %entry ], [ %next, label %body ]
  %acc = phi i64 [ 0, label %entry ], [ %acc3, label %body ]
  %c = icmp slt i64 %i, %n
  br i1 %c, label %body, label %done
body:
  %v1 = call i64 (i64) @work(i64 %i)
  %v2 = call i64 (i64) @work(i64 %v1)
  %v3 = call i64 (i64) @work(i64 %v2)
  %acc3 = add i64 %acc, %v3
  %next = add i64 %i, 1
  br label %head
done:
  ret i64 %acc
}
define external i64 @padding(i64 %x) {
entry:
  %p0 = add i64 %x, 0
  %p1 = add i64 %x, 1
  %p2 = add i64 %x, 2
  %p3 = add i64 %x, 3
  %p4 = add i64 %x, 4
