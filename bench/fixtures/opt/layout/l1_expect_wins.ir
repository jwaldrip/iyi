; iyi-ir 1
source_filename = "l1_expect_wins"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
define internal i32 @expect_wins(i64 %x) {
entry:
  %negative = icmp slt i64 %x, 0
  %hint = intrinsic llvm.expect.i1(i1 %negative, i1 true)
  br i1 %hint, label %negative_path, label %positive_path
negative_path:
  br label %join
join:
  %result = phi i32 [ 1, label %negative_path ], [ 2, label %positive_path ]
  ret i32 %result
positive_path:
  br label %join
}
