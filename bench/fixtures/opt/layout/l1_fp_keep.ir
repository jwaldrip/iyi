; iyi-ir 1
source_filename = "l1_fp_keep"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
define internal i32 @fp_compare(double %x) {
entry:
  %test = fcmp oeq double %x, 0.000000e+00
  br i1 %test, label %equal, label %different
different:
  br label %join
equal:
  br label %join
join:
  %result = phi i32 [ 1, label %equal ], [ 2, label %different ]
  ret i32 %result
}
