define internal i32 @eq_null(ptr %x) {
entry:
  %test = icmp eq ptr %x, null
  br i1 %test, label %slow, label %fast
slow:
  br label %join
fast:
  br label %join
join:
  %result = phi i32 [ 1, label %slow ], [ 2, label %fast ]
  ret i32 %result
