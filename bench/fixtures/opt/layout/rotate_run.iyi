class Probe
  getter calls : Int32

  def initialize
    @calls = 0
  end

  # The loop header's condition has a side effect: every test is counted.
  def more?(i : Int32, limit : Int32) : Bool
    @calls = @calls + 1
    i < limit
  end
end

# A while loop whose header is the test: zero, one and many iterations.
def sum_to(limit : Int32) : Int32
  total = 0
  i = 0
  while i < limit
    total = total + i
    i = i + 1
  end
  total
end

# The same shape, with the test a method call that has a side effect.
def probe_loop(limit : Int32) : Int32
  probe = Probe.new
  i = 0
  total = 0
  while probe.more?(i, limit)
    total = total + i
    i = i + 1
  end
  total * 1000 + probe.calls
end

# Nested loops, with next (skips the add at j == 2) and break (leaves at j > 5).
def nested(outer : Int32, inner : Int32) : Int32
  total = 0
  i = 0
  while i < outer
    j = 0
    while j < inner
      j = j + 1
      next if j == 2
      break if j > 5
      total = total + i * 10 + j
    end
    i = i + 1
  end
  total
end

# Early exit from a loop with a conditional header.
def search(limit : Int32, target : Int32) : Int32
  i = 0
  found = -1
  while i < limit
    if i == target
      found = i
      break
    end
    i = i + 1
  end
  found
end

puts "#{sum_to(0)} #{sum_to(1)} #{sum_to(7)} #{sum_to(100)}"
puts "#{probe_loop(0)} #{probe_loop(1)} #{probe_loop(7)}"
puts "#{nested(0, 4)} #{nested(3, 0)} #{nested(3, 9)}"
puts "#{search(10, 0)} #{search(10, 9)} #{search(10, 10)}"
