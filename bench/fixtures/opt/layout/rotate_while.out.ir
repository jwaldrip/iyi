; iyi-ir 1
source_filename = "rotate_while"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
define external i32 @rotate_while(i32 %n) {
entry:
  br label %pre
pre:
  br label %header
body:
  br label %latch
latch:
  %next = add i32 %i, 1
  br label %header
header:
  %i = phi i32 [ 0, label %pre ], [ %next, label %latch ]
  %more = icmp slt i32 %i, %n
  br i1 %more, label %body, label %exit
exit:
  ret i32 %i
}
