; iyi-ir 1
source_filename = "m1_body_partial_object"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
define internal i8 @m1_body_partial_object(ptr %source, i1 %again) {
entry:
  %first = getelementptr inbounds { i8, i8 }, ptr %source, i64 0, i32 0
  %second = getelementptr inbounds { i8, i8 }, ptr %source, i64 0, i32 1
  br label %head
head:
  %total = phi i8 [ 0, label %entry ], [ %next, label %body ]
  %present = load i8, ptr %first, align 1
  br i1 %again, label %body, label %done
body:
  %value = load i8, ptr %second, align 1
  %next = add i8 %total, %value
  br label %head
done:
  %result = add i8 %total, %present
  ret i8 %result
}
