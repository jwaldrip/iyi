; iyi-ir 1
source_filename = "m1_header_fault_order"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
define internal i64 @m1_header_load_order(ptr %base, ptr %source, i1 %again) {
entry:
  br label %head
head:
  %index = phi i64 [ 0, label %entry ], [ %next, label %body ]
  %address = getelementptr i64, ptr %base, i64 %index
  %first = load i64, ptr %address, align 8
  %second = load i64, ptr %source, align 8
  br i1 %again, label %body, label %done
body:
  %next = add i64 %index, 1
  br label %head
done:
  %result = add i64 %first, %second
  ret i64 %result
}
define internal i64 @m1_header_div_order(i64 %numerator, i64 %denominator, ptr %source, i1 %again) {
entry:
  br label %head
head:
  %quotient = sdiv i64 %numerator, %denominator
  %value = load i64, ptr %source, align 8
  br i1 %again, label %body, label %done
body:
  br label %head
done:
  %result = add i64 %quotient, %value
  ret i64 %result
}
