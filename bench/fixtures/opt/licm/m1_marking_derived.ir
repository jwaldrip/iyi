; iyi-ir 1
source_filename = "m1_marking_derived"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
@__iyi_marking = external global i8
define internal i8 @m1_marking_derived(i1 %again) {
entry:
  %bits = ptrtoint ptr @__iyi_marking to i64
  %address = inttoptr i64 %bits to ptr
  br label %head
head:
  %flag = load i8, ptr %address, align 1
  br i1 %again, label %body, label %done
body:
  br label %head
done:
  ret i8 %flag
}
