; iyi-ir 1
source_filename = "m1_memory_boundaries"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
define internal i64 @m1_fence(ptr %source, i1 %again) {
entry:
  br label %head
head:
  %value = load i64, ptr %source, align 8
  br i1 %again, label %body, label %done
body:
  fence seq_cst
  br label %head
done:
  ret i64 %value
}
define internal i64 @m1_atomic(ptr %source, ptr %other, i1 %again) {
entry:
  br label %head
head:
  %value = load i64, ptr %source, align 8
  br i1 %again, label %body, label %done
body:
  %atomic = load i64, ptr %other, align 8 atomic acquire
  br label %head
done:
  ret i64 %value
}
define internal i64 @m1_volatile(ptr %source, ptr %other, i1 %again) {
entry:
  br label %head
head:
  %value = load i64, ptr %source, align 8
  br i1 %again, label %body, label %done
body:
  %volatile = volatile load i64, ptr %other, align 8
  br label %head
done:
  ret i64 %value
}
define internal i64 @m1_volatile_header(ptr %source, i1 %again) {
entry:
  br label %head
head:
  %value = volatile load i64, ptr %source, align 8
  br i1 %again, label %body, label %done
body:
  br label %head
done:
  ret i64 %value
}
define internal i64 @m1_memset(ptr %source, ptr %target, i1 %again) {
entry:
  br label %head
head:
  %value = load i64, ptr %source, align 8
  br i1 %again, label %body, label %done
body:
  intrinsic llvm.memset.p0.i64(ptr %target, i8 0, i64 8, i1 false)
  br label %head
done:
  ret i64 %value
}
define internal i64 @m1_memcpy(ptr %source, ptr %target, i1 %again) {
entry:
  br label %head
head:
  %value = load i64, ptr %source, align 8
  br i1 %again, label %body, label %done
body:
  intrinsic llvm.memcpy.p0.p0.i64(ptr %target, ptr %source, i64 8, i1 false)
  br label %head
done:
  ret i64 %value
}
define internal i64 @m1_asm(ptr %source, i1 %again) {
entry:
  br label %head
head:
  %value = load i64, ptr %source, align 8
  br i1 %again, label %body, label %done
body:
  call void () asm sideeffect "nop", ""()
  br label %head
done:
  ret i64 %value
}
