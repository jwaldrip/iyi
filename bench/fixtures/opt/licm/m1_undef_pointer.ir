; iyi-ir 1
source_filename = "m1_undef_pointer"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
define internal i64 @m1_undef_pointer(i1 %again) {
entry:
  br label %head
head:
  %value = load i64, ptr undef, align 8
  br i1 %again, label %body, label %done
body:
  br label %head
done:
  ret i64 %value
}
