; iyi-ir 1
source_filename = "induction_start"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
define internal i1 @induction_start(i32 %x) {
entry:
  %s = and i32 %x, 7
  br label %head
head:
  %i = phi i32 [ %s, label %entry ], [ %next, label %body ]
  %more = icmp slt i32 %i, 10
  br i1 %more, label %body, label %done
body:
  %j = add i32 %i, 1
  %next = add i32 %i, 1
  br i1 false, label %bad, label %head
bad:
  ret i1 true
done:
  ret i1 false
}

