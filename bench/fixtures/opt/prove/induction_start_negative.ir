; iyi-ir 1
source_filename = "induction_start_negative"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
define internal i1 @induction_start_negative(i1 %c) {
entry:
  %s = select i1 %c, i32 -3, i32 2
  br label %head
head:
  %i = phi i32 [ %s, label %entry ], [ %next, label %body ]
  %more = icmp slt i32 %i, 10
  br i1 %more, label %body, label %done
body:
  %j = add i32 %i, 1
  %neg = icmp slt i32 %j, 0
  %next = add i32 %i, 1
  br i1 %neg, label %bad, label %head
bad:
  ret i1 true
done:
  ret i1 false
}
