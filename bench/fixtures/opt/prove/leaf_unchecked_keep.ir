; iyi-ir 1
source_filename = "leaf_unchecked_keep"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
define internal i1 @leaf_unchecked_keep(i8 %x, i1 %c) {
entry:
  %m = and i8 %x, 63
  %k = select i1 %c, i8 1, i8 100
  %pair = intrinsic llvm.sadd.with.overflow.i8(i8 %m, i8 %k)
  %v = extractvalue { i8, i1 } %pair, 0
  %f = extractvalue { i8, i1 } %pair, 1
  br i1 %f, label %bad, label %ok
ok:
  ret i1 false
bad:
  %neg = icmp slt i8 %v, 0
  ret i1 %neg
}
