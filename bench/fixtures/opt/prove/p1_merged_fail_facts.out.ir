; iyi-ir 1
source_filename = "p1_merged_fail_facts"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
define internal i32 @fail_facts(i32 %x, i32 %n) {
entry:
  %size = and i32 %n, 2147483647
  %neg = icmp slt i32 %x, 0
  %0 = icmp uge i32 %x, %size
  br i1 %0, label %fail, label %middle
middle:
  br i1 false, label %fail, label %ok
fail:
  %t = icmp slt i32 %x, 0
  %r = zext i1 %t to i32
  ret i32 %r
ok:
  ret i32 %size
}

