; iyi-ir 1
source_filename = "p1_merged_unknown_bound"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
define internal i32 @unknown(i32 %x, i32 %n) {
entry:
  %neg = icmp slt i32 %x, 0
  br i1 %neg, label %fail, label %middle
middle:
  %above = icmp sge i32 %x, %n
  br i1 %above, label %fail, label %ok
fail:
  ret i32 %x
ok:
  ret i32 %n
}
