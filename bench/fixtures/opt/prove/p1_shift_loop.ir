; iyi-ir 1
source_filename = "p1_shift_loop"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
define internal i1 @shift(i32 %i, i32 %size) {
entry:
  %next = add nsw i32 %i, 1
  %more = icmp slt i32 %next, %size
  br i1 %more, label %body, label %done
body:
  %check = icmp slt i32 %i, %size
  ret i1 %check
done:
  ret i1 false
}
define internal i1 @checked_shift(i32 %i, i32 %size) {
entry:
  %pair = intrinsic llvm.sadd.with.overflow.i32(i32 %i, i32 1)
  %overflow = extractvalue { i32, i1 } %pair, 1
  br i1 %overflow, label %done, label %ok
ok:
  %next = extractvalue { i32, i1 } %pair, 0
  %more = icmp sle i32 %next, %size
  br i1 %more, label %body, label %done
body:
  %check = icmp slt i32 %i, %size
  ret i1 %check
done:
  ret i1 false
}
define internal void @loop(i32 %size, ptr %out) {
entry:
  br label %head
head:
  %i = phi i32 [ 0, label %entry ], [ %next, label %latch ]
  %offset = add nsw i32 %i, 1
  %more = icmp slt i32 %offset, %size
  br i1 %more, label %body, label %done
body:
  %check = icmp slt i32 %i, %size
  store i1 %check, ptr %out, align 1
  br label %latch
latch:
  %next = add i32 %i, 1
  br label %head
done:
  ret void
}
