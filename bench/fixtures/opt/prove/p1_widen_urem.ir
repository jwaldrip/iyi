; iyi-ir 1
source_filename = "p1_widen_urem"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
define internal i64 @remainder(i32 %x) {
entry:
  %nonnegative = icmp sge i32 %x, 0
  br i1 %nonnegative, label %body, label %done
body:
  %rem = urem i32 %x, 7
  %wide = zext i32 %rem to i64
  ret i64 %wide
done:
  ret i64 0
}
define internal i64 @signed_remainder(i32 %x) {
entry:
  %nonnegative = icmp sge i32 %x, 0
  br i1 %nonnegative, label %body, label %done
body:
  %rem = srem i32 %x, 7
  %wide = sext i32 %rem to i64
  ret i64 %wide
done:
  ret i64 0
}
define internal i64 @quotient(i32 %x) {
entry:
  %value = and i32 %x, 2147483647
  %quotient = udiv i32 %value, 7
  %wide = sext i32 %quotient to i64
  ret i64 %wide
}
define internal i64 @byte_boundary(i8 %x, ptr %out) {
entry:
  %value = and i8 %x, 127
  %rem = urem i8 %value, 200
  %signed = sext i8 %rem to i64
  %unsigned = zext i8 %rem to i64
  store i64 %signed, ptr %out, align 8
  ret i64 %unsigned
}
define internal i64 @word_divisor(i16 %x) {
entry:
  %value = and i16 %x, 32767
  %quotient = udiv i16 %value, 40000
  %wide = zext i16 %quotient to i64
  ret i64 %wide
}
define internal i64 @int_divisor(i32 %x) {
entry:
  %value = and i32 %x, 2147483647
  %rem = urem i32 %value, 4294967295
  %wide = sext i32 %rem to i64
  ret i64 %wide
}
define internal i64 @i63_divisor(i63 %x) {
entry:
  %value = and i63 %x, 4611686018427387903
  %rem = urem i63 %value, 9223372036854775807
  %wide = zext i63 %rem to i64
  ret i64 %wide
}
