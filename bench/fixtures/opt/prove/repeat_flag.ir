; iyi-ir 1
source_filename = "repeat_flag"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
define internal i32 @repeat_flag(i32 %x, i32 %y) {
entry:
  %pair = intrinsic llvm.sadd.with.overflow.i32(i32 %x, i32 %y)
  %flag = extractvalue { i32, i1 } %pair, 1
  br i1 %flag, label %overflow, label %ok
overflow:
  ret i32 -1
ok:
  %sum = extractvalue { i32, i1 } %pair, 0
  br i1 %flag, label %raise, label %done
raise:
  ret i32 -2
done:
  ret i32 %sum
}
