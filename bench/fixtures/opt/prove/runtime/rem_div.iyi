def sum_nonneg(n : Int32) : Int64
  total = 0_i64
  i = 0
  while i < n
    total = total + (i % 7).to_i64 + (i / 3).to_i64
    i = i + 1
  end
  total
end

def sum_signed : Int64
  total = 0_i64
  i = -10
  while i < 10
    total = total + (i % 7).to_i64 + (i / 3).to_i64
    i = i + 1
  end
  total
end

puts "nonneg=#{sum_nonneg(100)}"
puts "signed=#{sum_signed}"
puts "consts=#{(-7) % 3} #{(-8) % 3} #{7 % (-3)} #{(-7) / 2}"
