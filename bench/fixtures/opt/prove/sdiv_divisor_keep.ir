; iyi-ir 1
source_filename = "sdiv_divisor_keep"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
define internal i32 @sdiv_divisor_keep(i32 %x, i1 %c) {
entry:
  %n = and i32 %x, 255
  %d = select i1 %c, i32 -1, i32 3
  %q = sdiv i32 %n, %d
  ret i32 %q
}
