; iyi-ir 1
source_filename = "s1_nil_select"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
define internal i1 @nil_eq(i1 %c) {
entry:
  %tag = select i1 %c, i32 0, i32 69
  %r = icmp eq i32 0, %tag
  ret i1 %r
}
define internal i1 @nil_ne(i1 %c) {
entry:
  %tag = select i1 %c, i32 0, i32 69
  %r = icmp ne i32 %tag, 0
  ret i1 %r
}
define internal i1 @signed_order(i1 %c) {
entry:
  %v = select i1 %c, i8 -1, i8 1
  %r = icmp slt i8 0, %v
  ret i1 %r
}
define internal i1 @both_true(i1 %c) {
entry:
  %v = select i1 %c, i32 2, i32 3
  %r = icmp sgt i32 %v, 1
  ret i1 %r
}
define internal i1 @both_false(i1 %c) {
entry:
  %v = select i1 %c, i32 2, i32 3
  %r = icmp eq i32 %v, 1
  ret i1 %r
}
