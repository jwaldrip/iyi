; iyi-ir 1
source_filename = "s1_overflow_two"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
define internal i1 @smul_two(i32 %x) {
entry:
  %pair = intrinsic llvm.smul.with.overflow.i32(i32 %x, i32 2)
  %value = extractvalue { i32, i1 } %pair, 0
  %flag = extractvalue { i32, i1 } %pair, 1
  %eq = icmp eq i32 %value, 5
  %out = xor i1 %flag, %eq
  ret i1 %out
}
define internal i1 @ssub_left_zero(i32 %x) {
entry:
  %pair = intrinsic llvm.ssub.with.overflow.i32(i32 0, i32 %x)
  %flag = extractvalue { i32, i1 } %pair, 1
  ret i1 %flag
}
define internal i1 @sadd_i128(i128 %x) {
entry:
  %pair = intrinsic llvm.sadd.with.overflow.i128(i128 %x, i128 0)
  %flag = extractvalue { i128, i1 } %pair, 1
  ret i1 %flag
}
define internal { i32, i1 } @aggregate_user(i32 %x) {
entry:
  %pair = intrinsic llvm.sadd.with.overflow.i32(i32 %x, i32 0)
  ret { i32, i1 } %pair
}
define internal i1 @poison_flag() {
entry:
  %pair = intrinsic llvm.sadd.with.overflow.i32(i32 poison, i32 0)
  %flag = extractvalue { i32, i1 } %pair, 1
  ret i1 %flag
}
