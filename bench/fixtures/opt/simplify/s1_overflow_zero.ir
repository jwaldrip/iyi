; iyi-ir 1
source_filename = "s1_overflow_zero"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
define internal i32 @sadd_zero(i32 %x) {
entry:
  %pair = intrinsic llvm.sadd.with.overflow.i32(i32 %x, i32 0)
  %value = extractvalue { i32, i1 } %pair, 0
  %flag = extractvalue { i32, i1 } %pair, 1
  %out = select i1 %flag, i32 7, i32 %value
  ret i32 %out
}
define internal i1 @uadd_left_zero(i32 %x) {
entry:
  %pair = intrinsic llvm.uadd.with.overflow.i32(i32 0, i32 %x)
  %flag = extractvalue { i32, i1 } %pair, 1
  ret i1 %flag
}
define internal i32 @ssub_zero(i32 %x) {
entry:
  %pair = intrinsic llvm.ssub.with.overflow.i32(i32 %x, i32 0)
  %value = extractvalue { i32, i1 } %pair, 0
  %flag = extractvalue { i32, i1 } %pair, 1
  %out = select i1 %flag, i32 7, i32 %value
  ret i32 %out
}
define internal i1 @usub_zero(i32 %x) {
entry:
  %pair = intrinsic llvm.usub.with.overflow.i32(i32 %x, i32 0)
  %flag = extractvalue { i32, i1 } %pair, 1
  ret i1 %flag
}
define internal i32 @smul_one(i32 %x) {
entry:
  %pair = intrinsic llvm.smul.with.overflow.i32(i32 %x, i32 1)
  %value = extractvalue { i32, i1 } %pair, 0
  %flag = extractvalue { i32, i1 } %pair, 1
  %out = select i1 %flag, i32 7, i32 %value
  ret i32 %out
}
define internal i1 @umul_zero(i32 %x) {
entry:
  %pair = intrinsic llvm.umul.with.overflow.i32(i32 0, i32 %x)
  %flag = extractvalue { i32, i1 } %pair, 1
  ret i1 %flag
}
define internal i64 @umul_one(i64 %x) {
entry:
  %pair = intrinsic llvm.umul.with.overflow.i64(i64 1, i64 %x)
  %value = extractvalue { i64, i1 } %pair, 0
  %flag = extractvalue { i64, i1 } %pair, 1
  %out = select i1 %flag, i64 7, i64 %value
  ret i64 %out
}
define internal i32 @smul_zero(i32 %x) {
entry:
  %pair = intrinsic llvm.smul.with.overflow.i32(i32 %x, i32 0)
  %value = extractvalue { i32, i1 } %pair, 0
  %flag = extractvalue { i32, i1 } %pair, 1
  %out = select i1 %flag, i32 %x, i32 %value
  ret i32 %out
}
define internal i1 @umul_right_one_flag(i32 %x) {
entry:
  %pair = intrinsic llvm.umul.with.overflow.i32(i32 %x, i32 1)
  %flag = extractvalue { i32, i1 } %pair, 1
  ret i1 %flag
}
