; iyi-ir 1
source_filename = "s1_overflow_zero"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
define internal i32 @sadd_zero(i32 %x) {
entry:
  %out = select i1 false, i32 7, i32 %x
  ret i32 %out
}

define internal i1 @uadd_left_zero(i32 %x) {
entry:
  ret i1 false
}

define internal i32 @ssub_zero(i32 %x) {
entry:
  %out = select i1 false, i32 7, i32 %x
  ret i32 %out
}

define internal i1 @usub_zero(i32 %x) {
entry:
  ret i1 false
}

define internal i32 @smul_one(i32 %x) {
entry:
  %out = select i1 false, i32 7, i32 %x
  ret i32 %out
}

define internal i1 @umul_zero(i32 %x) {
entry:
  ret i1 false
}

define internal i64 @umul_one(i64 %x) {
entry:
  %out = select i1 false, i64 7, i64 %x
  ret i64 %out
}

define internal i32 @smul_zero(i32 %x) {
entry:
  %out = select i1 false, i32 %x, i32 0
  ret i32 %out
}

