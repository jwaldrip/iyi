; iyi-ir 1
source_filename = "s1_parity_by_three"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
define internal i1 @by_three(i32 %x) {
entry:
  %r = srem i32 %x, 3
  %test = icmp eq i32 %r, 0
  ret i1 %test
}
define internal i1 @negative_divisor(i32 %x) {
entry:
  %r = srem i32 %x, -2
  %test = icmp eq i32 %r, 0
  ret i1 %test
}
define internal i1 @not_zero(i32 %x) {
entry:
  %r = urem i32 %x, 4
  %test = icmp eq i32 %r, 1
  ret i1 %test
}
define internal i1 @ordered_compare(i32 %x) {
entry:
  %r = urem i32 %x, 4
  %test = icmp ult i32 %r, 0
  ret i1 %test
}
