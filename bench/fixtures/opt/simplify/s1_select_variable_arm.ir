; iyi-ir 1
source_filename = "s1_select_variable_arm"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
define internal i1 @variable_arm(i1 %c, i32 %x) {
entry:
  %tag = select i1 %c, i32 %x, i32 69
  %r = icmp eq i32 0, %tag
  ret i1 %r
}
define internal i1 @undef_condition() {
entry:
  %tag = select i1 undef, i32 0, i32 69
  %r = icmp eq i32 0, %tag
  ret i1 %r
}
define internal i1 @pointer_condition(ptr %p) {
entry:
  %address = ptrtoint ptr %p to i64
  %c = icmp eq i64 %address, 0
  %tag = select i1 %c, i32 0, i32 69
  %r = icmp eq i32 0, %tag
  ret i1 %r
}
