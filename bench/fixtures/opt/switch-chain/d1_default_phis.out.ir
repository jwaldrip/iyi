; iyi-ir 1
source_filename = "d1_default_phis"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
define external i32 @dispatch(i32 %x, i1 %choose) {
entry:
  br i1 %choose, label %head, label %external
external:
  br label %default
head:
  switch i32 %x, label %default [ i32 0, label %merge, i32 1, label %merge, i32 2, label %arm2, i32 3, label %arm3 ]
merge:
  %m = phi i32 [ 99, label %head ]
  ret i32 %m
arm2:
  ret i32 2
arm3:
  ret i32 3
default:
  %p = phi i32 [ 77, label %external ], [ 42, label %head ]
  ret i32 %p
}
