; iyi-ir 1
source_filename = "d1_duplicate"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
define external i32 @dispatch(i32 %x, i32 %y) {
entry:
  switch i32 %x, label %default [ i32 0, label %arm0, i32 1, label %arm1, i32 3, label %arm3 ]
arm0:
  ret i32 0
arm1:
  ret i32 1
arm2:
  ret i32 2
arm3:
  ret i32 3
default:
  unreachable
}
