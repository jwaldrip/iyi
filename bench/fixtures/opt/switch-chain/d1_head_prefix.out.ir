; iyi-ir 1
source_filename = "d1_head_prefix"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
define external i32 @dispatch(i32 %x) {
entry:
  %s = add i32 %x, 1
  switch i32 %s, label %default [ i32 -1, label %a0, i32 0, label %a1, i32 1, label %a2, i32 2, label %a3 ]
a0:
  ret i32 0
a1:
  ret i32 1
a2:
  ret i32 2
a3:
  ret i32 3
default:
  ret i32 9
}
