; iyi-ir 1
source_filename = "d1_range_arm"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
declare external i1 @range(i32)
define external i32 @dispatch(i32 %x) {
entry:
  %c0 = icmp eq i32 %x, 0
  br i1 %c0, label %arm0, label %b1
b1:
  %c1 = icmp eq i32 %x, 1
  br i1 %c1, label %arm1, label %b2
b2:
  %c2 = icmp eq i32 %x, 2
  br i1 %c2, label %arm2, label %b3
b3:
  %r = call i1 (i32) @range(i32 %x)
  br i1 %r, label %arm3, label %b4
b4:
  %c4 = icmp eq i32 %x, 4
  br i1 %c4, label %arm4, label %b5
b5:
  %c5 = icmp eq i32 %x, 5
  br i1 %c5, label %arm5, label %b6
b6:
  %c6 = icmp eq i32 %x, 6
  br i1 %c6, label %arm6, label %default
arm0:
  ret i32 0
arm1:
  ret i32 1
arm2:
  ret i32 2
arm3:
  ret i32 3
arm4:
  ret i32 4
arm5:
  ret i32 5
arm6:
  ret i32 6
default:
  unreachable
}
