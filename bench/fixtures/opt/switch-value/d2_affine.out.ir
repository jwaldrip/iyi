; iyi-ir 1
source_filename = "d2_affine"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
define external i32 @dispatch(i32 %x) {
entry:
  %switch.selector = freeze i32 %x
  %switch.index = sub i32 %switch.selector, 10
  %switch.affine.in_range = icmp ule i32 %switch.index, 3
  %switch.affine.multiply = mul i32 %switch.index, 2
  %switch.affine.add = add i32 %switch.affine.multiply, 7
  br i1 %switch.affine.in_range, label %join, label %otherwise
otherwise:
  ret i32 -100
join:
  %result = phi i32 [ %switch.affine.add, label %entry ]
  ret i32 %result
}

