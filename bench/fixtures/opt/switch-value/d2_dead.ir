; iyi-ir 1
source_filename = "d2_dead"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"

define internal i32 @dead(i32 %x) {
entry:
  switch i32 %x, label %otherwise [ i32 5, label %a0, i32 6, label %a1, i32 7, label %a2, i32 8, label %a3 ]
a0:
  br label %join
a1:
  br label %join
a2:
  br label %join
a3:
  br label %join
otherwise:
  ret i32 -1
join:
  %result = phi i32 [ 2, label %a0 ], [ 9, label %a1 ], [ 4, label %a2 ], [ 15, label %a3 ]
  ret i32 %result
}

define external i32 @live(i32 %x) {
entry:
  switch i32 %x, label %otherwise [ i32 5, label %a0, i32 6, label %a1, i32 7, label %a2, i32 8, label %a3 ]
a0:
  br label %join
a1:
  br label %join
a2:
  br label %join
a3:
  br label %join
otherwise:
  ret i32 -1
join:
  %result = phi i32 [ 2, label %a0 ], [ 9, label %a1 ], [ 4, label %a2 ], [ 15, label %a3 ]
  ret i32 %result
}
