; iyi-ir 1
source_filename = "d2_direct_join"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
define external i32 @dispatch(i32 %x) {
entry:
  switch i32 %x, label %otherwise [ i32 5, label %join, i32 6, label %a1, i32 7, label %a2, i32 8, label %a3 ]
a1:
  br label %join
a2:
  br label %join
a3:
  br label %join
otherwise:
  ret i32 -1
join:
  %result = phi i32 [ 17, label %entry ], [ 33, label %a1 ], [ 44, label %a2 ], [ 55, label %a3 ]
  ret i32 %result
}
