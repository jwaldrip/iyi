; iyi-ir 1
source_filename = "d2_direct_join"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
@__iyi_switch_value.dispatch.0 = private constant [4 x i32] [ i32 17, i32 33, i32 44, i32 55 ]
define external i32 @dispatch(i32 %x) {
entry:
  %switch.selector = freeze i32 %x
  %switch.index = sub i32 %switch.selector, 5
  %switch.table.in_range = icmp ule i32 %switch.index, 3
  br i1 %switch.table.in_range, label %switch.value, label %otherwise
otherwise:
  ret i32 -1
join:
  %result = phi i32 [ %switch.table.load, label %switch.value ]
  ret i32 %result
switch.value:
  %switch.index.extend = zext i32 %switch.index to i64
  %switch.table.address = getelementptr inbounds i32, ptr @__iyi_switch_value.dispatch.0, i64 %switch.index.extend
  %switch.table.load = load i32, ptr %switch.table.address, align 4
  br label %join
}

