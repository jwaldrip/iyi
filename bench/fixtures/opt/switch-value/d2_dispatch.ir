current_def24:
  br label %exit
current_def26:
  br label %exit
current_def28:
  br label %exit
current_def30:
  br label %exit
current_def32:
  br label %exit
current_def34:
  br label %exit
current_def36:
  br label %exit
current_def38:
  br label %exit
current_def40:
  br label %exit
current_def42:
  br label %exit
current_def44:
  br label %exit
current_def46:
  br label %exit
next_def54:
  unreachable
exit:
  %value = phi i32 [ 23, label %current_def ], [ 22, label %current_def2 ], [ 21, label %current_def4 ], [ 20, label %current_def6 ], [ 19, label %current_def8 ], [ 18, label %current_def10 ], [ 17, label %current_def12 ], [ 16, label %current_def14 ], [ 15, label %current_def16 ], [ 14, label %current_def18 ], [ 13, label %current_def20 ], [ 12, label %current_def22 ], [ 11, label %current_def24 ], [ 10, label %current_def26 ], [ 9, label %current_def28 ], [ 8, label %current_def30 ], [ 7, label %current_def32 ], [ 6, label %current_def34 ], [ 5, label %current_def36 ], [ 4, label %current_def38 ], [ 3, label %current_def40 ], [ 2, label %current_def42 ], [ 1, label %current_def44 ], [ 0, label %current_def46 ]
  %wide = sext i32 %value to i64
  ret i64 %wide
}
