; iyi-ir 1
source_filename = "d2_dispatch"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"

define internal i64 @dispatch(ptr %p) {
entry:
  %obj = load ptr, ptr %p, align 8
  %type_id = getelementptr inbounds i8, ptr %obj, i32 -4
  %t = load i32, ptr %type_id, align 4
  switch i32 %t, label %next_def54 [ i32 68, label %current_def, i32 67, label %current_def2, i32 66, label %current_def4, i32 65, label %current_def6, i32 64, label %current_def8, i32 63, label %current_def10, i32 62, label %current_def12, i32 61, label %current_def14, i32 60, label %current_def16, i32 59, label %current_def18, i32 58, label %current_def20, i32 57, label %current_def22, i32 56, label %current_def24, i32 55, label %current_def26, i32 54, label %current_def28, i32 53, label %current_def30, i32 52, label %current_def32, i32 51, label %current_def34, i32 50, label %current_def36, i32 49, label %current_def38, i32 48, label %current_def40, i32 47, label %current_def42, i32 46, label %current_def44, i32 45, label %current_def46 ]
current_def:
  br label %exit
current_def2:
  br label %exit
current_def4:
  br label %exit
current_def6:
  br label %exit
current_def8:
