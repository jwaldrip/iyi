; iyi-ir 1
source_filename = "d2_duplicate"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
@input = internal global i32 1
define external i32 @dispatch(i32 %x) {
entry:
  %c0 = icmp eq i32 %x, 0
  br i1 %c0, label %a0, label %b1
b1:
  %c1 = icmp eq i32 %x, 1
  br i1 %c1, label %a1, label %b2
b2:
  %c2 = icmp eq i32 %x, 1
  br i1 %c2, label %a2, label %b3
b3:
  %c3 = icmp eq i32 %x, 2
  br i1 %c3, label %a3, label %b4
b4:
  %c4 = icmp eq i32 %x, 3
  br i1 %c4, label %a4, label %otherwise
a0:
  br label %join
a1:
  br label %join
a2:
  br label %join
a3:
  br label %join
a4:
  br label %join
otherwise:
  ret i32 -1
join:
  %v = phi i32 [ 0, label %a0 ], [ 11, label %a1 ], [ 999, label %a2 ], [ 22, label %a3 ], [ 33, label %a4 ]
  ret i32 %v
}
define external i32 @main() {
entry:
  %input_value = load i32, ptr @input, align 4
  %result = call i32 (i32) @dispatch(i32 %input_value)
  %ok = icmp eq i32 %result, 11
  %status = select i1 %ok, i32 0, i32 77
  ret i32 %status
}
