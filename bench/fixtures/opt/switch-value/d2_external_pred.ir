; iyi-ir 1
source_filename = "d2_external_pred"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
define external i32 @dispatch(i1 %gate, i32 %x, i32 %other_value) {
entry:
  br i1 %gate, label %head, label %other
head:
  switch i32 %x, label %otherwise [ i32 10, label %a0, i32 11, label %a1, i32 12, label %a2, i32 13, label %a3 ]
a0:
  br label %join
a1:
  br label %join
a2:
  br label %join
a3:
  br label %join
other:
  br label %join
otherwise:
  ret i32 -1
join:
  %result = phi i32 [ 0, label %a0 ], [ 1, label %a1 ], [ 2, label %a2 ], [ 3, label %a3 ], [ %other_value, label %other ]
  ret i32 %result
}
