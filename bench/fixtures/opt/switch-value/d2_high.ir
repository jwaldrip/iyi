; iyi-ir 1
source_filename = "d2_high"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
define external i32 @dispatch(i64 %x) {
entry:
  switch i64 %x, label %otherwise [ i64 -4, label %a0, i64 -3, label %a1, i64 -2, label %a2, i64 -1, label %a3 ]
a0:
  br label %join
a1:
  br label %join
a2:
  br label %join
a3:
  br label %join
otherwise:
  ret i32 0
join:
  %result = phi i32 [ 3, label %a0 ], [ 5, label %a1 ], [ 7, label %a2 ], [ 9, label %a3 ]
  ret i32 %result
}
