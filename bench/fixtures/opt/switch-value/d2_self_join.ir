; iyi-ir 1
source_filename = "d2_self_join"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
define external i32 @dispatch(i32 %x) {
entry:
  br label %head
head:
  %v = phi i32 [ 0, label %entry ], [ 7, label %head ], [ 1, label %a1 ], [ 2, label %a2 ], [ 3, label %a3 ]
  switch i32 %x, label %done [ i32 10, label %head, i32 11, label %a1, i32 12, label %a2, i32 13, label %a3 ]
a1:
  br label %head
a2:
  br label %head
a3:
  br label %head
done:
  ret i32 %v
}
