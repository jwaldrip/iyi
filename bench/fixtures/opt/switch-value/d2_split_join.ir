; iyi-ir 1
source_filename = "d2_split_join"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"

define external i32 @dispatch(i32 %x) {
entry:
  switch i32 %x, label %otherwise [ i32 0, label %a0, i32 1, label %a1, i32 2, label %a2, i32 3, label %a3 ]
a0:
  br label %join
a1:
  br label %other_join
a2:
  br label %join
a3:
  br label %join
otherwise:
  unreachable
join:
  %v = phi i32 [ 0, label %a0 ], [ 2, label %a2 ], [ 3, label %a3 ]
  ret i32 %v
other_join:
  %w = phi i32 [ 1, label %a1 ]
  ret i32 %w
}
