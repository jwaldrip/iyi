; iyi-ir 1
source_filename = "d2_table"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
@__iyi_switch_value.dispatch.0 = private constant i8 0
define external i32 @dispatch(i32 %x) {
entry:
  switch i32 %x, label %otherwise [ i32 5, label %a0, i32 6, label %a1, i32 7, label %a2, i32 8, label %a3, i32 9, label %a4 ]
a0:
  br label %join
a1:
  br label %join
a2:
  br label %join
a3:
  br label %join
a4:
  br label %join
otherwise:
  ret i32 -100
join:
  %result = phi i32 [ 41, label %a0 ], [ -4, label %a1 ], [ 7, label %a2 ], [ 92, label %a3 ], [ 0, label %a4 ]
  %flag = phi i1 [ true, label %a0 ], [ false, label %a1 ], [ true, label %a2 ], [ true, label %a3 ], [ false, label %a4 ]
  %wide = zext i1 %flag to i32
  %sum = add i32 %result, %wide
  ret i32 %sum
}
