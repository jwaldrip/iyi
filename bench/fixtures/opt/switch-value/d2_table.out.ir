; iyi-ir 1
source_filename = "d2_table"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
@__iyi_switch_value.dispatch.0 = private constant i8 0
@__iyi_switch_value.dispatch.1 = private constant [5 x i32] [ i32 41, i32 -4, i32 7, i32 92, i32 0 ]
@__iyi_switch_value.dispatch.2 = private constant [5 x i8] [ i8 1, i8 0, i8 1, i8 1, i8 0 ]
define external i32 @dispatch(i32 %x) {
entry:
  %switch.selector = freeze i32 %x
  %switch.index = sub i32 %switch.selector, 5
  %switch.table.in_range = icmp ule i32 %switch.index, 4
  br i1 %switch.table.in_range, label %switch.value, label %otherwise
otherwise:
  ret i32 -100
join:
  %result = phi i32 [ %switch.table.load, label %switch.value ]
  %flag = phi i1 [ %switch.table.truncate, label %switch.value ]
  %wide = zext i1 %flag to i32
  %sum = add i32 %result, %wide
  ret i32 %sum
switch.value:
  %switch.index.extend = zext i32 %switch.index to i64
  %switch.table.address = getelementptr inbounds i32, ptr @__iyi_switch_value.dispatch.1, i64 %switch.index.extend
  %switch.table.load = load i32, ptr %switch.table.address, align 4
  %switch.table.address1 = getelementptr inbounds i8, ptr @__iyi_switch_value.dispatch.2, i64 %switch.index.extend
  %switch.table.load2 = load i8, ptr %switch.table.address1, align 1
  %switch.table.truncate = trunc i8 %switch.table.load2 to i1
  br label %join
}

