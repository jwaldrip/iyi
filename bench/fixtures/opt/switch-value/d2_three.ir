; iyi-ir 1
source_filename = "d2_three"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
@dummy = internal global i32 0
@effect = internal global i32 0

define external i32 @dispatch(i32 %x) {
entry:
  switch i32 %x, label %otherwise [ i32 10, label %a0, i32 11, label %a1, i32 12, label %a2 ]
a0:
  br label %join
a1:
  br label %join
a2:
  br label %join
otherwise:
  unreachable
join:
  %result = phi i32 [ 0, label %a0 ], [ 1, label %a1 ], [ 2, label %a2 ]
  ret i32 %result
}
