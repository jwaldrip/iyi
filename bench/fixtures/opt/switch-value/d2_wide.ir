; iyi-ir 1
source_filename = "d2_wide"
target triple = "aarch64-apple-darwin"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
@dummy = internal global i32 0
@effect = internal global i32 0

define external i128 @dispatch(i128 %x) {
entry:
  switch i128 %x, label %otherwise [ i128 10, label %a0, i128 11, label %a1, i128 12, label %a2, i128 13, label %a3 ]
a0:
  br label %join
a1:
  br label %join
a2:
  br label %join
a3:
  br label %join
otherwise:
  unreachable
join:
  %result = phi i128 [ 0, label %a0 ], [ 1, label %a1 ], [ 2, label %a2 ], [ 3, label %a3 ]
  ret i128 %result
}
