class LiteralBase
end

class LiteralLeaf < LiteralBase
end

class LiteralOther < LiteralBase
end

def literal_leaf : LiteralLeaf
  LiteralLeaf.new
end

def accepts_base(xs : Array(LiteralBase)) : Int32
  xs.size
end

def accepts_nested(xs : Array(Array(LiteralBase))) : Int32
  xs.size
end

def accepts_splat(*xs : Array(LiteralBase)) : Int32
  xs.size
end

def accepts_block(xs : Array(LiteralBase), &block : Int32 -> Int32) : Int32
  yield xs.size
end

assigned = [literal_leaf]
puts accepts_base([literal_leaf])
puts accepts_base(assigned)
puts accepts_base([literal_leaf, LiteralOther.new])
puts accepts_base([] of LiteralLeaf)
puts accepts_nested([[literal_leaf]])
puts accepts_splat([literal_leaf])
puts accepts_block([literal_leaf]) { |size| size }
