@[Unsafe("fixture: a top-level fun is a C function the compiler does not check")]

def inner_def(x : Int32) : Int32
  x
end

# A fun's macro body is visited and expanded before its branch's call is typed.
fun splice_entry(x : Int32) : Int32
  {% if flag?(:darwin) %}
    inner_def(x)
  {% else %}
    inner_def(x + 1)
  {% end %}
end

splice_entry(3)
