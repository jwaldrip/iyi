class TupleIndexProbe
  def scalar : Int32
    t = {1, "s", 3_u8}
    x = t[0]
    x + 1
  end

  def text_size : Int32
    t = {1, "s"}
    t[1].bytesize
  end

  def pair_size : Int32
    pairs = [{1, "a"}, {2, "b"}]
    n = 0
    pairs.each do |pair|
      n = n + pair[0] + pair[1].bytesize
    end
    n
  end
end
RANGE = 0..1


members = {1, "s"}
single = members[0]
singleton = members[0..0]
empty = members[1...1]
last = members[-1]
absent = members[4]?
tail_empty = members[2..]
constant_range = members[RANGE]
tuple_type = typeof(members)
meta_single = tuple_type[0]
meta_range = tuple_type[0..0]
meta_empty = tuple_type[1...1]
named = {a: 1, b: "s"}
named_value = named[:a]

probe = TupleIndexProbe.new
scalar = probe.scalar
text_size = probe.text_size
pair_size = probe.pair_size
