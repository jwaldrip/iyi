class MatchAnimal
end

class MatchDog < MatchAnimal
end

class MatchCat < MatchAnimal
end

class MatchHolder(T)
  def put(value : T) : Nil
  end
end

def match_holder : MatchHolder(MatchAnimal)
  MatchHolder(MatchAnimal).new
end

