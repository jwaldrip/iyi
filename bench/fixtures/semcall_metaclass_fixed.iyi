# A non-forall metaclass parameter (Bar.class) takes only a metaclass of Bar. An instance
# of Bar, an instance of another class, or a literal does not match it, and the refusal
# is the one hosted gives. Read by bench/selfhost_semantic_calls_exercise.sh.

class Bar
end

class Baz
end

def g(t : Bar.class) : Int32
  1
end

# call g(instance(Bar))
# call g(instance(Baz))
# call g(1)
# error g(1)
# error g("a")
# error g(nil)
