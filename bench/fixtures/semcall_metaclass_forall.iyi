# A forall metaclass parameter (T.class) given an argument that is not a metaclass, either
# an instance (written as instance(Bar)) or a literal, positionally or by name. The hosted
# restriction is no match, so the lookup finds no def, for a class method and for the
# constructor, whose generated new keeps the forall names. Read by
# bench/selfhost_semantic_calls_exercise.sh.

class Bar
end

class Foo
  def self.one(t : T.class) : Int32 forall T
    1
  end

  def initialize(t : T.class) forall T
    @x = 1
  end
end

# call Foo.one(instance(Bar))
# call Foo.one(1)
# call Foo.new(instance(Bar))
# call Foo.new(1)
# call Foo.new(t: instance(Bar))
