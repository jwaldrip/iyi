# Calls on prelude types: generic receivers (Array(Int32), Hash(Int32, String)),
# String, Int32, and methods inherited from Object, reached through declared
# returns. Read by bench/selfhost_semantic_calls_exercise.sh with the prelude loaded.
# `# call` lines only: an `# error` on these receivers would type the stub bodies.
#
# waiting: Int32#to_i32, Int32#+ and Int32#< are generated by {% for %} in
# src/iyi/number.iyi:31, and the port's declaration pass does not expand them yet.
# The hosted oracle answers them (Int32::to_i32() -> Int32, Int32::+(Int32) -> Int32,
# Int32::<(Int32) -> Bool). They are not compared until the declarations slice
# expands the prelude's macros.

def arr(x : Int32) : Array(Int32)
  nil
end

def hsh(x : Int32) : Hash(Int32, String)
  nil
end

def str(x : Int32) : String
  nil
end

def num(x : Int32) : Int32
  nil
end

# call arr(1).size
# call arr(1).each { 1 }
# call arr(1).<<(2)
# call arr(1).nope(1)
# call hsh(1).size
# call str(1).size
# call str(1).to_s
# call num(1).to_s
# call num(1).class
# call num(1).nope(1)
