# A pointer to a generic struct instance keeps that instance's variables.
# Hosted IyiChanLock holds Pointer(Atomic(UInt64)); the typed dump includes
# Atomic(UInt64)#@value : UInt64.
struct Atomic(T)
  @value : T

  def initialize(@value : T)
  end
end

class Lock
  @word : Pointer(Atomic(UInt64))

  def initialize(@word : Pointer(Atomic(UInt64)))
  end
end
