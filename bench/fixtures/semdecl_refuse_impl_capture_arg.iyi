# An argument restriction names `A`, which the rename would capture: refused (the argument restriction is walked).
module samples/semdecl_refuse_impl_capture_arg

pub trait Show
  abstract def show : String
end

pub struct Pair(A, B)
  getter first : A
  getter second : B

  def initialize(@first : A, @second : B)
  end
end

impl Show for Pair(X, Y) forall X, Y
  def show : String
    "pair"
  end

  def label(v : A) : String
    "first"
  end
end
