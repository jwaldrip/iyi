# The body names `A`, a declared parameter of `Pair(A, B)` that the impl's own `X` would rename into: the rename would
# capture it, so the impl is refused, the same as hosted's TypeParamRenamer.
module samples/semdecl_refuse_impl_capture_body

pub trait Show
  abstract def show : String
end

pub struct Pair(A, B)
  getter first : A
  getter second : B

  def initialize(@first : A, @second : B)
  end
end

impl Show for Pair(X, Y) forall X, Y
  def show : String
    A.name
  end
end
