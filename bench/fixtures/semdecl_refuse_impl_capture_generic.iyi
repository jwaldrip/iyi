# A generic argument in a return type names `A`, which the rename would capture: refused (generic arguments are walked).
module samples/semdecl_refuse_impl_capture_generic

pub trait Show
  abstract def show : String
end

pub struct Pair(A, B)
  getter first : A
  getter second : B

  def initialize(@first : A, @second : B)
  end
end

impl Show for Pair(X, Y) forall X, Y
  def show : String
    "pair"
  end

  def make : Array(A)
    [] of A
  end
end
