# A proc literal in the body names `A` inside its body: refused (the literal's body is walked, as hosted's base walk does).
module samples/semdecl_refuse_impl_capture_proclit

pub trait Show
  abstract def show : String
end

pub struct Pair(A, B)
  getter first : A
  getter second : B

  def initialize(@first : A, @second : B)
  end
end

impl Show for Pair(X, Y) forall X, Y
  def show : String
    "pair"
  end

  def later : Int32
    f = -> { A.name }
    1
  end
end
