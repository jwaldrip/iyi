# A union return type names `A`, which the rename would capture: refused (the union's members are walked).
module samples/semdecl_refuse_impl_capture_union

pub trait Show
  abstract def show : String
end

pub struct Pair(A, B)
  getter first : A
  getter second : B

  def initialize(@first : A, @second : B)
  end
end

impl Show for Pair(X, Y) forall X, Y
  def show : String
    "pair"
  end

  def maybe(v : X) : A | Nil
    nil
  end
end
