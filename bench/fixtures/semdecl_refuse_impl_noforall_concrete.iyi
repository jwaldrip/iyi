# `impl Show for Box(Int32)` without `forall`: refused as a specialised impl, which iyi does not have.
module samples/semdecl_refuse_impl_noforall_concrete

pub trait Show
  abstract def show : String
end

pub struct Box(T)
  getter value : T

  def initialize(@value : T)
  end
end

impl Show for Box(Int32)
  def show : String
    "box"
  end
end
