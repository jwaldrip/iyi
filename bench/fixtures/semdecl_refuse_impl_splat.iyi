# `impl Show for Tup(*X, Y) forall X, Y` puts the `*` on a parameter that is not the target's splat: refused, and the
# text says to bind it without the star.
module samples/semdecl_refuse_impl_splat

pub trait Show
  abstract def show : String
end

pub struct Tup(A, *B)
  getter first : A

  def initialize(@first : A)
  end
end

impl Show for Tup(*X, Y) forall X, Y
  def show : String
    "tup"
  end
end
