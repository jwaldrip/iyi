# A name declared before a macro block, then read through the block.
# The site's expansion is parsed knowing that name (inline_macros.iyi, the parser's var scope).
# A plain read of the name still types when the scope is dropped: a zero-argument call finds the
# local the earlier assignment recorded. pointerof does not. It refuses an operand that is not
# a local, and at the top level that refusal belongs to no def, so the gate's root-refusal count
# rises. The fun below is the same shape inside a fun body (type_nodes.iyi visit_fun_def).
seminl_prior = 1
{% if true %}
  seminl_prior_ptr = pointerof(seminl_prior)
{% end %}
seminl_prior_ptr

@[Unsafe("a C function is not checked by the compiler")]
fun probe_locals(argc : Int32) : Int32
  x = 1
  {% if true %}
    y = x + 1
  {% end %}
  argc + y
end
probe_locals(0)
