class Animal
end

class Dog < Animal
end

class Cat < Animal
end

module Walk
end

module Tagged
end

class Crate
  include Walk
end

class Bin
  include Walk
end

class Box(T)
end

alias Id = Int32
alias Chain = Id
alias Pets = Dog | Cat
alias Named = Animal

lib LibC
  type Handle = Int32
end

