import std/process::{Process, ProcessResult}

result = Process.run("/bin/sh", ["-c", "printf process-ok; exit 7"], capture: false)
raise "process did not return a result" unless result.is_a?(ProcessResult)
finished = result.as(ProcessResult)
raise "wrong child exit" unless finished.exit_code == 7
raise "inherited stdout was captured" unless finished.stdout.empty?
raise "inherited stderr was captured" unless finished.stderr.empty?
puts ":parent-ok"
