struct Large
  @a : Int64
  @b : Int64
  @c : Int64
  @d : Int64
  @e : Int64
  @f : Int64
  @g : Int64
  @h : Int64
  @i : Int64
  @j : Int64
  @k : Int64
  @l : Int64
  @m : Int64
  @n : Int64
  @o : Int64
  @p : Int64
  @q : Int64

  def value : Int64
    @q
  end
end

lib LibC
  fun calloc(count : UInt64, size : UInt64) : Void*
  fun exit(status : Int32) : NoReturn
end

def consume(value : Large) : Int32
  value.value == 0_i64 ? 7 : 1
end

storage = LibC.calloc(1_u64, sizeof(Large).to_u64).as(Pointer(Large))
LibC.exit(consume(storage.value))
