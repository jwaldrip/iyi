module bench/lib/lower_gate

# The lowering gates' shared driver code: the bench/selfhost_lower_core_exercise.iyi and
# bench/selfhost_lower_calls_exercise.iyi drivers import it and neither copies it.
#
# It analyses a fixture with the port's semantic passes, makes the IR module of an
# oracle's triple, normalises both sides the same way (the driver header of each gate
# lists what is dropped), compares the modules function by function, and runs the
# `lower` and `emit` modes.
#
# `stand_in_libs` is the one place a gate reads a lib that the analysis does not type
# yet (NEEDS.md, lowering calls row 31): see stand_in_lib_types. Only the calls gate sets it.

import compiler/syntax/ast::{ASTNode, Def, Expressions, FunDef, LibDef}
import compiler/syntax/parser::{Parser}
import compiler/semantic/top_level::{LibType, SemanticProgram, TopLevelVisitor}
import compiler/semantic/main_visitor::{MainVisitor}
import compiler/semantic/normalizer::{NormalizerProgram}
import compiler/semantic/recursive_struct_checker::{RecursiveStructChecker}
import compiler/ir/module::{Module}
import compiler/ir/layout::{LayoutError}
import compiler/ir/parser::{parse, IrParseError}
import compiler/ir/printer::{print}
import compiler/platform/target::{Target}
import compiler/lower/typer::{LowerTyper}
import compiler/lower/lower::{codegen_program}
import bench/lib/primitive_stand_in::{stand_in_primitive_types}

# The parsed and analysed fixture: the tree and the semantic pass that typed it.
pub class Analysis
  getter root : ASTNode
  getter visitor : MainVisitor

  def initialize(@root : ASTNode, @visitor : MainVisitor)
  end
end

# Stand-in for the semantic typing of `lib` definitions (NEEDS.md, lowering calls row 31).
# The analysis records a lib's funs as names only and types no LibDef node, so a call
# through a lib has no target to read. Here each LibDef is typed as nil, and each of its
# funs is registered in the lib as a def that has no body and returns its declared type:
# the analysis then types a call to it the way the hosted analysis does. The lowering
# reads the lib call from the call node, the lib's funs and these defs, and never lowers
# the stand-in bodies (there are none).
pub def stand_in_lib_types(root : ASTNode, prog : SemanticProgram, mv : MainVisitor) : Nil
  top = [] of ASTNode
  if root.is_a?(Expressions)
    top = root.as(Expressions).expressions
  else
    top << root
  end
  top.each do |node|
    next unless node.is_a?(LibDef)
    lib_node = node.as(LibDef)
    mv.set_type(lib_node, prog.nil_type)
    lib_type = prog.lookup_type_node(lib_node.name.as(ASTNode), prog)
    the_lib = lib_type.as(LibType)
    funs = [] of ASTNode
    body = lib_node.body
    if body.is_a?(Expressions)
      funs = body.as(Expressions).expressions
    else
      funs << body
    end
    funs.each do |f|
      next unless f.is_a?(FunDef)
      decl = f.as(FunDef)
      the_lib.metaclass.add_def(Def.new(decl.name, decl.args, nil, nil, nil, decl.return_type))
    end
  end
end

# The analysis of a fixture alone, with no prelude, in the order the typed-dump tool runs
# the passes. `stand_in_libs` runs stand_in_lib_types between the declarations and the
# main visitor.
pub def analyse(source : String, filename : String, stand_in_libs : Bool) : Analysis
  parser = Parser.new(source, filename)
  root = parser.parse
  normalizer = NormalizerProgram.new
  normalizer.iyi_prelude = false
  root = normalizer.normalize(root)
  prog = SemanticProgram.new
  tl = TopLevelVisitor.new(prog)
  root.accept(tl)
  tl.finish
  mv = MainVisitor.new(prog)
  if stand_in_libs
    stand_in_lib_types(root, prog, mv)
    stand_in_primitive_types(root, prog, mv)
  end
  root.accept(mv)
  RecursiveStructChecker.new(prog).run
  Analysis.new(root, mv)
end

pub def ir_module(triple : String) : Module
  made = Module.for_target("main_module", Target.new(triple))
  raise made.as(LayoutError).to_s if made.is_a?(LayoutError)
  made.as(Module)
end

# The triple an oracle module was built for, from its `target triple` line.
pub def triple_of(text : String) : String
  text.split("\n").each do |line|
    if line.starts_with?("target triple")
      return line.split("\"")[1]
    end
  end
  raise "the oracle module names no target triple"
end

# The IR text of a module, normalised the way the gates compare it.
pub def normalised_lines(text : String, hosted : String) : Array(String)
  out = [] of String
  text.split("\n").each do |line|
    stripped = line.strip
    next if stripped.empty?
    next if stripped.starts_with?(";")
    next if stripped.starts_with?("source_filename")
    next if stripped.starts_with?("attributes #")
    next if stripped.starts_with?("declare") && stripped.includes?("@printf(")
    next if stripped.starts_with?("@") && stripped.includes?(hosted) || stripped.starts_with?("%Nil = type")
    next if stripped.includes?("@\"'")
    next if stripped.includes?("@\"''\"")
    if pidx = line.index(" ; preds")
      out << line[0, pidx]
      next
    end
    if idx = line.index(" #")
      out << line[0, idx] + " {"
    elsif line.starts_with?("define ") && (bracket = line.index(") ["))
      out << line[0, bracket.as(Int32) + 1] + " {"
    else
      out << line
    end
  end
  out
end

# The tokens of an attribute list, sorted and joined by spaces, so the two sides compare as sets.
pub def sorted_tokens(text : String, separator : String) : String
  tokens = [] of String
  text.split(separator).each do |t|
    tokens << t.strip unless t.strip.empty?
  end
  tokens.sorted.join(" ")
end

# The oracle's function attributes by function name: each `define`'s attribute group, read from
# the oracle's text (`attributes #N = { ... }`), because the port's parser keeps no groups.
pub def oracle_attr_map(raw : String) : Hash(String, String)
  groups = Hash(String, String).new
  raw.split("\n").each do |line|
    next unless line.starts_with?("attributes #")
    open = line.index("{")
    close = line.index("}")
    next if open.nil? || close.nil?
    groups[line.split(" ")[1]] = sorted_tokens(line[open.as(Int32) + 1, close.as(Int32) - open.as(Int32) - 1], " ")
  end
  out = Hash(String, String).new
  raw.split("\n").each do |line|
    next unless line.starts_with?("define ")
    tokens = line.split(" ")
    ref = ""
    if tokens.size >= 2 && tokens[tokens.size - 2].starts_with?("#")
      ref = tokens[tokens.size - 2]
    end
    out[function_name(line)] = groups[ref]? || ""
  end
  out
end

# The printer's attribute list of each define line, from the bracket after its parameters.
pub def printed_attr_map(text : String) : Hash(String, String)
  out = Hash(String, String).new
  text.split("\n").each do |line|
    next unless line.starts_with?("define ")
    bracket = line.index(") [")
    close = line.index("] {")
    next if bracket.nil? || close.nil?
    open = bracket.as(Int32) + 3
    out[function_name(line)] = sorted_tokens(line[open, close.as(Int32) - open], ", ")
  end
  out
end

# Appends each lowered def's attribute tokens to its define line, so a difference in attributes
# is a difference in the line. Only the functions the calls and functions files lower (names that
# start with `*`) are compared this way; `main` and `__crystal_main` wait on the core hook
# (NEEDS.md, lowering calls row 34).
pub def attach_attrs(lines : Array(String), attrs : Hash(String, String)) : Array(String)
  out = [] of String
  lines.each do |line|
    if line.starts_with?("define ")
      name = function_name(line)
      if name.starts_with?("*")
        out << line + "  ; attrs: " + (attrs[name]? || "")
        next
      end
    end
    out << line
  end
  out
end

# The name of a `define`d function: the text between its @ and its parameter list.
pub def function_name(define_line : String) : String
  name = define_line.split("@")[1]
  if name.starts_with?("\"")
    name.split("\"")[1]
  else
    name.split("(")[0]
  end
end

# Splits normalised lines into the module-level items (globals, declares, headers)
# and the functions, by name, in the order they are printed.
pub def split_module(lines : Array(String)) : {Array(String), Hash(String, Array(String)), Array(String)}
  items = [] of String
  fns = Hash(String, Array(String)).new
  order = [] of String
  current : Array(String)? = nil
  current_name = ""
  lines.each do |line|
    if cur = current
      cur << line
      if line == "}"
        fns[current_name] = cur
        current = nil
      end
    elsif line.starts_with?("define ")
      current_name = function_name(line)
      order << current_name
      current = [line] of String
    else
      items << line
    end
  end
  {items, fns, order}
end

# Compares the oracle's lines with the port's, function by function, and prints each
# verdict. Returns how many of the oracle's functions the port reproduced exactly.
pub def compare(oracle : Array(String), port : Array(String)) : Int32
  o_items, o_fns, o_order = split_module(oracle)
  p_items, p_fns, p_order = split_module(port)
  identical = 0
  if o_items == p_items
    puts "  module-level: identical (#{o_items.size} lines)"
  else
    puts "  module-level: differs"
    puts "    oracle: #{o_items.join(" | ")}"
    puts "    port:   #{p_items.join(" | ")}"
  end
  o_order.each do |name|
    want = o_fns[name]
    got = p_fns[name]?
    if got.nil?
      puts "  @#{name}: MISSING from the port"
      next
    end
    if got == want
      identical += 1
      puts "  @#{name}: identical (#{want.size} lines)"
    else
      at = 0
      while at < want.size && at < got.size && want[at] == got[at]
        at += 1
      end
      puts "  @#{name}: differs at line #{at + 1}"
      puts "    oracle: #{want[at]?}"
      puts "    port:   #{got[at]?}"
    end
  end
  p_order.each do |name|
    puts "  @#{name}: EXTRA in the port" unless o_fns.has_key?(name)
  end
  identical
end

# The `oracle` mode: the hosted module, normalised, one line each.
pub def run_oracle(path : String, hosted : String) : Nil
  text = File.read(path)
  parsed = parse(text)
  if parsed.is_a?(IrParseError)
    raise parsed.as(IrParseError).to_s
  end
  normalised_lines(print(parsed.as(Module)), hosted).each { |line| puts line }
end

# The `lower` mode: lowers the fixture and compares the port's module with the oracle's.
pub def run_lower(fixture : String, oracle_path : String, hosted : String, stand_in_libs : Bool) : Nil
  oracle_text = File.read(oracle_path)
  parsed = parse(oracle_text)
  raise parsed.as(IrParseError).to_s if parsed.is_a?(IrParseError)
  oracle = attach_attrs(normalised_lines(print(parsed.as(Module)), hosted), oracle_attr_map(oracle_text))
  triple = triple_of(oracle_text)

  analysis = analyse(File.read(fixture), fixture, stand_in_libs)
  m = ir_module(triple)
  typer = LowerTyper.new(m.types, m.layout, true)
  codegen_program(analysis.root, analysis.visitor, typer, m)
  port_text = print(m)
  port = attach_attrs(normalised_lines(port_text, hosted), printed_attr_map(port_text))
  identical = compare(oracle, port)
  total = split_module(oracle)[2].size
  puts "SUMMARY identical=#{identical} total=#{total}"
end

# The `emit` mode: the port's module as text, for the native tool.
pub def run_emit(fixture : String, oracle_path : String, stand_in_libs : Bool) : Nil
  triple = triple_of(File.read(oracle_path))
  analysis = analyse(File.read(fixture), fixture, stand_in_libs)
  m = ir_module(triple)
  typer = LowerTyper.new(m.types, m.layout, true)
  codegen_program(analysis.root, analysis.visitor, typer, m)
  puts print(m)
end
