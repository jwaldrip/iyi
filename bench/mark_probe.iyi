{% if flag?(:gc_iyi) %}
  class Root
    @@head : UInt64 = 0_u64

    def self.head : UInt64
      @@head
    end

    def self.head=(value : UInt64) : Nil
      @@head = value
    end
  end

  def build(length : UInt64) : Nil
    head = Pointer(UInt8).malloc(64_u64).address
    Root.head = head
    node = head
    built = 1_u64
    while built < length
      nxt = Pointer(UInt8).malloc(64_u64).address
      Pointer(UInt64).new(node).value = nxt
      node = nxt
      built = built + 1_u64
    end
  end

  def walk_length : UInt64
    node = Root.head
    seen = 0_u64
    while node != 0
      seen = seen + 1_u64
      node = Pointer(UInt64).new(node).value
    end
    seen
  end

  [400_u64, 600_u64, 1100_u64, 3000_u64, 9000_u64, 20000_u64].each do |length|
    IyiMark.unmark
    build(length)
    reachable = walk_length
    black = IyiMark.mark
    colour = IyiMark.colour(Root.head)
    puts "length #{length.to_i64.to_s}: chain walks #{reachable.to_i64.to_s}, marked #{black.to_i64.to_s}, head colour #{colour.to_i64.to_s}"
  end
{% end %}
