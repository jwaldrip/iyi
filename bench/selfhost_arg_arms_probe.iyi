import compiler/syntax/parser::{Parser}
import compiler/syntax/ast::{Call}
import compiler/syntax/visitor::{Visitor}
import compiler/semantic/normalizer::{Normalizer, NormalizerProgram}
import compiler/semantic/top_level::{SemanticProgram, TopLevelVisitor, Type}
import compiler/semantic/main_visitor::{MainVisitor}
import compiler/semantic/method_lookup::{ArmWalk}

class ArmProbe < Visitor
  def initialize(@program : SemanticProgram, @typer : MainVisitor, @name : String)
  end

  def visit(node : Call) : Bool
    if node.name == @name
      receiver : Type = @program
      if obj = node.obj
        if typed = @typer.type_of?(obj)
          receiver = typed
        else
          return true
        end
      end
      found = @typer.lookup_call_arms(receiver, receiver, node.name, node.args, node, ArmWalk::Parents)
      puts "arms=#{found.matches.size} cover=#{found.cover_all?}"
      found.matches.each do |match|
        puts "#{match.defining.full_name}##{match.definition.name}:#{match.arg_types.map(&.full_name).join(",")}"
        if node.name == "new"
          puts "owner=#{match.owner.full_name}"
        end
      end
    end
    true
  end
end

path = Program.args[0]
node = Normalizer.new(NormalizerProgram.new(false)).normalize(Parser.new(File.read(path), path).parse)
program = SemanticProgram.new
program.total_mode = true
program.search_path = [Program.args[1]]
top = TopLevelVisitor.new(program, path)
node.accept(top)
top.finish
typer = MainVisitor.new(program)
typer.total = true
node.accept(typer)
probe = ArmProbe.new(program, typer, Program.args[2])
node.accept(probe)
