    vectors << ["test", "--help"]
    vectors << ["test", "-h"]
    vectors << ["test", "--json"]
    vectors << ["test", "--timeout", "10.5"]
    vectors << ["test", "--timeout", "not_a_num"]
    vectors << ["test", "--timeout"]
    vectors << ["test", "--affected", "src/foo.iyi"]
    vectors << ["test", "--affected"]
    vectors << ["test", "foo_test.iyi"]
