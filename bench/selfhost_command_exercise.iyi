    vectors << ["bind"]
    vectors << ["bind", "--help"]
    vectors << ["bind", "--mods", "my_mods", "--lib", "my_lib"]
    vectors << ["bind", "--mods"]
    vectors << ["bind", "--lib"]
    vectors << ["migrate"]
    vectors << ["migrate", "--help"]
    vectors << ["migrate", "--out", "dest_dir", "--check", "--annotate", "--verbose"]
