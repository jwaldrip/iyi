    vectors << ["bi"]
    vectors << ["da"]
    vectors << ["mi"]
    vectors << ["unknown_command"]
    vectors << ["missing.cr"]
    vectors
  end

  def self.run
    CommandDriver.program_name = "crystal"
    CommandDriver.version_description = "Crystal 1.22.0-dev\n\nThe compiler was not built in release mode.\n\nLLVM: 22.1.8\nDefault target: aarch64-apple-darwin25.5.0\n"

    corpus.each_with_index do |argv, idx|
      driver = CommandDriver.new(argv)
      driver.run
      puts "=== VECTOR #{idx}: #{argv.inspect} ==="
      puts driver.format_result
    end
  end
end

BenchSelfhostCommandExercise.run
