module bench/selfhost_loop_instance_probe

import bench/lib/lower_gate::{analyse}

path = Program.args[0]
visitor = analyse(File.read(path), path, true).visitor
puts "refusals: #{visitor.refusals.size}"
visitor.refusals.each { |refusal| puts refusal.reason }
visitor.typed_instances.each do |instance|
  if instance.definition.name == "link" || instance.definition.name == "bump"
    names = [] of String
    instance.arg_types.each { |arg| names << arg.full_name }
    puts "#{instance.definition.name}(#{names.join(",")})"
  end
end
