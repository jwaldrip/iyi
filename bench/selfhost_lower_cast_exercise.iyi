module bench/selfhost_lower_cast_exercise

# The port's side of the cast gate (bench/selfhost_lower_cast_exercise.sh): the
# same modes as the calls gate's driver, for the fixtures that call a builtin primitive
# (lowcast_*). The analysis runs with the lib stand-in (bench/lib/lower_gate.iyi), the
# same as the calls gate: a lib's funs are not typed by the semantic pass yet.
#
#   port oracle <oracle.ll>                 the oracle module, normalised, one line each
#   port lower <fixture.iyi> <oracle.ll>    lowers the fixture and compares it with the oracle
#   port emit <fixture.iyi> <oracle.ll>     the port's module as text, for the native tool

import bench/lib/lower_gate::{analyse, ir_module, run_emit, run_lower, run_oracle}
import compiler/ir/values::{Value}
import compiler/lower/cast::{assign_mixed_union}
import compiler/lower/context::{Lowerer}
import compiler/lower/typer::{LowerTyper}
import compiler/semantic/top_level::{Type}
import compiler/types/types::{MixedUnionType}

def refuse_wrong_union_member : Nil
  analysis = analyse("nil\n", "wrong_union_member.iyi", true)
  prog = analysis.visitor.program
  int_type = prog.lookup_type("Int32").as(Type)
  bool_type = prog.lookup_type("Bool").as(Type)
  char_type = prog.lookup_type("Char").as(Type)
  target = MixedUnionType.new(prog, [int_type, bool_type] of Type)
  m = ir_module("arm64-apple-macosx")
  low = Lowerer.new(m, LowerTyper.new(m.types, m.layout, analysis.iyi), analysis.visitor)
  assign_mixed_union(low, Value.new(m.types.ptr), target, char_type, Value.new(m.types.int32))
  raise "non-member union store was accepted"
end

def run : Nil
  args = Program.args
  if args.empty?
    # With no arguments the driver checks that the analysis with the lib stand-in runs, and exits 0.
    analyse("nil\n", "usage_check.iyi", true)
    puts "usage: port oracle <oracle.ll> | port lower <fixture.iyi> <oracle.ll> | port emit <fixture.iyi> <oracle.ll>"
    return
  end
  mode = args[0]
  if mode == "oracle"
    run_oracle(args[1], "::")
  elsif mode == "lower"
    run_lower(args[1], args[2], "::", true)
  elsif mode == "emit"
    run_emit(args[1], args[2], true)
  elsif mode == "wrong_union_member"
    refuse_wrong_union_member
  else
    raise "unknown mode #{mode}"
  end
end

run
