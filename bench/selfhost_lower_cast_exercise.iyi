module bench/selfhost_lower_cast_exercise

# The port's side of the cast gate (bench/selfhost_lower_cast_exercise.sh): the
# same modes as the calls gate's driver, for the fixtures that call a builtin primitive
# (lowcast_*). The analysis runs with the lib stand-in (bench/lib/lower_gate.iyi), the
# same as the calls gate: a lib's funs are not typed by the semantic pass yet.
#
#   port oracle <oracle.ll>                 the oracle module, normalised, one line each
#   port lower <fixture.iyi> <oracle.ll>    lowers the fixture and compares it with the oracle
#   port emit <fixture.iyi> <oracle.ll>     the port's module as text, for the native tool

import bench/lib/lower_gate::{analyse, ir_module, run_emit, run_lower, run_oracle}
import compiler/ir/inst::{Inst, Op}
import compiler/ir/types::{IrType}
import compiler/ir/verifier::{verify_function}
import compiler/ir/values::{Value}
import compiler/lower/cast::{assign, assign_mixed_union, downcast, mixed_union_type?, type_id_of_value}
import compiler/lower/context::{Lowerer}
import compiler/lower/typer::{LowerTyper}
import compiler/semantic/top_level::{Type, UnionType}
import compiler/types/types::{MixedUnionType}

def refuse_wrong_union_member : Nil
  analysis = analyse("nil\n", "wrong_union_member.iyi", true)
  prog = analysis.visitor.program
  int_type = prog.lookup_type("Int32").as(Type)
  bool_type = prog.lookup_type("Bool").as(Type)
  char_type = prog.lookup_type("Char").as(Type)
  target = MixedUnionType.new(prog, [int_type, bool_type] of Type)
  m = ir_module("arm64-apple-macosx")
  low = Lowerer.new(m, LowerTyper.new(m.types, m.layout, analysis.iyi), analysis.visitor)
  assign_mixed_union(low, Value.new(m.types.ptr), target, char_type, Value.new(m.types.int32))
  raise "non-member union store was accepted"
end

def skip_noreturn_assignment : Nil
  analysis = analyse("nil\n", "noreturn.iyi", true)
  prog = analysis.visitor.program
  int_type = prog.lookup_type("Int32").as(Type)
  bool_type = prog.lookup_type("Bool").as(Type)
  target = MixedUnionType.new(prog, [int_type, bool_type] of Type)
  m = ir_module("arm64-apple-macosx")
  low = Lowerer.new(m, LowerTyper.new(m.types, m.layout, analysis.iyi), analysis.visitor)
  assign(low, Value.new(m.types.ptr), target, prog.no_return_type, Value.new(m.types.int32))
end

# Exercise both semantic union classes with a loaded aggregate, as a getter returns.
def check_union_representations : Nil
  analysis = analyse("nil\n", "union_representations.iyi", true)
  prog = analysis.visitor.program
  int_type = prog.lookup_type("Int32").as(Type)
  bool_type = prog.lookup_type("Bool").as(Type)
  members = [int_type, bool_type] of Type
  plain = UnionType.new(prog, members)
  mixed = MixedUnionType.new(prog, members)
  reference = UnionType.new(prog, [prog.object_type, prog.nil_type] of Type)
  raise "plain union was not classified as mixed" unless mixed_union_type?(plain)
  raise "specialized union was not classified as mixed" unless mixed_union_type?(mixed)
  raise "reference union was classified as mixed" if mixed_union_type?(reference)

  m = ir_module("arm64-apple-macosx")
  low = Lowerer.new(m, LowerTyper.new(m.types, m.layout, analysis.iyi), analysis.visitor)
  low.type_ids.assign_all(prog.object_type)
  unions = [plain.as(Type), mixed.as(Type)] of Type
  names = ["plain", "specialized"]
  unions.each_with_index do |union, i|
    fn = low.begin_main_function(names[i], m.types.func([] of IrType, m.types.void), true)
    value = low.builder.const_zero(low.typer.llvm_type(union))
    slot = low.alloca(low.typer.llvm_type(union), "")
    assign(low, slot, union, int_type, low.builder.const_int(m.types.int32, 12_i64))
    tid = type_id_of_value(low, analysis.root, value, union)
    raise "#{names[i]} union used a static type id" unless tid.is_a?(Inst) && tid.as(Inst).op == Op::Load && tid.as(Inst).args[0].is_a?(Inst) && tid.as(Inst).args[0].as(Inst).op == Op::Gep
    downcast(low, value, int_type, union, true)
    low.builder.ret_void
    low.finish_main_function
    errors = verify_function(m, fn)
    raise "#{names[i]} union emitted invalid IR: #{errors[0].message}" unless errors.empty?
  end
end

def run : Nil
  args = Program.args
  if args.empty?
    # With no arguments the driver checks that the analysis with the lib stand-in runs, and exits 0.
    analyse("nil\n", "usage_check.iyi", true)
    puts "usage: port oracle <oracle.ll> | port lower <fixture.iyi> <oracle.ll> | port emit <fixture.iyi> <oracle.ll>"
    return
  end
  mode = args[0]
  if mode == "oracle"
    run_oracle(args[1], "::")
  elsif mode == "lower"
    run_lower(args[1], args[2], "::", true)
  elsif mode == "emit"
    run_emit(args[1], args[2], true)
  elsif mode == "wrong_union_member"
    refuse_wrong_union_member
  elsif mode == "skip_noreturn"
    skip_noreturn_assignment
  elsif mode == "union_representations"
    check_union_representations
  else
    raise "unknown mode #{mode}"
  end
end

run
