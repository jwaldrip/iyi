module bench/selfhost_lower_primitives_exercise

# The port's side of the primitives gate (bench/selfhost_lower_primitives_exercise.sh): the
# fixtures that call a builtin primitive (lowprim_*). The analysis runs with the lib stand-in
# (bench/lib/lower_gate.iyi), as the calls gate's does: a lib's funs are not typed by the semantic
# pass yet.
#
# The fixtures are bare programs (the hosted build is `--prelude empty`), so the typer keeps the
# hosted object layout, where a class's type id is its first field. The shared lower and emit
# modes of bench/lib/lower_gate.iyi build the typer with the header layout; this driver builds it
# with the bare layout, here and nowhere else.
#
#   port oracle <oracle.ll>                 the oracle module, normalised, one line each
#   port lower <fixture.iyi> <oracle.ll>    lowers the fixture and compares it with the oracle
#   port emit <fixture.iyi> <oracle.ll>     the port's module as text, for the native tool

import bench/lib/lower_gate::{analyse, ir_module, triple_of, normalised_lines, build_names, attach_attrs, oracle_attr_map, printed_attr_map, compare, split_module, run_oracle}
import compiler/ir/module::{Module}
import compiler/ir/parser::{parse, IrParseError}
import compiler/ir/printer::{print}
import compiler/lower/typer::{LowerTyper}
import compiler/lower/lower::{codegen_program}
import compiler/lower/primitives::{class_pointerful?}
import compiler/semantic/top_level::{GenericClassType, Type}
import compiler/types/types::{GenericClassInstanceType}

# The bare layout of the typer: a bare program is not an own-prelude build, so its objects are
# the hosted (`Program#iyi_object_layout?` is false without the prelude's IyiRuntimeLock).
def bare_typer(m : Module) : LowerTyper
  LowerTyper.new(m.types, m.layout, false)
end

def lower_bare(fixture : String, oracle_path : String) : Nil
  oracle_text = File.read(oracle_path)
  parsed = parse(oracle_text)
  raise parsed.as(IrParseError).to_s if parsed.is_a?(IrParseError)
  builds = build_names(oracle_text, "::")
  oracle = attach_attrs(normalised_lines(print(parsed.as(Module)), builds), oracle_attr_map(oracle_text))
  triple = triple_of(oracle_text)

  analysis = analyse(File.read(fixture), fixture, true)
  m = ir_module(triple)
  codegen_program(analysis.root, analysis.visitor, bare_typer(m), m)
  port_text = print(m)
  port = attach_attrs(normalised_lines(port_text, builds), printed_attr_map(port_text))
  identical = compare(oracle, port)
  total = split_module(oracle)[2].size
  module_ok = split_module(oracle)[0] == split_module(port)[0]
  puts "SUMMARY identical=#{identical} total=#{total} module=#{module_ok ? 1 : 0}"
end

def emit_bare(fixture : String, oracle_path : String) : Nil
  triple = triple_of(File.read(oracle_path))
  analysis = analyse(File.read(fixture), fixture, true)
  m = ir_module(triple)
  codegen_program(analysis.root, analysis.visitor, bare_typer(m), m)
  puts print(m)
end

# A generic class instance is not a ClassType. class_pointerful? used to cast it and the
# port tool raised (census root row 17). This check analyses a generic class whose instance
# variable is a pointer, finds the instantiation, and requires the pointerful answer without
# that cast. A mutation that drops the generic class's variables answers false.
def check_generic_pointerful : Nil
  source = "class Hold(T)\n  @buf : Pointer(Int32)\nend\n"
  analysis = analyse(source, "generic_pointerful.iyi", false)
  prog = analysis.visitor.program
  found = prog.lookup_type("Hold")
  raise "generic class Hold was not declared" if found.nil?
  generic = found.as(GenericClassType)
  int32 = prog.lookup_type("Int32")
  raise "Int32 was not declared" if int32.nil?
  tv = Hash(String, Type).new
  tv["T"] = int32.as(Type)
  args = [int32.as(Type)] of Type
  inst = GenericClassInstanceType.new(prog, generic, tv, args, generic.superclass)
  answer = class_pointerful?(inst)
  unless answer
    raise "Hold(Int32) is not pointerful"
  end
  puts "generic_pointerful=1"
end

def run : Nil
  args = Program.args
  if args.empty?
    # With no arguments the driver checks that the analysis with the lib stand-in runs, and exits 0.
    analyse("nil\n", "usage_check.iyi", true)
    puts "usage: port oracle <oracle.ll> | port lower <fixture.iyi> <oracle.ll> | port emit <fixture.iyi> <oracle.ll>"
    return
  end
  mode = args[0]
  if mode == "oracle"
    run_oracle(args[1], "::")
  elsif mode == "lower"
    lower_bare(args[1], args[2])
  elsif mode == "emit"
    emit_bare(args[1], args[2])
  elsif mode == "generic_pointerful"
    check_generic_pointerful
  else
    raise "unknown mode #{mode}"
  end
end

run
