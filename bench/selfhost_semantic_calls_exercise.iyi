import compiler/syntax/parser::{Parser}
import compiler/syntax/ast::{ASTNode, Call}
import compiler/semantic/top_level::{ModuleType, SemanticProgram, TopLevelVisitor, Type, dir_of}
import compiler/types/type_system::{TypeSystem}
import compiler/types/lookup::{LookupError, TypeLookup}
import compiler/semantic/method_lookup::{MethodLookup, Matches}
import compiler/semantic/match::{CallSignature, Match}
import compiler/semantic/restrictions::{ArgRestriction}
import compiler/semantic/call::{CallReceiver, CallRecalculation}
import compiler/semantic/default_arguments::{DefaultArguments}

# Call-lookup driver for bench/selfhost_semantic_calls_exercise.sh.
#
#   selfhost_semantic_calls_exercise <fixture.iyi>
#
# Loads the fixture with the prelude, through the port's top-level pass and the
# closure of what it requires (IYI_PATH is the search path, as the declarations gate
# reads it), then answers each `# call <expr>` line and each `# error <expr>` line
# and prints the same lines the hosted oracle
# (bench/selfhost_semantic_calls_oracle.cr) prints. The receiver rule and the result
# formats are the oracle's header. `# call` lines print the lookup's matches;
# `# error` lines run CallRecalculation.recalculate and print `ok` when the call has
# a target, or its error line.
module BenchSelfhostSemanticCallsExercise
  def self.search_path : Array(String)
    text = ENV["IYI_PATH"]? || ""
    text.split(":").select { |entry| !entry.empty? }
  end

  # One match as the oracle writes it: owner, name, restrictions, return.
  def self.match_text(ts : TypeSystem, m : Match) : String
    defining = m.defining
    restrictions = [] of String
    m.definition.args.each do |arg|
      r = ArgRestriction.of(ts, defining, arg, m.owner)
      if r.type.nil?
        restrictions << "_"
      else
        restrictions << r.type.as(Type).to_s
      end
    end
    ret_text = "needs body typing"
    ret = m.definition.return_type
    if ret
      found = ArgRestriction.lookup_bound(ts, defining, ret.as(ASTNode), m.owner)
      if found.is_a?(LookupError)
        ret_text = "error: #{found.as(LookupError).message}"
      else
        ret_text = found.as(Type).to_s
      end
    end
    "#{m.owner.to_s}::#{m.definition.name}(#{restrictions.join(", ")}) -> #{ret_text}"
  end

  # The matches of the call with its receiver, literal arguments, named arguments
  # and block, or the message of why they cannot be found.
  def self.lookup(prog : SemanticProgram, ts : TypeSystem, call : Call) : Matches | String
    scope = CallReceiver.scope(prog, ts, call.obj)
    if scope.nil?
      return "receiver is not resolvable"
    end
    arg_types = [] of Type
    call.args.each do |arg|
      typed = CallReceiver.argument_type(prog, arg)
      if typed.nil?
        return "argument is not a literal"
      end
      arg_types << typed.as(Type)
    end
    named_types = CallReceiver.named_argument_types(prog, call.named_args)
    if named_types.nil?
      return "argument is not a literal"
    end
    signature = CallSignature.new(call.name, arg_types, named_types, call.block != nil)
    MethodLookup.lookup_receiver(scope.as(Type), ts, signature)
  end

  # `# expand` line: the argument list of the one def the call matches, with its
  # default arguments expanded (DefaultArguments.expand), or why it is not
  # supported. Prints the text the hosted oracle prints for the same line.
  def self.evaluate_expand(prog : SemanticProgram, ts : TypeSystem, expr : String) : String
    node = Parser.new(expr, "call").parse
    if !node.is_a?(Call)
      return "error: not a call"
    end
    call = node.as(Call)
    found = lookup(prog, ts, call)
    if found.is_a?(String)
      return "error: #{found.as(String)}"
    end
    matches = found.as(Matches)
    if matches.error
      return "error: #{matches.error.to_s}"
    end
    if matches.matches.size != 1
      return "error: expected one match"
    end
    definition = matches.matches[0].definition
    if !DefaultArguments.supported?(definition, call.args, call.named_args)
      return "error: default arguments not supported"
    end
    texts = [] of String
    DefaultArguments.expand(definition, call.args, call.named_args).each do |arg|
      texts << arg.to_s
    end
    texts.join(", ")
  end

  def self.evaluate(prog : SemanticProgram, ts : TypeSystem, expr : String) : String
    node = Parser.new(expr, "call").parse
    if !node.is_a?(Call)
      return "error: not a call"
    end
    found = lookup(prog, ts, node.as(Call))
    if found.is_a?(String)
      return "error: #{found.as(String)}"
    end
    matches = found.as(Matches)
    if matches.error
      return "error: #{matches.error.to_s}"
    end
    if matches.empty?
      return "none"
    end
    parts = [] of String
    matches.matches.each do |m|
      parts << match_text(ts, m)
    end
    text = parts.join("; ")
    text = text + " [cover all]" if matches.cover_all?
    text
  end

  # `ok` when the call has a target, otherwise the first line of its error, as the
  # hosted call pass raises it. A message not ported is marked as such.
  def self.evaluate_error(prog : SemanticProgram, ts : TypeSystem, expr : String) : String
    node = Parser.new(expr, "call").parse
    if !node.is_a?(Call)
      return "error: not a call"
    end
    call = node.as(Call)
    scope = CallReceiver.scope(prog, ts, call.obj)
    if scope.nil?
      return "error: receiver is not resolvable"
    end
    target = CallRecalculation.recalculate(scope.as(Type), ts, prog, call.name, call.args, call.named_args, call.block != nil, call.obj != nil)
    if target.error
      return "error: #{target.error.to_s}"
    end
    arg_types = [] of Type
    call.args.each do |arg|
      arg_types << CallReceiver.argument_type(prog, arg).as(Type)
    end
    named = CallReceiver.named_argument_types(prog, call.named_args)
    signature = CallSignature.new(call.name, arg_types, named, call.block != nil)
    by_signature = CallRecalculation.recalculate_signature(scope.as(Type), ts, signature, call.obj != nil)
    if by_signature.error.to_s != target.error.to_s
      return "error: signature entry diverges from recalculate"
    end
    "ok"
  end

  def self.run(src : String, filename : String) : String
    prog = SemanticProgram.new
    prog.search_path = search_path
    prog.project_root = dir_of(filename)
    # The prelude is the first statement of every fixture, as a compile prepends it.
    # Fixtures live in bench/fixtures, so the prelude is two levels up, in src.
    node = Parser.new("require \"../../src/iyi/prelude\"\n" + src, filename).parse
    visitor = TopLevelVisitor.new(prog, filename)
    node.accept(visitor)
    visitor.finish
    # The type system is installed after the declarations, as the declarations gate does.
    ts = TypeSystem.new(prog)
    out = [] of String
    src.split("\n").each do |line|
      if line.starts_with?("# call ")
        expr = line[7, line.bytesize - 7].strip
        out << "#{expr} => #{evaluate(prog, ts, expr)}"
      elsif line.starts_with?("# error ")
        expr = line[8, line.bytesize - 8].strip
        out << "#{expr} => #{evaluate_error(prog, ts, expr)}"
      elsif line.starts_with?("# expand ")
        expr = line[9, line.bytesize - 9].strip
        out << "#{expr} => #{evaluate_expand(prog, ts, expr)}"
      end
    end
    out.join("\n") + "\n"
  end
end

if Program.args.size > 0
  filename = Program.args[0]
  print BenchSelfhostSemanticCallsExercise.run(File.read(filename), filename)
end
