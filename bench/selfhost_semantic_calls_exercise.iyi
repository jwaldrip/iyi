import compiler/syntax/parser::{Parser}
import compiler/syntax/ast::{ASTNode, Call}
import compiler/semantic/top_level::{ModuleType, SemanticProgram, TopLevelVisitor, Type}
import compiler/types/type_system::{TypeSystem}
import compiler/types/lookup::{LookupError, TypeLookup}
import compiler/semantic/method_lookup::{MethodLookup, Matches}
import compiler/semantic/match::{CallSignature, Match}
import compiler/semantic/restrictions::{ArgRestriction}
import compiler/semantic/call::{CallReceiver, CallRecalculation}

# Call-lookup driver for bench/selfhost_semantic_calls_exercise.sh.
#
#   selfhost_semantic_calls_exercise <fixture.iyi>
#
# Builds the fixture's declarations into a SemanticProgram, then answers each
# `# call <expr>` line and each `# error <expr>` line and prints the same lines
# the hosted oracle (bench/selfhost_semantic_calls_oracle.cr) prints. The
# receiver rule and the result formats are the oracle's header. `# call` lines
# print the lookup's matches; `# error` lines run CallRecalculation.recalculate
# and print `ok` when the call has a target, or its error line.
module BenchSelfhostSemanticCallsExercise
  # One match as the oracle writes it: owner, name, restrictions, return.
  def self.match_text(ts : TypeSystem, m : Match) : String
    defining = m.defining
    restrictions = [] of String
    m.definition.args.each do |arg|
      r = ArgRestriction.of(ts, defining, arg)
      if r.type.nil?
        restrictions << "_"
      else
        restrictions << r.type.as(Type).to_s
      end
    end
    ret_text = "needs body typing"
    ret = m.definition.return_type
    if ret
      found = TypeLookup.new(ts.instances).lookup(defining, ret.as(ASTNode))
      if found.is_a?(LookupError)
        ret_text = "error: #{found.as(LookupError).message}"
      else
        ret_text = found.as(Type).to_s
      end
    end
    "#{m.owner.to_s}::#{m.definition.name}(#{restrictions.join(", ")}) -> #{ret_text}"
  end

  # The matches of the call with its receiver, literal arguments, named arguments
  # and block, or the message of why they cannot be found.
  def self.lookup(prog : SemanticProgram, ts : TypeSystem, call : Call) : Matches | String
    scope = CallReceiver.scope(prog, ts, call.obj)
    if scope.nil?
      return "receiver is not resolvable"
    end
    owner = scope.as(ModuleType)
    arg_types = [] of Type
    call.args.each do |arg|
      typed = CallReceiver.argument_type(prog, arg)
      if typed.nil?
        return "argument is not a literal"
      end
      arg_types << typed.as(Type)
    end
    named_types = CallReceiver.named_argument_types(prog, call.named_args)
    if named_types.nil?
      return "argument is not a literal"
    end
    signature = CallSignature.new(call.name, arg_types, named_types, call.block != nil)
    MethodLookup.lookup_matches(owner, ts, signature, owner, owner, [] of Match)
  end

  def self.evaluate(prog : SemanticProgram, ts : TypeSystem, expr : String) : String
    node = Parser.new(expr, "call").parse
    if !node.is_a?(Call)
      return "error: not a call"
    end
    found = lookup(prog, ts, node.as(Call))
    if found.is_a?(String)
      return "error: #{found.as(String)}"
    end
    matches = found.as(Matches)
    if matches.error
      return "error: #{matches.error.to_s}"
    end
    if matches.empty?
      return "none"
    end
    parts = [] of String
    matches.matches.each do |m|
      parts << match_text(ts, m)
    end
    text = parts.join("; ")
    text = text + " [cover all]" if matches.cover_all?
    text
  end

  # `ok` when the call has a target, otherwise the first line of its error, as the
  # hosted call pass raises it. A message not ported is marked as such.
  def self.evaluate_error(prog : SemanticProgram, ts : TypeSystem, expr : String) : String
    node = Parser.new(expr, "call").parse
    if !node.is_a?(Call)
      return "error: not a call"
    end
    call = node.as(Call)
    scope = CallReceiver.scope(prog, ts, call.obj)
    if scope.nil?
      return "error: receiver is not resolvable"
    end
    target = CallRecalculation.recalculate(scope.as(ModuleType), ts, prog, call.name, call.args, call.named_args, call.block != nil)
    if target.error
      return "error: #{target.error.to_s}"
    end
    "ok"
  end

  def self.run(src : String, filename : String) : String
    parser = Parser.new(src, filename)
    node = parser.parse
    prog = SemanticProgram.new
    # The type system is installed before the visitor runs, as the types driver does.
    ts = TypeSystem.new(prog)
    node.accept(TopLevelVisitor.new(prog))
    out = [] of String
    src.split("\n").each do |line|
      if line.starts_with?("# call ")
        expr = line[7, line.bytesize - 7].strip
        out << "#{expr} => #{evaluate(prog, ts, expr)}"
      elsif line.starts_with?("# error ")
        expr = line[8, line.bytesize - 8].strip
        out << "#{expr} => #{evaluate_error(prog, ts, expr)}"
      end
    end
    out.join("\n") + "\n"
  end
end

if Program.args.size > 0
  filename = Program.args[0]
  print BenchSelfhostSemanticCallsExercise.run(File.read(filename), filename)
end
