# The port's side of the math gate: folds every constant expression of a
# fixture with the port's MathInterpreter and prints one line per expression,
# in the layout the hosted oracle uses (bench/selfhost_semantic_math_oracle.cr).
# A `# target: <kind>` comment line sets the target type for the lines after
# it. A refused expression prints `refused=` with the reason, and is not
# compared with the oracle (the gate checks the refused fixture is refused).
import std/file
import compiler/syntax/parser::{Parser}
import compiler/syntax/token::{NumberKind}
import compiler/semantic/math_interpreter::{MathInterpreter, MathValue, MathError}

module BenchSemanticMathExercise
  def self.target_of(name : String) : NumberKind?
    case name
    when "i8"   then NumberKind::I8
    when "i16"  then NumberKind::I16
    when "i32"  then NumberKind::I32
    when "i64"  then NumberKind::I64
    when "i128" then NumberKind::I128
    when "u8"   then NumberKind::U8
    when "u16"  then NumberKind::U16
    when "u32"  then NumberKind::U32
    when "u64"  then NumberKind::U64
    when "u128" then NumberKind::U128
    else             nil
    end
  end
end

filename = Program.args[0]
lines = File.read_lines(filename)
target : NumberKind? = nil
i = 0
while i < lines.size
  line = lines[i]
  if line.starts_with?("# target: ")
    target = BenchSemanticMathExercise.target_of(line[10, line.bytesize - 10])
  elsif line.bytesize > 0 && !line.starts_with?("#")
    parser = Parser.new(line, filename)
    node = parser.parse
    result = MathInterpreter.new(target).interpret(node)
    if result.is_a?(MathValue)
      value = result.as(MathValue)
      puts "#{i + 1}: value=#{value.value} kind=#{value.kind.to_s}"
    else
      error = result.as(MathError)
      if error.refused
        puts "#{i + 1}: refused=#{error.message}"
      else
        puts "#{i + 1}: error=#{error.message}"
      end
    end
  end
  i = i + 1
end
