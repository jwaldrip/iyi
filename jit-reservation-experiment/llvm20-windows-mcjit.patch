+/*===-- Windows MCJIT Factory & Identity Functions
+ * -------------------------===*/
+
+LLVMBool LLVMExtCreateWindowsMCJITCompilerForModule(
+    LLVMExecutionEngineRef *OutEE, LLVMModuleRef M, char **OutError) {
+  if (!OutEE) {
+    if (OutError)
+      *OutError = strdup("OutEE pointer must not be null");
+    return 1;
+  }
+  *OutEE = nullptr;
+
+  if (!M) {
+    if (OutError)
+      *OutError = strdup("Module must not be null");
+    return 1;
+  }
+
+  LLVMMCJITCompilerOptions options;
+  LLVMInitializeMCJITCompilerOptions(&options, sizeof(options));
+
+  TargetOptions targetOptions;
+  targetOptions.EnableFastISel = options.EnableFastISel;
+  std::unique_ptr<llvm::Module> Mod(unwrap(M));
+
+  if (Mod) {
+    for (auto &F : *Mod) {
+      auto Attrs = F.getAttributes();
+      StringRef Value = options.NoFramePointerElim ? "all" : "none";
+      Attrs = Attrs.addFnAttribute(F.getContext(), "frame-pointer", Value);
+      F.setAttributes(Attrs);
+    }
+  }
+
+  std::string Error;
+  EngineBuilder builder(std::move(Mod));
+  builder.setEngineKind(EngineKind::JIT)
+      .setErrorStr(&Error)
+      .setOptLevel((CodeGenOptLevel)options.OptLevel)
+      .setTargetOptions(targetOptions);
+
+  bool JIT;
+  if (std::optional<CodeModel::Model> CM = unwrap(options.CodeModel, JIT))
+    builder.setCodeModel(*CM);
+
+  auto MM = std::make_unique<WindowsMCJITMemoryManager>();
+  builder.setMCJITMemoryManager(std::move(MM));
+
+  if (ExecutionEngine *JITEngine = builder.create()) {
+    *OutEE = wrap(JITEngine);
+    return 0;
+  }
+
+  if (OutError)
+    *OutError = strdup(!Error.empty() ? Error.c_str()
+                                      : "Failed to create ExecutionEngine");
+  return 1;
+}
+
+const char *LLVMExtGetWindowsMCJITBuildIdentity(void) {
+  return "windows-mcjit-dynamic-packed-v1";
+}
+
+void LLVMExtSetWindowsMCJITFaultInjection(uint32_t Flags) {
+  llvm::setWindowsMCJITFaultInjection(Flags);
+}
+
+void LLVMExtMapSectionAddress(LLVMExecutionEngineRef EE,
+                              const void *LocalAddress,
+                              uint64_t TargetAddress) {
+  if (unwrap(EE))
+    unwrap(EE)->mapSectionAddress(LocalAddress, TargetAddress);
+}
