    1: def base_env(pin: dict | None = None, stage_extra: dict[str, str] | None = None) -> dict[str, str]:
           """
           Contract C2 + Amendment A: Clean environment for stage processes started directly by run_proof.
           Removes:
             - every key starting with IYI_ or CRYSTAL_
             - PYTHONOPTIMIZE, PYTHONPATH, PYTHONHOME, PYTHONSTARTUP
             - ROUTE_A_DRIVERS, STD_SIBLINGS, SIBLING_MINUTES
           Sets:
             - LIBRARY_PATH=/opt/homebrew/opt/bdw-gc/lib
             - PKG_CONFIG_PATH=/opt/homebrew/opt/openssl@3/lib/pkgconfig
             - PYTHONDONTWRITEBYTECODE=1
           From pin:
             - PATH, HOME
           Stage additions only via stage_extra.
           """
 1579:     env = os.environ.copy()
       
201869:     for k in list(env.keys()):
200290:         if k.startswith("IYI_") or k.startswith("CRYSTAL_"):
    6:             env.pop(k, None)
       
12632:     for k in [
               "PYTHONOPTIMIZE",
               "PYTHONPATH",
               "PYTHONHOME",
               "PYTHONSTARTUP",
               "ROUTE_A_DRIVERS",
               "STD_SIBLINGS",
               "SIBLING_MINUTES",
           ]:
11053:         env.pop(k, None)
       
 1579:     env["LIBRARY_PATH"] = "/opt/homebrew/opt/bdw-gc/lib"
 1579:     env["PKG_CONFIG_PATH"] = "/opt/homebrew/opt/openssl@3/lib/pkgconfig"
 1579:     env["PYTHONDONTWRITEBYTECODE"] = "1"
       
 1579:     if pin:
 1579:         env["PATH"] = pin["env_path"]
 1579:         env["HOME"] = pin["env_home"]
       
 1579:     if stage_extra:
  311:         env.update(stage_extra)
       
 1579:     return env
       
       
