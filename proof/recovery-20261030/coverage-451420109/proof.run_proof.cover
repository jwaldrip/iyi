  115:         stage_additions.update(additions)
  131:     return base_env(pin, stage_additions)
       
       
    1: def run_logged(cmd: list[str], *, cwd: str, env: dict[str, str], log_path: str, times_path: str, limit_sec: float | None, grace_sec: float = GRACE_SEC):
  318:     result = run_bounded(
