    1: def _skip_hits(census: dict, text: str) -> list[dict[str, str]]:
   56:     lines = text.splitlines()
   56:     hits: list[dict[str, str]] = []
   98:     for entry in census.get("skips", []):
   42:         if not isinstance(entry, dict):
    1:             continue
   41:         regex = entry.get("regex")
   41:         if not isinstance(regex, str):
    1:             continue
   40:         try:
  114:             matched = any(re.search(regex, line) for line in lines)
    1:         except re.error:
    1:             matched = False
   40:         if matched:
   12:             hits.append(
    6:                 {
    6:                     "driver": str(census.get("driver", "")),
    6:                     "class": str(entry.get("class", "")),
    6:                     "what": str(entry.get("what", "")),
    6:                     "regex": regex,
                       }
                   )
   62:     unique = {tuple(sorted(hit.items())): hit for hit in hits}
  112:     return sorted(
   56:         unique.values(),
   62:         key=lambda hit: (
    6:             hit["driver"],
    6:             hit["class"],
    6:             hit["what"],
    6:             hit["regex"],
               ),
           )
       
       
    1: def _baseline_skip_hits(w_path: str, log_text: str) -> list[dict[str, str]]:
   54:     header = re.compile(
   27:         r"^-- running sibling: std_([A-Za-z0-9_]+)_exercise\.sh\s*$",
   27:         re.MULTILINE,
           )
   27:     matches = list(header.finditer(log_text))
   27:     hits: list[dict[str, str]] = []
 2557:     for index, match in enumerate(matches):
 2532:         driver = match.group(1)
 2532:         section_end = matches[index + 1].start() if index + 1 < len(matches) else len(log_text)
 2532:         section = log_text[match.end():section_end]
 2532:         census_path = os.path.join(w_path, "proof", "census", f"{driver}.json")
 2532:         if not os.path.isfile(census_path):
 2507:             continue
   25:         census = _load_json(census_path)
   25:         if not isinstance(census, dict):
    2:             raise ValueError(f"census is not an object: {census_path}")
   23:         hits.extend(_skip_hits(census, section))
   26:     unique = {tuple(sorted(hit.items())): hit for hit in hits}
   50:     return sorted(
   25:         unique.values(),
   26:         key=lambda hit: (
    1:             hit["driver"],
    1:             hit["class"],
    1:             hit["what"],
    1:             hit["regex"],
               ),
           )
       
       
