    1:     "the platform skips",
           (
    1:         "under helpers, observed-source binaries run only in the drivers' "
               "own artifact blocks (acme, autocert, compress, png, regex, shlex, "
               "tls, websocket, xz, zip) and in negative mutation proofs; every "
               "other canonical or positive build runs its artifact consumer; RG2 "
               "proves observed source bare for all 141"
           ),
       ]
       
       
    1: def _attempt_entries(parent_dir: str) -> list[tuple[int, str]]:
  505:     try:
  505:         names = os.listdir(parent_dir)
   12:     except FileNotFoundError:
   12:         return []
  493:     entries: list[tuple[int, str]] = []
  897:     for name in names:
  404:         match = re.fullmatch(r"a([1-9][0-9]*)", name)
  404:         path = os.path.join(parent_dir, name)
  404:         if match and os.path.isdir(path):
  402:             entries.append((int(match.group(1)), path))
  493:     return sorted(entries)
       
       
    1: def next_attempt_dir(parent_dir: str) -> str:
  100:     os.makedirs(parent_dir, exist_ok=True)
  100:     entries = _attempt_entries(parent_dir)
  100:     attempt = entries[-1][0] + 1 if entries else 1
  100:     path = os.path.join(parent_dir, f"a{attempt}")
  100:     os.makedirs(path, exist_ok=False)
  100:     return path
       
       
    1: def latest_attempt_dir(parent_dir: str) -> str | None:
  331:     entries = _attempt_entries(parent_dir)
  331:     return entries[-1][1] if entries else None
       
       
    1: def _attempt_number(path: str) -> int:
  144:     match = re.fullmatch(r"a([1-9][0-9]*)", os.path.basename(path))
  144:     if not match:
    1:         raise ValueError(f"not an attempt directory: {path}")
  143:     return int(match.group(1))
       
       
    1: def _write_json_atomic(path: str, value: object) -> None:
  138:     parent = os.path.dirname(os.path.abspath(path))
  138:     os.makedirs(parent, exist_ok=True)
  276:     temporary = os.path.join(
  138:         parent,
  138:         f".{os.path.basename(path)}.{os.getpid()}.{secrets.token_hex(8)}.tmp",
           )
  138:     try:
  276:         with open(temporary, "x", encoding="utf-8") as output:
  138:             json.dump(value, output, indent=2, sort_keys=True)
  138:             output.write("\n")
  138:             output.flush()
  138:             os.fsync(output.fileno())
  138:         os.replace(temporary, path)
           finally:
  138:         try:
  138:             os.unlink(temporary)
  138:         except FileNotFoundError:
  138:             pass
       
       
    1: def _load_json(path: str) -> object:
  402:     with open(path, "r", encoding="utf-8") as source:
  200:         return json.load(source)
       
       
    1: def read_log(log_path: str) -> bytes:
  310:     with open(log_path, "rb") as log_file:
  155:         return log_file.read()
       
       
    1: def fresh_stage_env(pin: dict, attempt_dir: str, stage_name: str, additions: dict[str, str] | None = None) -> dict[str, str]:
  132:     tmp_dir = os.path.join(attempt_dir, f"{stage_name}.tmp")
