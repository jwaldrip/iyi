    1: def _new_result(pin: dict, unit: str, attempt: int, checks: dict[str, str], reasons: list[str], started_ns: int, survivors: Sequence[int]) -> dict:
  100:     kind = unit.split("/", 1)[0]
  100:     record = {
  100:         "v": 1,
  100:         "chain_id": pin["chain_id"],
  100:         "unit": unit,
  100:         "attempt": attempt,
  100:         "status": "FAIL",
  100:         "reasons": list(reasons),
  100:         "checks": dict(checks),
  100:         "started_ns": started_ns,
  100:         "ended_ns": time.time_ns(),
  200:         "survivors": sorted(set(int(pid) for pid in survivors)),
           }
  100:     record["status"] = recompute_status(record, kind)
  100:     return record
       
       
    1: def _finish_attempt(attempt_dir: str, pin: dict, unit: str, checks: dict[str, str], reasons: list[str], started_ns: int, survivors: Sequence[int]) -> dict:
  200:     record = _new_result(
  100:         pin,
  100:         unit,
  100:         _attempt_number(attempt_dir),
  100:         checks,
  100:         reasons,
  100:         started_ns,
  100:         survivors,
           )
  100:     write_result(os.path.join(attempt_dir, "result.json"), record)
  100:     return record
       
       
