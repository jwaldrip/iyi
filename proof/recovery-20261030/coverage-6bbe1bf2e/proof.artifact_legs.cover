  134:     if proc.returncode != 0:
    1:         detail = proc.stderr.strip() or proc.stdout.strip()
    2:         raise RuntimeError(
    1:             f"{nm_bin} -U failed (exit {proc.returncode}): {detail}"
               )
  266:     return [
   14:         line.strip()
  280:         for line in proc.stdout.splitlines()
   14:         if "__iyi_effect_" in line
           ]
       
       
    1: def _compare_frame_stderr(stderr_a: bytes, stderr_b: bytes, repo_root: str, row_dir: str, tag: str) -> tuple[bool, str]:
    6:     stderr_file_a = os.path.join(row_dir, f"stderr_{tag}_a.out")
    6:     stderr_file_b = os.path.join(row_dir, f"stderr_{tag}_b.out")
   12:     with open(stderr_file_a, "wb") as stream:
    6:         stream.write(stderr_a)
   12:     with open(stderr_file_b, "wb") as stream:
    6:         stream.write(stderr_b)
       
    6:     frames_script = os.path.join(repo_root, "bench/frames_equivalent.py")
    6:     if not os.path.isfile(frames_script):
    1:         raise RuntimeError(f"frames_equivalent.py not found at {frames_script}")
       
   10:     proc = subprocess.run(
    5:         [sys.executable, frames_script, stderr_file_a, stderr_file_b],
    5:         capture_output=True,
    5:         text=True,
    5:         check=False,
           )
    5:     if proc.returncode == 0:
    1:         return True, "stdout byte-equal and stderr frames equivalent"
    4:     if proc.returncode == 1:
    3:         violation = proc.stdout.strip() or proc.stderr.strip()
    3:         return False, f"stderr frames equivalence failed: {violation}"
    2:     raise RuntimeError(
    2:         "frames_equivalent.py crashed "
    1:         f"(exit {proc.returncode}): {proc.stderr.strip()}"
           )
       
       
    1: def compare_r1(name: str, status_a: int, status_b: int, stdout_a: bytes, stderr_a: bytes, stdout_b: bytes, stderr_b: bytes, repo_root: str, row_dir: str, tag: str) -> tuple[bool, str]:
   48:     if status_a != status_b:
    1:         return False, f"exit status mismatch: {status_a} != {status_b}"
       
   47:     if name in EXIT_ONLY_EXERCISES:
    9:         return True, "exit-only check passed"
       
   38:     if stdout_a != stdout_b:
    2:         difference = f"len {len(stdout_a)} != {len(stdout_b)}" if len(stdout_a) != len(stdout_b) else "differing bytes"
    2:         return False, f"stdout mismatch ({difference})"
       
   36:     if stderr_a == stderr_b:
   30:         return True, "exact stdout and stderr match"
       
    6:     return _compare_frame_stderr(stderr_a, stderr_b, repo_root, row_dir, tag) if platform.system() == "Darwin" else (False, "stderr differs (frames_equivalent CLI only available on Darwin)")
       
       
    1: def _row_identity(source: str, repo: str, work_root: str) -> tuple[str, str, str, bool, str]:
