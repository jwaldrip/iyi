    1: def run_session_proc(cmd: list[str], cwd: str, env: dict[str, str], timeout_sec: float, stdin_devnull: bool = True) -> tuple[int, bytes, bytes, bool]:
           """Run one build or program in its own process group."""
  248:     stdin = subprocess.DEVNULL if stdin_devnull else None
  496:     proc = subprocess.Popen(
  248:         cmd,
  248:         cwd=cwd,
  248:         env=env,
  248:         stdin=stdin,
  248:         stdout=subprocess.PIPE,
  248:         stderr=subprocess.PIPE,
  248:         start_new_session=True,
           )
  247:     timed_out = False
  247:     stdout = b""
  247:     stderr = b""
  247:     try:
  247:         stdout, stderr = proc.communicate(timeout=timeout_sec)
    7:     except subprocess.TimeoutExpired:
    7:         timed_out = True
    7:         _kill_process_group(proc.pid, signal.SIGTERM)
    7:         try:
    7:             stdout, stderr = proc.communicate(timeout=0.5)
    1:         except subprocess.TimeoutExpired:
    1:             _kill_process_group(proc.pid, signal.SIGKILL)
    1:             stdout, stderr = proc.communicate()
       
  247:     returncode = proc.returncode if proc.returncode is not None else -1
  247:     return returncode, stdout, stderr, timed_out
       
       
    1: def check_defined_symbols(binary_path: str, nm_bin: str) -> list[str]:
