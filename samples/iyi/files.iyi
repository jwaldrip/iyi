# Files — the missing piece between a demonstration and a tool.
#
#   ./bin/iyi run samples/iyi/files.iyi
#
# Writes a file, reads it back, checks `exists?`. The path is next to the
# process, named so it is obvious, and left behind: this prelude has no
# `unlink` yet. Delete `iyi-files-sample.txt` when you are done.

module samples/files

path = "iyi-files-sample.txt"
File.write(path, "hello from iyi\n")
puts File.read(path)
puts File.exists?(path)
puts File.exists?("iyi-files-sample-missing.txt")
