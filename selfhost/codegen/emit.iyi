module main

# The codegen slice, written in iyi: LLVM IR for the shapes the fixtures
# under `fixtures/` write.
#
# The other slices diff a tree or a type against the current compiler's.
# Two independent backends do not write the same IR, so comparing the
# text would measure spelling. What this slice compares is what the
# program *does*: each fixture ends in `__iyi_exit`, both compilers turn
# it into an executable, and the gate diffs the exit status and stdout.
#
# What it carries: integer literals and arithmetic, comparisons, `if`,
# `while`, locals, arguments, calls to methods in the file, `print` of a
# literal, and a struct with fields and methods. Not here: a class, which
# is a reference and needs a heap; any other type; anything that
# allocates. Each of those wants its own diffed fixture rather than a
# guess.
#
# The operators are the prelude's primitives. `@[Primitive(:binary)] def
# +(other : Int32) : self` is an instruction rather than a body, which is
# why this can emit `add` without reading the prelude at all.

import std/file
import parser/parser
using std/file::{File}
using parser/parser::{Parser, Node, IfNode, WhileNode, StrNode, NumNode, VarNode, IvarNode, AssignNode, ExprsNode, DefNode, ArgNode, CallNode, ClassDefNode, PathNode, VisibilityModifierNode}

# A value, and what shape it has. Everything in this slice is either an
# `i32` or a struct passed by value, and knowing which decides how it is
# stored, loaded and passed.
pub class Val
  getter text : String
  getter kind : String
  # Which type this is, for looking a method up. A reference prints as
  # `ptr` and every reference prints the same, so the name cannot be read
  # back out of the kind.
  getter shape : String

  def initialize(@text : String, @kind : String)
    @shape = ""
  end

  def initialize(@text : String, @kind : String, @shape : String)
  end
end

pub def int_val(text : String) : Val
  Val.new(text, "i32")
end

# One struct the file declares: the fields it holds, in the order its
# constructor assigns them, and the methods written on it.
pub class Shape
  getter name : String
  getter fields : Array(String)
  getter defs : Array(DefNode)
  # A `class` is a reference and a `struct` is a value. They hold their
  # fields the same way and are passed around differently: one is a
  # pointer to an object on the heap, the other is the object.
  getter reference : Bool

  def initialize(@name : String, @reference : Bool)
    @fields = [] of String
    @defs = [] of DefNode
  end

  def add_field(field : String) : Nil
    @fields << field unless @fields.includes?(field)
  end

  def add(node : DefNode) : Nil
    @defs << node
  end

  def index_of(field : String) : Int32
    found = @fields.index(field)
    found.nil? ? 0 : found
  end

  def method(name : String) : Array(DefNode)
    hit = [] of DefNode
    @defs.each { |node| hit << node if node.name == name }
    hit
  end

  def knows?(name : String) : Bool
    method(name).size > 0
  end

  # How a value of the type is written in the IR. A reference is an
  # opaque pointer; the struct type below it is what an offset into it
  # is measured against.
  def kind : String
    @reference ? "ptr" : "%#{@name}"
  end

  def layout : String
    "%#{@name}"
  end

  # Four bytes a field, because every field in this slice is an `Int32`.
  def bytes : Int32
    @fields.size * 4
  end

  def declaration : String
    written = [] of String
    @fields.each { |field| written << "i32" }
    "#{layout} = type { #{written.join(", ")} }"
  end
end

# What the file declares: its own methods, and its structs.
pub class Known
  @names : Array(String)
  @nodes : Array(DefNode)
  @shapes : Array(Shape)

  def initialize
    @names = [] of String
    @nodes = [] of DefNode
    @shapes = [] of Shape
  end

  def add(node : DefNode) : Nil
    @names << node.name
    @nodes << node
  end

  def nodes : Array(DefNode)
    @nodes
  end

  def knows?(name : String) : Bool
    !@names.index(name).nil?
  end

  def add_shape(shape : Shape) : Nil
    @shapes << shape
  end

  def shapes : Array(Shape)
    @shapes
  end

  def shape_named(name : String) : Array(Shape)
    hit = [] of Shape
    @shapes.each { |shape| hit << shape if shape.name == name }
    hit
  end

  def shape?(name : String) : Bool
    shape_named(name).size > 0
  end

  def shape_of(name : String) : Array(Shape)
    return [] of Shape if name == ""
    shape_named(name)
  end
end

# The module's string constants. A literal is bytes with a name, and the
# name is what a call passes. Collected while the functions are emitted
# and printed above them, so the text reads in the order LLVM would have
# written it.
pub class Constants
  @lines : String
  @count : Int32

  def initialize
    @lines = ""
    @count = 0
  end

  def text : String
    @lines
  end

  # The bytes of a literal, as LLVM spells them: every byte that is not
  # plain printable ASCII is written as two hex digits, because a newline
  # inside a constant would end the line it is written on.
  def add(text : String) : String
    name = "@str#{@count}"
    @count = @count + 1
    written = ""
    index = 0
    while index < text.bytesize
      ch = text[index]
      written = written + if ch == '"' || ch == '\\' || ch.ord < 32 || ch.ord > 126
        "\\#{hex(ch.ord)}"
      else
        ch.to_s
      end
      index = index + 1
    end
    @lines = @lines + "#{name} = private unnamed_addr constant [#{text.bytesize} x i8] c\"#{written}\"\n"
    name
  end

  # Integer division, spelled so: a bare `/` on two integers is a float
  # here, and the prelude offers both.
  def hex(value : Int32) : String
    "#{digit(value // 16)}#{digit(value % 16)}"
  end

  def digit(value : Int32) : String
    return "#{value}" if value < 10
    return "A" if value == 10
    return "B" if value == 11
    return "C" if value == 12
    return "D" if value == 13
    return "E" if value == 14
    "F"
  end
end

# One function's worth of instructions.
pub class Body
  @lines : String
  @next : Int32
  @slots : Array(String)
  @slot_kinds : Array(String)
  @slot_shapes : Array(String)
  # Which block the cursor is in, and how many branches have been given
  # labels, so two `if`s in one method do not share them.
  @label : String
  @marks : Int32
  # The struct this method belongs to, if any. Its fields are read
  # through the slot `self` arrived in.
  @holder : String

  def initialize(@holder : String)
    @lines = ""
    @next = 0
    @slots = [] of String
    @slot_kinds = [] of String
    @slot_shapes = [] of String
    @label = "entry"
    @marks = 0
  end

  def holder : String
    @holder
  end

  def text : String
    @lines
  end

  def write(line : String) : Nil
    @lines = @lines + "  " + line + "\n"
  end

  # A fresh register. LLVM names them itself when they are unnamed, and
  # naming them here keeps the emitted text readable and the counter
  # under this pass's control rather than the printer's.
  def register : String
    name = "%t#{@next}"
    @next = @next + 1
    name
  end

  # A local lives in a slot rather than a register, so an assignment can
  # rewrite it without this pass having to ask which branch wrote it.
  def slot(name : String, kind : String) : String
    slot_of(name, kind, "")
  end

  def slot_of(name : String, kind : String, shape : String) : String
    index = @slots.index(name)
    if index.nil?
      @slots << name
      @slot_kinds << kind
      @slot_shapes << shape
      write("%#{name}.slot = alloca #{kind}")
    end
    "%#{name}.slot"
  end

  def slot_shape(name : String) : String
    index = @slots.index(name)
    index.nil? ? "" : @slot_shapes[index]
  end

  def slot?(name : String) : Bool
    !@slots.index(name).nil?
  end

  def slot_kind(name : String) : String
    index = @slots.index(name)
    index.nil? ? "i32" : @slot_kinds[index]
  end

  # A block, and the label this pass is writing into now. A `phi` names
  # the block each of its values came from, and that is the block the arm
  # *ended* in rather than the one it started in: an `if` inside an arm
  # leaves the cursor somewhere else.
  def block(name : String) : Nil
    @lines = @lines + name + ":\n"
    @label = name
  end

  def label : String
    @label
  end

  def mark : Int32
    @marks = @marks + 1
    @marks
  end
end

# `+`, `-` and `*` on integers are instructions. The prelude declares
# them as primitives, so there is no body to emit and no call to make.
pub def instruction(name : String) : String
  return "add" if name == "+"
  return "sub" if name == "-"
  return "mul" if name == "*"
  ""
end

# A comparison is a primitive too, and it answers an `i1` rather than an
# `i32`. Signed, because every integer in this slice is an `Int32`.
pub def compare(name : String) : String
  return "slt" if name == "<"
  return "sle" if name == "<="
  return "sgt" if name == ">"
  return "sge" if name == ">="
  return "eq" if name == "=="
  return "ne" if name == "!="
  ""
end

# A branch: the condition, a block per arm, and a `phi` that names what
# each arm answered and the block it answered from. An arm with nothing
# in it answers zero, which is what an `if` with no `else` is worth on
# the side that did not run.
pub def emit_if(node : IfNode, body : Body, known : Known, constants : Constants) : Val
  condition = emit_one(node.cond, body, known, constants)
  mark = body.mark
  taken = "then#{mark}"
  other = "else#{mark}"
  join = "join#{mark}"

  body.write("br i1 #{condition.text}, label %#{taken}, label %#{other}")
  body.block(taken)
  first = emit_one(node.then_branch, body, known, constants)
  from_first = body.label
  body.write("br label %#{join}")

  body.block(other)
  second = emit_one(node.else_branch, body, known, constants)
  from_second = body.label
  body.write("br label %#{join}")

  body.block(join)
  reg = body.register
  body.write("#{reg} = phi i32 [ #{first.text}, %#{from_first} ], [ #{second.text}, %#{from_second} ]")
  int_val(reg)
end

# A loop: the condition in a block of its own, because it is asked again
# on every turn, and a body that branches back to it. Nothing has to be
# threaded around the back edge, because a local lives in a slot and is
# loaded where it is read.
#
# A loop is not a value, so it answers zero and the method answers what
# follows it.
pub def emit_while(node : WhileNode, body : Body, known : Known, constants : Constants) : Val
  mark = body.mark
  again = "loop#{mark}"
  inside = "body#{mark}"
  after = "done#{mark}"

  body.write("br label %#{again}")
  body.block(again)
  condition = emit_one(node.cond, body, known, constants)
  body.write("br i1 #{condition.text}, label %#{inside}, label %#{after}")

  body.block(inside)
  emit_one(node.body, body, known, constants)
  body.write("br label %#{again}")

  body.block(after)
  int_val("0")
end

# Where a field lives: the struct arrived in a slot, and a field is an
# offset into it.
pub def field_place(name : String, body : Body, known : Known) : String
  shape = known.shape_named(body.holder)[0]
  place = body.slot("self", shape.kind)
  # For a value the fields are in the slot; for a reference the slot
  # holds the pointer and the fields are where it points.
  unless shape.reference
    reg = body.register
    body.write("#{reg} = getelementptr #{shape.layout}, ptr #{place}, i32 0, i32 #{shape.index_of(name)}")
    return reg
  end
  object = body.register
  body.write("#{object} = load ptr, ptr #{place}")
  reg = body.register
  body.write("#{reg} = getelementptr #{shape.layout}, ptr #{object}, i32 0, i32 #{shape.index_of(name)}")
  reg
end

pub def emit(node : Node, body : Body, known : Known, constants : Constants) : Val
  case node
  when NumNode
    int_val(node.value)
  when VarNode
    kind = body.slot_kind(node.name)
    place = body.slot(node.name, kind)
    reg = body.register
    body.write("#{reg} = load #{kind}, ptr #{place}")
    Val.new(reg, kind, body.slot_shape(node.name))
  when IvarNode
    place = field_place(node.name, body, known)
    reg = body.register
    body.write("#{reg} = load i32, ptr #{place}")
    int_val(reg)
  when AssignNode
    value = emit_one(node.value, body, known, constants)
    if node.target.size > 0
      target = node.target[0]
      case target
      when VarNode
        body.write("store #{value.kind} #{value.text}, ptr #{body.slot_of(target.name, value.kind, value.shape)}")
      when IvarNode
        place = field_place(target.name, body, known)
        body.write("store i32 #{value.text}, ptr #{place}")
      end
    end
    value
  when ExprsNode
    answer = int_val("0")
    node.items.each { |item| answer = emit(item, body, known, constants) }
    answer
  when VisibilityModifierNode
    emit_one(node.body, body, known, constants)
  when IfNode
    emit_if(node, body, known, constants)
  when WhileNode
    emit_while(node, body, known, constants)
  when CallNode
    emit_call(node, body, known, constants)
  else
    int_val("0")
  end
end

pub def emit_one(nodes : Array(Node), body : Body, known : Known, constants : Constants) : Val
  return int_val("0") if nodes.size == 0
  answer = int_val("0")
  nodes.each { |node| answer = emit(node, body, known, constants) }
  answer
end

pub def emit_call(node : CallNode, body : Body, known : Known, constants : Constants) : Val
  # A comparison answers an `i1`, which is what a branch takes and the
  # only place this slice puts one.
  test = compare(node.name)
  if test != "" && node.recv.size == 1 && node.args.size == 1
    left = emit(node.recv[0], body, known, constants)
    right = emit(node.args[0], body, known, constants)
    reg = body.register
    body.write("#{reg} = icmp #{test} i32 #{left.text}, #{right.text}")
    return Val.new(reg, "i1")
  end

  # `a + b` is a call on a value, and the value is an integer: the
  # operator is an instruction rather than a function.
  op = instruction(node.name)
  if op != "" && node.recv.size == 1 && node.args.size == 1
    left = emit(node.recv[0], body, known, constants)
    right = emit(node.args[0], body, known, constants)
    reg = body.register
    body.write("#{reg} = #{op} i32 #{left.text}, #{right.text}")
    return int_val(reg)
  end

  # `print` of a literal is a write, the same way `+` is an `add`: the
  # prelude declares both and this knows what they do. Nothing else in
  # the prelude is known by name.
  if node.name == "print" && node.recv.size == 0 && node.args.size == 1
    written = node.args[0]
    case written
    when StrNode
      name = constants.add(written.value)
      reg = body.register
      body.write("#{reg} = call i64 @write(i32 1, ptr #{name}, i64 #{written.value.bytesize})")
      return int_val("0")
    end
  end

  # `Point.new(3, 1)` names a type rather than a value, and what it
  # answers is the struct itself.
  named = path_of(node.recv)
  if node.name == "new" && named != "" && known.shape?(named)
    return emit_new(named, node, body, known, constants)
  end

  # A method on a struct. The value arrives as the first argument,
  # because a struct is passed by value and there is nothing to point at.
  if node.recv.size == 1
    receiver = emit(node.recv[0], body, known, constants)
    holder = known.shape_of(receiver.shape)
    if holder.size > 0 && holder[0].knows?(node.name)
      return emit_method(holder[0], node, receiver, body, known, constants)
    end
    return int_val("0")
  end

  # Written with no receiver inside a method of a struct, this is a call
  # on that struct: `spread` reaches `x` and `y` without naming itself.
  if body.holder != "" && known.shape?(body.holder) &&
     known.shape_named(body.holder)[0].knows?(node.name)
    holder = known.shape_named(body.holder)[0]
    place = body.slot("self", holder.kind)
    reg = body.register
    body.write("#{reg} = load #{holder.kind}, ptr #{place}")
    return emit_method(holder, node, Val.new(reg, holder.kind, holder.name), body, known, constants)
  end

  if known.knows?(node.name)
    written = [] of Val
    node.args.each { |arg| written << emit(arg, body, known, constants) }
    reg = body.register
    body.write("#{reg} = call i32 @#{mangle(node.name)}(#{arguments(written)})")
    return int_val(reg)
  end

  # A name with no method and no instruction is a local read as a call,
  # which is what a bare `total` is before the parser knows it is one.
  if node.args.size == 0 && body.slot?(node.name)
    kind = body.slot_kind(node.name)
    place = body.slot(node.name, kind)
    reg = body.register
    body.write("#{reg} = load #{kind}, ptr #{place}")
    return Val.new(reg, kind, body.slot_shape(node.name))
  end
  int_val("0")
end

pub def emit_new(named : String, node : CallNode, body : Body, known : Known,
                 constants : Constants) : Val
  shape = known.shape_named(named)[0]
  written = [] of Val
  node.args.each { |arg| written << emit(arg, body, known, constants) }
  reg = body.register
  body.write("#{reg} = call #{shape.kind} @#{mangle_method(named, "new")}(#{arguments(written)})")
  Val.new(reg, shape.kind, shape.name)
end

pub def emit_method(shape : Shape, node : CallNode, receiver : Val, body : Body,
                    known : Known, constants : Constants) : Val
  written = [] of Val
  written << receiver
  node.args.each { |arg| written << emit(arg, body, known, constants) }
  reg = body.register
  body.write("#{reg} = call i32 @#{mangle_method(shape.name, node.name)}(#{arguments(written)})")
  int_val(reg)
end

pub def arguments(written : Array(Val)) : String
  pieces = [] of String
  written.each { |value| pieces << "#{value.kind} #{value.text}" }
  pieces.join(", ")
end

pub def path_of(nodes : Array(Node)) : String
  return "" if nodes.size == 0
  node = nodes[0]
  case node
  when PathNode then node.names
  else               ""
  end
end

# The name a method is emitted under. Prefixed, because `add` and `main`
# are names a C runtime already has and an operator is not a name at all.
pub def mangle(name : String) : String
  "iyi_#{name}"
end

pub def mangle_method(holder : String, name : String) : String
  "iyi_#{holder}_#{name}"
end

pub def parameters(node : DefNode, first : String) : String
  pieces = [] of String
  pieces << first unless first == ""
  index = 0
  node.args.each do |arg|
    case arg
    when ArgNode
      pieces << "i32 %arg#{index}"
      index = index + 1
    end
  end
  pieces.join(", ")
end

# An argument arrives in a register and a local lives in a slot, so the
# first thing a body does is put it there.
pub def store_arguments(node : DefNode, body : Body) : Nil
  index = 0
  node.args.each do |arg|
    case arg
    when ArgNode
      body.write("store i32 %arg#{index}, ptr #{body.slot(arg.name, "i32")}")
      index = index + 1
    end
  end
end

pub def emit_def(node : DefNode, known : Known, constants : Constants) : String
  body = Body.new("")
  store_arguments(node, body)
  answer = emit_one(node.body, body, known, constants)
  "define i32 @#{mangle(node.name)}(#{parameters(node, "")}) {\nentry:\n#{body.text}  ret i32 #{answer.text}\n}\n"
end

# A method of a struct. `self` arrives by value and is put in a slot, so
# a field read is the same shape as a local read: an offset and a load.
pub def emit_method_def(shape : Shape, node : DefNode, known : Known,
                        constants : Constants) : String
  body = Body.new(shape.name)
  body.write("store #{shape.kind} %self, ptr #{body.slot("self", shape.kind)}")
  store_arguments(node, body)
  answer = emit_one(node.body, body, known, constants)
  "define i32 @#{mangle_method(shape.name, node.name)}(#{parameters(node, "#{shape.kind} %self")}) {\nentry:\n#{body.text}  ret i32 #{answer.text}\n}\n"
end

# The `new` the compiler writes: it runs the constructor's body against a
# value of its own and answers that value. A struct is passed by value,
# so there is nothing to allocate beyond the slot the body writes into.
pub def emit_new_def(shape : Shape, node : DefNode, known : Known,
                     constants : Constants) : String
  body = Body.new(shape.name)
  body.slot("self", shape.kind)
  if shape.reference
    object = body.register
    body.write("#{object} = call ptr @malloc(i64 #{shape.bytes})")
    body.write("store ptr #{object}, ptr %self.slot")
  end
  store_arguments(node, body)
  emit_one(node.body, body, known, constants)
  reg = body.register
  body.write("#{reg} = load #{shape.kind}, ptr %self.slot")
  "define #{shape.kind} @#{mangle_method(shape.name, "new")}(#{parameters(node, "")}) {\nentry:\n#{body.text}  ret #{shape.kind} #{reg}\n}\n"
end

# The program's own entry. `__iyi_exit(e)` is what a fixture ends on and
# what it is worth, so it is emitted as the return from `main`: the
# status a process exits with is the one thing both compilers can be
# asked for. Everything above it is emitted in order, because a `print`
# before the exit is part of what the program does.
pub def emit_main(nodes : Array(Node), known : Known, constants : Constants) : String
  body = Body.new("")
  answer = int_val("0")
  nodes.each do |node|
    case node
    when CallNode
      if node.name == "__iyi_exit" && node.args.size == 1
        answer = emit(node.args[0], body, known, constants)
      else
        emit(node, body, known, constants)
      end
    end
  end
  "define i32 @main() {\nentry:\n#{body.text}  ret i32 #{answer.text}\n}\n"
end

# What a struct holds, read off the constructor: the parser writes
# `def initialize(@x : Int32)` as an argument and an assignment, so the
# fields are the assignments in the order they are made.
pub def learn_fields(nodes : Array(Node), shape : Shape) : Nil
  nodes.each do |node|
    case node
    when ExprsNode
      learn_fields(node.items, shape)
    when AssignNode
      if node.target.size > 0
        target = node.target[0]
        case target
        when IvarNode then shape.add_field(target.name)
        end
      end
    end
  end
end

pub def collect(nodes : Array(Node), known : Known) : Nil
  nodes.each do |node|
    case node
    when ExprsNode
      collect(node.items, known)
    when VisibilityModifierNode
      collect(node.body, known)
    when DefNode
      known.add(node)
    when ClassDefNode
      shape = Shape.new(path_of(node.name), node.kind == "class")
      known.add_shape(shape)
      collect_shape(node.body, shape)
    end
  end
end

pub def collect_shape(nodes : Array(Node), shape : Shape) : Nil
  nodes.each do |node|
    case node
    when ExprsNode
      collect_shape(node.items, shape)
    when VisibilityModifierNode
      collect_shape(node.body, shape)
    when DefNode
      shape.add(node)
      learn_fields(node.body, shape) if node.name == "initialize"
    end
  end
end

pub def top_items(tree : Node) : Array(Node)
  case tree
  when ExprsNode then tree.items
  else                [tree] of Node
  end
end

path = Program.args[0]?
if path.nil?
  puts "usage: emit <file.iyi>"
else
  tree = Parser.new(File.read(path)).parse
  items = top_items(tree)
  known = Known.new
  collect(items, known)

  constants = Constants.new
  functions = ""
  known.shapes.each do |shape|
    shape.defs.each do |node|
      functions = functions + if node.name == "initialize"
        emit_new_def(shape, node, known, constants)
      else
        emit_method_def(shape, node, known, constants)
      end + "\n"
    end
  end
  known.nodes.each { |node| functions = functions + emit_def(node, known, constants) + "\n" }
  functions = functions + emit_main(items, known, constants)

  puts "; #{path}, emitted by selfhost/codegen/emit.iyi"
  # The one thing this slice borrows from outside the program it is
  # compiling. The current compiler writes the syscall itself; the port
  # calls the C library's, and what the gate compares is the bytes that
  # reach stdout either way.
  puts "declare i64 @write(i32, ptr, i64)"
  puts "declare ptr @malloc(i64)"
  puts ""
  known.shapes.each { |shape| puts shape.declaration }
  puts ""
  print constants.text
  puts ""
  print functions
end
