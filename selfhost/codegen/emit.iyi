module main

# The first codegen slice, written in iyi: LLVM IR for a program whose
# every value is an `Int32`.
#
# The other slices diff a tree or a type against the current compiler's.
# Two independent backends do not write the same IR, so comparing the
# text would measure spelling. What this slice compares is what the
# program *does*: the fixture ends in `__iyi_exit`, both compilers turn
# it into an executable, and the gate diffs the exit status.
#
# Scope, and it is narrow on purpose: integer literals, `+`, `-` and `*`,
# local assignment and lookup, arguments, and a call to a method declared
# in the same file. Not here: any other type, `if`, loops, strings,
# allocation, a method on anything but an integer. Each of those wants
# its own diffed slice rather than a guess, and the arithmetic is the one
# that needs no runtime underneath it.
#
# The operators are the prelude's primitives. `@[Primitive(:binary)] def
# +(other : Int32) : self` is an instruction rather than a body, which is
# why this slice can emit `add` without reading the prelude at all.

import std/file
import parser/parser
using std/file::{File}
using parser/parser::{Parser, Node, IfNode, WhileNode, StrNode, NumNode, VarNode, AssignNode, ExprsNode, DefNode, ArgNode, CallNode, RequireNode, VisibilityModifierNode}

# The methods the file declares, by name, so a call can find the one it
# reaches and know how many arguments to pass.
pub class Methods
  @names : Array(String)
  @nodes : Array(DefNode)

  def initialize
    @names = [] of String
    @nodes = [] of DefNode
  end

  def add(node : DefNode) : Nil
    @names << node.name
    @nodes << node
  end

  def names : Array(String)
    @names
  end

  def nodes : Array(DefNode)
    @nodes
  end

  def knows?(name : String) : Bool
    !@names.index(name).nil?
  end
end

# The module's string constants. A literal is bytes with a name, and
# the name is what the call passes. Collected while the functions are
# emitted and printed above them, so the text reads in the order LLVM
# would have written it.
pub class Constants
  @lines : String
  @count : Int32

  def initialize
    @lines = ""
    @count = 0
  end

  def text : String
    @lines
  end

  # The bytes of a literal, as LLVM spells them: every byte that is not
  # plain ASCII is written as two hex digits, because a newline inside a
  # constant would end the line it is written on.
  def add(text : String) : String
    name = "@str#{@count}"
    @count = @count + 1
    written = ""
    index = 0
    while index < text.bytesize
      ch = text[index]
      written = written + if ch == '"' || ch == '\\' || ch.ord < 32 || ch.ord > 126
        "\\#{hex(ch.ord)}"
      else
        ch.to_s
      end
      index = index + 1
    end
    @lines = @lines + "#{name} = private unnamed_addr constant [#{text.bytesize} x i8] c\"#{written}\"\n"
    name
  end

  def hex(value : Int32) : String
    # Integer division, spelled so: a bare `/` on two integers is a
    # float here, and the prelude offers both.
    "#{digit(value // 16)}#{digit(value % 16)}"
  end

  def digit(value : Int32) : String
    return "#{value}" if value < 10
    return "A" if value == 10
    return "B" if value == 11
    return "C" if value == 12
    return "D" if value == 13
    return "E" if value == 14
    "F"
  end
end

# One function's worth of instructions. `value` names what an expression
# answered: either a literal, which needs no instruction, or a register.
pub class Body
  @lines : String
  @next : Int32
  @slots : Array(String)
  # Which block the cursor is in, and how many branches have been given
  # labels, so two `if`s in one method do not share them.
  @label : String
  @marks : Int32

  def initialize
    @lines = ""
    @next = 0
    @slots = [] of String
    @label = "entry"
    @marks = 0
  end

  def text : String
    @lines
  end

  def write(line : String) : Nil
    @lines = @lines + "  " + line + "\n"
  end

  # A fresh register. LLVM names them itself when they are unnamed, and
  # naming them here keeps the emitted text readable and the counter
  # under this pass's control rather than the printer's.
  def register : String
    name = "%t#{@next}"
    @next = @next + 1
    name
  end

  # A local lives in a slot rather than a register, so an assignment can
  # rewrite it without this pass having to ask which branch wrote it.
  def slot(name : String) : String
    unless @slots.includes?(name)
      @slots << name
      write("%#{name}.slot = alloca i32")
    end
    "%#{name}.slot"
  end

  def slot?(name : String) : Bool
    @slots.includes?(name)
  end

  # A block, and the label this pass is writing into now. A `phi` names
  # the block each of its values came from, and that is the block the
  # arm *ended* in rather than the one it started in: an `if` inside an
  # arm leaves the cursor somewhere else.
  def block(name : String) : Nil
    @lines = @lines + name + ":\n"
    @label = name
  end

  def label : String
    @label
  end

  def mark : Int32
    @marks = @marks + 1
    @marks
  end
end

# `+`, `-` and `*` on integers are instructions. The prelude declares
# them as primitives, so there is no body to emit and no call to make.
pub def instruction(name : String) : String
  return "add" if name == "+"
  return "sub" if name == "-"
  return "mul" if name == "*"
  ""
end

# A comparison is a primitive too, and it answers an `i1` rather than an
# `i32`. Signed, because every integer in this slice is an `Int32`.
pub def compare(name : String) : String
  return "slt" if name == "<"
  return "sle" if name == "<="
  return "sgt" if name == ">"
  return "sge" if name == ">="
  return "eq" if name == "=="
  return "ne" if name == "!="
  ""
end

# A branch: the condition, a block per arm, and a `phi` that names what
# each arm answered and the block it answered from. An arm with nothing
# in it answers zero, which is what an `if` with no `else` is worth on
# the side that did not run.
pub def emit_if(node : IfNode, body : Body, methods : Methods, constants : Constants) : String
  condition = emit_one(node.cond, body, methods, constants)
  mark = body.mark
  taken = "then#{mark}"
  other = "else#{mark}"
  join = "join#{mark}"

  body.write("br i1 #{condition}, label %#{taken}, label %#{other}")
  body.block(taken)
  first = emit_one(node.then_branch, body, methods, constants)
  from_first = body.label
  body.write("br label %#{join}")

  body.block(other)
  second = emit_one(node.else_branch, body, methods, constants)
  from_second = body.label
  body.write("br label %#{join}")

  body.block(join)
  reg = body.register
  body.write("#{reg} = phi i32 [ #{first}, %#{from_first} ], [ #{second}, %#{from_second} ]")
  reg
end

# A loop: the condition in a block of its own, because it is asked
# again on every turn, and a body that branches back to it. Nothing has
# to be threaded around the back edge, because a local lives in a slot
# and is loaded where it is read.
#
# A loop is not a value, so it answers zero and the method answers what
# follows it.
pub def emit_while(node : WhileNode, body : Body, methods : Methods, constants : Constants) : String
  mark = body.mark
  again = "loop#{mark}"
  inside = "body#{mark}"
  after = "done#{mark}"

  body.write("br label %#{again}")
  body.block(again)
  condition = emit_one(node.cond, body, methods, constants)
  body.write("br i1 #{condition}, label %#{inside}, label %#{after}")

  body.block(inside)
  emit_one(node.body, body, methods, constants)
  body.write("br label %#{again}")

  body.block(after)
  "0"
end

pub def emit(node : Node, body : Body, methods : Methods, constants : Constants) : String
  case node
  when NumNode
    node.value
  when VarNode
    place = body.slot(node.name)
    reg = body.register
    body.write("#{reg} = load i32, ptr #{place}")
    reg
  when AssignNode
    value = emit_one(node.value, body, methods, constants)
    if node.target.size > 0
      target = node.target[0]
      case target
      when VarNode
        body.write("store i32 #{value}, ptr #{body.slot(target.name)}")
      end
    end
    value
  when ExprsNode
    answer = "0"
    node.items.each { |item| answer = emit(item, body, methods, constants) }
    answer
  when VisibilityModifierNode
    emit_one(node.body, body, methods, constants)
  when IfNode
    emit_if(node, body, methods, constants)
  when WhileNode
    emit_while(node, body, methods, constants)
  when CallNode
    emit_call(node, body, methods, constants)
  else
    "0"
  end
end

pub def emit_one(nodes : Array(Node), body : Body, methods : Methods, constants : Constants) : String
  return "0" if nodes.size == 0
  answer = "0"
  nodes.each { |node| answer = emit(node, body, methods, constants) }
  answer
end

pub def emit_call(node : CallNode, body : Body, methods : Methods, constants : Constants) : String
  # `a + b` is a call on a value, and the value is an integer: the
  # operator is an instruction rather than a function.
  # A comparison answers an `i1`, which is what a branch takes and the
  # only place this slice puts one.
  test = compare(node.name)
  if test != "" && node.recv.size == 1 && node.args.size == 1
    left = emit(node.recv[0], body, methods, constants)
    right = emit(node.args[0], body, methods, constants)
    reg = body.register
    body.write("#{reg} = icmp #{test} i32 #{left}, #{right}")
    return reg
  end

  op = instruction(node.name)
  if op != "" && node.recv.size == 1 && node.args.size == 1
    left = emit(node.recv[0], body, methods, constants)
    right = emit(node.args[0], body, methods, constants)
    reg = body.register
    body.write("#{reg} = #{op} i32 #{left}, #{right}")
    return reg
  end

  # `print` of a literal is a write, the same way `+` is an `add`: the
  # prelude declares both and this knows what they do. Nothing else in
  # the prelude is known by name.
  if node.name == "print" && node.recv.size == 0 && node.args.size == 1
    written = node.args[0]
    case written
    when StrNode
      name = constants.add(written.value)
      reg = body.register
      body.write("#{reg} = call i64 @write(i32 1, ptr #{name}, i64 #{written.value.bytesize})")
      return "0"
    end
  end

  if node.recv.size == 0 && methods.knows?(node.name)
    written = [] of String
    node.args.each { |arg| written << emit(arg, body, methods, constants) }
    reg = body.register
    body.write("#{reg} = call i32 @#{mangle(node.name)}(#{arguments(written)})")
    return reg
  end

  # A name with no method and no instruction is a local read as a call,
  # which is what a bare `total` is before the parser knows it is one.
  if node.recv.size == 0 && node.args.size == 0 && body.slot?(node.name)
    place = body.slot(node.name)
    reg = body.register
    body.write("#{reg} = load i32, ptr #{place}")
    return reg
  end
  "0"
end

pub def arguments(written : Array(String)) : String
  pieces = [] of String
  written.each { |value| pieces << "i32 #{value}" }
  pieces.join(", ")
end

# The name a method is emitted under. Prefixed, because `add` and `main`
# are names a C runtime already has and an operator is not a name at all.
pub def mangle(name : String) : String
  "iyi_#{name}"
end

pub def parameters(node : DefNode) : String
  pieces = [] of String
  index = 0
  node.args.each do |arg|
    case arg
    when ArgNode
      pieces << "i32 %arg#{index}"
      index = index + 1
    end
  end
  pieces.join(", ")
end

pub def emit_def(node : DefNode, methods : Methods, constants : Constants) : String
  body = Body.new
  index = 0
  node.args.each do |arg|
    case arg
    when ArgNode
      # An argument arrives in a register and a local lives in a slot, so
      # the first thing a body does is put it there.
      body.write("store i32 %arg#{index}, ptr #{body.slot(arg.name)}")
      index = index + 1
    end
  end
  answer = emit_one(node.body, body, methods, constants)
  "define i32 @#{mangle(node.name)}(#{parameters(node)}) {\nentry:\n#{body.text}  ret i32 #{answer}\n}\n"
end

# The program's own entry. `__iyi_exit(e)` is what the fixture ends on
# and what it is worth, so it is emitted as the return from `main`: the
# status a process exits with is the one thing both compilers can be
# asked for.
pub def emit_main(nodes : Array(Node), methods : Methods, constants : Constants) : String
  body = Body.new
  answer = "0"
  nodes.each do |node|
    case node
    when CallNode
      if node.name == "__iyi_exit" && node.args.size == 1
        answer = emit(node.args[0], body, methods, constants)
      else
        emit(node, body, methods, constants)
      end
    end
  end
  "define i32 @main() {\nentry:\n#{body.text}  ret i32 #{answer}\n}\n"
end

pub def top_items(tree : Node) : Array(Node)
  case tree
  when ExprsNode then tree.items
  else                [tree] of Node
  end
end

path = Program.args[0]?
if path.nil?
  puts "usage: emit <file.iyi>"
else
  tree = Parser.new(File.read(path)).parse
  items = top_items(tree)
  methods = Methods.new
  items.each do |node|
    case node
    when DefNode then methods.add(node)
    end
  end

  constants = Constants.new
  functions = ""
  methods.nodes.each { |node| functions = functions + emit_def(node, methods, constants) + "\n" }
  functions = functions + emit_main(items, methods, constants)

  puts "; #{path}, emitted by selfhost/codegen/emit.iyi"
  # The one thing this slice borrows from outside the program it is
  # compiling. The current compiler writes the syscall itself; the port
  # calls the C library's, and what the gate compares is the bytes that
  # reach stdout either way.
  puts "declare i64 @write(i32, ptr, i64)"
  puts ""
  print constants.text
  puts ""
  print functions
end
