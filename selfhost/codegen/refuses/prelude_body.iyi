# Not a fixture: a program this slice is required to refuse.
#
# `abs`, `even?` and `odd?` are declared in `src/iyi/number.iyi` with
# bodies written in iyi rather than as primitives, and emitting a body
# out of the prelude is the slice after this one.
#
# What makes this a gate rather than a note is what the emitter used to
# do with it. A call it could not answer returned a literal zero, so
# `(0 - 9).abs` came out as `add i32 %t, 0`, the module assembled, the
# program ran, and it exited 0 where the compiler exits 39. Every
# fixture passed, because none of them reached one.
#
# A gate that compares exit status cannot see a wrong answer that is
# also a plausible one. So the emitter names what it could not do and
# exits non-zero, and `diff.sh` requires that of every file here.

def answer : Int32
  total = 0
  total = total + (0 - 9).abs
  total = total + (4.even? ? 10 : 0)
  total = total + (7.odd? ? 20 : 0)
  total
end

__iyi_exit(answer)
