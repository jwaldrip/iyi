    max-width: var(--measure);
    color: var(--graphite);
    font-size: var(--step-0);
    line-height: var(--lead-snug);
  }

  /* The badge. Four states, and the signal colour appears on exactly one of
   * them, because a service that is not answering is a caveat and that is the
   * only thing this colour means on the site. */
  .badge {
    margin: 0;
    font-size: var(--step--2);
    color: var(--graphite);
    border: var(--hair) solid var(--hairline);
    padding: 0.3rem 0.7rem;
    white-space: normal;
    max-width: 34ch;
  }

  .badge-label {
    color: var(--mute);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-inline-end: 0.6ch;
  }

  .badge[data-state="silent"] {
    color: var(--signal-deep);
    border-color: var(--signal);
  }

  .badge[data-state="absent"] {
    color: var(--mute);
  }

  /* The control bar. */
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 0.5rem 0.8rem;
    border-block: var(--hair) solid var(--hairline);
    padding-block: 0.6rem;
    position: relative;
  }

  .run {
    font-weight: 600;
  }

  .chord {
    color: var(--mute);
    margin-inline-start: 0.7ch;
    font-size: var(--step--2);
  }

  .run:disabled .chord {
    color: var(--track);
  }

  /* The sample menu. A disclosure holding real links, so it needs no script
   * and a deep link into it is a URL rather than a state. */
  .menu {
    position: relative;
  }

  .menu summary {
    cursor: pointer;
    list-style: none;
  }

  .menu summary::-webkit-details-marker {
    display: none;
  }

  .menu summary::after {
    content: "";
    display: inline-block;
    margin-inline-start: 0.7ch;
    border: 0.3em solid transparent;
    border-top-color: var(--mute);
    transform: translateY(0.15em);
  }

  .menu-body {
    position: absolute;
    z-index: 2;
    inset-inline-start: 0;
    inset-block-start: calc(100% + 0.35rem);
    min-width: 26ch;
    max-width: 40ch;
    background: var(--raise);
    border: var(--hair) solid var(--hairline);
    padding: 0.6rem 0.8rem;
  }

  .menu-body ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(11ch, 1fr));
    gap: 0.15rem 0.9rem;
  }

  .pick {
    font-size: var(--step--2);
    color: var(--graphite);
    text-decoration: none;
  }

  .pick:hover {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--signal);
    text-underline-offset: 0.18em;
  }

  .pick[aria-current="page"] {
    color: var(--ink);
    font-weight: 600;
  }

  /* A sample the recording gave a note to behaves unusually on this target,
   * which is a caveat, which is the one thing the signal colour means. The
   * tittle marks it rather than a badge. */
  .pick[data-lesson]::after {
    content: "";
    display: inline-block;
    width: var(--tittle);
    height: var(--tittle);
    margin-inline-start: 0.35ch;
    vertical-align: 0.28em;
    border-radius: 50%;
    background: var(--signal);
  }

  .menu-note {
    margin: 0.7rem 0 0;
    padding-block-start: 0.5rem;
    border-top: var(--hair) solid var(--hairline);
    font-size: var(--step--2);
    color: var(--mute);
    line-height: 1.5;
  }

  .share-note {
    flex-basis: 100%;
    margin: 0.2rem 0 0;
    font-size: var(--step--2);
    color: var(--graphite);
    max-width: var(--measure);
    line-height: 1.5;
  }

  .share-note.refused {
    color: var(--signal-deep);
  }

  /* THE PANES. Editor first in source order, so the stacked order below the
   * breakpoint is editor then output with no reordering: the thing the page is
   * about is the thing a narrow screen shows first. */
  .panes {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: var(--gutter);
    align-items: start;
  }

  @media (max-width: 62rem) {
    .panes {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .pane-editor {
    margin: 0;
  }

  .pane-output {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-width: 0;
  }

  /* The editor. Two layers in one grid cell: the colouring behind, the editable
   * text in front with its glyphs made transparent so the layer underneath
   * shows through. Every metric that affects where a glyph lands is declared on
   * both, because one difference in padding or line height slides the emphasis
   * off the tokens it belongs to.
   *
   * Selectors are two classes deep so they beat `.source pre` from code.css,
   * which sets `overflow: visible` and would otherwise stop the two layers
   * scrolling as one. */
  .editor {
    display: grid;
    height: clamp(20rem, 58vh, 40rem);
  }

  .editor .editor-ink,
  .editor .editor-text {
    grid-area: 1 / 1;
    margin: 0;
    padding: 0.95rem 1.1rem;
    border: 0;
    background: none;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-variant-ligatures: none;
    line-height: 1.58;
    letter-spacing: normal;
    word-spacing: normal;
    tab-size: 2;
    white-space: pre;
  }

  .editor :global(.editor-ink) {
    color: var(--ink);
    overflow: hidden;
    pointer-events: none;
  }

  .editor .editor-text {
    color: transparent;
    -webkit-text-fill-color: transparent;
    caret-color: var(--ink);
    overflow: auto;
    resize: none;
  }

  /* No colouring to show through, so the text becomes ink in its own right. */
  .editor .editor-text.plain {
    color: var(--ink);
    -webkit-text-fill-color: var(--ink);
  }

  .editor .editor-text::selection {
    background: var(--track);
  }

  .editor .editor-text:focus {
    outline: none;
    box-shadow: inset 0 0 0 var(--hair) var(--graphite);
  }

  .source-foot {
    border-top: var(--hair) solid var(--hairline);
    border-bottom: 0;
    gap: 0.8rem;
  }

  .source-foot span {
    white-space: normal;
    line-height: 1.5;
  }

  .console {
    min-height: 12rem;
  }

  .console pre {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .console :global(.idle) {
    color: var(--mute);
  }

  /* Diagnostics, under the output, because that is the order a person reads
   * them in: what happened, then why it did not. */
  .diagnostics .label {
    margin: 0 0 0.3rem;
  }

  .pane-note {
    margin: 0;
    font-size: var(--step--2);
    color: var(--mute);
    line-height: 1.5;
  }

  .diagnostics :global(.case) {
    margin-block-start: 1rem;
  }

  .diagnostics :global(.case h3) {
    font-size: var(--step--2);
    color: var(--mute);
    margin: 0 0 0.3rem;
  }

  /* The stages this engine does not reach. */
  .stages {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.2rem;
    align-items: flex-start;
  }

  .stage {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .stage-note {
    font-size: var(--step--2);
    color: var(--mute);
  }

  .stages .decl-toggle:disabled,
  .bar .decl-toggle:disabled {
    cursor: not-allowed;
    color: var(--mute);
    border-color: var(--track);
    background: var(--paper);
  }

  .rail {
    margin-block: 0.4rem 0;
  }

  .rail dd a {
    color: inherit;
  }

  /* Runtime-only blocks: nodes the client script creates cannot carry Astro's
   * scoped attributes, so these are declared global. They use only tokens, and
   * the signal colour appears only on a refusal, which is a caveat. */
  :global(.gap) {
    color: var(--signal);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    line-height: 1.6;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  :global(.stamp) {
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    line-height: 1.6;
    border: var(--hair) solid var(--hairline);
    border-left: 2px solid var(--hairline);
    background: var(--paper);
    padding: 0.6rem 1.1rem;
    border-radius: 2px;
  }

  :global(.stamp-note) {
    display: block;
    margin-block-start: 0.3rem;
    font-size: var(--step--2);
    color: var(--mute);
  }
</style>
