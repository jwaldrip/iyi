@[Unsafe("reads LLVM's C objects through raw handles this module does not own, which the compiler does not check")]
module compiler/backend/llvm/import

import compiler/ir/types::{IrType, valid_int_bits?}
import compiler/ir/values::{Value, Param, canonical_words, int_words_parse}
import compiler/ir/inst::{Op, Inst, Block, CallConv, Ordering, Attribute, CallAux, AsmAux, AsmDialect, GepAux, MemAux, IntrinsicAux, DebugLoc}
import compiler/ir/function::{Function, Global, Linkage, TlsModel, Visibility}
import compiler/ir/module::{Module}
import compiler/ir/layout::{DataLayout, LayoutError}
import compiler/ir/intrinsics::{intrinsic_match, intrinsic_signature}
import compiler/platform/target::{Target}
import compiler/llvm/lib_llvm::{string_from_c, to_c_str, string_and_dispose}

# LLVM's value kind, linkage and calling convention, read through the C API's enums (as plain numbers:
# LLVM 22 gives values past the enums' members, which the enums carry without checking).
pub def llvm_value_kind(ref : LibLLVM::ValueRef) : Int32
  LibLLVM.get_value_kind(ref).value
end

pub def llvm_linkage(ref : LibLLVM::ValueRef) : Int32
  LibLLVM.get_linkage(ref).value
end

pub def llvm_calling_convention(ref : LibLLVM::ValueRef) : Int32
  LibLLVM.get_function_call_convention(ref).value
end

# A refusal, by name: the LLVM module uses something the IR's closed sets do not contain.
pub class ImportError
  getter message : String

  def initialize(@message : String)
  end

  def to_s : String
    @message
  end
end

