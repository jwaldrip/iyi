import compiler/syntax/parser::{Parser}
import compiler/syntax/visitor::{Visitor}
import compiler/syntax/token::{NumberKind}
import compiler/semantic/top_level::{SemanticProgram, TopLevelVisitor, Type, ClassType, NonGenericClassType}
import compiler/semantic/instance_vars::{declare_guessed_instance_vars}
import compiler/semantic/main_visitor::{MainVisitor}
import compiler/macros/interpreter::{MacroInterpreter}
import compiler/macros/methods::{MacroMethods}
import compiler/macros/engine::{MacroEngine}
import compiler/macros/target_flags::{MacroTargetFlags}
