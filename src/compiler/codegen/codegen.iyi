# Code Generation - Stage 2 Self-hosting Slice: Typed AST to IR
#
# Slice boundary:
# Emits IR for top-level `fun` declarations and custom type declarations:
# - Integer and float arithmetic (+, -, *, /, //, %, &+, &-, &*, unsafe_div, unsafe_mod,
#   &, |, ^, <<, >>, unsafe_shl, unsafe_shr)
# - Integer and float comparisons (<, <=, >, >=, ==, !=)
# - Local variable allocation (stack alloca), store, and load
# - Control flow: `if`/`else` branching and phi value merges, and `while` loops
# - Calls between `fun` functions
# - Struct definitions, initialization (Point.new), field access (p.x, p.x = val)
# - Struct methods (p.distance_sq, v1.dot(v2), v1.add(v2))
# - Pointers and Pointer(T) operations (pointerof, ptr.value, ptr.value=, ptr + off, ptr - other, ptr.address, Pointer(T).new)
# - Classes with instance variables and method dispatch (Counter.new, c.count, c.increment, Multiplier.new, m.scaled)
#
# Explicitly excluded from this slice:
# - Closures and proc literals
# - Exception handling: `rescue` and `ensure` are refused with the oracle's message, not lowered
# - Generics instantiation beyond Pointer(T)
# - Garbage collection interface (classes use malloc directly)
# - Dynamic virtual hierarchy dispatch tables (~match<Base+>)

@[Unsafe("reads a UInt64's bits back as an Int64 through a pointer cast, which the compiler does not check")]
module compiler/codegen/codegen

