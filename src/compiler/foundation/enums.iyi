module compiler/foundation/enums

struct ::Enum
  def ==(other : self) : Bool
    value == other.value
  end

  def ===(other : self) : Bool
    value == other.value
  end

  def !=(other : self) : Bool
    value != other.value
  end

  def <(other : self) : Bool
    value < other.value
  end

  def <=(other : self) : Bool
    value <= other.value
  end

  def >(other : self) : Bool
    value > other.value
  end

  def >=(other : self) : Bool
    value >= other.value
  end
end
