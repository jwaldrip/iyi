# Hosted release uses LLVM's ordinary O3 pipeline (compiler.cr:4407-4468).
# The collector scans the optimized stack conservatively (GC_DESIGN.md:58-59).
# CSE reuses an identical dominating computation; it creates no new address.

module compiler/ir/opt/cse

import compiler/ir/types::{IrType}
import compiler/ir/values::{Value, canonical_words}
import compiler/ir/inst::{Op, Inst, GepAux, IntrinsicAux, terminator_op?}
import compiler/ir/function::{Function, Global}
import compiler/ir/module::{Module}
import compiler/ir/intrinsics::{IntrinsicId}
import compiler/ir/layout::{DataLayout}
import compiler/ir/opt/analysis::{Cfg, DomTree, DefUse}
import compiler/ir/opt/edit::{Editor}
import compiler/ir/opt/effects::{opaque?, pure?, reads_memory?, writes_memory?, has_side_effects?}
import compiler/ir/opt/escape::{sizeof_value}
import compiler/ir/opt/fold::{canonical, int_value}

class CseFrame
  getter block : Int32
  getter mark : Int32
  property entered : Bool
  property child : Int32

  def initialize(@block : Int32, @mark : Int32)
    @entered = false
    @child = 0
  end
end

# The stack frame of the walk over constant operands in reaches_flag?.
class ConstWalk
  getter node : Inst
  property child : Int32

  def initialize(@node : Inst)
    @child = 0
  end
end

# Memsets longer than this stay: the zeroing rule holds one flag per byte of the range.
ZEROING_LIMIT = 4096_i64

# The marking flag is the one global whose address the write barrier reads.
def flag_global?(value : Value) : Bool
  value.is_a?(Global) && value.as(Global).name == "__iyi_marking"
end

# The flag's address as an instruction: a GlobalAddr of the flag.
def flag_address?(value : Value) : Bool
  return false unless value.is_a?(Inst)
  inst = value.as(Inst)
  inst.op == Op::GlobalAddr && inst.args.size == 1 && flag_global?(inst.args[0])
end

# Constants can hold the flag's address in their operands. Plain instructions cannot: they carry it only through the
# derivations that find_marking_derivations follows.
def constant_node?(value : Value) : Bool
  return false unless value.is_a?(Inst)
  op = value.as(Inst).op
  op == Op::ConstExpr || op == Op::ConstAggregate || op == Op::GlobalAddr
end

# A getelementptr, as an instruction or as a constant expression.
def gep_form?(inst : Inst) : Bool
  is_gep = inst.op == Op::Gep || (inst.op == Op::ConstExpr && inst.aux_int == Op::Gep.value.to_i64)
  is_gep && inst.aux.is_a?(GepAux) && !inst.args.empty?
end

# Operations whose result is a function of their operands: an address that reaches an operand reaches the result.
def derives_result?(inst : Inst) : Bool
  case inst.op
  when Op::Gep, Op::PtrToInt, Op::IntToPtr, Op::BitCast, Op::AddrSpaceCast, Op::Trunc, Op::ZExt, Op::SExt,
       Op::Add, Op::Sub, Op::Mul, Op::SDiv, Op::UDiv, Op::SRem, Op::URem, Op::Shl, Op::LShr, Op::AShr,
       Op::And, Op::Or, Op::Xor, Op::ICmp, Op::Select, Op::Phi, Op::Freeze
    true
  when Op::Intrinsic
    inst.aux.is_a?(IntrinsicAux) && inst.aux.as(IntrinsicAux).id == IntrinsicId::ExpectI1
  else
    false
  end
end

# How operand `index` of `user` takes a value that may carry the flag's address.
#   0: an address (a load's pointer, a store's destination). Memory is read or written; nothing is derived.
#   1: a derivation. The result may carry the address.
#   2: a leak. The address may reach memory, a call, a return, an aggregate, a branch, or an operation not listed.
def flow_kind(user : Inst, index : Int32) : Int32
  if user.op == Op::Load
    0
  elsif user.op == Op::Store
    index == 1 ? 0 : 2
  elsif user.op == Op::Select && index == 0
    2
  elsif derives_result?(user)
    1
  else
    2
  end
end

# Results that memory or a call can supply. Once the address has escaped, it can come back through one of them.
def returned_source?(inst : Inst) : Bool
  case inst.op
  when Op::Load, Op::Call, Op::Invoke, Op::ExtractValue, Op::AtomicRmw, Op::CmpXchg, Op::VaArg, Op::LandingPad
    true
  when Op::Intrinsic
    !derives_result?(inst)
  else
    false
  end
end

# The byte offset that a getelementptr with constant indices adds to its base, through the data layout.
def gep_delta(layout : DataLayout, gep : Inst) : Int64?
  delta = 0_i64
  current = gep.aux.as(GepAux).source_type
  k = 1
  while k < gep.args.size
    index = constant_index(gep.args[k])
    return nil if index.nil?
    n = index.as(Int64)
    if k == 1
      delta = delta + n * layout.alloc_size(current)
    elsif current.struct?
      fields = current.struct_element_types
      return nil if n < 0_i64 || n >= fields.size.to_i64
      delta = delta + layout.offset_of(current, n.to_i32)
      current = fields[n.to_i32]
    elsif current.array?
      delta = delta + n * layout.alloc_size(current.element_type)
      current = current.element_type
    else
      return nil
    end
    k = k + 1
  end
  delta
end

# A constant getelementptr index. An i1 index is signed (true is -1), so it is not read as a constant.
def constant_index(value : Value) : Int64?
  return nil unless value.type.int? && value.type.bits > 1
  int_value(value)
end

def plain_scalar?(type : IrType) : Bool
  type.int? || type.float? || type.pointer?
end

# A pointer's root and its byte offset from that root. `exact` is false when a getelementptr index is not constant.
class CseAddress
  getter base : Value
  getter offset : Int64
  getter exact : Bool

  def initialize(@base : Value, @offset : Int64, @exact : Bool)
  end
end

# Peels bitcasts and getelementptrs off a pointer. The root is always found; the offset is exact only when every index
# is constant.
def split_pointer(layout : DataLayout, value : Value) : CseAddress
  offset = 0_i64
  exact = true
  current = value
  moving = true
  while moving
    moving = false
    if current.is_a?(Inst)
      inst = current.as(Inst)
      if inst.op == Op::BitCast && inst.args.size == 1 && inst.args[0].type.pointer?
        current = inst.args[0]
        moving = true
      elsif gep_form?(inst)
        delta = gep_delta(layout, inst)
        if delta.nil?
          exact = false
        else
          offset = offset + delta.as(Int64)
        end
        current = inst.args[0]
        moving = true
      end
    end
  end
  CseAddress.new(current, offset, exact)
end

# An undef use may choose a new value each time. Do not key operations on it,
# or on compound constants that might contain one.
def stable_operand?(value : Value) : Bool
  return true unless value.is_a?(Inst)
  case value.as(Inst).op
  when Op::ConstUndef, Op::ConstPoison, Op::ConstExpr, Op::ConstAggregate, Op::ConstBytes
    false
  else
    true
  end
end

class Cse
  def initialize(@mod : Module, @fn : Function)
    @cfg = Cfg.new(@fn)
    @dom = DomTree.new(@cfg)
    @du = DefUse.new(@fn)
    @editor = Editor.new(@fn, @du)
    @numbers = Hash(Value, Int32).new
    @constant_numbers = Hash(String, Int32).new
    @type_numbers = Hash(IrType, Int32).new
    @next_number = 1
    @next_type_number = 1
    @marking_derived = Hash(Inst, Bool).new
    @flag_reach = Hash(Inst, Bool).new
    @escaped = false
    @boundaries = Hash(Inst, Int32).new
    @last_boundary = [] of Int32
    @entry_version = [] of Int32
    @exit_version = [] of Int32
    @available = Hash(String, Value).new
    @insertions = [] of String
    @changed = false
    find_marking_derivations
    number_memory_versions
  end

  # The flag, its address, and a constant whose operand graph reaches either.
  def marking_root?(value : Value) : Bool
    return flag_global?(value) if value.is_a?(Global)
    return false unless value.is_a?(Inst)
    return true if flag_address?(value)
    return false unless constant_node?(value) # mutation R2-root: only a constant that reaches the flag is a root
    reaches_flag?(value.as(Inst))
  end

  # Walks the constant operand graph below `root` with an explicit stack. Each node is memoized when it finishes, so a
  # constant shared by several uses is walked once per function.
  def reaches_flag?(root : Inst) : Bool
    return known_reach?(root) if @flag_reach.has_key?(root)
    frames = [ConstWalk.new(root)]
    while !frames.empty?
      frame = frames.last
      if frame.child >= frame.node.args.size
        @flag_reach[frame.node] = false
        frames.pop
      else
        arg = frame.node.args[frame.child]
        frame.child = frame.child + 1
        if flag_global?(arg) || flag_address?(arg) || known_reach?(arg)
          frames.each { |walk| @flag_reach[walk.node] = true }
          return true
        end
        if constant_node?(arg) && !@flag_reach.has_key?(arg.as(Inst))
          frames << ConstWalk.new(arg.as(Inst))
        end
      end
    end
    false
  end

  def known_reach?(value : Value) : Bool
    return false unless value.is_a?(Inst) && @flag_reach.has_key?(value.as(Inst))
    @flag_reach[value.as(Inst)]
  end

  # Records one use of a value that may carry the flag's address. A derivation spreads the mark; a leak marks the
  # function as escaping.
  def note_use(user : Inst, index : Int32, work : Array(Inst)) : Nil
    kind = flow_kind(user, index)
    if kind == 2
      @escaped = true
    elsif kind == 1 && !@marking_derived.has_key?(user)
      @marking_derived[user] = true
      work << user
    end
  end

  # Follows the derivations in `work` from position `head` through their users.
  def propagate(work : Array(Inst), head : Int32) : Nil
    cursor = head
    while cursor < work.size
      inst = work[cursor]
      cursor = cursor + 1
      @du.uses(inst).each do |usage|
        note_use(usage.user, usage.index, work)
      end
    end
  end

  # A derived address of the flag is just as opaque as the direct load. Its derivations follow their users. When the
  # address escapes the function's own values, every value that memory or a call can return is marked too, since the
  # address may come back through it.
  def find_marking_derivations : Nil
    work = [] of Inst
    @fn.blocks.each do |block|
      block.insts.each do |inst|
        inst.args.each_with_index do |arg, index|
          note_use(inst, index, work) if marking_root?(arg)
        end
      end
    end
    propagate(work, 0)
    return unless @escaped # mutation R2-escape: the fallback runs only when the address escapes
    mark = work.size
    @fn.blocks.each do |block|
      block.insts.each do |inst|
        next unless returned_source?(inst) && !@marking_derived.has_key?(inst)
        @marking_derived[inst] = true
        work << inst
      end
    end
    propagate(work, mark)
  end

  def marking_read?(inst : Inst) : Bool
    return false unless inst.op == Op::Load && inst.args.size == 1
    pointer = inst.args[0]
    return true if marking_root?(pointer)
    pointer.is_a?(Inst) && @marking_derived.has_key?(pointer.as(Inst))
  end

  # Opaque reads are conservative memory boundaries. Thread-local address
  # operations themselves do not access memory.
  def memory_boundary?(inst : Inst) : Bool
    writes_memory?(inst) || ((opaque?(inst) || marking_read?(inst)) && inst.op != Op::ThreadLocalAddr && inst.op != Op::ThreadPointer)
  end

  # Number the clobbers first. Entry, per-block join IDs, and clobber IDs
  # occupy disjoint ranges and stay stable across a dominator-tree walk.
  def number_memory_versions : Nil
    next_boundary = 1 + @cfg.size
    components = [] of Array(Int32)
    component = [] of Int32
    @fn.blocks.each do |block|
      last = -1
      block.insts.each do |inst|
        if memory_boundary?(inst)
          @boundaries[inst] = next_boundary
          last = next_boundary
          next_boundary = next_boundary + 1
        end
      end
      @last_boundary << last
      @entry_version << 0
      @exit_version << 0
      component << -1
    end

    # Cfg's RPO is decreasing DFS finish order. A reverse-graph DFS in that
    # order finds SCCs in topological order, without recursion or LoopInfo.
    @cfg.rpo.each do |start|
      next unless component[start] < 0
      id = components.size
      components << [] of Int32
      component[start] = id
      work = [start] of Int32
      while !work.empty?
        block = work.pop
        @cfg.preds(block).each do |pred|
          next unless @cfg.reachable?(pred) && component[pred] < 0
          component[pred] = id
          work << pred
        end
      end
    end
    # Bucket each SCC in RPO, so forward edges within a clobbered SCC have
    # already been numbered. No decision depends on hash iteration order.
    @cfg.rpo.each { |block| components[component[block]] << block }

    id = 0
    while id < components.size
      blocks = components[id]
      clobbered = false
      blocks.each { |block| clobbered = true if @last_boundary[block] >= 0 }
      if !clobbered
        # Every internal path is clobber-free. Merge only external entries;
        # their SCCs have already been processed in topological order.
        version = 0
        have_pred = false
        fresh = false
        blocks.each do |block|
          @cfg.preds(block).each do |pred|
            next unless @cfg.reachable?(pred) && component[pred] != id
            if !have_pred
              version = @exit_version[pred]
              have_pred = true
            elsif version != @exit_version[pred]
              fresh = true
            end
          end
        end
        fresh = true if !have_pred && blocks[0] != 0
        version = 1 + blocks[0] if fresh
        blocks.each do |block|
          @entry_version[block] = version
          @exit_version[block] = version
        end
      else
        # A clobbered SCC remains conservative at every retreating edge.
        blocks.each do |block|
          version = 0
          if block != 0
            have_pred = false
            fresh = false
            @cfg.preds(block).each do |pred|
              next unless @cfg.reachable?(pred)
              if component[pred] == id && @cfg.rpo_number(pred) >= @cfg.rpo_number(block)
                fresh = true
              elsif !have_pred
                version = @exit_version[pred]
                have_pred = true
              elsif version != @exit_version[pred]
                fresh = true
              end
            end
            version = 1 + block if fresh || !have_pred
          end
          @entry_version[block] = version
          @exit_version[block] = @last_boundary[block] < 0 ? version : @last_boundary[block]
        end
      end
      id = id + 1
    end
  end

  def type_number(type : IrType) : Int32
    if id = @type_numbers[type]?
      return id
    end
    id = @next_type_number
    @next_type_number = @next_type_number + 1
    @type_numbers[type] = id
    id
  end

  def fresh_number : Int32
    id = @next_number
    @next_number = @next_number + 1
    id
  end

  # Scalar constants are not interned by the IR builder. Canonicalize their
  # contents, including all words of wide integers, before numbering them.
  def constant_key(inst : Inst) : String?
    case inst.op
    when Op::ConstInt
      String.build do |io|
        io << "I|" << type_number(inst.type) << '|'
        if inst.type.bits <= 64
          io << canonical(inst.type.bits, inst.aux_int)
        else
          canonical_words(inst.int_words(inst.type.bits), inst.type.bits).each { |word| io << word << ',' }
        end
      end
    when Op::ConstFloat
      "F|#{type_number(inst.type)}|#{inst.aux_int}"
    when Op::ConstNull
      "N|#{type_number(inst.type)}"
    when Op::ConstZero
      if inst.type.int?
        String.build do |io|
          io << "I|" << type_number(inst.type) << '|'
          if inst.type.bits <= 64
            io << '0'
          else
            words = (inst.type.bits + 63) // 64
            k = 0
            while k < words
              io << "0,"
              k = k + 1
            end
          end
        end
      elsif inst.type.float?
        "F|#{type_number(inst.type)}|0"
      elsif inst.type.pointer?
        "N|#{type_number(inst.type)}"
      else
        "Z|#{type_number(inst.type)}"
      end
    else
      nil
    end
  end

  def number(value : Value) : Int32
    if id = @numbers[value]?
      return id
    end
    if value.is_a?(Inst)
      inst = value.as(Inst)
      if (inst.op == Op::GlobalAddr || inst.op == Op::FunctionAddr) && inst.args.size == 1 && inst.type == inst.args[0].type
        id = number(inst.args[0])
        @numbers[value] = id
        return id
      end
      if key = constant_key(inst)
        id = @constant_numbers[key]?
        unless id
          id = fresh_number
          @constant_numbers[key] = id
        end
        @numbers[value] = id
        return id
      end
    end
    id = fresh_number
    @numbers[value] = id
    id
  end

  # Unknown auxiliary forms are deliberately not keyed. Flags and predicates
  # live in aux_int; GEP and intrinsic metadata have additional fields.
  def expression_key(inst : Inst) : String?
    return nil if inst.type.void? || terminator_op?(inst.op)
    inst.args.each { |arg| return nil unless stable_operand?(arg) }
    aux = inst.aux
    if aux.is_a?(IntrinsicAux)
      aux.as(IntrinsicAux).param_attrs.each { |attrs| return nil unless attrs.empty? }
    elsif !aux.nil? && !aux.is_a?(GepAux)
      return nil
    end
    String.build do |io|
      io << "P|" << inst.op.value << '|' << type_number(inst.type) << '|' << inst.aux_int << '|'
      if aux.is_a?(GepAux)
        gep = aux.as(GepAux)
        io << "G|" << type_number(gep.source_type) << '|' << (gep.inbounds ? 1 : 0) << '|'
      elsif aux.is_a?(IntrinsicAux)
        intrinsic = aux.as(IntrinsicAux)
        io << "I|" << intrinsic.id.value << '|'
        intrinsic.overload.each { |type| io << type_number(type) << ',' }
        io << '|'
      else
        io << "N|"
      end
      inst.args.each { |arg| io << number(arg) << ',' }
    end
  end

  def load_key(type : IrType, ptr : Value, version : Int32) : String
    "L|#{type_number(type)}|#{number(ptr)}|#{version}"
  end

  def remember(key : String, value : Value) : Nil
    return if @available.has_key?(key)
    @available[key] = value
    @insertions << key
  end

  def replace(inst : Inst, value : Value) : Nil
    @numbers[inst] = number(value)
    @editor.replace_all_uses(inst, value)
    @editor.erase(inst)
    @changed = true
  end

  # Codegen zeroes an atomic object before its fields are stored (collector fact G5). A zeroing memset is dead when the
  # stores after it in its block overwrite all of its bytes before anything reads them.
  def erase_dead_zeroing : Nil
    block = 0
    while block < @cfg.size
      insts = @cfg.block(block).insts
      index = 0
      while index < insts.size
        length = zeroing_length(insts[index])
        if length
          target = split_pointer(@mod.layout, insts[index].args[0])
          if target.exact && zeroed_then_overwritten?(insts, index, target, length.as(Int64))
            @editor.erase(insts[index])
            @changed = true
          end
        end
        index = index + 1
      end
      block = block + 1
    end
  end

  # The byte count of a memset that zeroes its destination: a constant or sizeof length, zero fill, not volatile.
  def zeroing_length(inst : Inst) : Int64?
    return nil unless inst.op == Op::Intrinsic && inst.aux.is_a?(IntrinsicAux) && inst.args.size == 4
    return nil unless inst.aux.as(IntrinsicAux).id == IntrinsicId::Memset
    return nil unless int_value(inst.args[1]) == 0_i64 && int_value(inst.args[3]) == 0_i64
    length = sizeof_value(@mod, inst.args[2])
    return nil if length.nil?
    count = length.as(Int64)
    return nil if count <= 0_i64 || count > ZEROING_LIMIT
    count
  end

  # Whether `inst` may sit between a zeroing memset and the stores that overwrite it. A store may write anywhere but
  # must not carry the pointer. Any other instruction must not read or write memory or have effects, and may use the
  # pointer only as an address.
  def window_ok?(inst : Inst, base : Value) : Bool
    if inst.op == Op::Store
      return !opaque?(inst) && split_pointer(@mod.layout, inst.args[0]).base != base
    end
    return false if opaque?(inst) || writes_memory?(inst) || has_side_effects?(inst)
    return false if reads_memory?(inst) # mutation R2-read: a read of the zeroed object ends the window
    return true if inst.op == Op::BitCast || gep_form?(inst)
    index = 0
    while index < inst.args.size
      if split_pointer(@mod.layout, inst.args[index]).base == base && flow_kind(inst, index) != 0
        return false
      end
      index = index + 1
    end
    true
  end

  # True when the stores after `start` in its block overwrite each of the `length` bytes at `target` with plain scalars,
  # and no instruction before the last of them reads memory or uses the pointer other than as an address.
  def zeroed_then_overwritten?(insts : Array(Inst), start : Int32, target : CseAddress, length : Int64) : Bool
    covered = [] of Bool
    count = length.to_i32
    k = 0
    while k < count
      covered << false
      k = k + 1
    end
    remaining = count
    index = start + 1
    while index < insts.size
      inst = insts[index]
      if inst.op == Op::Store
        return false unless window_ok?(inst, target.base)
        address = split_pointer(@mod.layout, inst.args[1])
        if address.exact && address.base == target.base && plain_scalar?(inst.args[0].type)
          first = address.offset - target.offset
          last = first + @mod.layout.store_size(inst.args[0].type)
          first = 0_i64 if first < 0_i64
          last = length if last > length
          position = first
          while position < last
            if !covered[position.to_i32]
              covered[position.to_i32] = true
              remaining = remaining - 1
            end
            position = position + 1_i64
          end
          return true if remaining == 0
        end
      elsif !window_ok?(inst, target.base)
        return false
      end
      index = index + 1
    end
    false
  end

  def visit_block(block : Int32) : Nil
    version = @entry_version[block]
    @cfg.block(block).insts.each do |inst|
      if opaque?(inst) || marking_read?(inst) # mutation CSE-opaque: preserve opaque operations
        version = @boundaries[inst] if @boundaries.has_key?(inst)
      elsif inst.op == Op::Store
        version = @boundaries[inst] # mutation CSE-store: invalidate loads at each store
        if inst.args.size == 2 && stable_operand?(inst.args[0]) && stable_operand?(inst.args[1])
          value = inst.args[0]
          unless value.is_a?(Inst) && (opaque?(value.as(Inst)) || marking_read?(value.as(Inst)))
            remember(load_key(value.type, inst.args[1], version), value)
          end
        end
      elsif inst.op == Op::Load
        if inst.args.size == 1 && stable_operand?(inst.args[0])
          key = load_key(inst.type, inst.args[0], version)
          if value = @available[key]?
            replace(inst, value)
          else
            number(inst)
            remember(key, inst)
          end
        end
      elsif memory_boundary?(inst)
        version = @boundaries[inst]
      elsif pure?(inst)
        if key = expression_key(inst)
          if value = @available[key]?
            replace(inst, value)
          else
            number(inst)
            remember(key, inst)
          end
        end
      end
    end
  end

  def run : Bool
    erase_dead_zeroing
    frames = [CseFrame.new(0, 0)]
    while !frames.empty?
      frame = frames.last
      unless frame.entered
        frame.entered = true
        visit_block(frame.block)
      end
      children = @dom.children(frame.block)
      if frame.child < children.size
        child = children[frame.child]
        frame.child = frame.child + 1
        frames << CseFrame.new(child, @insertions.size)
      else
        while @insertions.size > frame.mark
          @available.delete(@insertions.pop)
        end
        frames.pop
      end
    end
    @editor.flush if @changed
    @changed
  end
end

pub def run_cse(mod : Module, fn : Function) : Bool
  return false if fn.declaration?
  Cse.new(mod, fn).run
end
