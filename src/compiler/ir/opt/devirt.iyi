module compiler/ir/opt/devirt

import compiler/ir/values::{Value}
import compiler/ir/inst::{Op, Inst, GepAux, AsmAux, IntPredicate}
import compiler/ir/function::{Function, Global, Linkage}
import compiler/ir/module::{Module}
import compiler/ir/builder::{Builder}
import compiler/ir/opt/analysis::{DefUse}
import compiler/ir/opt/edit::{new_inst}
import compiler/ir/opt/effects::{opaque?, writes_memory?, runtime_entry?}
import compiler/ir/opt/escape::{partitioned_heap?}
import compiler/ir/opt/fold::{int_value, canonical}

# A byte GEP is the only accepted representation of the high half of the
# allocator's header. In particular, never manufacture a ptrtoint expression.
def header_base(v : Value) : Value?
  return nil unless v.is_a?(Inst)
  gep = v.as(Inst)
  return nil unless gep.op == Op::Gep && gep.args.size == 2 && gep.aux.is_a?(GepAux)
  source = gep.aux.as(GepAux).source_type
  return nil unless source.int? && source.bits == 8
  return nil unless int_value(gep.args[1]) == -4_i64 # mutation S9-header-half: read the high half at P-4
  gep.args[0]
end

def private_function?(fn : Function) : Bool
  fn.linkage == Linkage::Internal || fn.linkage == Linkage::Private
end


# This type-id source set also includes IyiHeap.new_object; effects.iyi's runtime_entry? instead lists opaque calls.
def new_object?(name : String) : Bool
  name.includes?("IyiHeap::new_object") || name.includes?("IyiHeap.new_object")
end

def allocator?(name : String) : Bool
  name == "__iyi_new" || new_object?(name)
end

def raw_allocator?(name : String) : Bool
  name == "__iyi_malloc64" || name == "__iyi_malloc_atomic64" || name == "__iyi_realloc64" ||
    name == "__crystal_malloc64" || name == "__crystal_malloc_atomic64" || name == "__crystal_realloc64"
end

def partition_entry?(name : String) : Bool
  name == "__iyi_new_shared" || name == "__iyi_publish"
end

def named_entry?(name : String) : Bool
  allocator?(name) || raw_allocator?(name) || partition_entry?(name)
end

def byte_zero_gep?(inst : Inst) : Bool
  return false unless inst.op == Op::Gep && inst.args.size == 2 && inst.aux.is_a?(GepAux)
  source = inst.aux.as(GepAux).source_type
  source.int? && source.bits == 8 && int_value(inst.args[1]) == 0_i64
end

# One instance is constructed after the preceding module passes. It remains
# valid while devirt runs over the functions, since this pass adds no source
# of object pointers or type ids. Rebuild it if another pass changes the module.
pub class DevirtInfo
  getter refusal_reason : String?
  getter local_folds : Int32
  getter global_folds : Int32

  # The scheduler supplies the shared partition-use scan result.
  def initialize(@mod : Module, partitioned : Bool)
    @partitioned = partitioned
    @refusal_reason = nil.as(String?)
    @local_folds = 0
    @global_folds = 0
    @classes = Hash(Int64, Bool).new
    @possible = Hash(Int64, Bool).new
    @class_sorted = [] of Int64
    @possible_sorted = [] of Int64
    @safe_object = Hash(Value, Bool).new
    @needs = Hash(Value, Int32).new
    @has_source = Hash(Value, Bool).new
    @blocked = Hash(Value, Bool).new
    @waiters = Hash(Value, Array(Value)).new
    @seeds = [] of Value
    @address_taken = Hash(Function, Bool).new
    @seen_constants = Hash(Value, Bool).new
    @named_used = Hash(Function, Bool).new
    @named_edges = Hash(Function, Array(Function)).new
    @return_nodes = Hash(Function, Value).new
    @can_local = false
    @needs_dynamic_local = false
    if allocator = @mod.function?("__iyi_new")
      @can_local = runtime_entry?(allocator)
    end
    inspect_environment
    refuse("partition allocation or publication is used") if partitioned
    return if @partitioned
    return if @refusal_reason && !@can_local
    inspect_globals
    return if @refusal_reason && !@can_local
    collect_named_uses
    inspect_functions
    return if @partitioned
    unless @refusal_reason
      @class_sorted = @classes.keys.sorted
      @possible_sorted = @possible.keys.sorted
    end
    build_origins unless @refusal_reason && !@needs_dynamic_local
  end

  private def refuse(reason : String) : Nil
    @refusal_reason = reason unless @refusal_reason
  end


  private def inspect_environment : Nil
    @mod.flags.each do |name, value|
      if value != 0_i64 && (name.includes?("unit") || name.includes?("iyimod") || name.includes?("external"))
        refuse("external unit or iyimod marker")
      end
    end
    @mod.functions.each do |fn|
      refuse("external function declaration") if fn.declaration? # mutation S9-external: unknown declarations invalidate the set
      refuse("allocation entry can be called by an external unit") if allocator?(fn.name) && !fn.declaration? && !private_function?(fn)
    end
    @mod.globals.each do |global|
      refuse("external global declaration") unless global.initializer
    end
  end

  # `:headed` is emitted only for numbered non-generic and instantiated
  # generic classes; a paired `:type_id` therefore proves a heap-class id.
  # All other numbered ids, including structs, primitives and nil, remain
  # possible even if no __iyi_new call names them.
  private def inspect_globals : Nil
    @mod.globals.each do |global|
      next unless global.name.ends_with?(":headed") && global.constant && global.value_type.int? && global.value_type.bits == 8
      init = global.initializer
      next unless init && !int_value(init).nil?
      prefix = global.name[0, global.name.bytesize - 7]
      id_global = @mod.global?(prefix + ":type_id")
      next unless id_global && id_global.constant && id_global.value_type.int? && id_global.value_type.bits == 32
      if id_init = id_global.initializer
        if id = int_value(id_init)
          @classes[canonical(32, id)] = true
        end
      end
    end
    @mod.globals.each do |global|
      unless global.linkage == Linkage::Internal || global.linkage == Linkage::Private
        refuse("externally visible global")
      end
      init = global.initializer
      if init
        # Aggregate or pointer initializers can contain pre-headed static
        # objects such as String literals. Until enumerated, no set is complete.
        unless global.value_type.int? && !int_value(init).nil?
          refuse("unclassified static object or global initializer")
        end
        note_address(init)
      end
      next unless global.name.ends_with?(":type_id") && global.constant && global.value_type.int? && global.value_type.bits == 32
      next unless init
      id = int_value(init)
      next unless id
      prefix = global.name[0, global.name.bytesize - 8]
      headed = @mod.global?(prefix + ":headed")
      unless headed && headed.constant && headed.value_type.int? && headed.value_type.bits == 8 && headed.initializer && !int_value(headed.initializer.as(Value)).nil?
        @possible[canonical(32, id)] = true
      end
    end
  end

  # Visit constants only: a local instruction is not an address expression and
  # walking through it would count every ordinary call as address-taking.
  private def note_address(value : Value) : Nil
    unless value.is_a?(Function)
      return unless value.is_a?(Inst)
      op = value.as(Inst).op
      return unless op == Op::FunctionAddr || op == Op::GlobalAddr || op == Op::ConstExpr || op == Op::ConstAggregate || op == Op::ConstBytes
      return if @seen_constants[value]?
    end
    work = [value] of Value
    while !work.empty?
      current = work.pop
      if current.is_a?(Function)
        fn = current.as(Function)
        @address_taken[fn] = true
        refuse("allocator address is taken") if allocator?(fn.name) || raw_allocator?(fn.name)
      elsif current.is_a?(Inst)
        inst = current.as(Inst)
        case inst.op
        when Op::FunctionAddr, Op::GlobalAddr, Op::ConstExpr, Op::ConstAggregate, Op::ConstBytes
          unless @seen_constants[current]?
            @seen_constants[current] = true
            inst.args.each { |arg| work << arg }
          end
        end
      end
    end
  end

  # Only a reference from ordinary code, or from another used entry, makes a
  # private runtime entry live. A dormant definition is not an allocation.
  private def collect_named_uses : Nil
    work = [] of Function
    @mod.functions.each do |fn|
      work << fn if named_entry?(fn.name) && @address_taken[fn]?
      fn.blocks.each do |block|
        block.insts.each do |inst|
          next unless (inst.op == Op::Call || inst.op == Op::Invoke) && !inst.args.empty? && inst.args[0].is_a?(Function)
          target = inst.args[0].as(Function)
          next unless named_entry?(target.name)
          if named_entry?(fn.name)
            list = @named_edges[fn]?
            unless list
              list = [] of Function
              @named_edges[fn] = list
            end
            list << target
          else
            work << target
          end
        end
      end
    end
    cursor = 0
    while cursor < work.size
      fn = work[cursor]
      cursor = cursor + 1
      next if @named_used[fn]?
      @named_used[fn] = true
      if targets = @named_edges[fn]?
        targets.each { |target| work << target }
      end
    end
  end

  private def record_allocation(inst : Inst, target : Function, owner : Function) : Nil
    expected = target.name == "__iyi_new" ? 4 : 5
    unless inst.args.size == expected && inst.args[2].type.int? && inst.args[2].type.bits == 64
      refuse("malformed allocation entry")
      return
    end
    unless private_function?(target)
      refuse("allocation entry can be called by an external unit")
    end
    # An allocator forwarding its own type-id parameter is not another
    # allocation source. A different argument must still be accounted for.
    if allocator?(owner.name) && owner.params.size >= 2 && inst.args[2] == owner.params[1]
      return
    end
    id = int_value(inst.args[2])
    unless id
      refuse("allocation entry has a nonconstant type id") # mutation S9-unknown-id: do not infer an incomplete set
      return
    end
    @possible[canonical(32, id)] = true
  end

  private def inspect_functions : Nil
    @mod.functions.each do |fn|
      next if named_entry?(fn.name) && !@named_used[fn]?
      note_address(fn.personality.as(Value)) if fn.personality
      fn.blocks.each do |block|
        block.insts.each do |inst|
          if inst.op == Op::Call || inst.op == Op::Invoke
            if inst.args.empty? || !inst.args[0].is_a?(Function) || inst.op == Op::Invoke
              refuse("indirect call or invoke")
            else
              target = inst.args[0].as(Function)
              if target.name == "__iyi_new" && inst.args.size == 4 && headed_site?(inst, target) && int_value(inst.args[2]).nil?
                @needs_dynamic_local = true
              end
              if allocator?(target.name)
                record_allocation(inst, target, fn)
              elsif raw_allocator?(target.name) && !allocator?(fn.name) && !raw_allocator?(fn.name)
                refuse("raw allocator outside a named allocation entry")
              end
            end
          end
          if inst.aux.is_a?(AsmAux)
            refuse("inline assembly may allocate or write an object header")
          end
          if writes_memory?(inst) && inst.op != Op::Call && inst.op != Op::Invoke && !allocator?(fn.name) && !raw_allocator?(fn.name) # mutation S9-header-write
            # An arbitrary address could alias P-4. This intentionally also
            # rejects ordinary stores until alias analysis proves them disjoint.
            refuse("possible object-header write outside an allocator")
          end
          k = 0
          while k < inst.args.size
            unless k == 0 && (inst.op == Op::Call || inst.op == Op::Invoke) && inst.args[k].is_a?(Function)
              note_address(inst.args[k])
            end
            k = k + 1
          end
        end
      end
    end
  end

  # Object provenance and pointer-free integer provenance share a graph, but
  # a pointer-to-int, unknown load or externally supplied integer is never a
  # seed. This prevents the local truncation from hiding a collector root.
  # A node becomes safe only when every incoming edge is safe; unresolved
  # cycles and address-taken or externally callable parameters stay unsafe.
  private def candidate(v : Value) : Nil
    @needs[v] = 0 unless @needs.has_key?(v)
  end

  private def dependency(v : Value, source : Value) : Nil
    seed(source) if source.type.int? && !int_value(source).nil?
    candidate(v)
    @has_source[v] = true
    @needs[v] = @needs[v] + 1
    list = @waiters[source]?
    unless list
      list = [] of Value
      @waiters[source] = list
    end
    list << v
  end

  private def seed(v : Value) : Nil
    unless @safe_object[v]?
      @safe_object[v] = true
      @seeds << v
    end
  end

  private def headed_site?(inst : Inst, target : Function) : Bool
    if target.name == "__iyi_new"
      return false unless inst.args.size == 4
      flags = int_value(inst.args[3])
      return false unless flags
      return (flags & 1_i64) == 1_i64 # mutation S9-headed: require a headed allocation
    end
    if new_object?(target.name)
      return false unless inst.args.size == 5
      headed = int_value(inst.args[3])
      return headed == 1_i64
    end
    false
  end

  private def build_origins : Nil
    # A function's address is not its return value. Give each summary its
    # own graph node so code pointers can never become trusted objects.
    @mod.functions.each do |fn|
      type = fn.fn_type.return_type
      if type.pointer? || type.int?
        node = Value.new(type)
        @return_nodes[fn] = node
        candidate(node)
        @blocked[node] = true unless private_function?(fn) && !@address_taken[fn]?
      end
    end
    @mod.functions.each do |fn|
      fn.params.each do |param|
        next unless param.type.pointer? || param.type.int?
        candidate(param)
        @blocked[param] = true unless private_function?(fn) && !@address_taken[fn]?
      end
      result = @return_nodes[fn]?
      fn.blocks.each do |block|
        block.insts.each do |inst|
          if inst.op == Op::Ret && inst.args.size == 1 && result
            dependency(result, inst.args[0])
          end
          if inst.op == Op::Call && !inst.args.empty? && inst.args[0].is_a?(Function)
            target = inst.args[0].as(Function)
            k = 1
            while k < inst.args.size && k <= target.params.size
              param = target.params[k - 1]
              dependency(param, inst.args[k]) if param.type.pointer? || param.type.int?
              k = k + 1
            end
            if inst.type.pointer?
              if allocator?(target.name) && headed_site?(inst, target)
                seed(inst)
              elsif !allocator?(target.name) && !raw_allocator?(target.name)
                result_node = @return_nodes[target]?
                dependency(inst, result_node) if result_node
              end
            elsif inst.type.int?
              result_node = @return_nodes[target]?
              dependency(inst, result_node) if result_node && !allocator?(target.name) && !raw_allocator?(target.name)
            end
          elsif inst.type.pointer?
            if inst.op == Op::BitCast && inst.args.size == 1 && inst.args[0].type.pointer?
              dependency(inst, inst.args[0])
            elsif byte_zero_gep?(inst)
              dependency(inst, inst.args[0])
            elsif inst.op == Op::Phi
              inst.args.each { |arg| dependency(inst, arg) }
            elsif inst.op == Op::Select && inst.args.size == 3
              dependency(inst, inst.args[1])
              dependency(inst, inst.args[2])
            end
          elsif inst.type.int?
            if inst.op == Op::Load && inst.args.size == 1 && inst.args[0].is_a?(Global)
              global = inst.args[0].as(Global)
              if !opaque?(inst) && global.constant && global.initializer && !int_value(global.initializer.as(Value)).nil?
                seed(inst)
              end
            else
              case inst.op
              when Op::Add, Op::Sub, Op::Mul, Op::SDiv, Op::UDiv, Op::SRem, Op::URem,
                   Op::Shl, Op::LShr, Op::AShr, Op::And, Op::Or, Op::Xor, Op::ICmp,
                   Op::Trunc, Op::ZExt, Op::SExt, Op::Phi, Op::Select, Op::Freeze
                inst.args.each { |arg| dependency(inst, arg) }
              end
            end
          end
        end
      end
    end
    cursor = 0
    while cursor < @seeds.size
      source = @seeds[cursor]
      cursor = cursor + 1
      list = @waiters[source]?
      next unless list
      list.each do |v|
        @needs[v] = @needs[v] - 1
        if @needs[v] == 0 && @has_source[v]? && !@blocked[v]?
          seed(v)
        end
      end
    end
  end

  private def safe_type_id?(v : Value) : Bool
    return false unless v.is_a?(Inst)
    load = v.as(Inst)
    return false unless load.op == Op::Load && load.type.int? && load.type.bits == 32 && load.args.size == 1
    return false if opaque?(load)
    base = header_base(load.args[0])
    return false unless base
    @safe_object[base]? == true
  end

  private def lower_bound(values : Array(Int64), key : Int64) : Int32
    left = 0
    right = values.size
    while left < right
      mid = left + (right - left) // 2
      if values[mid] < key
        left = mid + 1
      else
        right = mid
      end
    end
    left
  end

  # Every integer in the range must be a known heap class, not merely absent
  # from the observed ids. Unknown, primitive, struct and nil ids stay live.
  private def absent_class_range?(lo : Int64, hi : Int64) : Bool
    first = lower_bound(@class_sorted, lo)
    after = lower_bound(@class_sorted, hi + 1_i64)
    return false unless (after - first).to_i64 == hi - lo + 1_i64 # mutation S9-range-domain: require known heap classes
    possible = lower_bound(@possible_sorted, lo)
    !(possible < @possible_sorted.size && @possible_sorted[possible] <= hi)
  end

  private def absent_compare?(inst : Inst) : Bool
    return false unless inst.op == Op::ICmp && inst.aux_int == IntPredicate::EQ.value.to_i64 && inst.args.size == 2
    a = inst.args[0]
    b = inst.args[1]
    id = int_value(a)
    value = b
    unless id
      id = int_value(b)
      value = a
    end
    return false unless id && value.type.int? && value.type.bits == 32 && safe_type_id?(value)
    id = canonical(32, id)
    return false unless @classes[id]? && !@possible[id]? # mutation S9-absent-id: require an absent heap-class id
    true
  end

  # Match only the exact side-effect-free range helper emitted by lowering.
  # Non-class ids remain in @possible, so their ranges are never discarded.
  private def absent_range_call?(inst : Inst) : Bool
    return false unless inst.op == Op::Call && inst.args.size == 2 && inst.args[0].is_a?(Function)
    fn = inst.args[0].as(Function)
    return false unless fn.name.starts_with?("~match<") && private_function?(fn) && fn.params.size == 1
    return false unless fn.params[0].type.int? && fn.params[0].type.bits == 32
    return false unless fn.blocks.size == 1 && fn.blocks[0].insts.size == 4
    return false unless safe_type_id?(inst.args[1])
    body = fn.blocks[0].insts
    lo_cmp = body[0]
    hi_cmp = body[1]
    both = body[2]
    ret = body[3]
    return false unless lo_cmp.op == Op::ICmp && lo_cmp.aux_int == IntPredicate::SGE.value.to_i64 && lo_cmp.args.size == 2
    return false unless hi_cmp.op == Op::ICmp && hi_cmp.aux_int == IntPredicate::SLE.value.to_i64 && hi_cmp.args.size == 2
    return false unless lo_cmp.args[0] == fn.params[0] && hi_cmp.args[0] == fn.params[0]
    return false unless both.op == Op::And && both.args.size == 2 && both.args[0] == lo_cmp && both.args[1] == hi_cmp
    return false unless ret.op == Op::Ret && ret.args.size == 1 && ret.args[0] == both
    lo = int_value(lo_cmp.args[1])
    hi = int_value(hi_cmp.args[1])
    return false unless lo && hi && lo <= hi
    absent_class_range?(lo, hi)
  end

  private def replace_uses(du : DefUse, old : Value, replacement : Value) : Nil
    du.uses(old).each do |use|
      du.remove(use.user, use.index)
      use.user.args[use.index] = replacement
      du.add(use.user, use.index)
    end
  end

  private def remove_operands(du : DefUse, inst : Inst) : Nil
    k = 0
    while k < inst.args.size
      du.remove(inst, k)
      k = k + 1
    end
  end

  def run(fn : Function) : Bool
    return false if @partitioned || fn.declaration? || (@refusal_reason && !@can_local)
    builder = Builder.new(@mod)
    du = DefUse.new(fn)
    changed = false
    fn.blocks.each do |block|
      # Each block has its own memory epoch. A store, call or other possible
      # write between allocation and load invalidates the local proof.
      epoch = 0
      allocation_epoch = Hash(Value, Int32).new
      allocation_tid = Hash(Value, Value).new
      aliases = Hash(Value, Value).new
      output = [] of Inst
      block_changed = false
      block.insts.each do |inst|
        removed = false
        epoch = epoch + 1 if writes_memory?(inst)
        if inst.op == Op::Call && inst.args.size == 4 && inst.args[0].is_a?(Function)
          target = inst.args[0].as(Function)
          if target.name == "__iyi_new" && runtime_entry?(target) && inst.type.pointer? && headed_site?(inst, target) && inst.args[2].type.int? && inst.args[2].type.bits == 64 && (!int_value(inst.args[2]).nil? || @safe_object[inst.args[2]]?) # mutation S9-pointer-tid
            allocation_epoch[inst] = epoch
            allocation_tid[inst] = inst.args[2]
            aliases[inst] = inst
          end
        elsif inst.type.pointer? && (inst.op == Op::BitCast || byte_zero_gep?(inst)) && !inst.args.empty?
          root = aliases[inst.args[0]]?
          aliases[inst] = root if root
        end
        if inst.op == Op::Load && inst.type.int? && inst.type.bits == 32 && inst.args.size == 1 && !opaque?(inst)
          base = header_base(inst.args[0])
          root = base ? aliases[base]? : nil
          if root && allocation_epoch[root]? == epoch # mutation S9-known-site: require an unclobbered headed allocation
            tid = allocation_tid[root]
            number = int_value(tid)
            if number
              replacement = builder.const_int(inst.type, canonical(32, number))
              replace_uses(du, inst, replacement)
            else
              replacement = new_inst(Op::Trunc, inst.type, [tid] of Value)
              du.add(replacement, 0)
              output << replacement
              replace_uses(du, inst, replacement)
            end
            remove_operands(du, inst)
            removed = true
            block_changed = true
            @local_folds = @local_folds + 1
            changed = true
          end
        end
        if !removed && !@refusal_reason && (inst.op != Op::Call || du.use_count(inst) > 0) && (absent_compare?(inst) || absent_range_call?(inst))
          replace_uses(du, inst, builder.const_int(inst.type, 0_i64))
          # Calls are I8-opaque: keep the call even when its result is known.
          if inst.op != Op::Call
            remove_operands(du, inst)
            removed = true
            block_changed = true
          end
          @global_folds = @global_folds + 1
          changed = true
        end
        output << inst unless removed
      end
      block.insts[0, block.insts.size] = output if block_changed
    end
    changed
  end
end

pub def run_devirt(mod : Module, fn : Function) : Bool
  DevirtInfo.new(mod, partitioned_heap?(mod)).run(fn)
end
