module compiler/ir/opt/inline

import compiler/ir/values::{Value, u64_as_i64}
import compiler/ir/types::{IrType}
import compiler/ir/inst::{Op, Inst, Block, Attribute, CallAux, AsmAux, IntrinsicAux}
import compiler/ir/function::{Function, Linkage}
import compiler/ir/module::{Module}
import compiler/ir/intrinsics::{IntrinsicId}
import compiler/ir/opt/analysis::{Cfg, DomTree, LoopInfo}
import compiler/ir/opt/callgraph::{CallGraph, cold_blocks}
import compiler/ir/opt/effects::{runtime_entry?, returns_twice_call?}
import compiler/ir/opt/edit::{new_inst, new_phi}
import compiler/ir/opt/fold::{int_value, canonical, unsigned_value, fold_int_binary, fold_int_compare, fold_int_cast}
import compiler/ir/opt/escape::{sizeof_value}

pub class InlineBudget
  getter limit : Int32
  property used : Int32
  # The round of run_inline in progress. A recursive callee is copied only in round 0.
  property round : Int32
  # The late group (R9) considers only the allocation entries, when entries_ok, and the calls those entries
  # expose. Its calls are costed with their constant arguments folded in, and its gate is wider.
  getter late : Bool
  getter entries_ok : Bool

  def initialize(mod : Module, late : Bool = false, entries_ok : Bool = false)
    total = 0
    mod.functions.each do |fn|
      fn.blocks.each { |block| total = total + block.insts.size }
    end
    @mod = mod
    @used = total
    @limit = total + total // 2
    @round = 0
    @late = late
    @entries_ok = entries_ok
    @eligible = Hash(Function, Int32).new
    @costs = Hash(Function, Int32).new
    @folded = Hash(Function, Hash(String, Int32)).new
    @exposed = Hash(Inst, Bool).new
  end

  # Functions can still change while their own pipeline is running. The
  # driver invalidates both entries when that function's pipeline finishes.
  def callee_allowed(fn : Function) : Bool
    if cached = @eligible[fn]?
      return cached == 1
    end
    allowed = callee_allowed?(fn, @entries_ok)
    @eligible[fn] = allowed ? 1 : 0
    allowed
  end

  def callee_cost(fn : Function) : Int32
    if cached = @costs[fn]?
      return cached
    end
    cost = inline_cost(fn)
    @costs[fn] = cost
    cost
  end

  # The cost the gate weighs for one call. In the late group it is what the callee keeps once the call's
  # constant arguments are folded in; elsewhere it is the callee's whole cost.
  def call_cost(callee : Function, call : Inst) : Int32
    return callee_cost(callee) unless @late
    args = [] of Int64?
    k = 1
    while k < call.args.size
      args << constant_argument(@mod, call.args[k])
      k = k + 1
    end
    key = ""
    args.each do |value|
      key = key + (value ? "#{value}" : "?") + ","
    end
    table = @folded[callee]? || Hash(String, Int32).new
    @folded[callee] = table
    if cached = table[key]?
      return cached
    end
    cost = folded_cost(callee, args)
    table[key] = cost
    cost
  end

  # The gate for one call's cost. The late group is wider: a folded allocation body is kept only once its
  # constants have removed the paths they do not take.
  def gate : Int32
    @late ? 120 : 40
  end

  def rounds : Int32
    @late ? 3 : 2
  end

  def mark_exposed(inst : Inst) : Nil
    @exposed[inst] = true
    nil
  end

  def exposed?(inst : Inst) : Bool
    @exposed.has_key?(inst)
  end

  def invalidate(fn : Function) : Nil
    @eligible.delete(fn)
    @costs.delete(fn)
    @folded.delete(fn)
    nil
  end

  # Replaces a function's transient clone charge with its net size change over the
  # whole group, so `used` tracks the module's current size.
  def settle(start_used : Int32, start_size : Int32, fn : Function) : Nil
    @used = start_used + (instruction_count(fn) - start_size)
    nil
  end
end

def has_attr?(attrs : Array(Attribute), name : String) : Bool
  attrs.any? { |attr| attr.name == name }
end

# Source-mandated inlining: alwaysinline on the callee or on the call site.
def source_mandated?(callee : Function, call : Inst) : Bool
  return true if has_attr?(callee.attrs, "alwaysinline")
  call.aux.is_a?(CallAux) && has_attr?(call.aux.as(CallAux).fn_attrs, "alwaysinline")
end

def tls_value?(value : Value) : Bool
  return false unless value.is_a?(Inst)
  op = value.as(Inst).op
  op == Op::ThreadLocalAddr || op == Op::ThreadPointer
end

def restricted_params?(attrs : Array(Array(Attribute))) : Bool
  attrs.any? { |row| has_attr?(row, "byval") || has_attr?(row, "sret") }
end

def caller_allowed?(fn : Function) : Bool
  return false if has_attr?(fn.attrs, "naked") || has_attr?(fn.attrs, "noreturn")
  fn.blocks.each do |block|
    block.insts.each { |inst| return false if returns_twice_call?(inst) }
  end
  true
end

# The allocation entries: the only runtime entries the late group may inline, and only after escape has run
# (invariant I10c, spec 3.4).
def alloc_entry?(fn : Function) : Bool
  case fn.name
  when "__iyi_new", "__iyi_malloc64", "__iyi_malloc_atomic64" then true
  else                                                             false
  end
end

# Refuse shapes whose control flow or calling convention cannot be cloned here. A runtime entry is refused
# unless it is an allocation entry the late group may inline.
def callee_allowed?(fn : Function, entries_ok : Bool) : Bool
  return false if fn.declaration? || fn.fn_type.varargs?
  return false if runtime_entry?(fn) && !(entries_ok && alloc_entry?(fn))
  # Keep the program-lifetime frame and the runtime's stack-clearing wrappers
  # distinct even if a producer omits their noinline attributes.
  return false if top_level?(fn) || fn.name == "__iyi_program" || fn.name == "__iyi_enter" # mutation entry-frame: preserve entry identities
  return false if has_attr?(fn.attrs, "noinline") || has_attr?(fn.attrs, "naked")
  return false if has_attr?(fn.attrs, "returns_twice") || has_attr?(fn.attrs, "noreturn")
  return false if restricted_params?(fn.param_attrs) || fn.personality
  return false if !fn.blocks[0].insts.empty? && fn.blocks[0].insts[0].op == Op::Phi
  returns = 0
  bi = 0
  while bi < fn.blocks.size
    block = fn.blocks[bi]
    block.insts.each do |inst|
      return false if inst.op == Op::Alloca && (bi != 0 || !inst.args.empty?)
      return false if returns_twice_call?(inst)
      case inst.op
      when Op::Invoke, Op::LandingPad, Op::Resume, Op::CatchSwitch, Op::CatchPad, Op::CatchRet, Op::CleanupPad, Op::CleanupRet
        return false
      when Op::Ret
        returns = returns + 1
        return false if !inst.args.empty? && tls_value?(inst.args[0])
      when Op::Intrinsic
        return false unless inst.aux.is_a?(IntrinsicAux)
        case inst.aux.as(IntrinsicAux).id
        when IntrinsicId::Frameaddress, IntrinsicId::Returnaddress, IntrinsicId::Stacksave, IntrinsicId::Stackrestore, IntrinsicId::VaStart
          return false
        end
      end
      if inst.op == Op::Call && !inst.args.empty? && inst.args[0].is_a?(Inst)
        target = inst.args[0].as(Inst)
        return false if target.aux.is_a?(AsmAux) && target.aux.as(AsmAux).unwind
      end
    end
    bi = bi + 1
  end
  returns > 0
end

pub def instruction_count(fn : Function) : Int32
  count = 0
  fn.blocks.each { |block| count = count + block.insts.size }
  count
end

# Cold regions are components of blocks that can reach unreachable but not a
# return. Their instructions cost zero, and each connected region costs five.
def inline_cost(fn : Function) : Int32
  cfg = Cfg.new(fn)
  cold = cold_blocks(fn)
  visited = [] of Bool
  k = 0
  while k < cfg.size
    visited << false
    k = k + 1
  end
  cost = 0
  k = 0
  while k < cfg.size
    if cold[k]
      unless visited[k]
        cost = cost + 5
        visited[k] = true
        region = [k] of Int32
        while !region.empty?
          node = region.pop
          neighbors = cfg.succs(node) + cfg.preds(node)
          neighbors.each do |other|
            if cold[other] && !visited[other]
              visited[other] = true
              region << other
            end
          end
        end
      end
    else
      cfg.block(k).insts.each do |inst|
        if inst.op == Op::Call
          cost = cost + 10
        elsif inst.op == Op::Alloca || inst.op == Op::Phi
          # Free in the cost model.
        elsif inst.op == Op::Intrinsic && inst.aux.is_a?(IntrinsicAux) && inst.aux.as(IntrinsicAux).id == IntrinsicId::ExpectI1
          # A branch hint has no machine cost.
        elsif inst.op == Op::BitCast && inst.type.pointer? && !inst.args.empty? && inst.args[0].type.pointer?
          # A pointer-to-pointer cast has no machine cost.
        else
          cost = cost + 1
        end
      end
    end
    k = k + 1
  end
  cost
end

def top_level?(fn : Function) : Bool
  fn.name == "__iyi_main" || fn.name == "__crystal_main"
end

def in_loop?(fn : Function, block : Block) : Bool
  fn.relink
  cfg = Cfg.new(fn)
  dom = DomTree.new(cfg)
  loops = LoopInfo.new(cfg, dom)
  id = cfg.index(block)
  loops.depth(id) > 0
end

# A dispatch link has exactly one conditional successor continuing the chain,
# and one arm containing exactly one call. The original classifier counts
# only chains whose continuing edge eventually reaches unreachable.
def dispatch_next(block : Block) : Block?
  term = block.terminator
  return nil unless term.op == Op::CondBr && term.targets.size == 2
  a = term.targets[0]
  b = term.targets[1]
  a_chain = a.terminator.op == Op::CondBr || a.terminator.op == Op::Unreachable
  b_chain = b.terminator.op == Op::CondBr || b.terminator.op == Op::Unreachable
  return nil if a_chain == b_chain
  arm = a_chain ? b : a
  calls = 0
  arm.insts.each { |inst| calls = calls + 1 if inst.op == Op::Call }
  return nil unless calls == 1
  a_chain ? a : b
end

# Only the predicate (> 4 arms) is used by the cost model. Start at the
# target's immediate conditional predecessors instead of every block. Follow
# each chain to its unreachable end, then walk backwards only far enough to
# establish whether an earlier start would make that chain longer than four.
def dispatch_over_four?(target : Block) : Bool
  calls = 0
  target.insts.each { |inst| calls = calls + 1 if inst.op == Op::Call }
  return false unless calls == 1
  target.preds.each do |start|
    following = dispatch_next(start)
    next unless following && following != target
    current = start
    seen = Hash(Block, Bool).new
    suffix = 0
    terminal = false
    while !seen.has_key?(current)
      seen[current] = true
      if current.terminator.op == Op::Unreachable
        terminal = true
        break
      end
      next_block = dispatch_next(current)
      break unless next_block
      suffix = suffix + 1
      current = next_block
    end
    next unless terminal
    return true if suffix > 4 # mutation S6P1: a five-arm chain exceeds the limit
    pending = [start] of Block
    lengths = [suffix] of Int32
    seen = Hash(Block, Bool).new
    seen[start] = true
    at = 0
    while at < pending.size
      node = pending[at]
      length = lengths[at]
      at = at + 1
      node.preds.each do |pred|
        next if seen.has_key?(pred)
        next unless dispatch_next(pred) == node
        return true if length + 1 > 4 # mutation S6P3: earlier chain starts also count
        seen[pred] = true
        pending << pred
        lengths << length + 1
      end
    end
  end
  false
end

# A late-group call is a candidate when it calls an allocation entry, and the entries may be inlined, or when
# an earlier inline of an allocation entry in this group exposed it.
def alloc_candidate?(site : Inst, budget : InlineBudget) : Bool
  return false if site.args.empty? || !site.args[0].is_a?(Function)
  return true if budget.exposed?(site)
  budget.entries_ok && alloc_entry?(site.args[0].as(Function))
end

def call_allowed?(fn : Function, block : Block, call : Inst, callee : Function, graph : CallGraph, budget : InlineBudget) : Bool
  return false unless call.aux.is_a?(CallAux)
  aux = call.aux.as(CallAux)
  return false unless aux.fn_type == callee.fn_type && aux.cc == callee.cc
  return false if restricted_params?(aux.param_attrs) || has_attr?(aux.fn_attrs, "noinline")
  return false if has_attr?(aux.fn_attrs, "returns_twice") || has_attr?(aux.fn_attrs, "noreturn")
  return false unless call.args.size == callee.params.size + 1
  k = 1
  while k < call.args.size
    return false if tls_value?(call.args[k]) || call.args[k].type != callee.params[k - 1].type
    k = k + 1
  end
  return false unless budget.callee_allowed(callee)
  return false if callee == fn || graph.same_component?(fn, callee)
  # A recursive callee may be copied once into an outside caller, in round 0 only. The late group's calls
  # are its own allocation funnel, bounded by its rounds instead.
  return false if budget.round > 0 && !budget.late && graph.recursive?(callee)
  always = source_mandated?(callee, call)
  return false if top_level?(fn) && !always && !in_loop?(fn, block)
  # Source-mandated inlining is exempt from the cost-model size limits.
  # inline_one still charges its growth, so later ordinary calls see it.
  return true if always
  cost = budget.call_cost(callee, call)
  match_helper = callee.name.includes?("~match<")
  return false if !match_helper && cost > 10 && dispatch_over_four?(block)
  unless match_helper || cost <= budget.gate || (callee.linkage == Linkage::Internal && graph.call_sites(callee) == 1 && cost <= 400)
    return false
  end
  # Removing the call and adding the entry branch cancel; cloning preserves
  # the body's instruction count, plus a result phi for non-void calls.
  growth = instruction_count(callee) + (call.type.void? ? 0 : 1)
  return false if instruction_count(fn) + growth > 3000
  return false if budget.used + growth > budget.limit
  true
end

def mapped_value(value : Value, values : Hash(Value, Value)) : Value
  found = values[value]?
  found ? found : value
end

# Only call sites present at the start of a round need use lists. New clones
# register their uses too, since they can refer to a later site in that round.
def track_site_uses(inst : Inst, users : Hash(Inst, Array(Inst))) : Nil
  inst.args.each do |arg|
    if arg.is_a?(Inst)
      if list = users[arg.as(Inst)]?
        list << inst
      end
    end
  end
  nil
end

# The old terminator moves to a newly appended continuation. Preserve the
# predecessor order that a full relink in block order would have produced.
def move_predecessor(target : Block, old : Block, replacement : Block) : Nil
  preds = [] of Block
  target.preds.each { |pred| preds << pred unless pred == old }
  preds << replacement unless preds.any? { |pred| pred == replacement }
  target.preds[0, target.preds.size] = preds
  nil
end

# Clone the entire callee at one call site. Phis are filled only after every
# instruction has an identity, so backedges and forward references are safe.
def inline_one(mod : Module, fn : Function, block : Block, at : Int32, call : Inst, callee : Function, budget : InlineBudget, owners : Hash(Inst, Block), users : Hash(Inst, Array(Inst))) : Int32
  values = Hash(Value, Value).new
  k = 0
  while k < callee.params.size
    values[callee.params[k]] = call.args[k + 1] # mutation S6-arg: actual argument to parameter
    k = k + 1
  end
  blocks = Hash(Block, Block).new
  callee.blocks.each do |source|
    copy = fn.append_basic_block(source.name)
    copy.no_vectorize = source.no_vectorize
    blocks[source] = copy
  end
  continuation = fn.append_basic_block("inline.cont")
  originals = [] of Inst
  clones = [] of Inst
  allocas = [] of Inst
  callee.blocks.each do |source|
    dest = blocks[source]
    source.insts.each do |inst|
      next if inst.op == Op::Ret
      copy = Inst.new(inst.op, inst.type, [] of Value, inst.aux_int, inst.aux, [] of Block, inst.cases[0, inst.cases.size], "")
      values[inst] = copy
      originals << inst
      clones << copy
      if inst.op == Op::Alloca
        allocas << copy
      else
        dest.insts << copy
      end
    end
  end
  # Calls copied out of an allocation entry's body are the funnel the late group considers next.
  if budget.late
    clones.each { |copy| budget.mark_exposed(copy) if copy.op == Op::Call }
  end
  # Late group: the values the call's constants fix in the callee stand in for their instructions, so the cleanup
  # passes fold the clone. Those values hold on every path, so the substitution is sound.
  if budget.late
    constants = late_constants(mod, callee, call)
    k = 0
    while k < callee.params.size
      if constant = constants[callee.params[k]]?
        values[callee.params[k]] = const_int(callee.params[k].type, constant)
      end
      k = k + 1
    end
    callee.blocks.each do |source|
      source.insts.each do |inst|
        if constant = constants[inst]?
          values[inst] = const_int(inst.type, constant)
        end
      end
    end
  end
  k = 0
  while k < originals.size
    original = originals[k]
    copy = clones[k]
    original.args.each { |arg| copy.args << mapped_value(arg, values) }
    original.targets.each { |target| copy.targets << blocks[target] }
    track_site_uses(copy, users)
    k = k + 1
  end

  suffix = block.insts[at + 1, block.insts.size - at - 1]
  prefix = block.insts[0, at]
  continuation.insts[0, continuation.insts.size] = suffix
  suffix.each { |inst| owners[inst] = continuation if owners.has_key?(inst) }
  old_term = continuation.terminator
  old_term.targets.each do |target|
    move_predecessor(target, block, continuation)
    target.insts.each do |inst|
      break unless inst.op == Op::Phi
      inst.move_incoming(block, continuation)
    end
  end
  prefix << new_inst(Op::Br, mod.types.void, [] of Value, 0_i64, nil, [blocks[callee.blocks[0]]] of Block)
  block.insts[0, block.insts.size] = prefix
  blocks[callee.blocks[0]].add_pred(block)

  entry = fn.blocks[0]
  if !allocas.empty?
    term = entry.insts.pop
    allocas.each { |inst| entry.insts << inst }
    entry.insts << term
  end
  phi = call.type.void? ? nil : new_phi(call.type)
  callee.blocks.each do |source|
    term = source.terminator
    next unless term.op == Op::Ret
    dest = blocks[source]
    if result = phi
      result.add_incoming(mapped_value(term.args[0], values), dest) # mutation S6-return: every return edge
    end
    dest.insts << new_inst(Op::Br, mod.types.void, [] of Value, 0_i64, nil, [continuation] of Block)
  end
  callee.blocks.each do |source|
    dest = blocks[source]
    dest.terminator.targets.each { |target| target.add_pred(dest) }
  end
  if result = phi
    track_site_uses(result, users)
    continuation.insts[0, 0] = [result]
    if uses = users[call]?
      uses.each do |inst|
        j = 0
        while j < inst.args.size
          inst.args[j] = result if inst.args[j] == call
          j = j + 1
        end
      end
    end
  end
  instruction_count(callee) + (call.type.void? ? 0 : 1)
end

pub def run_inline(mod : Module, fn : Function, graph : CallGraph, budget : InlineBudget) : Bool
  return false if fn.declaration? || !caller_allowed?(fn)
  changed = false
  round = 0
  relinked = false
  while round < budget.rounds
    budget.round = round
    sites = [] of Inst
    owners = Hash(Inst, Block).new
    users = Hash(Inst, Array(Inst)).new
    fn.blocks.each do |block|
      block.insts.each do |inst|
        if inst.op == Op::Call && (!budget.late || alloc_candidate?(inst, budget))
          sites << inst
          owners[inst] = block
          users[inst] = [] of Inst
        end
      end
    end
    # The late group does no work in a function with no candidate call.
    break if sites.empty?
    # Raise paths are cold. Blocks an inline creates later in this round have no entry and count as hot.
    cold = cold_blocks(fn)
    cold_by_block = Hash(Block, Bool).new
    k = 0
    while k < cold.size
      cold_by_block[fn.blocks[k]] = cold[k]
      k = k + 1
    end
    indexed_users = false
    round_changed = false
    sites.each do |site|
      next if site.args.empty? || !site.args[0].is_a?(Function)
      callee = site.args[0].as(Function)
      if block = owners[site]?
        position = 0
        while position < block.insts.size && block.insts[position] != site
          position = position + 1
        end
        next if position == block.insts.size
        # Leaving an existing alloca in the continuation would violate I4.
        after_alloca = false
        k = position + 1
        while k < block.insts.size
          after_alloca = true if block.insts[k].op == Op::Alloca
          k = k + 1
        end
        next if after_alloca
        # A raise path is cold: only source-mandated inlining may copy into it.
        next if cold_by_block[block]? && !source_mandated?(callee, site)
        next unless call_allowed?(fn, block, site, callee, graph, budget)
        unless indexed_users
          fn.blocks.each { |owner| owner.insts.each { |inst| track_site_uses(inst, users) } }
          indexed_users = true
        end
        unless relinked
          fn.relink
          relinked = true
        end
        budget.used = budget.used + inline_one(mod, fn, block, position, site, callee, budget, owners, users)
        changed = true
        round_changed = true
      end
    end
    break unless round_changed
    round = round + 1
  end
  budget.invalidate(fn) if changed
  changed
end

# ---- Constant-argument costing (late group). ----------------------------------------------------------------

# A call argument's constant: an integer constant, or the size of a type (the sizeof form the escape pass reads).
def constant_argument(mod : Module, value : Value) : Int64?
  if constant = int_value(value)
    return constant
  end
  sizeof_value(mod, value)
end

# The constant an operand holds under the folded parameters: a value this walk folded, or an integer constant.
def known_of(value : Value, known : Hash(Value, Int64)) : Int64?
  found = known[value]?
  return found if found
  int_value(value)
end

# Whether a block calls a noinline callee: its path is a slow path, costed as a cold region.
def calls_noinline?(block : Block) : Bool
  block.insts.any? { |inst| inst.op == Op::Call && !inst.args.empty? && inst.args[0].is_a?(Function) && has_attr?(inst.args[0].as(Function).attrs, "noinline") }
end

# usub.with.overflow and uadd.with.overflow over known operands leave [value, overflow] for their extractvalues.
def overflow_pair(inst : Inst, known : Hash(Value, Int64), pairs : Hash(Value, Array(Int64))) : Nil
  return nil unless inst.aux.is_a?(IntrinsicAux) && inst.args.size == 2 && inst.args[0].type.int? && inst.args[0].type.bits <= 64
  id = inst.aux.as(IntrinsicAux).id
  return nil unless id == IntrinsicId::USubOverflow || id == IntrinsicId::UAddOverflow
  bits = inst.args[0].type.bits
  a = known_of(inst.args[0], known)
  c = known_of(inst.args[1], known)
  return nil if a.nil? || c.nil?
  au = unsigned_value(bits, a)
  cu = unsigned_value(bits, c)
  mask = bits < 64 ? 0xFFFFFFFFFFFFFFFF_u64.unsafe_shr(64 - bits) : 0xFFFFFFFFFFFFFFFF_u64
  if id == IntrinsicId::USubOverflow
    value = (au &- cu) & mask
    overflow = au < cu
  else
    total = au &+ cu
    value = total & mask
    overflow = bits < 64 ? total > mask : total < au
  end
  pairs[inst] = [canonical(bits, u64_as_i64(value)), overflow ? 1_i64 : 0_i64]
  nil
end

# The value an instruction takes when its operands are known, or nil. Overflow intrinsics record their pair.
def fold_inst(inst : Inst, known : Hash(Value, Int64), pairs : Hash(Value, Array(Int64))) : Int64?
  case inst.op
  when Op::Add, Op::Sub, Op::Mul, Op::And, Op::Or, Op::Xor, Op::Shl, Op::LShr, Op::AShr, Op::UDiv, Op::URem, Op::SDiv, Op::SRem
    return nil unless inst.type.int? && inst.type.bits <= 64
    a = known_of(inst.args[0], known)
    c = known_of(inst.args[1], known)
    return nil if a.nil? || c.nil?
    fold_int_binary(inst.op, inst.type.bits, a, c, inst.aux_int)
  when Op::ICmp
    return nil unless inst.args[0].type.int? && inst.args[0].type.bits <= 64
    a = known_of(inst.args[0], known)
    c = known_of(inst.args[1], known)
    return nil if a.nil? || c.nil?
    result = fold_int_compare(inst.aux_int, inst.args[0].type.bits, a, c)
    result.nil? ? nil : (result ? 1_i64 : 0_i64)
  when Op::Select
    condition = known_of(inst.args[0], known)
    return nil if condition.nil?
    known_of(condition == 0_i64 ? inst.args[2] : inst.args[1], known)
  when Op::Trunc, Op::ZExt, Op::SExt
    return nil unless inst.type.int? && inst.type.bits <= 64 && inst.args[0].type.int? && inst.args[0].type.bits <= 64
    a = known_of(inst.args[0], known)
    return nil if a.nil?
    fold_int_cast(inst.op, inst.args[0].type.bits, inst.type.bits, a)
  when Op::ExtractValue
    agg = inst.args[0]
    return nil unless agg.is_a?(Inst)
    pair = pairs[agg]?
    return nil if pair.nil?
    pair[inst.aux_int.to_i32]
  when Op::Intrinsic
    overflow_pair(inst, known, pairs)
    nil
  else
    nil
  end
end

# The cost of what the callee keeps once its parameters are the given constants (nil: unknown). Only blocks
# the constants reach count. An instruction they fix is free, and so is a branch they decide. A raise path or
# a block calling a noinline callee is cold: its instructions are free and each region costs five.
def folded_cost(callee : Function, args : Array(Int64?)) : Int32
  known = Hash(Value, Int64).new
  pairs = Hash(Value, Array(Int64)).new
  decided = Hash(Inst, Bool).new
  k = 0
  while k < callee.params.size
    if constant = args[k]
      known[callee.params[k]] = constant
    end
    k = k + 1
  end
  cfg = Cfg.new(callee)
  cold = cold_blocks(callee)
  n = cfg.size
  live = [] of Bool
  came = [] of Int32
  k = 0
  while k < n
    live << false
    came << -1
    k = k + 1
  end
  live[0] = true
  work = [0] of Int32
  while !work.empty?
    b = work.pop
    block = callee.blocks[b]
    block.insts.each do |inst|
      if inst.op == Op::Phi
        from = came[b]
        k2 = 0
        while from >= 0 && k2 < inst.targets.size
          if inst.targets[k2] == callee.blocks[from]
            if value = known_of(inst.args[k2], known)
              known[inst] = value
            end
          end
          k2 = k2 + 1
        end
      else
        value = fold_inst(inst, known, pairs)
        known[inst] = value if value
      end
    end
    term = block.terminator
    targets = [] of Int32
    if term.op == Op::CondBr
      decided_by = known_of(term.args[0], known)
      if condition = decided_by
        decided[term] = true
        targets << cfg.index(term.targets[condition == 0_i64 ? 1 : 0])
      else
        targets << cfg.index(term.targets[0])
        targets << cfg.index(term.targets[1])
      end
    elsif term.op == Op::Br
      targets << cfg.index(term.targets[0])
    elsif term.op == Op::Switch
      term.targets.each { |target| targets << cfg.index(target) }
    end
    targets.each do |s|
      next if live[s]
      live[s] = true
      came[s] = b
      work << s
    end
  end
  cold_live = [] of Bool
  k = 0
  while k < n
    cold_live << (live[k] && (cold[k] || calls_noinline?(callee.blocks[k])))
    k = k + 1
  end
  cost = 0
  k = 0
  while k < n
    if live[k] && !cold_live[k]
      callee.blocks[k].insts.each do |inst|
        next if known.has_key?(inst) || decided.has_key?(inst)
        if inst.op == Op::Call
          cost = cost + 10
        elsif inst.op == Op::Alloca || inst.op == Op::Phi
          # Free in the cost model.
        elsif inst.op == Op::Intrinsic && inst.aux.is_a?(IntrinsicAux) && inst.aux.as(IntrinsicAux).id == IntrinsicId::ExpectI1
          # A branch hint has no machine cost.
        elsif inst.op == Op::BitCast && inst.type.pointer? && !inst.args.empty? && inst.args[0].type.pointer?
          # A pointer-to-pointer cast has no machine cost.
        else
          cost = cost + 1
        end
      end
    end
    k = k + 1
  end
  visited = [] of Bool
  k = 0
  while k < n
    visited << false
    k = k + 1
  end
  k = 0
  while k < n
    if cold_live[k] && !visited[k]
      cost = cost + 5
      visited[k] = true
      region = [k] of Int32
      while !region.empty?
        node = region.pop
        neighbors = cfg.succs(node) + cfg.preds(node)
        neighbors.each do |other|
          if cold_live[other] && !visited[other]
            visited[other] = true
            region << other
          end
        end
      end
    end
    k = k + 1
  end
  cost
end

# The constants a call fixes in its callee: the parameters it passes constants to, and every non-phi instruction
# whose value they determine. Such a value holds on every path, so a clone may use its constant in place of the
# instruction. Phis are left out, because their value depends on the path taken.
def late_constants(mod : Module, callee : Function, call : Inst) : Hash(Value, Int64)
  known = Hash(Value, Int64).new
  pairs = Hash(Value, Array(Int64)).new
  k = 0
  while k < callee.params.size
    if constant = constant_argument(mod, call.args[k + 1])
      known[callee.params[k]] = constant
    end
    k = k + 1
  end
  rounds = 0
  while rounds < 4
    callee.blocks.each do |block|
      block.insts.each do |inst|
        next if inst.op == Op::Phi || known.has_key?(inst)
        value = fold_inst(inst, known, pairs)
        known[inst] = value if value
      end
    end
    rounds = rounds + 1
  end
  known
end

# An integer constant for a clone to use in place of a folded instruction, canonical for its type.
def const_int(type : IrType, value : Int64) : Inst
  Inst.new(Op::ConstInt, type, [] of Value, canonical(type.bits, value), nil, [] of Block, [] of Int64, "")
end
