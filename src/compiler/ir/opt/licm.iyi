module compiler/ir/opt/licm

import compiler/ir/values::{Value}
import compiler/ir/inst::{Op, Inst, IntrinsicAux, terminator_op?}
import compiler/ir/function::{Function, Global}
import compiler/ir/module::{Module}
import compiler/ir/opt/analysis::{Cfg, DomTree}
import compiler/ir/opt/effects::{pure?, writes_memory?, opaque?, has_side_effects?, marking_flag_load?}

# The effects classifier describes side effects, not whether integer division
# can trap. A zero-trip loop must not execute division in its preheader.
def speculatable?(inst : Inst) : Bool
  return false unless pure?(inst) && !inst.type.void?
  return false if inst.op == Op::SDiv || inst.op == Op::UDiv || inst.op == Op::SRem || inst.op == Op::URem # mutation M16: never speculate integer division
  if inst.op == Op::Intrinsic
    return false unless inst.aux.is_a?(IntrinsicAux)
    aux = inst.aux.as(IntrinsicAux)
    aux.param_attrs.each { |attrs| return false unless attrs.empty? }
  end
  inst.args.each do |arg|
    if arg.is_a?(Inst)
      op = arg.as(Inst).op
      return false if op == Op::ConstUndef || op == Op::ConstPoison
    end
  end
  true
end

# An irreducible DFS retreating edge is not a natural-loop backedge. Skip the
# function instead of assuming the reducible-loop forest property.
def irreducible?(cfg : Cfg, dom : DomTree) : Bool
  return false if cfg.size == 0
  color = [] of Int32
  k = 0
  while k < cfg.size
    color << 0
    k = k + 1
  end
  nodes = [0] of Int32
  edges = [0] of Int32
  color[0] = 1
  while !nodes.empty?
    top = nodes.size - 1
    b = nodes[top]
    at = edges[top]
    if at < cfg.succs(b).size
      successor = cfg.succs(b)[at]
      edges[top] = at + 1
      if color[successor] == 0
        color[successor] = 1
        nodes << successor
        edges << 0
      elsif color[successor] == 1 && !dom.dominates?(successor, b)
        return true
      end
    else
      color[b] = 2
      nodes.pop
      edges.pop
    end
  end
  false
end

class Licm
  def initialize(@fn : Function, @cfg : Cfg, @dom : DomTree)
    @places = Hash(Inst, Int32).new
    @mentions_marking = false
    @escaped_marking = false
    @marking_roots = Hash(Value, Bool).new
    @fn.blocks.each_with_index do |block, b|
      block.insts.each do |inst|
        @places[inst] = b
        unless @mentions_marking
          inst.args.each do |arg|
            if arg.is_a?(Global)
              @mentions_marking = true if arg.as(Global).name == "__iyi_marking"
            elsif arg.is_a?(Inst)
              node = arg.as(Inst)
              if node.op == Op::ConstExpr || node.op == Op::ConstAggregate || node.op == Op::GlobalAddr
                @mentions_marking = true if rooted_at_marking?(arg)
              end
            end
          end
        end
      end
    end
    @inner = [] of Int32
    @headers = [] of Int32
    @parents = [] of Int32
    @preheaders = [] of Int32
    @nearest = [] of Int32
    @jumps = [] of Array(Int32)
    @transparent = [] of Bool
    k = 0
    while k < @cfg.size
      @inner << -1
      k = k + 1
    end
  end

  def find_set(parent : Array(Int32), node : Int32) : Int32
    root = node
    while parent[root] != root
      root = parent[root]
    end
    current = node
    while current != root
      next_node = parent[current]
      parent[current] = root
      current = next_node
    end
    root
  end

  # The representative label is the contracted loop header, independently of
  # the union-find root selected by rank.
  def merge_set(parent : Array(Int32), rank : Array(Int32), label : Array(Int32), header : Int32, member : Int32) : Nil
    a = find_set(parent, header)
    b = find_set(parent, member)
    return if a == b
    if rank[a] < rank[b]
      parent[a] = b
      label[b] = header
    else
      parent[b] = a
      label[a] = header
      rank[a] = rank[a] + 1 if rank[a] == rank[b]
    end
  end

  def preheader(header : Int32) : Int32
    outside = -1
    @cfg.preds(header).each do |pred|
      next if @dom.dominates?(header, pred)
      return -1 if outside >= 0
      outside = pred
    end
    return -1 if outside < 0 || !@cfg.reachable?(outside)
    block = @cfg.block(outside)
    return -1 unless block.terminated? && block.terminator.op == Op::Br
    outside
  end

  # Collapse each natural loop inside out. Once collapsed, an inner loop is
  # represented by its header when walking the predecessors of its parent.
  def collect_loops : Nil
    latches = [] of Array(Int32)
    stamp = [] of Int32
    parent = [] of Int32
    rank = [] of Int32
    label = [] of Int32
    header_loop = [] of Int32
    k = 0
    while k < @cfg.size
      latches << [] of Int32
      stamp << -1
      parent << k
      rank << 0
      label << k
      header_loop << -1
      k = k + 1
    end
    @cfg.rpo.each do |tail|
      @cfg.succs(tail).each do |header|
        latches[header] << tail if @dom.dominates?(header, tail)
      end
    end
    at = @cfg.rpo.size - 1
    while at >= 0
      header = @cfg.rpo[at]
      at = at - 1
      next if latches[header].empty?
      raise "BUG: contracted loop header" unless label[find_set(parent, header)] == header
      loop_id = @headers.size
      @headers << header
      @parents << -1
      @preheaders << preheader(header)
      @nearest << -1
      header_loop[header] = loop_id
      @inner[header] = loop_id
      stamp[header] = loop_id
      work = [] of Int32
      latches[header].each do |latch|
        member = label[find_set(parent, latch)]
        next if member == header || stamp[member] == loop_id
        stamp[member] = loop_id
        work << member
      end
      cursor = 0
      while cursor < work.size
        member = work[cursor]
        cursor = cursor + 1
        @cfg.preds(member).each do |pred|
          next unless @cfg.reachable?(pred) && @dom.dominates?(header, pred)
          representative = label[find_set(parent, pred)]
          next if representative == header || stamp[representative] == loop_id
          stamp[representative] = loop_id
          work << representative
        end
      end
      work.each do |member|
        child = header_loop[member]
        if child >= 0
          raise "BUG: loop has two parents" if @parents[child] >= 0
          @parents[child] = loop_id
        else
          @inner[member] = loop_id
        end
        merge_set(parent, rank, label, header, member)
      end
    end
  end

  # Trace an address through SSA operands, including GEPs, casts and phis.
  # A visited set handles loop-carried phis; only complete walks are cached.
  def rooted_at_marking?(value : Value) : Bool
    return @marking_roots[value] if @marking_roots.has_key?(value)
    pending = [value] of Value
    seen = Hash(Inst, Bool).new
    found = false
    while !pending.empty?
      current = pending.pop
      if current.is_a?(Global)
        if current.as(Global).name == "__iyi_marking"
          found = true
          break
        end
      elsif current.is_a?(Inst)
        node = current.as(Inst)
        next if seen.has_key?(node)
        seen[node] = true
        node.args.each { |arg| pending << arg }
      end
    end
    @marking_roots[value] = found
    found
  end

  # If the marking address escapes, a later load may recover it from memory.
  # Do not hoist loads in that function without a whole-program alias proof.
  def find_marking_references : Nil
    return unless @mentions_marking
    @fn.blocks.each do |block|
      block.insts.each do |inst|
        if inst.op == Op::Store && !inst.args.empty?
          @escaped_marking = true if rooted_at_marking?(inst.args[0])
        elsif inst.op == Op::Call || inst.op == Op::Invoke || inst.op == Op::Ret
          inst.args.each { |arg| @escaped_marking = true if rooted_at_marking?(arg) }
        end
      end
    end
  end

  def marking_read?(inst : Inst) : Bool
    return false unless inst.op == Op::Load && !inst.args.empty?
    marking_flag_load?(inst) || (@mentions_marking && rooted_at_marking?(inst.args[0]))
  end

  # Calls are checked independently of their memory classification: even a
  # memory-free call can raise or fail to return.
  def loop_boundary?(inst : Inst) : Bool
    return may_leave_block?(inst) if inst.op == Op::Call
    writes_memory?(inst) || opaque?(inst) || marking_read?(inst) ||
      (!terminator_op?(inst.op) && has_side_effects?(inst))
  end

  # The loop ids are created inside out. Mark the innermost owner of each
  # clobber, then propagate that fact to its ancestors just once.
  def build_transparency : Nil
    @headers.each { |_| @transparent << true }
    @cfg.rpo.each do |b|
      owner = @inner[b]
      next if owner < 0 || !@transparent[owner]
      @cfg.block(b).insts.each do |inst|
        if loop_boundary?(inst)
          @transparent[owner] = false
          break
        end
      end
    end
    i = 0
    while i < @headers.size
      parent = @parents[i]
      @transparent[parent] = false if parent >= 0 && !@transparent[i]
      i = i + 1
    end
  end

  def loop_transparent?(loop_id : Int32) : Bool
    @transparent[loop_id]
  end

  # A loop lacking a preheader does not prevent motion directly to an outer
  # loop's preheader. Jumps index only ancestors which actually have one.
  def build_jumps : Nil
    valid_parent = [] of Int32
    @headers.each { |_| valid_parent << -1 }
    i = @headers.size - 1
    while i >= 0
      outer = @parents[i]
      nearest_outer = outer < 0 ? -1 : @nearest[outer]
      valid_parent[i] = nearest_outer
      @nearest[i] = @preheaders[i] >= 0 ? i : nearest_outer
      i = i - 1
    end
    return if @headers.empty?
    @jumps << valid_parent
    span = 1
    while span < @headers.size
      previous = @jumps[@jumps.size - 1]
      row = [] of Int32
      i = 0
      while i < @headers.size
        outer = previous[i]
        row << (outer < 0 ? -1 : previous[outer])
        i = i + 1
      end
      @jumps << row
      break if span > @headers.size // 2
      span = span * 2
    end
  end

  def available?(location : Int32, preheader : Int32) : Bool
    return true if location < 0
    return false unless @dom.dominates?(location, preheader) # mutation M17: the operand must dominate the preheader
    true
  end

  # Every operand definition dominates the original use, so their blocks form
  # one dominator chain. The one with the greatest RPO number is the deepest
  # and suffices to test all operands at a proposed destination.
  def latest_operand_block(inst : Inst) : Int32
    latest = -1
    inst.args.each do |arg|
      if arg.is_a?(Inst)
        if location = @places[arg.as(Inst)]?
          if latest < 0 || @cfg.rpo_number(location) > @cfg.rpo_number(latest)
            latest = location
          end
        end
      end
    end
    latest
  end

  def destination(owner : Int32, location : Int32) : Int32
    loop_id = @nearest[owner]
    return -1 if loop_id < 0
    return -1 unless available?(location, @preheaders[loop_id])
    i = @jumps.size - 1
    while i >= 0
      outer = @jumps[i][loop_id]
      if outer >= 0 && available?(location, @preheaders[outer])
        loop_id = outer
      end
      i = i - 1
    end
    @preheaders[loop_id]
  end

  # A header runs whenever its preheader runs. Stop at the first loop whose
  # header is not this block rather than speculating a body-only load.
  def header_load_destination(inst : Inst, owner : Int32, block : Int32) : Int32
    return -1 unless inst.op == Op::Load && !inst.type.void? && inst.args.size == 1
    pointer = inst.args[0]
    if pointer.is_a?(Inst)
      op = pointer.as(Inst).op
      return -1 if op == Op::ConstUndef || op == Op::ConstPoison
    end
    return -1 if @escaped_marking || opaque?(inst) || marking_read?(inst)
    loop_id = @nearest[owner]
    return -1 if loop_id < 0 || @headers[loop_id] != block || !loop_transparent?(loop_id)
    return -1 unless available?(latest_operand_block(inst), @preheaders[loop_id])
    @preheaders[loop_id]
  end

  # A header load is certain to run only if no preceding instruction can
  # leave the block in a defined way. Calls are also transparency barriers.
  def may_leave_block?(inst : Inst) : Bool
    return true if inst.op == Op::Call # mutation M1Call: calls may leave the block
    inst.op == Op::Invoke || (inst.op == Op::Intrinsic && has_side_effects?(inst))
  end

  def run : Bool
    collect_loops
    return false if @headers.empty?
    build_jumps
    find_marking_references
    build_transparency
    moved_from = [] of Bool
    moved_to = [] of Array(Inst)
    k = 0
    while k < @cfg.size
      moved_from << false
      moved_to << [] of Inst
      k = k + 1
    end
    changed = false
    @cfg.rpo.each do |b|
      owner = @inner[b]
      next if owner < 0 || @nearest[owner] < 0
      block = @cfg.block(b)
      next if block.terminator.op == Op::Unreachable
      earlier_exit = false
      block.insts.each do |inst|
        target = -1
        if inst.op == Op::Load
          target = header_load_destination(inst, owner, b) unless earlier_exit
        else
          earlier_exit = true if may_leave_block?(inst)
          target = destination(owner, latest_operand_block(inst)) if speculatable?(inst)
        end
        next if target < 0
        @places[inst] = target
        moved_from[b] = true
        moved_to[target] << inst
        changed = true
      end
    end
    return false unless changed
    @fn.blocks.each_with_index do |block, b|
      next unless moved_from[b] || !moved_to[b].empty?
      rebuilt = [] of Inst
      block.insts.each do |inst|
        moved_to[b].each { |moved| rebuilt << moved } if inst == block.terminator
        rebuilt << inst if @places[inst]? == b
      end
      block.insts[0, block.insts.size] = rebuilt
    end
    true
  end
end

pub def run_licm(mod : Module, fn : Function) : Bool
  return false if fn.declaration? || fn.blocks.size < 2
  cfg = Cfg.new(fn)
  retreating = false
  cfg.rpo.each do |tail|
    cfg.succs(tail).each do |head|
      if cfg.rpo_number(head) <= cfg.rpo_number(tail)
        retreating = true
        break
      end
    end
    break if retreating
  end
  return false unless retreating
  dom = DomTree.new(cfg)
  return false if irreducible?(cfg, dom)
  Licm.new(fn, cfg, dom).run
end
