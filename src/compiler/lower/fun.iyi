module compiler/lower/fun

# The port of the hosted function emitter, `target_def_fun` and `codegen_fun` in
# src/compiler/iyi/codegen/fun.cr, for a def of a single-module unit: a top-level def, or a
# method of a class or struct with a receiver. A def is compiled into a function of its own
# where the first call that reaches it is lowered; a later call at the same argument types
# finds that function and does not emit it again.
#
# Ported: the mangled name of a def (`*name<A, B>:R` for a top-level def, `*Owner#name<A, B>:R`
# for a method, codegen/ast.cr), the function's type and signature (`self` first, when the
# owner is passed as self), the frame (the alloca and entry blocks, the parameters read where
# they arrive, the body, the return), and the lowering state the caller keeps (saved and put
# back around the body).
#
# Not ported, and refused by name at the call that reaches them (lower/call.iyi): by-value and
# indirect arguments and results, the closure, block and proc parameters, the `@[NoInline]`,
# `@[AlwaysInline]`, `@[Naked]` and `@[Raises]` annotations, the debug metadata, and every
# `in artifact`, runtime copy, preemption and closure-host branch of the hosted code: the iyi
# artifact, runtime and preemption machinery does not apply to a single-module unit.
#
# The body is lowered through the dispatch the lowering installed (`BodyVisit`,
# context.iyi), because iyi refuses an import cycle and the dispatch imports this file.

import compiler/syntax/ast::{ASTNode, Assign, ClassDef, Def, ModuleDef, ProcLiteral, Var}
import compiler/syntax/visitor::{Visitor}
import compiler/ir/function::{Function, Linkage}
import compiler/ir/inst::{Attribute, Block, CallConv}
import compiler/ir/types::{IrType}
import compiler/ir/values::{Value}
import compiler/ir/module::{Module}
import compiler/lower/cast::{assign, to_rhs, upcast}
import compiler/lower/context::{BodyVisit, Lowerer, LowerContext, LowerSavedState, LowerVar}
import compiler/lower/helpers::{load_aligned, store_aligned}
import compiler/lower/instance_var::{self_by_pointer?}
import compiler/lower/typer::{passed_by_value?}
import compiler/types/merge::{TypeMerge}
import compiler/types/rendering::{TypeRenderer}
import compiler/semantic/top_level::{GenericClassType, GenericModuleType, MetaclassType, ModuleType, NilType, NoReturnType, Type, VoidType}
import compiler/types/types::{GenericClassInstanceType, GenericInstanceType, GenericModuleInstanceType, PointerInstanceType}

# The hosted `Def#mangled_name` (codegen/ast.cr:13-31): `*`, then for a method the receiver's
# name, `^` and the defining owner when that owner is not the receiver, then `#` (or `::` for a
# metaclass owner). Then the name, the argument types in `<>`, each by its full name, then `:`
# and the return type. A def with no argument has no `<>`. The hosted escaping of a name that is
# not a plain identifier is not ported: the caller refuses such a name. `self_type` is nil for a
# top-level def. A caller that still passes a metaclass as `self_type` and no `class_owner` is
# the hosted metaclass owner: the instance type and `::`, not `Owner.class#`.
pub def mangled_name(name : String, self_type : Type?, arg_types : Array(Type), ret : Type, class_owner : Type? = nil) : String
  text = "*"
  named_self = self_type
  named_class = class_owner
  if named_class.nil?
    if st = self_type
      if st.is_a?(MetaclassType)
        named_class = st.as(MetaclassType).instance_type
        named_self = nil
      end
    end
  end
  if co = named_class
    text = text + owner_segment(co, name, true) + "::"
  end
  if st = named_self
    text = text + owner_segment(st, name, false) + "#"
  end
  text = text + name
  if arg_types.size > 0
    names = [] of String
    arg_types.each do |t|
      names << symbol_type(t)
    end
    text = text + "<" + names.join(", ") + ">"
  end
  text + ":" + symbol_type(ret)
end

# The receiver's name in a symbol, then `^` and the defining owner when the hosted compiler writes
# that segment (codegen/ast.cr: original_owner != self_type). A class method compares instance types.
def owner_segment(receiver : Type, name : String, class_method : Bool) : String
  shown = owner_spell(receiver)
  start = defining_walk_start(receiver, class_method)
  return shown if start.nil?
  found = defining_type(start.as(Type), name, [] of UInt64)
  return shown if found.nil?
  defined = found.as(Type)
  if class_method && defined.is_a?(MetaclassType)
    defined = defined.as(MetaclassType).instance_type
  end
  defined_spell = owner_spell(defined)
  return shown if defined_spell == shown
  shown + "^" + defined_spell
end

# The name the hosted compiler writes for an owner (llvm_name). An unbound generic is `Box(T)`,
# which is `to_s`; `full_name` drops the type variables.
def owner_spell(t : Type) : String
  symbol_type(t)
end

# Hosted llvm_name omits the union's own parentheses inside Pointer(...), but keeps
# virtual types in generic arguments, unlike the user-facing full_name.
def symbol_type(t : Type) : String
  if t.is_a?(PointerInstanceType)
    element = t.as(PointerInstanceType).element_type
    return "Pointer(#{TypeRenderer.render(element, skip_union_parens: true, codegen: true)})"
  end
  TypeRenderer.render(t, codegen: true)
end

# Where the walk for the defining owner starts. A generic instance's methods live on the generic
# type, not on the instance (method_lookup.iyi lookup_receiver). Starting on the instance would
# see the delegated defs and omit `^`.
def defining_walk_start(receiver : Type, class_method : Bool) : Type?
  if class_method
    if receiver.is_a?(GenericClassInstanceType)
      generic = receiver.as(GenericClassInstanceType).generic_type
      return nil unless generic.is_a?(ModuleType)
      return generic.as(ModuleType).metaclass
    end
    if receiver.is_a?(GenericModuleInstanceType)
      generic = receiver.as(GenericModuleInstanceType).generic_type
      return nil unless generic.is_a?(ModuleType)
      return generic.as(ModuleType).metaclass
    end
    return nil unless receiver.is_a?(ModuleType)
    return receiver.as(ModuleType).metaclass
  end
  if receiver.is_a?(GenericInstanceType)
    generic = receiver.as(GenericInstanceType).generic_type
    return generic if generic.is_a?(ModuleType)
    return nil
  end
  return receiver if receiver.is_a?(ModuleType)
  nil
end

# The first type on the parent walk whose own defs declare *name* (hosted original_owner: the type
# the untyped def was added to). Parents are the hosted lookup order.
def defining_type(start : Type, name : String, seen : Array(UInt64)) : Type?
  id = start.object_id
  i = 0
  while i < seen.size
    return nil if seen[i] == id
    i += 1
  end
  seen << id
  return nil unless start.is_a?(ModuleType)
  mod = start.as(ModuleType)
  return mod if mod.defs[name]?
  parents = mod.parents
  pi = 0
  while pi < parents.size
    found = defining_type(parents[pi], name, seen)
    return found if found
    pi += 1
  end
  nil
end

# Lowers the body of a function through the installed dispatch (hosted `accept`).
pub def visit_node(low : Lowerer, node : ASTNode) : Nil
  visitor = low.body_visitor
  raise "BUG: the lowering has no node visitor installed (lower.iyi: codegen_program)" if visitor.nil?
  visitor.as(BodyVisit).visit_body(low, node)
end

# Bodies this process finished emitting, per module. A probe that dies does not mark its
# function, so a later probe must not reuse the leftover.
FUN_EMISSION_DONE = Hash(UInt64, Hash(String, Bool)).new

pub def fun_emission_done?(m : Module, name : String) : Bool
  per = FUN_EMISSION_DONE[m.object_id]?
  return false if per.nil?
  !per.as(Hash(String, Bool))[name]?.nil?
end

pub def mark_fun_emission_done(m : Module, name : String) : Nil
  per = FUN_EMISSION_DONE[m.object_id]?
  if per.nil?
    made = Hash(String, Bool).new
    FUN_EMISSION_DONE[m.object_id] = made
    per = made
  end
  per.as(Hash(String, Bool))[name] = true
end

pub def clear_fun_emission_done(m : Module, name : String) : Nil
  per = FUN_EMISSION_DONE[m.object_id]?
  return if per.nil?
  per.as(Hash(String, Bool)).delete(name)
end

# Drops every function a probe added. A failed probe leaves nothing a later probe can reuse.
pub def discard_probe_functions(m : Module, before : Array(String)) : Nil
  added = [] of Function
  m.functions.each do |fn|
    seen = false
    i = 0
    while i < before.size
      seen = true if before[i] == fn.name
      i += 1
    end
    added << fn unless seen
  end
  added.each do |fn|
    clear_fun_emission_done(m, fn.name)
    m.remove_function(fn)
  end
end

# The hosted `target_def_fun` for a def at these self and argument types, and its return type: the
# function already in the module when there is one, otherwise a new one, emitted now. A method's
# self is the first parameter, of the owner's type (hosted `codegen_fun_signature_non_external`).
pub def target_def_fun(low : Lowerer, target : Def, self_type : Type?, arg_types : Array(Type), ret : Type, class_owner : Type? = nil) : Function
  name = mangled_name(target.name, self_type, arg_types, ret, class_owner)
  if existing = low.module.get_function?(name)
    return existing.as(Function) if fun_emission_done?(low.module, name) || low.emitting[name]?
    low.module.remove_function(existing.as(Function))
    clear_fun_emission_done(low.module, name)
  end
  params = [] of IrType
  if st = self_type
    if self_by_pointer?(st)
      params << low.module.types.ptr(0)
    else
      params << low.typer.llvm_type(st)
    end
  end
  arg_types.each do |t|
    params << low.typer.llvm_type(t)
  end
  ret_ir = low.typer.llvm_return_type(ret)
  fn_type = low.module.types.func(params, ret_ir)
  fn = codegen_fun(low, name, target, self_type, arg_types, fn_type, ret_ir, ret, class_owner)
  # Hosted codegen_fun: a def whose analysed return type is NoReturn carries `noreturn` (fun.cr).
  if ret.is_a?(NoReturnType)
    fn.attrs << Attribute.new("noreturn", 0_u64, nil, nil)
  end
  fn
end

# The function a fun body goes into. A fun the program never calls was declared at its visit (hosted codegen.cr:864
# declares it there and defines its body at the end), so its body goes into that declaration; any other name gets a new
# function. A declaration that already has a body is a bug: a fun is emitted once (hosted External#dead).
pub def declared_or_defined_fun(low : Lowerer, name : String, fn_type : IrType) : Function
  declared = low.module.get_function?(name)
  if declared.nil?
    return low.module.define_function(name, fn_type)
  end
  fn = declared.as(Function)
  if !fn.blocks.empty?
    raise "BUG: #{name} already has a body (hosted External#dead)"
  end
  fn
end

# The calling convention of a function with a body (import.iyi convention_of, the rule the native back end
# reads the oracle with): a def, named with a leading `*` or `~`, is `Iyi`; a `fun` and the runtime's entry
# points (`__crystal_raise_overflow`, `main`) are `C`. The hosted code emits both as `ccc`; the IR keeps them apart.
pub def def_convention(name : String) : CallConv
  return CallConv::Iyi if name.starts_with?("*") || name.starts_with?("~")
  CallConv::C
end

# The hosted `codegen_fun` (fun.cr:271), plain case. The function is declared first, so a recursive
# call finds it. Its body is lowered in a frame of its own: the alloca and entry blocks as
# `new_entry_block` makes them, `self` (when the owner is passed as self) and each parameter a value
# read where it arrives (hosted `already_loaded`), the body, and the return. The caller's state is put
# back afterwards (hosted `old_position`, `old_alloca_block`, `old_needs_value`).
pub def codegen_fun(low : Lowerer, name : String, target : Def, self_type : Type?, arg_types : Array(Type), fn_type : IrType, ret_ir : IrType, ret : Type, class_owner : Type? = nil) : Function
  fn = declared_or_defined_fun(low, name, fn_type)
  low.emitting[name] = true
  fn.call_convention = def_convention(name)
  fn.linkage = Linkage::Internal
  add_body_attributes(fn, low.module.triple)

  saved = low.save_function_state
  # A class method's context names its instance type (hosted: the metaclass's instance, which `allocate` reads),
  # since it has no self. The implicit-self refusal then covers the calls inside it that are not primitives.
  ctx_type = self_type
  if ctx_type.nil?
    ctx_type = class_owner
  end
  low.context = LowerContext.new(fn, fn_type, ctx_type, Hash(String, LowerVar).new)
  low.current_context.return_type = ret
  low.current_context.var_unions = low.analysed.def_var_unions[target]?
  low.alloca_block = nil
  low.entry_block = nil
  low.new_entry_block

  first = 0
  if st = self_type
    self_param = fn.param(0)
    fn.name_param(self_param, "self")
    low.current_context.vars["self"] = LowerVar.new(self_param, st, !self_by_pointer?(st))
    first = 1
  end
  assigned = collect_assigned_vars(target.body)
  i = 0
  while i < target.args.size
    arg = target.args[i]
    arg_type = arg_types[i]
    param = fn.param(i + first)
    fn.name_param(param, arg.name)
    create_local_copy_of_arg(low, arg.name, arg_type, param, assigned.includes?(arg.name))
    i += 1
  end

  low.needs_value = true
  visit_node(low, target.body)
  codegen_fun_return(low, ret_ir, target.body)
  low.finish_main_function
  low.leave_main(saved)
  low.emitting.delete(name)
  mark_fun_emission_done(low.module, name)
  fn
end

# Whether the block the builder is in already ends (its last instruction is a terminator,
# such as the `unreachable` after a NoReturn call). Nothing is emitted after such a block:
# the hosted code tests `@builder.end` before it returns.
pub def block_ended?(low : Lowerer) : Bool
  block = low.builder.insert_block
  return false if block.nil?
  block.as(Block).terminated?
end

# The hosted `codegen_return(target_def.body.type?)` converts the body value to the
# function's semantic result before returning it (fun.cr:579-604, codegen.cr:1192-1209).
pub def codegen_fun_return(low : Lowerer, ret_ir : IrType, body : ASTNode) : Nil
  return if block_ended?(low)
  if ret_ir.void?
    low.builder.ret_void
    return
  end
  value = low.last
  raise "BUG: a function returns a value but its body left none (hosted codegen.cr: codegen_return)" if value.nil?
  body_type = low.analysed.type_of?(body)
  raise "BUG: the function body has no analysed type (hosted codegen_return)" if body_type.nil?
  return_type = low.current_context.return_type
  raise "BUG: the function has no analysed return type (hosted codegen_return)" if return_type.nil?
  converted = upcast(low, value.as(Value), body_type.as(Type), return_type.as(Type))
  # The port's upcast may already return an SSA aggregate rather than its storage.
  converted = to_rhs(low, converted, return_type.as(Type)) if converted.type.pointer?
  low.builder.ret(converted)
end

# The unwind table kind of a function with a body (hosted fun.cr:437-441): sync on aarch64,
# async elsewhere.
pub def uwtable_kind(triple : String) : String
  if triple.includes?("aarch64")
    return "sync"
  end
  "async"
end

# Whether the target is darwin, where the hosted code asks for frame pointers (fun.cr:445).
pub def darwin_triple?(triple : String) : Bool
  triple.includes?("darwin")
end

# The attributes a function with a body carries (hosted codegen_fun, fun.cr:437-450): the unwind
# table, the frame pointers on darwin, and probe-stack (hosted finish, codegen.cr:833).
pub def add_body_attributes(fn : Function, triple : String) : Nil
  fn.attrs << Attribute.new("uwtable", 0_u64, uwtable_kind(triple), nil)
  if darwin_triple?(triple)
    fn.attrs << Attribute.new("frame-pointer", 0_u64, "all", nil)
  end
  fn.attrs << Attribute.new("probe-stack", 0_u64, "inline-asm", nil)
end

# Whether a function already carries the attribute of this name.
pub def has_attr?(fn : Function, name : String) : Bool
  i = 0
  while i < fn.attrs.size
    return true if fn.attrs[i].name == name
    i += 1
  end
  false
end

# The hosted attributes of the functions that codegen_fun does not make: the module's `main`
# (uwtable, frame pointers, probe-stack, as hosted define_main_function) and `__crystal_main`
# (probe-stack). Every function with a body gets probe-stack, as the hosted finish does.
# Called once by codegen_program after `main` is defined. Defs already carry theirs.
pub def function_attributes(m : Module) : Nil
  m.functions.each do |fn|
    next if fn.basic_blocks.empty?
    if fn.name == "main"
      fn.attrs << Attribute.new("uwtable", 0_u64, uwtable_kind(m.triple), nil) unless has_attr?(fn, "uwtable")
      if darwin_triple?(m.triple) && !has_attr?(fn, "frame-pointer")
        fn.attrs << Attribute.new("frame-pointer", 0_u64, "all", nil)
      end
    end
    next if has_attr?(fn, "probe-stack")
    fn.attrs << Attribute.new("probe-stack", 0_u64, "inline-asm", nil)
  end
end

# Collects variable names assigned anywhere in a def's body (excluding nested defs/types/proc literals).
# Hosted `target_def_var.assigned_to?` (fun.cr:1000).
private class AssignedVarCollector < Visitor
  getter names : Set(String)

  def initialize
    @names = Set(String).new
  end

  def visit_any(node : ASTNode) : Bool
    return false if node.is_a?(Def) || node.is_a?(ClassDef) || node.is_a?(ModuleDef) || node.is_a?(ProcLiteral)
    if node.is_a?(Assign)
      t = node.as(Assign).target
      if t.is_a?(Var)
        @names.add(t.as(Var).name)
      end
    end
    true
  end
end

private def collect_assigned_vars(body : ASTNode) : Set(String)
  collector = AssignedVarCollector.new
  body.accept(collector)
  collector.names
end

# The hosted `create_local_copy_of_arg` (fun.cr:945-1043) for a def parameter: allocates a local
# slot and copies the parameter into it when assigned inside the body or passed by value (or widened
# into a variable union); otherwise reads the parameter directly (`already_loaded = true`).
pub def create_local_copy_of_arg(low : Lowerer, name : String, arg_type : Type, param : Value, assigned_to : Bool) : Nil
  return if name == "_"
  var_type = arg_type
  if vu = low.current_context.var_unions
    if u = vu[name]?
      var_type = TypeMerge.merge(low.analysed.program, arg_type, u.as(Type))
    end
  end
  return if var_type.is_a?(VoidType)
  needs_copy = assigned_to || var_type.full_name != arg_type.full_name
  if needs_copy
    pointer = low.alloca(low.typer.llvm_type(var_type), name)
    low.current_context.vars[name] = LowerVar.new(pointer, var_type, false)
    val = param
    if passed_by_value?(arg_type)
      pointer2 = low.alloca(low.typer.llvm_type(arg_type), "")
      store_aligned(low, param, pointer2)
      val = pointer2
    end
    if var_type.full_name == arg_type.full_name
      unless arg_type.is_a?(NilType)
        if passed_by_value?(arg_type)
          store_aligned(low, load_aligned(low, low.typer.llvm_type(arg_type), val), pointer)
        else
          store_aligned(low, val, pointer)
        end
      end
    else
      assign(low, pointer, var_type, arg_type, val)
    end
    return
  end
  if passed_by_value?(arg_type)
    pointer = low.alloca(low.typer.llvm_type(var_type), name)
    store_aligned(low, param, pointer)
    low.current_context.vars[name] = LowerVar.new(pointer, var_type, false)
    return
  end
  low.current_context.vars[name] = LowerVar.new(param, var_type, true)
end
