module compiler/lower/fun

# The port of the hosted function emitter, `target_def_fun` and `codegen_fun` in
# src/compiler/iyi/codegen/fun.cr, for a top-level def of a single-module unit. A def
# is compiled into a function of its own where the first call that reaches it is
# lowered; a later call at the same argument types finds that function and does not
# emit it again.
#
# Ported: the mangled name of a top-level def (`*name<A, B>:R`, codegen/ast.cr), the
# function's type and signature, the frame (the alloca and entry blocks, the
# parameters read where they arrive, the body, the return), and the lowering state the
# caller keeps (saved and put back around the body).
#
# Not ported, and refused by name at the call that reaches them (lower/call.iyi):
# methods with a receiver (self), by-value and indirect arguments and results, the
# closure, block and proc parameters, the `@[NoInline]`, `@[AlwaysInline]`, `@[Naked]`
# and `@[Raises]` annotations, the debug metadata, and every `in artifact`, runtime
# copy, preemption and closure-host branch of the hosted code: the iyi artifact,
# runtime and preemption machinery does not apply to a single-module unit.
#
# The body is lowered through the dispatch the lowering installed (`BodyVisit`,
# context.iyi), because iyi refuses an import cycle and the dispatch imports this file.

import compiler/syntax/ast::{ASTNode, Def}
import compiler/ir/function::{Function, Linkage}
import compiler/ir/inst::{Attribute, Block, CallConv}
import compiler/ir/types::{IrType}
import compiler/ir/values::{Value}
import compiler/ir/module::{Module}
import compiler/lower/context::{BodyVisit, Lowerer, LowerContext, LowerSavedState, LowerVar}
import compiler/semantic/top_level::{NoReturnType, Type}

# The hosted `Def#mangled_name` for a top-level def (codegen/ast.cr): `*` and the name,
# then the argument types in `<>`, each by its full name, then `:` and the return type.
# A def with no argument has no `<>`. The hosted escaping of a name that is not a plain
# identifier is not ported: the caller refuses such a name.
pub def mangled_name(name : String, arg_types : Array(Type), ret : Type) : String
  text = "*" + name
  if arg_types.size > 0
    names = [] of String
    arg_types.each do |t|
      names << t.full_name
    end
    text = text + "<" + names.join(", ") + ">"
  end
  text + ":" + ret.full_name
end

# Lowers the body of a function through the installed dispatch (hosted `accept`).
pub def visit_node(low : Lowerer, node : ASTNode) : Nil
  visitor = low.body_visitor
  raise "BUG: the lowering has no node visitor installed (lower.iyi: codegen_program)" if visitor.nil?
  visitor.as(BodyVisit).visit_body(low, node)
end

# The hosted `target_def_fun` for a top-level def at these argument types, and its
# return type: the function already in the module when there is one, otherwise a new
# one, emitted now.
pub def target_def_fun(low : Lowerer, target : Def, arg_types : Array(Type), ret : Type) : Function
  name = mangled_name(target.name, arg_types, ret)
  if existing = low.module.get_function?(name)
    return existing.as(Function)
  end
  params = [] of IrType
  arg_types.each do |t|
    params << low.typer.llvm_type(t)
  end
  ret_ir = low.typer.llvm_return_type(ret)
  fn_type = low.module.types.func(params, ret_ir)
  fn = codegen_fun(low, name, target, arg_types, fn_type, ret_ir)
  # Hosted codegen_fun: a def whose analysed return type is NoReturn carries `noreturn` (fun.cr).
  if ret.is_a?(NoReturnType)
    fn.attrs << Attribute.new("noreturn", 0_u64, nil, nil)
  end
  fn
end

# The hosted `codegen_fun` (fun.cr:271), plain case. The function is declared first, so a
# recursive call finds it. Its body is lowered in a frame of its own: the alloca and
# entry blocks as `new_entry_block` makes them, each parameter a value read where it
# arrives (hosted `already_loaded`), the body, and the return. The caller's state is put
# back afterwards (hosted `old_position`, `old_alloca_block`, `old_needs_value`).
pub def codegen_fun(low : Lowerer, name : String, target : Def, arg_types : Array(Type), fn_type : IrType, ret_ir : IrType) : Function
  fn = low.module.define_function(name, fn_type)
  fn.call_convention = CallConv::C
  fn.linkage = Linkage::Internal
  add_body_attributes(fn, low.module.triple)

  saved = LowerSavedState.new(low.context, low.alloca_block, low.entry_block, low.builder.insert_block, low.needs_value, low.in_main)
  low.context = LowerContext.new(fn, fn_type, nil, Hash(String, LowerVar).new)
  low.current_context.var_unions = low.analysed.def_var_unions[target]?
  low.alloca_block = nil
  low.entry_block = nil
  low.new_entry_block

  i = 0
  while i < target.args.size
    param = fn.param(i)
    fn.name_param(param, target.args[i].name)
    low.current_context.vars[target.args[i].name] = LowerVar.new(param, arg_types[i], true)
    i += 1
  end

  low.needs_value = true
  visit_node(low, target.body)
  codegen_fun_return(low, ret_ir)
  low.finish_main_function
  low.leave_main(saved)
  fn
end

# Whether the block the builder is in already ends (its last instruction is a terminator,
# such as the `unreachable` after a NoReturn call). Nothing is emitted after such a block:
# the hosted code tests `@builder.end` before it returns.
pub def block_ended?(low : Lowerer) : Bool
  block = low.builder.insert_block
  return false if block.nil?
  block.as(Block).terminated?
end

# The hosted `codegen_return(type)` (codegen.cr:1192) for the value of the body: a void
# result returns nothing, any other returns the value the body left.
pub def codegen_fun_return(low : Lowerer, ret_ir : IrType) : Nil
  return if block_ended?(low)
  if ret_ir.void?
    low.builder.ret_void
    return
  end
  value = low.last
  raise "BUG: a function returns a value but its body left none (hosted codegen.cr: codegen_return)" if value.nil?
  low.builder.ret(value.as(Value))
end

# The unwind table kind of a function with a body (hosted fun.cr:437-441): sync on aarch64,
# async elsewhere.
pub def uwtable_kind(triple : String) : String
  if triple.includes?("aarch64")
    return "sync"
  end
  "async"
end

# Whether the target is darwin, where the hosted code asks for frame pointers (fun.cr:445).
pub def darwin_triple?(triple : String) : Bool
  triple.includes?("darwin")
end

# The attributes a function with a body carries (hosted codegen_fun, fun.cr:437-450): the unwind
# table, the frame pointers on darwin, and probe-stack (hosted finish, codegen.cr:833).
pub def add_body_attributes(fn : Function, triple : String) : Nil
  fn.attrs << Attribute.new("uwtable", 0_u64, uwtable_kind(triple), nil)
  if darwin_triple?(triple)
    fn.attrs << Attribute.new("frame-pointer", 0_u64, "all", nil)
  end
  fn.attrs << Attribute.new("probe-stack", 0_u64, "inline-asm", nil)
end

# Whether a function already carries the attribute of this name.
pub def has_attr?(fn : Function, name : String) : Bool
  i = 0
  while i < fn.attrs.size
    return true if fn.attrs[i].name == name
    i += 1
  end
  false
end

# The hosted attributes of the functions that codegen_fun does not make: the module's `main`
# (uwtable, frame pointers, probe-stack, as hosted define_main_function) and `__crystal_main`
# (probe-stack). Every function with a body gets probe-stack, as the hosted finish does.
# Called once by codegen_program after `main` is defined. Defs already carry theirs.
pub def function_attributes(m : Module) : Nil
  m.functions.each do |fn|
    next if fn.basic_blocks.empty?
    if fn.name == "main"
      fn.attrs << Attribute.new("uwtable", 0_u64, uwtable_kind(m.triple), nil) unless has_attr?(fn, "uwtable")
      if darwin_triple?(m.triple) && !has_attr?(fn, "frame-pointer")
        fn.attrs << Attribute.new("frame-pointer", 0_u64, "all", nil)
      end
    end
    next if has_attr?(fn, "probe-stack")
    fn.attrs << Attribute.new("probe-stack", 0_u64, "inline-asm", nil)
  end
end
