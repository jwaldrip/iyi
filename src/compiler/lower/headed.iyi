module compiler/lower/headed

# The port of the `:headed` census: `iyi_headed?`, `iyi_headed_types` and `iyi_headed_candidate?`
# in src/compiler/iyi/codegen/gc_layouts.cr (lines 166-227). A class is headed when its object
# carries its type id under its fields, which the arena's `__iyi_new` reads from the class's
# `:headed` byte (`iyi_headed_flag`, type_id.cr 153). Hosted rule, in its order:
#   1. `String` is headed by rule (the prelude stores the id under it itself).
#   2. A type whose id does not fit the arena's sixteen-bit slot is headed (`UInt16::MAX`).
#   3. A candidate (a non-generic class or a generic instance) is headed when a virtual type over it
#      was made (`virtual_type_made?`), or a reference union holds it, or it is a subclass of one.
# Rule 3 is the whole-program census (`census_answer`). The allocation does not read it: it loads
# the `:headed` global, and `define_headed_bytes` fills that global once every def is lowered, so a
# virtual type made after the allocation is the byte the load reads (type_id.cr 138-144).
#
# The ids are the port's (`LowerTypeIds`), 30 above the hosted ids until row 16 closes, so the
# sixteen-bit test moves by that shift at the boundary; no fixture reaches it.

import compiler/semantic/top_level::{GenericClassType, NonGenericClassType, SemanticProgram, Type, UnionType}
import compiler/types/types::{GenericClassInstanceType, GenericInstanceType, NilableReferenceUnionType, ReferenceUnionType, TypeQueries}
import compiler/lower/type_id::{LowerTypeIds}
import compiler/lower/typer::{primitive_kind}

# The hosted `UInt16::MAX`, the largest id the arena's layout slot holds.
pub def headed_id_limit : Int32
  65535
end

# The hosted `iyi_headed_candidate?`. A builtin primitive is a NonGenericClassType in the port and a
# PrimitiveType in the hosted program, so it is excluded here by `primitive_kind`.
pub def headed_candidate?(type : Type) : Bool
  return false unless primitive_kind(type) == ""
  type.is_a?(NonGenericClassType) || type.is_a?(GenericClassInstanceType)
end

private def add_headed_with_subclasses(headed : Set(String), type : Type) : Nil
  headed.add(type.full_name)
  TypeQueries.all_subclasses(type).each do |sub|
    headed.add(sub.full_name)
  end
end

private def collect_virtual_headed(headed : Set(String), type : Type) : Nil
  if headed_candidate?(type) && TypeQueries.virtual_type_made?(type)
    add_headed_with_subclasses(headed, type)
  end
  if type.is_a?(GenericClassType)
    type.as(GenericClassType).instantiated_types.each do |inst|
      collect_virtual_headed(headed, inst)
    end
  end
  TypeQueries.subclasses(type).each do |sub|
    next if sub.is_a?(GenericInstanceType)
    collect_virtual_headed(headed, sub)
  end
end

# The hosted `iyi_headed_types` (gc_layouts.cr 204-223): classes that carry a header word
# because a virtual type over them or an ancestor was made, or because they or an ancestor
# appear in a reference union in `program.unions`.
private def headed_census_types(program : SemanticProgram) : Set(String)
  headed = Set(String).new
  if root = program.object_type
    collect_virtual_headed(headed, root.as(Type))
  end
  program.unions.each_value do |union|
    next unless union.is_a?(ReferenceUnionType) || union.is_a?(NilableReferenceUnionType)
    union.as(UnionType).union_types.each do |member|
      resolved = program.remove_alias(member)
      next unless headed_candidate?(resolved)
      add_headed_with_subclasses(headed, resolved)
    end
  end
  headed
end

# The hosted `iyi_headed?` census check (gc_layouts.cr 173-177, 204-223).
private def census_answer(type : Type) : Bool?
  headed_census_types(type.program).includes?(type.full_name)
end

# The `:headed` answer for *type*: true or false when the rules decide it, nil when the census
# (not in the port) would decide it. The caller refuses nil by name rather than guess a byte.
pub def headed?(type : Type, ids : LowerTypeIds) : Bool?
  return true if type.full_name == "String"
  return false unless headed_candidate?(type)
  return true if ids.type_id(type) > headed_id_limit
  census_answer(type)
end
