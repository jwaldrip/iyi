module compiler/lower/proc

# The port of the hosted proc literal: `visit(ProcLiteral)` (src/compiler/iyi/codegen/codegen.cr:1042-1092),
# `fun_literal_name` (codegen.cr:1094-1130) and `make_fun` (codegen.cr:2378-2384), for a literal that captures no
# local, no `self` and no instance variable. Its body is a fun of its own, internal with the Iyi convention, and
# the proc value is the pair of that fun's address and a null context.
#
# Ported: the name (`~proc` and the proc type's text, `^`, the file relative to the working directory, `:` and
# the line; a second literal of one name is `~proc2...`, counted per module), the fun (codegen_fun, with the
# literal's parameters and return), and the value (an alloca, the function and the null context stored into its
# two fields, the struct loaded: hosted make_fun).
#
# Refused by name, at the literal that reaches them: a literal that reads a local the body does not declare
# (a closure: hosted closured_vars and malloc_closure), a literal that reads `self` or an instance variable, a
# literal with a block or a nested literal or def inside it, a literal that returns NoReturn, and a literal whose
# non-Nil body type differs from its return type (hosted upcast of the return, not ported).

import compiler/foundation/location::{Location}
import compiler/ir/types::{IrType}
import compiler/ir/inst::{Attribute}
import compiler/ir/values::{Value}
import compiler/lower/context::{Lowerer}
import compiler/lower/fun::{codegen_fun}
import compiler/lower/helpers::{load_aligned, store_aligned}
import compiler/lower/pending::{refuse_port}
import compiler/syntax/ast::{ASTNode, Assign, ClassDef, Def, InstanceVar, ModuleDef, ProcLiteral, Self, Var}
import compiler/syntax/visitor::{Visitor}
import compiler/semantic/top_level::{NoReturnType, Type}
import compiler/types/types::{ProcInstanceType}

# The hosted `Iyi.symbol_text` (util.cr:59): a text someone else chose, written into a symbol with `%`, `@` and
# `^` escaped, so that the join `^` is never the text's.
pub def symbol_text(text : String) : String
  String.build do |str|
    text.each_char do |char|
      if char == '%'
        str << "%25"
      elsif char == '@'
        str << "%40"
      elsif char == '^'
        str << "%5E"
      else
        str << char.to_s
      end
    end
  end
end

# The hosted `Iyi.relative_filename` (util.cr:4): the file with the working directory and its separator taken
# off the front. A file outside the directory, or one that only starts with its text, keeps its full path.
pub def relative_filename(filename : String) : String
  cwd = Program.cwd
  return filename unless cwd.is_a?(String)
  base = cwd.as(String)
  return filename unless filename.starts_with?(base)
  rest = filename[base.size, filename.size - base.size]
  return rest[1, rest.size - 1] if rest.starts_with?("/")
  filename
end

# The hosted `fun_literal_name` (codegen.cr:1094-1130) for a literal of this proc type, at its place. The name
# is `~proc` and the type's text, `^`, the place's file and `:` and its line. The second literal of one name in
# the module is `~proc2...`, the third `~proc3...`, as the hosted proc counts give them.
pub def proc_literal_name(low : Lowerer, node : ProcLiteral, proc_type : Type) : String
  place = node.location
  if place.nil?
    refuse_port("a proc literal with no location (hosted fun_literal_name, the name ~fun_literal)")
  end
  loc = place.as(Location)
  rest = symbol_text(proc_type.full_name) + "^" + symbol_text(relative_filename(loc.filename)) + ":" + loc.line_number.to_s
  count = 1
  previous = low.proc_counts[rest]?
  if p = previous
    count = p + 1
  end
  low.proc_counts[rest] = count
  if count > 1
    return "~proc" + count.to_s + rest
  end
  "~proc" + rest
end

# What a proc literal's body reads and assigns, found by a walk over the body. A local is declared by an
# assignment or a parameter; a read of a name no assignment declares is a capture. `refused` names the first
# node that makes the literal a closure this port does not lower (a block, a nested literal or def, `self`, an
# instance variable).
pub class ProcScan < Visitor
  getter referenced : Array(String)
  getter assigned : Array(String)
  getter refused : String?

  def initialize
    @referenced = [] of String
    @assigned = [] of String
    @refused = nil
  end

  def visit_any(node : ASTNode) : Bool
    if node.is_a?(Compiler::Syntax::Ast::Block)
      @refused = "a block inside a proc literal (hosted closure over the block context, lower/block.iyi)" if @refused.nil?
      return false
    end
    if node.is_a?(ProcLiteral) || node.is_a?(Def) || node.is_a?(ClassDef) || node.is_a?(ModuleDef)
      @refused = "a nested proc, def or class inside a proc literal (hosted closure)" if @refused.nil?
      return false
    end
    if node.is_a?(Self)
      @refused = "self read by a proc literal (hosted closure over self)" if @refused.nil?
      return false
    end
    if node.is_a?(InstanceVar)
      @refused = "an instance variable read by a proc literal (hosted closure over self)" if @refused.nil?
      return false
    end
    if node.is_a?(Var)
      @referenced << node.as(Var).name
    end
    if node.is_a?(Assign)
      target = node.as(Assign).target
      if target.is_a?(Var)
        @assigned << target.as(Var).name
      end
    end
    true
  end
end

# The hosted `make_fun` (codegen.cr:2378): the proc value of a function and its context, built in an alloca whose
# two fields are stored, then loaded as one struct. Field 0 is the function, field 1 the context.
pub def make_fun(low : Lowerer, proc_type : Type, fun_ptr : Value, ctx_ptr : Value) : Value
  struct_type = low.typer.llvm_type(proc_type)
  closure_ptr = low.alloca(struct_type)
  i32 = low.module.types.int32
  zero = low.builder.const_int(i32, 0).as(Value)
  fun_field = low.builder.inbounds_gep(struct_type, closure_ptr, [zero, low.builder.const_int(i32, 0).as(Value)] of Value)
  store_aligned(low, fun_ptr, fun_field)
  ctx_field = low.builder.inbounds_gep(struct_type, closure_ptr, [zero, low.builder.const_int(i32, 1).as(Value)] of Value)
  store_aligned(low, ctx_ptr, ctx_field)
  load_aligned(low, struct_type, closure_ptr).as(Value)
end

# The hosted `visit(ProcLiteral)` for a literal that captures nothing: the body is emitted as a fun of its own
# (codegen_fun, the Iyi convention, internal), and the literal's value is `make_fun` of that fun and a null
# context. The literal's value is the struct the proc type lowers to.
pub def lower_proc_literal(low : Lowerer, node : ProcLiteral) : Nil
  t = low.analysed.type_of?(node.as(ASTNode))
  raise "BUG: the analysed program has no type for a proc literal (hosted codegen.cr: visit(ProcLiteral))" if t.nil?
  proc_type = t.as(Type)
  unless proc_type.is_a?(ProcInstanceType)
    refuse_port("a proc literal typed #{proc_type.full_name} (hosted visit(ProcLiteral), not a Proc)")
  end
  proc = proc_type.as(ProcInstanceType)

  # The hosted closured check (codegen.cr: def.closure?): every read is of a local the body declares, and the
  # body reads no block, nested literal, self or instance variable.
  scan = ProcScan.new
  node.def.body.accept(scan)
  refused = scan.refused
  if refused
    refuse_port("proc literal: #{refused}")
  end
  declared = [] of String
  node.def.args.each do |arg|
    declared << arg.name
  end
  scan.assigned.each do |name|
    declared << name
  end
  scan.referenced.each do |name|
    unless declared.includes?(name)
      refuse_port("proc literal reads #{name}, a local of the enclosing code: a closure (hosted closured_vars, not ported)")
    end
  end

  body_t = low.analysed.type_of?(node.def.body)
  raise "BUG: the analysed program has no type for a proc literal's body (hosted codegen.cr: visit(ProcLiteral))" if body_t.nil?
  if body_t.as(Type).full_name != proc.return_type.full_name && !proc.return_type.nil_type?
    refuse_port("a proc literal whose body is #{body_t.as(Type).full_name} and returns #{proc.return_type.full_name} (hosted upcast of the return, not ported)")
  end

  name = proc_literal_name(low, node, proc_type)
  params = [] of IrType
  proc.arg_types.each do |at|
    params << low.typer.llvm_type(at)
  end
  ret_ir = low.typer.llvm_type(proc.return_type)
  fn_type = low.module.types.func(params, ret_ir)
  fn = codegen_fun(low, name, node.def, nil, proc.arg_types, fn_type, ret_ir, proc.return_type)
  if proc.return_type.is_a?(NoReturnType)
    fn.attrs << Attribute.new("noreturn", 0_u64, nil, nil)
  end
  null_ctx = low.builder.const_null(low.module.types.ptr(0)).as(Value)
  low.last = make_fun(low, proc_type, fn.as(Value), null_ctx)
end
