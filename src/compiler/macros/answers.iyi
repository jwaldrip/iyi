      "id stringify symbolize class_name doc doc_comment raise warning filename line_number column_number end_line_number end_column_number == != ! nil?"
    when "TupleLiteral"
      "any? all? splat empty? find first includes? join last size each each_with_index map map_with_index select reject reduce shuffle sort sort_by uniq [] []= unshift push << + - * id stringify symbolize class_name doc doc_comment raise warning filename line_number column_number end_line_number end_column_number == != ! nil?"
    when "TypeDeclaration"
      "var type value id stringify symbolize class_name doc doc_comment raise warning filename line_number column_number end_line_number end_column_number == != ! nil?"
    when "TypeDef"
      "name type id stringify symbolize class_name doc doc_comment raise warning filename line_number column_number end_line_number end_column_number == != ! nil?"
    when "TypeNode"
      "abstract? union? module? class? struct? nilable? union_types name type_vars instance_vars class_vars ancestors superclass subclasses all_subclasses includers constants constant has_constant? methods all_methods has_method? annotation annotations size keys [] class instance == != < <= > >= overrides? resolve resolve? private? public? visibility has_inner_pointers? id stringify symbolize class_name doc doc_comment raise warning filename line_number column_number end_line_number end_column_number ! nil?"
    when "TypeOf"
      "args id stringify symbolize class_name doc doc_comment raise warning filename line_number column_number end_line_number end_column_number == != ! nil?"
    when "UnaryExpression"
      "exp id stringify symbolize class_name doc doc_comment raise warning filename line_number column_number end_line_number end_column_number == != ! nil?"
    when "Underscore"
      "id stringify symbolize class_name doc doc_comment raise warning filename line_number column_number end_line_number end_column_number == != ! nil?"
    when "UninitializedVar"
      "var type id stringify symbolize class_name doc doc_comment raise warning filename line_number column_number end_line_number end_column_number == != ! nil?"
    when "Union"
      "resolve resolve? types id stringify symbolize class_name doc doc_comment raise warning filename line_number column_number end_line_number end_column_number == != ! nil?"
    when "Unless"
      "id stringify symbolize class_name doc doc_comment raise warning filename line_number column_number end_line_number end_column_number == != ! nil?"
    when "Until"
      "id stringify symbolize class_name doc doc_comment raise warning filename line_number column_number end_line_number end_column_number == != ! nil?"
    when "UsingDecl"
      "id stringify symbolize class_name doc doc_comment raise warning filename line_number column_number end_line_number end_column_number == != ! nil?"
    when "Var"
      "id stringify symbolize class_name doc doc_comment raise warning filename line_number column_number end_line_number end_column_number == != ! nil?"
    when "VisibilityModifier"
      "exp visibility id stringify symbolize class_name doc doc_comment raise warning filename line_number column_number end_line_number end_column_number == != ! nil?"
    when "When"
      "conds body exhaustive? id stringify symbolize class_name doc doc_comment raise warning filename line_number column_number end_line_number end_column_number == != ! nil?"
    when "While"
      "cond body id stringify symbolize class_name doc doc_comment raise warning filename line_number column_number end_line_number end_column_number == != ! nil?"
    when "Yield"
      "expressions scope id stringify symbolize class_name doc doc_comment raise warning filename line_number column_number end_line_number end_column_number == != ! nil?"
    else
