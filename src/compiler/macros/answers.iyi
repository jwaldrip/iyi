# The macro methods the hosted compiler answers on a receiver of each AST type,
# and the receiverless calls it answers. A name not listed is undefined there.
pub class MacroAnswers
  # Whether the hosted compiler answers `method` on a receiver of `class_name`.
  def self.receiver?(class_name : String, method : String) : Bool
    (" " + receiver_names(class_name) + " ").includes?(" " + method + " ")
  end

  # Whether the hosted compiler answers a receiverless call named `name`.
  def self.receiverless?(name : String) : Bool
    (" " + receiverless_names + " ").includes?(" " + name + " ")
  end

  # Whether a path naming one of these resolves to a type, as the hosted program's own do.
  def self.builtin_type?(name : String) : Bool
    (" " + builtin_type_names + " ").includes?(" " + name + " ")
  end

  def self.builtin_type_names : String
    "Object Reference Value Number NoReturn Void Nil Bool Char Int Int8 UInt8 Int16 UInt16 Int32 UInt32 Int64 UInt64 Int128 UInt128 Float Float32 Float64 Symbol Pointer Tuple NamedTuple StaticArray String Class Struct Enumerable Indexable Array Hash Regex Range Slice Exception Enum Proc Union ARGC_UNSAFE ARGV_UNSAFE GC AlwaysInline CallConvention Extern Flags Link Naked NoInline Packed Primitive Raises ReturnsTwice ThreadLocal Deprecated Experimental TargetFeature Share NoPreempt SafeReach UnsafeReach Unsafe Error"
