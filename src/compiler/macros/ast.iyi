module compiler/macros/ast

import compiler/syntax/ast::{ASTNode, StringBuilder, StringLiteral, SymbolLiteral, Var}

pub class MacroId < ASTNode
  property value : String

  def initialize(@value : String)
  end

  def to_macro_id : String
    @value
  end

  def clone_without_location : self
    MacroId.new(@value)
  end

  def to_s(sb : StringBuilder) : Nil
    sb << @value
  end

  def ==(other : self) : Bool
    @value == other.value
  end

  def ==(other : ASTNode) : Bool
    if other.is_a?(MacroId)
      @value == other.as(MacroId).value
    elsif other.is_a?(StringLiteral)
      @value == other.as(StringLiteral).value
    elsif other.is_a?(SymbolLiteral)
      @value == other.as(SymbolLiteral).value
    elsif other.is_a?(Var)
      @value == other.as(Var).name
    else
      false
    end
  end

  def hash : Int32
    @value.hash
  end
end

# A type the macro language names: a path that resolves to one of the hosted
# program's built-in types. It prints as the type's name, as the hosted
# `TypeNode` does.
pub class TypeNode < ASTNode
  property name : String

  def initialize(@name : String)
  end

  def to_macro_id : String
    @name
  end

  def to_s(sb : StringBuilder) : Nil
    sb << @name
  end

  def clone_without_location : self
    TypeNode.new(@name)
  end
end
