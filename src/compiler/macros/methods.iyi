module compiler/macros/methods

import compiler/syntax/ast::{ASTNode, Arg, ArrayLiteral, Assign, Block, BoolLiteral, Call, CharLiteral, ClassDef, ClassVar, Def, DoubleSplat, Expressions, Generic, Global, HashLiteral, If, ImplicitObj, InstanceVar, IsA, Macro, MacroExpression, MacroFor, MacroIf, MacroLiteral, MacroVar, MacroVerbatim, MultiAssign, NamedArgument, NamedTupleLiteral, Next, NilLiteral, Nop, Not, NumberLiteral, OpAssign, Or, Path, RangeLiteral, Return, Self, Splat, StringInterpolation, StringLiteral, SymbolLiteral, TupleLiteral, TypeDeclaration, Underscore, Unless, Until, Var, While, StringBuilder}
import compiler/syntax/token::{NumberKind}
import compiler/platform/flags::{PlatformFlags}
import compiler/macros/ast::{MacroId, TypeNode}
import compiler/macros/answers::{MacroAnswers}

pub class MacroMethods
  # A hosted method refusal (`undefined method 'size' ...`), read once by the
  # interpreter. Nil when the method is simply not ported.
  @@method_error : String? = nil

  def self.refuse(message : String) : Nil
    @@method_error = message
    nil
  end

  def self.take_error : String?
    err = @@method_error
    @@method_error = nil
    err
  end

  def self.truthy?(node : ASTNode) : Bool
    if node.is_a?(NilLiteral) || node.is_a?(Nop)
      false
    elsif node.is_a?(BoolLiteral)
      node.as(BoolLiteral).value
    else
      true
    end
  end

  # `flag?(name)` answers from the flag set of the target the macro is expanded
  # for (see `MacroTargetFlags`), as the hosted `Program#has_flag?` does.
  def self.has_flag?(flags : Array(String), name : String) : Bool
    PlatformFlags.has_flag?(flags, name)
  end

  def self.to_macro_id(node : ASTNode) : String
    if node.is_a?(MacroId)
      node.as(MacroId).value
    elsif node.is_a?(StringLiteral)
      node.as(StringLiteral).value
    elsif node.is_a?(SymbolLiteral)
      node.as(SymbolLiteral).value
    elsif node.is_a?(CharLiteral)
      node.as(CharLiteral).value.to_s
    elsif node.is_a?(Var)
      node.as(Var).name
    else
      sb = StringBuilder.new
      node.to_s(sb)
      sb.to_s
    end
  end

  def self.node_stringify(node : ASTNode) : String
    if node.is_a?(MacroId)
      node.as(MacroId).value
    else
      sb = StringBuilder.new
      node.to_s(sb)
      sb.to_s
    end
  end

  # A symbol as the hosted compiler writes it: bare when it is a plain name,
  # quoted with its quotes and backslashes escaped otherwise.
  def self.symbol_text(value : String) : String
    plain = value.bytesize > 0
    i = 0
    while i < value.bytesize
      c = value.byte_at(i).unsafe_chr
      ok_start = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_'
      ok_rest = ok_start || (c >= '0' && c <= '9') || ((c == '?' || c == '!' || c == '=') && i == value.bytesize - 1)
      if (i == 0 && !ok_start) || (i > 0 && !ok_rest)
        plain = false
      end
      i = i + 1
    end
    if plain
      ":" + value
    else
      sb = StringBuilder.new
      sb << ":\""
      j = 0
      while j < value.bytesize
        c = value.byte_at(j).unsafe_chr
        if c == '"' || c == '\\'
          sb << "\\"
        end
        sb << c
        j = j + 1
      end
      sb << "\""
      sb.to_s
    end
  end

  # A string literal as the hosted compiler writes it: quoted, with its quotes,
  # backslashes and line breaks escaped.
  def self.string_text(value : String) : String
    sb = StringBuilder.new
    sb << "\""
    i = 0
    while i < value.bytesize
      c = value.byte_at(i).unsafe_chr
      if c == '"' || c == '\\'
        sb << "\\"
        sb << c
      elsif c == '\n'
        sb << "\\n"
      elsif c == '\r'
        sb << "\\r"
      elsif c == '\t'
        sb << "\\t"
      else
        sb << c
      end
      i = i + 1
    end
    sb << "\""
    sb.to_s
  end

  # The hosted compiler's name for a node's class, as `class_desc` gives it.
  def self.node_class_name(node : ASTNode) : String
    MacroAnswers.class_name_of(node)
  end

  def self.capitalize(s : String) : String
    if s.empty?
      ""
    else
      sb = StringBuilder.new
      i = 0
      while i < s.bytesize
        c = s.byte_at(i).unsafe_chr
        if i == 0
          sb << c.upcase
        else
          sb << c.downcase
        end
        i = i + 1
      end
      sb.to_s
    end
  end

  def self.camelcase(s : String) : String
    sb = StringBuilder.new
    up = true
    i = 0
    while i < s.bytesize
      c = s.byte_at(i).unsafe_chr
      if c == '_'
        up = true
      elsif up
        sb << c.upcase
        up = false
      else
        sb << c
      end
      i = i + 1
    end
    sb.to_s
  end

  def self.underscore(s : String) : String
    sb = StringBuilder.new
    i = 0
    while i < s.bytesize
      c = s.byte_at(i).unsafe_chr
      if c >= 'A' && c <= 'Z'
        if i > 0
          sb << "_"
        end
        sb << c.downcase
      else
        sb << c
      end
      i = i + 1
    end
    sb.to_s
  end

  def self.eval_int(node : ASTNode) : Int64
    if node.is_a?(NumberLiteral)
      val_str = node.as(NumberLiteral).value
      val_str.to_i64? || 0_i64
    else
      0_i64
    end
  end

  def self.ast_equal?(a : ASTNode, b : ASTNode) : Bool
    if a.is_a?(MacroId) || b.is_a?(MacroId)
      to_macro_id(a) == to_macro_id(b)
    elsif a.is_a?(StringLiteral) && b.is_a?(StringLiteral)
      a.as(StringLiteral).value == b.as(StringLiteral).value
    elsif a.is_a?(NumberLiteral) && b.is_a?(NumberLiteral)
      a.as(NumberLiteral).value == b.as(NumberLiteral).value
    elsif a.is_a?(BoolLiteral) && b.is_a?(BoolLiteral)
      a.as(BoolLiteral).value == b.as(BoolLiteral).value
    elsif a.is_a?(NilLiteral) && b.is_a?(NilLiteral)
      true
    elsif a.is_a?(Var) && b.is_a?(Var)
      a.as(Var).name == b.as(Var).name
    else
      a == b
    end
  end

  # `text` with each byte of `from` replaced by the byte at its place in `to`, as
  # the hosted `String#tr` does for two lists of the same length without ranges.
  def self.translate_chars(text : String, from : String, to : String) : String
    sb = StringBuilder.new
    i = 0
    while i < text.bytesize
      c = text.byte_at(i).unsafe_chr
      mapped = c
      j = 0
      found = false
      while j < from.bytesize
        if !found && from.byte_at(j).unsafe_chr == c
          mapped = to.byte_at(j).unsafe_chr
          found = true
        end
        j = j + 1
      end
      sb << mapped
      i = i + 1
    end
    sb.to_s
  end

  # Whether one of `elements` is `value`, as the hosted `Array#includes?` finds it.
  def self.tuple_includes?(elements : Array(ASTNode), value : ASTNode) : Bool
    i = 0
    while i < elements.size
      if ast_equal?(elements[i], value)
        return true
      end
      i = i + 1
    end
    false
  end

  # Whether a node holds text as the macro text arguments take it: a string, a
  # symbol or an identifier.
  def self.text_like?(node : ASTNode) : Bool
    node.is_a?(StringLiteral) || node.is_a?(SymbolLiteral) || node.is_a?(MacroId)
  end

  # Whether every byte of `text` is an ASCII digit.
  def self.digits?(text : String) : Bool
    i = 0
    while i < text.bytesize
      c = text.byte_at(i).unsafe_chr
      if c < '0' || c > '9'
        return false
      end
      i = i + 1
    end
    true
  end

  # The three numbers of a `MAJOR.MINOR.PATCH` version, or nil for any other
  # text. Prerelease and build forms are not ported and read as nil.
  def self.version_numbers(text : String) : Array(Int64)?
    pieces = text.split(".")
    if pieces.size != 3
      return nil
    end
    nums = [] of Int64
    i = 0
    while i < 3
      piece = pieces[i]
      if piece.empty? || !digits?(piece)
        return nil
      end
      nums << (piece.to_i64? || 0_i64)
      i = i + 1
    end
    nums
  end

  # The hosted compiler's `compare_versions`: -1, 0 or 1 by the order of two
  # `MAJOR.MINOR.PATCH` versions, or nil when either is not one.
  def self.compare_versions(first : String, second : String) : Int32?
    if a = version_numbers(first)
      if b = version_numbers(second)
        i = 0
        while i < 3
          if a[i] < b[i]
            return -1
          end
          if a[i] > b[i]
            return 1
          end
          i = i + 1
        end
        return 0
      end
    end
    nil
  end

  # The value a macro method called on `receiver` answers, or nil when this port
  # has no branch for it. Whether the hosted compiler answers `method` on that
  # receiver at all is `MacroAnswers.receiver?`, which the interpreter asks
  # first: a name it does not answer is undefined there, and a name it answers
  # that has no branch here is refused by name, never guessed at.
  def self.interpret_method(
    flags : Array(String),
    receiver : ASTNode?,
    method : String,
    args : Array(ASTNode),
    named_args : Hash(String, ASTNode)? = nil,
    block : Block? = nil,
  ) : ASTNode?
    @@method_error = nil
    if receiver.nil?
      return nil
    end

    rec = receiver.as(ASTNode)

    case method
    when "id"
      return MacroId.new(to_macro_id(rec))
    when "stringify"
      return StringLiteral.new(node_stringify(rec))
    when "class_name"
      return StringLiteral.new(node_class_name(rec))
    when "symbolize"
      return SymbolLiteral.new(node_stringify(rec))
    when "nil?"
      return BoolLiteral.new(rec.is_a?(NilLiteral) || rec.is_a?(Nop))
    when "!"
      return BoolLiteral.new(!truthy?(rec))
    when "=="
      if args.size > 0
        return BoolLiteral.new(ast_equal?(rec, args[0]))
      else
        return BoolLiteral.new(false)
      end
    when "!="
      if args.size > 0
        return BoolLiteral.new(!ast_equal?(rec, args[0]))
      else
        return BoolLiteral.new(true)
      end
    end

    if rec.is_a?(TypeNode)
      tn = rec.as(TypeNode)
      # `name(generic_args:)` changes only a generic type's name. The scan never
      # answers a generic type from its name (MacroSiteRef.generic), so the name
      # is the same with or without the argument.
      if method == "name"
        return MacroId.new(rec.as(TypeNode).name)
      end
      # Hosted `TypeNode#size`: the type argument count of a tuple or named
      # tuple instance. Any other type, a union included, is refused.
      if method == "size"
        if tn.sized
          return NumberLiteral.new(tn.type_args.size.to_s, NumberKind::I32)
        end
        shown = StringBuilder.new
        tn.to_s(shown)
        refuse("undefined method 'size' for TypeNode of type #{shown.to_s} (must be a tuple or named tuple type)")
        return nil
      end
      # Hosted TypeNode#[]: a tuple type argument by index. Out of range is nil.
      # Any other type is refused, as size is.
      if method == "[]"
        if !tn.sized
          shown = StringBuilder.new
          tn.to_s(shown)
          refuse("undefined method '[]' for TypeNode of type #{shown.to_s} (must be a tuple or named tuple type)")
          return nil
        end
        if args.size == 1 && args[0].is_a?(NumberLiteral)
          idx = eval_int(args[0]).to_i32
          if idx < 0
            idx = tn.type_args.size + idx
          end
          if idx >= 0 && idx < tn.type_args.size
            return TypeNode.new(tn.type_args[idx])
          end
          return NilLiteral.new
        end
        return NilLiteral.new
      end
      return nil
    end

    if rec.is_a?(StringLiteral)
      str = rec.as(StringLiteral)
      case method
      when "+"
        if args.size > 0
          other_node = args[0]
          combined = str.value + to_macro_id(other_node)
          if other_node.is_a?(MacroId)
            return MacroId.new(combined)
          else
            return StringLiteral.new(combined)
          end
        else
          return nil
        end
      when "size", "bytesize"
        return NumberLiteral.new(str.value.bytesize.to_s, NumberKind::I32)
      when "empty?"
        return BoolLiteral.new(str.value.empty?)
      when "upcase"
        return StringLiteral.new(str.value.upcase)
      when "downcase"
        return StringLiteral.new(str.value.downcase)
      when "capitalize"
        return StringLiteral.new(capitalize(str.value))
      when "camelcase"
        return StringLiteral.new(camelcase(str.value))
      when "underscore"
        return StringLiteral.new(underscore(str.value))
      when "starts_with?"
        prefix = args.size > 0 ? to_macro_id(args[0]) : ""
        return BoolLiteral.new(str.value.starts_with?(prefix))
      when "ends_with?"
        suffix = args.size > 0 ? to_macro_id(args[0]) : ""
        return BoolLiteral.new(str.value.ends_with?(suffix))
      when "includes?"
        sub = args.size > 0 ? to_macro_id(args[0]) : ""
        return BoolLiteral.new(str.value.includes?(sub))
      when "tr"
        if args.size == 2 && args[0].is_a?(StringLiteral) && args[1].is_a?(StringLiteral)
          from = args[0].as(StringLiteral).value
          to = args[1].as(StringLiteral).value
          if from.bytesize == to.bytesize && !from.includes?("-") && !to.includes?("-")
            return StringLiteral.new(translate_chars(str.value, from, to))
          end
        end
      when "[]"
        if args.size == 1
          idx = eval_int(args[0]).to_i32
          if idx >= 0 && idx < str.value.bytesize
            return StringLiteral.new(str.value.byte_at(idx).unsafe_chr.to_s)
          else
            return StringLiteral.new("")
          end
        end
      end
      return nil
    end

    if rec.is_a?(NumberLiteral)
      num = rec.as(NumberLiteral)
      val = eval_int(num)
      other_val = args.size > 0 ? eval_int(args[0]) : 0_i64
      case method
      when "+"
        return NumberLiteral.new((val + other_val).to_s, num.kind)
      when "-"
        return NumberLiteral.new((val - other_val).to_s, num.kind)
      when "*"
        return NumberLiteral.new((val * other_val).to_s, num.kind)
      when "/"
        res = other_val != 0_i64 ? (val // other_val) : 0_i64
        return NumberLiteral.new(res.to_s, num.kind)
      when "%"
        res = other_val != 0_i64 ? (val % other_val) : 0_i64
        return NumberLiteral.new(res.to_s, num.kind)
      when "<"
        return BoolLiteral.new(val < other_val)
      when "<="
        return BoolLiteral.new(val <= other_val)
      when ">"
        return BoolLiteral.new(val > other_val)
      when ">="
        return BoolLiteral.new(val >= other_val)
      end
      return nil
    end

    if rec.is_a?(HashLiteral)
      hash = rec.as(HashLiteral)
      case method
      when "size"
        return NumberLiteral.new(hash.entries.size.to_s, NumberKind::I32)
      when "empty?"
        return BoolLiteral.new(hash.entries.empty?)
      when "keys"
        keys = [] of ASTNode
        hash.entries.each do |entry|
          keys << entry.key
        end
        return ArrayLiteral.new(keys)
      when "[]"
        if args.size == 1
          i = 0
          while i < hash.entries.size
            if ast_equal?(hash.entries[i].key, args[0])
              return hash.entries[i].value
            end
            i = i + 1
          end
          return NilLiteral.new
        end
      end
      return nil
    end

    if rec.is_a?(ArrayLiteral)
      arr = rec.as(ArrayLiteral)
      case method
      when "size"
        return NumberLiteral.new(arr.elements.size.to_s, NumberKind::I32)
      when "empty?"
        return BoolLiteral.new(arr.elements.empty?)
      when "first"
        if arr.elements.size > 0
          return arr.elements[0]
        else
          return NilLiteral.new
        end
      when "last"
        if arr.elements.size > 0
          return arr.elements[arr.elements.size - 1]
        else
          return NilLiteral.new
        end
      when "[]"
        if args.size == 1
          idx = eval_int(args[0]).to_i32
          if idx < 0
            idx = arr.elements.size + idx
          end
          if idx >= 0 && idx < arr.elements.size
            return arr.elements[idx]
          else
            return NilLiteral.new
          end
        end
      when "+"
        if args.size > 0 && args[0].is_a?(ArrayLiteral)
          other_arr = args[0].as(ArrayLiteral)
          new_elems = [] of ASTNode
          arr.elements.each { |e| new_elems << e }
          other_arr.elements.each { |e| new_elems << e }
          return ArrayLiteral.new(new_elems)
        end
      when "includes?"
        if args.size == 1
          return BoolLiteral.new(tuple_includes?(arr.elements, args[0]))
        end
      when "join"
        sep = args.size > 0 ? to_macro_id(args[0]) : ""
        sb = StringBuilder.new
        i = 0
        while i < arr.elements.size
          if i > 0
            sb << sep
          end
          sb << to_macro_id(arr.elements[i])
          i = i + 1
        end
        return StringLiteral.new(sb.to_s)
      end
      return nil
    end

    if rec.is_a?(TupleLiteral)
      tup = rec.as(TupleLiteral)
      case method
      when "size"
        return NumberLiteral.new(tup.elements.size.to_s, NumberKind::I32)
      when "empty?"
        return BoolLiteral.new(tup.elements.empty?)
      when "first"
        if tup.elements.size > 0
          return tup.elements[0]
        else
          return NilLiteral.new
        end
      when "last"
        if tup.elements.size > 0
          return tup.elements[tup.elements.size - 1]
        else
          return NilLiteral.new
        end
      when "[]"
        if args.size == 1
          idx = eval_int(args[0]).to_i32
          if idx < 0
            idx = tup.elements.size + idx
          end
          if idx >= 0 && idx < tup.elements.size
            return tup.elements[idx]
          else
            return NilLiteral.new
          end
        end
      when "includes?"
        if args.size == 1
          return BoolLiteral.new(tuple_includes?(tup.elements, args[0]))
        end
      when "join"
        sep = args.size > 0 ? to_macro_id(args[0]) : ""
        sb = StringBuilder.new
        i = 0
        while i < tup.elements.size
          if i > 0
            sb << sep
          end
          sb << to_macro_id(tup.elements[i])
          i = i + 1
        end
        return StringLiteral.new(sb.to_s)
      end
      return nil
    end

    if rec.is_a?(NamedTupleLiteral)
      nt = rec.as(NamedTupleLiteral)
      case method
      when "size"
        return NumberLiteral.new(nt.entries.size.to_s, NumberKind::I32)
      when "empty?"
        return BoolLiteral.new(nt.entries.empty?)
      when "keys"
        keys_arr = [] of ASTNode
        nt.entries.each do |e|
          keys_arr << MacroId.new(e.key)
        end
        return ArrayLiteral.new(keys_arr)
      when "values"
        vals_arr = [] of ASTNode
        nt.entries.each do |e|
          vals_arr << e.value
        end
        return ArrayLiteral.new(vals_arr)
      when "[]"
        if args.size == 1
          k = to_macro_id(args[0])
          i = 0
          while i < nt.entries.size
            if nt.entries[i].key == k
              return nt.entries[i].value
            end
            i = i + 1
          end
          return NilLiteral.new
        end
      when "has_key?"
        if args.size == 1
          k = to_macro_id(args[0])
          i = 0
          found = false
          while i < nt.entries.size
            if nt.entries[i].key == k
              found = true
            end
            i = i + 1
          end
          return BoolLiteral.new(found)
        else
          return BoolLiteral.new(false)
        end
      end
      return nil
    end

    if rec.is_a?(Call)
      call_node = rec.as(Call)
      case method
      when "name"
        return MacroId.new(call_node.name)
      when "args"
        call_args = [] of ASTNode
        call_node.args.each { |a| call_args << a }
        return ArrayLiteral.new(call_args)
      when "receiver"
        if o = call_node.obj
          return o
        else
          return NilLiteral.new
        end
      when "block"
        if b = call_node.block
          return b
        else
          return NilLiteral.new
        end
      end
      return nil
    end

    if rec.is_a?(Def)
      def_node = rec.as(Def)
      case method
      when "name"
        return MacroId.new(def_node.name)
      when "args"
        d_args = [] of ASTNode
        def_node.args.each { |a| d_args << a.as(ASTNode) }
        return ArrayLiteral.new(d_args)
      when "return_type"
        if rt = def_node.return_type
          return rt
        else
          return NilLiteral.new
        end
      when "body"
        return def_node.body
      end
      return nil
    end

    if rec.is_a?(Arg)
      arg_node = rec.as(Arg)
      case method
      when "name"
        return MacroId.new(arg_node.name)
      when "default_value"
        if dv = arg_node.default_value
          return dv
        else
          return NilLiteral.new
        end
      end
      return nil
    end

    if rec.is_a?(RangeLiteral)
      rng = rec.as(RangeLiteral)
      case method
      when "begin"
        return rng.from
      when "end"
        return rng.to
      when "excludes_end?"
        return BoolLiteral.new(rng.exclusive)
      end
      return nil
    end

    if rec.is_a?(TypeDeclaration)
      td = rec.as(TypeDeclaration)
      case method
      when "var"
        return td.var
      when "type"
        return td.declared_type
      when "value"
        if v = td.value
          return v
        else
          return NilLiteral.new
        end
      end
      return nil
    end

    nil
  end
end
