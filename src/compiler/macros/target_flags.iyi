module compiler/macros/target_flags

import compiler/platform/target::{Target}
import compiler/platform/flags::{PlatformFlags}

# The flag set a macro sees: the flags its target triple implies, then the `-D`
# defines, as the hosted compiler builds `Program#flags` (`flags_for_target`
# plus `program.flags << define`). `flag?(:name)` in a macro answers from this
# set and nothing else.
pub class MacroTargetFlags
  # The host's triple, as the hosted `Config.host_target` gives it at run time: the triple the flags this compiler was
  # built for name, with the macOS version taken from MACOSX_DEPLOYMENT_TARGET when that is set. Not ported: the Linux C
  # library the hosted compiler detects with ldd, and IYI_CONFIG_TARGET, which the hosted compiler reads when it is built.
  # Read from the compile-time flags, not LLVM's default triple, so the native tool links no LLVM.
  # The triple this compiler was built for, from its own platform flags.
  pub def self.compile_time_triple : String
    {% if flag?(:darwin) %}
      {% if flag?(:aarch64) %} "aarch64-apple-darwin" {% else %} "x86_64-apple-darwin" {% end %}
    {% elsif flag?(:win32) %}
      "x86_64-pc-windows-msvc"
    {% elsif flag?(:aarch64) %}
      "aarch64-unknown-linux-gnu"
    {% else %}
      "x86_64-unknown-linux-gnu"
    {% end %}
  end

  pub def self.host_triple : String
    target = Target.new(compile_time_triple)
    if target.macos?
      if min_version = ENV["MACOSX_DEPLOYMENT_TARGET"]?
        target = Target.new("#{target.architecture}-#{target.vendor}-macosx#{min_version}")
      end
    end
    target.to_s
  end

  pub def self.for_triple(triple : String, defines : Array(String)) : Array(String)
    target = Target.new(triple)
    flags = PlatformFlags.flags_for_target(target, "")
    defines.each do |define|
      if !flags.includes?(define)
        flags << define
      end
    end
    flags
  end

  # The flags of the host, with the same defines.
  pub def self.host(defines : Array(String)) : Array(String)
    MacroTargetFlags.for_triple(MacroTargetFlags.host_triple, defines)
  end
end
