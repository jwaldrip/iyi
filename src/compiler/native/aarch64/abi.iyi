module compiler/native/aarch64/abi

# The aarch64 calling convention for the native backend (SPEC 2.2, per-target
# ABI rules). The producer has already lowered aggregates the way codegen/abi
# does, so a signature carries coerced aggregates such as [2 x i64] or
# [4 x float]; this module assigns those leaves the way LLVM's AArch64 backend
# does. It is shared by callers and callees, so both sides agree by construction.
#
# Rules implemented:
#   - integer and pointer scalars: x0..x7; floating-point scalars: d0..d7.
#   - an aggregate of at most 16 bytes takes one register per leaf. A homogeneous
#     floating-point aggregate of up to four elements takes d registers.
#   - arguments that do not fit the registers go to the stack in order, each
#     leaf in an 8-byte slot (darwin: the same, and every variadic argument goes
#     to the stack regardless of its type; Linux: variadic arguments are passed
#     like fixed ones).
#   - an sret parameter (attribute "sret" on parameter 0) travels in x8.
#   - a return value is in x0/x1 or d0..d3; an aggregate over 16 bytes is returned
#     through the sret parameter, never in registers.
#
# Refused by name: i128 (the runtime helpers slice owns it), byval, and an
# aggregate argument over 16 bytes, which the producer must pass as a pointer.

import compiler/ir/types::{IrType, TypeKind}
import compiler/ir/layout::{DataLayout}
import compiler/native/aarch64/regs::{integer_arg_regs, fp_arg_regs}

# One scalar leaf of an argument or a return value.
pub class LeafLoc
  getter kind : Int32       # 0 gpr, 1 fpr, 2 stack
  getter reg : Int32        # physical register for kinds 0 and 1; -1 for the stack
  getter offset : Int64     # byte offset from sp for kind 2; -1 otherwise
  getter bits : Int32       # the leaf's width in bits
  getter fp : Bool          # the leaf is floating point
  getter leaf_type : IrType

  def initialize(@kind : Int32, @reg : Int32, @offset : Int64, @bits : Int32, @fp : Bool, @leaf_type : IrType)
  end
end

# The assignment of one signature: a list of leaves per argument, in flattened order, and the bytes the
# outgoing stack arguments occupy.
pub class CallAssignment
  getter args : Array(Array(LeafLoc))
  getter stack_bytes : Int64
  getter indirect_result : Bool       # sret: the caller passes the result pointer in x8

  def initialize(@args : Array(Array(LeafLoc)), @stack_bytes : Int64, @indirect_result : Bool)
  end
end

# The flattened scalar leaves of a type, as (byte offset, scalar type). An aggregate's leaves follow its
# layout; padding is skipped. Void has none.
pub def flatten_leaves(layout : DataLayout, t : IrType) : Array({Int64, IrType})
  acc = [] of {Int64, IrType}
  flatten_into(layout, t, 0_i64, acc)
  acc
end

def flatten_into(layout : DataLayout, t : IrType, base : Int64, acc : Array({Int64, IrType})) : Nil
  if t.struct?
    fields = t.struct_element_types
    i = 0
    while i < fields.size
      flatten_into(layout, fields[i], base + layout.offset_of(t, i), acc)
      i = i + 1
    end
    return
  end
  if t.array?
    element = t.element_type
    stride = layout.alloc_size(element)
    n = t.count
    k = 0_i64
    while k < n
      flatten_into(layout, element, base + k * stride, acc)
      k = k + 1_i64
    end
    return
  end
  if t.void?
    return
  end
  acc << {base, t}
end

# Whether an aggregate is a homogeneous floating-point aggregate of one to four elements.
pub def homogeneous_float?(leaves : Array({Int64, IrType})) : Bool
  return false if leaves.empty? || leaves.size > 4
  first = leaves[0][1]
  return false unless first.float?
  leaves.all? { |l| l[1].float? && l[1].bits == first.bits }
end

# Whether a type is an aggregate in this convention's sense.
pub def aggregate?(t : IrType) : Bool
  t.struct? || t.array?
end

# Refuses a type this convention cannot place, and returns the reason.
pub def refusal(t : IrType) : String?
  if t.int? && t.bits == 128
    return "i128 values are not lowered in this slice: they await the runtime helpers slice"
  end
  nil
end

# The register class of one leaf: fp for a float scalar.
pub def leaf_is_fp?(t : IrType) : Bool
  t.float?
end

# Assigns every argument of a call. `fixed` is the count of named parameters; the rest are variadic. `darwin`
# selects the Apple variant, whose variadic arguments all go on the stack. `sret_first` says parameter 0 is
# the indirect result pointer.
pub def assign_call(layout : DataLayout, params : Array(IrType), fixed : Int32, darwin : Bool, sret_first : Bool) : CallAssignment | String
  gpr_next = 0
  fpr_next = 0
  stack = 0_i64
  args = [] of Array(LeafLoc)
  indirect = false
  i = 0
  while i < params.size
    t = params[i]
    reason = refusal(t)
    return reason if reason
    leaves = flatten_leaves(layout, t)
    variadic = i >= fixed
    if i == 0 && sret_first
      indirect = true
      locs = [] of LeafLoc
      locs << LeafLoc.new(0, 8, -1_i64, 64, false, layout_pointer(t))
      args << locs
      i = i + 1
      next
    end
    needs_stack = darwin && variadic
    if !needs_stack
      if t.float?
        if fpr_next < 8
          args << [LeafLoc.new(1, 32 + fpr_next, -1_i64, t.bits, true, t)]
          fpr_next = fpr_next + 1
          i = i + 1
          next
        end
      elsif t.int? || t.pointer?
        if gpr_next < 8
          args << [LeafLoc.new(0, gpr_next, -1_i64, t.int? ? t.bits : 64, false, t)]
          gpr_next = gpr_next + 1
          i = i + 1
          next
        end
      elsif aggregate?(t)
        return "an aggregate argument over 16 bytes must be passed by pointer" if layout.store_size(t) > 16
        if homogeneous_float?(leaves) && fpr_next + leaves.size <= 8
          locs = [] of LeafLoc
          leaves.each do |l|
            locs << LeafLoc.new(1, 32 + fpr_next, -1_i64, l[1].bits, true, l[1])
            fpr_next = fpr_next + 1
          end
          args << locs
          i = i + 1
          next
        end
        if !homogeneous_float?(leaves) && gpr_next + leaves.size <= 8
          locs = [] of LeafLoc
          leaves.each do |l|
            locs << LeafLoc.new(0, gpr_next, -1_i64, l[1].int? ? l[1].bits : 64, false, l[1])
            gpr_next = gpr_next + 1
          end
          args << locs
          i = i + 1
          next
        end
      end
    end
    # The stack: every leaf in an 8-byte slot, in argument order.
    locs = [] of LeafLoc
    leaves.each do |l|
      locs << LeafLoc.new(2, -1, stack, l[1].int? ? l[1].bits : (l[1].float? ? l[1].bits : 64), l[1].float?, l[1])
      stack = stack + 8_i64
    end
    if leaves.empty?
      locs = [] of LeafLoc
    end
    args << locs
    i = i + 1
  end
  CallAssignment.new(args, stack, indirect)
end

# The return convention of a result type: the leaves and their registers, or nil when the result is
# indirect (sret), which the caller reports through `CallAssignment#indirect_result`.
pub def assign_return(layout : DataLayout, t : IrType) : Array(LeafLoc) | String
  return [] of LeafLoc if t.void?
  reason = refusal(t)
  return reason if reason
  if t.float?
    return [LeafLoc.new(1, 32, -1_i64, t.bits, true, t)]
  end
  if t.int? || t.pointer?
    return [LeafLoc.new(0, 0, -1_i64, t.int? ? t.bits : 64, false, t)]
  end
  leaves = flatten_leaves(layout, t)
  return "a result over 16 bytes is returned through sret" if layout.store_size(t) > 16
  acc = [] of LeafLoc
  if homogeneous_float?(leaves)
    k = 0
    leaves.each do |l|
      acc << LeafLoc.new(1, 32 + k, -1_i64, l[1].bits, true, l[1])
      k = k + 1
    end
    return acc
  end
  k = 0
  leaves.each do |l|
    acc << LeafLoc.new(0, k, -1_i64, l[1].int? ? l[1].bits : 64, false, l[1])
    k = k + 1
  end
  acc
end

# Pointer type for an indirect result location; the caller only needs its width.
def layout_pointer(t : IrType) : IrType
  t
end

# The byte offset of a stack slot, rounded up to a multiple of 8.
pub def round8(n : Int64) : Int64
  ((n + 7_i64) // 8_i64) * 8_i64
end
