module compiler/native/aarch64/fold

import compiler/ir/values::{Value, u64_as_i64}
import compiler/ir/inst::{Inst, Op}

# Match the selector's canonical representation of scalar integer and null constants.
pub def integer_constant(v : Value) : Int64?
  return nil unless v.is_a?(Inst)
  c = v.as(Inst)
  return 0_i64 if c.op == Op::ConstNull && c.type.pointer?
  return 0_i64 if c.op == Op::ConstZero && (c.type.int? || c.type.pointer?)
  return nil unless c.op == Op::ConstInt && c.type.int? && c.type.bits <= 64
  value = c.aux_int
  bits = c.type.bits
  return value & 1_i64 if bits == 1
  if bits < 64
    span = 1_i64 << bits
    value = value & (span - 1_i64)
    value = value - span if value >= span // 2_i64
  end
  value
end

# A64 add/sub and compare immediates without a shift. Negative values use the
# opposite operation, provided their magnitude fits the same field.
pub def add_immediate?(value : Int64) : Bool
  value >= -4095_i64 && value <= 4095_i64 # fold-immediate-range
end

# N:immr:imms for any A64 64-bit logical immediate, or nil for an unencodable mask.
# A mask consists of a repeated power-of-two-sized element with one rotated run of ones.
pub def logical_immediate(value : Int64) : Int64?
  size = 2
  while size <= 64
    repeats = true
    i = size
    while i < 64
      if ((value.unsafe_shr(i.to_i64)) & 1_i64) != ((value.unsafe_shr((i % size).to_i64)) & 1_i64)
        repeats = false
        break
      end
      i = i + 1
    end
    if repeats
      ones = 0
      starts = 0
      start = 0
      i = 0
      while i < size
        bit = (value.unsafe_shr(i.to_i64)) & 1_i64
        if bit == 1_i64
          ones = ones + 1
          prev = (value.unsafe_shr(((i + size - 1) % size).to_i64)) & 1_i64
          if prev == 0_i64
            starts = starts + 1
            start = i
          end
        end
        i = i + 1
      end
      if starts == 1 && ones > 0 && ones < size
        n = size == 64 ? 1_i64 : 0_i64
        immr = ((size - start) % size).to_i64
        imms = (((~(size - 1)) << 1) | (ones - 1)) & 63
        return (n << 22) | (immr << 16) | (imms.to_i64 << 10)
      end
    end
    size = size * 2
  end
  nil
end

# Return the sole set bit in the value's declared width, including bit 63.
pub def single_bit(value : Int64, width : Int32) : Int32
  return -1 if width < 1 || width > 64
  found = -1
  i = 0
  while i < width
    if ((value.unsafe_shr(i.to_i64)) & 1_i64) != 0_i64
      return -1 if found >= 0
      found = i
    end
    i = i + 1
  end
  found
end

# Exact unsigned reciprocal division. A zero multiplier denotes a power of two;
# otherwise the quotient is mulhi(n, multiplier), optionally corrected, then shifted.
pub struct DivMagic
  getter multiplier : Int64
  getter shift : Int32
  getter adjust : Bool

  def initialize(@multiplier : Int64, @shift : Int32, @adjust : Bool)
  end
end

pub def division_magic(divisor : UInt64) : DivMagic
  raise "BUG: zero division magic" if divisor == 0_u64
  shift = 0
  high = divisor
  while high > 1_u64
    high = high.unsafe_shr(1_i64)
    shift = shift + 1
  end
  if (divisor & (divisor &- 1_u64)) == 0_u64
    return DivMagic.new(0_i64, shift, false)
  end
  # Divide the 128-bit number 2^(64+shift) by divisor without requiring
  # 128-bit operations in the self-hosted compiler.
  remainder = 1_u64.unsafe_shl(shift.to_i64)
  quotient = 0_u64
  bit = 63
  while bit >= 0
    carry = remainder.unsafe_shr(63_i64)
    remainder = remainder &+ remainder
    if carry != 0_u64 || remainder >= divisor
      remainder = remainder &- divisor
      quotient = quotient | 1_u64.unsafe_shl(bit.to_i64)
    end
    bit = bit - 1
  end
  adjust = false
  if divisor &- remainder >= 1_u64.unsafe_shl(shift.to_i64)
    quotient = quotient &+ quotient
    doubled = remainder &+ remainder
    quotient = quotient &+ 1_u64 if doubled >= divisor || doubled < remainder
    adjust = true
  end
  multiplier = quotient &+ 1_u64 # division-magic
  DivMagic.new(u64_as_i64(multiplier), shift, adjust)
end
