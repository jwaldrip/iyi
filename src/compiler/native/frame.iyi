module compiler/native/frame

# Frame layout and the prologue and epilogue (SPEC 2.2 step 5).
#
# The frame record is pushed first: `stp x29, x30, [sp, #-16]!` and `x29 <- sp`, so
# the frame pointer always names the record and darwin's backtrace walks it. Below
# the record, sp moves down by the frame size. Every offset is from the final sp:
#
#   sp + 0 ............ outgoing argument area (the call's stack arguments)
#   sp + saves ........ one 8-byte save per pinned callee-saved register
#   sp + slots ........ allocas and spill slots, each at its alignment
#
# A frame over a page is entered page by page: each page is moved over and then
# touched with `str xzr`, from the top down, before anything is written into it
# (the stack-probe rule, SPEC 2.2 step 5; the touch is inline on every target). Each
# epilogue restores the saves, releases the frame and pops the record.

import compiler/native/mir::{MFunction, MBlock, MInst, MOp, Operand, OperandKind, Role}
import compiler/native/target::{new_inst, is_role?, isa_aarch64}
import compiler/native/aarch64/regs::{fp_reg, lr_reg, is_fpr?, callee_saved_gprs, callee_saved_fprs}

def round_up(n : Int64, to : Int64) : Int64
  ((n + to - 1_i64) // to) * to
end

# Stack-argument loads use the frame pointer. Inline assembly and physical
# callee-saved or stack-register operands also retain the established frame.
def frameless_leaf?(fn : MFunction) : Bool
  f = fn.frame
  return false if fn.naked || f.has_calls || f.outgoing_bytes != 0_i64
  return false unless f.slots.empty? # frameless-no-slots
  return false unless f.callee_saved.empty?
  saved = callee_saved_gprs + callee_saved_fprs
  fn.blocks.each do |block|
    block.insts.each do |inst|
      return false if inst.call || !inst.asm.nil?
      inst.uses.each do |op|
        if op.kind == OperandKind::Physical
          return false if op.reg == fp_reg || op.reg == lr_reg || op.reg == 31 || saved.includes?(op.reg)
        end
      end
      inst.defs.each do |op|
        if op.kind == OperandKind::Physical
          return false if op.reg == fp_reg || op.reg == lr_reg || op.reg == 31 || saved.includes?(op.reg)
        end
      end
    end
  end
  true
end

# Lays acc the frame, then inserts the prologue at the start of the entry block and an epilogue before every return.
pub def lay_out(fn : MFunction, stack_align : Int64) : Nil
  f = fn.frame
  # Physical definitions include explicit inline-assembly clobbers as well as
  # allocator homes. Preserve every callee-saved floating register they write.
  fp_saves = callee_saved_fprs
  written = [] of Int32
  fn.blocks.each do |block|
    block.insts.each do |inst|
      inst.defs.each do |op|
        if op.kind == OperandKind::Physical && fp_saves.includes?(op.reg) && !written.includes?(op.reg)
          written << op.reg
        end
      end
    end
  end
  fp_saves.each do |reg|
    f.callee_saved << reg if written.includes?(reg) && !f.callee_saved.includes?(reg)
  end
  # The physical numbering puts GPRs before FPRs. Sorting changes only each
  # register's slot in the save area, not the area's size or position.
  if fn.isa == isa_aarch64
    i = 1
    while i < f.callee_saved.size
      reg = f.callee_saved[i]
      j = i
      while j > 0 && f.callee_saved[j - 1] > reg
        f.callee_saved[j] = f.callee_saved[j - 1]
        j = j - 1
      end
      f.callee_saved[j] = reg
      i = i + 1
    end
  end
  offset = round_up(f.outgoing_bytes, 8_i64)
  f.saves_offset = offset
  offset = offset + 8_i64 * f.callee_saved.size.to_i64
  f.offsets = [] of Int64
  f.slots.each do |slot|
    align = slot[1].to_i64
    offset = round_up(offset, align)
    f.offsets << offset
    offset = offset + slot[0]
  end
  f.frame_size = round_up(offset, stack_align)
  return if frameless_leaf?(fn)
  insert_prologue(fn)
  fn.blocks.each do |block|
    insert_epilogues(fn, block)
  end
end

def sp_adjust(isa : Int32, insts : Array(MInst), by : Int64) : Nil
  m = new_inst(isa, Role::Adjust)
  m.imm = by
  insts << m
end

# Odd, out-of-range and equal-register neighbours stay single. Pin can
# record a register twice; both slots hold its entry value, so a later
# duplicate may pair with a different neighbour and either restore is safe.
def pairs_with_next?(fn : MFunction, i : Int32) : Bool
  f = fn.frame
  fn.isa == isa_aarch64 && i + 1 < f.callee_saved.size &&
    f.callee_saved[i] != f.callee_saved[i + 1] &&
    is_fpr?(f.callee_saved[i]) == is_fpr?(f.callee_saved[i + 1]) &&
    f.saves_offset + 8_i64 * i.to_i64 <= 504_i64
end

# The prologue: the frame record, the frame, the probes, and the saves.
def prologue_insts(fn : MFunction) : Array(MInst)
  f = fn.frame
  acc = [] of MInst
  acc << new_inst(fn.isa, Role::PushRecord)
  acc << new_inst(fn.isa, Role::SetFramePointer)
  remaining = f.frame_size
  while remaining >= 4096_i64
    sp_adjust(fn.isa, acc, -4096_i64)
    acc << new_inst(fn.isa, Role::Probe)
    remaining = remaining - 4096_i64
  end
  if remaining > 0_i64
    sp_adjust(fn.isa, acc, -remaining)
  end
  i = 0
  while i < f.callee_saved.size
    paired = pairs_with_next?(fn, i)
    m = new_inst(fn.isa, Role::SaveReg)
    m.size = 64
    m.fp = is_fpr?(f.callee_saved[i])
    m.imm = f.saves_offset + 8_i64 * i.to_i64
    m.uses << Operand.new(OperandKind::Physical, f.callee_saved[i])
    if paired
      m.opcode = MOp::Stp.value.to_i32
      m.uses << Operand.new(OperandKind::Physical, f.callee_saved[i + 1])
      m.uses << Operand.new(OperandKind::Physical, 31)
    end
    acc << m
    i = i + 1
    i = i + 1 if paired
  end
  acc
end

def insert_prologue(fn : MFunction) : Nil
  entry = fn.blocks[0]
  pro = prologue_insts(fn)
  entry.insts = pro + entry.insts
end

# The epilogue in front of each return: restore the saves, release the frame, pop the record.
def insert_epilogues(fn : MFunction, block : MBlock) : Nil
  f = fn.frame
  acc = [] of MInst
  block.insts.each do |inst|
    if is_role?(fn.isa, inst, Role::Return)
      i = 0
      while i < f.callee_saved.size
        paired = pairs_with_next?(fn, i)
        m = new_inst(fn.isa, Role::RestoreReg)
        m.size = 64
        m.fp = is_fpr?(f.callee_saved[i])
        m.imm = f.saves_offset + 8_i64 * i.to_i64
        m.defs << Operand.new(OperandKind::Physical, f.callee_saved[i])
        if paired
          m.opcode = MOp::Ldp.value.to_i32
          m.defs << Operand.new(OperandKind::Physical, f.callee_saved[i + 1])
          m.uses << Operand.new(OperandKind::Physical, 31)
        end
        acc << m
        i = i + 1
        i = i + 1 if paired
      end
      if f.frame_size > 0_i64
        sp_adjust(fn.isa, acc, f.frame_size)
      end
      acc << new_inst(fn.isa, Role::PopRecord)
    end
    acc << inst
  end
  block.insts = acc
end
