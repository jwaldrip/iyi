module compiler/native/mir_clean

import compiler/native/mir::{MFunction, MInst, MOp, OperandKind, Role}
import compiler/native/target::{is_role?, invert_branch, isa_aarch64}
import std/env::{ENV}

# Both passes share the same switch and reject misspellings rather than silently changing code generation.
def mir_clean_enabled? : Bool
  choice = ENV["IYI_NATIVE_MIR_CLEAN"]?
  return true if choice.nil?
  name = choice.as(String)
  return true if name == "1"
  return false if name == "0"
  raise "IYI_NATIVE_MIR_CLEAN is #{name}; the choices are 0 and 1"
end

# Counts every virtual operand, including inline assembly. Positions refer to the original
# instruction order while each block is compacted in place.
pub def fold_result_copies(fn : MFunction) : Int32
  return 0 unless mir_clean_enabled?
  defs = [] of Int32
  uses = [] of Int32
  def_block = [] of Int32
  def_inst = [] of MInst?
  def_pos = [] of Int32
  def_slot = [] of Int32
  last_touch = [] of Int32
  v = 0
  while v < fn.vreg_count
    defs << 0
    uses << 0
    def_block << -1
    def_inst << nil
    def_pos << -1
    def_slot << -1
    last_touch << -1
    v = v + 1
  end

  pos = 0
  b = 0
  while b < fn.blocks.size
    block = fn.blocks[b]
    i = 0
    while i < block.insts.size
      inst = block.insts[i]
      j = 0
      while j < inst.defs.size
        op = inst.defs[j]
        if op.kind == OperandKind::Virtual
          v = op.reg
          defs[v] = defs[v] + 1
          def_block[v] = b
          def_inst[v] = inst
          def_pos[v] = pos
          def_slot[v] = j
        end
        j = j + 1
      end
      j = 0
      while j < inst.uses.size
        op = inst.uses[j]
        uses[op.reg] = uses[op.reg] + 1 if op.kind == OperandKind::Virtual
        j = j + 1
      end
      pos = pos + 1
      i = i + 1
    end
    b = b + 1
  end

  removed = 0
  pos = 0
  b = 0
  while b < fn.blocks.size
    block = fn.blocks[b]
    kept = 0
    i = 0
    while i < block.insts.size
      inst = block.insts[i]
      folded = false
      if is_role?(fn.isa, inst, Role::Copy) && inst.defs.size == 1 && inst.uses.size == 1
        dst = inst.defs[0]
        src = inst.uses[0]
        if dst.kind == OperandKind::Virtual && src.kind == OperandKind::Virtual
          d = dst.reg
          s = src.reg
          if fn.vreg_classes[d] == fn.vreg_classes[s] && defs[s] == 1 && uses[s] == 1 && defs[d] == 1 && def_block[s] == b && def_pos[s] < pos && last_touch[d] <= def_pos[s]
            producer = def_inst[s].as(MInst)
            if producer.asm.nil?
              producer.defs[def_slot[s]] = dst # fold-result-rename
              fn.vreg_pointer[d] = fn.vreg_pointer[d] || fn.vreg_pointer[s]
              def_block[d] = b
              def_inst[d] = producer
              def_pos[d] = def_pos[s]
              def_slot[d] = def_slot[s]
              last_touch[d] = def_pos[s]
              defs[s] = 0
              uses[s] = 0
              removed = removed + 1
              folded = true
            end
          end
        end
      end
      unless folded
        block.insts[kept] = inst if kept != i
        kept = kept + 1
        j = 0
        while j < inst.uses.size
          op = inst.uses[j]
          last_touch[op.reg] = pos if op.kind == OperandKind::Virtual
          j = j + 1
        end
        j = 0
        while j < inst.defs.size
          op = inst.defs[j]
          last_touch[op.reg] = pos if op.kind == OperandKind::Virtual
          j = j + 1
        end
      end
      pos = pos + 1
      i = i + 1
    end
    while block.insts.size > kept
      block.insts.pop
    end
    b = b + 1
  end
  removed
end

# Only these comparisons have the same flag-setting semantics when repeated.
def repeated_compare_candidate?(inst : MInst) : Bool
  op = inst.opcode
  count = 0
  if op == MOp::Cmp.value.to_i32 || op == MOp::FCmp.value.to_i32
    count = 2
  elsif op == MOp::CmpImm.value.to_i32 || op == MOp::CmnImm.value.to_i32
    count = 1
  else
    return false
  end
  return false unless inst.uses.size == count && inst.defs.empty? && inst.clobbers.empty?
  return false if inst.call || inst.terminator || !inst.asm.nil?
  inst.uses.each { |operand| return false unless operand.kind == OperandKind::Physical }
  true
end

def same_compare?(first : MInst, second : MInst) : Bool
  return false unless first.opcode == second.opcode && first.size == second.size &&
                      first.fp == second.fp && first.imm == second.imm &&
                      first.uses.size == second.uses.size
  i = 0
  while i < first.uses.size
    return false unless first.uses[i].reg == second.uses[i].reg
    i = i + 1
  end
  true
end

# After allocation, a comparison remains valid only along this block's
# fallthrough path. Unknown instructions, including pseudo-ops, are barriers.
def elide_repeated_compares(fn : MFunction) : Int32
  return 0 unless fn.isa == isa_aarch64
  removed = 0
  fn.blocks.each do |block|
    previous = nil.as(MInst?)
    kept = 0
    block.insts.each do |inst|
      if repeated_compare_candidate?(inst)
        if !previous.nil? && same_compare?(previous.as(MInst), inst)
          removed = removed + 1
          next
        end
        previous = inst
      elsif (inst.opcode != MOp::Bcond.value.to_i32 &&
             inst.opcode != MOp::Cbz.value.to_i32 && inst.opcode != MOp::Cbnz.value.to_i32 &&
             inst.opcode != MOp::Tbz.value.to_i32 && inst.opcode != MOp::Tbnz.value.to_i32) ||
            !inst.defs.empty? || !inst.clobbers.empty? || inst.call || !inst.asm.nil? # l1-compare-barrier
        previous = nil
      end
      block.insts[kept] = inst
      kept = kept + 1
    end
    while block.insts.size > kept
      block.insts.pop
    end
  end
  removed
end

# A table branch owns inline data. Unknown terminators and pseudo-operations
# cannot be used as fallthrough entries, even when their block is adjacent.
def known_fallthrough_entry?(inst : MInst) : Bool
  op = inst.opcode
  return false if op < MOp::Mov.value.to_i32 || op > MOp::SubsImm.value.to_i32
  return false if op == MOp::BrTable.value.to_i32 || op == MOp::AddrTable.value.to_i32 ||
                  op == MOp::InlineAsm.value.to_i32 || op == MOp::Br.value.to_i32 ||
                  op == MOp::Brk.value.to_i32
  if inst.terminator
    return true if op == MOp::B.value.to_i32 || op == MOp::Bcond.value.to_i32 ||
                   op == MOp::Cbz.value.to_i32 || op == MOp::Cbnz.value.to_i32 ||
                   op == MOp::Tbz.value.to_i32 || op == MOp::Tbnz.value.to_i32 ||
                   op == MOp::Ret.value.to_i32
    return false
  end
  true
end

# Block indices follow emission order. Empty blocks share the next instruction's
# address; a non-empty block is always a barrier, even if it is a pseudo-op.
pub def elide_fallthrough(fn : MFunction) : Int32
  return 0 unless mir_clean_enabled?
  removed = 0
  next_nonempty = -1
  b = fn.blocks.size - 1
  while b >= 0
    block = fn.blocks[b]
    n = block.insts.size
    if n > 0 && b + 1 < fn.blocks.size
      last_fallthrough = next_nonempty < 0 ? b + 1 : next_nonempty
      if next_nonempty >= 0 && !known_fallthrough_entry?(fn.blocks[next_nonempty].insts[0])
        last_fallthrough = b
      end
      tail = block.insts[n - 1]
      if is_role?(fn.isa, tail, Role::Branch)
        if tail.target > b && tail.target <= last_fallthrough # fallthrough-branch
          block.insts.pop
          removed = removed + 1
        elsif n > 1
          cond = block.insts[n - 2]
          if is_role?(fn.isa, cond, Role::CondBranch) && cond.target > b &&
             cond.target <= last_fallthrough && invert_branch(fn.isa, cond)
            cond.target = tail.target
            block.insts.pop
            removed = removed + 1
          end
        end
      end
      n = block.insts.size
      if n > 0
        tail = block.insts[n - 1]
        if is_role?(fn.isa, tail, Role::CondBranch) &&
           tail.target > b && tail.target <= last_fallthrough
          block.insts.pop
          removed = removed + 1
        end
      end
    end
    next_nonempty = b unless block.insts.empty?
    b = b - 1
  end
  removed + elide_repeated_compares(fn)
end
