module compiler/native/rt/builtins_text

# GENERATED from builtins.ir by bench/lib/gen_runtime.py: do not edit by hand.
# The native runtime's IR text, one array element per line, so the compiler needs no file at run time.

pub def builtins_ir : String
  lines = [] of String
  lines << "; iyi-ir 1"
  lines << "source_filename = \"builtins\""
  lines << "target triple = \"aarch64-apple-darwin\""
  lines << "target datalayout = \"e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32\""
  lines << ""
  lines << "; The native runtime helpers (SPEC 3.7). The backend calls them, with the C convention, for a copy or a fill it"
  lines << "; does not inline and for every 128-bit division or remainder. They are written here in IR and linked into every"
  lines << "; native program by the driver. Division by zero gives 0 for both the quotient and the remainder; the hosted"
  lines << "; compiler's LLVM leaves that case undefined, and the native runtime does not trap."
  lines << ""
  lines << "; memcpy: 8 bytes at a time, then the tail a byte at a time. The regions must not overlap."
  lines << "define void @__iyi_native_memcpy(ptr %dst, ptr %src, i64 %n) {"
  lines << "entry:"
  lines << "  %words = and i64 %n, -8"
  lines << "  br label %wh"
  lines << "wh:"
  lines << "  %wi = phi i64 [ 0, label %entry ], [ %wi2, label %wbody ]"
  lines << "  %wmore = icmp ult i64 %wi, %words"
  lines << "  br i1 %wmore, label %wbody, label %bh"
  lines << "wbody:"
  lines << "  %wsp = getelementptr i8, ptr %src, i64 %wi"
  lines << "  %wdp = getelementptr i8, ptr %dst, i64 %wi"
  lines << "  %wv = load i64, ptr %wsp, align 1"
  lines << "  store i64 %wv, ptr %wdp, align 1"
  lines << "  %wi2 = add i64 %wi, 8"
  lines << "  br label %wh"
  lines << "bh:"
  lines << "  %bi = phi i64 [ %wi, label %wh ], [ %bi2, label %bbody ]"
  lines << "  %bmore = icmp ult i64 %bi, %n"
  lines << "  br i1 %bmore, label %bbody, label %bdone"
  lines << "bbody:"
  lines << "  %bsp = getelementptr i8, ptr %src, i64 %bi"
  lines << "  %bdp = getelementptr i8, ptr %dst, i64 %bi"
  lines << "  %bv = load i8, ptr %bsp, align 1"
  lines << "  store i8 %bv, ptr %bdp, align 1"
  lines << "  %bi2 = add i64 %bi, 1"
  lines << "  br label %bh"
  lines << "bdone:"
  lines << "  ret void"
  lines << "}"
  lines << ""
  lines << "; memmove: the forward copy when dst is not inside [src, src + n), which is the memcpy above, and a backward byte"
  lines << "; copy otherwise, so every byte is read before it is overwritten in both directions."
  lines << "define void @__iyi_native_memmove(ptr %dst, ptr %src, i64 %n) {"
  lines << "entry:"
  lines << "  %d = ptrtoint ptr %dst to i64"
  lines << "  %s = ptrtoint ptr %src to i64"
  lines << "  %end = add i64 %s, %n"
  lines << "  %before = icmp ule i64 %d, %s"
  lines << "  br i1 %before, label %forward, label %check"
  lines << "check:"
  lines << "  %past = icmp uge i64 %d, %end"
  lines << "  br i1 %past, label %forward, label %backward"
  lines << "forward:"
  lines << "  call void (ptr, ptr, i64) @__iyi_native_memcpy(ptr %dst, ptr %src, i64 %n)"
  lines << "  ret void"
  lines << "backward:"
  lines << "  br label %kh"
  lines << "kh:"
  lines << "  %k = phi i64 [ %n, label %backward ], [ %k2, label %kbody ]"
  lines << "  %kmore = icmp ne i64 %k, 0"
  lines << "  br i1 %kmore, label %kbody, label %kdone"
  lines << "kbody:"
  lines << "  %k2 = sub i64 %k, 1"
  lines << "  %ksp = getelementptr i8, ptr %src, i64 %k2"
  lines << "  %kdp = getelementptr i8, ptr %dst, i64 %k2"
  lines << "  %kv = load i8, ptr %ksp, align 1"
  lines << "  store i8 %kv, ptr %kdp, align 1"
  lines << "  br label %kh"
  lines << "kdone:"
  lines << "  ret void"
  lines << "}"
  lines << ""
  lines << "; memset: the low byte of the value, stored n times."
  lines << "define void @__iyi_native_memset(ptr %dst, i64 %value, i64 %n) {"
  lines << "entry:"
  lines << "  %byte = trunc i64 %value to i8"
  lines << "  br label %sh"
  lines << "sh:"
  lines << "  %si = phi i64 [ 0, label %entry ], [ %si2, label %sbody ]"
  lines << "  %smore = icmp ult i64 %si, %n"
  lines << "  br i1 %smore, label %sbody, label %sdone"
  lines << "sbody:"
  lines << "  %sp = getelementptr i8, ptr %dst, i64 %si"
  lines << "  store i8 %byte, ptr %sp, align 1"
  lines << "  %si2 = add i64 %si, 1"
  lines << "  br label %sh"
  lines << "sdone:"
  lines << "  ret void"
  lines << "}"
  lines << ""
  lines << "; Unsigned 128-bit division by restoring shift and subtract, from bit 127 down to bit 0. The result is the quotient"
  lines << "; when want is 0 and the remainder otherwise."
  lines << "define internal i128 @iyi_native_udivmod(i128 %a, i128 %b, i128 %want) {"
  lines << "entry:"
  lines << "  %bz = icmp eq i128 %b, 0"
  lines << "  %wr = icmp ne i128 %want, 0"
  lines << "  br i1 %bz, label %zero, label %head"
  lines << "zero:"
  lines << "  ret i128 0"
  lines << "head:"
  lines << "  %i = phi i128 [ 127, label %entry ], [ %i2, label %body ]"
  lines << "  %q = phi i128 [ 0, label %entry ], [ %q2, label %body ]"
  lines << "  %r = phi i128 [ 0, label %entry ], [ %r2, label %body ]"
  lines << "  %more = icmp sge i128 %i, 0"
  lines << "  br i1 %more, label %body, label %exit"
  lines << "body:"
  lines << "  %sh = lshr i128 %a, %i"
  lines << "  %bit = and i128 %sh, 1"
  lines << "  %r1 = shl i128 %r, 1"
  lines << "  %r1b = or i128 %r1, %bit"
  lines << "  %ge = icmp uge i128 %r1b, %b"
  lines << "  %rs = sub i128 %r1b, %b"
  lines << "  %r2 = select i1 %ge, i128 %rs, i128 %r1b"
  lines << "  %qb = shl i128 1, %i"
  lines << "  %qo = or i128 %q, %qb"
  lines << "  %q2 = select i1 %ge, i128 %qo, i128 %q"
  lines << "  %i2 = sub i128 %i, 1"
  lines << "  br label %head"
  lines << "exit:"
  lines << "  %out = select i1 %wr, i128 %r, i128 %q"
  lines << "  ret i128 %out"
  lines << "}"
  lines << ""
  lines << "; Signed 128-bit division on the magnitudes. The quotient is negative when the signs differ; the remainder takes the"
  lines << "; sign of the dividend. The signed minimum divided by minus one wraps to the minimum, as two's complement does."
  lines << "define internal i128 @iyi_native_sdivmod(i128 %a, i128 %b, i128 %want) {"
  lines << "entry:"
  lines << "  %an = icmp slt i128 %a, 0"
  lines << "  %na = sub i128 0, %a"
  lines << "  %ua = select i1 %an, i128 %na, i128 %a"
  lines << "  %bn = icmp slt i128 %b, 0"
  lines << "  %nb = sub i128 0, %b"
  lines << "  %ub = select i1 %bn, i128 %nb, i128 %b"
  lines << "  %m = call i128 (i128, i128, i128) @iyi_native_udivmod(i128 %ua, i128 %ub, i128 %want)"
  lines << "  %anz = zext i1 %an to i128"
  lines << "  %bnz = zext i1 %bn to i128"
  lines << "  %xs = xor i128 %anz, %bnz"
  lines << "  %wr = icmp ne i128 %want, 0"
  lines << "  %sg = select i1 %wr, i128 %anz, i128 %xs"
  lines << "  %neg = icmp ne i128 %sg, 0"
  lines << "  %nm = sub i128 0, %m"
  lines << "  %out = select i1 %neg, i128 %nm, i128 %m"
  lines << "  ret i128 %out"
  lines << "}"
  lines << ""
  lines << "define i128 @__iyi_native_divti3(i128 %a, i128 %b) {"
  lines << "entry:"
  lines << "  %r = call i128 (i128, i128, i128) @iyi_native_sdivmod(i128 %a, i128 %b, i128 0)"
  lines << "  ret i128 %r"
  lines << "}"
  lines << ""
  lines << "define i128 @__iyi_native_udivti3(i128 %a, i128 %b) {"
  lines << "entry:"
  lines << "  %r = call i128 (i128, i128, i128) @iyi_native_udivmod(i128 %a, i128 %b, i128 0)"
  lines << "  ret i128 %r"
  lines << "}"
  lines << ""
  lines << "define i128 @__iyi_native_modti3(i128 %a, i128 %b) {"
  lines << "entry:"
  lines << "  %r = call i128 (i128, i128, i128) @iyi_native_sdivmod(i128 %a, i128 %b, i128 1)"
  lines << "  ret i128 %r"
  lines << "}"
  lines << ""
  lines << "define i128 @__iyi_native_umodti3(i128 %a, i128 %b) {"
  lines << "entry:"
  lines << "  %r = call i128 (i128, i128, i128) @iyi_native_udivmod(i128 %a, i128 %b, i128 1)"
  lines << "  ret i128 %r"
  lines << "}"
  lines.join("\n") + "\n"
end
