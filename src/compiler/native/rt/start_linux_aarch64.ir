; iyi-ir 1
source_filename = "start_linux_aarch64"
target triple = "aarch64-linux-gnu"
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i8:8:32-i16:16:32-i64:64-i128:128-n32:64-S128-Fn32"

; The Linux start code of the static-PIE executable (SPEC 2.2 and 3.7, slice D3). The linker lays out the image
; from base 0 and defines the symbols this file reads. `_start` is naked: it takes the initial stack pointer, which
; holds argc, then argv, then a NULL, then envp, and hands it to __iyi_start_c, which sets `environ`, applies the
; relative relocations, makes the RELRO region read-only, maps and fills the main thread's TLS block (variant I:
; tpidr_el0 points at the 16-byte TCB, and the block lies at its alignment above it), calls main, and exits with
; main's result through exit_group.
;
; Absolute symbols the linker defines as constants (__iyi_tls_memsz, __iyi_tls_align) are not read here: the TLS
; size and alignment come from the PT_TLS program header, which sits in the image at __ehdr_start.

declare external i32 @main(i32, ptr)

@environ = global ptr null, align 8
@__ehdr_start = external global i8
@__iyi_rela_start = external global i8
@__iyi_rela_end = external global i8
@__iyi_relro_start = external global i8
@__iyi_relro_end = external global i8
@__iyi_tdata_start = external global i8
@__iyi_tdata_end = external global i8

; The raw system call: number in x8, arguments in x0..x5, result in x0.
define internal i64 @iyi_syscall(i64 %nr, i64 %a0, i64 %a1, i64 %a2, i64 %a3, i64 %a4, i64 %a5) {
entry:
  %r = call i64 (i64, i64, i64, i64, i64, i64, i64) asm sideeffect "svc #0", "={x0},0,{x1},{x2},{x3},{x4},{x5},{x8},~{memory}"(i64 %a0, i64 %a1, i64 %a2, i64 %a3, i64 %a4, i64 %a5, i64 %nr)
  ret i64 %r
}

; exit_group with the status.
define internal void @iyi_exit(i64 %status) {
entry:
  %r = call i64 (i64, i64, i64, i64, i64, i64, i64) @iyi_syscall(i64 94, i64 %status, i64 0, i64 0, i64 0, i64 0, i64 0)
  unreachable
}

; Adds the load base to every word the relative table names. The table holds link-time addresses, and so does each
; word it names, so the base is added to both.
define internal void @iyi_apply_relocations() {
entry:
  %base = ptrtoint ptr @__ehdr_start to i64
  %start = ptrtoint ptr @__iyi_rela_start to i64
  %end = ptrtoint ptr @__iyi_rela_end to i64
  br label %head
head:
  %p = phi i64 [ %start, label %entry ], [ %p2, label %body ]
  %more = icmp ult i64 %p, %end
  br i1 %more, label %body, label %done
body:
  %pp = inttoptr i64 %p to ptr
  %off = load i64, ptr %pp, align 8
  %site = add i64 %off, %base
  %sp = inttoptr i64 %site to ptr
  %w = load i64, ptr %sp, align 8
  %nw = add i64 %w, %base
  store i64 %nw, ptr %sp, align 8
  %p2 = add i64 %p, 8
  br label %head
done:
  ret void
}

; Makes the RELRO region read-only once the relocations are applied (mprotect, PROT_READ).
define internal void @iyi_relro_protect() {
entry:
  %s = ptrtoint ptr @__iyi_relro_start to i64
  %e = ptrtoint ptr @__iyi_relro_end to i64
  %len = sub i64 %e, %s
  %r = call i64 (i64, i64, i64, i64, i64, i64, i64) @iyi_syscall(i64 226, i64 %s, i64 %len, i64 1, i64 0, i64 0, i64 0)
  ret void
}

; Maps the main thread's TLS block and sets tpidr_el0. The PT_TLS header gives the block's size and alignment; its
; image is copied from __iyi_tdata_start to __iyi_tdata_end, and the rest of the block is the zeroed mapping.
define internal void @iyi_setup_tls() {
entry:
  %ehdr = ptrtoint ptr @__ehdr_start to i64
  %phoffp = add i64 %ehdr, 32
  %phoffpp = inttoptr i64 %phoffp to ptr
  %phoff = load i64, ptr %phoffpp, align 8
  %phnump = add i64 %ehdr, 56
  %phnumpp = inttoptr i64 %phnump to ptr
  %phnum16 = load i16, ptr %phnumpp, align 2
  %phnum = zext i16 %phnum16 to i64
  %phdr0 = add i64 %ehdr, %phoff
  br label %loop
loop:
  %i = phi i64 [ 0, label %entry ], [ %i2, label %loopbody ]
  %memsz = phi i64 [ 0, label %entry ], [ %memsz2, label %loopbody ]
  %align = phi i64 [ 1, label %entry ], [ %align2, label %loopbody ]
  %more = icmp ult i64 %i, %phnum
  br i1 %more, label %loopbody, label %found
loopbody:
  %scaled = mul i64 %i, 56
  %ph = add i64 %phdr0, %scaled
  %phpp = inttoptr i64 %ph to ptr
  %type = load i32, ptr %phpp, align 4
  %is_tls = icmp eq i32 %type, 7
  %mempp = add i64 %ph, 40
  %memptr = inttoptr i64 %mempp to ptr
  %mem_here = load i64, ptr %memptr, align 8
  %alpp = add i64 %ph, 48
  %alptr = inttoptr i64 %alpp to ptr
  %al_here = load i64, ptr %alptr, align 8
  %memsz2 = select i1 %is_tls, i64 %mem_here, i64 %memsz
  %align2 = select i1 %is_tls, i64 %al_here, i64 %align
  %i2 = add i64 %i, 1
  br label %loop
found:
  %a1 = sub i64 %align, 1
  %neg = sub i64 0, %align
  %t16x = add i64 16, %a1
  %t16 = and i64 %t16x, %neg
  %region0 = add i64 %t16, %memsz
  %region1 = add i64 %region0, %align
  %regionp = add i64 %region1, 4095
  %size = and i64 %regionp, -4096
  %m = call i64 (i64, i64, i64, i64, i64, i64, i64) @iyi_syscall(i64 222, i64 0, i64 %size, i64 3, i64 34, i64 -1, i64 0)
  %bad = icmp ugt i64 %m, -4096
  br i1 %bad, label %nomem, label %mapped
nomem:
  call void (i64) @iyi_exit(i64 1)
  unreachable
mapped:
  %b0 = add i64 %m, %t16
  %b1 = add i64 %b0, %a1
  %block = and i64 %b1, %neg
  %tp = sub i64 %block, %t16
  %src = ptrtoint ptr @__iyi_tdata_start to i64
  %srce = ptrtoint ptr @__iyi_tdata_end to i64
  %fsz = sub i64 %srce, %src
  br label %copyhead
copyhead:
  %k = phi i64 [ 0, label %mapped ], [ %k2, label %copybody ]
  %kmore = icmp ult i64 %k, %fsz
  br i1 %kmore, label %copybody, label %copydone
copybody:
  %sk = add i64 %src, %k
  %skp = inttoptr i64 %sk to ptr
  %v = load i8, ptr %skp, align 1
  %dk = add i64 %block, %k
  %dkp = inttoptr i64 %dk to ptr
  store i8 %v, ptr %dkp, align 1
  %k2 = add i64 %k, 1
  br label %copyhead
copydone:
  call void (i64) asm sideeffect "msr tpidr_el0, $0", "r,~{memory}"(i64 %tp)
  ret void
}

; The C-side start: argc, argv and envp from the initial stack.
define internal void @__iyi_start_c(ptr %sp) {
entry:
  %argc = load i64, ptr %sp, align 8
  %argv = getelementptr i8, ptr %sp, i64 8
  %n1 = add i64 %argc, 1
  %off = shl i64 %n1, 3
  %envp = getelementptr i8, ptr %argv, i64 %off
  store ptr %envp, ptr @environ, align 8
  call void () @iyi_apply_relocations()
  call void () @iyi_relro_protect()
  call void () @iyi_setup_tls()
  %argc32 = trunc i64 %argc to i32
  %r = call i32 (i32, ptr) @main(i32 %argc32, ptr %argv)
  %st = zext i32 %r to i64
  call void (i64) @iyi_exit(i64 %st)
  unreachable
}

; The entry point. Naked: no prologue may move the stack before the initial pointer is read.
define void @_start() [naked] {
entry:
  call void () asm sideeffect "mov x0, sp; bl __iyi_start_c", "~{x0},~{x30}"()
  unreachable
}
