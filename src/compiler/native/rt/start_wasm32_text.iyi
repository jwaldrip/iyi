module compiler/native/rt/start_wasm32_text

# GENERATED from start_wasm32.ir by bench/native_wasm_gen.py: do not edit by hand.
# The wasm32-wasi runtime's IR text, one array element per line, so the compiler needs no file at run time.

pub def start_wasm32_ir : String
  lines = [] of String
  lines << "; iyi-ir 1"
  lines << "module \"start_wasm32\""
  lines << "target triple = \"wasm32-wasi\""
  lines << "target datalayout = \"e-m:e-p:32:32-p10:8:8-p20:8:8-i64:64-i128:128-n32:64-S128-ni:1:10:20\""
  lines << ""
  lines << "; The wasm32-wasi runtime (SPEC 2.2 row wasm32-wasi; slice D5). It is compiled into every wasm program, beside the"
  lines << "; program's module. `_start` is the WASI command entry: it calls the program's main and exits with its result."
  lines << "; The only imports are wasi_snapshot_preview1 functions, named by their __wasi_ declarations."
  lines << ""
  lines << "declare external i32 @main()"
  lines << "declare external void @__wasi_proc_exit(i32)"
  lines << "declare external i32 @__wasi_fd_write(i32, ptr, i32, ptr)"
  lines << ""
  lines << "define external void @_start() {"
  lines << "entry:"
  lines << "  %r = call i32 () @main()"
  lines << "  call void (i32) @__wasi_proc_exit(i32 %r)"
  lines << "  unreachable"
  lines << "}"
  lines << ""
  lines << "; Writes a signed 64-bit integer and a newline to standard output, in decimal, as the hosted program's puts does."
  lines << "define external void @__iyi_print_i64(i64 %v) {"
  lines << "entry:"
  lines << "  %buf = alloca [33 x i8], align 8"
  lines << "  %iov = alloca [2 x i32], align 8"
  lines << "  %nw = alloca i32, align 4"
  lines << "  %neg = icmp slt i64 %v, 0"
  lines << "  %nv = sub i64 0, %v"
  lines << "  %mag = select i1 %neg, i64 %nv, i64 %v"
  lines << "  %nl = getelementptr [33 x i8], ptr %buf, i32 0, i32 32"
  lines << "  store i8 10, ptr %nl, align 1"
  lines << "  br label %loop"
  lines << "loop:"
  lines << "  %pos = phi i32 [ 31, label %entry ], [ %pos2, label %loop ]"
  lines << "  %cur = phi i64 [ %mag, label %entry ], [ %q, label %loop ]"
  lines << "  %q = udiv i64 %cur, 10"
  lines << "  %rem = urem i64 %cur, 10"
  lines << "  %d = trunc i64 %rem to i8"
  lines << "  %c = add i8 %d, 48"
  lines << "  %p = getelementptr [33 x i8], ptr %buf, i32 0, i32 %pos"
  lines << "  store i8 %c, ptr %p, align 1"
  lines << "  %pos2 = sub i32 %pos, 1"
  lines << "  %more = icmp ne i64 %q, 0"
  lines << "  br i1 %more, label %loop, label %done"
  lines << "done:"
  lines << "  %st1 = add i32 %pos2, 1"
  lines << "  br i1 %neg, label %sign, label %out"
  lines << "sign:"
  lines << "  %sp = getelementptr [33 x i8], ptr %buf, i32 0, i32 %pos2"
  lines << "  store i8 45, ptr %sp, align 1"
  lines << "  br label %out"
  lines << "out:"
  lines << "  %start = phi i32 [ %st1, label %done ], [ %pos2, label %sign ]"
  lines << "  %ps = getelementptr [33 x i8], ptr %buf, i32 0, i32 %start"
  lines << "  store ptr %ps, ptr %iov, align 4"
  lines << "  %lenp = getelementptr i8, ptr %iov, i32 4"
  lines << "  %len0 = sub i32 33, %start"
  lines << "  store i32 %len0, ptr %lenp, align 4"
  lines << "  %w = call i32 (i32, ptr, i32, ptr) @__wasi_fd_write(i32 1, ptr %iov, i32 1, ptr %nw)"
  lines << "  ret void"
  lines << "}"
  lines << ""
  lines << "; Writes n bytes at p to standard output with one fd_write. Unbuffered, so the bytes arrive in printf's order."
  lines << "define internal void @__printf_write(ptr %p, i32 %n) {"
  lines << "entry:"
  lines << "  %iov = alloca [2 x i32], align 8"
  lines << "  %nw = alloca i32, align 4"
  lines << "  store ptr %p, ptr %iov, align 4"
  lines << "  %lenp = getelementptr i8, ptr %iov, i32 4"
  lines << "  store i32 %n, ptr %lenp, align 4"
  lines << "  %w = call i32 (i32, ptr, i32, ptr) @__wasi_fd_write(i32 1, ptr %iov, i32 1, ptr %nw)"
  lines << "  ret void"
  lines << "}"
  lines << ""
  lines << "; The digits of v in base 10 or 16, written into buf[0..32) from the end. Returns the index of the first digit."
  lines << "define internal i32 @__printf_digits(i64 %v, i32 %base, ptr %buf) {"
  lines << "entry:"
  lines << "  %b64 = zext i32 %base to i64"
  lines << "  br label %loop"
  lines << "loop:"
  lines << "  %pos = phi i32 [ 31, label %entry ], [ %pos2, label %loop ]"
  lines << "  %cur = phi i64 [ %v, label %entry ], [ %q, label %loop ]"
  lines << "  %q = udiv i64 %cur, %b64"
  lines << "  %r = urem i64 %cur, %b64"
  lines << "  %ri = trunc i64 %r to i32"
  lines << "  %lt = icmp ult i32 %ri, 10"
  lines << "  %adj = select i1 %lt, i32 48, i32 87"
  lines << "  %ch = add i32 %ri, %adj"
  lines << "  %c8 = trunc i32 %ch to i8"
  lines << "  %p = getelementptr i8, ptr %buf, i32 %pos"
  lines << "  store i8 %c8, ptr %p, align 1"
  lines << "  %pos2 = sub i32 %pos, 1"
  lines << "  %more = icmp ne i64 %q, 0"
  lines << "  br i1 %more, label %loop, label %done"
  lines << "done:"
  lines << "  %start = add i32 %pos2, 1"
  lines << "  ret i32 %start"
  lines << "}"
  lines << ""
  lines << "; The length of the NUL-terminated string at s."
  lines << "define internal i32 @__printf_strlen(ptr %s) {"
  lines << "entry:"
  lines << "  br label %loop"
  lines << "loop:"
  lines << "  %n = phi i32 [ 0, label %entry ], [ %n2, label %loop ]"
  lines << "  %sp = getelementptr i8, ptr %s, i32 %n"
  lines << "  %c = load i8, ptr %sp, align 1"
  lines << "  %n2 = add i32 %n, 1"
  lines << "  %more = icmp ne i8 %c, 0"
  lines << "  br i1 %more, label %loop, label %done"
  lines << "done:"
  lines << "  ret i32 %n"
  lines << "}"
  lines << ""
  lines << "; One integer conversion. Reads the 8-byte slot at *apos and advances *apos by 8. kind 0 is signed decimal, 1 is"
  lines << "; unsigned decimal, 2 is unsigned hexadecimal. lng 0 reads the low 32 bits of the slot, otherwise all 64."
  lines << "define internal void @__printf_int(ptr %va, ptr %apos, i32 %lng, i32 %kind) {"
  lines << "entry:"
  lines << "  %ibuf = alloca [32 x i8], align 8"
  lines << "  %o = load i32, ptr %apos, align 4"
  lines << "  %slot = getelementptr i8, ptr %va, i32 %o"
  lines << "  %raw = load i64, ptr %slot, align 8"
  lines << "  %o2 = add i32 %o, 8"
  lines << "  store i32 %o2, ptr %apos, align 4"
  lines << "  %t32 = trunc i64 %raw to i32"
  lines << "  %sx = sext i32 %t32 to i64"
  lines << "  %zx = zext i32 %t32 to i64"
  lines << "  %is32 = icmp eq i32 %lng, 0"
  lines << "  %vs = select i1 %is32, i64 %sx, i64 %raw"
  lines << "  %vu = select i1 %is32, i64 %zx, i64 %raw"
  lines << "  %issg = icmp eq i32 %kind, 0"
  lines << "  %v = select i1 %issg, i64 %vs, i64 %vu"
  lines << "  %isneg0 = icmp slt i64 %v, 0"
  lines << "  %neg = and i1 %issg, %isneg0"
  lines << "  %nv = sub i64 0, %v"
  lines << "  %mag = select i1 %neg, i64 %nv, i64 %v"
  lines << "  %ishex = icmp eq i32 %kind, 2"
  lines << "  %base = select i1 %ishex, i32 16, i32 10"
  lines << "  %start = call i32 (i64, i32, ptr) @__printf_digits(i64 %mag, i32 %base, ptr %ibuf)"
  lines << "  br i1 %neg, label %sign, label %nosign"
  lines << "sign:"
  lines << "  %sm1 = sub i32 %start, 1"
  lines << "  %sp = getelementptr i8, ptr %ibuf, i32 %sm1"
  lines << "  store i8 45, ptr %sp, align 1"
  lines << "  br label %emit"
  lines << "nosign:"
  lines << "  br label %emit"
  lines << "emit:"
  lines << "  %from = phi i32 [ %sm1, label %sign ], [ %start, label %nosign ]"
  lines << "  %fp = getelementptr i8, ptr %ibuf, i32 %from"
  lines << "  %len = sub i32 32, %from"
  lines << "  call void (ptr, i32) @__printf_write(ptr %fp, i32 %len)"
  lines << "  ret void"
  lines << "}"
  lines << ""
  lines << "; %g of v, exact or a trap. v must be a dyadic rational (|v| * 2^j is an integer for some j <= 40) whose exact decimal"
  lines << "; has at most six significant digits and a decimal exponent in [-4, 5]. It then prints in fixed notation with trailing"
  lines << "; zeros removed, as C's %g does. Any other value traps rather than print a rounded or exponent-form result."
  lines << "define internal void @__printf_g(double %v) {"
  lines << "entry:"
  lines << "  %ibuf = alloca [32 x i8], align 8"
  lines << "  %lit = alloca [1 x i8], align 1"
  lines << "  %neg = fcmp olt double %v, 0x0000000000000000"
  lines << "  %nv = fsub double 0x0000000000000000, %v"
  lines << "  %av = select i1 %neg, double %nv, double %v"
  lines << "  %iszero = fcmp oeq double %av, 0x0000000000000000"
  lines << "  br i1 %iszero, label %zero, label %findj"
  lines << "zero:"
  lines << "  %vbits = bitcast double %v to i64"
  lines << "  %zneg = icmp slt i64 %vbits, 0"
  lines << "  br i1 %zneg, label %zminus, label %zplus"
  lines << "zminus:"
  lines << "  store i8 45, ptr %lit, align 1"
  lines << "  call void (ptr, i32) @__printf_write(ptr %lit, i32 1)"
  lines << "  br label %zplus"
  lines << "zplus:"
  lines << "  store i8 48, ptr %lit, align 1"
  lines << "  call void (ptr, i32) @__printf_write(ptr %lit, i32 1)"
  lines << "  ret void"
  lines << "findj:"
  lines << "  %j = phi i32 [ 0, label %entry ], [ %j2, label %nextj ]"
  lines << "  %w = phi double [ %av, label %entry ], [ %w2, label %nextj ]"
  lines << "  %lim = fcmp olt double %w, 0x4340000000000000"
  lines << "  br i1 %lim, label %chk, label %trap"
  lines << "chk:"
  lines << "  %wi = fptosi double %w to i64"
  lines << "  %wf = sitofp i64 %wi to double"
  lines << "  %integral = fcmp oeq double %wf, %w"
  lines << "  br i1 %integral, label %found, label %nextj"
  lines << "nextj:"
  lines << "  %j2 = add i32 %j, 1"
  lines << "  %w2 = fmul double %w, 0x4000000000000000"
  lines << "  %more = icmp slt i32 %j2, 41"
  lines << "  br i1 %more, label %findj, label %trap"
  lines << "found:"
  lines << "  %isj0 = icmp eq i32 %j, 0"
  lines << "  br i1 %isj0, label %scale, label %p5loop"
  lines << "p5loop:"
  lines << "  %k = phi i32 [ 0, label %found ], [ %k2, label %p5loop ]"
  lines << "  %p5 = phi i64 [ 1, label %found ], [ %p52, label %p5loop ]"
  lines << "  %p52 = mul i64 %p5, 5"
  lines << "  %k2 = add i32 %k, 1"
  lines << "  %p5more = icmp slt i32 %k2, %j"
  lines << "  br i1 %p5more, label %p5loop, label %scale"
  lines << "scale:"
  lines << "  %pf = phi i64 [ 1, label %found ], [ %p52, label %p5loop ]"
  lines << "  %maxn = udiv i64 9223372036854775807, %pf"
  lines << "  %fits = icmp ule i64 %wi, %maxn"
  lines << "  br i1 %fits, label %scale2, label %trap"
  lines << "scale2:"
  lines << "  %nn = mul i64 %wi, %pf"
  lines << "  br label %strip"
  lines << "strip:"
  lines << "  %sn = phi i64 [ %nn, label %scale2 ], [ %sn2, label %stripdo ]"
  lines << "  %sj = phi i32 [ %j, label %scale2 ], [ %sj2, label %stripdo ]"
  lines << "  %r10 = urem i64 %sn, 10"
  lines << "  %trail = icmp eq i64 %r10, 0"
  lines << "  %hasfrac = icmp sgt i32 %sj, 0"
  lines << "  %dostrip = and i1 %trail, %hasfrac"
  lines << "  br i1 %dostrip, label %stripdo, label %stripped"
  lines << "stripdo:"
  lines << "  %sn2 = udiv i64 %sn, 10"
  lines << "  %sj2 = sub i32 %sj, 1"
  lines << "  br label %strip"
  lines << "stripped:"
  lines << "  %dig = call i32 (i64, i32, ptr) @__printf_digits(i64 %sn, i32 10, ptr %ibuf)"
  lines << "  %len = sub i32 32, %dig"
  lines << "  %lenok = icmp ule i32 %len, 6"
  lines << "  br i1 %lenok, label %expcheck, label %trap"
  lines << "expcheck:"
  lines << "  %x = sub i32 %len, 1"
  lines << "  %xv = sub i32 %x, %sj"
  lines << "  %xhi = icmp sle i32 %xv, 5"
  lines << "  %xlo = icmp sge i32 %xv, -4"
  lines << "  %xok = and i1 %xhi, %xlo"
  lines << "  br i1 %xok, label %emit, label %trap"
  lines << "emit:"
  lines << "  br i1 %neg, label %minus, label %noneg"
  lines << "minus:"
  lines << "  store i8 45, ptr %lit, align 1"
  lines << "  call void (ptr, i32) @__printf_write(ptr %lit, i32 1)"
  lines << "  br label %noneg"
  lines << "noneg:"
  lines << "  %dp = getelementptr i8, ptr %ibuf, i32 %dig"
  lines << "  %wholeq = icmp eq i32 %sj, 0"
  lines << "  br i1 %wholeq, label %whole, label %frac"
  lines << "whole:"
  lines << "  call void (ptr, i32) @__printf_write(ptr %dp, i32 %len)"
  lines << "  ret void"
  lines << "frac:"
  lines << "  %intlen = sub i32 %len, %sj"
  lines << "  %hasint = icmp sgt i32 %intlen, 0"
  lines << "  br i1 %hasint, label %splitint, label %leadzero"
  lines << "splitint:"
  lines << "  call void (ptr, i32) @__printf_write(ptr %dp, i32 %intlen)"
  lines << "  store i8 46, ptr %lit, align 1"
  lines << "  call void (ptr, i32) @__printf_write(ptr %lit, i32 1)"
  lines << "  %fp = getelementptr i8, ptr %dp, i32 %intlen"
  lines << "  call void (ptr, i32) @__printf_write(ptr %fp, i32 %sj)"
  lines << "  ret void"
  lines << "leadzero:"
  lines << "  store i8 48, ptr %lit, align 1"
  lines << "  call void (ptr, i32) @__printf_write(ptr %lit, i32 1)"
  lines << "  store i8 46, ptr %lit, align 1"
  lines << "  call void (ptr, i32) @__printf_write(ptr %lit, i32 1)"
  lines << "  %zeros = sub i32 %sj, %len"
  lines << "  br label %zloop"
  lines << "zloop:"
  lines << "  %zi = phi i32 [ 0, label %leadzero ], [ %zi2, label %zloop ]"
  lines << "  store i8 48, ptr %lit, align 1"
  lines << "  call void (ptr, i32) @__printf_write(ptr %lit, i32 1)"
  lines << "  %zi2 = add i32 %zi, 1"
  lines << "  %zmore = icmp slt i32 %zi2, %zeros"
  lines << "  br i1 %zmore, label %zloop, label %zdone"
  lines << "zdone:"
  lines << "  call void (ptr, i32) @__printf_write(ptr %dp, i32 %len)"
  lines << "  ret void"
  lines << "trap:"
  lines << "  unreachable"
  lines << "}"
  lines << ""
  lines << "; printf(fmt, va): the C printf the test corpus calls. A variadic call stores its arguments in 8-byte slots at va"
  lines << "; (integers sign-extended to 64 bits, pointers zero-extended, floats promoted to double) and passes va last."
  lines << "; Conversions: d i u x s c g %, with the l and ll length modifiers (g is __printf_g: exact, or a trap)."
  lines << "define external i32 @printf(ptr %fmt, ptr %va) {"
  lines << "entry:"
  lines << "  %pp = alloca ptr, align 4"
  lines << "  %apos = alloca i32, align 4"
  lines << "  %off = alloca i32, align 4"
  lines << "  %lng = alloca i32, align 4"
  lines << "  %lit = alloca [1 x i8], align 1"
  lines << "  store ptr %fmt, ptr %pp, align 4"
  lines << "  store i32 0, ptr %apos, align 4"
  lines << "  br label %scan"
  lines << "scan:"
  lines << "  %cp = load ptr, ptr %pp, align 4"
  lines << "  %c0 = load i8, ptr %cp, align 1"
  lines << "  %atend = icmp eq i8 %c0, 0"
  lines << "  br i1 %atend, label %done, label %notend"
  lines << "notend:"
  lines << "  %ispct = icmp eq i8 %c0, 37"
  lines << "  br i1 %ispct, label %spec, label %literal"
  lines << "literal:"
  lines << "  store i8 %c0, ptr %lit, align 1"
  lines << "  call void (ptr, i32) @__printf_write(ptr %lit, i32 1)"
  lines << "  %nlit = getelementptr i8, ptr %cp, i32 1"
  lines << "  store ptr %nlit, ptr %pp, align 4"
  lines << "  br label %scan"
  lines << "spec:"
  lines << "  %a1 = getelementptr i8, ptr %cp, i32 1"
  lines << "  %c1 = load i8, ptr %a1, align 1"
  lines << "  %pct2 = icmp eq i8 %c1, 37"
  lines << "  br i1 %pct2, label %percent, label %lenmod"
  lines << "percent:"
  lines << "  store i8 37, ptr %lit, align 1"
  lines << "  call void (ptr, i32) @__printf_write(ptr %lit, i32 1)"
  lines << "  %npct = getelementptr i8, ptr %cp, i32 2"
  lines << "  store ptr %npct, ptr %pp, align 4"
  lines << "  br label %scan"
  lines << "lenmod:"
  lines << "  store i32 0, ptr %lng, align 4"
  lines << "  store i32 1, ptr %off, align 4"
  lines << "  %isl1 = icmp eq i8 %c1, 108"
  lines << "  br i1 %isl1, label %long1, label %conv"
  lines << "long1:"
  lines << "  store i32 1, ptr %lng, align 4"
  lines << "  store i32 2, ptr %off, align 4"
  lines << "  %a2 = getelementptr i8, ptr %cp, i32 2"
  lines << "  %c2 = load i8, ptr %a2, align 1"
  lines << "  %isl2 = icmp eq i8 %c2, 108"
  lines << "  br i1 %isl2, label %long2, label %conv"
  lines << "long2:"
  lines << "  store i32 2, ptr %lng, align 4"
  lines << "  store i32 3, ptr %off, align 4"
  lines << "  br label %conv"
  lines << "conv:"
  lines << "  %o = load i32, ptr %off, align 4"
  lines << "  %ca = getelementptr i8, ptr %cp, i32 %o"
  lines << "  %cv = load i8, ptr %ca, align 1"
  lines << "  %nexto = add i32 %o, 1"
  lines << "  %nxt = getelementptr i8, ptr %cp, i32 %nexto"
  lines << "  store ptr %nxt, ptr %pp, align 4"
  lines << "  %lv = load i32, ptr %lng, align 4"
  lines << "  %isd = icmp eq i8 %cv, 100"
  lines << "  %isi = icmp eq i8 %cv, 105"
  lines << "  %issd = or i1 %isd, %isi"
  lines << "  br i1 %issd, label %sdec, label %nsd"
  lines << "sdec:"
  lines << "  call void (ptr, ptr, i32, i32) @__printf_int(ptr %va, ptr %apos, i32 %lv, i32 0)"
  lines << "  br label %scan"
  lines << "nsd:"
  lines << "  %isu = icmp eq i8 %cv, 117"
  lines << "  br i1 %isu, label %udec, label %nu"
  lines << "udec:"
  lines << "  call void (ptr, ptr, i32, i32) @__printf_int(ptr %va, ptr %apos, i32 %lv, i32 1)"
  lines << "  br label %scan"
  lines << "nu:"
  lines << "  %isx = icmp eq i8 %cv, 120"
  lines << "  br i1 %isx, label %hex, label %nx"
  lines << "hex:"
  lines << "  call void (ptr, ptr, i32, i32) @__printf_int(ptr %va, ptr %apos, i32 %lv, i32 2)"
  lines << "  br label %scan"
  lines << "nx:"
  lines << "  %iss = icmp eq i8 %cv, 115"
  lines << "  br i1 %iss, label %str, label %ns"
  lines << "str:"
  lines << "  %sa = load i32, ptr %apos, align 4"
  lines << "  %sslot = getelementptr i8, ptr %va, i32 %sa"
  lines << "  %sval = load ptr, ptr %sslot, align 4"
  lines << "  %sa2 = add i32 %sa, 8"
  lines << "  store i32 %sa2, ptr %apos, align 4"
  lines << "  %slen = call i32 (ptr) @__printf_strlen(ptr %sval)"
  lines << "  call void (ptr, i32) @__printf_write(ptr %sval, i32 %slen)"
  lines << "  br label %scan"
  lines << "ns:"
  lines << "  %isc = icmp eq i8 %cv, 99"
  lines << "  br i1 %isc, label %chr, label %ng"
  lines << "chr:"
  lines << "  %ca3 = load i32, ptr %apos, align 4"
  lines << "  %cslot = getelementptr i8, ptr %va, i32 %ca3"
  lines << "  %craw = load i32, ptr %cslot, align 4"
  lines << "  %cbyte = trunc i32 %craw to i8"
  lines << "  store i8 %cbyte, ptr %lit, align 1"
  lines << "  call void (ptr, i32) @__printf_write(ptr %lit, i32 1)"
  lines << "  %ca4 = add i32 %ca3, 8"
  lines << "  store i32 %ca4, ptr %apos, align 4"
  lines << "  br label %scan"
  lines << "ng:"
  lines << "  %isg = icmp eq i8 %cv, 103"
  lines << "  br i1 %isg, label %dbl, label %other"
  lines << "dbl:"
  lines << "  %da = load i32, ptr %apos, align 4"
  lines << "  %dslot = getelementptr i8, ptr %va, i32 %da"
  lines << "  %dval = load double, ptr %dslot, align 8"
  lines << "  %da2 = add i32 %da, 8"
  lines << "  store i32 %da2, ptr %apos, align 4"
  lines << "  call void (double) @__printf_g(double %dval)"
  lines << "  br label %scan"
  lines << "other:"
  lines << "  store i8 %cv, ptr %lit, align 1"
  lines << "  call void (ptr, i32) @__printf_write(ptr %lit, i32 1)"
  lines << "  br label %scan"
  lines << "done:"
  lines << "  ret i32 0"
  lines << "}"
  lines.join("\n") + "\n"
end
