module compiler/native/value_numbers

import compiler/ir/values::{Value}
import compiler/ir/function::{Function}

# Dense, per-function identities for parameters and instructions. The function retains the values themselves;
# the table stores only their object identities and never changes after construction.
pub class ValueNumbers
  getter size : Int32
  getter mask : Int32
  getter keys : Array(UInt64)
  getter numbers : Array(Int32)

  def initialize(fn : Function)
    count = fn.params.size
    fn.blocks.each { |block| count = count + block.insts.size }
    capacity = 2
    while capacity // 2 < count
      capacity = capacity * 2
    end
    @mask = capacity - 1
    @keys = Array(UInt64).new(capacity, 0_u64)
    @numbers = Array(Int32).new(capacity, -1)
    @size = 0
    fn.params.each { |param| add(param) }
    fn.blocks.each do |block|
      block.insts.each { |inst| add(inst) }
    end
  end

  def slot(key : UInt64) : Int32
    hash = key.unsafe_shr(4_u64) ^ key.unsafe_shr(36_u64)
    i = (hash & @mask.to_u64).to_i32
    while @numbers[i] >= 0 && @keys[i] != key
      i = (i + 1) & @mask
    end
    i
  end

  def add(value : Value) : Nil
    key = value.object_id
    i = slot(key)
    if @numbers[i] < 0
      @keys[i] = key
      @numbers[i] = @size
      @size = @size + 1
    end
  end

  # Values outside this function have no number, just as a missing hash key has no binding.
  def number(value : Value) : Int32
    @numbers[slot(value.object_id)]
  end
end
