module compiler/semantic/call

import compiler/syntax/ast::{ASTNode, BoolLiteral, Def, NamedArgument, NilLiteral, NumberLiteral, StringLiteral}
import compiler/semantic/call_nodes::{CallNodes}
import compiler/semantic/call_error::{CallFailure}
import compiler/semantic/top_level::{ModuleType, SemanticProgram, Type}
import compiler/types/type_system::{TypeSystem}
import compiler/types/lookup::{LookupError, TypeLookup}
import compiler/types/types::{NamedArgumentType}
import compiler/semantic/method_lookup::{MethodLookup}
import compiler/semantic/match::{CallSignature, Match}

# The receiver and the argument types of a call: the seed of the port of
# semantic/call.cr. The hosted call pass types an argument from its body, and the
# bodies slice provides that later. Until then an argument is typed only when it
# is a literal, and a receiver only when it is a type path or a call with a
# single match that declares its return type. Anything else is nil, and the
# caller says why. A call node is read through CallNodes, because this module's
# name is `call`.
pub class CallReceiver
  # The type a call's receiver is: the program for a call without one (*obj* is
  # nil), else the receiver's type, or nil when the receiver cannot be typed.
  def self.scope(prog : SemanticProgram, ts : TypeSystem, obj : ASTNode?) : ModuleType?
    return prog if obj.nil?
    receiver_type(prog, ts, obj.as(ASTNode))
  end

  # The type a receiver node names: a call names the instance type of its
  # single match's declared return; a type path names its metaclass, where its
  # class methods are.
  def self.receiver_type(prog : SemanticProgram, ts : TypeSystem, node : ASTNode) : ModuleType?
    if call = CallNodes.as_call(node)
      return return_type_of(prog, ts, call.obj, call.name, call.args, call.named_args, call.block != nil)
    end
    found = TypeLookup.new(ts.instances).lookup(prog, node)
    return nil if found.is_a?(LookupError)
    scoped = found.as(Type)
    return nil if !scoped.is_a?(ModuleType)
    scoped.as(ModuleType).metaclass
  end

  # The instance type of the single match of a call with receiver *obj*, method
  # *name*, positional arguments *args*, named arguments *named_args* and a block
  # when *block* is true, or nil unless the match is unique and declares its
  # return type. The lookup is the hosted one with analyze_all off.
  def self.return_type_of(prog : SemanticProgram, ts : TypeSystem, obj : ASTNode?, name : String, args : Array(ASTNode), named_args : Array(NamedArgument)?, block : Bool) : ModuleType?
    arg_types = [] of Type
    args.each do |arg|
      typed = argument_type(prog, arg)
      return nil if typed.nil?
      arg_types << typed.as(Type)
    end
    typed_named = named_argument_types(prog, named_args)
    return nil if typed_named.nil?
    owner = scope(prog, ts, obj)
    return nil if owner.nil?
    scoped = owner.as(ModuleType)
    signature = CallSignature.new(name, arg_types, typed_named, block)
    matches = MethodLookup.lookup_matches(scoped, ts, signature, scoped, scoped, [] of Match)
    return nil if matches.error
    return nil if matches.matches.size != 1
    single = matches.matches[0]
    ret = single.definition.return_type
    return nil if ret.nil?
    found = TypeLookup.new(ts.instances).lookup(single.defining, ret.as(ASTNode))
    return nil if found.is_a?(LookupError)
    instance = found.as(Type)
    return nil if !instance.is_a?(ModuleType)
    instance.as(ModuleType)
  end

  # The named arguments of a call with their types: an empty list when the call
  # has none, and nil when one of them is not typeable.
  def self.named_argument_types(prog : SemanticProgram, named_args : Array(NamedArgument)?) : Array(NamedArgumentType)?
    typed_list = [] of NamedArgumentType
    return typed_list if named_args.nil?
    named_args.each do |na|
      typed = argument_type(prog, na.value)
      return nil if typed.nil?
      typed_list << NamedArgumentType.new(na.name, typed.as(Type))
    end
    typed_list
  end

  # The type of a literal argument: an integer is Int32, a string String, true
  # or false Bool, and nil Nil. Nil for any other argument.
  def self.argument_type(prog : SemanticProgram, node : ASTNode) : Type?
    if node.is_a?(NumberLiteral)
      return prog.types["Int32"]
    end
    if node.is_a?(StringLiteral)
      return prog.types["String"]
    end
    if node.is_a?(BoolLiteral)
      return prog.types["Bool"]
    end
    if node.is_a?(NilLiteral)
      return prog.types["Nil"]
    end
    nil
  end
end

# The target of a call on a receiver type: the hosted Call#recalculate's result.
# *definition* is the one def the call resolves to, *declared_return* its declared
# return type, and *untyped* says the def declares none, so its type waits on the
# body (the bodies slice). *error* is the first line of the message the hosted
# call pass raises, or a marked refusal for a shape this port does not answer.
pub class CallTarget
  getter definition : Def?
  getter owner : ModuleType?
  getter declared_return : Type?
  getter untyped : Bool
  getter error : String?

  def initialize(@definition : Def?, @owner : ModuleType?, @declared_return : Type?, @untyped : Bool, @error : String?)
  end

  def self.failed(message : String) : CallTarget
    CallTarget.new(nil, nil, nil, false, message)
  end
end

# The port of Call#recalculate for the bodies slice: the call's target on the
# receiver type rec_type, found by the lookup of the call's name, arguments and
# block, as the hosted call pass finds it before it instantiates the body. It is
# the entry the bodies slice's visit(Call) calls where the hosted pass calls
# recalculate, with the receiver first and the hosted names kept. Arguments are
# typed as CallReceiver types them (literals only until the bodies slice types
# them), so an argument it cannot type is refused by name.
pub class CallRecalculation
  def self.recalculate(rec_type : ModuleType, ts : TypeSystem, prog : SemanticProgram, name : String, args : Array(ASTNode), named_args : Array(NamedArgument)?, block : Bool) : CallTarget
    arg_types = [] of Type
    args.each do |arg|
      typed = CallReceiver.argument_type(prog, arg)
      return CallTarget.failed("argument is not a literal") if typed.nil?
      arg_types << typed.as(Type)
    end
    typed_named = CallReceiver.named_argument_types(prog, named_args)
    return CallTarget.failed("argument is not a literal") if typed_named.nil?
    signature = CallSignature.new(name, arg_types, typed_named, block)
    matches = MethodLookup.lookup_matches(rec_type, ts, signature, rec_type, rec_type, [] of Match)
    return CallTarget.failed(matches.error.to_s) if matches.error
    if matches.matches.size > 1
      return CallTarget.failed("not ported: several matches")
    end
    if matches.matches.size == 1
      single = matches.matches[0]
      ret = single.definition.return_type
      if ret.nil?
        return CallTarget.new(single.definition, rec_type, nil, true, nil)
      end
      found = TypeLookup.new(ts.instances).lookup(single.defining, ret.as(ASTNode))
      return CallTarget.failed(found.as(LookupError).message) if found.is_a?(LookupError)
      return CallTarget.new(single.definition, rec_type, found.as(Type), false, nil)
    end
    return CallTarget.failed("not ported: named argument message") if named_args
    defined = MethodLookup.defines?(rec_type, name)
    defs = MethodLookup.all_defs(rec_type, name, [] of Def)
    CallTarget.failed(CallFailure.first_line(rec_type, ts, name, arg_types, defs, defined))
  end
end
