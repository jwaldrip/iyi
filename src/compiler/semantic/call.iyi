module compiler/semantic/call

import compiler/semantic/restrictions::{ArgRestriction}
import compiler/syntax/ast::{ASTNode, BoolLiteral, Def, NamedArgument, NilLiteral, NumberLiteral, Path, StringLiteral, Visibility}
import compiler/semantic/call_nodes::{CallNodes}
import compiler/semantic/call_error::{CallFailure}
import compiler/semantic/top_level::{ModuleType, SemanticProgram, Type}
import compiler/types/type_system::{TypeSystem}
import compiler/types/lookup::{LookupError, TypeLookup}
import compiler/types/types::{GenericClassInstanceType, NamedArgumentType}
import compiler/semantic/method_lookup::{MethodLookup}
import compiler/semantic/match::{CallSignature, Match}

# The receiver and the argument types of a call: the seed of the port of
# semantic/call.cr. The hosted call pass types an argument from its body, and the
# bodies slice provides that later. Until then an argument is typed only when it
# is a literal, and a receiver only when it is a type path or a call with a
# single match that declares its return type. A union return is a union receiver.
#
# A value typed as a class with subclasses is a virtual type in the hosted pass
# only once a body has typed it (`self`, an expression's merged type); a declared
# return keeps the class. The port writes that value as `virtual(T)` in a fixture,
# which is `T+`, the form the bodies slice will produce. Anything else is nil, and
# the caller says why. A call node is read through CallNodes, because this
# module's name is `call`.
pub class CallReceiver
  # The type a call's receiver is: the program for a call without one (*obj* is
  # nil), else the receiver's type, or nil when the receiver cannot be typed.
  def self.scope(prog : SemanticProgram, ts : TypeSystem, obj : ASTNode?) : Type?
    return prog if obj.nil?
    receiver_type(prog, ts, obj.as(ASTNode))
  end

  # The type a receiver node names: `virtual(T)` is T's virtual form; a call names
  # the type of its single match's declared return; a type path names its
  # metaclass, where its class methods are.
  def self.receiver_type(prog : SemanticProgram, ts : TypeSystem, node : ASTNode) : Type?
    if call = CallNodes.as_call(node)
      if call.obj.nil? && call.name == "virtual" && call.args.size == 1
        named = TypeLookup.new(ts.instances).lookup(prog, call.args[0])
        return nil if named.is_a?(LookupError)
        base = named.as(Type)
        return nil if !base.is_a?(ModuleType)
        return MethodLookup.virtual_of(base.as(ModuleType))
      end
      return return_type_of(prog, ts, call.obj, call.name, call.args, call.named_args, call.block != nil)
    end
    found = TypeLookup.new(ts.instances).lookup(prog, node)
    return nil if found.is_a?(LookupError)
    scoped = found.as(Type)
    if scoped.is_a?(GenericClassInstanceType)
      return scoped.as(GenericClassInstanceType).metaclass
    end
    return nil if !scoped.is_a?(ModuleType)
    scoped.as(ModuleType).metaclass
  end

  # The type of the single match of a call with receiver *obj*, method *name*,
  # positional arguments *args*, named arguments *named_args* and a block when
  # *block* is true, or nil unless the match is unique and declares its return
  # type. A receiver that is a union or a virtual type dispatches to every member.
  # The lookup is the hosted one with analyze_all off.
  def self.return_type_of(prog : SemanticProgram, ts : TypeSystem, obj : ASTNode?, name : String, args : Array(ASTNode), named_args : Array(NamedArgument)?, block : Bool) : Type?
    arg_types = [] of Type
    args.each do |arg|
      typed = argument_type(prog, arg)
      return nil if typed.nil?
      arg_types << typed.as(Type)
    end
    typed_named = named_argument_types(prog, named_args)
    return nil if typed_named.nil?
    owner = scope(prog, ts, obj)
    return nil if owner.nil?
    signature = CallSignature.new(name, arg_types, typed_named, block)
    matches = MethodLookup.lookup_receiver(owner.as(Type), ts, signature)
    return nil if matches.error
    return nil if matches.matches.size != 1
    single = matches.matches[0]
    ret = single.definition.return_type
    return nil if ret.nil?
    found = ArgRestriction.lookup_free(ts, single.defining, ret.as(ASTNode), owner, single.bound)
    return nil if found.is_a?(LookupError)
    found.as(Type)
  end

  # The named arguments of a call with their types: an empty list when the call
  # has none, and nil when one of them is not typeable.
  def self.named_argument_types(prog : SemanticProgram, named_args : Array(NamedArgument)?) : Array(NamedArgumentType)?
    typed_list = [] of NamedArgumentType
    return typed_list if named_args.nil?
    named_args.each do |na|
      typed = argument_type(prog, na.value)
      return nil if typed.nil?
      typed_list << NamedArgumentType.new(na.name, typed.as(Type))
    end
    typed_list
  end

  # The type of a literal argument: an integer is Int32, a string String, true
  # or false Bool, and nil Nil. Nil for any other argument.
  def self.argument_type(prog : SemanticProgram, node : ASTNode) : Type?
    if node.is_a?(NumberLiteral)
      return prog.types["Int32"]
    end
    if node.is_a?(StringLiteral)
      return prog.types["String"]
    end
    if node.is_a?(BoolLiteral)
      return prog.types["Bool"]
    end
    if node.is_a?(NilLiteral)
      return prog.types["Nil"]
    end
    if call = CallNodes.as_call(node)
      if call.obj.nil? && call.name == "instance" && call.args.size == 1 && call.args[0].is_a?(Path)
        names = call.args[0].as(Path).names
        if names.size == 1
          t = prog.types[names[0]]?
          return t.as(Type) if t
        end
      end
    end
    nil
  end
end

# The target of a call on a receiver type: the hosted Call#recalculate's result.
# *definition* is the one def the call resolves to, *declared_return* its declared
# return type, and *untyped* says the def declares none, so its type waits on the
# body (the bodies slice). *owner* is the receiver it was found on. *defining* is
# the type the def was found on, which is not the receiver when the method is
# inherited. *error* is the first line of the message the hosted call pass raises,
# or a marked refusal for a shape this port does not answer.
pub class CallTarget
  getter definition : Def?
  getter owner : Type?
  getter defining : ModuleType?
  getter declared_return : Type?
  getter untyped : Bool
  getter error : String?

  def initialize(@definition : Def?, @owner : Type?, @declared_return : Type?, @untyped : Bool, @error : String?, @defining : ModuleType? = nil)
  end

  def self.failed(message : String) : CallTarget
    CallTarget.new(nil, nil, nil, false, message)
  end
end

# The port of Call#recalculate for the bodies slice: the call's target on the
# receiver type rec_type, found by the lookup of the call's name, arguments and
# block, as the hosted call pass finds it before it instantiates the body. It is
# the entry the bodies slice's visit(Call) calls where the hosted pass calls
# recalculate, with the receiver first and the hosted names kept. The receiver
# may be a module type, a virtual type or a union; a receiver with several matches
# is a dispatch, answered as not ported until the bodies slice instantiates
# several targets. Arguments are typed as CallReceiver types them.
pub class CallRecalculation
  def self.recalculate(rec_type : Type, ts : TypeSystem, prog : SemanticProgram, name : String, args : Array(ASTNode), named_args : Array(NamedArgument)?, block : Bool, explicit : Bool = false) : CallTarget
    arg_types = [] of Type
    args.each do |arg|
      typed = CallReceiver.argument_type(prog, arg)
      return CallTarget.failed("argument is not a literal") if typed.nil?
      arg_types << typed.as(Type)
    end
    typed_named = CallReceiver.named_argument_types(prog, named_args)
    return CallTarget.failed("argument is not a literal") if typed_named.nil?
    signature = CallSignature.new(name, arg_types, typed_named, block)
    CallRecalculation.recalculate_signature(rec_type, ts, signature, explicit, args)
  end

  # The port of the hosted Call#recalculate for a call whose arguments are already
  # typed: the receiver's lookup_matches of *signature* (the hosted lookup with
  # analyze_all off), then the numeric autocast retry when *arg_nodes* are given,
  # the one target's declared return type, and the first line of the error the
  # hosted pass raises when it finds no target. `recalculate` types literal
  # arguments and calls this; the bodies slice calls this directly with the
  # argument types its own pass has typed, and passes the argument nodes so a
  # number literal can match a wider integer.
  def self.recalculate_signature(rec_type : Type, ts : TypeSystem, signature : CallSignature, explicit : Bool, arg_nodes : Array(ASTNode)? = nil) : CallTarget
    name = signature.name
    arg_types = signature.arg_types
    matches = MethodLookup.lookup_with_autocast(rec_type, ts, signature, arg_nodes)
    return CallTarget.failed(matches.error.to_s) if matches.error
    if matches.matches.size > 1
      return CallTarget.failed("not ported: several matches")
    end
    if matches.matches.size == 1
      single = matches.matches[0]
      if explicit && single.definition.visibility == Visibility::Private
        return CallTarget.failed("private method '#{name}' called for #{rec_type.to_s}")
      end
      ret = single.definition.return_type
      if ret.nil?
        return CallTarget.new(single.definition, rec_type, nil, true, nil, single.defining)
      end
      found = ArgRestriction.lookup_free(ts, single.defining, ret.as(ASTNode), rec_type, single.bound)
      return CallTarget.failed(found.as(LookupError).message) if found.is_a?(LookupError)
      return CallTarget.new(single.definition, rec_type, found.as(Type), false, nil, single.defining)
    end
    named = signature.named_args
    if named
      return CallTarget.failed("not ported: named argument message") if !named.empty?
    end
    if !rec_type.is_a?(ModuleType)
      return CallTarget.failed("not ported: virtual or union receiver message")
    end
    module_type = rec_type.as(ModuleType)
    defined = MethodLookup.defines?(module_type, name)
    defs = MethodLookup.all_defs(module_type, name, [] of Def)
    CallTarget.failed(CallFailure.first_line(module_type, ts, name, arg_types, defs, defined))
  end
end
