module compiler/semantic/call_error

import compiler/syntax/ast::{Def}
import compiler/semantic/top_level::{MetaclassType, ModuleType, SemanticProgram}

# The messages the hosted call pass raises when a call has no match, first line
# only (the oracle compares first lines).
#
# Ported: "undefined method" (raise_undefined_method in call_error.cr), which the
# hosted pass reaches when no def of the name exists on the receiver or its
# parents; and "wrong number of arguments for <name> (given N, expected M)"
# (raise_matches_not_found_named_args), which it reaches when every def of the
# name takes some other number of positional arguments.
#
# Not yet ported, and refused by the driver rather than answered: "no overload
# matches", whose first line comes from compute_call_error_reason and the
# argument-type checks, and every message for named or splat arguments.
pub class CallError
  # The first line of the undefined-method error for *name* on *owner*. The
  # program's own calls name their owner "top-level"; a metaclass prints Foo.class.
  def self.undefined_method(owner : ModuleType, name : String) : String
    owner_name = owner.is_a?(SemanticProgram) ? "top-level" : owner.to_s
    "undefined method '#{name}' for #{owner_name}"
  end

  # The name a message gives a method: Owner#name for an instance, Owner.name for
  # a metaclass, and the bare name for the program's own defs (hosted Call.full_name).
  def self.full_name(owner : ModuleType, name : String) : String
    return name if owner.is_a?(SemanticProgram)
    if owner.is_a?(MetaclassType)
      return "#{owner.as(MetaclassType).instance_type.to_s}.#{name}"
    end
    "#{owner.to_s}##{name}"
  end

  # The number of positional parameters a def must be given: those without a default.
  def self.required(d : Def) : Int32
    count = 0
    d.args.each do |arg|
      count += 1 if arg.default_value.nil?
    end
    count
  end

  # The first line of the wrong-number-of-arguments error for *name* on *owner*
  # given *given* positional arguments, when every def in *defs* takes some other
  # number of arguments. Nil when some def takes this many, or when there are none.
  def self.wrong_number(owner : ModuleType, name : String, given : Int32, defs : Array(Def)) : String?
    return nil if defs.empty?
    top = 0
    defs.each do |d|
      return nil if given >= required(d) && given <= d.args.size
      top = d.args.size if d.args.size > top
    end
    sizes = [] of Int32
    i = 0
    while i <= top
      takes = false
      defs.each do |d|
        takes = true if i >= required(d) && i <= d.args.size
      end
      sizes << i if takes
      i += 1
    end
    expected = expected_text(sizes)
    "wrong number of arguments for '#{full_name(owner, name)}' (given #{given}, expected #{expected})"
  end

  # The sizes as the hosted message writes them: a run of consecutive sizes as
  # first..last, anything else as a list.
  def self.expected_text(sizes : Array(Int32)) : String
    if sizes.size > 1 && sizes[sizes.size - 1] - sizes[0] == sizes.size - 1
      return "#{sizes[0]}..#{sizes[sizes.size - 1]}"
    end
    parts = [] of String
    sizes.each do |size|
      parts << size.to_s
    end
    parts.join(", ")
  end
end
