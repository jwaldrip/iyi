module compiler/semantic/inline_macros

import compiler/syntax/ast::{ASTNode, Assign, Block, Call, ClassDef, Def, Expressions, FunDef, LibDef, Macro, MacroExpression, MacroFor, MacroIf, ModuleDef, MultiAssign, NodeMap, Path, ProcLiteral, TypeDeclaration, UninitializedVar, Var}
import compiler/syntax/parser::{Parser}
import compiler/semantic/normalizer::{Normalizer, NormalizerProgram}
import compiler/syntax/visitor::{Visitor}
import compiler/macros/engine::{MacroEngine}
import compiler/macros/interpreter::{MacroFailure, MacroFreeBinding}
import compiler/macros/type_facts::{MacroTypeFacts}
import compiler/foundation/location::{Location}
import compiler/foundation/errors::{refuse_port}

# One inline macro site the declarations pass visited: the file it is written in,
# its kind and place, and why the engine refused it (nil when it expanded, an empty
# expansion included). The gate prints these, so a refused site is counted and
# never dropped.
pub class InlineMacroSite
  property file : String
  property kind : String
  property line : Int32
  property column : Int32
  property reason : String?

  def initialize(@file : String, @kind : String, @line : Int32, @column : Int32, @reason : String?)
  end
end

# Every inline macro site, in visiting order. A declaration-time failure is
# keyed by node so body typing cannot retry it with later declarations in scope.
pub class InlineMacroLedger
  @@sites = [] of InlineMacroSite
  @@no_sites = [] of InlineMacroSite
  @@declaration_failures = NodeMap(InlineMacroSite).new

  def self.sites(node : ASTNode? = nil) : Array(InlineMacroSite)
    if node
      if failed = @@declaration_failures[node]?
        return [failed] of InlineMacroSite
      end
      return @@no_sites
    end
    @@sites
  end

  def self.record(site : InlineMacroSite, node : ASTNode? = nil) : Nil
    @@sites << site
    if node && site.reason
      @@declaration_failures[node] = site
    end
    nil
  end

  def self.reset : Nil
    @@sites = [] of InlineMacroSite
    @@declaration_failures = NodeMap(InlineMacroSite).new
    nil
  end
end

# Expands one inline macro site (`{% if %}`, `{% for %}` or `{{ }}` at the top
# level, in a type body or in a `lib` body) as the hosted pass expands it: with a
# fresh interpreter that names `scope_name` for `@type` and `@top_level`, the output
# is parsed in the site's file and normalised. A site in a `lib` body is parsed as a
# lib body (`fun` declarations with no body). Returns the expansion for the caller
# to visit in the same scope, or nil when the engine refuses the site or the
# expansion is empty. Either way the site is recorded in the ledger.
#
# The expansion's nodes carry the lines of the expansion text, not of the site: the
# declarations pass reads only the file a node was written in, which the site
# shares. A line reported for a declaration a macro made is the expansion's line.
#
# `locals` are the names the body declares before the site, in the order its statements are read.
# The expansion is parsed knowing them, as the hosted parser reads it in the body's own scope: a
# later reference to such a local is a variable, not a call.
#
# `bindings` are the type parameters a site in a def body sees (macro_bindings.iyi): the receiver's
# and the def's free variables. A site at the top level or in a type body has none.
# `flag?` reads normalizer.macro_flags, or the host's flags when none were supplied.
# `program_names` answers the program's root names for a site, read as the site expands (see
# SemanticProgram#macro_names_at): nil when the caller cannot know them for that site, and then
# `@top_level.has_constant?` is refused by name.
pub def expand_inline_macro(site : ASTNode, scope_name : String, filename : String, in_lib : Bool, normalizer : NormalizerProgram, locals : Array(String) = [] of String, bindings : Array(MacroFreeBinding)? = nil, facts : MacroTypeFacts? = nil, path_lookup : Proc(Path, ASTNode?)? = nil, program_names : Proc(ASTNode, Array(String)?)? = nil) : ASTNode?
  program : MacroTypeFacts? = nil
  if names_of = program_names
    if names = names_of.call(site)
      program = MacroTypeFacts.program(names)
    end
  end
  report = MacroEngine.new(normalizer.macro_flags, normalizer.host_flags).site_report(site, scope_name, bindings, facts, path_lookup, program)
  first = report.sites.first
  kind = first.kind
  line = first.line
  column = first.column

  if f = report.failure
    InlineMacroLedger.record(InlineMacroSite.new(filename, kind, line, column, f.message), path_lookup.nil? ? nil : site)
    return nil
  end
  if report.skipped
    InlineMacroLedger.record(InlineMacroSite.new(filename, kind, line, column, "skip_file ends the file's expansion early, which the port does not expand"), path_lookup.nil? ? nil : site)
    return nil
  end

  InlineMacroLedger.record(InlineMacroSite.new(filename, kind, line, column, nil))
  text = report.output
  return nil if text.bytesize == 0

  scopes = [Set(String).new] of Set(String)
  locals.each { |name| scopes[0].add(name) }
  parser = Parser.new(text, filename, nil, scopes)
  parsed = in_lib ? parser.parse_lib_body : parser.parse
  Normalizer.new(normalizer).normalize(parsed)
end

# The local names a body declares, as the parser records them: an assignment to a plain
# variable, a typed declaration, and a multiple assignment's targets. A block, def, class,
# module, lib, fun or lambda has a scope of its own that the enclosing body does not see, so
# the scan does not enter one.
class InlineLocalNames < Visitor
  def initialize(@names : Array(String))
  end

  def visit(node : Assign) : Bool
    add_name(node.target)
    true
  end

  def visit(node : TypeDeclaration) : Bool
    add_name(node.var)
    true
  end

  def visit(node : UninitializedVar) : Bool
    add_name(node.var)
    true
  end

  def visit(node : MultiAssign) : Bool
    node.targets.each { |target| add_name(target) }
    true
  end

  def visit(node : Block) : Bool
    false
  end

  def visit(node : Def) : Bool
    false
  end

  def visit(node : ClassDef) : Bool
    false
  end

  def visit(node : ModuleDef) : Bool
    false
  end

  def visit(node : LibDef) : Bool
    false
  end

  def visit(node : FunDef) : Bool
    false
  end

  def visit(node : ProcLiteral) : Bool
    false
  end

  def add_name(target : ASTNode) : Nil
    if target.is_a?(Var)
      name = target.as(Var).name
      @names << name unless @names.includes?(name)
    end
    nil
  end
end

# Adds to `names` the locals `node` declares (see InlineLocalNames).
pub def collect_local_names(node : ASTNode, names : Array(String)) : Nil
  node.accept(InlineLocalNames.new(names))
  nil
end

# Replaces every inline macro site among `nodes` (the children of one Expressions: a file's top
# level, a type body, or the body of a def or fun) with its expansion, recursively, so the tree the
# later passes read holds the expansion and not the macro node. A site the engine refuses stays in
# the tree, so the pass that reads it refuses it too. An empty expansion is removed at the top
# level. In a def body (`keep_empty`) it stays: hosted parse_macro_source still parses an empty
# expansion (macros.cr 2128-2143) and expand_inline_macro binds that tree to the site
# (semantic_visitor.cr 2221-2226), so a site that writes nothing is still an expression, typed Nil.
# `locals` names what is declared before the first node, and grows with each node that declares one.
# A declarations visitor, when supplied, visits each ordinary node before the next site is
# expanded. The lookup then sees constants declared earlier, including in an expansion.
pub def splice_inline_sites(nodes : Array(ASTNode), scope_name : String, filename : String, in_lib : Bool, normalizer : NormalizerProgram, locals : Array(String) = [] of String, bindings : Array(MacroFreeBinding)? = nil, facts : MacroTypeFacts? = nil, keep_empty : Bool = false, path_lookup : Proc(Path, ASTNode?)? = nil, declarations : Visitor? = nil, program_names : Proc(ASTNode, Array(String)?)? = nil) : Array(ASTNode)
  out = [] of ASTNode
  nodes.each do |n|
    unless n.is_a?(MacroIf) || n.is_a?(MacroFor) || n.is_a?(MacroExpression)
      collect_local_names(n, locals)
      if visitor = declarations
        n.accept(visitor)
      end
      out << n
      next
    end
    expanded = expand_inline_macro(n, scope_name, filename, in_lib, normalizer, locals, bindings, facts, path_lookup, program_names)
    if expanded.nil?
      sites = InlineMacroLedger.sites
      last = sites[sites.size - 1]
      if last.reason.nil?
        out << n if keep_empty
      else
        # A walk-time loop or expression the port refuses is kept for the declarations pass, which drops those kinds
        # without a message (compiler.iyi extract_declarations). The walk refuses it here, at the site's position. A
        # walk-time `if` stays recorded: the declarations pass refuses it, and the gates count the refusals.
        if !path_lookup.nil? && (n.is_a?(MacroFor) || n.is_a?(MacroExpression))
          if reason = last.reason
            refuse_port(macro_site_refusal(n, reason))
          end
        end
        out << n
      end
      next
    end
    inner = [expanded.as(ASTNode)] of ASTNode
    if expanded.is_a?(Expressions)
      inner = expanded.as(Expressions).expressions
    end
    if keep_empty && inner.empty?
      out << n
      next
    end
    # A site an expansion writes has the lines of the expansion's text, not of the file, so the names rule
    # cannot place it: it is given no program names, and a `has_constant?` in it is refused by name.
    out.concat(splice_inline_sites(inner, scope_name, filename, in_lib, normalizer, locals, bindings, facts, keep_empty, path_lookup, declarations, nil))
  end
  out
end

# A body that is one inline macro node (a class, module or lib body) has no Expressions around it,
# so splice_inline_sites is never asked about it. Wrap it in an Expressions and splice it as a body
# of several nodes is spliced. A site the engine refuses stays. `keep_empty` is the def-body rule above.
pub def splice_body_node(body : ASTNode, scope_name : String, filename : String, in_lib : Bool, normalizer : NormalizerProgram, locals : Array(String) = [] of String, bindings : Array(MacroFreeBinding)? = nil, facts : MacroTypeFacts? = nil, keep_empty : Bool = false, path_lookup : Proc(Path, ASTNode?)? = nil, program_names : Proc(ASTNode, Array(String)?)? = nil) : ASTNode
  return body unless body.is_a?(MacroIf) || body.is_a?(MacroFor) || body.is_a?(MacroExpression)
  Expressions.new(splice_inline_sites([body] of ASTNode, scope_name, filename, in_lib, normalizer, locals, bindings, facts, keep_empty, path_lookup, nil, program_names))
end

# Where a site or a call is written, as a refusal names it: the base name of its file, then its line and
# column. The declarations pass names a refused `if` the same way.
pub def macro_where(place : Location?) : String
  if loc = place
    macro_where_at(loc.filename, loc.line_number, loc.column_number)
  else
    "an unlocated site"
  end
end

pub def macro_where_at(name : String, line : Int32, column : Int32) : String
  base = name
  i = name.size - 1
  while i >= 0
    if name[i] == '/'
      base = name[i + 1, name.size - i - 1]
      break
    end
    i = i - 1
  end
  "#{base}:#{line}:#{column}"
end

# The message a macro site the port refuses carries: the kind of site, the place it is written (an `if`
# names its condition) and the engine's reason.
pub def macro_site_refusal(site : ASTNode, reason : String) : String
  place = site.location
  if site.is_a?(MacroIf)
    place = site.as(MacroIf).cond.location || place
    return "port limitation: the port cannot evaluate the macro if condition at #{macro_where(place)} (#{reason}), so it refuses instead of taking either branch"
  end
  if site.is_a?(MacroFor)
    return "port limitation: the port cannot expand the macro for loop at #{macro_where(place)} (#{reason}), so it refuses instead of guessing its items"
  end
  "port limitation: the port cannot expand the macro expression at #{macro_where(place)} (#{reason}), so it refuses instead of guessing its text"
end

# The message a macro call the port refuses carries: the macro's name, the call's place, and the port's
# refusal with the place it sits in the macro's body.
pub def macro_call_refusal(call : Call, a_macro : Macro, failure : MacroFailure) : String
  defined = "an unlocated site"
  if loc = a_macro.location
    defined = macro_where_at(loc.filename, failure.line, failure.column)
  end
  "port limitation: the port cannot expand the macro '#{a_macro.name}' called at #{macro_where(call.location)} (#{failure.message}, at #{defined}), so it refuses instead of leaving the call out"
end
