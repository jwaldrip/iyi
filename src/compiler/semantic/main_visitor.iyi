# One construct the body typing could not type or refused, as the pipeline's
# refusal table reads it. `file` is nil and `line` and `column` are 0 when the
# node has no location. `def_name` is the def whose body was being typed, named
# `Owner#name` inside a type and `name` at top level; nil outside any def.
pub class Refusal
  getter reason : String
  getter file : String?
  getter line : Int32
  getter column : Int32
  getter def_name : String?
  getter node : ASTNode

  def initialize(@reason : String, @file : String?, @line : Int32, @column : Int32, @def_name : String?, @node : ASTNode)
  end
end

# One instantiation whose body typing started with every parameter typed: the
# instantiated clone of the def (`definition`, the value `call_target_defs` holds),
# the receiver (`self_type`, nil at top level) and one argument type per parameter,
# in declaration order. `definition` is the name because `def` is a keyword.
pub class TypedInstance
  getter definition : Def
  getter self_type : Type?
  getter arg_types : Array(Type)

  def initialize(@definition : Def, @self_type : Type?, @arg_types : Array(Type))
  end
end

# One cached instantiation (hosted DefInstance, Call#instantiate): the typed clone of a def
# whose body typing finished, and the type that body evaluates to. A call with the same key takes
# both, so the body is not typed again and the call site records the clone the lowering reads.
pub class DefInstance
  getter definition : Def
  getter return_type : Type

  def initialize(@definition : Def, @return_type : Type)
  end
end

# The def a block is written in, and the return values of its body (hosted: a `return` in a
# block leaves the def the block is written in).
pub class BlockOwner
  getter def_node : Def?
  getter return_types : Array(Type?)?
  # iyi: what a `yield` written in the block's body runs: the block of the def the block is
  # written in, with that def's block context and self. Without them the body's own `yield`
  # found the block it sits in and the typing never ended.
  getter call_block : Block?
  getter context_vars : Hash(String, Type)?
  getter yield_nodes : Array(Yield)?
  getter scope : Type?
  getter writer_type : ModuleType?

  def initialize(@def_node : Def?, @return_types : Array(Type?)?, @call_block : Block? = nil, @context_vars : Hash(String, Type)? = nil, @yield_nodes : Array(Yield)? = nil, @scope : Type? = nil, @writer_type : ModuleType? = nil)
  end
end

# Port of src/compiler/iyi/semantic/filters.cr: TypeFilters maps each variable
# name to its positive (then) and negative (else) TypeFilterSpec.
pub class TypeFilters
  getter pos : Hash(String, TypeFilterSpec)
  getter neg : Hash(String, TypeFilterSpec)

  def initialize(@pos : Hash(String, TypeFilterSpec) = Hash(String, TypeFilterSpec).new, @neg : Hash(String, TypeFilterSpec) = Hash(String, TypeFilterSpec).new)
  end

  def self.single(name : String, spec : TypeFilterSpec) : TypeFilters
    f = TypeFilters.new
    f.pos[name] = spec
    f.neg[name] = TypeFilter.negate(spec)
    f
  end

  def self.truthy(name : String) : TypeFilters
    single(name, TypeFilterSpec.new("truthy"))
  end

  def self.and_spec(s1 : TypeFilterSpec?, s2 : TypeFilterSpec?) : TypeFilterSpec?
    if a = s1
      if b = s2
        return a if a == b
        return TypeFilterSpec.new("and", nil, "", a, b)
      end
      return a
    end
    s2
  end

  def self.or_spec(s1 : TypeFilterSpec?, s2 : TypeFilterSpec?) : TypeFilterSpec?
    if a = s1
      if b = s2
        return a if a == b
        return TypeFilterSpec.new("or", nil, "", a, b)
      end
    end
    nil
  end

  def self.and_filters(f1 : TypeFilters?, f2 : TypeFilters?) : TypeFilters?
    return nil if f1.nil? && f2.nil?
    nf = TypeFilters.new
    common_keys(f1, f2).each do |name|
      p1 = f1 ? f1.as(TypeFilters).pos[name]? : nil
      p2 = f2 ? f2.as(TypeFilters).pos[name]? : nil
      if pf = and_spec(p1, p2)
        nf.pos[name] = pf
      end
      n1 = f1 ? f1.as(TypeFilters).neg[name]? : nil
      n2 = f2 ? f2.as(TypeFilters).neg[name]? : nil
      if negf = or_spec(n1, n2)
        nf.neg[name] = negf
      end
    end
    nf
  end

  def self.or_filters(f1 : TypeFilters?, f2 : TypeFilters?) : TypeFilters?
    return nil if f1.nil? && f2.nil?
    nf = TypeFilters.new
    common_keys(f1, f2).each do |name|
      p1 = f1 ? f1.as(TypeFilters).pos[name]? : nil
      p2 = f2 ? f2.as(TypeFilters).pos[name]? : nil
      if pf = or_spec(p1, p2)
        nf.pos[name] = pf
      end
      n1 = f1 ? f1.as(TypeFilters).neg[name]? : nil
      n2 = f2 ? f2.as(TypeFilters).neg[name]? : nil
      if negf = and_spec(n1, n2)
        nf.neg[name] = negf
      end
    end
    nf
  end

  def self.invert(f : TypeFilters?) : TypeFilters?
    return nil if f.nil?
    filters = f.as(TypeFilters)
    TypeFilters.new(filters.neg.dup, filters.pos.dup)
  end

  def self.assign_var(filters : TypeFilters?, name : String) : TypeFilters
    return truthy(name) if filters.nil?
    spec = TypeFilterSpec.new("truthy")
    nf = filters.as(TypeFilters).dup
    if pf = and_spec(nf.pos[name]?, spec)
      nf.pos[name] = pf
    end
    if negf = and_spec(nf.neg[name]?, TypeFilter.negate(spec))
      nf.neg[name] = negf
    end
    nf
  end

  def dup : TypeFilters
    TypeFilters.new(@pos.dup, @neg.dup)
  end

  def self.common_keys(f1 : TypeFilters?, f2 : TypeFilters?) : Array(String)
    keys = [] of String
    if a = f1
      a.pos.each_key { |k| keys << k unless keys.includes?(k) }
      a.neg.each_key { |k| keys << k unless keys.includes?(k) }
    end
    if b = f2
      b.pos.each_key { |k| keys << k unless keys.includes?(k) }
      b.neg.each_key { |k| keys << k unless keys.includes?(k) }
    end
    keys
  end
end

# iyi: two modes. Strict (the default) raises on the first construct it cannot
# type, as the port always did, and every existing gate relies on that. Total
# (`total = true`, the typed dump's mode) records the reason on the node that
# cannot be typed and goes on, so one unsupported construct costs its own nodes
# and not the file. A node with no type is never printed as typed, so it never
# counts as matched.
pub class MainVisitor < TypeNodeHost
  property program : SemanticProgram
  property current_type : ModuleType
  property scope : Type?
  property vars : Hash(String, Type)
  property node_types : NodeMap(Type)
  property untyped_reasons : NodeMap(String)
  property call_target_defs : NodeMap(Def)
  property current_def : Def?
  property current_call_block : Block?
  property current_block_context_vars : Hash(String, Type)?
  property current_yield_nodes : Array(Yield)?
  property total : Bool = false
  property in_type_args : Int32 = 0
  # The instantiations whose body typing is in progress, by key (receiver, def
  # name, argument types). A key typed again is a recursive call: it takes the
  # declared return type, or is refused. Shared with a fun body's visitor.
  property typing_stack : Array(String)
  # Every refusal recorded, in order (see Refusal). Shared with a fun body's visitor.
  property refusals : Array(Refusal)
  # Every instantiation whose body typing started with all its parameters typed,
  # in order (see TypedInstance). Shared with a fun body's visitor.
  property typed_instances : Array(TypedInstance)
  # Every finished instantiation by its key (see def_instance_key). Shared with a fun body's visitor.
  property def_instances : Hash(String, DefInstance)

  # The values the body being typed returns (`return`), and the values a `break` (of the call
  # whose block it is) and a `next` (of that block) carry while they are collected. nil where
  # none is collected; a nil entry is a value with no type.
  property return_types : Array(Type?)? = nil
  property break_types : Array(Type?)? = nil
  property next_types : Array(Type?)? = nil
  # The break values of each block's call, and the def and return list each block is written in.
  property block_breaks : NodeMap(Array(Type?)) = NodeMap(Array(Type?)).new
  property block_owners : NodeMap(BlockOwner) = NodeMap(BlockOwner).new
  # Jump boundaries are AST identities, not the value-collection stacks.
  property jump_block_calls : NodeMap(Call) = NodeMap(Call).new
  property jump_block : Block? = nil
  property jump_whiles : Array(While) = [] of While
  # The record of each call on a lib (see visit_lib_call): the fun, the result type and the
  # arguments the lowering passes.
  property lib_call_targets : NodeMap(LibCallTarget) = NodeMap(LibCallTarget).new
  # The expanded tree of each literal the hosted pass keeps (node.expanded).
  # Lowering reads this map the same way it reads lib_call_targets. The typed
  # dump prints nothing from it.
  property expansions : NodeMap(ASTNode) = NodeMap(ASTNode).new
  property type_filters : TypeFilters? = nil
  property needs_type_filters : Int32 = 0
  property unreachable : Bool = false
  property while_break_vars : Array(Array(Hash(String, Type))) = [] of Array(Hash(String, Type))
  # Assignment types visible from each enclosing handler's ensure.
  property handler_vars : Array(Hash(String, Type)) = [] of Hash(String, Type)
  property handler_writes : Array(Set(String)) = [] of Set(String)
  property handler_inside_ensure : Bool = false
  property handler_inside_defer : Bool = false
  property handler_direct_exit : Bool = false

  def handler_defer_exit(node : ASTNode, keyword : String) : Bool
    refuse(node, "`#{keyword}` can't leave a `defer`\n\nA `defer` runs while its scope is already being left, by a return, by `!`, or by a panic, so its cleanup has no answer of its own to give and nowhere to jump to. Let it run to its end, and answer from the scope. See SPEC.md III.1.4.")
  end

  def handler_assign(name : String, type : Type) : Nil
    @handler_writes.each { |writes| writes.add(name) }
    unless @handler_vars.empty?
      vars = @handler_vars.last
      if old = vars[name]?
        vars[name] = @program.type_merge(old, type)
      else
        vars[name] = type
      end
    end
    nil
  end

  def needs_type_filters? : Bool
    @needs_type_filters > 0
  end

  def visit_any(node : ASTNode) : Bool
    @unreachable = false
    true
  end

  def type_args_depth : Int32
    @in_type_args
  end

  # The analysed signature of each fun, keyed by its FunDef node: argument types
  # in declared order and the declared return type. The lowering reads them.
  property fun_arg_types_by_node : NodeMap(Array(Type)) = NodeMap(Array(Type)).new
  property matched_call_args : NodeMap(Array(Type)) = NodeMap(Array(Type)).new
  property fun_return_types_by_node : NodeMap(Type) = NodeMap(Type).new

  def record_fun_signature(node : FunDef, arg_types : Array(Type), return_type : Type?) : Nil
    @fun_arg_types_by_node[node] = arg_types
    if rt = return_type
      @fun_return_types_by_node[node] = rt
    end
    nil
  end

  def fun_arg_types(node : FunDef) : Array(Type)?
    @fun_arg_types_by_node[node]?
  end

  def fun_return_type(node : FunDef) : Type?
    @fun_return_types_by_node[node]?
  end

  # The union of the types each variable of the body being typed is assigned, keyed
  # by name; `def_var_unions` keeps it per instantiated def (the lowering's storage type).
  property var_unions : Hash(String, Type)
  property def_var_unions : NodeMap(Hash(String, Type))
  # The free variables of each instantiated def as its call's arguments bound them (hosted
  # MatchContext free_vars), kept per def: a macro site in the body names them (def_inline_bindings).
  property def_free_types : NodeMap(Hash(String, Type))
  # The locals of the body being typed whose value has no type, by name, with the
  # reason their reads are reported with. Saved and restored per body.
  property untyped_locals : Hash(String, String)
  property fun_inline_file : String?
  @literal_expander : LiteralExpander

  def initialize(@program : SemanticProgram)
    @literal_expander = LiteralExpander.new(@program.normalizer)
    # The generated `new` methods are completed before any body is typed: the
    # declarations pass has recorded the expansions, and this consumes them (idempotent).
    define_new_methods(@program)
    @current_type = @program
    @scope = nil
    @vars = Hash(String, Type).new
    @node_types = NodeMap(Type).new
    @untyped_reasons = NodeMap(String).new
    @call_target_defs = NodeMap(Def).new
    @var_unions = Hash(String, Type).new
    @def_var_unions = NodeMap(Hash(String, Type)).new
    @def_free_types = NodeMap(Hash(String, Type)).new
    @untyped_locals = Hash(String, String).new
    @current_def = nil
    @fun_inline_file = nil
    @current_call_block = nil
    @current_block_context_vars = nil
    @current_yield_nodes = nil
    @typing_stack = [] of String
    @refusals = [] of Refusal
    @typed_instances = [] of TypedInstance
    @def_instances = Hash(String, DefInstance).new
  end

  def set_type(node : ASTNode, type : Type) : Type
    if type.is_a?(UnresolvedType)
      untyped(node, "undefined constant #{type.name}")
      return type
    end
    @node_types[node] = type
    type
  end

  def type_of?(node : ASTNode) : Type?
    @node_types[node]?
  end

  def type_of(node : ASTNode) : Type
    if t = @node_types[node]?
      t
    else
      raise("BUG: node has no type: #{node.to_s}")
    end
  end

  # The type of a node a visit has already visited. Strict mode raises when it
  # has none: the reason the node was refused when there is one, else a BUG. Total
  # mode returns nil and the caller leaves its own node untyped.
  def child_type(node : ASTNode) : Type?
    if t = @node_types[node]?
      return t
    end
    unless @total
      if reason = @untyped_reasons[node]?
        raise(reason)
      end
      raise("BUG: node has no type: #{node.to_s}")
    end
    nil
  end

  # The reason a node could not be typed. Total mode records it and returns
  # false, so a visit can end with `return untyped(node, "...")`.
  def untyped(node : ASTNode, reason : String) : Bool
    @untyped_reasons[node] = reason
    record_refusal(node, reason)
    false
  end

  # A construct the port refuses. Strict mode raises the message (the program's
  # error, as before); total mode records it on the node.
  def refuse(node : ASTNode, message : String) : Bool
    record_refusal(node, message)
    raise(message) unless @total
    @untyped_reasons[node] = message
    false
  end

  # Appends one Refusal for `node`: the reason, the node's file, line and column
  # (0 when it has no location), and the def whose body was being typed, named
  # `Owner#name` inside a type and `name` at top level.
  def record_refusal(node : ASTNode, reason : String) : Nil
    file : String? = nil
    line = 0
    column = 0
    if loc = node.location
      file = loc.filename
      line = loc.line_number
      column = loc.column_number
    end
    def_name : String? = nil
    if cd = @current_def
      def_name = cd.name
      if owner = @scope
        unless owner.is_a?(SemanticProgram)
          def_name = "#{owner.full_name}##{cd.name}"
        end
      end
    end
    @refusals << Refusal.new(reason, file, line, column, def_name, node)
    nil
  end

  # The type a declared type names, or nil when it names none. A declared type never
  # raises here (the trunk's lookup raises on an unresolved name): the caller records
  # the refusal on its node. Generic receivers bind their type parameters as lookup_under does.
  def lookup_declared?(node : ASTNode, owner : Type?) : Type?
    if receiver_instance(owner).nil?
      return @program.lookup_type_node?(node, @current_type)
    end
    found = ArgRestriction.lookup_bound(type_node_system(@program), @current_type, node, owner)
    return found.as(Type) unless found.is_a?(LookupError)
    nil
  end

  # The name a declared type is refused by: the base of a generic.
  def declared_base_name(node : ASTNode) : String
    if node.is_a?(Generic)
      return node.as(Generic).name.to_s
    end
    node.to_s
  end

  def untyped_reason?(node : ASTNode) : String?
    @untyped_reasons[node]?
  end

  def target_def?(call : Call) : Def?
    @call_target_defs[call]?
  end

  # The lib call record of a call on a lib (see visit_lib_call), keyed by the call node: the fun,
  # the argument nodes, and the literal and out information the lowering needs. Nil for any other call.
  def lib_call_target?(call : Call) : LibCallTarget?
    @lib_call_targets[call]?
  end

  # The generic instance a body or signature is typed under: the receiver, or the
  # instance a metaclass stands for (`Pointer(UInt64).new` binds `T` to UInt64).
  def receiver_instance(owner : Type?) : GenericInstanceType?
    o : Type? = owner
    if o.is_a?(MetaclassType)
      o = o.as(MetaclassType).instance_type
    end
    if o.is_a?(GenericInstanceType)
      return o.as(GenericInstanceType)
    end
    nil
  end

  # The type a type node names under `owner`. A generic instance binds its type
  # parameter names to its type arguments (`T` is UInt64 in Pointer(UInt64)), and a
  # generic written with those names (`Pointer(T)`) is instantiated, as the hosted
  # MatchContext does. Anything else is the lexical lookup from the current type.
  def lookup_under(node : ASTNode, owner : Type?) : Type
    if cd = @current_def
      if bound = @def_free_types[cd]?
        found = ArgRestriction.lookup_free(type_node_system(@program), @current_type, node, owner, bound)
        return found.as(Type) unless found.is_a?(LookupError)
      end
    end
    if instance = receiver_instance(owner)
      found = ArgRestriction.lookup_bound(type_node_system(@program), @current_type, node, instance)
      return found.as(Type) unless found.is_a?(LookupError)
    end
    if node.is_a?(Self)
      if o = owner
        return o.as(Type) unless o.is_a?(SemanticProgram)
      end
    end
    if quiet = @program.lookup_type_node?(node, @current_type)
      return TypeQueries.virtual_type(quiet)
    end
    TypeQueries.virtual_type(@program.lookup_type_node(node, @current_type))
  end

  # iyi: a class variable that is replaced keeps the @[ThreadLocal] flag of the one it replaces
  # (hosted types.cr 1265: var.thread_local = class_var.thread_local?).
  def replace_class_var(mod_type : ModuleType, name : String, mv : MetaTypeVar) : Nil
    if old = mod_type.class_vars[name]?
      mv.thread_local = old.thread_local
    end
    mod_type.class_vars[name] = mv
    nil
  end

  def type_from_literal_kind(kind : NumberKind) : Type
    case kind
    when NumberKind::I8   then @program.types["Int8"]
    when NumberKind::I16  then @program.types["Int16"]
    when NumberKind::I32  then @program.int32_type
    when NumberKind::I64  then @program.types["Int64"]
    when NumberKind::I128 then @program.types["Int128"]
    when NumberKind::U8   then @program.types["UInt8"]
    when NumberKind::U16  then @program.types["UInt16"]
    when NumberKind::U32  then @program.types["UInt32"]
    when NumberKind::U64  then @program.types["UInt64"]
    when NumberKind::U128 then @program.types["UInt128"]
    when NumberKind::F32  then @program.types["Float32"]
    when NumberKind::F64  then @program.types["Float64"]
    else
      @program.int32_type
    end
  end

  def visit(node : NilLiteral) : Bool
    set_type(node, @program.nil_type)
    false
  end

  def visit(node : Macro) : Bool
    set_type(node, @program.nil_type)
    false
  end

  # iyi: the `module` header the parser leaves as the file's first statement. The
  # hosted tree has no such node (its parser makes the ModuleDef alone, parser.cr
  # 349-402), so the header is typed nothing, recorded nothing, and not walked.
  def visit(node : ModuleHeader) : Bool
    false
  end

  # iyi: an argument of a def, block or enum member. The hosted pass skips it
  # (semantic_visitor.cr: "Arg nodes are also used for Enum constants"): it is
  # neither typed nor walked.
  def visit(node : Arg) : Bool
    false
  end

  # iyi: declarations the hosted base visitor types as nil without walking them
  # (semantic_visitor.cr 1861-1911).
  def visit(node : ImportDecl) : Bool
    set_type(node, @program.nil_type)
    false
  end

  def visit(node : UsingDecl) : Bool
    set_type(node, @program.nil_type)
    false
  end

  def visit(node : Extend) : Bool
    set_type(node, @program.nil_type)
    false
  end

  def visit(node : Include) : Bool
    set_type(node, @program.nil_type)
    false
  end

  def visit(node : Alias) : Bool
    set_type(node, @program.nil_type)
    false
  end

  def visit(node : AnnotationDef) : Bool
    set_type(node, @program.nil_type)
    false
  end

  def visit(node : LibDef) : Bool
    set_type(node, @program.nil_type)
    false
  end

  def visit(node : AssocTypeDecl) : Bool
    set_type(node, @program.nil_type)
    false
  end

  # iyi: the visibility modifier types what it modifies and is nil itself. A call
  # with no expansion is refused, as the hosted pass refuses it.
  def visit(node : VisibilityModifier) : Bool
    exp = node.exp
    exp.accept(self)
    if exp.is_a?(Call) && exp.expanded.nil?
      return refuse(node, "can't apply visibility modifier")
    end
    set_type(node, @program.nil_type)
    false
  end

  # Hosted semantic_visitor.cr:1943-1961 and 2202-2226 expand a site wherever
  # it is visited, retain the expansion and type the site from that tree.
  def visit(node : MacroIf) : Bool
    expanded = @expansions[node]?
    if expanded.nil?
      expanded = expand_inline_macro(node, def_inline_scope_name, def_inline_file, false, @program.normalizer, @vars.keys, def_inline_bindings, MacroBindings.facts(@scope))
      if expanded.nil?
        return untyped(node, "macro control expansion (macros engine)") unless InlineMacroLedger.sites.last.reason.nil?
        expanded = Nop.new
      end
      @expansions[node] = expanded
    end
    expanded.accept(self)
    if et = child_type(expanded)
      set_type(node, et)
    end
    false
  end

  def visit(node : MacroFor) : Bool
    expanded = @expansions[node]?
    if expanded.nil?
      expanded = expand_inline_macro(node, def_inline_scope_name, def_inline_file, false, @program.normalizer, @vars.keys, def_inline_bindings, MacroBindings.facts(@scope))
      if expanded.nil?
        return untyped(node, "macro control expansion (macros engine)") unless InlineMacroLedger.sites.last.reason.nil?
        expanded = Nop.new
      end
      @expansions[node] = expanded
    end
    expanded.accept(self)
    if et = child_type(expanded)
      set_type(node, et)
    end
    false
  end

  def visit(node : MacroExpression) : Bool
    expanded = @expansions[node]?
    if expanded.nil?
      expanded = expand_inline_macro(node, def_inline_scope_name, def_inline_file, false, @program.normalizer, @vars.keys, def_inline_bindings, MacroBindings.facts(@scope))
      if expanded.nil?
        return untyped(node, "macro control expansion (macros engine)") unless InlineMacroLedger.sites.last.reason.nil?
        expanded = Nop.new
      end
      @expansions[node] = expanded
    end
    expanded.accept(self)
    if et = child_type(expanded)
      set_type(node, et)
    end
    false
  end

  def visit(node : MacroVerbatim) : Bool
    expanded = @expansions[node]?
    if expanded.nil?
      expanded = expand_inline_macro(node, def_inline_scope_name, def_inline_file, false, @program.normalizer, @vars.keys, def_inline_bindings, MacroBindings.facts(@scope))
      if expanded.nil?
        return untyped(node, "macro control expansion (macros engine)") unless InlineMacroLedger.sites.last.reason.nil?
        expanded = Nop.new
      end
      @expansions[node] = expanded
    end
    expanded.accept(self)
    if et = child_type(expanded)
      set_type(node, et)
    end
    false
  end

  def visit(node : MacroLiteral) : Bool
    false
  end

  # iyi: a literal the hosted pass expands before it types it (main_visitor.cr
  # 3664-3700, expand(node)). The literal expander draws its names from the
  # program's normalizer, as hosted `@program.literal_expander` does; the
  # literal takes the expanded tree's type, and the tree is walked.
  def expand_literal(node : ASTNode) : Bool
    expanded = node.transform(@literal_expander)
    expanded.accept(self)
    @expansions[node] = expanded
    if et = child_type(expanded)
      set_type(node, et)
    end
    false
  end

  def visit(node : ArrayLiteral) : Bool
    expand_literal(node)
  end

  def visit(node : HashLiteral) : Bool
    expand_literal(node)
  end

  def visit(node : RangeLiteral) : Bool
    expand_literal(node)
  end

  def visit(node : StringInterpolation) : Bool
    expand_literal(node)
  end

  def visit(node : And) : Bool
    expand_literal(node)
  end

  def visit(node : Or) : Bool
    expand_literal(node)
  end

  def visit(node : Case) : Bool
    expand_literal(node)
  end

  def visit(node : Select) : Bool
    expand_literal(node)
  end

  # A multiple assignment is expanded before it is typed, as the hosted pass does
  # (main_visitor.cr 3736): its targets are assigned from temporaries.
  def visit(node : MultiAssign) : Bool
    expand_literal(node)
  end

  # iyi: an annotation is a sibling of the def it annotates, not an expression.
  # The hosted pass does not type or walk it, so neither does the port; the
  # primitive name is read from the Annotation by the lowering (S2d owns that).
  def visit(node : Annotation) : Bool
    false
  end

  # Returns the local variable name if `exp` is a local variable read or
  # assignment to one (hosted MainVisitor#get_expression_var).
  def expression_var_name(exp : ASTNode) : String?
    if exp.is_a?(Var)
      return exp.as(Var).name
    elsif exp.is_a?(Assign)
      t = exp.as(Assign).target
      return t.as(Var).name if t.is_a?(Var)
    elsif exp.is_a?(Expressions)
      exps = exp.as(Expressions).expressions
      return expression_var_name(exps[0]) if exps.size == 1
    elsif exp.is_a?(Call)
      c = exp.as(Call)
      if c.obj.nil? && c.args.empty? && c.block.nil? && @vars.has_key?(c.name)
        return c.name
      end
    end
    nil
  end

  # iyi: `x.is_a?(T)` and `x.nil?` are Bool and record a SimpleTypeFilter
  # when the enclosing condition requests type filters (hosted main_visitor.cr 2251-2284).
  def visit(node : IsA) : Bool
    node.obj.accept(self)
    @in_type_args = @in_type_args + 1
    saved_ntf = @needs_type_filters
    @needs_type_filters = 0
    node.const.accept(self)
    @needs_type_filters = saved_ntf
    @in_type_args = @in_type_args - 1
    set_type(node, @program.bool_type)
    @type_filters = nil
    if needs_type_filters?
      is_const = false
      if node.const.is_a?(Path)
        if pt = @program.lookup_type_path?(node.const.as(Path), @current_type)
          is_const = true if pt.const?
        end
      end
      unless is_const
        if vname = expression_var_name(node.obj)
          if target = child_type(node.const)
            @type_filters = TypeFilters.single(vname, TypeFilterSpec.new("is_a", target))
          end
        end
      end
    end
    false
  end

  # iyi: `!x` is Bool and inverts its operand's type filters (hosted main_visitor.cr 3757).
  def visit(node : Not) : Bool
    @type_filters = nil
    node.exp.accept(self)
    set_type(node, @program.bool_type)
    if needs_type_filters?
      @type_filters = TypeFilters.invert(@type_filters)
    end
    false
  end

  # iyi: `break` and `next` never complete, so they are NoReturn. The value they carry is typed
  # first (the hosted pass binds it): a `break` to the call whose block is being typed, a `next`
  # to the block (see visit(Yield) and call_result).
  def visit(node : Break) : Bool
    if @handler_direct_exit
      return handler_defer_exit(node, "break") if @handler_inside_defer
      return refuse(node, "can't use break inside ensure")
    end
    value_t : Type? = @program.nil_type
    if e = node.exp
      e.accept(self)
      value_t = child_type(e)
    end
    if target = @jump_whiles.last?
      node.target = target
    elsif block = @jump_block
      node.target = @jump_block_calls[block]?
    end
    if bts = @break_types
      bts << value_t
    elsif !@while_break_vars.empty?
      @while_break_vars.last << @vars.dup
    end
    @unreachable = true
    set_type(node, @program.no_return_type)
    false
  end

  def visit(node : Next) : Bool
    if @handler_direct_exit
      return handler_defer_exit(node, "next") if @handler_inside_defer
      return refuse(node, "can't use next inside ensure")
    end
    value_t : Type? = @program.nil_type
    if e = node.exp
      e.accept(self)
      value_t = child_type(e)
    end
    if target = @jump_whiles.last?
      node.target = target
    elsif block = @jump_block
      node.target = block
    elsif current = @current_def
      node.target = current if current.captured_block?
    end
    if nts = @next_types
      nts << value_t
    end
    @unreachable = true
    set_type(node, @program.no_return_type)
    false
  end

  # iyi: the body of a `@[Primitive(:name)]` def (hosted main_visitor.cr
  # 2842-2851). It has the def's declared return type. `pre_initialize` and the
  # by-name cases are not ported here; a primitive with no return type is
  # recorded untyped with its name.
  def visit(node : Primitive) : Bool
    if node.name == "tuple_indexer_known_index" && !node.tuple_range
      if sc = @scope
        instance : Type = sc
        meta = false
        if sc.is_a?(MetaclassType)
          instance = sc.as(MetaclassType).instance_type
          meta = true
        end
        if instance.is_a?(TupleInstanceType)
          members = instance.as(TupleInstanceType).tuple_types
          if node.tuple_index >= 0 && node.tuple_index < members.size
            result = members[node.tuple_index]
            set_type(node, meta ? type_node_metaclass(result).as(Type) : result)
            return false
          end
        elsif instance.is_a?(NamedTupleInstanceType)
          entries = instance.as(NamedTupleInstanceType).entries
          if node.tuple_index >= 0 && node.tuple_index < entries.size
            result = entries[node.tuple_index].type
            set_type(node, meta ? type_node_metaclass(result).as(Type) : result)
            return false
          end
        end
      end
      return refuse(node, "unsupported TupleIndexer scope")
    end
    if cd = @current_def
      if primitive_type = @program.primitive_return_type(cd)
        set_type(node, primitive_type)
        return false
      end
      if rt = cd.return_type
        set_type(node, lookup_under(rt, @scope))
        return false
      end
    end
    if node.name == "allocate" || node.name == "pointer_malloc" || node.name == "pointer_new"
      if sc = @scope
        if sc.is_a?(MetaclassType)
          instance = sc.as(MetaclassType).instance_type
          if node.name == "pointer_malloc" && instance.is_a?(GenericClassType)
            return refuse(node, "can't malloc pointer without type, use Pointer(Type).malloc(size)")
          end
          if node.name == "pointer_new" && instance.is_a?(GenericClassType)
            return refuse(node, "can't create pointer without type, use Pointer(Type).new(address)")
          end
          set_type(node, instance)
          return false
        end
      end
    end
    if node.name == "pointer_set"
      if pst = pointer_set_type
        set_type(node, pst)
        return false
      end
    end

    if node.name == "class"
      if sc = @scope
        if sc.is_a?(ModuleType)
          set_type(node, sc.as(ModuleType).metaclass)
          return false
        end
      end
    end
    untyped(node, "primitive #{node.name} without a declared return type")
    false
  end

  # Hosted visit_pointer_set (main_visitor.cr 3023-3035): a Void element types
  # the primitive as Nil; otherwise the type is the def's `value` argument.
  # A Pointer instance that is not a PointerInstanceType still has that argument.
  def pointer_set_type : Type?
    element = pointer_element(@scope)
    if element && element.is_a?(VoidType)
      return @program.nil_type
    end
    if vt = @vars["value"]?
      return vt
    end
    element
  end

  def pointer_element(scope : Type?) : Type?
    return nil if scope.nil?
    sc : Type = scope.as(Type)
    if sc.is_a?(MetaclassType)
      sc = sc.as(MetaclassType).instance_type
    end
    if sc.is_a?(PointerInstanceType)
      return sc.as(PointerInstanceType).element_type
    end
    if sc.is_a?(GenericClassInstanceType)
      inst = sc.as(GenericClassInstanceType)
      base = inst.generic_type
      if base.is_a?(GenericClassType) && base.as(GenericClassType).name == "Pointer"
        args = inst.type_args
        return args[0] if args.size == 1
      end
    end
    nil
  end

  # `obj.responds_to?(:name)` is typed Bool. Its value depends on the obj's type and is
  # decided by the lowering, not here (the hosted typer sets only the type).
  def visit(node : RespondsTo) : Bool
    obj = node.obj
    obj.accept(self)
    set_type(node, @program.bool_type)
    false
  end

  # iyi: a node of a kind this visitor does not type yet. The walk goes on into
  # its children, so the children are typed; the node itself is recorded.
  def visit(node : ASTNode) : Bool
    untyped(node, "unsupported node: #{node_class_name(node)}")
    true
  end

  def expand_macro(node : Call) : Bool
    if exp = node.expanded
      exp.accept(self)
      if et = child_type(exp)
        set_type(node, et)
      end
      return true
    end

    if node.obj.nil?
      lookup_type = @scope || @current_type
      if a_macro = lookup_type.lookup_macro?(node.name)
        engine = MacroEngine.new
        expanded_ast = engine.expand(a_macro, node, @program.normalizer)
        node.expanded = expanded_ast
        expanded_ast.accept(self)
        if et = child_type(expanded_ast)
          set_type(node, et)
        end
        return true
      end
    end

    false
  end

  def visit(node : BoolLiteral) : Bool
    set_type(node, @program.bool_type)
    false
  end

  def visit(node : CharLiteral) : Bool
    set_type(node, @program.char_type)
    false
  end

  def visit(node : StringLiteral) : Bool
    set_type(node, @program.string_type)
    false
  end

  # An unexpanded default still types here. A call expands the default to a literal
  # first and types that literal through its ordinary visitor.
  def visit(node : MagicConstant) : Bool
    if node.name == TokenKind::MAGIC_LINE || node.name == TokenKind::MAGIC_END_LINE
      set_type(node, @program.int32_type)
    else
      set_type(node, @program.string_type)
    end
    false
  end

  def visit(node : SymbolLiteral) : Bool
    set_type(node, @program.symbol_type)
    false
  end

  def visit(node : NumberLiteral) : Bool
    set_type(node, type_from_literal_kind(node.kind))
    false
  end

  def visit(node : Nop) : Bool
    set_type(node, @program.nil_type)
    false
  end

  def visit(node : Var) : Bool
    if t = @vars[node.name]?
      set_type(node, t)
      if needs_type_filters?
        @type_filters = TypeFilters.truthy(node.name)
      end
      return false
    end
    if reason = @untyped_locals[node.name]?
      return untyped(node, reason)
    end

    if node.name == "self"
      if sc = @scope
        set_type(node, sc)
        return false
      else
        return refuse(node, "there's no self in this scope")
      end
    end

    rec_type : Type = @scope || @current_type
    all_defs = [] of Def
    visited = Set(String).new
    collect_candidate_defs(rec_type, node.name, all_defs, visited)
    collect_scope_defs(rec_type, node.name, all_defs, visited) if all_defs.empty?
    zero_arg = all_defs.find { |d| d.args.empty? || (d.args.first.default_value != nil) }
    if zero_arg
      call = Call.new(nil, node.name).at(node)
      @call_target_defs[call] = zero_arg
      if ret_type = type_method_body(zero_arg, rec_type, [] of ASTNode, nil, node)
        set_type(node, ret_type)
      end
      return false
    end

    scope_name = if sc = @scope
                   sc.full_name
                 else
                   "top-level"
                 end
    refuse(node, "undefined local variable or method '#{node.name}' for #{scope_name}")
  end

  def visit(node : InstanceVar) : Bool
    if @scope.nil? && (@current_type.is_a?(SemanticProgram) || @current_type.nil?)
      return refuse(node, "can't use instance variables at the top level")
    end
    target_scope = @scope || @current_type
    target_type = if target_scope.is_a?(MetaclassType)
                    target_scope.as(MetaclassType).instance_type
                  else
                    target_scope
                  end
    if target_type.is_a?(ModuleType)
      if ivar = target_type.as(ModuleType).lookup_instance_var?(node.name)
        set_type(node, ivar.type)
        return false
      end
    end
    if target_type.is_a?(GenericClassInstanceType)
      if ivar = target_type.as(GenericClassInstanceType).lookup_instance_var?(node.name)
        set_type(node, ivar.type)
        return false
      end
    end
    refuse(node, "can't infer the type of instance variable '#{node.name}' of #{target_type.full_name}")
  end

  def visit(node : ClassVar) : Bool
    if @scope.nil? && (@current_type.is_a?(SemanticProgram) || @current_type.nil?)
      return refuse(node, "can't use class variables at the top level")
    end
    target_scope = @scope || @current_type
    target_type = if target_scope.is_a?(MetaclassType)
                    target_scope.as(MetaclassType).instance_type
                  else
                    target_scope
                  end
    if target_type.is_a?(ModuleType)
      if cvar = target_type.as(ModuleType).lookup_class_var?(node.name)
        set_type(node, cvar.type)
        return false
      end
    end
    refuse(node, "undefined class variable '#{node.name}' for #{target_type.full_name}")
  end

  # Class-body initializers run with self set to the owner's metaclass.
  # Assignments inside methods retain the method's existing scope.
  def type_class_var_initializer(value : ASTNode) : Nil
    old_scope = @scope
    if old_scope.nil? && @current_def.nil? && !@current_type.is_a?(SemanticProgram)
      @scope = @current_type.metaclass
    end
    value.accept(self)
    @scope = old_scope
    nil
  end

  def visit(node : Assign) : Bool
    # iyi: a constant whose value is one macro node is typed where a read of it types the value (visit(Path) expands
    # the site, see splice_const_value). The declaration is not walked as an expression: the macro refusal would
    # belong to no def.
    if node.target.is_a?(Path) && (node.value.is_a?(MacroIf) || node.value.is_a?(MacroFor) || node.value.is_a?(MacroExpression))
      return false
    end
    if node.target.is_a?(ClassVar)
      type_class_var_initializer(node.value)
    else
      node.value.accept(self)
    end
    value_type_filters = @type_filters
    @type_filters = nil
    vt = child_type(node.value)
    if vt.nil?
      # The local is declared; its reads report why its value has no type.
      if node.target.is_a?(Var)
        name = node.target.as(Var).name
        @untyped_locals[name] = "the value of '#{name}' cannot be typed"
      end
      return false
    end
    val_type = vt.as(Type)
    if node.target.is_a?(Var)
      @untyped_locals.delete(node.target.as(Var).name)
    end

    if node.target.is_a?(Var)
      v = node.target.as(Var)
      # The target and the later reads take the type of this assignment: the
      # oracle prints flow types (bench/fixtures/sem_bodies_union.iyi). The
      # variable's storage type is the union over the body's assignments, kept
      # apart in `def_var_unions` for the lowering.
      @vars[v.name] = val_type
      handler_assign(v.name, val_type)
      set_type(v, val_type)
      set_type(node, val_type)
      if needs_type_filters?
        @type_filters = TypeFilters.assign_var(value_type_filters, v.name)
      end
      if old_u = @var_unions[v.name]?
        @var_unions[v.name] = @program.type_merge(old_u, val_type)
      else
        @var_unions[v.name] = val_type
      end
    elsif node.target.is_a?(InstanceVar)
      ivar_node = node.target.as(InstanceVar)
      if @scope.nil? && (@current_type.is_a?(SemanticProgram) || @current_type.nil?)
        return refuse(node, "can't use instance variables at the top level")
      end
      target_scope = @scope || @current_type
      target_type = if target_scope.is_a?(MetaclassType)
                      target_scope.as(MetaclassType).instance_type
                    else
                      target_scope
                    end
      if target_type.is_a?(ModuleType)
        mod_type = target_type.as(ModuleType)
        if ivar = mod_type.lookup_instance_var?(ivar_node.name)
          unless val_type.subtype_of?(ivar.type)
            return refuse(node, "instance variable '#{ivar_node.name}' of #{mod_type.full_name} must be #{ivar.type.full_name}, not (#{ivar.type.full_name} | #{val_type.full_name})")
          end
          set_type(ivar_node, ivar.type)
        else
          ivar = MetaTypeVar.new(ivar_node.name, val_type, node.value)
          mod_type.instance_vars[ivar_node.name] = ivar
          set_type(ivar_node, val_type)
        end
        set_type(node, val_type)
      elsif target_type.is_a?(GenericClassInstanceType)
        gen_type = target_type.as(GenericClassInstanceType)
        if ivar = gen_type.lookup_instance_var?(ivar_node.name)
          unless val_type.subtype_of?(ivar.type)
            return refuse(node, "instance variable '#{ivar_node.name}' of #{gen_type.full_name} must be #{ivar.type.full_name}, not (#{ivar.type.full_name} | #{val_type.full_name})")
          end
          set_type(ivar_node, ivar.type)
        else
          gen_type.instance_vars[ivar_node.name] = MetaTypeVar.new(ivar_node.name, val_type, node.value)
          set_type(ivar_node, val_type)
        end
        set_type(node, val_type)
      else
        return refuse(node, "can't use instance variables in #{target_type.full_name}")
      end
    elsif node.target.is_a?(ClassVar)
      cvar_node = node.target.as(ClassVar)
      if @scope.nil? && (@current_type.is_a?(SemanticProgram) || @current_type.nil?)
        return refuse(node, "can't use class variables at the top level")
      end
      target_scope = @scope || @current_type
      target_type = if target_scope.is_a?(MetaclassType)
                      target_scope.as(MetaclassType).instance_type
                    else
                      target_scope
                    end
      if target_type.is_a?(ModuleType)
        mod_type = target_type.as(ModuleType)
        if cvar = mod_type.lookup_class_var?(cvar_node.name)
          unless val_type.subtype_of?(cvar.type) || (cvar.type.is_a?(UnionType) && TypeRestrictions.matches_restriction?(@program, val_type, cvar.type))
            return refuse(node, "type mismatch for class variable '#{cvar_node.name}': expected #{cvar.type.full_name}, got #{val_type.full_name}")
          end
          set_type(cvar_node, cvar.type)
        else
          cvar = MetaTypeVar.new(cvar_node.name, val_type, node.value)
          replace_class_var(mod_type, cvar_node.name, cvar)
          set_type(cvar_node, val_type)
        end
        set_type(node, val_type)
      else
        return refuse(node, "can't use class variables in #{target_type.full_name}")
      end
    elsif node.target.is_a?(Path)
      p = node.target.as(Path)
      set_type(p, val_type)
      set_type(node, val_type)
    else
      set_type(node, val_type)
    end
    false
  end

  def visit(node : TypeDeclaration) : Bool
    # Declarations must resolve generic arguments even before any expression
    # has caused the lazy type system to be installed.
    type_node_system(@program)
    decl_found = lookup_declared?(node.declared_type, @scope)
    if decl_found.nil?
      return refuse(node, "undefined constant #{declared_base_name(node.declared_type)}")
    end
    decl_type = decl_found.as(Type)
    if val = node.value
      if node.var.is_a?(ClassVar)
        type_class_var_initializer(val)
      else
        val.accept(self)
      end
      vt = child_type(val)
      return false if vt.nil?
      val_type = vt.as(Type)
      proc_compatible = val_type.is_a?(ProcInstanceType) && decl_type.is_a?(ProcInstanceType) &&
                        TypeIntersect.compatible_proc?(val_type.as(ProcInstanceType), decl_type.as(ProcInstanceType))
      class_var_union = node.var.is_a?(ClassVar) && decl_type.is_a?(UnionType) &&
                        TypeRestrictions.matches_restriction?(@program, val_type, decl_type)
      unless val_type.subtype_of?(decl_type) || proc_compatible || class_var_union
        if node.var.is_a?(InstanceVar)
          target_scope = @scope || @current_type
          target_type = if target_scope.is_a?(MetaclassType)
                          target_scope.as(MetaclassType).instance_type
                        else
                          target_scope
                        end
          return refuse(node, "instance variable '#{node.var.as(InstanceVar).name}' of #{target_type.full_name} must be #{decl_type.full_name}, not (#{decl_type.full_name} | #{val_type.full_name})")
        end
        return refuse(node, "expected type #{decl_type.full_name}, got #{val_type.full_name}")
      end
      if node.var.is_a?(Var)
        v = node.var.as(Var)
        @vars[v.name] = decl_type
        set_type(v, decl_type)
      elsif node.var.is_a?(InstanceVar)
        ivar_node = node.var.as(InstanceVar)
        if @scope.nil? && (@current_type.is_a?(SemanticProgram) || @current_type.nil?)
          return refuse(node, "can only declare instance variables of a non-generic class, not a main (<Program>)")
        end
        target_scope = @scope || @current_type
        target_type = if target_scope.is_a?(MetaclassType)
                        target_scope.as(MetaclassType).instance_type
                      else
                        target_scope
                      end
        if target_type.is_a?(ModuleType)
          mod_type = target_type.as(ModuleType)
          mod_type.instance_vars[ivar_node.name] = MetaTypeVar.new(ivar_node.name, decl_type, val)
          set_type(ivar_node, decl_type)
        end
      elsif node.var.is_a?(ClassVar)
        cvar_node = node.var.as(ClassVar)
        if @scope.nil? && (@current_type.is_a?(SemanticProgram) || @current_type.nil?)
          return refuse(node, "can't use class variables at the top level")
        end
        target_scope = @scope || @current_type
        target_type = if target_scope.is_a?(MetaclassType)
                        target_scope.as(MetaclassType).instance_type
                      else
                        target_scope
                      end
        if target_type.is_a?(ModuleType)
          mod_type = target_type.as(ModuleType)
          replace_class_var(mod_type, cvar_node.name, MetaTypeVar.new(cvar_node.name, decl_type, val))
          set_type(cvar_node, decl_type)
        end
      end
      set_type(node, val_type)
    else
      if node.var.is_a?(Var)
        v = node.var.as(Var)
        @vars[v.name] = decl_type
        set_type(v, decl_type)
      elsif node.var.is_a?(InstanceVar)
        ivar_node = node.var.as(InstanceVar)
        if @scope.nil? && (@current_type.is_a?(SemanticProgram) || @current_type.nil?)
          return refuse(node, "can only declare instance variables of a non-generic class, not a main (<Program>)")
        end
        target_scope = @scope || @current_type
        target_type = if target_scope.is_a?(MetaclassType)
                        target_scope.as(MetaclassType).instance_type
                      else
                        target_scope
                      end
        if target_type.is_a?(ModuleType)
          mod_type = target_type.as(ModuleType)
          mod_type.instance_vars[ivar_node.name] = MetaTypeVar.new(ivar_node.name, decl_type, nil)
          set_type(ivar_node, decl_type)
        end
      elsif node.var.is_a?(ClassVar)
        cvar_node = node.var.as(ClassVar)
        if @scope.nil? && (@current_type.is_a?(SemanticProgram) || @current_type.nil?)
          return refuse(node, "can't use class variables at the top level")
        end
        target_scope = @scope || @current_type
        target_type = if target_scope.is_a?(MetaclassType)
                        target_scope.as(MetaclassType).instance_type
                      else
                        target_scope
                      end
        if target_type.is_a?(ModuleType)
          mod_type = target_type.as(ModuleType)
          replace_class_var(mod_type, cvar_node.name, MetaTypeVar.new(cvar_node.name, decl_type, nil))
          set_type(cvar_node, decl_type)
        end
      end
      set_type(node, decl_type)
    end
    false
  end

  def visit(node : Path) : Bool
    if !node.global && node.names.size == 1
      if cd = @current_def
        if free = @def_free_types[cd]?
          if bound = free[node.names.first]?
            if @in_type_args == 0 && bound.is_a?(ModuleType)
              set_type(node, bound.as(ModuleType).metaclass)
            else
              set_type(node, bound)
            end
            return false
          end
        end
      end
    end
    if inst = receiver_instance(@scope)
      path = node
      if !path.global && path.names.size == 1
        if bound = inst.type_vars[path.names.first]?
          # A type parameter in an expression names the bound type's metaclass, as a
          # type name does (`T.new`), except inside a type argument.
          if @in_type_args == 0 && bound.is_a?(ModuleType)
            set_type(node, bound.as(ModuleType).metaclass)
          else
            set_type(node, bound)
          end
          return false
        end
      end
    end
    t = @program.lookup_type_path(node, @current_type)
    if t.const?
      c = t.as(Const)
      c.used = true
      if enum_type = c.enum_value_type
        set_type(c.value, enum_type)
        set_type(node, enum_type)
      elsif c_type = type_of?(c.value)
        set_type(node, c_type)
      else
        splice_const_value(c)
        c.value.accept(self)
        if c_type = child_type(c.value)
          set_type(node, c_type)
        end
      end
    elsif t.is_a?(ModuleType) && @in_type_args == 0 && !t.is_a?(LibType)
      set_type(node, t.as(ModuleType).metaclass)
    else
      set_type(node, t)
    end
    false
  end

  # An inline macro site (`{% if %}`, `{% for %}`, `{{ }}`) written in the body of the def being typed
  # is expanded in place, as the declarations pass expands one at the top level and in a type body
  # (inline_macros.iyi). The scope is the receiver's type and the file is the one the def is written in.
  # Outside a def (top level, a fun body) nothing is spliced here.
  def def_inline_scope_name : String
    if scope = @scope
      return scope.full_name
    end
    ""
  end

  def def_inline_file : String
    if cd = @current_def
      if loc = cd.location
        return loc.filename
      end
    end
    @fun_inline_file || ""
  end

  # Whether a body is spliced here: a def being typed, or a fun body (see visit(FunDef)).
  def in_inline_body? : Bool
    !@current_def.nil? || !@fun_inline_file.nil?
  end

  # The names a def's arguments declare: the locals its body sees before the first statement (inline_macros.iyi).
  def def_inline_locals : Array(String)
    names = [] of String
    if cd = @current_def
      cd.args.each { |arg| names << arg.name }
      if ba = cd.block_arg
        names << ba.name
      end
    end
    names
  end

  # The type parameters a macro site in the def being typed sees (macro_bindings.iyi): the receiver's
  # and the def's own free variables. The def is the one whose body the site is written in, so a site in
  # a block's body sees its writer's, not the yielding def's.
  def def_inline_bindings : Array(MacroFreeBinding)
    free = Hash(String, Type).new
    if cd = @current_def
      if bound = @def_free_types[cd]?
        free = bound
      end
    end
    MacroBindings.of(@scope, free)
  end

  # Whether a node is an inline macro site the splice expands.
  def inline_site?(node : ASTNode) : Bool
    node.is_a?(MacroIf) || node.is_a?(MacroFor) || node.is_a?(MacroExpression)
  end

  # Every Expressions of every def body passes here, so the names and bindings are built only for a
  # body that holds a site: a body with none is left as it is.
  def splice_def_inline_sites(node : Expressions) : Nil
    return nil if @current_def.nil?
    return nil unless node.expressions.any? { |exp| inline_site?(exp) }
    node.expressions = splice_inline_sites(node.expressions, def_inline_scope_name, def_inline_file, false, @program.normalizer, def_inline_locals, def_inline_bindings, MacroBindings.facts(@scope), true)
    nil
  end

  def splice_def_body(node : ASTNode) : ASTNode
    return node if @current_def.nil?
    return node unless inline_site?(node)
    splice_body_node(node, def_inline_scope_name, def_inline_file, false, @program.normalizer, def_inline_locals, def_inline_bindings, MacroBindings.facts(@scope), true)
  end

  # An inline macro site that is the whole value of a constant (`CHANNEL_WAIT = {% if ... %}512{% else %}2048{% end %}`)
  # is expanded where the constant is typed, as the hosted pass expands a macro where an expression is expected
  # (semantic_visitor.cr 1943-1956). The declared value keeps the site: the declarations dump prints it as written.
  def splice_const_value(c : Const) : Nil
    value = c.value
    return nil unless value.is_a?(MacroIf) || value.is_a?(MacroFor) || value.is_a?(MacroExpression)
    scope_name = ""
    if ns = c.namespace
      scope_name = ns.full_name
    end
    file = ""
    if locs = c.locations
      if first_loc = locs.first?
        file = first_loc.filename
      end
    end
    spliced = splice_body_node(value, scope_name, file, c.namespace.is_a?(LibType), @program.normalizer)
    if spliced.is_a?(Expressions)
      only = spliced.as(Expressions).expressions
      spliced = only[0] if only.size == 1
    end
    c.value = spliced
    nil
  end

  def visit(node : Expressions) : Bool
    splice_def_inline_sites(node)
    if node.expressions.empty?
      set_type(node, @program.nil_type)
    else
      # The type of an expression list is the type of its last expression. An
      # expression the port cannot type leaves the list untyped too.
      last_type : Type? = nil
      i = 0
      while i < node.expressions.size
        exp = node.expressions[i]
        # iyi: an annotation sits beside the def it annotates and is neither typed
        # nor walked (the hosted pass does not), so it does not end the list's type.
        unless exp.is_a?(Annotation)
          if i == node.expressions.size - 1
            exp.accept(self)
            last_type = child_type(exp)
          else
            saved_ntf = @needs_type_filters
            @needs_type_filters = 0
            exp.accept(self)
            @needs_type_filters = saved_ntf
          end
        end
        i = i + 1
      end
      if lt = last_type
        set_type(node, lt)
      end
    end
    false
  end

  # The type where two branches meet. A branch that never completes (NoReturn) adds
  # nothing, as the hosted merge drops it; the other branch's type is the result.
  def merge_flow(a : Type, b : Type) : Type
    return b if a.is_a?(NoReturnType)
    return a if b.is_a?(NoReturnType)
    @program.type_merge(a, b)
  end

  # Applies a TypeFilters map to @vars for the current branch.
  def filter_vars(filters : TypeFilters?) : Nil
    return nil if filters.nil?
    filters.as(TypeFilters).pos.each do |name, spec|
      if existing = @vars[name]?
        if narrowed = TypeFilter.apply(@program, spec, existing)
          @vars[name] = narrowed
        else
          @vars.delete(name)
          @untyped_locals[name] = "variable '#{name}' cannot be typed"
        end
      end
    end
    nil
  end

  # The hosted pass refuses rescue and else in iyi; only the ensure path is
  # needed here. The handler's value is its body, never the ensure's value.
  def visit(node : ExceptionHandler) : Bool
    if node.rescues || node.else
      return refuse(node, "iyi has no exceptions to rescue: an error is a value the caller handles (SPEC.md III.1), and a panic is caught at a task boundary (III.1.4), never here - this `rescue` would not run. Return the error, or read the task's `value`")
    end
    if @program.iyi_prelude? && !node.iyi_defer?
      if loc = node.location
        if loc.filename.ends_with?(".iyi") && node.ensure
          return refuse(node, "iyi has no `ensure`: a panic unwinds by registry and skips it (SPEC.md III.1.4). Write `defer`, which runs on return, on `!` and on a panic")
        end
      end
    end

    before_body = @vars.dup
    handler_vars = @vars.dup
    @handler_vars << handler_vars
    node.body.accept(self)
    after_body = @vars.dup
    body_unreachable = @unreachable
    @handler_vars.pop
    unless @handler_vars.empty?
      outer = @handler_vars.last
      handler_vars.each do |name, type|
        if old = outer[name]?
          outer[name] = @program.type_merge(old, type)
        else
          outer[name] = type
        end
      end
    end

    if cleanup = node.ensure
      handler_vars.each do |name, type|
        unless before_body.has_key?(name)
          handler_vars[name] = @program.type_merge(type, @program.nil_type)
        end
      end
      @vars = handler_vars
      writes = Set(String).new
      @handler_writes << writes
      @unreachable = false
      old_handler_inside_ensure = @handler_inside_ensure
      old_handler_inside_defer = @handler_inside_defer
      old_handler_direct_exit = @handler_direct_exit
      @handler_inside_ensure = true
      @handler_inside_defer = @handler_inside_defer || node.iyi_defer?
      @handler_direct_exit = true
      cleanup.accept(self)
      @handler_inside_ensure = old_handler_inside_ensure
      @handler_inside_defer = old_handler_inside_defer
      @handler_direct_exit = old_handler_direct_exit
      cleanup_unreachable = @unreachable
      @handler_writes.pop
      after_cleanup = @vars
      @vars = after_body
      writes.each do |name|
        if type = after_cleanup[name]?
          @vars[name] = type
        end
      end
      @unreachable = body_unreachable || cleanup_unreachable
    end
    if type = child_type(node.body)
      set_type(node, type)
    end
    false
  end

  # Merges @vars after an `if`'s two branches (hosted MainVisitor#merge_if_vars).
  def merge_if_vars(cond_vars : Hash(String, Type), then_vars : Hash(String, Type), else_vars : Hash(String, Type), then_untyped : Hash(String, String), else_untyped : Hash(String, String), then_unreachable : Bool, else_unreachable : Bool) : Nil
    merged_vars = Hash(String, Type).new
    merged_untyped = Hash(String, String).new
    keys = [] of String
    then_vars.each_key { |k| keys << k unless keys.includes?(k) }
    else_vars.each_key { |k| keys << k unless keys.includes?(k) }
    cond_vars.each_key { |k| keys << k unless keys.includes?(k) }
    keys.each do |name|
      then_var = then_vars[name]?
      else_var = else_vars[name]?
      cond_var = cond_vars[name]?
      if then_var && else_var
        if then_unreachable && else_unreachable
          merged_vars[name] = merge_flow(then_var, else_var)
        elsif then_unreachable
          merged_vars[name] = else_var
        elsif else_unreachable
          merged_vars[name] = then_var
        elsif then_var == else_var
          merged_vars[name] = then_var
        else
          merged_vars[name] = @program.type_merge(then_var, else_var)
        end
      elsif then_var
        if then_unreachable
          if cond_var && !else_unreachable
            # Narrowed to empty in else; keep nothing here
          elsif cond_var
            merged_vars[name] = cond_var
          end
        else
          if cond_var
            merged_vars[name] = then_var
          elsif else_unreachable
            merged_vars[name] = then_var
          else
            merged_vars[name] = @program.type_merge(then_var, @program.nil_type)
            if old_u = @var_unions[name]?
              @var_unions[name] = @program.type_merge(old_u, @program.nil_type)
            end
          end
        end
      elsif else_var
        if else_unreachable
          if cond_var && !then_unreachable
            # Narrowed to empty in then
          elsif cond_var
            merged_vars[name] = cond_var
          end
        else
          if cond_var
            merged_vars[name] = else_var
          elsif then_unreachable
            merged_vars[name] = else_var
          else
            merged_vars[name] = @program.type_merge(else_var, @program.nil_type)
            if old_u = @var_unions[name]?
              @var_unions[name] = @program.type_merge(old_u, @program.nil_type)
            end
          end
        end
      end
      unless merged_vars.has_key?(name)
        if reason = (else_unreachable ? then_untyped[name]? : (then_unreachable ? else_untyped[name]? : (then_untyped[name]? || else_untyped[name]?)))
          merged_untyped[name] = reason
        end
      end
    end
    @vars = merged_vars
    @untyped_locals = merged_untyped
    nil
  end

  def visit(node : If) : Bool
    @type_filters = nil
    @needs_type_filters = @needs_type_filters + 1
    node.cond.accept(self)
    @needs_type_filters = @needs_type_filters - 1

    cond_vars = @vars
    cond_untyped = @untyped_locals
    cond_type_filters = @type_filters

    @vars = cond_vars.dup
    @untyped_locals = cond_untyped.dup
    @type_filters = nil
    @unreachable = false
    filter_vars(cond_type_filters)
    node.then = splice_def_body(node.then)
    node.then.accept(self)
    then_vars = @vars
    then_untyped = @untyped_locals
    then_type_filters = @type_filters
    then_unreachable = @unreachable

    @vars = cond_vars.dup
    @untyped_locals = cond_untyped.dup
    @type_filters = nil
    @unreachable = false
    filter_vars(TypeFilters.invert(cond_type_filters))
    node.else = splice_def_body(node.else)
    node.else.accept(self)
    else_vars = @vars
    else_untyped = @untyped_locals
    else_type_filters = @type_filters
    else_unreachable = @unreachable

    merge_if_vars(cond_vars, then_vars, else_vars, then_untyped, else_untyped, then_unreachable, else_unreachable)

    @type_filters = nil
    if needs_type_filters?
      if node.from_and
        and_filters = TypeFilters.and_filters(cond_type_filters, then_type_filters)
        then_vars.each_key do |name|
          next if cond_vars.has_key?(name)
          and_filters = TypeFilters.and_filters(and_filters, TypeFilters.truthy(name))
        end
        @type_filters = and_filters
      elsif node.from_or
        @type_filters = TypeFilters.or_filters(cond_type_filters, else_type_filters)
      end
    end

    @unreachable = then_unreachable && else_unreachable

    then_type = child_type(node.then)
    else_type = child_type(node.else)
    if then_type && else_type
      merged = merge_flow(then_type, else_type)
      set_type(node, merged)
    elsif then_type && else_unreachable
      set_type(node, then_type)
    elsif else_type && then_unreachable
      set_type(node, else_type)
    end
    false
  end

  def endless_while_cond?(cond : ASTNode) : Bool
    c = cond
    while c.is_a?(Expressions)
      exps = c.as(Expressions).expressions
      return false unless exps.size == 1
      c = exps[0]
    end
    c.is_a?(BoolLiteral) && c.as(BoolLiteral).value
  end

  def merge_while_vars(endless : Bool, before_cond_vars : Hash(String, Type), after_cond_vars : Hash(String, Type), body_vars : Hash(String, Type), break_vars_list : Array(Hash(String, Type))) : Nil
    after_while = Hash(String, Type).new
    if endless
      if !break_vars_list.empty?
        keys = [] of String
        break_vars_list.each do |bv|
          bv.each_key { |k| keys << k unless keys.includes?(k) }
        end
        keys.each do |name|
          merged : Type? = nil
          all_have = true
          break_vars_list.each do |bv|
            if bt = bv[name]?
              merged = merged ? @program.type_merge(merged.as(Type), bt) : bt
            else
              all_have = false
            end
          end
          if mt = merged
            unless all_have || before_cond_vars.has_key?(name)
              mt = @program.type_merge(mt, @program.nil_type)
              if old_u = @var_unions[name]?
                @var_unions[name] = @program.type_merge(old_u, @program.nil_type)
              end
            end
            after_while[name] = mt
          end
        end
      end
    else
      keys = [] of String
      before_cond_vars.each_key { |k| keys << k unless keys.includes?(k) }
      after_cond_vars.each_key { |k| keys << k unless keys.includes?(k) }
      body_vars.each_key { |k| keys << k unless keys.includes?(k) }
      keys.each do |name|
        bcv = before_cond_vars[name]?
        acv = after_cond_vars[name]?
        wv = body_vars[name]?
        if acv && bcv != acv
          after_while[name] = acv
        elsif bcv && wv
          after_while[name] = bcv == wv ? bcv : @program.type_merge(bcv, wv)
        elsif bcv
          after_while[name] = bcv
        elsif wv
          merged_new = @program.type_merge(wv, @program.nil_type)
          after_while[name] = merged_new
          if old_u = @var_unions[name]?
            @var_unions[name] = @program.type_merge(old_u, @program.nil_type)
          end
        end
      end
      break_vars_list.each do |bv|
        bv.each do |name, bt|
          if existing = after_while[name]?
            after_while[name] = @program.type_merge(existing, bt) unless existing == bt
          else
            after_while[name] = @program.type_merge(bt, @program.nil_type)
          end
        end
      end
    end
    @vars = after_while
    nil
  end

  def visit(node : While) : Bool
    before_cond_vars_copy = @vars.dup
    before_cond_untyped = @untyped_locals.dup
    old_break_types = @break_types
    old_next_types = @next_types
    old_while_unreachable = @unreachable
    @break_types = nil
    @next_types = nil
    node.body = splice_def_body(node.body)

    cond_type_filters : TypeFilters? = nil
    after_cond_vars = before_cond_vars_copy
    body_vars = before_cond_vars_copy
    break_vars_list = [] of Hash(String, Type)

    pass = 0
    while pass < 3
      pass = pass + 1
      pass_start_vars = @vars.dup
      @type_filters = nil
      @needs_type_filters = @needs_type_filters + 1
      node.cond.accept(self)
      @needs_type_filters = @needs_type_filters - 1
      cond_type_filters = @type_filters
      after_cond_vars = @vars.dup

      filter_vars(cond_type_filters)
      @type_filters = nil
      @unreachable = false
      @while_break_vars.push([] of Hash(String, Type))
      @jump_whiles << node
      old_handler_direct_exit = @handler_direct_exit
      @handler_direct_exit = false
      node.body.accept(self)
      @jump_whiles.pop
      @handler_direct_exit = old_handler_direct_exit
      body_vars = @vars
      break_vars_list = @while_break_vars.pop

      changed = false
      next_vars = Hash(String, Type).new
      pass_start_vars.each do |name, start_t|
        if end_t = body_vars[name]?
          if end_t != start_t
            merged_t = @program.type_merge(start_t, end_t)
            if merged_t != start_t
              changed = true
            end
            next_vars[name] = merged_t
          else
            next_vars[name] = start_t
          end
        else
          next_vars[name] = start_t
        end
      end
      break unless changed
      @vars = next_vars
      @untyped_locals = before_cond_untyped.dup
    end

    @break_types = old_break_types
    @next_types = old_next_types
    @type_filters = nil
    @unreachable = old_while_unreachable

    endless_while = endless_while_cond?(node.cond)
    merge_while_vars(endless_while, before_cond_vars_copy, after_cond_vars, body_vars, break_vars_list)

    if break_vars_list.empty?
      if endless_while
        set_type(node, @program.no_return_type)
        @unreachable = true
        return false
      end
      filter_vars(TypeFilters.invert(cond_type_filters))
    end
    set_type(node, @program.nil_type)
    false
  end

  def visit(node : Until) : Bool
    node.cond.accept(self)
    # As in a while: a `break` or `next` in the loop is not the block's.
    old_break_types = @break_types
    old_next_types = @next_types
    @break_types = nil
    @next_types = nil
    node.body.accept(self)
    @break_types = old_break_types
    @next_types = old_next_types
    set_type(node, @program.nil_type)
    false
  end

  def visit(node : Return) : Bool
    if @handler_inside_defer || (@current_def && @current_def.as(Def).iyi_defer?)
      return handler_defer_exit(node, node.from_propagate ? "!" : "return")
    end
    return refuse(node, "can't return from ensure") if @handler_inside_ensure
    value_t : Type? = @program.nil_type
    if exp = node.exp
      exp.accept(self)
      value_t = child_type(exp)
      if value_t.nil?
        # An untyped value makes the def's type untyped (see type_method_body).
        if rts = @return_types
          rts << nil
        end
        @unreachable = true
        return false
      end
      if cd = @current_def
        if rt = cd.return_type
          expected_ret = lookup_under(rt, @scope)
          unless value_t.as(Type).subtype_of?(expected_ret)
            @unreachable = true
            return refuse(node, "type mismatch for return type: expected #{expected_ret.full_name}, got #{value_t.as(Type).full_name}")
          end
        end
      end
    end
    node.target = @current_def
    if rts = @return_types
      rts << value_t
    end
    @unreachable = true
    set_type(node, @program.no_return_type)
    false
  end

  def visit(node : ClassDef) : Bool
    t = @program.lookup_type_path?(node.name, @current_type)
    if t && t.is_a?(ClassType)
      old_type = @current_type
      @current_type = t.as(ClassType)
      node.body.accept(self)
      @current_type = old_type

      cls = t.as(ClassType)
      cls.class_vars.each_value do |cvar|
        if cvar.initializer.nil? && !cvar.type.nilable?
          return refuse(node, "class variable '#{cvar.name}' of #{cls.full_name} is not nilable (it's #{cvar.type.full_name}) so it must have an initializer")
        end
      end
    end
    set_type(node, @program.nil_type)
    false
  end

  def visit(node : ModuleDef) : Bool
    t = @program.lookup_type_path?(node.name, @current_type)
    if t && t.is_a?(ModuleType)
      old_type = @current_type
      @current_type = t.as(ModuleType)
      node.body.accept(self)
      @current_type = old_type

      mod = t.as(ModuleType)
      mod.class_vars.each_value do |cvar|
        if cvar.initializer.nil? && !cvar.type.nilable?
          return refuse(node, "class variable '#{cvar.name}' of #{mod.full_name} is not nilable (it's #{cvar.type.full_name}) so it must have an initializer")
        end
      end
    end
    set_type(node, @program.nil_type)
    false
  end

  # A trait's body is typed in the trait's own type (hosted semantic_visitor.cr 1849-1856).
  def visit(node : TraitDef) : Bool
    t = @program.lookup_type_path?(node.name, @current_type)
    if t && t.is_a?(TraitType)
      old_type = @current_type
      @current_type = t.as(TraitType)
      node.body.accept(self)
      @current_type = old_type
    end
    set_type(node, @program.nil_type)
    false
  end

  def visit(node : Def) : Bool
    set_type(node, @program.nil_type)
    false
  end

  def visit(node : Yield) : Bool
    if yn = @current_yield_nodes
      yn << node
    end
    node.exps.each do |exp|
      exp.accept(self)
    end

    if blk = @current_call_block
      old_vars = @vars
      old_scope = @scope
      blk_vars = if ctx = @current_block_context_vars
                   ctx.dup
                 else
                   @vars.dup
                 end

      i = 0
      while i < blk.args.size
        b_arg = blk.args[i]
        if i < node.exps.size
          if arg_t = child_type(node.exps[i])
            current_arg_t = type_of?(b_arg)
            new_arg_t = if cat = current_arg_t
                          @program.type_merge(cat, arg_t)
                        else
                          arg_t
                        end
            blk_vars[b_arg.name] = new_arg_t
            set_type(b_arg, new_arg_t)
          end
        end
        i = i + 1
      end
      @vars = blk_vars

      # The block's `break`s bind to the call that owns it, its `next`s to the block, and a `return`
      # leaves the def the block is written in (hosted Break, Next, Return).
      old_break_types = @break_types
      old_next_types = @next_types
      old_return_types = @return_types
      old_def_node = @current_def
      @break_types = @block_breaks[blk]?
      @next_types = [] of Type?
      callee_block = @current_call_block
      callee_context_vars = @current_block_context_vars
      callee_yield_nodes = @current_yield_nodes
      callee_type = @current_type
      if owner = @block_owners[blk]?
        @current_def = owner.def_node
        @return_types = owner.return_types
        @current_call_block = owner.call_block
        @current_block_context_vars = owner.context_vars
        @current_yield_nodes = owner.yield_nodes
        if writer_scope = owner.scope
          @scope = writer_scope
        end
        if writer_type = owner.writer_type
          @current_type = writer_type
        end
      else
        @return_types = nil
        @current_call_block = nil
        @current_block_context_vars = nil
        @current_yield_nodes = nil
      end

      callee_imports = @program.current_imports
      callee_import_defs = @program.current_import_defs
      old_yield_type_filters = @type_filters
      old_yield_needs_filters = @needs_type_filters
      old_yield_unreachable = @unreachable
      @type_filters = nil
      @needs_type_filters = 0
      @unreachable = false
      enter_file_scope(blk)
      saved_jump_block = @jump_block
      saved_jump_whiles = @jump_whiles
      @jump_block = blk
      @jump_whiles = [] of While
      old_handler_direct_exit = @handler_direct_exit
      @handler_direct_exit = false
      blk.body.accept(self)
      @current_type = callee_type
      @jump_block = saved_jump_block
      @jump_whiles = saved_jump_whiles
      @handler_direct_exit = old_handler_direct_exit
      @type_filters = old_yield_type_filters
      @needs_type_filters = old_yield_needs_filters
      @unreachable = old_yield_unreachable
      @program.current_imports = callee_imports
      @program.current_import_defs = callee_import_defs
      @current_call_block = callee_block
      @current_block_context_vars = callee_context_vars
      @current_yield_nodes = callee_yield_nodes
      @scope = old_scope
      blk_type = merge_jump_values(child_type(blk.body), @next_types)
      if bt = blk_type
        set_type(blk, bt)
        set_type(node, bt)
      end

      if ctx = @current_block_context_vars
        ctx.keys.each do |k|
          if new_v = @vars[k]?
            ctx[k] = new_v
          end
        end
      end

      @break_types = old_break_types
      @next_types = old_next_types
      @return_types = old_return_types
      @current_def = old_def_node
      @vars = old_vars
      @scope = old_scope

      if bt = blk_type
        if cd = @current_def
          if ba = cd.block_arg
            if r = ba.restriction
              if r.is_a?(ProcNotation)
                pn = r.as(ProcNotation)
                if out_node = pn.output
                  # `& : T -> _` leaves the block's result free (hosted: an Underscore output matches any type).
                  unless out_node.is_a?(Underscore)
                    # Hosted call.cr 1489-1493 restricts the block's result in
                    # the callee's match context, binding an output free variable.
                    if free_names = cd.free_vars
                      if FreeBindings.mentions?(out_node, free_names)
                        bound = @def_free_types[cd]? || Hash(String, Type).new
                        unless FreeBindings.bind(out_node, bt, free_names, bound)
                          return refuse(node, "expected block to return #{out_node}, not #{bt.full_name}")
                        end
                        @def_free_types[cd] = bound
                      end
                    end
                    expected_ret = lookup_under(out_node, @scope)
                    # hosted call.cr 1433 and void_return_type?: a declared Nil or void output accepts any block value.
                    unless expected_ret.nil_type? || expected_ret.is_a?(VoidType) || bt.subtype_of?(expected_ret)
                      return refuse(node, "expected block to return #{expected_ret.full_name}, not #{bt.full_name}")
                    end
                  end
                end
              end
            end
          end
        end
      end
    else
      set_type(node, @program.nil_type)
    end
    false
  end

  def visit(node : Block) : Bool
    node.body.accept(self)
    if bt = child_type(node.body)
      set_type(node, bt)
    end
    false
  end

  # The type a parameter's restriction names for a call on *rec_type*. A generic instance
  # (or its metaclass) binds its type parameters, so `v : T` on Box(Int32) is Int32 and
  # `Pointer(T)` is that pointer, as the hosted MatchContext binds them.
  # A splat restriction (`*T`) is not a type node: lookup_type_node would raise
  # "expected type, got *T". Nil here, so total mode records a refusal instead of aborting.
  def restriction_type(restriction : ASTNode, rec_type : Type) : Type?
    if restriction.is_a?(Splat)
      return nil
    end
    # A union restriction (`String | Path`, `T | Nil`) is each member, bound
    # the way a single name is, then merged. lookup_bound did not instantiate a
    # union node, so a call whose argument is one member was refused
    # "expected type, got String | Path".
    if restriction.is_a?(Union)
      return union_restriction_type(restriction.as(Union), rec_type)
    end
    owner = rec_type
    if owner.is_a?(MetaclassType)
      owner = owner.as(MetaclassType).instance_type
    end
    found = ArgRestriction.lookup_bound(type_node_system(@program), @current_type, restriction, owner)
    return found.as(Type) unless found.is_a?(LookupError)
    nil
  end

  # Each member of a union restriction, bound under the receiver, merged. A
  # member the quiet lookup misses is a total-mode placeholder, so a call still
  # matches the member it does have. Strict mode leaves the refusal.
  def union_restriction_type(node : Union, rec_type : Type) : Type?
    members = [] of Type
    i = 0
    while i < node.types.size
      member = restriction_type(node.types[i], rec_type)
      if member.nil? && @program.total_mode
        member = @program.lookup_type_node(node.types[i], @current_type)
      end
      return nil if member.nil?
      members << member.as(Type)
      i = i + 1
    end
    @program.type_merge(members)
  end

  def collect_candidate_defs(rec_type : Type, name : String, result : Array(Def), visited : Set(String)) : Nil
    return if visited.includes?(rec_type.full_name)
    visited.add(rec_type.full_name)

    if rec_type.is_a?(ModuleType)
      mod = rec_type.as(ModuleType)
      if list = mod.defs[name]?
        list.each { |d| result << d }
      end
      mod.parents.each do |p|
        collect_candidate_defs(p, name, result, visited)
      end
    elsif rec_type.is_a?(GenericInstanceType)
      # A generic instance's defs are its generic type's (Box(Int32) has Box(T)'s initialize).
      collect_candidate_defs(rec_type.as(GenericInstanceType).generic_type, name, result, visited)
    end
  end

  # iyi: what a call with no receiver finds when the type it is written in has no such def: the
  # defs its file imported by name (`import a/b::{parse}`), then the program's own (hosted
  # Call#lookup_matches: `lookup_matches_in_type(program)` after the scope).
  def collect_scope_defs(rec_type : Type, name : String, result : Array(Def), visited : Set(String)) : Nil
    # The hosted call lookup walks lexical unit owners before imported and top-level defs.
    lexical : Type? = @current_type
    while lexical
      current = lexical.as(Type)
      break unless current.is_a?(ModuleType)
      mod = current.as(ModuleType)
      if mod.iyi_unit
        collect_candidate_defs(mod, name, result, Set(String).new)
        break unless result.empty?
      end
      break if mod.is_a?(SemanticProgram)
      lexical = mod.namespace
    end
    return nil unless result.empty?
    if imported = @program.current_import_defs[name]?
      imported.each { |d| result << d }
    end
    if result.empty? && !rec_type.is_a?(SemanticProgram)
      collect_candidate_defs(@program, name, result, visited)
    end
    nil
  end

  def format_method_display_name(rec_type : Type, name : String) : String
    if rec_type.is_a?(SemanticProgram)
      name
    elsif rec_type.is_a?(MetaclassType)
      "#{rec_type.as(MetaclassType).instance_type.full_name}.#{name}"
    else
      "#{rec_type.full_name}##{name}"
    end
  end

  def format_overload_signature(rec_type : Type, d : Def) : String
    args_strs = d.args.map do |arg|
      s = arg.name
      if r = arg.restriction
        s = "#{s} : #{r.to_s}"
      end
      if dv = arg.default_value
        s = "#{s} = #{dv.to_s}"
      end
      s
    end
    method_name = format_method_display_name(rec_type, d.name)
    "#{method_name}(#{args_strs.join(", ")})"
  end

  def min_args_count(d : Def) : Int32
    count = 0
    d.args.each do |arg|
      if arg.default_value.nil?
        count = count + 1
      end
    end
    count
  end

  def def_more_specific?(d1 : Def, d2 : Def, args : Array(ASTNode), owner : Type) : Bool
    # Hosted restrictions.cr:393-414 orders non-splat overloads ahead of splats.
    return false if d1.splat_index && !d2.splat_index
    return true if d2.splat_index && !d1.splat_index
    if a = d1.splat_index
      if b = d2.splat_index
        return a.as(Int32) > b.as(Int32) if a != b
      end
    end
    arg_types = [] of Type
    args.each { |arg| arg_types << type_of(arg) }
    bound1 = FreeBindings.of_def(d1, arg_types, type_node_system(@program))
    bound2 = FreeBindings.of_def(d2, arg_types, type_node_system(@program))
    has_strict = false
    i = 0
    while i < args.size && i < d1.args.size && i < d2.args.size
      break if d1.splat_index == i || d2.splat_index == i
      p1 = d1.args[i]
      p2 = d2.args[i]
      t1 = if r1 = p1.restriction
             comparison_restriction(r1, owner, bound1)
           else
             @program.object_type
           end
      t2 = if r2 = p2.restriction
             comparison_restriction(r2, owner, bound2)
           else
             @program.object_type
           end

      unless t1.subtype_of?(t2)
        return false
      end
      if t1 != t2
        has_strict = true
      end
      i = i + 1
    end
    has_strict
  end

  def comparison_restriction(node : ASTNode, owner : Type, bound : Hash(String, Type)?) : Type
    if bound
      found = ArgRestriction.lookup_free(type_node_system(@program), @current_type, node, owner, bound)
      return found.as(Type) unless found.is_a?(LookupError)
    end
    @program.object_type
  end

  def filter_most_specific_overloads(candidates : Array(Def), args : Array(ASTNode), owner : Type) : Array(Def)
    if candidates.size <= 1
      return candidates
    end

    most_specific = [] of Def
    candidates.each do |cand|
      subsumed = false
      candidates.each do |other|
        if cand != other && def_more_specific?(other, cand, args, owner)
          subsumed = true
          break
        end
      end
      unless subsumed
        most_specific << cand
      end
    end

    if most_specific.empty?
      candidates
    else
      most_specific
    end
  end

  def number_literal_matches_type?(literal : NumberLiteral, target_type : Type) : Bool
    t_name = target_type.full_name
    if t_name == "Number" || t_name == "Value" || t_name == "Object"
      return true
    end

    if target_type.is_a?(UnionType)
      return target_type.as(UnionType).union_types.any? { |ut| number_literal_matches_type?(literal, ut) }
    end

    val = literal.value.to_i?
    return false if val.nil?
    v = val.as(Int32)
    case t_name
    when "Int8"
      v >= -128 && v <= 127
    when "UInt8"
      v >= 0 && v <= 255
    when "Int16"
      v >= -32768 && v <= 32767
    when "UInt16"
      v >= 0 && v <= 65535
    when "Int32"
      true
    when "UInt32"
      v >= 0
    when "Int64", "UInt64", "Int128", "UInt128"
      v >= 0 || t_name.starts_with?("Int")
    when "Float32", "Float64"
      true
    else
      false
    end
  end

  # A splat restriction (`*T`) is not a type node, so the candidate check refuses
  # it. The calls lane binds that splat from the argument types. One match is the
  # def; several matches are not collapsed to the first (the calls lane answers
  # that as not ported). Nil leaves the refusal in place.
  def match_splat_with_calls(rec_type : Type, name : String, args : Array(ASTNode), call_node : Call) : Def?
    arg_types = [] of Type
    i = 0
    while i < args.size
      t = child_type(args[i])
      return nil if t.nil?
      arg_types << t.as(Type)
      i = i + 1
    end
    block_present = false
    if call_node.block
      block_present = true
    end
    signature = CallSignature.new(name, arg_types, nil, block_present)
    target = CallRecalculation.recalculate_signature(rec_type, type_node_system(@program), signature, false, args)
    return nil if target.error
    target.definition
  end

  # The overload a call resolves to, or nil when it cannot: strict mode raises
  # the error, total mode records it on the call and returns nil.
  def lookup_method_matching(rec_type : Type, name : String, args : Array(ASTNode), call_node : Call) : Def?
    i = 0
    while i < args.size
      return nil if child_type(args[i]).nil?
      i = i + 1
    end

    indexer = CallRecalculation.check_tuple_indexer(rec_type, name, args, type_node_system(@program), @current_type)
    return indexer.as(Def) if indexer.is_a?(Def)
    return refuse_call(call_node, indexer) if indexer.is_a?(String)
    candidates = [] of Def
    visited = Set(String).new
    collect_candidate_defs(rec_type, name, candidates, visited)
    collect_scope_defs(rec_type, name, candidates, visited) if candidates.empty? && call_node.obj.nil?
    # Hosted method_lookup.cr:253-256: a call with a block matches only a def
    # that yields, and a call without one matches only a def that does not.
    # Array(T).new(size) is the generated initialize new; Array(T).new(size) { }
    # is the yielding overload. Matching the other leaves the receiver untyped.
    wants_block = !call_node.block.nil?
    write_at = 0
    read_at = 0
    while read_at < candidates.size
      keep = CallMatch.yields?(candidates[read_at]) == wants_block
      if keep
        candidates[write_at] = candidates[read_at]
        write_at += 1
      end
      read_at += 1
    end
    while candidates.size > write_at
      candidates.pop
    end

    if candidates.empty?
      if obj_node = call_node.obj
        obj_t = type_of(obj_node)
        if obj_t.is_a?(UnionType)
          return refuse_call(call_node, "undefined method '#{name}' for #{rec_type.full_name} (compile-time type is #{obj_t.full_name})")
        else
          return refuse_call(call_node, "undefined method '#{name}' for #{rec_type.full_name}")
        end
      else
        scope_name = if rec_type.is_a?(SemanticProgram)
                       "top-level"
                     else
                       rec_type.full_name
                     end
        return refuse_call(call_node, "undefined local variable or method '#{name}' for #{scope_name}")
      end
    end
    # The calls matcher binds splat restrictions as tuples, including an empty
    # argument list; the ordinary positional overload loop cannot resolve *T.
    if candidates.any? { |d| !d.splat_index.nil? }
      if splat_match = match_splat_with_calls(rec_type, name, args, call_node)
        return splat_match
      end
    end

    # 1. Filter by argument count
    count_matches = [] of Def
    candidates.each do |d|
      min_a = min_args_count(d)
      max_a = d.args.size
      if args.size >= min_a && args.size <= max_a
        count_matches << d
      end
    end

    if count_matches.empty?
      if rescued = match_splat_with_calls(rec_type, name, args, call_node)
        return rescued
      end
      overload_lines = candidates.map { |d| " - #{format_overload_signature(rec_type, d)}" }
      overloads_str = "Overloads are:\n#{overload_lines.join("\n")}"
      method_disp = format_method_display_name(rec_type, name)
      expected_str = if candidates.size == 1
                       candidates.first.args.size.to_s
                     else
                       min_all = candidates.map { |d| min_args_count(d) }.min
                       max_all = candidates.map { |d| d.args.size }.max
                       min_all == max_all ? min_all.to_s : "#{min_all}..#{max_all}"
                     end
      return refuse_call(call_node, "wrong number of arguments for '#{method_disp}' (given #{args.size}, expected #{expected_str})\n#{overloads_str}")
    end

    # 2. Check exact / subtype argument matches. A restriction that is not a type
    # node (a splat `*T`) does not match this candidate. If no candidate matches,
    # that failure is a refusal naming the restriction, not a raise: total mode
    # records it and goes on. The calls integration binds the splat; this only
    # stops the abort.
    exact_matches = [] of Def
    unresolved_restriction : String? = nil
    count_matches.each do |d|
      # The restriction is written in the def's file, not the caller's: `Path`
      # in `File.chmod(path : String | Path)` is that file's import.
      old_imports = @program.current_imports
      old_import_defs = @program.current_import_defs
      old_candidate_type = @current_type
      if owner = @program.def_owner(d)
        @current_type = owner if owner.iyi_unit
      end
      enter_file_scope(d)
      all_args_match = true
      i = 0
      while i < args.size
        arg_type = type_of(args[i])
        param = d.args[i]
        if r = param.restriction
          expected = restriction_type(r, rec_type)
          if expected.nil?
            all_args_match = false
            unresolved_restriction = "expected type, got #{r.to_s}"
            break
          end
          unless arg_type.subtype_of?(expected.as(Type))
            all_args_match = false
            break
          end
        end
        i = i + 1
      end
      @current_type = old_candidate_type
      @program.current_imports = old_imports
      @program.current_import_defs = old_import_defs
      if all_args_match
        exact_matches << d
      end
    end

    if exact_matches.size > 0
      most_specific = filter_most_specific_overloads(exact_matches, args, rec_type)
      return most_specific.first
    end

    # The shared matcher handles splats, free variables and numeric widening
    # for both number literals and typed integers.
    arg_types = [] of Type
    args.each { |arg| arg_types << type_of(arg) }
    signature = CallSignature.new(name, arg_types, nil, call_node.block != nil)
    widened = CallRecalculation.recalculate_signature(rec_type, type_node_system(@program), signature, false, args)
    if widened.error.nil? && widened.definition
      @matched_call_args[call_node] = widened.arg_types
      return widened.definition
    end
    if message = widened.error
      if message.starts_with?("ambiguous call")
        return refuse_call(call_node, message)
      end
    end
    if ur = unresolved_restriction
      return refuse_call(call_node, ur)
    end

    # 4. Error reporting for no matching overload
    all_same_mismatch = true
    mismatch_idx = -1
    count_matches.each do |d|
      first_mismatch = -1
      i = 0
      while i < args.size
        arg_t = type_of(args[i])
        param = d.args[i]
        if r = param.restriction
          exp_t = lookup_under(r, rec_type)
          unless arg_t.subtype_of?(exp_t)
            first_mismatch = i
            break
          end
        end
        i = i + 1
      end
      if mismatch_idx == -1
        mismatch_idx = first_mismatch
      elsif mismatch_idx != first_mismatch
        all_same_mismatch = false
      end
    end

    method_disp = format_method_display_name(rec_type, name)
    overload_lines = count_matches.map { |d| " - #{format_overload_signature(rec_type, d)}" }
    overloads_str = "Overloads are:\n#{overload_lines.join("\n")}"

    if all_same_mismatch && mismatch_idx != -1
      expected_types_list = [] of String
      count_matches.each do |d|
        param = d.args[mismatch_idx]
        if r = param.restriction
          exp_t = lookup_under(r, rec_type)
          expected_types_list << exp_t.full_name
        end
      end
      uniq_exp = [] of String
      expected_types_list.each do |en|
        uniq_exp << en unless uniq_exp.includes?(en)
      end
      expected_types_str = uniq_exp.join(" or ")
      actual_type_str = type_of(args[mismatch_idx]).full_name
      refuse_call(call_node, "expected argument ##{mismatch_idx + 1} to '#{method_disp}' to be #{expected_types_str}, not #{actual_type_str}\n\n#{overloads_str}")
    else
      arg_types_strs = args.map { |a| type_of(a).full_name }
      plural = (args.size > 1) ? "s" : ""
      refuse_call(call_node, "no overload matches '#{method_disp}' with type#{plural} #{arg_types_strs.join(", ")}\n\n#{overloads_str}")
    end
  end

  # A call the port cannot resolve: strict mode raises, total mode records the
  # reason on the call and answers nil.
  def refuse_call(call_node : Call, message : String) : Nil
    refuse(call_node, message)
    nil
  end

  # The key of one instantiation: the receiver, the def name and the argument
  # types, and for a block call the block's node. Two calls with different blocks
  # are different instantiations (a block nested in another call's block is not a
  # recursion of that call); the same call with the same block is.
  def instance_key(rec_type : Type, target_def : Def, args : Array(ASTNode), block : Block?) : String
    parts = [] of String
    args.each do |a|
      if at = child_type(a)
        parts << at.full_name
      else
        parts << "?"
      end
    end
    key = "#{rec_type.full_name}##{target_def.name}(#{parts.join(",")})"
    if block
      key = key + "&#{block.node_id}"
    end
    key
  end

  # The key of a cached instantiation (hosted Call#instantiate, def_instance_key). It names the
  # def by its original's identity (the clone is what is typed), the receiver, and the argument
  # types. Nil when the call cannot share an instance: an argument has no type yet, the call has
  # named arguments, or it passes a block to a def that does not take one (hosted
  # `use_cache = !block || match.def.block_arg`).
  def def_instance_key(origin : Def, rec_type : Type, call_node : Call) : String?
    return nil if call_node.named_args
    block = call_node.block
    return nil if block && origin.block_arg.nil?
    parts = [] of String
    i = 0
    while i < call_node.args.size
      at = child_type(call_node.args[i])
      return nil if at.nil?
      parts << at.full_name
      i = i + 1
    end
    key = "#{origin.node_id}|#{rec_type.full_name}(#{parts.join(",")})"
    if blk = block
      key = key + "&#{blk.node_id}"
    end
    key
  end

  # The cached instance for a key, or nil when there is none.
  def cached_instance(key : String?) : DefInstance?
    if k = key
      return @def_instances[k]?
    end
    nil
  end

  # Caches a finished instance, including one with a refused body and a declared
  # return type. Its recorded refusals remain attached to the cached definition.
  def remember_def_instance(key : String?, definition : Def, return_type : Type) : Nil
    if k = key
      @def_instances[k] = DefInstance.new(definition, return_type)
    end
    nil
  end

  # A recursive call or an over-deep instantiation is refused at the call site, or
  # at the def's body when there is no site.
  def refuse_recursion(site : ASTNode?, target_def : Def, message : String) : Type?
    anchor : ASTNode = target_def.body.as(ASTNode)
    if s = site
      anchor = s
    end
    refuse(anchor, message)
    nil
  end

  # The type a body evaluates to with `args` bound to its parameters, or nil when
  # the body or an argument cannot be typed. `site` is the node that reports a
  # return-type mismatch.
  # `cache_key` (see def_instance_key) caches the finished instance; nil caches nothing.
  def type_method_body(target_def : Def, rec_type : Type, args : Array(ASTNode), block : Block?, site : ASTNode? = nil, cache_key : String? = nil, call_node : Call? = nil) : Type?
    old_imports = @program.current_imports
    old_import_defs = @program.current_import_defs
    enter_file_scope(target_def)
    old_current_type = @current_type
    body_receiver = rec_type
    if owner = @program.def_owner(target_def)
      body_receiver = owner if owner.iyi_unit
    end
    enter_owner_scope(body_receiver)
    result = type_method_body_in_file(target_def, body_receiver, args, block, site, cache_key, old_current_type, call_node)
    @current_type = old_current_type
    @program.current_imports = old_imports
    @program.current_import_defs = old_import_defs
    result
  end

  # iyi: a body's constants are looked up from the type the def is called on, not from the type the
  # call is written in (hosted: the def's self type). A generic instance's constants are its generic
  # type's, and a metaclass names its instance type: `SIZE` in a class method of Hdr is Hdr's whatever
  # class calls it.
  def enter_owner_scope(rec_type : Type) : Nil
    owner : Type = rec_type
    if owner.is_a?(MetaclassType)
      owner = owner.as(MetaclassType).instance_type
    end
    if owner.is_a?(GenericInstanceType)
      owner = owner.as(GenericInstanceType).generic_type
    end
    if owner.is_a?(ModuleType)
      @current_type = owner.as(ModuleType)
    end
    nil
  end

  # iyi: the names a node's file imported become the names in scope (SPEC.md R-2b). A node with
  # no location (a generated def) keeps the scope it is typed from.
  def enter_file_scope(node : ASTNode) : Nil
    if loc = node.location
      @program.current_imports = @program.file_imports[loc.filename]? || Hash(String, Type).new
      @program.current_import_defs = @program.file_import_defs[loc.filename]? || Hash(String, Array(Def)).new
    end
    nil
  end

  # Return annotations belong to the callee's match context, not the caller's.
  def lookup_def_return(node : ASTNode, owner : Type, definition : Def) : Type
    saved_def = @current_def
    @current_def = definition
    result = lookup_under(node, owner)
    @current_def = saved_def
    result
  end

  def type_method_body_in_file(target_def : Def, rec_type : Type, args : Array(ASTNode), block : Block?, site : ASTNode?, cache_key : String?, writer_type : ModuleType, call_node : Call?) : Type?
    # Hosted call.cr binds the match's free variables from the call arguments,
    # including for primitive and recursive definitions with no body to visit.
    call_arg_types = [] of Type
    args.each do |call_arg|
      if call_arg_type = child_type(call_arg)
        call_arg_types << call_arg_type
      end
    end
    if call_arg_types.size == args.size
      if free_types = FreeBindings.of_def(target_def, call_arg_types, type_node_system(@program))
        @def_free_types[target_def] = free_types unless free_types.empty?
      end
    end
    # A captured block is typed in its writer before the callee body. Its output
    # binds the match context used by the callee's body and return annotation
    # (hosted call.cr 1259-1293, 1336-1432).
    captured_block_type : Type? = nil
    if target_def.uses_block_arg?
      if blk = block
        if ba = target_def.block_arg
          if restriction = ba.restriction
            if restriction.is_a?(ProcNotation)
              notation = restriction.as(ProcNotation)
              input_types = [] of Type
              if inputs = notation.inputs
                inputs.each { |input| input_types << lookup_def_return(input, rec_type, target_def) }
              end
              if existing = blk.fun_literal
                captured_block_type = child_type(existing)
              else
                saved_vars = @vars
                saved_type = @current_type
                saved_imports = @program.current_imports
                saved_import_defs = @program.current_import_defs
                @vars = @vars.dup
                blk.args.each_with_index do |arg, index|
                  if index < input_types.size
                    @vars[arg.name] = input_types[index]
                    set_type(arg, input_types[index])
                  end
                end
                @current_type = writer_type
                enter_file_scope(blk)
                blk.body.accept(self)
                block_type = child_type(blk.body)
                @vars = saved_vars
                @current_type = saved_type
                @program.current_imports = saved_imports
                @program.current_import_defs = saved_import_defs
                if bt = block_type
                  resolved_output : Type? = nil
                  if output = notation.output
                    free_output = false
                    if output.is_a?(Path)
                      if free_names = target_def.free_vars
                        names = output.as(Path).names
                        free_output = names.size == 1 && free_names.includes?(names[0])
                      end
                    end
                    if free_output
                      # Hosted call.cr 1442-1446 leaves this Block unbound;
                      # fix_missing_types.cr 66-75 later makes it NoReturn.
                      # The result is the literal's Proc return type, not the Block type.
                      set_type(blk, @program.no_return_type)
                    else
                      resolved_output = lookup_def_return(output, rec_type, target_def)
                      set_type(blk, resolved_output.as(Type))
                    end
                    if free_names = target_def.free_vars
                      bound = @def_free_types[target_def]? || Hash(String, Type).new
                      if FreeBindings.bind(output, bt, free_names, bound)
                        @def_free_types[target_def] = bound unless bound.empty?
                      end
                    end
                  end
                  result_type = resolved_output || bt
                  literal_args = [] of Arg
                  input_types.each_with_index do |input_type, index|
                    name = index < blk.args.size ? blk.args[index].name : "__arg#{index}"
                    literal_arg = Arg.new(name)
                    set_type(literal_arg, input_type)
                    literal_args << literal_arg
                  end
                  literal_def = Def.new("->", literal_args, blk.body).at(blk)
                  literal_def.captured_block = true
                  literal = ProcLiteral.new(literal_def)
                  if call = call_node
                    literal.at(call)
                  end
                  captured_block_type = ProcInstanceType.new(@program, input_types, result_type)
                  set_type(literal_def, result_type)
                  set_type(literal, captured_block_type.as(Type))
                  blk.fun_literal = literal
                end
              end
            end
          end
        end
      end
    end
    body = target_def.body
    if body.nil? || body.is_a?(MacroLiteral)
      if rt = target_def.return_type
        return lookup_def_return(rt, rec_type, target_def)
      else
        return @program.nil_type
      end
    end

    # A requirement supplies a return contract. Keep its absent implementation out
    # of the typed-instance cache and the lowering probes.
    if target_def.abstract
      if rt = target_def.return_type
        return lookup_def_return(rt, rec_type, target_def)
      end
      anchor : ASTNode = target_def.body.as(ASTNode)
      if s = site
        anchor = s
      elsif c = call_node
        anchor = c
      end
      refuse(anchor, "cannot resolve the call to abstract def '#{target_def.name}': it declares no return type, and dispatch to its implementers is not ported")
      return nil
    end

    # A def typed again while its body is being typed is a recursive call: it takes
    # the declared return type, or the call is refused. The depth bounds a chain of
    # instantiations whose argument types keep growing.
    key = instance_key(rec_type, target_def, args, block)
    if @typing_stack.includes?(key)
      if rt = target_def.return_type
        return lookup_def_return(rt, rec_type, target_def)
      end
      # No declared return type: until the body's own type is known the recursive
      # call contributes nothing to a merge, so it is NoReturn (the bottom of the
      # merge). The hosted pass gets the same answer from the non-recursive returns
      # (bench/fixtures/sem_bodies_recursive.iyi: count(true) is Int32).
      return @program.no_return_type
    end
    if @typing_stack.size >= 256
      return refuse_recursion(site, target_def, "instantiation depth exceeded at '#{target_def.name}'")
    end

    saved_jump_block = @jump_block
    saved_jump_whiles = @jump_whiles
    @jump_block = nil
    @jump_whiles = [] of While
    old_vars = @vars
    old_handler_vars = @handler_vars
    old_handler_writes = @handler_writes
    @handler_vars = [] of Hash(String, Type)
    @handler_writes = [] of Set(String)
    old_handler_inside_ensure = @handler_inside_ensure
    old_handler_inside_defer = @handler_inside_defer
    old_handler_direct_exit = @handler_direct_exit
    @handler_inside_ensure = false
    @handler_inside_defer = false
    @handler_direct_exit = false
    old_scope = @scope
    old_def = @current_def
    old_block_call = @current_call_block
    old_block_context_vars = @current_block_context_vars
    old_yield_nodes = @current_yield_nodes
    old_var_unions = @var_unions
    old_untyped_locals = @untyped_locals
    @untyped_locals = Hash(String, String).new
    @var_unions = Hash(String, Type).new
    old_break_types = @break_types
    old_next_types = @next_types
    old_return_types = @return_types
    old_type_filters = @type_filters
    old_needs_type_filters = @needs_type_filters
    old_unreachable = @unreachable
    @type_filters = nil
    @needs_type_filters = 0
    @unreachable = false
    old_while_break_vars = @while_break_vars
    @while_break_vars = [] of Array(Hash(String, Type))
    @break_types = nil
    @next_types = nil
    @return_types = [] of Type?

    if block
      @current_block_context_vars = @vars.dup
      @current_yield_nodes = [] of Yield
      if blk = block
        @block_owners[blk] = BlockOwner.new(@current_def, old_return_types, old_block_call, old_block_context_vars, old_yield_nodes, old_scope, writer_type)
      end
    end

    new_vars = Hash(String, Type).new
    if rec_type.is_a?(MetaclassType)
      new_vars["self"] = rec_type
    elsif rec_type.is_a?(SemanticProgram)
      # No self at top-level
    else
      new_vars["self"] = rec_type
    end

    inst_args = [] of Type
    params_typed = true
    i = 0
    while i < target_def.args.size
      param = target_def.args[i]
      param_type : Type? = nil
      splat_index = target_def.splat_index
      if splat_index && i == splat_index.as(Int32)
        # Hosted call.cr binds the splat local to a tuple, including the empty tuple.
        elements = [] of Type
        suffix = target_def.args.size - i - 1
        end_index = args.size - suffix
        j = i
        while j < end_index
          if element_type = child_type(args[j])
            elements << element_type
          else
            params_typed = false
          end
          j = j + 1
        end
        param_type = tuple_type_of(@program, elements)
      elsif splat_index && i > splat_index.as(Int32)
        arg_index = args.size - (target_def.args.size - i)
        param_type = child_type(args[arg_index]) if arg_index >= 0 && arg_index < args.size
      elsif i < args.size
        param_type = child_type(args[i])
        if call_node
          if matched = @matched_call_args[call_node]?
            param_type = matched[i] if i < matched.size
          end
        end
      elsif dv = param.default_value
        dv.accept(self)
        param_type = child_type(dv)
      elsif r = param.restriction
        param_type = lookup_under(r, rec_type)
      else
        param_type = @program.nil_type
      end
      if pt = param_type
        new_vars[param.name] = pt
        inst_args << pt
        # iyi: the instantiated clone's parameter carries its type, so the lowering
        # reads the argument types from the def (hosted codegen/ast.cr 48).
        set_type(param, pt)
        if param.name.starts_with?("@") && !param.name.starts_with?("@@")
          if rec_type.is_a?(ModuleType)
            rec_type.as(ModuleType).instance_vars[param.name] = MetaTypeVar.new(param.name, pt)
          end
        end
      else
        params_typed = false
      end
      i = i + 1
    end
    if bt = captured_block_type
      if ba = target_def.block_arg
        new_vars[ba.name] = bt
        set_type(ba, bt)
      end
    end
    @vars = new_vars
    @scope = rec_type
    @current_def = target_def
    @current_call_block = block

    @typing_stack << key
    if params_typed
      self_t : Type? = nil
      unless rec_type.is_a?(SemanticProgram)
        self_t = rec_type
      end
      @typed_instances << TypedInstance.new(target_def, self_t, inst_args)
      # Hosted Call#instantiate registers the typed def before visiting its body
      # (semantic/call.cr 628-630, body at 714). A recursive call must target this
      # object, whose parameters already carry their instantiated types, not a fresh clone.
      provisional : Type = @program.no_return_type
      if declared = target_def.return_type
        provisional = lookup_def_return(declared, rec_type, target_def)
      end
      set_type(target_def, provisional)
      remember_def_instance(cache_key, target_def, provisional)
    end
    body = splice_def_body(body.as(ASTNode))
    target_def.body = body.as(ASTNode)
    body.as(ASTNode).accept(self)
    body_type = merge_jump_values(child_type(body.as(ASTNode)), @return_types)

    if block && (ctx_vars = @current_block_context_vars)
      ctx_vars.each do |k, new_v|
        if old_v = old_vars[k]?
          if old_v != new_v
            old_vars[k] = @program.type_merge(old_v, new_v)
          end
        end
      end
    end

    if block
      if final_blk_t = child_type(block)
        if y_nodes = @current_yield_nodes
          y_nodes.each do |ynode|
            set_type(ynode, final_blk_t)
          end
        end
      end
    end

    @break_types = old_break_types
    @next_types = old_next_types
    @return_types = old_return_types
    @vars = old_vars
    @handler_vars = old_handler_vars
    @handler_writes = old_handler_writes
    @handler_inside_ensure = old_handler_inside_ensure
    @handler_inside_defer = old_handler_inside_defer
    @handler_direct_exit = old_handler_direct_exit
    @scope = old_scope
    @current_def = old_def
    @current_call_block = old_block_call
    @current_block_context_vars = old_block_context_vars
    @current_yield_nodes = old_yield_nodes
    @def_var_unions[target_def] = @var_unions
    @var_unions = old_var_unions
    @untyped_locals = old_untyped_locals
    @type_filters = old_type_filters
    @needs_type_filters = old_needs_type_filters
    @unreachable = old_unreachable
    @while_break_vars = old_while_break_vars
    @jump_block = saved_jump_block
    @jump_whiles = saved_jump_whiles
    @typing_stack.pop

    return nil unless params_typed
    bt = body_type
    # A body that cannot be typed (its refusal is recorded on the body's own nodes)
    # still leaves a call its declared return type, as the oracle types it
    # (bench/fixtures/sem_bodies_primitive_add.iyi).
    if bt.nil?
      if rt = target_def.return_type
        declared_ret = lookup_def_return(rt, rec_type, target_def)
        set_type(target_def, declared_ret)
        remember_def_instance(cache_key, target_def, declared_ret)
        return declared_ret
      end
      return nil
    end

    if rt = target_def.return_type
      declared_ret = lookup_def_return(rt, rec_type, target_def)
      # A Nil annotation discards the body's value; a body that never returns
      # still gives the def NoReturn (hosted bindings.cr Def#map_type).
      if declared_ret.nil_type? && bt.is_a?(NoReturnType)
        set_type(target_def, bt)
        remember_def_instance(cache_key, target_def, bt)
        return bt
      end
      unless declared_ret.nil_type? || bt.subtype_of?(declared_ret)
        mismatch = "type mismatch for return type: expected #{declared_ret.full_name}, got #{bt.full_name}"
        if s = site
          refuse(s, mismatch)
        else
          refuse(body.as(ASTNode), mismatch)
        end
        return nil
      end
      set_type(target_def, declared_ret)
      remember_def_instance(cache_key, target_def, declared_ret)
      declared_ret
    else
      set_type(target_def, bt)
      remember_def_instance(cache_key, target_def, bt)
      bt
    end
  end

  # iyi: `out x` in a lib call declares `x` as the parameter's pointee (see declare_out). Visited
  # alone it declares nothing: the call does. An instance variable is visited for its own type;
  # `out _` has no type.
  def visit(node : Out) : Bool
    if exp = node.exp
      if exp.is_a?(InstanceVar)
        exp.accept(self)
      end
    end
    false
  end

  # A call on a lib (`LibC.name(args)`), the port of Call#recalculate_lib_call. The arguments are
  # typed by the walk in visit(Call); the lib call checks them (semantic/lib_call.iyi), answers the
  # result type, and marks the lib and the fun used. Its record is kept for the lowering.
  def visit_lib_call(node : Call, lib_type : LibType) : Bool
    args = [] of LibCallArgument
    node.args.each do |arg|
      args << LibCallArgument.new(arg, type_of?(arg), nil)
    end
    if named = node.named_args
      named.each do |na|
        na.value.accept(self)
        args << LibCallArgument.new(na.value, type_of?(na.value), na.name)
      end
    end
    target = LibCall.recalculate(lib_type, @program, type_node_system(@program), node.name, args)
    record_lib_call(node, target)
  end

  # A call with no receiver that names a `fun` the program declares at its top level
  # (`__iyi_enter(argc, argv)`). The hosted pass adds such a fun to the program as an External
  # def and the call finds it by ordinary lookup; the port keeps it in `global_funs` and records
  # the call as a lib call, which is what the lowering emits for an External: a C call.
  def visit_global_fun_call(node : Call, lib_fun : LibFun) : Bool
    args = [] of LibCallArgument
    node.args.each do |arg|
      args << LibCallArgument.new(arg, type_of?(arg), nil)
    end
    if named = node.named_args
      named.each do |na|
        na.value.accept(self)
        args << LibCallArgument.new(na.value, type_of?(na.value), na.name)
      end
    end
    target = LibCall.recalculate_fun(lib_fun, node.name, @program, type_node_system(@program), args)
    record_lib_call(node, target)
  end

  # The fun the program declares at its top level under *name*, or nil.
  def global_fun_named(name : String) : LibFun?
    funs = @program.global_funs
    i = 0
    while i < funs.size
      return funs[i] if funs[i].name == name
      i += 1
    end
    nil
  end

  def record_lib_call(node : Call, target : LibCallTarget) : Bool
    if msg = target.error
      return refuse(node, msg)
    end
    @lib_call_targets[node] = target
    i = 0
    while i < target.out_index.size
      out_node = target.arg_nodes[target.out_index[i]].as(Out)
      declare_out(out_node, target.out_type[i])
      i += 1
    end
    set_type(node, target.result_type.as(Type))
    @unreachable = true if target.result_type.as(Type).is_a?(NoReturnType)
    @type_filters = nil
    false
  end

  # The variable an `out` argument names takes the parameter's pointee type. As the hosted pass
  # does, a name the body already has is refused: `out` defines a variable.
  def declare_out(out_node : Out, pointee : Type) : Nil
    exp = out_node.exp
    return nil unless exp.is_a?(Var)
    name = exp.as(Var).name
    if @vars[name]?
      refuse(out_node, "variable '#{name}' is already defined, `out` must be used to define a variable, use another name")
      return nil
    end
    @vars[name] = pointee
    if old_u = @var_unions[name]?
      @var_unions[name] = @program.type_merge(old_u, pointee)
    else
      @var_unions[name] = pointee
    end
    set_type(exp, pointee)
    set_type(out_node, pointee)
    nil
  end

  # The lib call record of a call on a lib (see visit_lib_call), or nil.
  def lib_call_target(node : Call) : LibCallTarget?
    @lib_call_targets[node]?
  end

  # The type of a body, block or call with the values its jumps carry merged in (hosted: `return`
  # binds to the def, `next` to the block). An untyped value makes the whole untyped.
  def merge_jump_values(base : Type?, values : Array(Type?)?) : Type?
    vs = values
    return base if vs.nil?
    return base if vs.empty?
    b = base
    return nil if b.nil?
    result : Type = b.as(Type)
    i = 0
    while i < vs.size
      v = vs[i]
      return nil if v.nil?
      result = merge_flow(result, v.as(Type))
      i += 1
    end
    result
  end

  # The type of a call: its method's result, with the values its block's `break`s carry merged in.
  def call_result(node : Call, ret : Type?) : Type?
    if blk = node.block
      return merge_jump_values(ret, @block_breaks[blk]?)
    end
    ret
  end

  # `obj.@name`: the instance variable of obj's type (hosted visit_read_instance_var).
  def visit(node : ReadInstanceVar) : Bool
    node.obj.accept(self)
    ot = child_type(node.obj)
    return false if ot.nil?
    owner : Type = ot.as(Type)
    if owner.is_a?(ModuleType)
      if ivar = owner.as(ModuleType).lookup_instance_var?(node.name)
        set_type(node, ivar.type)
        return false
      end
    end
    refuse(node, "undefined instance variable '#{node.name}' for #{owner.full_name}")
  end

  # Hosted codegen expands an omitted magic default at the call, not at the def.
  # The literal is this call's coordinates, typed as the literal it is.
  def materialized_magic(node : Call, magic : MagicConstant) : ASTNode
    literal = magic.expand_node(node.location, node.end_location).at(node)
    literal.accept(self)
    literal
  end

  # Fill a trailing run of magic defaults from this call's coordinates.
  def defaults_magic_arguments(node : Call, target_def : Def) : Bool
    i = node.args.size
    while i < target_def.args.size
      value = target_def.args[i].default_value
      return false unless value.is_a?(MagicConstant)
      node.args << materialized_magic(node, value.as(MagicConstant))
      i += 1
    end
    true
  end

  # After wrapper selection, every omitted magic default is a literal of this call.
  # A named expansion clones the raw default; materialize that clone before visiting it.
  def defaults_expand_call(node : Call, definition : Def) : Def?
    target = definition
    if named = node.named_args
      if DefaultArguments.supported?(definition, node.args, named)
        original = node.args.size
        node.args = DefaultArguments.expand(definition, node.args, named)
        i = original
        while i < node.args.size
          arg = node.args[i]
          if arg.is_a?(MagicConstant)
            arg = materialized_magic(node, arg.as(MagicConstant))
            node.args[i] = arg
          else
            arg.accept(self)
          end
          i += 1
        end
        return definition
      end
    end
    if node.named_args.nil? && (target.splat_index || (node.args.size < target.args.size && DefaultArguments.supported?(target, node.args, nil)))
      splat_names = [] of String
      if splat_index = target.splat_index
        count = node.args.size - splat_index
        names = NormalizerProgram.new
        while count > 0
          splat_names << names.new_temp_var_name("$splat_")
          count -= 1
        end
      end
      expanded = DefaultArguments.expand_for_call(target, node.args.size, nil, splat_names)
      if expanded.is_a?(String)
        refuse_call(node, expanded)
        return nil
      end
      expanded.at(target)
      @program.copy_def_owner(target, expanded)
      target = expanded
    end
    if node.args.size < target.args.size && !defaults_magic_arguments(node, target)
      refuse_call(node, "not ported: omitted non-magic argument")
      return nil
    end
    target
  end

  def defaults_bind_splat(definition : Def, instantiated : Def, args : Array(ASTNode)) : Nil
    if definition.splat_index && definition.free_vars
      arg_types = [] of Type
      args.each do |arg|
        if arg_type = child_type(arg)
          arg_types << arg_type
        end
      end
      if arg_types.size == args.size
        if free_types = FreeBindings.of_def(definition, arg_types, type_node_system(@program))
          target_def = instantiated
          @def_free_types[target_def] = free_types unless free_types.empty?
        end
      end
    end
  end

  def visit(node : Call) : Bool
    if block = node.block
      @jump_block_calls[block] = node
    end
    if expand_macro(node)
      return false
    end

    if !node.global && !node.has_parentheses && node.obj.nil? && node.args.empty? && node.named_args.nil? && node.block.nil? && node.block_arg.nil?
      if vt = @vars[node.name]?
        # A macro can leave a bare local name as Call syntax. Keep the resolved
        # variable read for lowering; it has no method target.
        local_read = Var.new(node.name).at(node)
        set_type(local_read, vt)
        @expansions[node] = local_read
        set_type(node, vt)
        if needs_type_filters?
          @type_filters = TypeFilters.truthy(node.name)
        end
        return false
      end
    end

    saved_call_ntf = @needs_type_filters
    @needs_type_filters = 0
    rec_type : Type
    if obj = node.obj
      obj.accept(self)
      if ot = child_type(obj)
        rec_type = ot
      else
        @needs_type_filters = saved_call_ntf
        @type_filters = nil
        return false
      end
    else
      rec_type = @scope || @current_type
    end
    node.args.each do |arg|
      arg.accept(self)
    end
    @needs_type_filters = saved_call_ntf
    if rec_type.is_a?(LibType)
      return visit_lib_call(node, rec_type.as(LibType))
    end

    # Multiple dispatch over a union receiver
    if rec_type.is_a?(UnionType)
      union_t = rec_type.as(UnionType)
      ret_types = [] of Type
      first_target_def : Def? = nil
      supplied_args = node.args.dup
      expanded_args : Array(ASTNode)? = nil

      if blk = node.block
        @block_breaks[blk] = [] of Type?
      end
      i = 0
      while i < union_t.union_types.size
        node.args = supplied_args.dup
        ut = union_t.union_types[i]
        target_def = lookup_method_matching(ut, node.name, node.args, node)
        return false if target_def.nil?
        original_def = target_def
        union_instance_owner : Type = ut
        if node.obj.nil?
          if declared_owner = @program.def_owner(target_def)
            union_instance_owner = declared_owner if declared_owner.is_a?(SemanticProgram)
          end
        end
        dkey = def_instance_key(target_def, union_instance_owner, node)
        expanded = defaults_expand_call(node, target_def)
        return false if expanded.nil?
        target_def = expanded
        if previous_args = expanded_args
          if previous_args.map(&.to_s) != node.args.map(&.to_s)
            refuse_call(node, "not ported: differing union call-site defaults")
            return false
          end
        else
          expanded_args = node.args
        end
        instantiated_def = target_def.clone
        defaults_bind_splat(original_def, instantiated_def, supplied_args)
        @program.copy_def_owner(target_def, instantiated_def)
        ret_t : Type? = nil
        if hit = cached_instance(dkey)
          instantiated_def = hit.definition
          ret_t = hit.return_type
        else
          ret_t = type_method_body(instantiated_def, union_instance_owner, node.args, node.block, node, dkey, node)
        end
        return false if ret_t.nil?
        if first_target_def.nil?
          first_target_def = instantiated_def
        end
        ret_types << ret_t
        i = i + 1
      end
      node.args = expanded_args || supplied_args

      if td = first_target_def
        @call_target_defs[node] = td
      end

      merged_ret = @program.type_merge(ret_types)
      if merged_call_t = call_result(node, merged_ret)
        set_type(node, merged_call_t)
        @unreachable = true if merged_call_t.is_a?(NoReturnType)
      end
      @type_filters = nil
      return false
    end

    if node.obj.nil?
      if global_fun = global_fun_named(node.name)
        own = [] of Def
        seen = Set(String).new
        collect_candidate_defs(rec_type, node.name, own, seen)
        collect_scope_defs(rec_type, node.name, own, seen) if own.empty?
        return visit_global_fun_call(node, global_fun) if own.empty?
      end
    end

    target_def = lookup_method_matching(rec_type, node.name, node.args, node)
    return false if target_def.nil?
    original_def = target_def
    # A receiverless fallback to a program def is instantiated by the program,
    # not by the type that happened to call it. Methods retain the actual
    # receiver, including generic instances and inherited methods.
    instance_owner : Type = rec_type
    if node.obj.nil?
      if declared_owner = @program.def_owner(original_def)
        instance_owner = declared_owner if declared_owner.is_a?(SemanticProgram)
      end
    end
    dkey = def_instance_key(original_def, instance_owner, node)
    expanded = defaults_expand_call(node, original_def)
    return false if expanded.nil?
    target_def = expanded
    instantiated_def = target_def.clone
    defaults_bind_splat(original_def, instantiated_def, node.args)
    @program.copy_def_owner(target_def, instantiated_def)
    body_ret : Type? = nil
    if hit = cached_instance(dkey)
      # A cached instance: the call records its clone and takes its return type. Its block breaks
      # are the ones the block already collected, so they are kept.
      instantiated_def = hit.definition
      @call_target_defs[node] = instantiated_def
      body_ret = hit.return_type
    else
      @call_target_defs[node] = instantiated_def
      if blk = node.block
        @block_breaks[blk] = [] of Type?
      end
      body_ret = type_method_body(instantiated_def, instance_owner, node.args, node.block, nil, dkey, node)
    end
    ret_type = call_result(node, body_ret)
    if ret_type
      set_type(node, ret_type)
      @unreachable = true if ret_type.is_a?(NoReturnType)
    end
    @type_filters = nil
    false
  end

  # A tuple literal is the tuple of its elements' types (hosted visit(TupleLiteral)).
  def visit(node : TupleLiteral) : Bool
    types = [] of Type
    i = 0
    while i < node.elements.size
      e = node.elements[i]
      e.accept(self)
      if et = child_type(e)
        types << et
      else
        return false
      end
      i = i + 1
    end
    set_type(node, tuple_type_of(@program, types))
    false
  end

  # A named tuple literal is the named tuple of its entries' types (hosted
  # visit(NamedTupleLiteral)).
  def visit(node : NamedTupleLiteral) : Bool
    entries = [] of NamedArgumentType
    i = 0
    while i < node.entries.size
      entry = node.entries[i]
      entry.value.accept(self)
      if et = child_type(entry.value)
        entries << NamedArgumentType.new(entry.key, et)
      else
        return false
      end
      i = i + 1
    end
    set_type(node, named_tuple_type_of(@program, entries))
    false
  end

  # --- asm: begin ---
  # Hosted visit(node : Asm) (main_visitor.cr 3605-3620). Each output is typed
  # through `pointerof` of its expression, each input expression is typed, and
  # the node is Void. The hosted compiler's other-language mode, the removed
  # interpreter, and exception typing beyond refusing `rescue` are not branches of this method.
  def visit(node : Asm) : Bool
    if outputs = node.outputs
      outputs.each do |output|
        ptrof = PointerOf.new(output.exp).at(output.exp)
        ptrof.accept(self)
      end
    end
    if inputs = node.inputs
      inputs.each do |input|
        input.exp.accept(self)
      end
    end
    if vt = @program.types["Void"]?
      set_type(node, vt)
    end
    false
  end

  # visit(Asm) returns false, as the hosted visit does, so an operand is not
  # walked from there. A walk that reaches the operand types its expression.
  def visit(node : AsmOperand) : Bool
    node.exp.accept(self)
    if et = child_type(node.exp)
      set_type(node, et)
    end
    false
  end

  # --- asm: end ---

  # --- type nodes: begin ---
  # The type-argument bracket the type-node functions use (hosted `@in_type_args`).
  def bracket_type_args(delta : Int32) : Nil
    @in_type_args = @in_type_args + delta
  end

  def visit(node : Generic) : Bool
    visit_generic(self, node)
  end

  def visit(node : Union) : Bool
    visit_union(self, node)
  end

  def visit(node : ProcNotation) : Bool
    visit_proc_notation(self, node)
  end

  def visit(node : Metaclass) : Bool
    visit_metaclass(self, node)
  end

  def visit(node : FunDef) : Bool
    file = ""
    if loc = node.location
      file = loc.filename
    end
    saved = @fun_inline_file
    @fun_inline_file = file
    typed = visit_fun_def(self, node)
    @fun_inline_file = saved
    typed
  end

  # `->(x : T) { body }` is typed `Proc(T, R)`, as the hosted pass types a ProcLiteral (main_visitor.cr
  # 1373-1433 and ProcLiteral#update, bindings.cr 604-619). Its parameters are locals of its body; R is the
  # declared return type, or else the body's type. Not ported: the closure analysis, the Proc argument
  # check, and force_nil.
  def visit(node : ProcLiteral) : Bool
    return false if type_of?(node)
    def_node = node.def
    fun_vars = @vars.dup
    arg_types = [] of Type
    i = 0
    while i < def_node.args.size
      arg = def_node.args[i]
      restriction = arg.restriction
      if restriction.nil?
        return refuse(node, "parameter '#{arg.name}' of Proc literal must have a type")
      end
      t = TypeQueries.virtual_type(lookup_under(restriction.as(ASTNode), @scope))
      set_type(restriction.as(ASTNode), t)
      set_type(arg, t)
      arg_types << t
      fun_vars[arg.name] = t
      i = i + 1
    end
    declared = proc_literal_return(def_node)
    body = def_node.body
    inner = sub_visitor(fun_vars).as(MainVisitor)
    # Unlike a fun body, the literal's body inherits its enclosing scope
    # (hosted main_visitor.cr 1416-1423).
    inner.scope = @scope
    inner.current_def = def_node if def_node.captured_block?
    old_imports = @program.current_imports
    old_import_defs = @program.current_import_defs
    enter_file_scope(node)
    body.accept(inner)
    @program.current_imports = old_imports
    @program.current_import_defs = old_import_defs
    ret = declared
    if bt = inner.child_type(body)
      if rt = declared
        merged = @program.type_merge(bt, rt)
        if merged != rt
          return refuse(node, "expected Proc to return #{rt.full_name} but it returned #{merged.full_name}")
        end
      else
        ret = TypeQueries.virtual_type(bt)
      end
    end
    if final = ret
      set_type(def_node, final)
      set_type(node, ProcInstanceType.new(@program, arg_types, final))
    else
      return refuse(node, "the body of the Proc literal was not typed")
    end
    false
  end

  # The declared return type of a Proc literal's def, or nil.
  def proc_literal_return(def_node : Def) : Type?
    if rt_node = def_node.return_type
      return TypeQueries.virtual_type(lookup_under(rt_node, @scope))
    end
    nil
  end

  def visit(node : Self) : Bool
    visit_self(self, node)
  end

  def visit(node : PointerOf) : Bool
    exp = node.exp
    if exp.is_a?(ClassVar) || exp.is_a?(InstanceVar)
      return pointerof_variable(node, exp)
    end
    if exp.is_a?(Call)
      call = exp.as(Call)
      if call.args.empty? && call.named_args.nil? && call.block.nil? && call.block_arg.nil?
        if obj = call.obj
          obj.accept(self)
          if owner = child_type(obj)
            if owner.is_a?(LibType)
              if external = owner.as(LibType).lookup_fun(call.name)
                if external.external_var && external.primitive == "external_var_get"
                  if var_type = external.resolved_return
                    set_type(call, var_type)
                    set_type(node, type_node_system(@program).pointer_of(var_type))
                    return false
                  end
                end
              end
            end
          end
        end
      end
    end
    if exp.is_a?(Path)
      exp.accept(self)
      ct = @program.lookup_type_path?(exp.as(Path), @current_type)
      if ct
        if ct.const?
          ct.as(Const).pointer_read = true
          if et = child_type(exp)
            set_type(node, type_node_system(@program).pointer_of(et.as(Type)))
          end
          return false
        end
      end
    end
    visit_pointer_of(self, node)
  end

  # `pointerof(@x)` and `pointerof(@@x)`: a pointer to the variable's type, as the
  # hosted pass binds it (main_visitor.cr 3108-3114). The `iyi_written` mark is the
  # lowering's and is not set here.
  def pointerof_variable(node : PointerOf, exp : ASTNode) : Bool
    exp.accept(self)
    t = child_type(exp)
    return false if t.nil?
    set_type(node, type_node_system(@program).pointer_of(t.as(Type)))
    false
  end

  def visit(node : TypeOf) : Bool
    visit_type_of(self, node)
  end

  def visit(node : SizeOf) : Bool
    visit_size_of(self, node)
  end

  def visit(node : AlignOf) : Bool
    visit_align_of(self, node)
  end

  def visit(node : InstanceSizeOf) : Bool
    visit_instance_size_of(self, node)
  end

  def visit(node : InstanceAlignOf) : Bool
    visit_instance_align_of(self, node)
  end

  def visit(node : EnumDef) : Bool
    visit_enum_def(self, node)
  end

  def visit(node : UninitializedVar) : Bool
    visit_uninitialized_var(self, node)
  end

  # The visitor of a fun body: the same node types and errors, its own locals.
  def sub_visitor(vars : Hash(String, Type)) : TypeNodeHost
    inner = MainVisitor.new(@program)
    inner.vars = vars
    inner.scope = @program
    inner.current_type = @current_type
    inner.node_types = @node_types
    inner.untyped_reasons = @untyped_reasons
    inner.call_target_defs = @call_target_defs
    inner.lib_call_targets = @lib_call_targets
    inner.expansions = @expansions
    inner.total = @total
    inner.typing_stack = @typing_stack
    inner.refusals = @refusals
    inner.typed_instances = @typed_instances
    inner.def_instances = @def_instances
    inner.def_var_unions = @def_var_unions
    inner.def_free_types = @def_free_types
    inner.untyped_locals = Hash(String, String).new
    inner.fun_inline_file = @fun_inline_file
    inner
  end

  def visit(node : Cast) : Bool
    visit_cast(self, node)
  end

  def visit(node : NilableCast) : Bool
    visit_nilable_cast(self, node)
  end

  # Whether the node being visited is inside a type argument.
  def in_type_args? : Bool
    @in_type_args > 0
  end

  def scope_type : Type?
    @scope
  end
  # --- type nodes: end ---
end

pub def node_class_name(node : ASTNode) : String
  if node.is_a?(Alias)
    "Alias"
  elsif node.is_a?(AlignOf)
    "AlignOf"
  elsif node.is_a?(And)
    "And"
  elsif node.is_a?(Annotation)
    "Annotation"
  elsif node.is_a?(AnnotationDef)
    "AnnotationDef"
  elsif node.is_a?(Arg)
    "Arg"
  elsif node.is_a?(ArrayLiteral)
    "ArrayLiteral"
  elsif node.is_a?(Asm)
    "Asm"
  elsif node.is_a?(AsmOperand)
    "AsmOperand"
  elsif node.is_a?(Assign)
    "Assign"
  elsif node.is_a?(AssocTypeDecl)
    "AssocTypeDecl"
  elsif node.is_a?(Block)
    "Block"
  elsif node.is_a?(BoolLiteral)
    "BoolLiteral"
  elsif node.is_a?(Break)
    "Break"
  elsif node.is_a?(CStructOrUnionDef)
    "CStructOrUnionDef"
  elsif node.is_a?(Call)
    "Call"
  elsif node.is_a?(Case)
    "Case"
  elsif node.is_a?(Cast)
    "Cast"
  elsif node.is_a?(CharLiteral)
    "CharLiteral"
  elsif node.is_a?(ClassDef)
    "ClassDef"
  elsif node.is_a?(ClassVar)
    "ClassVar"
  elsif node.is_a?(Def)
    "Def"
  elsif node.is_a?(Defer)
    "Defer"
  elsif node.is_a?(DoubleSplat)
    "DoubleSplat"
  elsif node.is_a?(EnumDef)
    "EnumDef"
  elsif node.is_a?(ExceptionHandler)
    "ExceptionHandler"
  elsif node.is_a?(Expressions)
    "Expressions"
  elsif node.is_a?(Extend)
    "Extend"
  elsif node.is_a?(ExternalVar)
    "ExternalVar"
  elsif node.is_a?(FunDef)
    "FunDef"
  elsif node.is_a?(Generic)
    "Generic"
  elsif node.is_a?(Global)
    "Global"
  elsif node.is_a?(HashLiteral)
    "HashLiteral"
  elsif node.is_a?(If)
    "If"
  elsif node.is_a?(ImplDef)
    "ImplDef"
  elsif node.is_a?(ImplicitObj)
    "ImplicitObj"
  elsif node.is_a?(ImportDecl)
    "ImportDecl"
  elsif node.is_a?(Include)
    "Include"
  elsif node.is_a?(InstanceAlignOf)
    "InstanceAlignOf"
  elsif node.is_a?(InstanceSizeOf)
    "InstanceSizeOf"
  elsif node.is_a?(InstanceVar)
    "InstanceVar"
  elsif node.is_a?(IsA)
    "IsA"
  elsif node.is_a?(LibDef)
    "LibDef"
  elsif node.is_a?(Macro)
    "Macro"
  elsif node.is_a?(MacroExpression)
    "MacroExpression"
  elsif node.is_a?(MacroFor)
    "MacroFor"
  elsif node.is_a?(MacroIf)
    "MacroIf"
  elsif node.is_a?(MacroLiteral)
    "MacroLiteral"
  elsif node.is_a?(MacroVar)
    "MacroVar"
  elsif node.is_a?(MacroVerbatim)
    "MacroVerbatim"
  elsif node.is_a?(MagicConstant)
    "MagicConstant"
  elsif node.is_a?(Metaclass)
    "Metaclass"
  elsif node.is_a?(ModuleDef)
    "ModuleDef"
  elsif node.is_a?(ModuleHeader)
    "ModuleHeader"
  elsif node.is_a?(MultiAssign)
    "MultiAssign"
  elsif node.is_a?(NamedArgument)
    "NamedArgument"
  elsif node.is_a?(NamedTupleLiteral)
    "NamedTupleLiteral"
  elsif node.is_a?(Next)
    "Next"
  elsif node.is_a?(NilLiteral)
    "NilLiteral"
  elsif node.is_a?(NilableCast)
    "NilableCast"
  elsif node.is_a?(Nop)
    "Nop"
  elsif node.is_a?(Not)
    "Not"
  elsif node.is_a?(NumberLiteral)
    "NumberLiteral"
  elsif node.is_a?(OffsetOf)
    "OffsetOf"
  elsif node.is_a?(OpAssign)
    "OpAssign"
  elsif node.is_a?(Or)
    "Or"
  elsif node.is_a?(Out)
    "Out"
  elsif node.is_a?(Path)
    "Path"
  elsif node.is_a?(PointerOf)
    "PointerOf"
  elsif node.is_a?(ProcLiteral)
    "ProcLiteral"
  elsif node.is_a?(ProcNotation)
    "ProcNotation"
  elsif node.is_a?(ProcPointer)
    "ProcPointer"
  elsif node.is_a?(Propagate)
    "Propagate"
  elsif node.is_a?(RangeLiteral)
    "RangeLiteral"
  elsif node.is_a?(ReadInstanceVar)
    "ReadInstanceVar"
  elsif node.is_a?(Recover)
    "Recover"
  elsif node.is_a?(RegexLiteral)
    "RegexLiteral"
  elsif node.is_a?(Require)
    "Require"
  elsif node.is_a?(Rescue)
    "Rescue"
  elsif node.is_a?(RespondsTo)
    "RespondsTo"
  elsif node.is_a?(Return)
    "Return"
  elsif node.is_a?(Select)
    "Select"
  elsif node.is_a?(Self)
    "Self"
  elsif node.is_a?(SizeOf)
    "SizeOf"
  elsif node.is_a?(Splat)
    "Splat"
  elsif node.is_a?(StringInterpolation)
    "StringInterpolation"
  elsif node.is_a?(StringLiteral)
    "StringLiteral"
  elsif node.is_a?(SymbolLiteral)
    "SymbolLiteral"
  elsif node.is_a?(TraitDef)
    "TraitDef"
  elsif node.is_a?(TupleLiteral)
    "TupleLiteral"
  elsif node.is_a?(TypeDeclaration)
    "TypeDeclaration"
  elsif node.is_a?(TypeDef)
    "TypeDef"
  elsif node.is_a?(TypeOf)
    "TypeOf"
  elsif node.is_a?(Underscore)
    "Underscore"
  elsif node.is_a?(UninitializedVar)
    "UninitializedVar"
  elsif node.is_a?(Union)
    "Union"
  elsif node.is_a?(Unless)
    "Unless"
  elsif node.is_a?(Until)
    "Until"
  elsif node.is_a?(UsingDecl)
    "UsingDecl"
  elsif node.is_a?(Var)
    "Var"
  elsif node.is_a?(VisibilityModifier)
    "VisibilityModifier"
  elsif node.is_a?(When)
    "When"
  elsif node.is_a?(While)
    "While"
  elsif node.is_a?(Yield)
    "Yield"
  else
    "ASTNode"
  end
end

pub def dump_typed_node(node : ASTNode, visitor : MainVisitor, sb : String::Builder, indent : String = "") : Nil
  type_str = if t = visitor.type_of?(node)
               t.full_name
             else
               "nil"
             end
  node_name = node_class_name(node)
  sb << indent << node_name << ": " << type_str << "\n"

  if node.is_a?(Expressions)
    node.as(Expressions).expressions.each do |e|
      dump_typed_node(e, visitor, sb, "#{indent}  ")
    end
  elsif node.is_a?(Assign)
    asgn = node.as(Assign)
    sb << indent << "  target:\n"
    dump_typed_node(asgn.target, visitor, sb, "#{indent}    ")
    sb << indent << "  value:\n"
    dump_typed_node(asgn.value, visitor, sb, "#{indent}    ")
  elsif node.is_a?(Var)
    sb << indent << "  name: " << node.as(Var).name << "\n"
  elsif node.is_a?(InstanceVar)
    sb << indent << "  name: " << node.as(InstanceVar).name << "\n"
  elsif node.is_a?(ClassVar)
    sb << indent << "  name: " << node.as(ClassVar).name << "\n"
  elsif node.is_a?(Path)
    sb << indent << "  names: [" << node.as(Path).names.join("::") << "]\n"
  elsif node.is_a?(NumberLiteral)
    num = node.as(NumberLiteral)
    sb << indent << "  value: " << num.value
    case num.kind
    when NumberKind::I32
      # no suffix
    when NumberKind::F64
      has_dot = false
      dot_i = 0
      while dot_i < num.value.bytesize
        b = num.value.byte_at(dot_i)
        if b == 46_u8 || b == 101_u8
          has_dot = true
          break
        end
        dot_i = dot_i + 1
      end
      unless has_dot
        sb << "_" << num.kind.to_s
      end
    else
      sb << "_" << num.kind.to_s
    end
    sb << "\n"
  elsif node.is_a?(StringLiteral) || node.is_a?(BoolLiteral) || node.is_a?(CharLiteral) || node.is_a?(SymbolLiteral) || node.is_a?(NilLiteral)
    sb << indent << "  value: " << node.to_s << "\n"
  elsif node.is_a?(If)
    if_node = node.as(If)
    sb << indent << "  cond:\n"
    dump_typed_node(if_node.cond, visitor, sb, "#{indent}    ")
    sb << indent << "  then:\n"
    dump_typed_node(if_node.then, visitor, sb, "#{indent}    ")
    if els = if_node.else
      sb << indent << "  else:\n"
      dump_typed_node(els, visitor, sb, "#{indent}    ")
    end
  elsif node.is_a?(While)
    wh = node.as(While)
    sb << indent << "  cond:\n"
    dump_typed_node(wh.cond, visitor, sb, "#{indent}    ")
    sb << indent << "  body:\n"
    dump_typed_node(wh.body, visitor, sb, "#{indent}    ")
  elsif node.is_a?(Yield)
    yd = node.as(Yield)
    unless yd.exps.empty?
      sb << indent << "  yield_exps:\n"
      yd.exps.each do |e|
        dump_typed_node(e, visitor, sb, "#{indent}    ")
      end
    end
  elsif node.is_a?(Return)
    ret = node.as(Return)
    if exp = ret.exp
      sb << indent << "  exp:\n"
      dump_typed_node(exp, visitor, sb, "#{indent}    ")
    end
  elsif node.is_a?(Call)
    c = node.as(Call)
    sb << indent << "  name: " << c.name << "\n"
    if obj = c.obj
      sb << indent << "  obj:\n"
      dump_typed_node(obj, visitor, sb, "#{indent}    ")
    end
    unless c.args.empty?
      sb << indent << "  args:\n"
      c.args.each do |a|
        dump_typed_node(a, visitor, sb, "#{indent}    ")
      end
    end
    if blk = c.block
      sb << indent << "  block:\n"
      dump_typed_node(blk, visitor, sb, "#{indent}    ")
    end
    if (td = visitor.target_def?(c)) && td.name != "new"
      ret_type_str = if t = visitor.type_of?(td)
                       t.full_name
                     else
                       "nil"
                     end
      sb << indent << "  target_def: " << td.name << ": " << ret_type_str << "\n"
      if body = td.body
        sb << indent << "  target_body:\n"
        dump_typed_node(body, visitor, sb, "#{indent}    ")
      end
    end
  elsif node.is_a?(Block)
    blk = node.as(Block)
    unless blk.args.empty?
      args_strs = blk.args.map do |a|
        t_str = if t = visitor.type_of?(a)
                  t.full_name
                else
                  "nil"
                end
        "#{a.name}: #{t_str}"
      end
      sb << indent << "  block_args: [" << args_strs.join(", ") << "]\n"
    end
    sb << indent << "  body:\n"
    dump_typed_node(blk.body, visitor, sb, "#{indent}    ")
  elsif node.is_a?(Def)
    sb << indent << "  name: " << node.as(Def).name << "\n"
  elsif node.is_a?(ClassDef)
    sb << indent << "  name: " << node.as(ClassDef).name.to_s << "\n"
  end
end

pub class CleanupTransformer < Transformer
  def transform(node : Call) : ASTNode
    if exp = node.expanded
      exp.transform(self)
    else
      super(node)
    end
  end

  def transform(node : Expressions) : ASTNode
    new_exps = [] of ASTNode
    node.expressions.each do |exp|
      transformed = exp.transform(self)
      if transformed.is_a?(Expressions)
        transformed.as(Expressions).expressions.each do |sub|
          new_exps << sub
        end
      else
        new_exps << transformed
      end
    end
    node.expressions = new_exps
    node
  end
end

pub def dump_program_expressions(program : SemanticProgram, node : ASTNode, visitor : MainVisitor) : String
  sb = String::Builder.new
  cleaned_node = CleanupTransformer.new.transform(node)
  dump_typed_node(cleaned_node, visitor, sb, "")
  sb.to_s
end
