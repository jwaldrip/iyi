module compiler/semantic/main_visitor

import compiler/foundation/location::{Location}
import compiler/syntax/ast::{ASTNode, Primitive, NodeMap, Alias, AlignOf, And, Annotation, AnnotationDef, Arg, ArrayLiteral, Asm, AsmOperand, Assign, AssocTypeDecl, Block, BoolLiteral, Break, CStructOrUnionDef, Call, Case, Cast, CharLiteral, ClassDef, ClassVar, Def, Defer, DoubleSplat, EnumDef, ExceptionHandler, Expressions, Extend, ExternalVar, FunDef, Generic, Global, HashLiteral, If, ImplDef, ImplicitObj, ImportDecl, Include, InstanceAlignOf, InstanceSizeOf, InstanceVar, IsA, LibDef, Macro, MacroExpression, MacroFor, MacroIf, MacroLiteral, MacroVar, MacroVerbatim, MagicConstant, Metaclass, ModuleDef, ModuleHeader, MultiAssign, NamedArgument, NamedTupleLiteral, Next, NilLiteral, NilableCast, Nop, Not, NumberLiteral, OffsetOf, OpAssign, Or, Out, Path, PointerOf, ProcLiteral, ProcNotation, ProcPointer, Propagate, RangeLiteral, ReadInstanceVar, Recover, RegexLiteral, Require, Rescue, RespondsTo, Return, Select, Self, SizeOf, Splat, StringInterpolation, StringLiteral, SymbolLiteral, TraitDef, TupleLiteral, TypeDeclaration, TypeDef, TypeOf, Underscore, UninitializedVar, Union, Unless, Until, UsingDecl, Var, VisibilityModifier, When, While, Yield}
import compiler/syntax/token::{NumberKind}
import compiler/syntax/visitor::{Visitor}
import compiler/syntax/transformer::{Transformer}
import compiler/macros/engine::{MacroEngine}
import compiler/semantic/top_level::{AliasType, ClassType, Const, EnumType, GenericClassType, GenericModuleType, GenericTraitType, MetaTypeVar, MetaclassType, ModuleType, NamedType, NonGenericClassType, NonGenericModuleType, SemanticProgram, TopLevelVisitor, TraitType, Type, UnionType, UnresolvedType}
import compiler/semantic/top_level::{NoReturnType}
import compiler/semantic/normalizer::{NormalizerProgram}
import compiler/semantic/literal_expander::{LiteralExpander}
import compiler/semantic/default_arguments::{DefaultArguments}
import compiler/semantic/type_node_host::{TypeNodeHost}
import compiler/semantic/type_nodes::{visit_generic, visit_union, visit_proc_notation, visit_metaclass, visit_fun_def, visit_self, visit_cast, visit_nilable_cast, visit_type_of, visit_size_of, visit_align_of, visit_instance_size_of, visit_instance_align_of, visit_pointer_of, visit_enum_def, visit_uninitialized_var}
import compiler/semantic/new::{define_new_methods}
import compiler/semantic/type_nodes::{tuple_type_of, named_tuple_type_of}
import compiler/types/types::{GenericInstanceType, NamedArgumentType}

# One construct the body typing could not type or refused, as the pipeline's
# refusal table reads it. `file` is nil and `line` and `column` are 0 when the
# node has no location. `def_name` is the def whose body was being typed, named
# `Owner#name` inside a type and `name` at top level; nil outside any def.
pub class Refusal
  getter reason : String
  getter file : String?
  getter line : Int32
  getter column : Int32
  getter def_name : String?
  getter node : ASTNode

  def initialize(@reason : String, @file : String?, @line : Int32, @column : Int32, @def_name : String?, @node : ASTNode)
  end
end

# One instantiation whose body typing started with every parameter typed: the
# instantiated clone of the def (`definition`, the value `call_target_defs` holds),
# the receiver (`self_type`, nil at top level) and one argument type per parameter,
# in declaration order. `definition` is the name because `def` is a keyword.
pub class TypedInstance
  getter definition : Def
  getter self_type : Type?
  getter arg_types : Array(Type)

  def initialize(@definition : Def, @self_type : Type?, @arg_types : Array(Type))
  end
end

# iyi: two modes. Strict (the default) raises on the first construct it cannot
# type, as the port always did, and every existing gate relies on that. Total
# (`total = true`, the typed dump's mode) records the reason on the node that
# cannot be typed and goes on, so one unsupported construct costs its own nodes
# and not the file. A node with no type is never printed as typed, so it never
# counts as matched.
pub class MainVisitor < TypeNodeHost
  property program : SemanticProgram
  property current_type : ModuleType
  property scope : Type?
  property vars : Hash(String, Type)
  property node_types : NodeMap(Type)
  property untyped_reasons : NodeMap(String)
  property call_target_defs : NodeMap(Def)
  property current_def : Def?
  property current_call_block : Block?
  property current_block_context_vars : Hash(String, Type)?
  property current_yield_nodes : Array(Yield)?
  property total : Bool = false
  property in_type_args : Int32 = 0
  # The instantiations whose body typing is in progress, by key (receiver, def
  # name, argument types). A key typed again is a recursive call: it takes the
  # declared return type, or is refused. Shared with a fun body's visitor.
  property typing_stack : Array(String)
  # Every refusal recorded, in order (see Refusal). Shared with a fun body's visitor.
  property refusals : Array(Refusal)
  # Every instantiation whose body typing started with all its parameters typed,
  # in order (see TypedInstance). Shared with a fun body's visitor.
  property typed_instances : Array(TypedInstance)

  def type_args_depth : Int32
    @in_type_args
  end

  # The analysed signature of each fun, keyed by its FunDef node: argument types
  # in declared order and the declared return type. The lowering reads them.
  property fun_arg_types_by_node : NodeMap(Array(Type)) = NodeMap(Array(Type)).new
  property fun_return_types_by_node : NodeMap(Type) = NodeMap(Type).new

  def record_fun_signature(node : FunDef, arg_types : Array(Type), return_type : Type?) : Nil
    @fun_arg_types_by_node[node] = arg_types
    if rt = return_type
      @fun_return_types_by_node[node] = rt
    end
    nil
  end

  def fun_arg_types(node : FunDef) : Array(Type)?
    @fun_arg_types_by_node[node]?
  end

  def fun_return_type(node : FunDef) : Type?
    @fun_return_types_by_node[node]?
  end

  # The union of the types each variable of the body being typed is assigned, keyed
  # by name; `def_var_unions` keeps it per instantiated def (the lowering's storage type).
  property var_unions : Hash(String, Type)
  property def_var_unions : NodeMap(Hash(String, Type))
  # The locals of the body being typed whose value has no type, by name, with the
  # reason their reads are reported with. Saved and restored per body.
  property untyped_locals : Hash(String, String)

  def initialize(@program : SemanticProgram)
    # The generated `new` methods are completed before any body is typed: the
    # declarations pass has recorded the expansions, and this consumes them (idempotent).
    define_new_methods(@program)
    @current_type = @program
    @scope = nil
    @vars = Hash(String, Type).new
    @node_types = NodeMap(Type).new
    @untyped_reasons = NodeMap(String).new
    @call_target_defs = NodeMap(Def).new
    @var_unions = Hash(String, Type).new
    @def_var_unions = NodeMap(Hash(String, Type)).new
    @untyped_locals = Hash(String, String).new
    @current_def = nil
    @current_call_block = nil
    @current_block_context_vars = nil
    @current_yield_nodes = nil
    @typing_stack = [] of String
    @refusals = [] of Refusal
    @typed_instances = [] of TypedInstance
  end

  def set_type(node : ASTNode, type : Type) : Type
    if type.is_a?(UnresolvedType)
      untyped(node, "undefined constant #{type.name}")
      return type
    end
    @node_types[node] = type
    type
  end

  def type_of?(node : ASTNode) : Type?
    @node_types[node]?
  end

  def type_of(node : ASTNode) : Type
    if t = @node_types[node]?
      t
    else
      raise("BUG: node has no type: #{node.to_s}")
    end
  end

  # The type of a node a visit has already visited. Strict mode raises when it
  # has none: the reason the node was refused when there is one, else a BUG. Total
  # mode returns nil and the caller leaves its own node untyped.
  def child_type(node : ASTNode) : Type?
    if t = @node_types[node]?
      return t
    end
    unless @total
      if reason = @untyped_reasons[node]?
        raise(reason)
      end
      raise("BUG: node has no type: #{node.to_s}")
    end
    nil
  end

  # The reason a node could not be typed. Total mode records it and returns
  # false, so a visit can end with `return untyped(node, "...")`.
  def untyped(node : ASTNode, reason : String) : Bool
    @untyped_reasons[node] = reason
    record_refusal(node, reason)
    false
  end

  # A construct the port refuses. Strict mode raises the message (the program's
  # error, as before); total mode records it on the node.
  def refuse(node : ASTNode, message : String) : Bool
    record_refusal(node, message)
    raise(message) unless @total
    @untyped_reasons[node] = message
    false
  end

  # Appends one Refusal for `node`: the reason, the node's file, line and column
  # (0 when it has no location), and the def whose body was being typed, named
  # `Owner#name` inside a type and `name` at top level.
  def record_refusal(node : ASTNode, reason : String) : Nil
    file : String? = nil
    line = 0
    column = 0
    if loc = node.location
      file = loc.filename
      line = loc.line_number
      column = loc.column_number
    end
    def_name : String? = nil
    if cd = @current_def
      def_name = cd.name
      if owner = @scope
        unless owner.is_a?(SemanticProgram)
          def_name = "#{owner.full_name}##{cd.name}"
        end
      end
    end
    @refusals << Refusal.new(reason, file, line, column, def_name, node)
    nil
  end

  def untyped_reason?(node : ASTNode) : String?
    @untyped_reasons[node]?
  end

  def target_def?(call : Call) : Def?
    @call_target_defs[call]?
  end

  def type_from_literal_kind(kind : NumberKind) : Type
    case kind
    when NumberKind::I8   then @program.types["Int8"]
    when NumberKind::I16  then @program.types["Int16"]
    when NumberKind::I32  then @program.int32_type
    when NumberKind::I64  then @program.types["Int64"]
    when NumberKind::I128 then @program.types["Int128"]
    when NumberKind::U8   then @program.types["UInt8"]
    when NumberKind::U16  then @program.types["UInt16"]
    when NumberKind::U32  then @program.types["UInt32"]
    when NumberKind::U64  then @program.types["UInt64"]
    when NumberKind::U128 then @program.types["UInt128"]
    when NumberKind::F32  then @program.types["Float32"]
    when NumberKind::F64  then @program.types["Float64"]
    else
      @program.int32_type
    end
  end

  def visit(node : NilLiteral) : Bool
    set_type(node, @program.nil_type)
    false
  end

  def visit(node : Macro) : Bool
    set_type(node, @program.nil_type)
    false
  end

  # iyi: the `module` header the parser leaves as the file's first statement. The
  # hosted tree has no such node (its parser makes the ModuleDef alone, parser.cr
  # 349-402), so the header is typed nothing, recorded nothing, and not walked.
  def visit(node : ModuleHeader) : Bool
    false
  end

  # iyi: an argument of a def, block or enum member. The hosted pass skips it
  # (semantic_visitor.cr: "Arg nodes are also used for Enum constants"): it is
  # neither typed nor walked.
  def visit(node : Arg) : Bool
    false
  end

  # iyi: declarations the hosted base visitor types as nil without walking them
  # (semantic_visitor.cr 1861-1911).
  def visit(node : ImportDecl) : Bool
    set_type(node, @program.nil_type)
    false
  end

  def visit(node : UsingDecl) : Bool
    set_type(node, @program.nil_type)
    false
  end

  def visit(node : Extend) : Bool
    set_type(node, @program.nil_type)
    false
  end

  def visit(node : Include) : Bool
    set_type(node, @program.nil_type)
    false
  end

  def visit(node : Alias) : Bool
    set_type(node, @program.nil_type)
    false
  end

  def visit(node : AnnotationDef) : Bool
    set_type(node, @program.nil_type)
    false
  end

  def visit(node : LibDef) : Bool
    set_type(node, @program.nil_type)
    false
  end

  def visit(node : AssocTypeDecl) : Bool
    set_type(node, @program.nil_type)
    false
  end

  # iyi: the visibility modifier types what it modifies and is nil itself. A call
  # with no expansion is refused, as the hosted pass refuses it.
  def visit(node : VisibilityModifier) : Bool
    exp = node.exp
    exp.accept(self)
    if exp.is_a?(Call) && exp.expanded.nil?
      return refuse(node, "can't apply visibility modifier")
    end
    set_type(node, @program.nil_type)
    false
  end

  # iyi: macro control inside a body. The hosted pass hands a MacroIf, MacroFor
  # or MacroExpression to its macro engine (semantic_visitor.cr 1943-1956) and
  # does not walk it; MacroLiteral text exists only inside those, and the hosted
  # pass never reaches it. Expansion waits for the macro engine (macros slice).
  def visit(node : MacroIf) : Bool
    untyped(node, "macro control expansion (macros engine)")
    false
  end

  def visit(node : MacroFor) : Bool
    untyped(node, "macro control expansion (macros engine)")
    false
  end

  def visit(node : MacroExpression) : Bool
    untyped(node, "macro control expansion (macros engine)")
    false
  end

  def visit(node : MacroVerbatim) : Bool
    untyped(node, "macro control expansion (macros engine)")
    false
  end

  def visit(node : MacroLiteral) : Bool
    false
  end

  # iyi: a literal the hosted pass expands before it types it (main_visitor.cr
  # 3664-3700, expand(node)). The literal expander builds the tree the hosted
  # pass types; the literal takes that tree's type, and the tree is walked.
  def expand_literal(node : ASTNode) : Bool
    expander = LiteralExpander.new(NormalizerProgram.new)
    expanded = node.transform(expander)
    expanded.accept(self)
    if et = child_type(expanded)
      set_type(node, et)
    end
    false
  end

  def visit(node : ArrayLiteral) : Bool
    expand_literal(node)
  end

  def visit(node : HashLiteral) : Bool
    expand_literal(node)
  end

  def visit(node : RangeLiteral) : Bool
    expand_literal(node)
  end

  def visit(node : StringInterpolation) : Bool
    expand_literal(node)
  end

  def visit(node : And) : Bool
    expand_literal(node)
  end

  def visit(node : Or) : Bool
    expand_literal(node)
  end

  def visit(node : Case) : Bool
    expand_literal(node)
  end

  def visit(node : Select) : Bool
    expand_literal(node)
  end

  # A multiple assignment is expanded before it is typed, as the hosted pass does
  # (main_visitor.cr 3736): its targets are assigned from temporaries.
  def visit(node : MultiAssign) : Bool
    expand_literal(node)
  end

  # iyi: an annotation is a sibling of the def it annotates, not an expression.
  # The hosted pass does not type or walk it, so neither does the port; the
  # primitive name is read from the Annotation by the lowering (S2d owns that).
  def visit(node : Annotation) : Bool
    false
  end

  # iyi: `x.is_a?(T)` is Bool (hosted type filter). Visit the receiver and the
  # constant, then type the node.
  def visit(node : IsA) : Bool
    node.obj.accept(self)
    node.const.accept(self)
    set_type(node, @program.bool_type)
    false
  end

  # iyi: `!x` is Bool whatever its operand (hosted main_visitor.cr 3757). The
  # operand is visited so its own nodes are typed.
  def visit(node : Not) : Bool
    node.exp.accept(self)
    set_type(node, @program.bool_type)
    false
  end

  # iyi: `break` and `next` never complete, so they are NoReturn. A value they
  # carry is visited first, as the hosted pass does (the expression is bound).
  def visit(node : Break) : Bool
    if e = node.exp
      e.accept(self)
    end
    set_type(node, @program.no_return_type)
    false
  end

  def visit(node : Next) : Bool
    if e = node.exp
      e.accept(self)
    end
    set_type(node, @program.no_return_type)
    false
  end

  # iyi: the body of a `@[Primitive(:name)]` def (hosted main_visitor.cr
  # 2842-2851). It has the def's declared return type. `pre_initialize` and the
  # by-name cases are not ported here; a primitive with no return type is
  # recorded untyped with its name.
  def visit(node : Primitive) : Bool
    if cd = @current_def
      if rt = cd.return_type
        set_type(node, @program.lookup_type_node(rt, @current_type))
        return false
      end
    end
    if node.name == "allocate"
      if sc = @scope
        if sc.is_a?(MetaclassType)
          set_type(node, sc.as(MetaclassType).instance_type)
          return false
        end
      end
    end
    untyped(node, "primitive #{node.name} without a declared return type")
    false
  end

  # `obj.responds_to?(:name)` is typed Bool. Its value depends on the obj's type and is
  # decided by the lowering, not here (the hosted typer sets only the type).
  def visit(node : RespondsTo) : Bool
    obj = node.obj
    obj.accept(self)
    set_type(node, @program.bool_type)
    false
  end

  # iyi: a node of a kind this visitor does not type yet. The walk goes on into
  # its children, so the children are typed; the node itself is recorded.
  def visit(node : ASTNode) : Bool
    untyped(node, "unsupported node: #{node_class_name(node)}")
    true
  end

  def expand_macro(node : Call) : Bool
    if exp = node.expanded
      exp.accept(self)
      if et = child_type(exp)
        set_type(node, et)
      end
      return true
    end

    if node.obj.nil?
      lookup_type = @scope || @current_type
      if a_macro = lookup_type.lookup_macro?(node.name)
        engine = MacroEngine.new
        expanded_ast = engine.expand(a_macro, node)
        node.expanded = expanded_ast
        expanded_ast.accept(self)
        if et = child_type(expanded_ast)
          set_type(node, et)
        end
        return true
      end
    end

    false
  end

  def visit(node : BoolLiteral) : Bool
    set_type(node, @program.bool_type)
    false
  end

  def visit(node : CharLiteral) : Bool
    set_type(node, @program.char_type)
    false
  end

  def visit(node : StringLiteral) : Bool
    set_type(node, @program.string_type)
    false
  end

  def visit(node : SymbolLiteral) : Bool
    set_type(node, @program.symbol_type)
    false
  end

  def visit(node : NumberLiteral) : Bool
    set_type(node, type_from_literal_kind(node.kind))
    false
  end

  def visit(node : Nop) : Bool
    set_type(node, @program.nil_type)
    false
  end

  def visit(node : Var) : Bool
    if t = @vars[node.name]?
      set_type(node, t)
      return false
    end
    if reason = @untyped_locals[node.name]?
      return untyped(node, reason)
    end

    if node.name == "self"
      if sc = @scope
        set_type(node, sc)
        return false
      else
        return refuse(node, "there's no self in this scope")
      end
    end

    rec_type : Type = @scope || @current_type
    all_defs = [] of Def
    visited = Set(String).new
    collect_candidate_defs(rec_type, node.name, all_defs, visited)
    zero_arg = all_defs.find { |d| d.args.empty? || (d.args.first.default_value != nil) }
    if zero_arg
      call = Call.new(nil, node.name).at(node)
      @call_target_defs[call] = zero_arg
      if ret_type = type_method_body(zero_arg, rec_type, [] of ASTNode, nil, node)
        set_type(node, ret_type)
      end
      return false
    end

    scope_name = if sc = @scope
                   sc.full_name
                 else
                   "top-level"
                 end
    refuse(node, "undefined local variable or method '#{node.name}' for #{scope_name}")
  end

  def visit(node : InstanceVar) : Bool
    if @scope.nil? && (@current_type.is_a?(SemanticProgram) || @current_type.nil?)
      return refuse(node, "can't use instance variables at the top level")
    end
    target_scope = @scope || @current_type
    target_type = if target_scope.is_a?(MetaclassType)
                    target_scope.as(MetaclassType).instance_type
                  else
                    target_scope
                  end
    if target_type.is_a?(ModuleType)
      if ivar = target_type.as(ModuleType).lookup_instance_var?(node.name)
        set_type(node, ivar.type)
        return false
      end
    end
    refuse(node, "can't infer the type of instance variable '#{node.name}' of #{target_type.full_name}")
  end

  def visit(node : ClassVar) : Bool
    if @scope.nil? && (@current_type.is_a?(SemanticProgram) || @current_type.nil?)
      return refuse(node, "can't use class variables at the top level")
    end
    target_scope = @scope || @current_type
    target_type = if target_scope.is_a?(MetaclassType)
                    target_scope.as(MetaclassType).instance_type
                  else
                    target_scope
                  end
    if target_type.is_a?(ModuleType)
      if cvar = target_type.as(ModuleType).lookup_class_var?(node.name)
        set_type(node, cvar.type)
        return false
      end
    end
    refuse(node, "undefined class variable '#{node.name}' for #{target_type.full_name}")
  end

  def visit(node : Assign) : Bool
    node.value.accept(self)
    vt = child_type(node.value)
    if vt.nil?
      # The local is declared; its reads report why its value has no type.
      if node.target.is_a?(Var)
        name = node.target.as(Var).name
        @untyped_locals[name] = "the value of '#{name}' cannot be typed"
      end
      return false
    end
    val_type = vt.as(Type)
    if node.target.is_a?(Var)
      @untyped_locals.delete(node.target.as(Var).name)
    end

    if node.target.is_a?(Var)
      v = node.target.as(Var)
      # The target and the later reads take the type of this assignment: the
      # oracle prints flow types (bench/fixtures/sem_bodies_union.iyi). The
      # variable's storage type is the union over the body's assignments, kept
      # apart in `def_var_unions` for the lowering.
      @vars[v.name] = val_type
      set_type(v, val_type)
      set_type(node, val_type)
      if old_u = @var_unions[v.name]?
        @var_unions[v.name] = @program.type_merge(old_u, val_type)
      else
        @var_unions[v.name] = val_type
      end
    elsif node.target.is_a?(InstanceVar)
      ivar_node = node.target.as(InstanceVar)
      if @scope.nil? && (@current_type.is_a?(SemanticProgram) || @current_type.nil?)
        return refuse(node, "can't use instance variables at the top level")
      end
      target_scope = @scope || @current_type
      target_type = if target_scope.is_a?(MetaclassType)
                      target_scope.as(MetaclassType).instance_type
                    else
                      target_scope
                    end
      if target_type.is_a?(ModuleType)
        mod_type = target_type.as(ModuleType)
        if ivar = mod_type.lookup_instance_var?(ivar_node.name)
          unless val_type.subtype_of?(ivar.type)
            return refuse(node, "instance variable '#{ivar_node.name}' of #{mod_type.full_name} must be #{ivar.type.full_name}, not (#{ivar.type.full_name} | #{val_type.full_name})")
          end
          set_type(ivar_node, ivar.type)
        else
          ivar = MetaTypeVar.new(ivar_node.name, val_type, node.value)
          mod_type.instance_vars[ivar_node.name] = ivar
          set_type(ivar_node, val_type)
        end
        set_type(node, val_type)
      else
        return refuse(node, "can't use instance variables in #{target_type.full_name}")
      end
    elsif node.target.is_a?(ClassVar)
      cvar_node = node.target.as(ClassVar)
      if @scope.nil? && (@current_type.is_a?(SemanticProgram) || @current_type.nil?)
        return refuse(node, "can't use class variables at the top level")
      end
      target_scope = @scope || @current_type
      target_type = if target_scope.is_a?(MetaclassType)
                      target_scope.as(MetaclassType).instance_type
                    else
                      target_scope
                    end
      if target_type.is_a?(ModuleType)
        mod_type = target_type.as(ModuleType)
        if cvar = mod_type.lookup_class_var?(cvar_node.name)
          unless val_type.subtype_of?(cvar.type)
            return refuse(node, "type mismatch for class variable '#{cvar_node.name}': expected #{cvar.type.full_name}, got #{val_type.full_name}")
          end
          set_type(cvar_node, cvar.type)
        else
          cvar = MetaTypeVar.new(cvar_node.name, val_type, node.value)
          mod_type.class_vars[cvar_node.name] = cvar
          set_type(cvar_node, val_type)
        end
        set_type(node, val_type)
      else
        return refuse(node, "can't use class variables in #{target_type.full_name}")
      end
    elsif node.target.is_a?(Path)
      p = node.target.as(Path)
      set_type(p, val_type)
      set_type(node, val_type)
    else
      set_type(node, val_type)
    end
    false
  end

  def visit(node : TypeDeclaration) : Bool
    decl_type = @program.lookup_type_node(node.declared_type, @current_type)
    if val = node.value
      val.accept(self)
      vt = child_type(val)
      return false if vt.nil?
      val_type = vt.as(Type)
      unless val_type.subtype_of?(decl_type)
        if node.var.is_a?(InstanceVar)
          target_scope = @scope || @current_type
          target_type = if target_scope.is_a?(MetaclassType)
                          target_scope.as(MetaclassType).instance_type
                        else
                          target_scope
                        end
          return refuse(node, "instance variable '#{node.var.as(InstanceVar).name}' of #{target_type.full_name} must be #{decl_type.full_name}, not (#{decl_type.full_name} | #{val_type.full_name})")
        end
        return refuse(node, "expected type #{decl_type.full_name}, got #{val_type.full_name}")
      end
      if node.var.is_a?(Var)
        v = node.var.as(Var)
        @vars[v.name] = decl_type
        set_type(v, decl_type)
      elsif node.var.is_a?(InstanceVar)
        ivar_node = node.var.as(InstanceVar)
        if @scope.nil? && (@current_type.is_a?(SemanticProgram) || @current_type.nil?)
          return refuse(node, "can only declare instance variables of a non-generic class, not a main (<Program>)")
        end
        target_scope = @scope || @current_type
        target_type = if target_scope.is_a?(MetaclassType)
                        target_scope.as(MetaclassType).instance_type
                      else
                        target_scope
                      end
        if target_type.is_a?(ModuleType)
          mod_type = target_type.as(ModuleType)
          mod_type.instance_vars[ivar_node.name] = MetaTypeVar.new(ivar_node.name, decl_type, val)
          set_type(ivar_node, decl_type)
        end
      elsif node.var.is_a?(ClassVar)
        cvar_node = node.var.as(ClassVar)
        if @scope.nil? && (@current_type.is_a?(SemanticProgram) || @current_type.nil?)
          return refuse(node, "can't use class variables at the top level")
        end
        target_scope = @scope || @current_type
        target_type = if target_scope.is_a?(MetaclassType)
                        target_scope.as(MetaclassType).instance_type
                      else
                        target_scope
                      end
        if target_type.is_a?(ModuleType)
          mod_type = target_type.as(ModuleType)
          mod_type.class_vars[cvar_node.name] = MetaTypeVar.new(cvar_node.name, decl_type, val)
          set_type(cvar_node, decl_type)
        end
      end
      set_type(node, decl_type)
    else
      if node.var.is_a?(Var)
        v = node.var.as(Var)
        @vars[v.name] = decl_type
        set_type(v, decl_type)
      elsif node.var.is_a?(InstanceVar)
        ivar_node = node.var.as(InstanceVar)
        if @scope.nil? && (@current_type.is_a?(SemanticProgram) || @current_type.nil?)
          return refuse(node, "can only declare instance variables of a non-generic class, not a main (<Program>)")
        end
        target_scope = @scope || @current_type
        target_type = if target_scope.is_a?(MetaclassType)
                        target_scope.as(MetaclassType).instance_type
                      else
                        target_scope
                      end
        if target_type.is_a?(ModuleType)
          mod_type = target_type.as(ModuleType)
          mod_type.instance_vars[ivar_node.name] = MetaTypeVar.new(ivar_node.name, decl_type, nil)
          set_type(ivar_node, decl_type)
        end
      elsif node.var.is_a?(ClassVar)
        cvar_node = node.var.as(ClassVar)
        if @scope.nil? && (@current_type.is_a?(SemanticProgram) || @current_type.nil?)
          return refuse(node, "can't use class variables at the top level")
        end
        target_scope = @scope || @current_type
        target_type = if target_scope.is_a?(MetaclassType)
                        target_scope.as(MetaclassType).instance_type
                      else
                        target_scope
                      end
        if target_type.is_a?(ModuleType)
          mod_type = target_type.as(ModuleType)
          mod_type.class_vars[cvar_node.name] = MetaTypeVar.new(cvar_node.name, decl_type, nil)
          set_type(cvar_node, decl_type)
        end
      end
      set_type(node, decl_type)
    end
    false
  end

  def visit(node : Path) : Bool
    t = @program.lookup_type_path(node, @current_type)
    if t.const?
      c = t.as(Const)
      if c_type = type_of?(c.value)
        set_type(node, c_type)
      else
        c.value.accept(self)
        if c_type = child_type(c.value)
          set_type(node, c_type)
        end
      end
    elsif t.is_a?(ModuleType) && @in_type_args == 0
      set_type(node, t.as(ModuleType).metaclass)
    else
      set_type(node, t)
    end
    false
  end

  def visit(node : Expressions) : Bool
    if node.expressions.empty?
      set_type(node, @program.nil_type)
    else
      # The type of an expression list is the type of its last expression. An
      # expression the port cannot type leaves the list untyped too.
      last_type : Type? = nil
      i = 0
      while i < node.expressions.size
        exp = node.expressions[i]
        # iyi: an annotation sits beside the def it annotates and is neither typed
        # nor walked (the hosted pass does not), so it does not end the list's type.
        unless exp.is_a?(Annotation)
          exp.accept(self)
          last_type = child_type(exp)
        end
        i = i + 1
      end
      if lt = last_type
        set_type(node, lt)
      end
    end
    false
  end

  # The type where two branches meet. A branch that never completes (NoReturn) adds
  # nothing, as the hosted merge drops it; the other branch's type is the result.
  def merge_flow(a : Type, b : Type) : Type
    return b if a.is_a?(NoReturnType)
    return a if b.is_a?(NoReturnType)
    @program.type_merge(a, b)
  end

  def visit(node : If) : Bool
    node.cond.accept(self)
    node.then.accept(self)
    node.else.accept(self)
    then_type = child_type(node.then)
    else_type = child_type(node.else)
    if then_type
      if else_type
        merged = merge_flow(then_type, else_type)
        set_type(node, merged)
      end
    end
    false
  end

  def visit(node : While) : Bool
    node.cond.accept(self)
    node.body.accept(self)
    set_type(node, @program.nil_type)
    false
  end

  def visit(node : Return) : Bool
    if exp = node.exp
      exp.accept(self)
      exp_type = child_type(exp)
      return false if exp_type.nil?
      if cd = @current_def
        if rt = cd.return_type
          expected_ret = @program.lookup_type_node(rt, @current_type)
          unless exp_type.as(Type).subtype_of?(expected_ret)
            return refuse(node, "type mismatch for return type: expected #{expected_ret.full_name}, got #{exp_type.as(Type).full_name}")
          end
        end
      end
    end
    set_type(node, @program.no_return_type)
    false
  end

  def visit(node : ClassDef) : Bool
    t = @program.lookup_type_path?(node.name, @current_type)
    if t && t.is_a?(ClassType)
      old_type = @current_type
      @current_type = t.as(ClassType)
      node.body.accept(self)
      @current_type = old_type

      cls = t.as(ClassType)
      cls.class_vars.each_value do |cvar|
        if cvar.initializer.nil? && !cvar.type.nilable?
          return refuse(node, "class variable '#{cvar.name}' of #{cls.full_name} is not nilable (it's #{cvar.type.full_name}) so it must have an initializer")
        end
      end
    end
    set_type(node, @program.nil_type)
    false
  end

  def visit(node : ModuleDef) : Bool
    t = @program.lookup_type_path?(node.name, @current_type)
    if t && t.is_a?(ModuleType)
      old_type = @current_type
      @current_type = t.as(ModuleType)
      node.body.accept(self)
      @current_type = old_type

      mod = t.as(ModuleType)
      mod.class_vars.each_value do |cvar|
        if cvar.initializer.nil? && !cvar.type.nilable?
          return refuse(node, "class variable '#{cvar.name}' of #{mod.full_name} is not nilable (it's #{cvar.type.full_name}) so it must have an initializer")
        end
      end
    end
    set_type(node, @program.nil_type)
    false
  end

  def visit(node : Def) : Bool
    set_type(node, @program.nil_type)
    false
  end

  def visit(node : Yield) : Bool
    if yn = @current_yield_nodes
      yn << node
    end
    node.exps.each do |exp|
      exp.accept(self)
    end

    if blk = @current_call_block
      old_vars = @vars
      old_scope = @scope
      blk_vars = if ctx = @current_block_context_vars
                   ctx.dup
                 else
                   @vars.dup
                 end

      i = 0
      while i < blk.args.size
        b_arg = blk.args[i]
        if i < node.exps.size
          if arg_t = child_type(node.exps[i])
            current_arg_t = type_of?(b_arg)
            new_arg_t = if cat = current_arg_t
                          @program.type_merge(cat, arg_t)
                        else
                          arg_t
                        end
            blk_vars[b_arg.name] = new_arg_t
            set_type(b_arg, new_arg_t)
          end
        end
        i = i + 1
      end
      @vars = blk_vars

      blk.body.accept(self)
      blk_type = child_type(blk.body)
      if bt = blk_type
        set_type(blk, bt)
        set_type(node, bt)
      end

      if ctx = @current_block_context_vars
        ctx.keys.each do |k|
          if new_v = @vars[k]?
            ctx[k] = new_v
          end
        end
      end

      @vars = old_vars
      @scope = old_scope

      if bt = blk_type
        if cd = @current_def
          if ba = cd.block_arg
            if r = ba.restriction
              if r.is_a?(ProcNotation)
                pn = r.as(ProcNotation)
                if out_node = pn.output
                  expected_ret = @program.lookup_type_node(out_node, @current_type)
                  unless bt.subtype_of?(expected_ret)
                    return refuse(node, "expected block to return #{expected_ret.full_name}, not #{bt.full_name}")
                  end
                end
              end
            end
          end
        end
      end
    else
      set_type(node, @program.nil_type)
    end
    false
  end

  def visit(node : Block) : Bool
    node.body.accept(self)
    if bt = child_type(node.body)
      set_type(node, bt)
    end
    false
  end

  # The type a parameter's restriction names for a call on *rec_type*. A generic instance
  # (or its metaclass) binds its type parameters, so `v : T` on Box(Int32) is Int32, as the
  # hosted MatchContext binds them. Anything else is the scope's own lookup.
  def restriction_type(restriction : ASTNode, rec_type : Type) : Type
    owner = rec_type
    if owner.is_a?(MetaclassType)
      owner = owner.as(MetaclassType).instance_type
    end
    if owner.is_a?(GenericInstanceType) && restriction.is_a?(Path)
      names = restriction.as(Path).names
      if names.size == 1
        if bound = owner.as(GenericInstanceType).type_vars[names[0]]?
          return bound
        end
      end
    end
    @program.lookup_type_node(restriction, @current_type)
  end

  def collect_candidate_defs(rec_type : Type, name : String, result : Array(Def), visited : Set(String)) : Nil
    return if visited.includes?(rec_type.full_name)
    visited.add(rec_type.full_name)

    if rec_type.is_a?(ModuleType)
      mod = rec_type.as(ModuleType)
      if list = mod.defs[name]?
        list.each { |d| result << d }
      end
      mod.parents.each do |p|
        collect_candidate_defs(p, name, result, visited)
      end
    elsif rec_type.is_a?(GenericInstanceType)
      # A generic instance's defs are its generic type's (Box(Int32) has Box(T)'s initialize).
      collect_candidate_defs(rec_type.as(GenericInstanceType).generic_type, name, result, visited)
    end
  end

  def format_method_display_name(rec_type : Type, name : String) : String
    if rec_type.is_a?(SemanticProgram)
      name
    elsif rec_type.is_a?(MetaclassType)
      "#{rec_type.as(MetaclassType).instance_type.full_name}.#{name}"
    else
      "#{rec_type.full_name}##{name}"
    end
  end

  def format_overload_signature(rec_type : Type, d : Def) : String
    args_strs = d.args.map do |arg|
      s = arg.name
      if r = arg.restriction
        s = "#{s} : #{r.to_s}"
      end
      if dv = arg.default_value
        s = "#{s} = #{dv.to_s}"
      end
      s
    end
    method_name = format_method_display_name(rec_type, d.name)
    "#{method_name}(#{args_strs.join(", ")})"
  end

  def min_args_count(d : Def) : Int32
    count = 0
    d.args.each do |arg|
      if arg.default_value.nil?
        count = count + 1
      end
    end
    count
  end

  def def_more_specific?(d1 : Def, d2 : Def, args : Array(ASTNode)) : Bool
    has_strict = false
    i = 0
    while i < args.size
      p1 = d1.args[i]
      p2 = d2.args[i]
      t1 = if r1 = p1.restriction
             @program.lookup_type_node(r1, @current_type)
           else
             @program.object_type
           end
      t2 = if r2 = p2.restriction
             @program.lookup_type_node(r2, @current_type)
           else
             @program.object_type
           end

      unless t1.subtype_of?(t2)
        return false
      end
      if t1 != t2
        has_strict = true
      end
      i = i + 1
    end
    has_strict
  end

  def filter_most_specific_overloads(candidates : Array(Def), args : Array(ASTNode)) : Array(Def)
    if candidates.size <= 1
      return candidates
    end

    most_specific = [] of Def
    candidates.each do |cand|
      subsumed = false
      candidates.each do |other|
        if cand != other && def_more_specific?(other, cand, args)
          subsumed = true
          break
        end
      end
      unless subsumed
        most_specific << cand
      end
    end

    if most_specific.empty?
      candidates
    else
      most_specific
    end
  end

  def number_literal_matches_type?(literal : NumberLiteral, target_type : Type) : Bool
    t_name = target_type.full_name
    if t_name == "Number" || t_name == "Value" || t_name == "Object"
      return true
    end

    if target_type.is_a?(UnionType)
      return target_type.as(UnionType).union_types.any? { |ut| number_literal_matches_type?(literal, ut) }
    end

    val = literal.value.to_i?
    return false if val.nil?
    v = val.as(Int32)
    case t_name
    when "Int8"
      v >= -128 && v <= 127
    when "UInt8"
      v >= 0 && v <= 255
    when "Int16"
      v >= -32768 && v <= 32767
    when "UInt16"
      v >= 0 && v <= 65535
    when "Int32"
      true
    when "UInt32"
      v >= 0
    when "Int64", "UInt64", "Int128", "UInt128"
      v >= 0 || t_name.starts_with?("Int")
    when "Float32", "Float64"
      true
    else
      false
    end
  end

  # The overload a call resolves to, or nil when it cannot: strict mode raises
  # the error, total mode records it on the call and returns nil.
  def lookup_method_matching(rec_type : Type, name : String, args : Array(ASTNode), call_node : Call) : Def?
    i = 0
    while i < args.size
      return nil if child_type(args[i]).nil?
      i = i + 1
    end

    candidates = [] of Def
    visited = Set(String).new
    collect_candidate_defs(rec_type, name, candidates, visited)

    if candidates.empty?
      if obj_node = call_node.obj
        obj_t = type_of(obj_node)
        if obj_t.is_a?(UnionType)
          return refuse_call(call_node, "undefined method '#{name}' for #{rec_type.full_name} (compile-time type is #{obj_t.full_name})")
        else
          return refuse_call(call_node, "undefined method '#{name}' for #{rec_type.full_name}")
        end
      else
        scope_name = if rec_type.is_a?(SemanticProgram)
                       "top-level"
                     else
                       rec_type.full_name
                     end
        return refuse_call(call_node, "undefined local variable or method '#{name}' for #{scope_name}")
      end
    end

    # 1. Filter by argument count
    count_matches = [] of Def
    candidates.each do |d|
      min_a = min_args_count(d)
      max_a = d.args.size
      if args.size >= min_a && args.size <= max_a
        count_matches << d
      end
    end

    if count_matches.empty?
      overload_lines = candidates.map { |d| " - #{format_overload_signature(rec_type, d)}" }
      overloads_str = "Overloads are:\n#{overload_lines.join("\n")}"
      method_disp = format_method_display_name(rec_type, name)
      expected_str = if candidates.size == 1
                       candidates.first.args.size.to_s
                     else
                       min_all = candidates.map { |d| min_args_count(d) }.min
                       max_all = candidates.map { |d| d.args.size }.max
                       min_all == max_all ? min_all.to_s : "#{min_all}..#{max_all}"
                     end
      return refuse_call(call_node, "wrong number of arguments for '#{method_disp}' (given #{args.size}, expected #{expected_str})\n#{overloads_str}")
    end

    # 2. Check exact / subtype argument matches
    exact_matches = [] of Def
    count_matches.each do |d|
      all_args_match = true
      i = 0
      while i < args.size
        arg_type = type_of(args[i])
        param = d.args[i]
        if r = param.restriction
          expected_type = restriction_type(r, rec_type)
          unless arg_type.subtype_of?(expected_type)
            all_args_match = false
            break
          end
        end
        i = i + 1
      end
      if all_args_match
        exact_matches << d
      end
    end

    if exact_matches.size > 0
      most_specific = filter_most_specific_overloads(exact_matches, args)
      return most_specific.first
    end

    # 3. Check autocast matches for literals
    has_literal_arg = args.any? { |a| a.is_a?(NumberLiteral) }
    if has_literal_arg
      autocast_matches = [] of Def
      autocast_types = [] of String
      count_matches.each do |d|
        all_match = true
        matched_t_name = ""
        i = 0
        while i < args.size
          arg = args[i]
          arg_t = type_of(arg)
          param = d.args[i]
          if r = param.restriction
            expected_t = @program.lookup_type_node(r, @current_type)
            if arg_t.subtype_of?(expected_t)
              # exact subtype match
            elsif arg.is_a?(NumberLiteral) && number_literal_matches_type?(arg.as(NumberLiteral), expected_t)
              matched_t_name = expected_t.full_name
            else
              all_match = false
              break
            end
          end
          i = i + 1
        end
        if all_match
          autocast_matches << d
          autocast_types << matched_t_name
        end
      end

      if autocast_matches.size > 1
        lit_val = ""
        args.each do |a|
          if a.is_a?(NumberLiteral)
            lit_val = a.as(NumberLiteral).value
            break
          end
        end
        uniq_types = [] of String
        autocast_types.each do |tn|
          unless tn.empty? || uniq_types.includes?(tn)
            uniq_types << tn
          end
        end
        return refuse_call(call_node, "ambiguous call, implicit cast of #{lit_val} matches all of #{uniq_types.join(", ")}")
      elsif autocast_matches.size == 1
        return autocast_matches.first
      end
    end

    # 4. Error reporting for no matching overload
    all_same_mismatch = true
    mismatch_idx = -1
    count_matches.each do |d|
      first_mismatch = -1
      i = 0
      while i < args.size
        arg_t = type_of(args[i])
        param = d.args[i]
        if r = param.restriction
          exp_t = @program.lookup_type_node(r, @current_type)
          unless arg_t.subtype_of?(exp_t)
            first_mismatch = i
            break
          end
        end
        i = i + 1
      end
      if mismatch_idx == -1
        mismatch_idx = first_mismatch
      elsif mismatch_idx != first_mismatch
        all_same_mismatch = false
      end
    end

    method_disp = format_method_display_name(rec_type, name)
    overload_lines = count_matches.map { |d| " - #{format_overload_signature(rec_type, d)}" }
    overloads_str = "Overloads are:\n#{overload_lines.join("\n")}"

    if all_same_mismatch && mismatch_idx != -1
      expected_types_list = [] of String
      count_matches.each do |d|
        param = d.args[mismatch_idx]
        if r = param.restriction
          exp_t = @program.lookup_type_node(r, @current_type)
          expected_types_list << exp_t.full_name
        end
      end
      uniq_exp = [] of String
      expected_types_list.each do |en|
        uniq_exp << en unless uniq_exp.includes?(en)
      end
      expected_types_str = uniq_exp.join(" or ")
      actual_type_str = type_of(args[mismatch_idx]).full_name
      refuse_call(call_node, "expected argument ##{mismatch_idx + 1} to '#{method_disp}' to be #{expected_types_str}, not #{actual_type_str}\n\n#{overloads_str}")
    else
      arg_types_strs = args.map { |a| type_of(a).full_name }
      plural = (args.size > 1) ? "s" : ""
      refuse_call(call_node, "no overload matches '#{method_disp}' with type#{plural} #{arg_types_strs.join(", ")}\n\n#{overloads_str}")
    end
  end

  # A call the port cannot resolve: strict mode raises, total mode records the
  # reason on the call and answers nil.
  def refuse_call(call_node : Call, message : String) : Nil
    refuse(call_node, message)
    nil
  end

  # The key of one instantiation: the receiver, the def name and the argument
  # types, and for a block call the block's node. Two calls with different blocks
  # are different instantiations (a block nested in another call's block is not a
  # recursion of that call); the same call with the same block is.
  def instance_key(rec_type : Type, target_def : Def, args : Array(ASTNode), block : Block?) : String
    parts = [] of String
    args.each do |a|
      if at = child_type(a)
        parts << at.full_name
      else
        parts << "?"
      end
    end
    key = "#{rec_type.full_name}##{target_def.name}(#{parts.join(",")})"
    if block
      key = key + "&#{block.node_id}"
    end
    key
  end

  # A recursive call or an over-deep instantiation is refused at the call site, or
  # at the def's body when there is no site.
  def refuse_recursion(site : ASTNode?, target_def : Def, message : String) : Type?
    anchor : ASTNode = target_def.body.as(ASTNode)
    if s = site
      anchor = s
    end
    refuse(anchor, message)
    nil
  end

  # The type a body evaluates to with `args` bound to its parameters, or nil when
  # the body or an argument cannot be typed. `site` is the node that reports a
  # return-type mismatch.
  def type_method_body(target_def : Def, rec_type : Type, args : Array(ASTNode), block : Block?, site : ASTNode? = nil) : Type?
    body = target_def.body
    if body.nil? || body.is_a?(Nop) || body.is_a?(MacroLiteral)
      if rt = target_def.return_type
        return @program.lookup_type_node(rt, @current_type)
      else
        return @program.nil_type
      end
    end

    # A def typed again while its body is being typed is a recursive call: it takes
    # the declared return type, or the call is refused. The depth bounds a chain of
    # instantiations whose argument types keep growing.
    key = instance_key(rec_type, target_def, args, block)
    if @typing_stack.includes?(key)
      if rt = target_def.return_type
        return @program.lookup_type_node(rt, @current_type)
      end
      # No declared return type: until the body's own type is known the recursive
      # call contributes nothing to a merge, so it is NoReturn (the bottom of the
      # merge). The hosted pass gets the same answer from the non-recursive returns
      # (bench/fixtures/sem_bodies_recursive.iyi: count(true) is Int32).
      return @program.no_return_type
    end
    if @typing_stack.size >= 256
      return refuse_recursion(site, target_def, "instantiation depth exceeded at '#{target_def.name}'")
    end

    old_vars = @vars
    old_scope = @scope
    old_def = @current_def
    old_block_call = @current_call_block
    old_block_context_vars = @current_block_context_vars
    old_yield_nodes = @current_yield_nodes
    old_var_unions = @var_unions
    old_untyped_locals = @untyped_locals
    @untyped_locals = Hash(String, String).new
    @var_unions = Hash(String, Type).new

    if block
      @current_block_context_vars = @vars.dup
      @current_yield_nodes = [] of Yield
    end

    new_vars = Hash(String, Type).new
    if rec_type.is_a?(MetaclassType)
      new_vars["self"] = rec_type
    elsif rec_type.is_a?(SemanticProgram)
      # No self at top-level
    else
      new_vars["self"] = rec_type
    end

    inst_args = [] of Type
    params_typed = true
    i = 0
    while i < target_def.args.size
      param = target_def.args[i]
      param_type : Type? = nil
      if i < args.size
        param_type = child_type(args[i])
      elsif dv = param.default_value
        dv.accept(self)
        param_type = child_type(dv)
      elsif r = param.restriction
        param_type = @program.lookup_type_node(r, @current_type)
      else
        param_type = @program.nil_type
      end
      if pt = param_type
        new_vars[param.name] = pt
        inst_args << pt
        # iyi: the instantiated clone's parameter carries its type, so the lowering
        # reads the argument types from the def (hosted codegen/ast.cr 48).
        set_type(param, pt)
        if param.name.starts_with?("@") && !param.name.starts_with?("@@")
          if rec_type.is_a?(ModuleType)
            rec_type.as(ModuleType).instance_vars[param.name] = MetaTypeVar.new(param.name, pt)
          end
        end
      else
        params_typed = false
      end
      i = i + 1
    end
    @vars = new_vars
    @scope = rec_type
    @current_def = target_def
    @current_call_block = block

    @typing_stack << key
    if params_typed
      self_t : Type? = nil
      unless rec_type.is_a?(SemanticProgram)
        self_t = rec_type
      end
      @typed_instances << TypedInstance.new(target_def, self_t, inst_args)
    end
    body.as(ASTNode).accept(self)
    body_type = child_type(body.as(ASTNode))

    if block && (ctx_vars = @current_block_context_vars)
      ctx_vars.each do |k, new_v|
        if old_v = old_vars[k]?
          if old_v != new_v
            old_vars[k] = @program.type_merge(old_v, new_v)
          end
        end
      end
    end

    if block
      if final_blk_t = child_type(block)
        if y_nodes = @current_yield_nodes
          y_nodes.each do |ynode|
            set_type(ynode, final_blk_t)
          end
        end
      end
    end

    @vars = old_vars
    @scope = old_scope
    @current_def = old_def
    @current_call_block = old_block_call
    @current_block_context_vars = old_block_context_vars
    @current_yield_nodes = old_yield_nodes
    @def_var_unions[target_def] = @var_unions
    @var_unions = old_var_unions
    @untyped_locals = old_untyped_locals
    @typing_stack.pop

    return nil unless params_typed
    bt = body_type
    # A body that cannot be typed (its refusal is recorded on the body's own nodes)
    # still leaves a call its declared return type, as the oracle types it
    # (bench/fixtures/sem_bodies_primitive_add.iyi).
    if bt.nil?
      if rt = target_def.return_type
        set_type(target_def, @program.lookup_type_node(rt, @current_type))
        return @program.lookup_type_node(rt, @current_type)
      end
      return nil
    end

    if rt = target_def.return_type
      declared_ret = @program.lookup_type_node(rt, @current_type)
      unless bt.subtype_of?(declared_ret)
        mismatch = "type mismatch for return type: expected #{declared_ret.full_name}, got #{bt.full_name}"
        if s = site
          refuse(s, mismatch)
        else
          raise(mismatch) unless @total
        end
        return nil
      end
      set_type(target_def, declared_ret)
      declared_ret
    else
      set_type(target_def, bt)
      bt
    end
  end

  def visit(node : Call) : Bool
    if expand_macro(node)
      return false
    end

    if node.obj.nil? && node.args.empty? && node.block.nil?
      if vt = @vars[node.name]?
        set_type(node, vt)
        return false
      end
    end

    node.args.each do |arg|
      arg.accept(self)
    end

    rec_type : Type
    if obj = node.obj
      obj.accept(self)
      if ot = child_type(obj)
        rec_type = ot
      else
        return false
      end
    else
      rec_type = @scope || @current_type
    end

    # Multiple dispatch over a union receiver
    if rec_type.is_a?(UnionType)
      union_t = rec_type.as(UnionType)
      ret_types = [] of Type
      first_target_def : Def? = nil

      i = 0
      while i < union_t.union_types.size
        ut = union_t.union_types[i]
        target_def = lookup_method_matching(ut, node.name, node.args, node)
        return false if target_def.nil?
        instantiated_def = target_def.clone
        ret_t = type_method_body(instantiated_def, ut, node.args, node.block, node)
        return false if ret_t.nil?
        if first_target_def.nil?
          first_target_def = instantiated_def
        end
        ret_types << ret_t
        i = i + 1
      end

      if td = first_target_def
        @call_target_defs[node] = td
      end

      merged_ret = @program.type_merge(ret_types)
      set_type(node, merged_ret)
      return false
    end

    target_def = lookup_method_matching(rec_type, node.name, node.args, node)
    return false if target_def.nil?
    # A positional call that leaves parameters to their defaults gets them as
    # cloned argument nodes, one per parameter (hosted expansion; the calls slice's
    # DefaultArguments). The new nodes are visited here; the rest were visited above.
    if node.named_args.nil? && DefaultArguments.supported?(target_def, node.args, nil)
      original_count = node.args.size
      node.args = DefaultArguments.expand(target_def, node.args, nil)
      i = original_count
      while i < node.args.size
        node.args[i].accept(self)
        i = i + 1
      end
    end
    instantiated_def = target_def.clone
    @call_target_defs[node] = instantiated_def

    ret_type = type_method_body(instantiated_def, rec_type, node.args, node.block)
    if ret_type
      set_type(node, ret_type)
    end
    false
  end

  # A tuple literal is the tuple of its elements' types (hosted visit(TupleLiteral)).
  def visit(node : TupleLiteral) : Bool
    types = [] of Type
    i = 0
    while i < node.elements.size
      e = node.elements[i]
      e.accept(self)
      if et = child_type(e)
        types << et
      else
        return false
      end
      i = i + 1
    end
    set_type(node, tuple_type_of(@program, types))
    false
  end

  # A named tuple literal is the named tuple of its entries' types (hosted
  # visit(NamedTupleLiteral)).
  def visit(node : NamedTupleLiteral) : Bool
    entries = [] of NamedArgumentType
    i = 0
    while i < node.entries.size
      entry = node.entries[i]
      entry.value.accept(self)
      if et = child_type(entry.value)
        entries << NamedArgumentType.new(entry.key, et)
      else
        return false
      end
      i = i + 1
    end
    set_type(node, named_tuple_type_of(@program, entries))
    false
  end

  # --- type nodes: begin ---
  # The type-argument bracket the type-node functions use (hosted `@in_type_args`).
  def bracket_type_args(delta : Int32) : Nil
    @in_type_args = @in_type_args + delta
  end

  def visit(node : Generic) : Bool
    visit_generic(self, node)
  end

  def visit(node : Union) : Bool
    visit_union(self, node)
  end

  def visit(node : ProcNotation) : Bool
    visit_proc_notation(self, node)
  end

  def visit(node : Metaclass) : Bool
    visit_metaclass(self, node)
  end

  def visit(node : FunDef) : Bool
    visit_fun_def(self, node)
  end

  def visit(node : Self) : Bool
    visit_self(self, node)
  end

  def visit(node : PointerOf) : Bool
    visit_pointer_of(self, node)
  end

  def visit(node : TypeOf) : Bool
    visit_type_of(self, node)
  end

  def visit(node : SizeOf) : Bool
    visit_size_of(self, node)
  end

  def visit(node : AlignOf) : Bool
    visit_align_of(self, node)
  end

  def visit(node : InstanceSizeOf) : Bool
    visit_instance_size_of(self, node)
  end

  def visit(node : InstanceAlignOf) : Bool
    visit_instance_align_of(self, node)
  end

  def visit(node : EnumDef) : Bool
    visit_enum_def(self, node)
  end

  def visit(node : UninitializedVar) : Bool
    visit_uninitialized_var(self, node)
  end

  # The visitor of a fun body: the same node types and errors, its own locals.
  def sub_visitor(vars : Hash(String, Type)) : TypeNodeHost
    inner = MainVisitor.new(@program)
    inner.vars = vars
    inner.scope = @program
    inner.current_type = @current_type
    inner.node_types = @node_types
    inner.untyped_reasons = @untyped_reasons
    inner.call_target_defs = @call_target_defs
    inner.total = @total
    inner.typing_stack = @typing_stack
    inner.refusals = @refusals
    inner.typed_instances = @typed_instances
    inner.untyped_locals = Hash(String, String).new
    inner
  end

  def visit(node : Cast) : Bool
    visit_cast(self, node)
  end

  def visit(node : NilableCast) : Bool
    visit_nilable_cast(self, node)
  end

  # Whether the node being visited is inside a type argument.
  def in_type_args? : Bool
    @in_type_args > 0
  end
  # --- type nodes: end ---
end

pub def node_class_name(node : ASTNode) : String
  if node.is_a?(Alias)
    "Alias"
  elsif node.is_a?(AlignOf)
    "AlignOf"
  elsif node.is_a?(And)
    "And"
  elsif node.is_a?(Annotation)
    "Annotation"
  elsif node.is_a?(AnnotationDef)
    "AnnotationDef"
  elsif node.is_a?(Arg)
    "Arg"
  elsif node.is_a?(ArrayLiteral)
    "ArrayLiteral"
  elsif node.is_a?(Asm)
    "Asm"
  elsif node.is_a?(AsmOperand)
    "AsmOperand"
  elsif node.is_a?(Assign)
    "Assign"
  elsif node.is_a?(AssocTypeDecl)
    "AssocTypeDecl"
  elsif node.is_a?(Block)
    "Block"
  elsif node.is_a?(BoolLiteral)
    "BoolLiteral"
  elsif node.is_a?(Break)
    "Break"
  elsif node.is_a?(CStructOrUnionDef)
    "CStructOrUnionDef"
  elsif node.is_a?(Call)
    "Call"
  elsif node.is_a?(Case)
    "Case"
  elsif node.is_a?(Cast)
    "Cast"
  elsif node.is_a?(CharLiteral)
    "CharLiteral"
  elsif node.is_a?(ClassDef)
    "ClassDef"
  elsif node.is_a?(ClassVar)
    "ClassVar"
  elsif node.is_a?(Def)
    "Def"
  elsif node.is_a?(Defer)
    "Defer"
  elsif node.is_a?(DoubleSplat)
    "DoubleSplat"
  elsif node.is_a?(EnumDef)
    "EnumDef"
  elsif node.is_a?(ExceptionHandler)
    "ExceptionHandler"
  elsif node.is_a?(Expressions)
    "Expressions"
  elsif node.is_a?(Extend)
    "Extend"
  elsif node.is_a?(ExternalVar)
    "ExternalVar"
  elsif node.is_a?(FunDef)
    "FunDef"
  elsif node.is_a?(Generic)
    "Generic"
  elsif node.is_a?(Global)
    "Global"
  elsif node.is_a?(HashLiteral)
    "HashLiteral"
  elsif node.is_a?(If)
    "If"
  elsif node.is_a?(ImplDef)
    "ImplDef"
  elsif node.is_a?(ImplicitObj)
    "ImplicitObj"
  elsif node.is_a?(ImportDecl)
    "ImportDecl"
  elsif node.is_a?(Include)
    "Include"
  elsif node.is_a?(InstanceAlignOf)
    "InstanceAlignOf"
  elsif node.is_a?(InstanceSizeOf)
    "InstanceSizeOf"
  elsif node.is_a?(InstanceVar)
    "InstanceVar"
  elsif node.is_a?(IsA)
    "IsA"
  elsif node.is_a?(LibDef)
    "LibDef"
  elsif node.is_a?(Macro)
    "Macro"
  elsif node.is_a?(MacroExpression)
    "MacroExpression"
  elsif node.is_a?(MacroFor)
    "MacroFor"
  elsif node.is_a?(MacroIf)
    "MacroIf"
  elsif node.is_a?(MacroLiteral)
    "MacroLiteral"
  elsif node.is_a?(MacroVar)
    "MacroVar"
  elsif node.is_a?(MacroVerbatim)
    "MacroVerbatim"
  elsif node.is_a?(MagicConstant)
    "MagicConstant"
  elsif node.is_a?(Metaclass)
    "Metaclass"
  elsif node.is_a?(ModuleDef)
    "ModuleDef"
  elsif node.is_a?(ModuleHeader)
    "ModuleHeader"
  elsif node.is_a?(MultiAssign)
    "MultiAssign"
  elsif node.is_a?(NamedArgument)
    "NamedArgument"
  elsif node.is_a?(NamedTupleLiteral)
    "NamedTupleLiteral"
  elsif node.is_a?(Next)
    "Next"
  elsif node.is_a?(NilLiteral)
    "NilLiteral"
  elsif node.is_a?(NilableCast)
    "NilableCast"
  elsif node.is_a?(Nop)
    "Nop"
  elsif node.is_a?(Not)
    "Not"
  elsif node.is_a?(NumberLiteral)
    "NumberLiteral"
  elsif node.is_a?(OffsetOf)
    "OffsetOf"
  elsif node.is_a?(OpAssign)
    "OpAssign"
  elsif node.is_a?(Or)
    "Or"
  elsif node.is_a?(Out)
    "Out"
  elsif node.is_a?(Path)
    "Path"
  elsif node.is_a?(PointerOf)
    "PointerOf"
  elsif node.is_a?(ProcLiteral)
    "ProcLiteral"
  elsif node.is_a?(ProcNotation)
    "ProcNotation"
  elsif node.is_a?(ProcPointer)
    "ProcPointer"
  elsif node.is_a?(Propagate)
    "Propagate"
  elsif node.is_a?(RangeLiteral)
    "RangeLiteral"
  elsif node.is_a?(ReadInstanceVar)
    "ReadInstanceVar"
  elsif node.is_a?(Recover)
    "Recover"
  elsif node.is_a?(RegexLiteral)
    "RegexLiteral"
  elsif node.is_a?(Require)
    "Require"
  elsif node.is_a?(Rescue)
    "Rescue"
  elsif node.is_a?(RespondsTo)
    "RespondsTo"
  elsif node.is_a?(Return)
    "Return"
  elsif node.is_a?(Select)
    "Select"
  elsif node.is_a?(Self)
    "Self"
  elsif node.is_a?(SizeOf)
    "SizeOf"
  elsif node.is_a?(Splat)
    "Splat"
  elsif node.is_a?(StringInterpolation)
    "StringInterpolation"
  elsif node.is_a?(StringLiteral)
    "StringLiteral"
  elsif node.is_a?(SymbolLiteral)
    "SymbolLiteral"
  elsif node.is_a?(TraitDef)
    "TraitDef"
  elsif node.is_a?(TupleLiteral)
    "TupleLiteral"
  elsif node.is_a?(TypeDeclaration)
    "TypeDeclaration"
  elsif node.is_a?(TypeDef)
    "TypeDef"
  elsif node.is_a?(TypeOf)
    "TypeOf"
  elsif node.is_a?(Underscore)
    "Underscore"
  elsif node.is_a?(UninitializedVar)
    "UninitializedVar"
  elsif node.is_a?(Union)
    "Union"
  elsif node.is_a?(Unless)
    "Unless"
  elsif node.is_a?(Until)
    "Until"
  elsif node.is_a?(UsingDecl)
    "UsingDecl"
  elsif node.is_a?(Var)
    "Var"
  elsif node.is_a?(VisibilityModifier)
    "VisibilityModifier"
  elsif node.is_a?(When)
    "When"
  elsif node.is_a?(While)
    "While"
  elsif node.is_a?(Yield)
    "Yield"
  else
    "ASTNode"
  end
end

pub def dump_typed_node(node : ASTNode, visitor : MainVisitor, sb : String::Builder, indent : String = "") : Nil
  type_str = if t = visitor.type_of?(node)
               t.full_name
             else
               "nil"
             end
  node_name = node_class_name(node)
  sb << indent << node_name << ": " << type_str << "\n"

  if node.is_a?(Expressions)
    node.as(Expressions).expressions.each do |e|
      dump_typed_node(e, visitor, sb, "#{indent}  ")
    end
  elsif node.is_a?(Assign)
    asgn = node.as(Assign)
    sb << indent << "  target:\n"
    dump_typed_node(asgn.target, visitor, sb, "#{indent}    ")
    sb << indent << "  value:\n"
    dump_typed_node(asgn.value, visitor, sb, "#{indent}    ")
  elsif node.is_a?(Var)
    sb << indent << "  name: " << node.as(Var).name << "\n"
  elsif node.is_a?(InstanceVar)
    sb << indent << "  name: " << node.as(InstanceVar).name << "\n"
  elsif node.is_a?(ClassVar)
    sb << indent << "  name: " << node.as(ClassVar).name << "\n"
  elsif node.is_a?(Path)
    sb << indent << "  names: [" << node.as(Path).names.join("::") << "]\n"
  elsif node.is_a?(NumberLiteral)
    num = node.as(NumberLiteral)
    sb << indent << "  value: " << num.value
    case num.kind
    when NumberKind::I32
      # no suffix
    when NumberKind::F64
      has_dot = false
      dot_i = 0
      while dot_i < num.value.bytesize
        b = num.value.byte_at(dot_i)
        if b == 46_u8 || b == 101_u8
          has_dot = true
          break
        end
        dot_i = dot_i + 1
      end
      unless has_dot
        sb << "_" << num.kind.to_s
      end
    else
      sb << "_" << num.kind.to_s
    end
    sb << "\n"
  elsif node.is_a?(StringLiteral) || node.is_a?(BoolLiteral) || node.is_a?(CharLiteral) || node.is_a?(SymbolLiteral) || node.is_a?(NilLiteral)
    sb << indent << "  value: " << node.to_s << "\n"
  elsif node.is_a?(If)
    if_node = node.as(If)
    sb << indent << "  cond:\n"
    dump_typed_node(if_node.cond, visitor, sb, "#{indent}    ")
    sb << indent << "  then:\n"
    dump_typed_node(if_node.then, visitor, sb, "#{indent}    ")
    if els = if_node.else
      sb << indent << "  else:\n"
      dump_typed_node(els, visitor, sb, "#{indent}    ")
    end
  elsif node.is_a?(While)
    wh = node.as(While)
    sb << indent << "  cond:\n"
    dump_typed_node(wh.cond, visitor, sb, "#{indent}    ")
    sb << indent << "  body:\n"
    dump_typed_node(wh.body, visitor, sb, "#{indent}    ")
  elsif node.is_a?(Yield)
    yd = node.as(Yield)
    unless yd.exps.empty?
      sb << indent << "  yield_exps:\n"
      yd.exps.each do |e|
        dump_typed_node(e, visitor, sb, "#{indent}    ")
      end
    end
  elsif node.is_a?(Return)
    ret = node.as(Return)
    if exp = ret.exp
      sb << indent << "  exp:\n"
      dump_typed_node(exp, visitor, sb, "#{indent}    ")
    end
  elsif node.is_a?(Call)
    c = node.as(Call)
    sb << indent << "  name: " << c.name << "\n"
    if obj = c.obj
      sb << indent << "  obj:\n"
      dump_typed_node(obj, visitor, sb, "#{indent}    ")
    end
    unless c.args.empty?
      sb << indent << "  args:\n"
      c.args.each do |a|
        dump_typed_node(a, visitor, sb, "#{indent}    ")
      end
    end
    if blk = c.block
      sb << indent << "  block:\n"
      dump_typed_node(blk, visitor, sb, "#{indent}    ")
    end
    if (td = visitor.target_def?(c)) && td.name != "new"
      ret_type_str = if t = visitor.type_of?(td)
                       t.full_name
                     else
                       "nil"
                     end
      sb << indent << "  target_def: " << td.name << ": " << ret_type_str << "\n"
      if body = td.body
        sb << indent << "  target_body:\n"
        dump_typed_node(body, visitor, sb, "#{indent}    ")
      end
    end
  elsif node.is_a?(Block)
    blk = node.as(Block)
    unless blk.args.empty?
      args_strs = blk.args.map do |a|
        t_str = if t = visitor.type_of?(a)
                  t.full_name
                else
                  "nil"
                end
        "#{a.name}: #{t_str}"
      end
      sb << indent << "  block_args: [" << args_strs.join(", ") << "]\n"
    end
    sb << indent << "  body:\n"
    dump_typed_node(blk.body, visitor, sb, "#{indent}    ")
  elsif node.is_a?(Def)
    sb << indent << "  name: " << node.as(Def).name << "\n"
  elsif node.is_a?(ClassDef)
    sb << indent << "  name: " << node.as(ClassDef).name.to_s << "\n"
  end
end

pub class CleanupTransformer < Transformer
  def transform(node : Call) : ASTNode
    if exp = node.expanded
      exp.transform(self)
    else
      super(node)
    end
  end

  def transform(node : Expressions) : ASTNode
    new_exps = [] of ASTNode
    node.expressions.each do |exp|
      transformed = exp.transform(self)
      if transformed.is_a?(Expressions)
        transformed.as(Expressions).expressions.each do |sub|
          new_exps << sub
        end
      else
        new_exps << transformed
      end
    end
    node.expressions = new_exps
    node
  end
end

pub def dump_program_expressions(program : SemanticProgram, node : ASTNode, visitor : MainVisitor) : String
  sb = String::Builder.new
  cleaned_node = CleanupTransformer.new.transform(node)
  dump_typed_node(cleaned_node, visitor, sb, "")
  sb.to_s
end
