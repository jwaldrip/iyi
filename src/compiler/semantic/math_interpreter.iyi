module compiler/semantic/math_interpreter

# Folds constant integer expressions: `1 + 2` for an enum value, a constant
# or a StaticArray size. Port of src/compiler/iyi/semantic/math_interpreter.cr
# (the hosted compiler), for iyi source only, so the hosted `iyi_rules?` branch
# is the only one ported: `//` truncates, `%` takes the dividend's sign, and
# shifts past the width answer zero (or the sign). Values are folded as signed
# 128-bit integers, each with the kind the hosted compiler answers with.
#
# What the port refuses by name, rather than answering. Each is a MathError
# with `refused` set, and its message begins with the reason:
#   - a value at or above 2^127 of kind UInt128 (the port stores no more);
#   - a path to a constant (the hosted lookup needs the program's types);
#   - a call the hosted compiler hands to macro expansion (it needs the
#     visitor): every call that is not one of the operators below, and any
#     unary operator on an unsigned kind;
#   - a divisor that changes sign when it is wrapped to the left kind and
#     then becomes zero (the hosted division traps there).
#
# The kind rules, each measured against the hosted compiler:
#   + - * answer exactly and must fit the left operand's kind ("Arithmetic
#     overflow"); &+ &- &* & | ^ answer the exact value wrapped to the left
#     kind; unary - must fit the kind; ~ wraps.
#   // and % with operands of the same signedness divide the exact values;
#     with mixed signedness the divisor is first wrapped to the left kind.
#     `//` on the least value of a signed kind by -1 is "Overflow: Int8::MIN / -1".
#   << and >> with a count at or past the width answer zero, or the sign for
#     a negative value shifted right; a negative count shifts the other way,
#     and a count below -2147483647 overflows the Int32 it is negated in.
#
# iyi has no catchable exceptions: a value out of range panics, so every
# range is checked before the operation runs.

import std/int
import compiler/syntax/ast::{ASTNode, Call, Expressions, NumberLiteral, Path}
import compiler/syntax/token::{NumberKind}

pub class MathValue
  getter value : Int128
  getter kind : NumberKind

  def initialize(@value : Int128, @kind : NumberKind)
  end
end

pub class MathError
  getter message : String
  getter refused : Bool

  def initialize(@message : String, @refused : Bool = false)
  end
end

pub alias MathResult = MathValue | MathError

# An exact result before it is checked against a kind: a sign, a magnitude,
# and `beyond` when the magnitude does not fit in UInt128.
class MathExact
  getter negative : Bool
  getter magnitude : UInt128
  getter beyond : Bool

  def initialize(@negative : Bool, @magnitude : UInt128, @beyond : Bool = false)
  end
end

pub class MathInterpreter
  getter target : NumberKind?

  def initialize(@target : NumberKind? = nil)
  end

  def interpret(node : ASTNode) : MathResult
    if node.is_a?(NumberLiteral)
      return interpret_number(node.as(NumberLiteral))
    end
    if node.is_a?(Call)
      return interpret_call(node.as(Call))
    end
    if node.is_a?(Path)
      return MathError.new("a constant path needs the program's types, which the port does not carry", true)
    end
    if node.is_a?(Expressions)
      expressions = node.as(Expressions).expressions
      if expressions.size == 1
        return interpret(expressions[0])
      end
      return MathError.new("invalid constant value")
    end
    MathError.new("invalid constant value")
  end

  def interpret_number(node : NumberLiteral) : MathResult
    kind = node.kind
    unless kind.signed? || kind.unsigned?
      return MathError.new("constant value must be an integer, not #{kind.to_s}")
    end
    target_kind = @target || kind
    MathInterpreter.parse_literal(node.value, target_kind)
  end

  def interpret_call(node : Call) : MathResult
    obj = node.obj
    return MathInterpreter.macro_refusal(node.name) unless obj
    if node.args.size == 0
      left = interpret(obj)
      return left if left.is_a?(MathError)
      return MathInterpreter.unary(left.as(MathValue), node.name)
    end
    if node.args.size == 1
      left = interpret(obj)
      return left if left.is_a?(MathError)
      right = interpret(node.args[0])
      return right if right.is_a?(MathError)
      return MathInterpreter.binary(left.as(MathValue), right.as(MathValue), node.name)
    end
    MathError.new("invalid constant value")
  end

  # The hosted `interpret_call_macro` with no visitor answers "invalid
  # constant value"; with a visitor it expands a macro. The port has no
  # visitor, so it refuses instead of answering either way.
  def self.macro_refusal(name : String) : MathError
    MathError.new("call #{name} may expand as a macro, which the port cannot run", true)
  end

  def self.unary(value : MathValue, name : String) : MathResult
    case name
    when "+"
      value
    when "-"
      return macro_refusal(name) unless value.kind.signed?
      exact = exact_of(value.value)
      classify(value.kind, MathExact.new(!exact.negative, exact.magnitude))
    when "~"
      wrap(~value.value, value.kind)
    else
      macro_refusal(name)
    end
  end

  def self.binary(left : MathValue, right : MathValue, name : String) : MathResult
    kind = left.kind
    case name
    when "+"
      classify(kind, exact_add(exact_of(left.value), exact_of(right.value)))
    when "-"
      classify(kind, exact_add(exact_of(left.value), negate(exact_of(right.value))))
    when "*"
      classify(kind, exact_mul(exact_of(left.value), exact_of(right.value)))
    when "&+"
      wrap(left.value &+ right.value, kind)
    when "&-"
      wrap(left.value &- right.value, kind)
    when "&*"
      wrap(left.value &* right.value, kind)
    when "&"
      wrap(left.value & right.value, kind)
    when "|"
      wrap(left.value | right.value, kind)
    when "^"
      wrap(left.value ^ right.value, kind)
    when "//"
      quotient(left, right)
    when "%"
      remainder(left, right)
    when "<<"
      shift_left(left, right.value)
    when ">>"
      shift_right(left, right.value)
    else
      macro_refusal(name)
    end
  end

  # Literals first: the target kind (when there is one) decides the kind and
  # the range, as the hosted `to_i8?` family does. A literal that does not fit
  # is "invalid Int8: 300" with the text as written.
  def self.parse_literal(text : String, kind : NumberKind) : MathResult
    negative = false
    start = 0
    if text.bytesize > 0 && text.byte_at(0) == 45_u8
      negative = true
      start = 1
    elsif text.bytesize > 0 && text.byte_at(0) == 43_u8
      start = 1
    end
    invalid = MathError.new("invalid #{kind_name(kind)}: #{text}")
    if start >= text.bytesize
      return invalid
    end
    magnitude = 0_u128
    beyond = false
    i = start
    while i < text.bytesize
      b = text.byte_at(i)
      return invalid if b < 48_u8 || b > 57_u8
      digit = (b - 48_u8).to_u128
      unless beyond
        if magnitude > (umax - digit) // 10_u128
          beyond = true
        else
          magnitude = magnitude * 10_u128 + digit
        end
      end
      i += 1
    end
    return invalid if beyond
    return invalid unless literal_fits(kind, negative, magnitude)
    if kind == NumberKind::U128 && magnitude >= two127
      return MathError.new("value above the signed 128-bit range, which the port does not carry", true)
    end
    MathValue.new(signed_of(negative, magnitude), kind)
  end

  def self.quotient(left : MathValue, right : MathValue) : MathResult
    kind = left.kind
    return MathError.new("Division by 0") if right.value == 0_i128
    if kind.signed? && left.value == min_of(kind) && right.value == -1_i128
      return MathError.new("Overflow: #{kind_name(kind)}::MIN / -1")
    end
    divisor = right.value
    if kind.signed? != right.kind.signed?
      converted = wrap(right.value, kind)
      return converted if converted.is_a?(MathError)
      divisor = converted.as(MathValue).value
      if divisor == 0_i128
        return MathError.new("the divisor wraps to zero in #{kind_name(kind)}, which the port does not fold", true)
      end
    end
    negative = (left.value < 0_i128) != (divisor < 0_i128)
    magnitude = magnitude_of(left.value) // magnitude_of(divisor)
    wrap(signed_of(negative, magnitude), kind)
  end

  def self.remainder(left : MathValue, right : MathValue) : MathResult
    kind = left.kind
    return MathError.new("Division by 0") if right.value == 0_i128
    if kind.signed? && left.value == min_of(kind) && right.value == -1_i128
      return MathValue.new(0_i128, kind)
    end
    divisor = right.value
    if kind.signed? != right.kind.signed?
      converted = wrap(right.value, kind)
      return converted if converted.is_a?(MathError)
      divisor = converted.as(MathValue).value
      if divisor == 0_i128
        return MathError.new("the divisor wraps to zero in #{kind_name(kind)}, which the port does not fold", true)
      end
    end
    magnitude = magnitude_of(left.value) % magnitude_of(divisor)
    wrap(signed_of(left.value < 0_i128, magnitude), kind)
  end

  # A count at or past the width answers zero: `1 << 64` is 0 for an Int32.
  # A negative count shifts the other way; its negation is computed in Int32,
  # so a count below -2147483647 overflows there.
  def self.shift_left(value : MathValue, count : Int128) : MathResult
    if count < 0_i128
      return MathError.new("Arithmetic overflow") if count < -2147483647_i128
      return shift_right_by(value, 0_i128 - count)
    end
    shift_left_by(value, count)
  end

  def self.shift_right(value : MathValue, count : Int128) : MathResult
    if count < 0_i128
      return MathError.new("Arithmetic overflow") if count < -2147483647_i128
      return shift_left_by(value, 0_i128 - count)
    end
    shift_right_by(value, count)
  end

  def self.shift_left_by(value : MathValue, count : Int128) : MathResult
    return MathValue.new(0_i128, value.kind) if count >= value.kind.bit_width.to_i128
    wrap(value.value << count.to_i32, value.kind)
  end

  def self.shift_right_by(value : MathValue, count : Int128) : MathResult
    if count >= value.kind.bit_width.to_i128
      return MathValue.new(value.value < 0_i128 ? -1_i128 : 0_i128, value.kind)
    end
    MathValue.new(value.value >> count.to_i32, value.kind)
  end

  # Wraps an Int128 bit pattern to the kind: the low bits, sign-extended for a
  # signed kind. A UInt128 with the top bit set is above the range the port
  # carries, so it is refused.
  def self.wrap(value : Int128, kind : NumberKind) : MathResult
    if kind == NumberKind::I128
      return MathValue.new(value, kind)
    end
    if kind == NumberKind::U128
      if value < 0_i128
        return MathError.new("value above the signed 128-bit range, which the port does not carry", true)
      end
      return MathValue.new(value, kind)
    end
    low = value & mask_of(kind)
    if kind.signed? && low > upper_magnitude(kind).to_i128
      low = low - (mask_of(kind) + 1_i128)
    end
    MathValue.new(low, kind)
  end

  # Exact arithmetic on sign and magnitude, so no step can overflow the iyi
  # integer it runs in.
  def self.exact_of(value : Int128) : MathExact
    MathExact.new(value < 0_i128, magnitude_of(value))
  end

  def self.negate(value : MathExact) : MathExact
    MathExact.new(!value.negative, value.magnitude, value.beyond)
  end

  def self.exact_add(a : MathExact, b : MathExact) : MathExact
    if a.negative == b.negative
      return MathExact.new(a.negative, umax, true) if b.magnitude > umax - a.magnitude
      return MathExact.new(a.negative, a.magnitude + b.magnitude)
    end
    if a.magnitude >= b.magnitude
      MathExact.new(a.negative, a.magnitude - b.magnitude)
    else
      MathExact.new(b.negative, b.magnitude - a.magnitude)
    end
  end

  def self.exact_mul(a : MathExact, b : MathExact) : MathExact
    return MathExact.new(false, 0_u128) if a.magnitude == 0_u128 || b.magnitude == 0_u128
    return MathExact.new(a.negative != b.negative, umax, true) if b.magnitude > umax // a.magnitude
    MathExact.new(a.negative != b.negative, a.magnitude * b.magnitude)
  end

  # The exact result must fit the kind: the magnitude against the kind's
  # limit on its side of zero.
  def self.classify(kind : NumberKind, exact : MathExact) : MathResult
    return MathError.new("Arithmetic overflow") if exact.beyond
    magnitude = exact.magnitude
    return MathValue.new(0_i128, kind) if magnitude == 0_u128
    if exact.negative
      return MathError.new("Arithmetic overflow") unless kind.signed? && magnitude <= lower_magnitude(kind)
      return MathValue.new(signed_of(true, magnitude), kind)
    end
    return MathError.new("Arithmetic overflow") if magnitude > upper_magnitude(kind)
    if magnitude >= two127
      return MathError.new("value above the signed 128-bit range, which the port does not carry", true)
    end
    MathValue.new(magnitude.to_i128, kind)
  end

  def self.literal_fits(kind : NumberKind, negative : Bool, magnitude : UInt128) : Bool
    if negative
      kind.signed? && magnitude <= lower_magnitude(kind)
    else
      magnitude <= upper_magnitude(kind)
    end
  end

  # The largest magnitude a kind holds on its positive side, and the largest
  # on its negative side (signed kinds only; zero otherwise).
  def self.upper_magnitude(kind : NumberKind) : UInt128
    case kind
    when NumberKind::I8   then 127_u128
    when NumberKind::I16  then 32767_u128
    when NumberKind::I32  then 2147483647_u128
    when NumberKind::I64  then 9223372036854775807_u128
    when NumberKind::I128 then 170141183460469231731687303715884105727_u128
    when NumberKind::U8   then 255_u128
    when NumberKind::U16  then 65535_u128
    when NumberKind::U32  then 4294967295_u128
    when NumberKind::U64  then 18446744073709551615_u128
    when NumberKind::U128 then umax
    else                       0_u128
    end
  end

  def self.lower_magnitude(kind : NumberKind) : UInt128
    case kind
    when NumberKind::I8   then 128_u128
    when NumberKind::I16  then 32768_u128
    when NumberKind::I32  then 2147483648_u128
    when NumberKind::I64  then 9223372036854775808_u128
    when NumberKind::I128 then two127
    else                       0_u128
    end
  end

  def self.min_of(kind : NumberKind) : Int128
    signed_of(true, lower_magnitude(kind))
  end

  def self.mask_of(kind : NumberKind) : Int128
    case kind
    when NumberKind::I8, NumberKind::U8   then 255_i128
    when NumberKind::I16, NumberKind::U16 then 65535_i128
    when NumberKind::I32, NumberKind::U32 then 4294967295_i128
    when NumberKind::I64, NumberKind::U64 then 18446744073709551615_i128
    else                                       0_i128
    end
  end

  def self.kind_name(kind : NumberKind) : String
    case kind
    when NumberKind::I8   then "Int8"
    when NumberKind::I16  then "Int16"
    when NumberKind::I32  then "Int32"
    when NumberKind::I64  then "Int64"
    when NumberKind::I128 then "Int128"
    when NumberKind::U8   then "UInt8"
    when NumberKind::U16  then "UInt16"
    when NumberKind::U32  then "UInt32"
    when NumberKind::U64  then "UInt64"
    when NumberKind::U128 then "UInt128"
    else                       kind.to_s
    end
  end

  def self.magnitude_of(value : Int128) : UInt128
    if value < 0_i128
      (0_i128 - (value + 1_i128)).to_u128 + 1_u128
    else
      value.to_u128
    end
  end

  # The Int128 bit pattern of a sign and magnitude. The magnitude 2^127 is the
  # least value whichever sign it has.
  def self.signed_of(negative : Bool, magnitude : UInt128) : Int128
    return -170141183460469231731687303715884105728_i128 if magnitude == two127
    positive = magnitude.to_i128
    negative ? 0_i128 - positive : positive
  end

  def self.two127 : UInt128
    170141183460469231731687303715884105728_u128
  end

  def self.umax : UInt128
    340282366920938463463374607431768211455_u128
  end
end
