module compiler/semantic/restrictions

import compiler/syntax/ast::{ASTNode, Arg, Def, Generic, Path, Self, Splat}
import compiler/semantic/top_level::{GenericClassType, ModuleType, Type, TypeParameterType}
import compiler/types/lookup::{LookupError, TypeLookup}
import compiler/types/type_system::{TypeSystem}
import compiler/types/types::{GenericInstanceType, TypeSplat}

# The answer to "what does this argument's restriction name": a type, nil when
# the argument has no restriction, or an error message when the written type does
# not resolve. The port of the restriction lookup in restrictions.cr.
pub class ArgRestriction
  getter type : Type?
  getter error : String?

  def initialize(@type : Type?, @error : String?)
  end

  def self.none : ArgRestriction
    ArgRestriction.new(nil, nil)
  end

  def self.failed(message : String) : ArgRestriction
    ArgRestriction.new(nil, message)
  end

  def self.found(type : Type) : ArgRestriction
    ArgRestriction.new(type, nil)
  end

  # The restriction of *arg* as written in *scope*, the type the def was found on,
  # as the hosted MatchContext resolves it. When the receiver *owner* is a generic
  # instance, its type arguments are bound first (see lookup_bound).
  def self.of(ts : TypeSystem, scope : ModuleType, arg : Arg, owner : Type? = nil) : ArgRestriction
    node = arg.restriction
    return ArgRestriction.none if node.nil?
    found = ArgRestriction.lookup_bound(ts, scope, node.as(ASTNode), owner)
    if found.is_a?(LookupError)
      return ArgRestriction.failed(found.as(LookupError).message)
    end
    ArgRestriction.found(found.as(Type))
  end

  # The type a written type names in *scope*. For a receiver *owner* that is a
  # generic instance, the instance's type arguments bind their parameter names
  # (`T` is Int32 in Array(Int32)), Self is the instance, and a generic written with
  # those names (`Array(T)`) is instantiated with the bound arguments, as the hosted
  # MatchContext of a generic instance resolves them. Anything else is the scope's
  # own lookup.
  def self.lookup_bound(ts : TypeSystem, scope : ModuleType, node : ASTNode, owner : Type?) : Type | LookupError
    if node.is_a?(Splat)
      inner = ArgRestriction.lookup_bound(ts, scope, node.as(Splat).exp, owner)
      return inner if inner.is_a?(LookupError)
      inner_type = inner.as(Type)
      if inner_type.is_a?(TypeParameterType)
        return TypeSplat.new(ts.program, inner_type.as(TypeParameterType))
      end
      return LookupError.new("can only splat tuple type, not #{inner_type.full_name}")
    end
    if owner.is_a?(GenericInstanceType)
      instance = owner.as(GenericInstanceType)
      return instance if node.is_a?(Self)
      if node.is_a?(Path)
        names = node.as(Path).names
        if names.size == 1
          bound = instance.type_vars[names[0]]?
          return bound.as(Type) if bound
        end
      end
      if node.is_a?(Generic)
        generic_node = node.as(Generic)
        base = TypeLookup.new(ts.instances).lookup(scope, generic_node.name)
        return base if base.is_a?(LookupError)
        base_type = base.as(Type)
        if base_type.is_a?(GenericClassType)
          args = [] of Type
          generic_node.type_vars.each do |arg_node|
            arg = ArgRestriction.lookup_bound(ts, scope, arg_node, owner)
            return arg if arg.is_a?(LookupError)
            args << arg.as(Type)
          end
          return TypeLookup.new(ts.instances).instantiate(base_type, args)
        end
      end
    end
    TypeLookup.new(ts.instances).lookup(scope, node)
  end

  # The restriction of *arg* in *scope* when the def has free variables (`forall T`):
  # the names in *bound* are the types the arguments gave them. With nothing bound it
  # is ArgRestriction.of.
  def self.of_bound(ts : TypeSystem, scope : ModuleType, arg : Arg, owner : Type?, bound : Hash(String, Type)) : ArgRestriction
    return ArgRestriction.of(ts, scope, arg, owner) if bound.size == 0
    node = arg.restriction
    return ArgRestriction.none if node.nil?
    found = ArgRestriction.lookup_free(ts, scope, node.as(ASTNode), owner, bound)
    if found.is_a?(LookupError)
      return ArgRestriction.failed(found.as(LookupError).message)
    end
    ArgRestriction.found(found.as(Type))
  end

  # The type a written type names when the def's free variables are bound: a name in
  # *bound* is its bound type, a generic written with names is instantiated with its
  # bound arguments (Pointer(T) with T bound is the pointer of that type), and anything
  # else is lookup_bound's answer.
  def self.lookup_free(ts : TypeSystem, scope : ModuleType, node : ASTNode, owner : Type?, bound : Hash(String, Type)) : Type | LookupError
    return ArgRestriction.lookup_bound(ts, scope, node, owner) if bound.size == 0
    if node.is_a?(Path)
      names = node.as(Path).names
      if names.size == 1
        found = bound[names[0]]?
        return found.as(Type) if found
      end
    end
    if node.is_a?(Generic)
      generic_node = node.as(Generic)
      base = TypeLookup.new(ts.instances).lookup(scope, generic_node.name)
      return base if base.is_a?(LookupError)
      base_type = base.as(Type)
      if base_type.is_a?(GenericClassType)
        args = [] of Type
        generic_node.type_vars.each do |arg_node|
          arg = ArgRestriction.lookup_free(ts, scope, arg_node, owner, bound)
          return arg if arg.is_a?(LookupError)
          args << arg.as(Type)
        end
        return TypeLookup.new(ts.instances).instantiate(base_type, args)
      end
    end
    ArgRestriction.lookup_bound(ts, scope, node, owner)
  end
end

# The types a def's free variables (`forall T`) are bound to by the arguments that name
# them: the hosted MatchContext's bound free variables, read from a restriction and an
# argument's type together. A name written alone takes the argument's type; a generic
# written with names (Pointer(T)) takes the argument's type arguments in turn.
pub class FreeBindings
  # Binds the free names *free* that *node* writes against *arg_type*. False when a name
  # is already bound to a different type, so the argument does not match.
  def self.bind(node : ASTNode, arg_type : Type, free : Array(String), bound : Hash(String, Type)) : Bool
    if node.is_a?(Path)
      names = node.as(Path).names
      if names.size == 1 && FreeBindings.free?(names[0], free)
        existing = bound[names[0]]?
        if existing
          return existing.as(Type).full_name == arg_type.full_name
        end
        bound[names[0]] = arg_type
      end
      return true
    end
    if node.is_a?(Generic) && arg_type.is_a?(GenericInstanceType)
      generic_node = node.as(Generic)
      inst = arg_type.as(GenericInstanceType)
      return true if inst.type_args.size != generic_node.type_vars.size
      i = 0
      while i < generic_node.type_vars.size
        return false if !FreeBindings.bind(generic_node.type_vars[i], inst.type_args[i], free, bound)
        i += 1
      end
    end
    true
  end

  # The free variables bound by *definition*'s parameter restrictions against
  # *arg_types*, or nil when two restrictions bind the same free variable to
  # different types. When *ts* is given and *definition* has a splat restriction
  # (`*values : *T`), the splat elements are packed as a tuple and bound too.
  def self.of_def(definition : Def, arg_types : Array(Type), ts : TypeSystem? = nil) : Hash(String, Type)?
    bound = Hash(String, Type).new
    free_names = definition.free_vars
    return bound if free_names.nil?
    free = free_names.as(Array(String))
    return bound if free.empty?
    splat = definition.splat_index
    prefix = splat ? splat.as(Int32) : definition.args.size
    i = 0
    while i < arg_types.size && i < prefix
      bind_node = definition.args[i].restriction
      if !bind_node.nil?
        return nil if !FreeBindings.bind(bind_node.as(ASTNode), arg_types[i], free, bound)
      end
      i += 1
    end
    if !ts.nil? && splat
      splat_idx = splat.as(Int32)
      splat_restriction = definition.args[splat_idx].restriction
      if splat_restriction && splat_restriction.is_a?(Splat)
        splat_types = [] of Type
        si = prefix
        while si < arg_types.size
          splat_types << arg_types[si]
          si += 1
        end
        splat_tuple = ts.as(TypeSystem).tuple_of(splat_types)
        return nil if !FreeBindings.bind(splat_restriction.as(Splat).exp, splat_tuple, free, bound)
      end
    end
    bound
  end

  def self.free?(name : String, free : Array(String)) : Bool
    i = 0
    while i < free.size
      return true if free[i] == name
      i += 1
    end
    false
  end
end
