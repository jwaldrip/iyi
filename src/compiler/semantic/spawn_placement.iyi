module compiler/semantic/spawn_placement

import compiler/syntax/ast::{ASTNode, Assign, Block, BoolLiteral, Break, Call, Cast, CharLiteral, ClassDef, ClassVar, Def, Expressions, FunDef, If, InstanceVar, LibDef, Macro, MacroExpression, MacroFor, MacroIf, MacroLiteral, MacroVar, MacroVerbatim, ModuleDef, MultiAssign, Next, NilableCast, NilLiteral, NodeMap, Nop, Not, NumberLiteral, OpAssign, Path, PointerOf, Primitive, ProcLiteral, Return, Self, StringLiteral, SymbolLiteral, Var, While, Yield}
import compiler/syntax/visitor::{Visitor}
import compiler/semantic/top_level::{Const, MetaclassType, MetaTypeVar, ModuleType, NilType, NonGenericClassType, NoReturnType, SemanticProgram, Type}
import compiler/semantic/main_visitor::{MainVisitor, node_class_name}
import compiler/semantic/closures::{ClosureBinding, ClosureFacts, ClosureFrame}
import compiler/semantic/share::{ShareFacts}
import compiler/types/types::{GenericClassInstanceType, VirtualMetaclassType}
import compiler/semantic/share_reach::{ShareReach, reach_called}

pub enum SpawnTarget
  AsWritten
  Pooled
  Unproven
  Refused
end

pub class SpawnVerdict
  getter target : SpawnTarget
  getter placement : String
  getter reason : String
  getter site : String

  def initialize(@target : SpawnTarget, @placement : String, @reason : String, @site : String)
  end
end

# The receiver, rather than a same-named method on another type, must be an
# IyiGroup. Virtual instance types are printed with a suffix by the typer.
def group_type?(type : Type?) : Bool
  return false unless type
  return false if type.is_a?(MetaclassType) || type.is_a?(VirtualMetaclassType)
  type.devirtualize.to_s == "IyiGroup"
end

def spawn_target?(visitor : MainVisitor, definition : Def, receiver : Type?) : Bool
  return false unless definition.name.split(':')[0] == "spawn"
  return true if group_type?(receiver)
  group_type?(visitor.program.def_owner(definition))
end

pub def spawn_call?(visitor : MainVisitor, call : Call) : Bool
  receiver = visitor.call_receiver?(call)
  if receiver.nil?
    if obj = call.obj
      receiver = visitor.type_of?(obj)
    end
  end
  if definition = visitor.target_def?(call)
    return true if spawn_target?(visitor, definition, receiver)
  end
  if targets = visitor.dispatch_targets?(call)
    targets.each do |target|
      return true if spawn_target?(visitor, target.definition, receiver || target.receiver)
    end
  end
  false
end

# Missing call bindings cannot establish either hosted's target or placement.
def unresolved_group_spawn?(visitor : MainVisitor, call : Call) : Bool
  return false unless call.name.split(':')[0] == "spawn"
  return false if visitor.target_def?(call)
  if targets = visitor.dispatch_targets?(call)
    return false unless targets.empty?
  end
  receiver = visitor.call_receiver?(call)
  if receiver.nil?
    if obj = call.obj
      receiver = visitor.type_of?(obj)
    end
  end
  group_type?(receiver)
end

def placement_text(call : Call) : String
  named = call.named_args
  return "spawn" if named.nil? || named.empty?
  placement = "spawn(unit: :same)"
  named.each do |arg|
    return "spawn(in: #{arg.value})" if arg.name == "in"
    if arg.name == "unit" && arg.value.is_a?(SymbolLiteral) && arg.value.as(SymbolLiteral).value == "new"
      placement = "spawn(unit: :new)"
    end
  end
  placement
end

def spawn_site(call : Call) : String
  if loc = call.name_location || call.location
    return loc.to_s
  end
  ""
end

def call_target(visitor : MainVisitor, call : Call) : Def?
  if target = visitor.target_def?(call)
    return target
  end
  if targets = visitor.dispatch_targets?(call)
    return targets.first.definition unless targets.empty?
  end
  nil
end

def literal_truthiness(node : ASTNode) : Int32
  if node.is_a?(BoolLiteral)
    return node.as(BoolLiteral).value ? 1 : -1
  elsif node.is_a?(NilLiteral) || node.is_a?(Nop)
    return -1
  elsif node.is_a?(Not)
    return 0 - literal_truthiness(node.as(Not).exp)
  end
  0
end

# Hosted cleanup and native lowering both discard the then arm when the
# condition's value is exactly Nil. Assignment conditions take their value's
# truthiness, not the assignment node's type.
def static_truthiness(visitor : MainVisitor, node : ASTNode) : Int32
  literal = literal_truthiness(node)
  return literal unless literal == 0
  if node.is_a?(Assign)
    return static_truthiness(visitor, node.as(Assign).value)
  end
  if type = visitor.type_of?(node)
    return -1 if type.is_a?(NilType)
  end
  0
end

# Find a target typed alongside a spawn, including calls in typed macro
# expansions. A name without a typed target is not evidence of that target.
class BesideFinder < Visitor
  getter found : Def? = nil

  def initialize(@visitor : MainVisitor, @name : String)
  end

  def visit_any(node : ASTNode) : Bool
    return false if @found
    if expanded = @visitor.expansions[node]?
      expanded.accept(self)
      return false
    end
    if node.is_a?(Call)
      if expanded = node.as(Call).expanded
        expanded.accept(self)
        return false
      end
    end
    true
  end

  def visit(node : Call) : Bool
    if node.name == @name
      @found = @visitor.target_def?(node)
    end
    @found.nil?
  end

  def visit(node : Def) : Bool
    false
  end

  def visit(node : Macro) : Bool
    false
  end

  def visit(node : MacroExpression) : Bool
    false
  end

  def visit(node : MacroFor) : Bool
    false
  end

  def visit(node : MacroIf) : Bool
    false
  end

  def visit(node : MacroLiteral) : Bool
    false
  end

  def visit(node : MacroVar) : Bool
    false
  end

  def visit(node : MacroVerbatim) : Bool
    false
  end

  def visit(node : ProcLiteral) : Bool
    node.def.body.accept(self)
    false
  end

  def visit(node : Block) : Bool
    node.body.accept(self)
    if literal = node.fun_literal
      if literal.is_a?(ProcLiteral)
        literal.as(ProcLiteral).def.body.accept(self)
      end
    end
    false
  end
end

def typed_beside(visitor : MainVisitor, definition : Def, name : String) : Def?
  finder = BesideFinder.new(visitor, name)
  definition.body.accept(finder)
  finder.found
end

pub class SpawnAnalysis
  getter verdicts : NodeMap(SpawnVerdict)
  getter ordered : Array(SpawnVerdict)
  getter pool_site : String?
  getter pool_proven : Bool

  def initialize
    @verdicts = NodeMap(SpawnVerdict).new
    @ordered = [] of SpawnVerdict
    @pool_site = nil
    @pool_proven = false
  end

  def reached? : Bool
    !@pool_site.nil?
  end

  def record(call : Call, verdict : SpawnVerdict) : Nil
    return if @verdicts.has_key?(call)
    @verdicts[call] = verdict
    @ordered << verdict
  end

  def unproven(site : String) : Nil
    @pool_site = site if @pool_site.nil?
  end

  def proven(site : String) : Nil
    unless @pool_proven
      @pool_site = site
      @pool_proven = true
    end
  end

  def self.analyse(visitor : MainVisitor, root : ASTNode) : SpawnAnalysis
    analysis = SpawnAnalysis.new
    share = ShareFacts.new
    reach = ShareReach.new(visitor)
    threads = false
    if group = visitor.program.types["IyiGroup"]?
      if group.is_a?(ModuleType)
        threads = group.as(ModuleType).defs.has_key?("spawn_pooled")
      end
    end

    root.accept(SpawnSiteCollector.new(visitor, analysis, share, reach, root, nil, nil, threads, true))
    seen = Set(UInt64).new
    visitor.typed_instances.each do |instance|
      definition = instance.definition
      next if seen.includes?(definition.node_id)
      seen.add(definition.node_id)
      definition.body.accept(SpawnSiteCollector.new(visitor, analysis, share, reach, root, definition, instance.self_type, threads, false))
    end
    # Constants used from imported units need not occur in the entry tree.
    constants = visitor.target_consts.values
    seen_constants = Set(UInt64).new
    constants.each do |constant|
      value = constant.value
      next if seen_constants.includes?(value.node_id)
      seen_constants.add(value.node_id)
      value.accept(SpawnSiteCollector.new(visitor, analysis, share, reach, value, nil, nil, threads, true))
    end
    analysis.sort_sites

    if visitor.program.types.has_key?("IyiChaos")
      analysis.proven("-Diyi_chaos: every loop checks for preemption (hosted codegen.cr 2999)")
    end
    reach = PoolReachWalk.new(visitor, analysis)
    root.accept(reach)
    constants.each do |constant|
      reach.visit_constant(constant.value)
    end
    analysis
  end

  def sort_sites : Nil
    @ordered = @ordered.sorted_by { |verdict| verdict.site }
  end
end

# Collect sites from typed bodies, not just the bodies reachable from the
# entry point. The reach walk below decides which verdicts affect lowering.
class SpawnSiteCollector < Visitor
  @facts : ClosureFacts? = nil

  def initialize(@visitor : MainVisitor, @analysis : SpawnAnalysis, @share : ShareFacts, @reach : ShareReach, @root : ASTNode, @in_def : Def?, @self_type : Type?, @threads : Bool, @root_scope : Bool)
  end

  def visit_any(node : ASTNode) : Bool
    if expanded = @visitor.expansions[node]?
      expanded.accept(self)
      return false
    end
    if node.is_a?(Call)
      if expanded = node.as(Call).expanded
        expanded.accept(self)
        return false
      end
    end
    true
  end

  def visit(node : Call) : Bool
    unless @analysis.verdicts.has_key?(node)
      if spawn_call?(@visitor, node)
        @analysis.record(node, classify(node))
      elsif unresolved_group_spawn?(@visitor, node)
        @analysis.record(node, SpawnVerdict.new(SpawnTarget::Unproven, placement_text(node), "the spawn target was not typed", spawn_site(node)))
      end
    end
    true
  end

  def visit(node : If) : Bool
    node.cond.accept(self)
    truth = static_truthiness(@visitor, node.cond)
    node.then.accept(self) unless truth == -1
    node.else.accept(self) unless truth == 1
    false
  end

  def visit(node : Def) : Bool
    false
  end

  def visit(node : Macro) : Bool
    false
  end

  def visit(node : MacroExpression) : Bool
    false
  end

  def visit(node : MacroFor) : Bool
    false
  end

  def visit(node : MacroIf) : Bool
    false
  end

  def visit(node : MacroLiteral) : Bool
    false
  end

  def visit(node : MacroVar) : Bool
    false
  end

  def visit(node : MacroVerbatim) : Bool
    false
  end

  def visit(node : LibDef) : Bool
    false
  end

  def visit(node : ClassDef) : Bool
    node.body.accept(self) if @root_scope
    false
  end

  def visit(node : ModuleDef) : Bool
    node.body.accept(self) if @root_scope
    false
  end

  def visit(node : FunDef) : Bool
    if body = node.body
      body.accept(self)
    end
    false
  end

  def visit(node : ProcLiteral) : Bool
    node.def.body.accept(self)
    false
  end

  def visit(node : Block) : Bool
    node.body.accept(self)
    if literal = node.fun_literal
      if literal.is_a?(ProcLiteral)
        literal.as(ProcLiteral).def.body.accept(self)
      end
    end
    false
  end

  def classify(call : Call) : SpawnVerdict
    site = spawn_site(call)
    named = call.named_args
    placement = placement_text(call)

    if targets = @visitor.dispatch_targets?(call)
      if targets.size > 1
        return SpawnVerdict.new(SpawnTarget::AsWritten, placement, "hosted classifies only a call with one target def", site)
      end
    end

    if named && !named.empty?
      if named.size > 1
        return SpawnVerdict.new(SpawnTarget::Refused, placement, "a spawn is placed one way: `in: u` runs it in the `Unit` u's unit, `unit: :same` in its spawner's and `unit: :new` in one of its own. Write one of them, or none and let the compiler place it (SPEC.md III.4.16)", site)
      end
      if named.first.name == "in"
        return classify_in_spawn(call, placement, site)
      end
      value = named.first.value
      unless value.is_a?(SymbolLiteral)
        return SpawnVerdict.new(SpawnTarget::Refused, placement, "`unit:` takes `:same` or `:new` as written: where a task runs is settled when the program compiles, and `#{value}` is known only when it runs. Write `unit: :same` or `unit: :new`, or leave it out and let the compiler place the task (SPEC.md III.4.16)", site)
      end
      symbol = value.as(SymbolLiteral).value
      if symbol == "same"
        return SpawnVerdict.new(SpawnTarget::AsWritten, placement, "`unit: :same` keeps it there (SPEC.md III.4.16)", site)
      elsif symbol == "new"
        unless @threads
          return SpawnVerdict.new(SpawnTarget::Refused, placement, "`unit: :new` needs threads, and a build under -Dgc_none or -Dgc_boehm has none: a thread would race the bump pointer, or be one Boehm never heard of (SPEC.md III.4.13)", site)
        end
        return classify_asked_spawn(call, placement, site)
      end
      return SpawnVerdict.new(SpawnTarget::Refused, placement, "`unit: #{value}` names no unit: `unit: :same` keeps the task in its spawner's unit, and `unit: :new` runs it in a unit of its own; or leave it out and let the compiler place the task (SPEC.md III.4.16)", site)
    end

    unless @threads
      return SpawnVerdict.new(SpawnTarget::AsWritten, placement, "a build under -Dgc_none or -Dgc_boehm has no threads (SPEC.md III.4.13)", site)
    end
    target = call_target(@visitor, call)
    if target.nil? || typed_beside(@visitor, target.as(Def), "spawn_pooled").nil?
      return SpawnVerdict.new(SpawnTarget::Unproven, placement, "the spawn_pooled target typed beside this spawn is unavailable", site)
    end
    if forwarded = call.block_arg
      return SpawnVerdict.new(SpawnTarget::AsWritten, placement, "the block is a proc, `&#{forwarded}`, and what a proc captured is not written in its type", site)
    end
    block = call.block
    if block.nil?
      return SpawnVerdict.new(SpawnTarget::AsWritten, placement, "the call has no block", site)
    end
    literal = block.as(Block).fun_literal
    unless literal.is_a?(ProcLiteral)
      return SpawnVerdict.new(SpawnTarget::AsWritten, placement, "the block was not typed", site)
    end
    plain_checks(call, literal.as(ProcLiteral), placement, site)
  end

  # The closure facts of the def the spawn is written in (or the program's top level), analysed once per collector.
  def closure_facts : ClosureFacts
    existing = @facts
    if existing
      return existing.as(ClosureFacts)
    end
    facts = ClosureFacts.new(@visitor)
    if definition = @in_def
      facts.analyse_def(definition, @self_type)
    else
      facts.analyse_program(@root)
    end
    @facts = facts
    facts
  end

  def block_frame(literal : ProcLiteral) : ClosureFrame?
    closure_facts.frame?(literal.def)
  end

  # The type that owns the def the spawn is written in: class variables of its block are looked up there.
  def spawner_owner : ModuleType?
    if definition = @in_def
      @visitor.program.def_owner(definition)
    else
      nil
    end
  end

  # A plain spawn's block, in hosted's order: its constants, class variables, captures, self, then the state it reaches.
  def plain_checks(call : Call, literal : ProcLiteral, placement : String, site : String) : SpawnVerdict
    frame = block_frame(literal)
    if frame.nil?
      return SpawnVerdict.new(SpawnTarget::Unproven, placement, "the spawn block has no closure frame", site)
    end
    closed = frame.as(ClosureFrame)
    walker = BlockFacts.new(@visitor, closure_facts, closed, @in_def)
    walker.walk(literal.def.body)
    if unsupported = walker.unsupported
      return SpawnVerdict.new(SpawnTarget::Unproven, placement, "no capture is proven non-Share; unsupported AST path #{unsupported}", site)
    end
    owner = spawner_owner
    check = BlockCheck.new(@visitor, @share, @reach, closure_facts, spawn_boundary)
    reason = check.run(walker, call, owner, @self_type, closed.closure)
    if pending = check.unknown
      return SpawnVerdict.new(SpawnTarget::Unproven, placement, pending, site)
    end
    if stays = reason
      return SpawnVerdict.new(SpawnTarget::AsWritten, placement, stays, site)
    end
    if block = call.block
      unless @reach.std_at?(block.location)
        reached = check.reach_reason(literal.def, owner)
        if pending = check.unknown
          return SpawnVerdict.new(SpawnTarget::Unproven, placement, pending, site)
        end
        if stays = reached
          return SpawnVerdict.new(SpawnTarget::AsWritten, placement, stays, site)
        end
      end
    end
    SpawnVerdict.new(SpawnTarget::Pooled, placement, "every capture is Share, and nothing the block reaches is module state that is not (SPEC.md III.4.15)", site)
  end

  # The checks a `spawn(unit: :new)` or `spawn(in: u)` block is held to: they refuse rather than keep the task in its
  # spawner's unit. Nil when they pass; else the verdict that says why the port does not place the task.
  def asked_checks(call : Call, literal : ProcLiteral, boundary : ShareBoundary, placement : String, site : String) : SpawnVerdict?
    frame = block_frame(literal)
    if frame.nil?
      return SpawnVerdict.new(SpawnTarget::Unproven, placement, "the spawn block has no closure frame", site)
    end
    closed = frame.as(ClosureFrame)
    walker = BlockFacts.new(@visitor, closure_facts, closed, @in_def)
    walker.walk(literal.def.body)
    if unsupported = walker.unsupported
      return SpawnVerdict.new(SpawnTarget::Unproven, placement, "no capture is proven non-Share; unsupported AST path #{unsupported}", site)
    end
    check = BlockCheck.new(@visitor, @share, @reach, closure_facts, boundary)
    reason = check.run(walker, call, spawner_owner, @self_type, closed.closure)
    if pending = check.unknown
      return SpawnVerdict.new(SpawnTarget::Unproven, placement, pending, site)
    end
    if refused = reason
      return SpawnVerdict.new(SpawnTarget::Refused, placement, refused, site)
    end
    nil
  end

  # `unit: :new` runs its block in a unit of its own, on another thread: a capture that is not Share is refused.
  def classify_asked_spawn(call : Call, placement : String, site : String) : SpawnVerdict
    boundary = parallel_boundary
    if forwarded = call.block_arg
      return SpawnVerdict.new(SpawnTarget::Refused, placement, "#{boundary.subject} is given a proc, `&#{forwarded}`, and what a proc captured is not written in its type: give it the block itself, written here, so what it captures is checked (SPEC.md III.4.4)", site)
    end
    block = call.block
    if block.nil?
      return SpawnVerdict.new(SpawnTarget::Pooled, placement, "`unit: :new` asks for a unit of its own", site)
    end
    literal = block.as(Block).fun_literal
    unless literal.is_a?(ProcLiteral)
      return SpawnVerdict.new(SpawnTarget::Pooled, placement, "`unit: :new` asks for a unit of its own", site)
    end
    if verdict = asked_checks(call, literal.as(ProcLiteral), boundary, placement, site)
      return verdict
    end
    SpawnVerdict.new(SpawnTarget::Pooled, placement, "`unit: :new` asks for a unit of its own, and every capture is Share (SPEC.md III.4.16)", site)
  end

  # `in: u` runs its task in the Unit u's unit: its captures are checked as a unit boundary, and the port does not
  # place a unit's task yet, so a task that passes is unproven, never kept as written.
  def classify_in_spawn(call : Call, placement : String, site : String) : SpawnVerdict
    boundary = unit_boundary(call)
    if forwarded = call.block_arg
      return SpawnVerdict.new(SpawnTarget::Refused, placement, "#{boundary.subject} is given a proc, `&#{forwarded}`, and what a proc captured is not written in its type: give it the block itself, written here, so what it captures is checked (SPEC.md III.4.4)", site)
    end
    block = call.block
    if block.nil?
      return SpawnVerdict.new(SpawnTarget::Unproven, placement, "the `in:` spawn has no block the port can read", site)
    end
    literal = block.as(Block).fun_literal
    unless literal.is_a?(ProcLiteral)
      return SpawnVerdict.new(SpawnTarget::Unproven, placement, "the `in:` spawn block has no typed proc literal", site)
    end
    if verdict = asked_checks(call, literal.as(ProcLiteral), boundary, placement, site)
      return verdict
    end
    SpawnVerdict.new(SpawnTarget::Unproven, placement, "`in:` runs the task in the Unit's unit, which this compiler does not place yet (SPEC.md III.4.18)", site)
  end
end

# The words a block's refusals use, as hosted's ShareBoundary spells them: what the block is called, what the two
# parties to a shared cell are, how long they share it, and the advice a refusal opens with.
pub class ShareBoundary
  getter subject : String
  getter local_owner : String
  getter pair : String
  getter again : String
  getter after : String
  getter race : String
  getter lead : String

  def initialize(@subject : String, @local_owner : String, @pair : String, @again : String, @after : String, @race : String, @lead : String)
  end

  def keep_advice : String
    if @lead.empty?
      "Keep"
    else
      "#{@lead}keep"
    end
  end

  def capture_advice : String
    if @lead.empty?
      "Capture"
    else
      "#{@lead}capture"
    end
  end
end

# hosted SPAWN_BOUNDARY: a plain spawn's block, which stays in its spawner's unit when a check refuses it.
def spawn_boundary : ShareBoundary
  ShareBoundary.new("the block", "a local of the code that spawned the task, so the task and its spawner", "the task and the code that spawned it", "spawns the task again", "the task was spawned", "safe within one unit and a data race across two", "To run it in a unit of its own, ")
end

# hosted PARALLEL_BOUNDARY: a `spawn(unit: :new)` block, which runs on a thread of its own.
def parallel_boundary : ShareBoundary
  ShareBoundary.new("the block spawn(unit: :new) runs in a unit of its own, on another thread", "a local of the code that spawned the task, so the task and its spawner", "the task and the code that spawned it", "spawns the task again", "the task was spawned", "a data race", "")
end

# The placement a `spawn(in: u)` call spells, as hosted writes it in its refusals.
def spelled_unit_spawn(call : Call) : String
  into = "u"
  if named = call.named_args
    named.each do |arg|
      into = arg.value.to_s if arg.name == "in"
    end
  end
  "spawn(in: #{into})"
end

# hosted unit_boundary: a `spawn(in: u)` block, which runs in another unit.
def unit_boundary(call : Call) : ShareBoundary
  ShareBoundary.new("the block #{spelled_unit_spawn(call)} runs in another unit", "a local of the code that spawned the task, so the task and its spawner", "the task and the code that spawned it", "spawns the task again", "the task was spawned", "a data race", "")
end

# A constant a block names in its own text, once (hosted NamedConstants).
pub class ConstantUse
  getter const_state : Const
  getter label : String
  getter type : Type

  def initialize(@const_state : Const, @label : String, @type : Type)
  end
end

# A class variable a block names in its own text, once, and whether the block assigns it (hosted NamedClassVars).
pub class ClassVarUse
  getter name : String
  property assigned : Bool

  def initialize(@name : String, @assigned : Bool)
  end
end

# A local a block captures, once: its type, the frame that declares it, whether the typer marked it mutably
# closured (hosted mutably_closured), and whether the block itself assigns it.
pub class CapturedLocal
  getter name : String
  getter type : Type
  getter owner : ClosureFrame
  getter mutably : Bool
  property assigned : Bool

  def initialize(@name : String, @type : Type, @owner : ClosureFrame, @mutably : Bool, @assigned : Bool)
  end
end

# The frame that declares *name*, from *frame* outwards.
def owner_frame_of(frame : ClosureFrame, name : String) : ClosureFrame?
  return frame if frame.local?(name)
  if parent = frame.parent
    return owner_frame_of(parent, name)
  end
  nil
end

# The body of the scope a frame is: a def's or a block's body, or the program's own tree.
def frame_body(frame : ClosureFrame) : ASTNode
  node = frame.node
  if node.is_a?(Def)
    node.as(Def).body
  elsif node.is_a?(Block)
    node.as(Block).body
  else
    node
  end
end

# The class variable *name* that an owner declares or inherits, nil when the owner does not have it.
def class_var_of(owner : ModuleType?, name : String) : MetaTypeVar?
  if known = owner
    return known.lookup_class_var?(name)
  end
  nil
end

# A node list copied, so a walk's region stack is never shared with the list it was saved in.
def copy_nodes(nodes : Array(ASTNode)) : Array(ASTNode)
  copied = [] of ASTNode
  nodes.each { |node| copied << node }
  copied
end

# Whether a region is a proc or a block that became one: code that may run after the task was spawned.
def proc_region?(region : ASTNode) : Bool
  return true if region.is_a?(ProcLiteral)
  region.is_a?(Block) && !region.as(Block).fun_literal.nil?
end

# The facts a spawn's block gives, read by walking the block's typed code the way hosted's cleanup reads it: the
# constants and class variables it names, the locals it captures, and whether it captures self. A literal dead
# branch is skipped. An expansion under a branch the port cannot fold makes the walk unsupported, since hosted
# may keep the original code there. Nothing here is a verdict.
class BlockFacts
  getter constants : Array(ConstantUse)
  getter class_vars : Array(ClassVarUse)
  getter captures : Array(CapturedLocal)
  getter self_captured : Bool
  getter unsupported : String?

  def initialize(@visitor : MainVisitor, @facts : ClosureFacts, @proc_frame : ClosureFrame, @in_def : Def?)
    @frames = [@proc_frame] of ClosureFrame
    @constants = [] of ConstantUse
    @constant_keys = Set(UInt64).new
    @class_vars = [] of ClassVarUse
    @captures = [] of CapturedLocal
    @self_captured = false
    @unsupported = nil
    @allow_expansions = true
  end

  def unavailable(description : String) : Nil
    @unsupported = description if @unsupported.nil?
  end

  def trusted_argument?(name : String) : Bool
    definition = @in_def
    return false unless definition && definition.share_annotated
    if block_arg = definition.block_arg
      return true if block_arg.name == name
    end
    definition.args.any? { |arg| arg.name == name }
  end

  def no_return?(node : ASTNode) : Bool
    type = @visitor.type_of?(node)
    !type.nil? && type.as(Type).is_a?(NoReturnType)
  end

  def walk_block(block : Block) : Nil
    literal = block.fun_literal
    if literal.is_a?(ProcLiteral)
      proc_def = literal.as(ProcLiteral).def
      if frame = @facts.frame?(proc_def)
        @frames << frame
        walk(proc_def.body)
        @frames.pop
      else
        unavailable("missing proc frame")
      end
    elsif frame = @facts.frame?(block)
      @frames << frame
      walk(block.body)
      @frames.pop
    else
      unavailable("missing block frame")
    end
  end

  def walk_call(node : Call) : Nil
    unless @visitor.type_of?(node)
      unavailable("untyped Call")
      return
    end
    # Hosted replaces a call with an untyped operand before it can retain any reference inside the call.
    if obj = node.obj
      unless @visitor.type_of?(obj)
        unavailable("untyped call receiver")
        return
      end
    end
    node.args.each do |arg|
      unless @visitor.type_of?(arg)
        unavailable("untyped call argument")
        return
      end
    end
    if named = node.named_args
      named.each do |arg|
        unless @visitor.type_of?(arg.value)
          unavailable("untyped named argument")
          return
        end
      end
    end
    if arguments = @visitor.call_arguments[node]?
      arguments.each do |arg|
        unless @visitor.type_of?(arg)
          unavailable("untyped expanded argument")
          return
        end
      end
    end
    if obj = node.obj
      walk(obj)
      return if no_return?(obj)
    end
    if arguments = @visitor.call_arguments[node]?
      arguments.each do |arg|
        walk(arg)
        return if no_return?(arg)
      end
    else
      node.args.each do |arg|
        walk(arg)
        return if no_return?(arg)
      end
      if named = node.named_args
        named.each do |arg|
          walk(arg.value)
          return if no_return?(arg.value)
        end
      end
    end
    # A receiverless call to a method that takes self captures self, as hosted's ReceiverlessSelfCalls reads it.
    capture_self if node.obj.nil? && implicit_self_call?(node)
    targets = @visitor.dispatch_targets?(node)
    return unless @visitor.target_def?(node) || (targets && !targets.empty?) || @visitor.lib_call_target?(node)
    if block = node.block
      walk_block(block)
    end
  end

  def implicit_self_target?(definition : Def) : Bool
    owner = @visitor.program.def_owner(definition)
    return false if owner.nil? || owner.is_a?(SemanticProgram)
    return false if owner.is_a?(ModuleType) && owner.as(ModuleType).iyi_unit
    true
  end

  def implicit_self_call?(call : Call) : Bool
    if target = @visitor.target_def?(call)
      return implicit_self_target?(target)
    end
    if targets = @visitor.dispatch_targets?(call)
      targets.each do |item|
        return true if implicit_self_target?(item.definition)
      end
    end
    false
  end

  def walk(node : ASTNode) : Nil
    if expanded = @visitor.expansions[node]?
      if @allow_expansions
        walk(expanded)
      else
        unavailable("conditionally retained expansion")
      end
      return
    end
    if node.is_a?(Def) || node.is_a?(Macro) || node.is_a?(LibDef) || node.is_a?(ClassDef) || node.is_a?(ModuleDef)
      return
    end
    if node.is_a?(Call)
      call = node.as(Call)
      if expanded = call.expanded
        if @allow_expansions
          walk(expanded)
        else
          unavailable("conditionally retained call expansion")
        end
        return
      end
      walk_call(call)
    elsif node.is_a?(Block)
      walk_block(node.as(Block))
    elsif node.is_a?(Expressions)
      node.as(Expressions).expressions.each do |child|
        unless @visitor.type_of?(child)
          unavailable("untyped #{node_class_name(child)}")
          break
        end
        walk(child)
        break if child.is_a?(Return) || child.is_a?(Break) || child.is_a?(Next) || no_return?(child)
      end
    elsif node.is_a?(If)
      branch = node.as(If)
      unless @visitor.type_of?(branch.cond)
        unavailable("untyped If condition")
        return
      end
      walk(branch.cond)
      return if no_return?(branch.cond)
      truth = literal_truthiness(branch.cond)
      if truth == 1
        walk(branch.then)
        unavailable("literal-dead If branch") unless branch.else.is_a?(Nop)
      elsif truth == -1
        walk(branch.else)
        unavailable("literal-dead If branch") unless branch.then.is_a?(Nop)
      else
        # Hosted may fold a typed nonliteral condition and leave its dead branch untransformed. An expansion
        # there is not a kept reference.
        previous = @allow_expansions
        @allow_expansions = false
        walk(branch.then)
        walk(branch.else)
        @allow_expansions = previous
      end
    elsif node.is_a?(While)
      loop_node = node.as(While)
      unless @visitor.type_of?(loop_node.cond)
        unavailable("untyped While condition")
        return
      end
      walk(loop_node.cond)
      walk(loop_node.body) unless no_return?(loop_node.cond)
    elsif node.is_a?(Assign)
      assign = node.as(Assign)
      unless @visitor.type_of?(assign.value)
        unavailable("untyped assignment value")
        return
      end
      if no_return?(assign.value)
        walk(assign.value)
      else
        assign_target(assign.target)
        walk(assign.value)
      end
    elsif node.is_a?(OpAssign)
      op = node.as(OpAssign)
      assign_target(op.target)
      walk(op.value)
    elsif node.is_a?(Return)
      if exp = node.as(Return).exp
        walk(exp)
      end
    elsif node.is_a?(Break)
      if exp = node.as(Break).exp
        walk(exp)
      end
    elsif node.is_a?(Next)
      if exp = node.as(Next).exp
        walk(exp)
      end
    elsif node.is_a?(Yield)
      node.as(Yield).exps.each do |exp|
        unless @visitor.type_of?(exp)
          unavailable("untyped Yield expression")
          break
        end
        walk(exp)
        break if no_return?(exp)
      end
    elsif node.is_a?(ProcLiteral)
      proc_def = node.as(ProcLiteral).def
      if frame = @facts.frame?(proc_def)
        @frames << frame
        walk(proc_def.body)
        @frames.pop
      else
        unavailable("missing proc frame")
      end
    elsif node.is_a?(Cast)
      walk(node.as(Cast).obj)
    elsif node.is_a?(NilableCast)
      walk(node.as(NilableCast).obj)
    elsif node.is_a?(Not)
      walk(node.as(Not).exp)
    elsif node.is_a?(Path)
      path = node.as(Path)
      if const = @visitor.target_const?(path)
        if type = @visitor.type_of?(path)
          note_constant(const, path.to_s, type)
        end
      end
    elsif node.is_a?(Var)
      variable(node.as(Var), false)
    elsif node.is_a?(ClassVar)
      class_var_use(node.as(ClassVar).name, false)
    elsif node.is_a?(InstanceVar) || node.is_a?(Self)
      capture_self
    elsif node.is_a?(BoolLiteral) || node.is_a?(NilLiteral) || node.is_a?(Nop) || node.is_a?(NumberLiteral) || node.is_a?(StringLiteral) || node.is_a?(CharLiteral) || node.is_a?(SymbolLiteral) || node.is_a?(Primitive)
      # These leaves hold no reference.
    else
      # Any other node: its children are read with the same walk, so nothing it holds is missed.
      node.accept(BridgeWalk.new(self, node))
    end
  end

  # An assignment to a local, a class variable or self: the local is captured and assigned by the block.
  def assign_target(target : ASTNode) : Nil
    if target.is_a?(Var)
      variable(target.as(Var), true)
    elsif target.is_a?(ClassVar)
      class_var_use(target.as(ClassVar).name, true)
    elsif target.is_a?(InstanceVar)
      capture_self
    else
      unavailable("untyped assignment target #{node_class_name(target)}")
    end
  end

  def variable(node : Var, assigned : Bool) : Nil
    if node.name == "self"
      capture_self
      return
    end
    return unless @proc_frame.closure
    return if trusted_argument?(node.name)
    @frames.each do |frame|
      return if frame.local?(node.name)
    end
    if parent = @proc_frame.parent
      if owner = owner_frame_of(parent, node.name)
        if binding = owner.local?(node.name)
          return unless binding.captured
          note_capture(node.name, binding, owner, assigned)
        end
      end
    end
  end

  def note_capture(name : String, binding : ClosureBinding, owner : ClosureFrame, assigned : Bool) : Nil
    @captures.each do |known|
      if known.name == name
        known.assigned = true if assigned
        return
      end
    end
    @captures << CapturedLocal.new(name, binding.variable.type, owner, binding.variable.mutably, assigned)
  end

  def capture_self : Nil
    return unless @proc_frame.closure
    @self_captured = true
  end

  def note_constant(const : Const, label : String, type : Type) : Nil
    key = const.object_id
    return if @constant_keys.includes?(key)
    @constant_keys.add(key)
    @constants << ConstantUse.new(const, label, type)
  end

  def class_var_use(name : String, assigned : Bool) : Nil
    @class_vars.each do |known|
      if known.name == name
        known.assigned = true if assigned
        return
      end
    end
    @class_vars << ClassVarUse.new(name, assigned)
  end
end

# Reads a node the walk does not name by walking its children with the same walk; the node itself is entered once.
class BridgeWalk < Visitor
  def initialize(@walker : BlockFacts, @root : ASTNode)
  end

  def visit_any(node : ASTNode) : Bool
    return true if node.node_id == @root.node_id
    @walker.walk(node)
    false
  end
end

# Whether a body writes an instance variable: an assignment, an operator assignment, a multiple assignment or a
# pointer taken of one.
class IvarWriteFinder < Visitor
  getter found : Bool

  def initialize
    @found = false
  end

  def visit(node : Assign) : Bool
    @found = true if node.target.is_a?(InstanceVar)
    !@found
  end

  def visit(node : OpAssign) : Bool
    @found = true if node.target.is_a?(InstanceVar)
    !@found
  end

  def visit(node : MultiAssign) : Bool
    node.targets.each do |target|
      @found = true if target.is_a?(InstanceVar)
    end
    !@found
  end

  def visit(node : PointerOf) : Bool
    @found = true if node.exp.is_a?(InstanceVar)
    !@found
  end

  def visit(node : Def) : Bool
    false
  end

  def visit(node : Macro) : Bool
    false
  end
end

# Whether a def body writes an instance variable inside code the share scan does not read: a macro's conditional or
# expanded code, which share.iyi's MutationScanner skips (it reads original bodies only). No Share verdict may rest
# on a type whose defs hold such a write.
class ShareScanGap < Visitor
  getter found : Bool

  def initialize(@visitor : MainVisitor)
    @found = false
  end

  def visit_any(node : ASTNode) : Bool
    return false if @found
    if node.is_a?(MacroIf) || node.is_a?(MacroFor) || node.is_a?(MacroVerbatim)
      # A control macro's code is not what the scan reads: its text holds no assignment, and its expansion is not kept
      # under the original def. Such a def may write a field the scan cannot see.
      @found = true
      return false
    end
    if node.is_a?(MacroExpression)
      if expanded = @visitor.expansions[node]?
        @found = true if writes_instance_var?(expanded)
      end
      return false
    end
    if expanded = @visitor.expansions[node]?
      @found = true if writes_instance_var?(expanded)
      return false
    end
    if node.is_a?(Call)
      if expanded = node.as(Call).expanded
        @found = true if writes_instance_var?(expanded)
        return false
      end
    end
    true
  end

  def writes_instance_var?(node : ASTNode) : Bool
    finder = IvarWriteFinder.new
    node.accept(finder)
    finder.found
  end
end

# Where an assignment to a captured local sits, read in the scope that declares it: the loops and blocks around it,
# and whether it comes after the call that starts the task (hosted CaptureAssignments).
pub class CaptureSite
  getter node : ASTNode
  getter regions : Array(ASTNode)
  getter after : Bool

  def initialize(@node : ASTNode, @regions : Array(ASTNode), @after : Bool)
  end
end

class CaptureAssignments < Visitor
  getter sites : Array(CaptureSite)
  getter start_regions : Array(ASTNode)
  getter found_start : Bool

  def initialize(@facts : ClosureFacts, @visitor : MainVisitor, @name : String, @start : Call)
    @sites = [] of CaptureSite
    @start_regions = [] of ASTNode
    @found_start = false
    @regions = [] of ASTNode
    @frames = [] of ClosureFrame?
  end

  def visit_any(node : ASTNode) : Bool
    if expanded = @visitor.expansions[node]?
      expanded.accept(self)
      return false
    end
    true
  end

  def visit(node : Call) : Bool
    if node.node_id == @start.node_id
      @found_start = true
      @start_regions = copy_nodes(@regions)
      return false
    end
    if expanded = node.expanded
      expanded.accept(self)
      return false
    end
    true
  end

  def visit(node : While) : Bool
    @regions << node
    true
  end

  def end_visit(node : While) : Nil
    @regions.pop
  end

  # A block that became a proc is read through its proc's body, as the walk reads it; end_visit pops either way.
  def visit(node : Block) : Bool
    @regions << node
    literal = node.fun_literal
    if literal.is_a?(ProcLiteral)
      proc_def = literal.as(ProcLiteral).def
      @frames << @facts.frame?(proc_def)
      proc_def.body.accept(self)
      return false
    end
    @frames << @facts.frame?(node)
    true
  end

  def end_visit(node : Block) : Nil
    @frames.pop
    @regions.pop
  end

  def visit(node : ProcLiteral) : Bool
    @regions << node
    frame = @facts.frame?(node.def)
    @frames << frame
    node.def.body.accept(self)
    @frames.pop
    @regions.pop
    false
  end

  def visit(node : Def) : Bool
    false
  end

  def visit(node : Macro) : Bool
    false
  end

  def visit(node : LibDef) : Bool
    false
  end

  def end_visit(node : Assign) : Nil
    note_target(node, node.target)
  end

  def end_visit(node : OpAssign) : Nil
    note_target(node, node.target)
  end

  def end_visit(node : MultiAssign) : Nil
    node.targets.each do |target|
      note_target(node, target)
    end
  end

  # A local of the name, unless a block or proc inside the scope declares a local of that name of its own.
  def note_target(node : ASTNode, target : ASTNode) : Nil
    return unless target.is_a?(Var)
    return unless target.as(Var).name == @name
    @frames.each do |entry|
      if frame = entry
        return if frame.local?(@name)
      end
    end
    @sites << CaptureSite.new(node, copy_nodes(@regions), @found_start)
  end
end

# The reason a captured local's assignments refuse a task that is spawned, in the scope that declares it, or nil
# when none does. A call that starts the task before the assignments, or none, is the assigned-once rule's answer.
def assigned_why(site : CaptureSite, start_regions : Array(ASTNode), again : String, after : String) : String?
  site.regions.each do |region|
    start_regions.each do |start_region|
      return "in a loop or a block that #{again}" if region.node_id == start_region.node_id
    end
  end
  site.regions.each do |region|
    return "in a block or a proc that may run after #{after}" if proc_region?(region)
  end
  return "after #{after}" if site.after
  nil
end

# The share checks a spawn's block is held to, in hosted's order (classify_spawn and check_block_captures): the
# constants it names, the class variables, its captured locals with the assigned-once rule, self, and, for a plain
# spawn, the state the block reaches through its calls. Each check gives hosted's words for the first thing that
# refuses. A fact the port cannot read (a class variable's writes, a macro that may write a type's field) sets
# `unknown` instead, which keeps the verdict unproven rather than letting a race through.
class BlockCheck
  getter unknown : String?

  def initialize(@visitor : MainVisitor, @share : ShareFacts, @reach : ShareReach, @facts : ClosureFacts, @boundary : ShareBoundary)
    @unknown = nil
  end

  # The words why a type is not Share, or nil when it is. A type whose witness is nil but whose defs hold a write the
  # scan cannot see is unknown.
  def reason_for(type : Type) : String?
    if why = @share.witness(type)
      return why
    end
    if scan_gap?(type)
      @unknown = "a macro in a def of #{type} may write its fields, which the share scan does not read"
    end
    nil
  end

  # Whether an owner class, or one of its ancestors, has a def with a write the share scan cannot see.
  def scan_gap?(type : Type) : Bool
    return false unless type.is_a?(NonGenericClassType) || type.is_a?(GenericClassInstanceType)
    if type.is_a?(GenericClassInstanceType)
      return false if type.as(GenericClassInstanceType).generic_type.share_trusted
    else
      return false if type.share_trusted
    end
    return false if type.object_id == type.program.string_type.object_id
    owners = [] of Type
    @share.collect_owners(type, owners, Set(UInt64).new)
    owners.each do |owner|
      if module_owner = @share.definition_owner(owner)
        module_owner.defs.each do |name, list|
          list.each do |definition|
            next if @reach.std_at?(definition.location)
            gap = ShareScanGap.new(@visitor)
            definition.body.accept(gap)
            return true if gap.found
          end
        end
      end
    end
    false
  end

  # The first certain refusal among the constants, class variables, captured locals and self of a block, in hosted's
  # order, or nil. `closure` is whether the block is a closure: hosted checks captures and self only then.
  def run(facts : BlockFacts, call : Call, owner : ModuleType?, self_type : Type?, closure : Bool) : String?
    subject = @boundary.subject
    facts.constants.each do |use|
      if why = reason_for(use.type)
        return "#{subject} names the constant `#{use.label} : #{use.type}`, which is not Share: #{why} (SPEC.md III.4.5)"
      end
      return nil unless @unknown.nil?
    end
    facts.class_vars.each do |use|
      cvar = class_var_of(owner, use.name)
      if cvar.nil?
        @unknown = "class variable #{use.name} is not resolved from its block's owner"
        return nil
      end
      next if cvar.thread_local
      if use.assigned
        return "#{subject} assigns `#{use.name}`, a class variable, so every thread that reaches it shares one mutable cell: #{@boundary.race} (SPEC.md III.4.5). #{@boundary.keep_advice} the value in an `Atomic`, or behind a `Mutex` (std/mutex)"
      end
      @unknown = "the writes of class variable #{use.name} are not read by the port"
      return nil
    end
    if closure
      facts.captures.each do |captured|
        if why = reason_for(captured.type)
          return "#{subject} captures `#{captured.name} : #{captured.type}`, which is not Share: #{why} (SPEC.md III.4.4)"
        end
        return nil unless @unknown.nil?
        next unless captured.mutably
        if captured.assigned
          return "#{subject} assigns `#{captured.name}`, #{@boundary.local_owner} share one mutable cell: #{@boundary.race} (SPEC.md III.4.4). #{@boundary.keep_advice} the value in an `Atomic`, or behind a `Mutex` (std/mutex)"
        end
        if why = assigned_again(captured, call, subject)
          return why
        end
      end
      if facts.self_captured
        if captured_self = self_type
          unless captured_self.is_a?(MetaclassType) || captured_self.is_a?(VirtualMetaclassType)
            if why = @share.witness_for_self(captured_self)
              return "#{subject} captures `self : #{captured_self}`, which is not Share: #{why} (SPEC.md III.4.4)"
            end
          end
        end
      end
    end
    nil
  end

  # hosted check_thread_capture_assigned_once's outside walk: the captured local's assignments in the scope that
  # declares it, read against the call that starts the task.
  def assigned_again(captured : CapturedLocal, start : Call, subject : String) : String?
    walker = CaptureAssignments.new(@facts, @visitor, captured.name, start)
    frame_body(captured.owner).accept(walker)
    advice = "so #{@boundary.pair} share one mutable cell: #{@boundary.race} (SPEC.md III.4.4). #{@boundary.capture_advice} a local that is assigned once (a block's own locals are new on every call), or keep the value in an `Atomic`, or behind a `Mutex` (std/mutex)"
    line = 0
    if location = start.location
      line = location.line_number
    end
    unless walker.found_start && !walker.sites.empty?
      return "#{subject} captures `#{captured.name}`, which is assigned again after the capture, or inside a loop or a block, #{advice}"
    end
    walker.sites.each do |site|
      if why = assigned_why(site, walker.start_regions, @boundary.again, @boundary.after)
        return "`#{captured.name}` is assigned here, #{why}, and #{subject} (line #{line}) captures it, #{advice}"
      end
    end
    nil
  end

  # The first state the block reaches through the defs it calls that is not Share, in hosted's words, or nil.
  # Class variables and constants are judged by their types, as hosted judges them when it walks the reach.
  def reach_reason(a_def : Def, owner : ModuleType?) : String?
    @reach.reach(a_def, owner).each do |item|
      named = item.named
      steps = [] of String
      item.path.each do |step|
        steps << "`#{reach_called(@visitor, step)}`"
      end
      steps << "`#{named.use}`"
      if why = reason_for(named.type)
        where = named.constant? ? "the constant" : "the class variable"
        return "the block reaches #{where} `#{named.label} : #{named.type}` through #{steps.join(" → ")}, and it is not Share: #{why}; if every thread may reach it safely - every write is before the first parallel task starts, or behind one `Mutex#lock` on a constant or a class variable - say why on it with `@[SafeReach(\"...\")]`, which the compiler proves (SPEC.md III.4.4)"
      end
      return nil unless @unknown.nil?
    end
    nil
  end
end

# This conservative graph walk prunes only statically false or true branches.
# Defs and typed-used constants are visited once, and a proven pool call wins
# over any earlier unproven placement.
class PoolReachWalk < Visitor
  @seen_defs : Set(UInt64)
  @seen_constants : Set(UInt64)
  @cause : Call? = nil

  def initialize(@visitor : MainVisitor, @analysis : SpawnAnalysis)
    @seen_defs = Set(UInt64).new
    @seen_constants = Set(UInt64).new
  end

  def visit_constant(value : ASTNode) : Nil
    return if @seen_constants.includes?(value.node_id)
    @seen_constants.add(value.node_id)
    value.accept(self)
  end

  def visit_any(node : ASTNode) : Bool
    if expanded = @visitor.expansions[node]?
      expanded.accept(self)
      return false
    end
    if node.is_a?(Call)
      if expanded = node.as(Call).expanded
        expanded.accept(self)
        return false
      end
    end
    true
  end

  def visit(node : Def) : Bool
    false
  end

  def visit(node : Macro) : Bool
    false
  end

  def visit(node : MacroExpression) : Bool
    false
  end

  def visit(node : MacroFor) : Bool
    false
  end

  def visit(node : MacroIf) : Bool
    false
  end

  def visit(node : MacroLiteral) : Bool
    false
  end

  def visit(node : MacroVar) : Bool
    false
  end

  def visit(node : MacroVerbatim) : Bool
    false
  end

  def visit(node : LibDef) : Bool
    false
  end

  def visit(node : ClassDef) : Bool
    node.body.accept(self)
    false
  end

  def visit(node : ModuleDef) : Bool
    node.body.accept(self)
    false
  end

  def visit(node : FunDef) : Bool
    if body = node.body
      body.accept(self)
    end
    false
  end

  def visit(node : ProcLiteral) : Bool
    node.def.body.accept(self)
    false
  end

  def visit(node : Block) : Bool
    if literal = node.fun_literal
      if literal.is_a?(ProcLiteral)
        literal.as(ProcLiteral).def.body.accept(self)
        return false
      end
    end
    node.body.accept(self)
    false
  end

  def visit(node : If) : Bool
    node.cond.accept(self)
    truth = static_truthiness(@visitor, node.cond)
    node.then.accept(self) unless truth == -1
    node.else.accept(self) unless truth == 1
    false
  end

  def visit(node : Path) : Bool
    if constant = @visitor.target_const?(node)
      visit_constant(constant.value)
    end
    false
  end

  def worker_metaclass?(type : Type?) : Bool
    return false unless type
    if type.is_a?(MetaclassType)
      return type.as(MetaclassType).instance_type.to_s == "IyiWorkers"
    elsif type.is_a?(VirtualMetaclassType)
      return type.as(VirtualMetaclassType).instance_type.base_type.to_s == "IyiWorkers"
    end
    false
  end

  def follow(definition : Def, receiver : Type?, call : Call, cause : Call?) : Nil
    if definition.name == "start" && (worker_metaclass?(receiver) || worker_metaclass?(@visitor.program.def_owner(definition)))
      if origin = cause
        placement = if verdict = @analysis.verdicts[origin]?
                      verdict.placement
                    else
                      "spawn"
                    end
        @analysis.proven("#{spawn_site(origin)} in #{placement}")
      elsif loc = call.name_location || call.location
        @analysis.proven("#{loc.filename}:#{loc.line_number} in IyiWorkers.start")
      else
        @analysis.proven("in IyiWorkers.start")
      end
    end
    return if @seen_defs.includes?(definition.node_id)
    @seen_defs.add(definition.node_id)
    previous = @cause
    @cause = cause
    definition.body.accept(self)
    @cause = previous
  end

  def follow_targets(call : Call, cause : Call?) : Nil
    receiver = @visitor.call_receiver?(call)
    if receiver.nil?
      if obj = call.obj
        receiver = @visitor.type_of?(obj)
      end
    end
    if call.name == "start" && worker_metaclass?(receiver) && call_target(@visitor, call).nil?
      @analysis.unproven("#{spawn_site(call)} in IyiWorkers.start (target unavailable)")
    end
    if definition = @visitor.target_def?(call)
      follow(definition, receiver, call, cause)
    end
    if targets = @visitor.dispatch_targets?(call)
      targets.each do |target|
        follow(target.definition, target.receiver, call, cause)
      end
    end
  end

  def visit(node : Call) : Bool
    if obj = node.obj
      obj.accept(self)
    end
    if arguments = @visitor.call_arguments[node]?
      arguments.each { |arg| arg.accept(self) }
    else
      node.args.each { |arg| arg.accept(self) }
      if named = node.named_args
        named.each { |arg| arg.value.accept(self) }
      end
    end
    if block_arg = node.block_arg
      block_arg.accept(self)
    end
    if block = node.block
      block.accept(self)
    end

    if verdict = @analysis.verdicts[node]?
      if verdict.target == SpawnTarget::Unproven
        @analysis.unproven(verdict.site)
      elsif verdict.target == SpawnTarget::Pooled
        # A missing or incomplete reachable body is not proof that this
        # explicitly pooled placement avoids preemption.
        @analysis.unproven(verdict.site)
        # A plain spawn runs the pooled def typed beside it; `unit: :new` asks for a unit of its own (spawn_new).
        pooled_name = "spawn_pooled"
        pooled_name = "spawn_new" if verdict.placement == "spawn(unit: :new)"
        if target = call_target(@visitor, node)
          if beside = typed_beside(@visitor, target, pooled_name)
            follow(beside, nil, node, node)
          end
        end
      elsif verdict.target == SpawnTarget::AsWritten
        follow_targets(node, node)
      end
    elsif spawn_call?(@visitor, node) || unresolved_group_spawn?(@visitor, node)
      # A missed site is not evidence that hosted leaves the target alone.
      @analysis.unproven(spawn_site(node))
    else
      follow_targets(node, @cause)
    end
    false
  end
end
