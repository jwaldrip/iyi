# The analysed-program contract (S0, specification section 3.6).
#
# Every member the Crystal code generator reads from the analysed program, one
# abstract def per member, in the order of src/compiler/lower/CONTRACT.md. The
# gate (bench/selfhost_typed_parity_exercise.sh) fails when this trait and that
# table name different members. A member's name is its original name, except
# where that name is not a legal iyi name: an iyi keyword gets a `_member`
# suffix, a `!` becomes `_bang`, and annotations and constants have no method
# name of their own, so their rows give the name used here.

module compiler/semantic/typed

pub trait AnalysedProgram
  abstract def accept
  abstract def all_instance_vars
  abstract def all_subclasses
  abstract def base_type
  abstract def belongs_to?
  abstract def bytes
  abstract def can_throw?
  abstract def const
  abstract def context
  abstract def def_member
  abstract def each_concrete_type
  abstract def each_instantiated_type
  abstract def entries
  abstract def expanded_location
  abstract def expressions
  abstract def filename
  abstract def filter_by
  abstract def get_exception_name
  abstract def has_key?
  abstract def hook_expansions
  abstract def implements?
  abstract def includes_type?
  abstract def index_of_instance_var
  abstract def instance
  abstract def instance_vars
  abstract def instance_vars_initializers
  abstract def instantiated_types
  abstract def iyi
  abstract def lookup_instance_var
  abstract def malloc_atomic_name
  abstract def malloc_name
  abstract def members
  abstract def name_type
  abstract def namespace
  abstract def new_temp_var_name
  abstract def nil_type
  abstract def nil_type?
  abstract def node
  abstract def normalize
  abstract def not_nil_type
  abstract def optimization_mode
  abstract def packed?
  abstract def params
  abstract def parent
  abstract def pointer?
  abstract def pointer_of
  abstract def proc?
  abstract def proc_type
  abstract def raise_cast_failed_name
  abstract def raise_name
  abstract def raise_overflow_name
  abstract def realloc_name
  abstract def reference_like?
  abstract def reference_type
  abstract def remove_indirection
  abstract def special_var?
  abstract def struct?
  abstract def subclasses
  abstract def super?
  abstract def superclass
  abstract def syntax_replacement
  abstract def target
  abstract def target_cpu
  abstract def target_features
  abstract def to
  abstract def tuple_types
  abstract def type_from_literal_kind
  abstract def type_merge
  abstract def types
  abstract def types?
  abstract def unbound?
  abstract def union_types
  abstract def unions
  abstract def upcast
  abstract def var
  abstract def visit_main
  abstract def void?
  abstract def arg_types
  abstract def args
  abstract def block
  abstract def body
  abstract def closure_in?
  abstract def cond
  abstract def def_full_name
  abstract def default_value
  abstract def else_member
  abstract def end_location
  abstract def exp
  abstract def expanded
  abstract def fun_literal
  abstract def has_inner_pointers?
  abstract def instance_type
  abstract def location
  abstract def mangled_name
  abstract def meta_vars
  abstract def metaclass
  abstract def metaclass?
  abstract def name
  abstract def name_location
  abstract def no_return?
  abstract def obj
  abstract def owner
  abstract def return_type
  abstract def scope
  abstract def set_type
  abstract def special_vars
  abstract def splat_index
  abstract def supports_autocast?
  abstract def target_const
  abstract def target_def
  abstract def target_defs
  abstract def then_member
  abstract def type_member
  abstract def type?
  abstract def uses_with_scope
  abstract def value
  abstract def vars
  abstract def with_scope
  abstract def type_id
  abstract def virtual_type
  abstract def virtual_type_bang
  abstract def virtual_type_made?
  abstract def size_bit_width
  abstract def sizeof_type
  abstract def alignstack?
  abstract def allowed_in_lib?
  abstract def annotation_member
  abstract def call_convention
  abstract def clobbers
  abstract def constraint
  abstract def element_type
  abstract def extern?
  abstract def extern_union?
  abstract def file_module
  abstract def file_modules
  abstract def inputs
  abstract def link_annotations
  abstract def main_name
  abstract def output_ptrofs
  abstract def outputs
  abstract def real_name
  abstract def remove_alias
  abstract def remove_typedef
  abstract def typedef
  abstract def volatile?
  abstract def wasm_import_module
  abstract def class_vars
  abstract def class_vars?
  abstract def global
  abstract def initializer
  abstract def lookup_class_var
  abstract def lookup_class_var?
  abstract def once_init_name
  abstract def once_name
  abstract def simple_initializer
  abstract def simple_literal?
  abstract def thread_local
  abstract def argc_unsafe
  abstract def argv_unsafe
  abstract def const_initializers
  abstract def const_slices
  abstract def predefined_constants
  abstract def has_flag?
  abstract def no_init_flag
  abstract def iyi_artifact_class_vars
  abstract def iyi_artifact_constant_reads
  abstract def iyi_artifact_match_types
  abstract def iyi_artifact_modules
  abstract def iyi_artifact_numbered_types
  abstract def iyi_artifact_objects
  abstract def iyi_artifact_phantom_types
  abstract def iyi_artifact_symbols
  abstract def iyi_exported_owners
  abstract def iyi_origin
  abstract def iyi_preempt_flag
  abstract def iyi_preempt_funs
  abstract def iyi_prelude_dir
  abstract def iyi_runs_c?
  abstract def iyi_unit_class_vars
  abstract def iyi_unit_constants
  abstract def iyi_unit_libs
  abstract def iyi_unit_match_types
  abstract def iyi_unit_symbol_literals
  abstract def iyi_unit_symbols
  abstract def iyi_unit_type_ids
  abstract def annotation_always_inline
  abstract def annotation_link
  abstract def annotation_naked
  abstract def annotation_no_inline
  abstract def annotation_no_preempt
  abstract def annotation_primitive
  abstract def annotation_raises
  abstract def annotation_thread_local
end
