module compiler/tools/bind

import compiler/foundation/location::{Location}
import compiler/syntax/ast::{ASTNode, Arg, ArrayLiteral, Assign, BoolLiteral, Call, ClassDef, Def, EnumDef, Expressions, ImplDef, InstanceVar, LibDef, ModuleDef, NilLiteral, Nop, NumberLiteral, Path, ProcNotation, Self, StringBuilder, StringInterpolation, StringLiteral, TraitDef, Var, Visibility, VisibilityModifier, Yield}
import compiler/syntax/parser::{Parser}
import compiler/syntax/visitor::{Visitor}

# What a method is, for a boundary.
pub enum BindVerdict
  Ready
  NeedsReturn
  NeedsHuman

  def ready? : Bool
    self == Ready
  end

  def needs_return? : Bool
    self == NeedsReturn
  end

  def needs_human? : Bool
    self == NeedsHuman
  end

  def to_s : String
    case self
    when Ready
      "ready"
    when NeedsReturn
      "needs_return"
    when NeedsHuman
      "needs_human"
    else
      "unknown"
    end
  end
end

# What happened when a written return type was held against what a caller is handed.
pub enum BindCheck
  NotWritten
  Agrees
  Disagrees
  Unchecked
  Dispatched

  def not_written? : Bool
    self == NotWritten
  end

  def agrees? : Bool
    self == Agrees
  end

  def disagrees? : Bool
    self == Disagrees
  end

  def unchecked? : Bool
    self == Unchecked
  end

  def dispatched? : Bool
    self == Dispatched
  end

  def to_s : String
    case self
    when NotWritten
      "not_written"
    when Agrees
      "agrees"
    when Disagrees
      "disagrees"
    when Unchecked
      "unchecked"
    when Dispatched
      "dispatched"
    else
      "unknown"
    end
  end
end

# Name, restriction, and default value of a method parameter.
pub struct BindParam
  property name : String
  property restriction : String
  property default_value : String

  def initialize(@name : String, @restriction : String, @default_value : String = "")
  end
end

# A method and its classification under a boundary.
pub class BindMethod
  property owner : String
  property name : String
  property verdict : BindVerdict
  property block : Bool
  property untyped : Array(String)
  property location : String
  property params : Array(BindParam)
  property returns : String?
  property receiver : String
  property written_block : String
  property inferred : String?
  property refused : String?
  property body : String?
  property storable : Bool
  property checked : BindCheck
  property produced : String?
  property private_def : Bool
  property body_answers : Bool
  property uncompilable : Bool
  property abstract_def : Bool
  property answers_abstract : Bool
  property written : String
  property free_vars : Array(String)

  def initialize(
    @owner : String,
    @name : String,
    @verdict : BindVerdict,
    @block : Bool = false,
    @untyped : Array(String) = [] of String,
    @location : String = "",
    @params : Array(BindParam) = [] of BindParam,
    @returns : String? = nil,
    @receiver : String = "",
    @written_block : String = "",
    @inferred : String? = nil,
    @refused : String? = nil,
    @body : String? = nil,
    @storable : Bool = true,
    @checked : BindCheck = BindCheck::NotWritten,
    @produced : String? = nil,
    @private_def : Bool = false,
    @body_answers : Bool = false,
    @uncompilable : Bool = false,
    @abstract_def : Bool = false,
    @answers_abstract : Bool = false,
    @written : String = "",
    @free_vars : Array(String) = [] of String,
  )
  end

  def answer : String?
    if p = @produced
      p
    elsif r = @returns
      r
    elsif i = @inferred
      i
    else
      nil
    end
  end

  def signature_types : Array(String)
    types = [] of String
    @params.each do |param|
      types << param.restriction
    end
    if ans = answer
      types << ans
    end
    if !@written_block.empty?
      parts = @written_block.split(" : ")
      types << parts[parts.size - 1]
    end
    types
  end

  def callable? : Bool
    !@block || !@written_block.empty?
  end

  def declaration(include_defaults : Bool = false) : String
    args_arr = [] of String
    @params.each do |param|
      if param.name.empty? || param.name == "*"
        args_arr << "*"
      else
        written = param.restriction == "?" ? param.name : "#{param.name} : #{param.restriction}"
        if include_defaults && !param.default_value.empty?
          written = "#{written} = #{param.default_value}"
        end
        args_arr << written
      end
    end
    args = args_arr.join(", ")
    sig = args.empty? ? @name : "#{@name}(#{args})"
    ans = answer || "Nil"
    "pub def #{sig} : #{ans}"
  end
end

# AST visitor collecting public methods and definitions under a root namespace.
pub class BindCollector < Visitor
  property root : String
  property namespace_stack : Array(String)
  property visibility_stack : Array(Visibility)
  property methods : Array(BindMethod)
  property types : Array(String)
  property shard_mode : Bool
  property current_class_name : String
  property current_class_initializers : Array(Def)

  def initialize(@root : String = "")
    @namespace_stack = [] of String
    @visibility_stack = [Visibility::Public]
    @methods = [] of BindMethod
    @types = [] of String
    @shard_mode = false
    @current_class_name = ""
    @current_class_initializers = [] of Def
  end

  def current_ns : String
    @namespace_stack.join("::")
  end

  def current_visibility : Visibility
    @visibility_stack.last
  end

  def visit(node : ModuleDef) : Bool
    ns = node.name.to_s
    @namespace_stack << ns
    full = current_ns
    @types << full unless @types.includes?(full)
    true
  end

  def end_visit(node : ModuleDef) : Nil
    @namespace_stack.pop unless @namespace_stack.empty?
  end

  def visit(node : ClassDef) : Bool
    c_name = node.name.to_s
    if @shard_mode
      if tv = node.type_vars
        c_name = "#{c_name}(#{tv.join(", ")})"
      end
      @current_class_name = @namespace_stack.empty? ? c_name : "#{@namespace_stack.join("::")}::#{c_name}"
      @current_class_initializers = [] of Def
    end
    @namespace_stack << c_name
    full = current_ns
    @types << full unless @types.includes?(full)
    if split = full.index("(")
      base = full[0, split]
      @types << base unless @types.includes?(base)
    end
    true
  end

  def end_visit(node : ClassDef) : Nil
    if @shard_mode
      c_name = @current_class_name
      inits = @current_class_initializers
      inits.each do |init_def|
        new_method = synthesize_new(c_name, init_def)
        @methods << new_method
      end
      @current_class_name = ""
      @current_class_initializers = [] of Def
    end
    @namespace_stack.pop unless @namespace_stack.empty?
  end

  def visit(node : EnumDef) : Bool
    ns = node.name.to_s
    @namespace_stack << ns
    full = current_ns
    @types << full unless @types.includes?(full)
    true
  end

  def end_visit(node : EnumDef) : Nil
    @namespace_stack.pop unless @namespace_stack.empty?
  end

  def visit(node : ImplDef) : Bool
    target_name = ""
    if node.target.is_a?(Path)
      target_name = node.target.as(Path).to_s
    else
      target_name = node.target.to_s
    end
    @namespace_stack << target_name
    full = current_ns
    @types << full unless @types.includes?(full)
    true
  end

  def end_visit(node : ImplDef) : Nil
    @namespace_stack.pop unless @namespace_stack.empty?
  end

  def visit(node : TraitDef) : Bool
    ns = node.name.to_s
    @namespace_stack << ns
    full = current_ns
    @types << full unless @types.includes?(full)
    true
  end

  def end_visit(node : TraitDef) : Nil
    @namespace_stack.pop unless @namespace_stack.empty?
  end

  def visit(node : VisibilityModifier) : Bool
    @visibility_stack << node.modifier
    true
  end

  def end_visit(node : VisibilityModifier) : Nil
    @visibility_stack.pop if @visibility_stack.size > 1
  end

  def synthesize_new(class_name : String, init_def : Def) : BindMethod
    owner = "#{class_name}.class"
    params = [] of BindParam
    init_def.args.each_with_index do |arg, idx|
      next if arg.name.empty?
      p_name = arg.name
      if idx == init_def.splat_index
        p_name = "*#{p_name}"
      end
      restr = arg.restriction ? arg.restriction.to_s : "?"
      restr = resolve_param_restriction(owner, restr)
      def_val = arg.default_value ? arg.default_value.to_s : ""
      params << BindParam.new(p_name, restr, def_val)
    end

    is_generic = class_name.includes?("(")
    inferred_ret = is_generic ? nil : class_name
    refused_reason = is_generic ? "generic type" : nil

    loc_str = init_def.location ? init_def.location.to_s : "?"

    BindMethod.new(
      owner: owner,
      name: "new",
      verdict: BindVerdict::NeedsReturn,
      block: false,
      untyped: [] of String,
      location: loc_str,
      params: params,
      returns: nil,
      receiver: "",
      written_block: "",
      inferred: inferred_ret,
      refused: refused_reason,
      body: nil,
      storable: true,
      checked: BindCheck::NotWritten,
      produced: nil,
      private_def: false,
      body_answers: false,
      uncompilable: false,
      abstract_def: false,
      answers_abstract: false,
      written: "",
      free_vars: init_def.free_vars || [] of String
    )
  end

  # Resolve a restriction in the owner's lexical namespace. Generic owners
  # keep unresolved restrictions as written, as the hosted lookup does.
  def resolve_param_restriction(owner : String, restr : String) : String
    return restr if owner.includes?("(")
    if restr.starts_with?("*")
      inner = restr[1, restr.bytesize - 1]
      return "*#{resolve_param_restriction(owner, inner)}"
    end
    scope = owner
    if scope.ends_with?(".class")
      scope = scope[0, scope.bytesize - 6]
    elsif scope.ends_with?(":Module")
      scope = scope[0, scope.bytesize - 7]
    end
    return scope if restr == "self"

    base = restr
    suffix = ""
    if split = restr.index("(")
      base = restr[0, split]
      suffix = restr[split, restr.bytesize - split]
    end
    absolute = base.starts_with?("::")
    bare = absolute ? base[2, base.bytesize - 2] : base
    unless absolute
      segments = scope.split("::")
      until segments.empty?
        candidate = "#{segments.join("::")}::#{bare}"
        return "#{candidate}#{suffix}" if @types.includes?(candidate)
        segments.pop
      end
    end
    return "#{bare}#{suffix}" if @types.includes?(bare)
    if suffix.empty? && BindTool.nameable_name?(bare, "")
      return "::#{bare}"
    end
    restr
  end

  def unqualify(type : String) : String
    type.starts_with?("::") ? type[2, type.bytesize - 2] : type
  end

  # This syntax-only collector cannot instantiate arbitrary calls. It reads
  # expressions whose answer is present in the tree and refuses the rest.
  def infer_expression(owner : String, node : ASTNode, definition : Def) : String?
    if node.is_a?(Expressions)
      expressions = node.as(Expressions).expressions
      return "Nil" if expressions.empty?
      return infer_expression(owner, expressions.last, definition)
    elsif node.is_a?(Assign)
      return infer_expression(owner, node.as(Assign).value, definition)
    elsif node.is_a?(Nop) || node.is_a?(NilLiteral)
      return "Nil"
    elsif node.is_a?(BoolLiteral)
      return "Bool"
    elsif node.is_a?(StringLiteral) || node.is_a?(StringInterpolation)
      return "String"
    elsif node.is_a?(NumberLiteral)
      kind = node.as(NumberLiteral).kind
      prefix = kind.float? ? "Float" : (kind.unsigned? ? "UInt" : "Int")
      return "#{prefix}#{kind.bit_width}"
    elsif node.is_a?(Var)
      name = node.as(Var).name
      definition.args.each do |arg|
        if arg.name == name
          if restriction = arg.restriction
            return unqualify(resolve_param_restriction(owner, restriction.to_s))
          end
        end
      end
    elsif node.is_a?(InstanceVar)
      name = node.as(InstanceVar).name
      @current_class_initializers.each do |initializer|
        if answer = infer_instance_assignment(owner, initializer.body, initializer, name)
          return answer
        end
      end
    elsif node.is_a?(Yield)
      if block_arg = definition.block_arg
        if restriction = block_arg.restriction
          if restriction.is_a?(ProcNotation)
            if output = restriction.as(ProcNotation).output
              return unqualify(resolve_param_restriction(owner, output.to_s))
            end
          end
        end
      end
    elsif node.is_a?(ArrayLiteral)
      if element = node.as(ArrayLiteral).of
        return "Array(#{unqualify(resolve_param_restriction(owner, element.to_s))})"
      end
    elsif node.is_a?(Self)
      return unqualify(resolve_param_restriction(owner, "self"))
    elsif node.is_a?(Call)
      call = node.as(Call)
      if call.name == "new"
        if receiver = call.obj
          return unqualify(resolve_param_restriction(owner, receiver.to_s))
        end
      end
    end
    nil
  end

  def infer_instance_assignment(owner : String, node : ASTNode, definition : Def, name : String) : String?
    if node.is_a?(Expressions)
      node.as(Expressions).expressions.each do |expression|
        if answer = infer_instance_assignment(owner, expression, definition, name)
          return answer
        end
      end
    elsif node.is_a?(Assign)
      assignment = node.as(Assign)
      if assignment.target.is_a?(InstanceVar) && assignment.target.as(InstanceVar).name == name
        return infer_expression(owner, assignment.value, definition)
      end
    end
    nil
  end

  def visit(node : Def) : Bool
    vis = node.visibility || current_visibility
    is_public = (vis == Visibility::Public)

    c_ns = current_ns
    rec = node.receiver ? node.receiver.to_s : ""
    is_self = (rec == "self")

    owner = ""
    if is_self
      if c_ns.empty?
        owner = "TopLevel:Module"
      else
        owner = "#{c_ns}:Module"
      end
    else
      if c_ns.empty?
        owner = "TopLevel"
      else
        owner = c_ns
      end
    end

    matches_root = !@root.empty? && (owner == @root || owner.starts_with?("#{@root}::") || owner.starts_with?("#{@root}:"))
    if matches_root
      if @shard_mode
        is_init = (node.name == "initialize")
        is_priv = (vis == Visibility::Private)
        is_pub = (vis == Visibility::Public)
        is_prot = (vis == Visibility::Protected)

        if is_init && !@current_class_name.empty?
          @current_class_initializers << node
        end

        if is_pub || is_init || is_priv || is_prot
          @methods << classify_def(owner, node, rec, is_priv || is_init)
        end
      elsif is_public
        @methods << classify_def(owner, node, rec, false)
      end
    end

    false
  end

  def classify_def(owner : String, node : Def, receiver : String, is_private : Bool = false) : BindMethod
    has_untyped = false
    untyped = [] of String
    params = [] of BindParam

    node.args.each_with_index do |arg, idx|
      if arg.name.empty?
        params << BindParam.new("*", "", "")
        next
      end

      restr_str = "?"
      if r = arg.restriction
        restr_str = @shard_mode ? resolve_param_restriction(owner, r.to_s) : r.to_s
      else
        has_untyped = true
        untyped << arg.name
      end

      p_name = arg.name
      if !arg.external_name.empty? && arg.external_name != arg.name
        p_name = "#{arg.external_name} #{arg.name}"
      end
      if idx == node.splat_index
        p_name = "*#{p_name}"
      end

      def_val = arg.default_value ? arg.default_value.to_s : ""
      params << BindParam.new(p_name, restr_str, def_val)
    end

    if ds = node.double_splat
      ds_restr = ds.restriction ? ds.restriction.to_s : "?"
      params << BindParam.new("**#{ds.name}", ds_restr, "")
    end

    verdict = BindVerdict::NeedsReturn
    if has_untyped
      verdict = BindVerdict::NeedsHuman
    elsif node.return_type
      verdict = BindVerdict::Ready
    else
      verdict = BindVerdict::NeedsReturn
    end

    has_block = !node.block_arg.nil? || node.uses_block_arg?
    written_blk = ""
    if ba = node.block_arg
      if br = ba.restriction
        written_blk = "&#{ba.name} : #{br.to_s}"
      else
        written_blk = "&#{ba.name}"
      end
    elsif node.uses_block_arg?
      written_blk = "&"
    end

    ret_str = if rt = node.return_type
                @shard_mode ? resolve_param_restriction(owner, rt.to_s) : rt.to_s
              else
                nil
              end

    loc_str = node.location ? node.location.to_s : "?"

    checked = BindCheck::NotWritten
    refused = nil
    inferred = nil
    produced = nil

    if @shard_mode
      free_vars = node.free_vars || [] of String
      if free_vars.empty?
        if node.abstract && ret_str
          checked = BindCheck::Dispatched
        elsif verdict.needs_return? || ret_str || (verdict.needs_human? && has_block)
          if ba = node.block_arg
            if br = ba.restriction
              refused = "block returns `_`" if br.to_s.includes?("_")
            else
              refused = "block is not annotated"
            end
          elsif node.uses_block_arg?
            refused = "yields without a block parameter"
          end
          if refused.nil?
            if node.splat_index || node.double_splat
              refused = "splat"
            elsif owner.includes?("(")
              refused = "generic type"
            elsif has_untyped
              refused = "no restriction"
            end
          end
          answer = refused.nil? ? infer_expression(owner, node.body, node) : nil
          refused = "return requires semantic analysis" if answer.nil? && refused.nil?
          if ret_str
            if answer.nil?
              checked = BindCheck::Unchecked
            elsif answer == unqualify(ret_str)
              checked = BindCheck::Agrees
            else
              checked = BindCheck::Disagrees
              produced = answer
            end
          elsif verdict.needs_return?
            inferred = answer
          end
        end
      end
    else
      if ret_str
        if node.abstract
          checked = BindCheck::Dispatched
        else
          checked = BindCheck::Agrees
        end
      end
    end

    BindMethod.new(
      owner: owner,
      name: node.name,
      verdict: verdict,
      block: has_block,
      untyped: untyped,
      location: loc_str,
      params: params,
      returns: ret_str,
      receiver: receiver,
      written_block: written_blk,
      inferred: inferred,
      refused: refused,
      body: node.body ? node.body.to_s : nil,
      storable: true,
      checked: checked,
      produced: produced,
      private_def: is_private,
      body_answers: false,
      uncompilable: false,
      abstract_def: node.abstract,
      answers_abstract: false,
      written: loc_str,
      free_vars: node.free_vars || [] of String
    )
  end
end

# Main entry point for analyzing and printing bind reports.
pub class BindTool
  BUILTIN_NAMES = [
    "Void", "Nil", "Bool", "Char",
    "Int8", "Int16", "Int32", "Int64", "Int128",
    "UInt8", "UInt16", "UInt32", "UInt64", "UInt128",
    "Float32", "Float64",
    "String", "Symbol", "Array", "Hash", "Range", "Tuple", "NamedTuple",
    "Slice", "Pointer", "Proc", "StaticArray", "Exception", "Class", "Object",
    "Value", "Number", "Int", "Float", "Struct",
  ]

  def self.iyi_module_name(root : String) : String
    segments = root.split("::")
    mapped = [] of String
    segments.each do |segment|
      broken = ""
      i = 0
      while i < segment.bytesize
        b = segment.byte_at(i)
        if b >= 65_u8 && b <= 90_u8
          broken = broken + "_"
          broken = broken + (b + 32_u8).unsafe_chr.to_s
        else
          broken = broken + b.unsafe_chr.to_s
        end
        i = i + 1
      end
      if broken.starts_with?("_")
        broken = broken[1, broken.bytesize - 1]
      end
      mapped << broken
    end
    mapped.join("/")
  end

  def self.consumer_name(root : String) : String
    segments = iyi_module_name(root).split('/')
    mapped = [] of String
    segments.each do |seg|
      parts = seg.split('_')
      c = ""
      parts.each do |p|
        if !p.empty?
          first_b = p.byte_at(0)
          first_char = (first_b >= 97_u8 && first_b <= 122_u8) ? (first_b - 32_u8).unsafe_chr.to_s : p[0, 1]
          rest = p.bytesize > 1 ? p[1, p.bytesize - 1] : ""
          c = c + first_char + rest
        end
      end
      mapped << c
    end
    mapped.join("::")
  end

  def self.round_trips?(root : String) : Bool
    consumer_name(root) == root
  end

  def self.nameable_name?(name : String, root : String, declared_types : Array(String) = [] of String) : Bool
    return true if !root.empty? && (name == root || name.starts_with?("#{root}::"))
    bare = name
    while bare.starts_with?("::")
      bare = bare[2, bare.bytesize - 2]
    end
    return true if !root.empty? && declared_types.includes?("#{root}::#{bare}")
    i = 0
    while i < BUILTIN_NAMES.size
      return true if bare == BUILTIN_NAMES[i]
      i = i + 1
    end
    false
  end

  def self.extract_type_identifiers(type_str : String) : Array(String)
    res = [] of String
    i = 0
    len = type_str.bytesize
    while i < len
      b = type_str.byte_at(i)
      is_start = (b >= 65_u8 && b <= 90_u8) || (b >= 97_u8 && b <= 122_u8) || b == 95_u8
      if is_start
        start_idx = i
        while i < len
          cb = type_str.byte_at(i)
          is_part = (cb >= 65_u8 && cb <= 90_u8) || (cb >= 97_u8 && cb <= 122_u8) ||
                    (cb >= 48_u8 && cb <= 57_u8) || cb == 95_u8 || cb == 58_u8
          if is_part
            i = i + 1
          else
            break
          end
        end
        token = type_str[start_idx, i - start_idx]
        res << token
      else
        i = i + 1
      end
    end
    res
  end

  def self.nameable?(type_str : String, root : String, free_vars : Array(String) = [] of String, declared_types : Array(String) = [] of String) : Bool
    if index = type_str.index(":Module")
      return false if index == 0 || type_str.byte_at(index - 1) != 58_u8
    end
    tokens = extract_type_identifiers(type_str)
    tokens.each do |token|
      next if token == "class" || token == "_"
      next if free_vars.includes?(token)
      unless nameable_name?(token, root, declared_types)
        return false
      end
    end
    true
  end

  def self.normalize_location(loc : String) : String
    idx = loc.index("bench/")
    rel = loc
    if idx
      rel = loc[idx, loc.bytesize - idx]
    else
      idx = loc.index("samples/")
      if idx
        rel = loc[idx, loc.bytesize - idx]
      else
        idx = loc.index("spec/")
        if idx
          rel = loc[idx, loc.bytesize - idx]
        else
          last_slash = loc.rindex('/')
          if last_slash
            rel = loc[last_slash + 1, loc.bytesize - last_slash - 1]
          end
        end
      end
    end
    colon_parts = rel.split(':')
    if colon_parts.size >= 3
      "#{colon_parts[0]}:#{colon_parts[1]}:#{colon_parts[2]}"
    elsif colon_parts.size >= 2
      "#{colon_parts[0]}:#{colon_parts[1]}"
    else
      rel
    end
  end

  def self.format_pct(val : Float64) : String
    int_part = (val * 10.0_f64 + 0.5_f64).to_i64
    whole = int_part // 10_i64
    tenth = int_part % 10_i64
    "#{whole}.#{tenth}"
  end

  def self.sort_strings(arr : Array(String)) : Nil
    n = arr.size
    i = 0
    while i < n - 1
      j = 0
      while j < n - i - 1
        if arr[j + 1] < arr[j]
          temp = arr[j]
          arr[j] = arr[j + 1]
          arr[j + 1] = temp
        end
        j = j + 1
      end
      i = i + 1
    end
  end

  def self.sort_methods(arr : Array(BindMethod)) : Nil
    n = arr.size
    i = 0
    while i < n - 1
      j = 0
      while j < n - i - 1
        a_key = "#{arr[j].owner}##{arr[j].name}"
        b_key = "#{arr[j + 1].owner}##{arr[j + 1].name}"
        if b_key < a_key
          temp = arr[j]
          arr[j] = arr[j + 1]
          arr[j + 1] = temp
        end
        j = j + 1
      end
      i = i + 1
    end
  end

  def self.count_name(names : Array(String), counts : Array(Int32), name : String) : Nil
    if index = names.index(name)
      counts[index] = counts[index] + 1
    else
      names << name
      counts << 1
    end
  end

  # Stable descending order, preserving the compiler's collection order on ties.
  def self.sort_counts(names : Array(String), counts : Array(Int32), alphabetic_ties : Bool = false) : Nil
    i = 0
    while i < names.size - 1
      j = 0
      while j < names.size - i - 1
        if counts[j + 1] > counts[j] || (alphabetic_ties && counts[j + 1] == counts[j] && names[j + 1] < names[j])
          name = names[j]
          count = counts[j]
          names[j] = names[j + 1]
          counts[j] = counts[j + 1]
          names[j + 1] = name
          counts[j + 1] = count
        end
        j = j + 1
      end
      i = i + 1
    end
  end

  def self.analyze(node : ASTNode, root : String) : Array(BindMethod)
    collector = BindCollector.new(root)
    node.accept(collector)
    collector.methods
  end

  def self.analyze_source(source : String, root : String, filename : String = "") : Array(BindMethod)
    parser = Parser.new(source)
    parser.filename = filename unless filename.empty?
    node = parser.parse
    analyze(node, root)
  end

  def self.detect_root(source : String) : String
    source.each_line do |line|
      stripped = line
      if stripped.starts_with?("abstract ")
        stripped = stripped[9, stripped.bytesize - 9]
      end
      kw = ""
      if stripped.starts_with?("module ")
        kw = "module "
      elsif stripped.starts_with?("class ")
        kw = "class "
      elsif stripped.starts_with?("struct ")
        kw = "struct "
      end
      if !kw.empty?
        rest = stripped[kw.bytesize, stripped.bytesize - kw.bytesize].strip
        i = 0
        while i < rest.bytesize
          b = rest.byte_at(i)
          is_id = (i == 0) ? (b >= 65_u8 && b <= 90_u8) : ((b >= 65_u8 && b <= 90_u8) || (b >= 97_u8 && b <= 122_u8) || (b >= 48_u8 && b <= 57_u8) || b == 95_u8)
          break unless is_id
          i = i + 1
        end
        return rest[0, i] if i > 0
      end
    end
    ""
  end

  def self.node_has_defs_or_types?(body : ASTNode?) : Bool
    return false if body.nil?
    if body.is_a?(Expressions)
      body.as(Expressions).expressions.each do |e|
        target = e
        if target.is_a?(VisibilityModifier)
          target = target.as(VisibilityModifier).exp
        end
        if target.is_a?(Def) || target.is_a?(ClassDef) || target.is_a?(ModuleDef) || target.is_a?(EnumDef) || target.is_a?(TraitDef)
          return true
        end
      end
    else
      target = body
      if target.is_a?(VisibilityModifier)
        target = target.as(VisibilityModifier).exp
      end
      if target.is_a?(Def) || target.is_a?(ClassDef) || target.is_a?(ModuleDef) || target.is_a?(EnumDef) || target.is_a?(TraitDef)
        return true
      end
    end
    false
  end

  def self.detect_other_namespaces(source : String, root : String) : Array(String)
    parser = Parser.new(source)
    ast = parser.parse
    names = [] of String
    expressions = [] of ASTNode
    if ast.is_a?(Expressions)
      expressions = ast.as(Expressions).expressions
    else
      expressions << ast
    end

    expressions.each do |stmt|
      target = stmt
      if target.is_a?(VisibilityModifier)
        target = target.as(VisibilityModifier).exp
      end

      if target.is_a?(EnumDef)
        e_name = target.as(EnumDef).name.to_s
        if e_name != root && !names.includes?(e_name)
          names << e_name
        end
      elsif target.is_a?(ClassDef)
        c_node = target.as(ClassDef)
        c_name = c_node.name.names.last
        is_generic = !c_node.type_vars.nil?
        if c_name != root && !is_generic && !names.includes?(c_name)
          if c_node.struct || node_has_defs_or_types?(c_node.body)
            names << c_name
          end
        end
      elsif target.is_a?(ModuleDef)
        m_node = target.as(ModuleDef)
        m_name = m_node.name.names.last
        is_generic = !m_node.type_vars.nil?
        if m_name != root && !is_generic && !names.includes?(m_name)
          if node_has_defs_or_types?(m_node.body)
            names << m_name
          end
        end
      elsif target.is_a?(TraitDef)
        t_node = target.as(TraitDef)
        t_name = t_node.name.names.last
        is_generic = false
        if tv = t_node.type_vars
          is_generic = true unless tv.empty?
        end
        if at = t_node.assoc_types
          is_generic = true unless at.empty?
        end
        if t_name != root && !is_generic && !names.includes?(t_name)
          if node_has_defs_or_types?(t_node.body)
            names << t_name
          end
        end
      elsif target.is_a?(ImplDef)
        i_node = target.as(ImplDef)
        target_name = ""
        if i_node.target.is_a?(Path)
          target_name = i_node.target.as(Path).names.last
        end
        if !target_name.empty? && target_name != root && !names.includes?(target_name)
          if node_has_defs_or_types?(i_node.body)
            names << target_name
          end
        end
      elsif target.is_a?(LibDef)
        l_name = target.as(LibDef).name.to_s
        if l_name != root && !names.includes?(l_name)
          names << l_name
        end
      end
    end

    sort_strings(names)
    names
  end

  def self.analyze_shard(source : String, root : String = "", filename : String = "", declared_types : Array(String) = [] of String) : Array(BindMethod)
    shard_root = root
    if shard_root.empty?
      shard_root = detect_root(source)
    end
    if shard_root.empty?
      return [] of BindMethod
    end
    parser = Parser.new(source, filename.empty? ? "fixture.iyi" : filename)
    node = parser.parse
    declarations = BindCollector.new
    declarations.shard_mode = true
    node.accept(declarations)
    declarations.types.each { |name| declared_types << name unless declared_types.includes?(name) }
    collector = BindCollector.new(shard_root)
    collector.shard_mode = true
    collector.types = declared_types
    node.accept(collector)
    collector.methods
  end

  def self.print_bind(source : String, root : String = "", filename : String = "") : String
    shard_root = root
    if shard_root.empty?
      shard_root = detect_root(source)
    end
    others = detect_other_namespaces(source, shard_root)
    declared_types = [] of String
    methods = analyze_shard(source, shard_root, filename, declared_types)
    report(methods, shard_root, true, others, declared_types)
  end

  def self.count_public_methods(source : String, root : String = "", filename : String = "") : Int32
    shard_root = root
    if shard_root.empty?
      shard_root = detect_root(source)
    end
    methods = analyze_shard(source, shard_root, filename)
    methods.size
  end

  def self.report(methods : Array(BindMethod), root : String, normalize_paths : Bool = true, other_namespaces : Array(String) = [] of String, declared_types : Array(String) = [] of String) : String
    ready = 0
    inferable = 0
    human = 0
    block_count = 0

    methods.each do |m|
      if m.verdict.ready?
        ready = ready + 1
      elsif m.verdict.needs_return?
        inferable = inferable + 1
      elsif m.verdict.needs_human?
        human = human + 1
      end
      if m.block
        block_count = block_count + 1
      end
    end

    sb = StringBuilder.new
    if other_namespaces.size > 0
      sb << "also declares: " << other_namespaces.join(", ") << "\n\n"
    else
      sb << "\n"
    end
    sb << "#{root}: #{methods.size} public methods on its own types\n\n"
    sb << "  R-2 as written            #{ready}\n"
    sb << "  a machine can write       #{inferable}\n"
    sb << "  a human has to write      #{human}\n\n"
    sb << "  of those, take a block    #{block_count}\n"

    if methods.empty?
      return sb.to_s
    end
    machine = methods.select { |m| m.verdict.needs_return? }
    unless machine.empty?
      answered = machine.count { |m| !m.inferred.nil? }
      refused_count = machine.size - answered
      sb << "\ninstantiated on purpose, to read what they return:\n"
      sb << "  answered                  #{answered}\n"
      sb << "  refused                   #{refused_count}\n"
      if refused_count > 0
        ref_reasons = [] of String
        ref_counts = [] of Int32
        machine.each do |m|
          if r = m.refused
            idx = ref_reasons.index(r)
            if idx
              ref_counts[idx] = ref_counts[idx] + 1
            else
              ref_reasons << r
              ref_counts << 1
            end
          end
        end
        sort_counts(ref_reasons, ref_counts)
        i = 0
        while i < ref_reasons.size && i < 8
          reason = ref_reasons[i]
          reason = reason[0, 38] if reason.bytesize > 38
          sb << "    #{reason.ljust(38)} #{ref_counts[i]}\n"
          i = i + 1
        end
      end
    end

    written = methods.reject { |m| m.checked.not_written? }
    unless written.empty?
      agrees = written.count { |m| m.checked.agrees? }
      disagrees = written.count { |m| m.checked.disagrees? }
      dispatched = written.count { |m| m.checked.dispatched? }
      unchecked = written.count { |m| m.checked.unchecked? }
      sb << "\nwritten returns, held against what a caller is handed:\n"
      sb << "  agrees                    #{agrees}\n"
      sb << "  disagrees                 #{disagrees}\n"
      sb << "  abstract, so dispatched   #{dispatched}\n"
      sb << "  could not be checked      #{unchecked}\n"
      if unchecked > 0
        unc_reasons = [] of String
        unc_counts = [] of Int32
        written.each do |m|
          if m.checked.unchecked?
            if r = m.refused
              idx = unc_reasons.index(r)
              if idx
                unc_counts[idx] = unc_counts[idx] + 1
              else
                unc_reasons << r
                unc_counts << 1
              end
            end
          end
        end
        sort_counts(unc_reasons, unc_counts)
        i = 0
        while i < unc_reasons.size && i < 8
          reason = unc_reasons[i]
          reason = reason[0, 38] if reason.bytesize > 38
          sb << "    #{reason.ljust(38)} #{unc_counts[i]}\n"
          i = i + 1
        end
      end
      disagreed_methods = written.select { |m| m.checked.disagrees? }
      unless disagreed_methods.empty?
        sb << "\n  and the ones that travel as the answer, not as written:\n"
        sort_methods(disagreed_methods)
        i = 0
        while i < disagreed_methods.size && i < 12
          m = disagreed_methods[i]
          sb << "    #{m.owner}##{m.name}\n"
          sb << "      writes #{m.returns}, answers #{m.produced}\n"
          i = i + 1
        end
        if disagreed_methods.size > 12
          sb << "    ... and #{disagreed_methods.size - 12} more\n"
        end
      end
    end

    mechanical = ready + inferable
    total = methods.size
    pct = total > 0 ? (mechanical * 100.0_f64 / total.to_f64) : 0.0_f64
    pct_str = format_pct(pct)

    sb << "\n  #{pct_str}% of the surface needs no human.\n\n"

    draft_lines = [] of String
    waiting = 0
    unheld = 0
    unblocked = 0
    naming_non_type = 0
    outside = [] of String
    outside_counts = [] of Int32
    unnameable = [] of String
    unnameable_counts = [] of Int32
    unchecked_methods = [] of BindMethod
    blockable_foreign = [] of Array(String)

    methods.each do |m|
      next unless m.verdict.ready? || !m.inferred.nil?
      unless m.storable
        unheld = unheld + 1
        next
      end
      unless m.callable?
        unblocked = unblocked + 1
        next
      end

      all_nameable = true
      declarable = false
      foreign_names = [] of String
      m.signature_types.each do |type|
        next if nameable?(type, root, [] of String, declared_types)
        all_nameable = false
        extract_type_identifiers(type).each do |part|
          next if part == "class" || nameable_name?(part, root, declared_types)
          foreign_names << part unless foreign_names.includes?(part)
          if declared_types.includes?(part)
            count_name(outside, outside_counts, part)
            declarable = true
          else
            count_name(unnameable, unnameable_counts, part)
          end
        end
      end
      blockable_foreign << foreign_names
      if all_nameable
        draft_lines << m.declaration
        unchecked_methods << m if m.checked.unchecked?
      elsif declarable
        waiting = waiting + 1
      else
        naming_non_type = naming_non_type + 1
      end
    end
    sort_strings(draft_lines)

    sb << "a boundary this tool can already write:\n"
    sb << "  signatures                #{draft_lines.size}\n"
    sb << "  waiting on a type nobody has declared  #{waiting}\n"
    sb << "  taking a type no variable can hold     #{unheld}\n" if unheld > 0
    sb << "  naming something that is not a type    #{naming_non_type}\n" if naming_non_type > 0
    sb << "  taking a block nobody annotated        #{unblocked}\n" if unblocked > 0
    sb << "  crossing on a return nobody checked    #{unchecked_methods.size}\n"

    unless unchecked_methods.empty?
      reasons = [] of String
      counts = [] of Int32
      unchecked_methods.each { |m| count_name(reasons, counts, m.refused || "no reason recorded") }
      sort_counts(reasons, counts)
      sb << "\nwhat is left of rule 1, by why the answer could not be read:\n"
      i = 0
      while i < reasons.size
        reason = reasons[i]
        sb << "  #{reason} \u{2014} #{counts[i]}\n"
        matching = unchecked_methods.select { |m| (m.refused || "no reason recorded") == reason }
        sort_methods(matching)
        j = 0
        while j < matching.size && j < 3
          m = matching[j]
          sb << "    #{m.owner}##{m.name} : #{m.returns}\n"
          j = j + 1
        end
        sb << "    ... and #{matching.size - 3} more\n" if matching.size > 3
        i = i + 1
      end
    end

    unless outside.empty?
      sort_counts(outside, outside_counts)
      sb << "\nthe types that boundary is waiting on:\n"
      i = 0
      while i < outside.size && i < 10
        sb << "  #{outside[i].ljust(44)} #{outside_counts[i]}\n"
        i = i + 1
      end
    end

    unless unnameable.empty?
      sort_counts(unnameable, unnameable_counts)
      sb << "\nand the names that are not types anybody can declare:\n"
      i = 0
      while i < unnameable.size && i < 10
        sb << "  #{unnameable[i].ljust(44)} #{unnameable_counts[i]}\n"
        i = i + 1
      end
      sb << "  A free variable, `self`, or a block nobody annotated. These\n"
      sb << "  never cross, and no work makes them.\n"
    end

    blocked_names = [] of String
    blocked_counts = [] of Int32
    blockable_foreign.each do |names|
      names.each do |name|
        count_name(blocked_names, blocked_counts, name) if declared_types.includes?(name)
      end
    end
    unless blocked_names.empty?
      sort_counts(blocked_names, blocked_counts, true)
      sb << "\ndeclaring one type at a time, and what each one unlocks:\n"
      declared = [] of String
      total_opened = 0
      i = 0
      while i < blocked_names.size && i < 8
        name = blocked_names[i]
        declared << name
        opened = 0
        blockable_foreign.each do |names|
          next if names.empty?
          all_declared = names.all? { |foreign| declared.includes?(foreign) }
          opened = opened + 1 if all_declared
        end
        difference = opened - total_opened
        sign = difference >= 0 ? "+" : ""
        sb << "  #{name.ljust(40)} #{sign}#{difference}  (#{opened} in all)\n"
        total_opened = opened
        i = i + 1
      end
    end

    if !draft_lines.empty?
      mod_name = iyi_module_name(root)
      sb << "\n# --- draft ---\n"
      sb << "# Flat, and a real boundary is not: these methods belong to the\n"
      sb << "# types that declare them, and grouping them there is the next\n"
      sb << "# thing this tool has to learn. What is settled here is the part\n"
      sb << "# that was in doubt, which is whether the signatures can be known.\n"
      sb << "module #{mod_name}\n\n"
      draft_lines.each do |dl|
        sb << dl
        sb << "\n"
      end
      sb << "# --- end ---\n"
    end

    if human > 0
      sb << "\nwhat a human has to write:\n"
      needs_human = methods.select { |m| m.verdict.needs_human? }
      sort_methods(needs_human)
      needs_human.each do |m|
        untyped_args = m.untyped.join(", ")
        sb << "  #{m.owner}##{m.name}(#{untyped_args})\n"
        loc = m.location
        if normalize_paths
          loc = normalize_location(loc)
        end
        sb << "    #{loc}\n"
      end
    end

    sb.to_s
  end

  def self.dump_bind(methods : Array(BindMethod), root : String, normalize_paths : Bool = true) : String
    sb = StringBuilder.new
    sb << report(methods, root, normalize_paths)
    sb << "\n== DETAILED METHOD BINDINGS ==\n"
    sorted = [] of BindMethod
    methods.each { |m| sorted << m }
    sort_methods(sorted)
    sorted.each do |m|
      loc = m.location
      if normalize_paths
        loc = normalize_location(loc)
      end
      sb << "METHOD owner=#{m.owner} name=#{m.name} receiver=#{m.receiver} verdict=#{m.verdict} block=#{m.block} callable=#{m.callable?} declaration=\"#{m.declaration(true)}\"\n"
      params_str = [] of String
      m.params.each do |p|
        if p.default_value.empty?
          params_str << "#{p.name}: #{p.restriction}"
        else
          params_str << "#{p.name}: #{p.restriction} = #{p.default_value}"
        end
      end
      sb << "  params: #{params_str.join(", ")}\n"
      if !m.untyped.empty?
        sb << "  untyped: #{m.untyped.join(", ")}\n"
      end
      if ret = m.returns
        sb << "  returns: #{ret}\n"
      end
      if !m.written_block.empty?
        sb << "  written_block: #{m.written_block}\n"
      end
      sb << "  location: #{loc}\n"
    end
    sb.to_s
  end
end
