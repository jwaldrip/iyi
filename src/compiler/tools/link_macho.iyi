# The driver for the native Mach-O executable gate (bench/native_link_exercise.sh).
#
# `link_macho hello OUT` writes a hand-built arm64 program: its `_main` stores a
# string address, calls `_write(1, msg, len)` and `_exit(7)` through imports from
# libSystem, and every word and relocation of it is written here by hand.
#
# `link_macho link OUT IDENT [-framework NAME]... OBJ...` reads each Mach-O arm64
# object with the native reader, links them with the native linker, and writes
# the executable to OUT. IDENT is the code signature's identifier. It prints one
# `LINKED OUT BYTES` line. It exits non-zero on any read or link error.

module compiler/tools/link_macho

import compiler/native/obj/object::{ObjectFile, ObjFormat, ObjError, Section, SectionKind, Symbol, SymbolKind, SymbolBinding, Reloc, RelocKind}
import compiler/native/obj/macho::{read_object}
import compiler/native/link/link::{link, LinkOptions, LinkedImage, LinkError}
import compiler/platform/target::{Target}
import std/slice::{Slice, Bytes}

module LinkMachoTool
  HELLO_TEXT = "hello from the iyi Mach-O linker\n"

  # The hand-built program. Each word is an arm64 instruction; the relocations
  # name the ones that take an address or call an import.
  def self.hello_object(target : Target) : ObjectFile
    msg = HELLO_TEXT
    msg_len = msg.bytesize.to_i64
    words = [] of Int64
    words << 0xd2800020_i64
    words << 0x90000001_i64
    words << 0x91000021_i64
    words << (0xd2800002_i64 | msg_len.unsafe_shl(5_i64))
    words << 0x94000000_i64
    words << 0xd28000e0_i64
    words << 0x94000000_i64
    words << 0xd4200000_i64
    text = Slice(UInt8).new(words.size * 4)
    text.fill(0_u8)
    k = 0
    while k < words.size
      b = 0
      while b < 4
        text[k * 4 + b] = (words[k].unsafe_shr(b.to_i64 * 8_i64) & 0xff_i64).to_u8
        b = b + 1
      end
      k = k + 1
    end
    text_relocs = [] of Reloc
    text_relocs << Reloc.new(4_i64, RelocKind::A64AdrpPage21, 1, 0_i64)
    text_relocs << Reloc.new(8_i64, RelocKind::A64AddLo12, 1, 0_i64)
    text_relocs << Reloc.new(16_i64, RelocKind::A64Call26, 2, 0_i64)
    text_relocs << Reloc.new(24_i64, RelocKind::A64Call26, 3, 0_i64)

    rodata = Slice(UInt8).new(msg.bytesize)
    i = 0
    while i < msg.bytesize
      rodata[i] = msg.byte_at(i)
      i = i + 1
    end

    obj = ObjectFile.new(ObjFormat::MachO, target, "iyi-native")
    obj.sections << Section.new(".text", SectionKind::Text, 4, text, words.size.to_i64 * 4_i64, text_relocs, 0_i64)
    obj.sections << Section.new(".rodata", SectionKind::ReadOnly, 1, rodata, msg_len, [] of Reloc, 0_i64)
    obj.symbols << Symbol.new("main", SymbolKind::Func, SymbolBinding::Global, 0, 0_i64, words.size.to_i64 * 4_i64)
    obj.symbols << Symbol.new("msg", SymbolKind::Object, SymbolBinding::Local, 1, 0_i64, msg_len)
    obj.symbols << Symbol.new("write", SymbolKind::Undefined, SymbolBinding::Global)
    obj.symbols << Symbol.new("exit", SymbolKind::Undefined, SymbolBinding::Global)
    obj
  end

  def self.write_bytes(path : String, bytes : Bytes) : Nil
    File.write(path, String.new(bytes))
  end

  def self.read_file(path : String, target : Target) : ObjectFile
    result = read_object(Slice(UInt8).of(File.read(path)), target)
    if result.is_a?(ObjError)
      raise "#{path}: #{result.message}"
    end
    result.as(ObjectFile)
  end

  def self.run_hello(dest : String) : Nil
    target = Target.new("aarch64-apple-darwin")
    obj = hello_object(target)
    result = link([obj], LinkOptions.new("hello", "main", [] of String))
    if result.is_a?(LinkError)
      raise "hello: #{result.message}"
    end
    image = result.as(LinkedImage)
    write_bytes(dest, image.executable)
    print "LINKED #{dest} #{image.executable.size}\n"
  end

  def self.run_link(args : Array(String)) : Nil
    dest = args[0]
    ident = args[1]
    frameworks = [] of String
    inputs = [] of String
    i = 2
    while i < args.size
      if args[i] == "-framework"
        frameworks << args[i + 1]
        i = i + 2
      else
        inputs << args[i]
        i = i + 1
      end
    end
    target = Target.new("aarch64-apple-darwin")
    objects = [] of ObjectFile
    inputs.each do |path|
      objects << read_file(path, target)
    end
    result = link(objects, LinkOptions.new(ident, "main", frameworks))
    if result.is_a?(LinkError)
      raise "link of #{dest}: #{result.message}"
    end
    image = result.as(LinkedImage)
    write_bytes(dest, image.executable)
    print "LINKED #{dest} #{image.executable.size}\n"
  end

  def self.run : Nil
    args = Program.args
    if args.size == 2 && args[0] == "hello"
      run_hello(args[1])
      return
    end
    if args.size >= 4 && args[0] == "link"
      rest = [] of String
      i = 1
      while i < args.size
        rest << args[i]
        i = i + 1
      end
      run_link(rest)
      return
    end
    raise "usage: link_macho hello OUT | link_macho link OUT IDENT [-framework NAME]... OBJ..."
  end
end

LinkMachoTool.run
