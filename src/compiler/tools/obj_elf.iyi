# The driver for the native ELF object gate (bench/native_elf_exercise.sh).
#
# `obj_elf IN OUT` reads an ELF object of x86_64 or aarch64 with the native reader (the target comes from the file's
# machine), writes the object it read with the native writer to OUT, reads that back, and requires the two reads to
# be equal. It prints one line per relocation kind the format covers with the count seen in IN, zero included, and
# exits non-zero when IN does not read, when the round trip changes the object, or when OUT cannot be written.

module compiler/tools/obj_elf

import compiler/native/obj/object::{ObjectFile, ObjError, Section, Symbol, Reloc, RelocKind, SectionKind}
import compiler/native/obj/elf::{read_object, write_object}
import compiler/platform/target::{Target}
import std/slice::{Slice, Bytes}

module ObjElfTool
  def self.x86_kinds : Array(RelocKind)
    [
      RelocKind::Abs64, RelocKind::PcRel32, RelocKind::X86Branch32, RelocKind::X86GotPcRel,
      RelocKind::Abs32, RelocKind::X86Abs32S, RelocKind::X86TpOff32, RelocKind::X86GotPcRelX,
      RelocKind::X86RexGotPcRelX,
    ]
  end

  def self.arm_kinds : Array(RelocKind)
    [
      RelocKind::Abs64, RelocKind::Abs32, RelocKind::PcRel32, RelocKind::A64Call26,
      RelocKind::A64Jump26, RelocKind::A64AdrpPage21, RelocKind::A64AddLo12,
      RelocKind::A64Ldst8Lo12, RelocKind::A64Ldst16Lo12, RelocKind::A64Ldst32Lo12,
      RelocKind::A64Ldst64Lo12, RelocKind::A64Ldst128Lo12, RelocKind::A64GotPage21,
      RelocKind::A64GotLo12, RelocKind::A64TprelMovwG1, RelocKind::A64TprelMovwG0Nc,
    ]
  end

  # The target an ELF file names in its machine field, from its bytes.
  def self.target_of(bytes : Bytes) : Target
    if bytes.size > 18 && bytes[18] == 62_u8
      return Target.new("x86_64-linux-gnu")
    end
    Target.new("aarch64-linux-gnu")
  end

  def self.read_file(path : String) : ObjectFile
    bytes = Slice(UInt8).of(File.read(path))
    result = read_object(bytes, target_of(bytes))
    if result.is_a?(ObjError)
      raise "#{path}: #{result.message}"
    end
    result.as(ObjectFile)
  end

  # The first place two objects differ, or nil when they are equal.
  def self.difference(a : ObjectFile, b : ObjectFile) : String?
    return "format" unless a.format == b.format
    return "target" unless a.target == b.target
    return "section count #{a.sections.size} vs #{b.sections.size}" unless a.sections.size == b.sections.size
    i = 0
    while i < a.sections.size
      sa = a.sections[i]
      sb = b.sections[i]
      where = "section #{i} #{sa.name}"
      return "#{where}: name #{sb.name}" unless sa.name == sb.name
      return "#{where}: kind" unless sa.kind == sb.kind
      return "#{where}: align" unless sa.align == sb.align
      return "#{where}: flags #{sa.flags} vs #{sb.flags}" unless sa.flags == sb.flags
      return "#{where}: entsize" unless sa.entsize == sb.entsize
      return "#{where}: size" unless sa.size == sb.size
      return "#{where}: byte count" unless sa.bytes.size == sb.bytes.size
      j = 0
      while j < sa.bytes.size
        return "#{where}: byte #{j}" unless sa.bytes[j] == sb.bytes[j]
        j = j + 1
      end
      return "#{where}: reloc count #{sa.relocs.size} vs #{sb.relocs.size}" unless sa.relocs.size == sb.relocs.size
      k = 0
      while k < sa.relocs.size
        ra = sa.relocs[k]
        rb = sb.relocs[k]
        unless ra.offset == rb.offset && ra.kind == rb.kind && ra.symbol == rb.symbol && ra.addend == rb.addend
          return "#{where}: reloc #{k} (offset #{ra.offset}, kind #{ra.kind}, symbol #{ra.symbol}, addend #{ra.addend}) vs (offset #{rb.offset}, kind #{rb.kind}, symbol #{rb.symbol}, addend #{rb.addend})"
        end
        k = k + 1
      end
      i = i + 1
    end
    return "symbol count #{a.symbols.size} vs #{b.symbols.size}" unless a.symbols.size == b.symbols.size
    i = 0
    while i < a.symbols.size
      x = a.symbols[i]
      y = b.symbols[i]
      unless x.name == y.name && x.kind == y.kind && x.binding == y.binding && x.section == y.section && x.value == y.value && x.size == y.size && x.desc == y.desc
        return "symbol #{i} #{x.name}: #{x.kind} #{x.binding} section #{x.section} value #{x.value} desc #{x.desc} vs #{y.name}: #{y.kind} #{y.binding} section #{y.section} value #{y.value} desc #{y.desc}"
      end
      i = i + 1
    end
    nil
  end

  # Prints the count of each relocation kind the format covers, for each architecture.
  def self.report(obj : ObjectFile) : Nil
    kinds = obj.target.architecture == "x86_64" ? x86_kinds : arm_kinds
    counts = [] of Int64
    kinds.each do |_kind|
      counts << 0_i64
    end
    obj.sections.each do |sec|
      sec.relocs.each do |reloc|
        k = 0
        while k < kinds.size
          if kinds[k] == reloc.kind
            counts[k] = counts[k] + 1_i64
          end
          k = k + 1
        end
      end
    end
    k = 0
    while k < kinds.size
      print "reloc #{kinds[k]} #{counts[k]}\n"
      k = k + 1
    end
    print "sections #{obj.sections.size} symbols #{obj.symbols.size}\n"
  end

  def self.run : Nil
    args = Program.args
    unless args.size == 2
      raise "usage: obj_elf IN.o OUT.o"
    end
    first = read_file(args[0])
    bytes = write_object(first)
    File.write(args[1], String.new(bytes))
    second = read_object(bytes, first.target)
    if second.is_a?(ObjError)
      raise "#{args[1]}: #{second.message}"
    end
    if message = difference(first, second.as(ObjectFile))
      raise "round trip of #{args[0]} changed the object at #{message}"
    end
    report(first)
    print "ROUNDTRIP EQUAL #{args[0]}\n"
  end
end

ObjElfTool.run
