pub class TypeSplat < Type
  getter splatted_type : Type

  def initialize(program : SemanticProgram, @splatted_type : Type)
    super(program, nil, "*#{@splatted_type.name}")
  end

  def full_name : String
    "*#{@splatted_type.full_name}"
  end
end

# Queries the code generator reads from a type (CONTRACT.md rows for types.cr).
# Each function is the hosted member of the same name in src/compiler/iyi/types.cr.
# Hosted methods reopen classes from other files, which iyi cannot do, so the
# port carries them as functions taking the receiver as their first argument.
pub class TypeQueries
  def self.pointer?(type : Type) : Bool
    type.is_a?(PointerInstanceType)
  end

  def self.proc?(type : Type) : Bool
    type.is_a?(ProcInstanceType)
  end

  def self.void?(type : Type) : Bool
    type.is_a?(VoidType)
  end

  def self.no_return?(type : Type) : Bool
    type.is_a?(NoReturnType)
  end

  def self.virtual?(type : Type) : Bool
    type.is_a?(VirtualType)
  end

  def self.virtual_metaclass?(type : Type) : Bool
    type.is_a?(VirtualMetaclassType)
  end

  # Hosted metaclass?: a MetaclassType of any kind, or a virtual metaclass.
  # The generic instance metaclasses derive from MetaclassType here.
  def self.metaclass?(type : Type) : Bool
    type.is_a?(MetaclassType) || type.is_a?(VirtualMetaclassType)
  end

  # Hosted Type#replace_type_parameters (types.cr): the type with each type parameter replaced by the
  # instance argument of that name, rebuilt only where something changed. A generic instance
  # is rebuilt through the type system's hook, since its arguments may name other instances.
  # A virtual type is not replaced: its base is the generic's own class, not an argument.
  def self.replace_type_parameters(type : Type, tv_map : Hash(String, Type)) : Type
    if type.is_a?(TypeParameterType)
      if replacement = tv_map[type.name]?
        return replacement
      end
      return type
    end
    if type.is_a?(TypeSplat)
      original = type.as(TypeSplat).splatted_type
      splatted = replace_type_parameters(original, tv_map)
      return splatted if splatted.is_a?(TupleInstanceType)
      return type if splatted == original
      return TypeSplat.new(type.program, splatted)
    end
    if type.is_a?(UnionType)
      members = [] of Type
      changed = false
      type.as(UnionType).union_types.each do |member|
        replaced = replace_type_parameters(member, tv_map)
        changed = true unless replaced == member
        members << replaced
      end
      return type unless changed
      if hook = type.program.merge_hook
        return hook.merge_members(members)
      end
      return type
    end
    if type.is_a?(GenericClassInstanceType)
      return replace_generic_instance(type.as(GenericClassInstanceType), tv_map)
    end
    type
  end

  # The arguments of a replaced list, in order.
  def self.replace_list(types : Array(Type), tv_map : Hash(String, Type)) : Array(Type)
    replaced = [] of Type
    types.each do |t|
      replaced << replace_type_parameters(t, tv_map)
    end
    replaced
  end

  def self.same_types?(a : Array(Type), b : Array(Type)) : Bool
    return false unless a.size == b.size
    i = 0
    while i < a.size
      return false unless a[i] == b[i]
      i = i + 1
    end
    true
  end

  # A generic instance, rebuilt with its replaced arguments. The built-in instances (tuple,
  # named tuple, proc, pointer, static array) are rebuilt by their own constructors, as the
  # hosted replace_type_parameters of each class does.
  def self.replace_generic_instance(inst : GenericClassInstanceType, tv_map : Hash(String, Type)) : Type
    if inst.is_a?(TupleInstanceType)
      tuple_types = inst.as(TupleInstanceType).tuple_types
      replaced = replace_list(tuple_types, tv_map)
      return inst if same_types?(replaced, tuple_types)
      return TupleInstanceType.new(inst.program, replaced)
    end
    if inst.is_a?(NamedTupleInstanceType)
      entries = inst.as(NamedTupleInstanceType).entries
      replaced_entries = [] of NamedArgumentType
      changed = false
      entries.each do |entry|
        replaced_type = replace_type_parameters(entry.type, tv_map)
        changed = true unless replaced_type == entry.type
        replaced_entries << NamedArgumentType.new(entry.name, replaced_type)
      end
      return inst unless changed
      return NamedTupleInstanceType.new(inst.program, replaced_entries)
    end
    if inst.is_a?(ProcInstanceType)
      proc_type = inst.as(ProcInstanceType)
      args = replace_list(proc_type.arg_types, tv_map)
      ret = replace_type_parameters(proc_type.return_type, tv_map)
      return inst if same_types?(args, proc_type.arg_types) && ret == proc_type.return_type
      return ProcInstanceType.new(inst.program, args, ret)
    end
    if inst.is_a?(PointerInstanceType)
      element = inst.as(PointerInstanceType).element_type
      replaced = replace_type_parameters(element, tv_map)
      return inst if replaced == element
      return PointerInstanceType.new(inst.program, replaced)
    end
    if inst.is_a?(StaticArrayInstanceType)
      array_type = inst.as(StaticArrayInstanceType)
      replaced = replace_type_parameters(array_type.element_type, tv_map)
      return inst if replaced == array_type.element_type
      return StaticArrayInstanceType.new(inst.program, replaced, array_type.size_int)
    end
    generic = inst.generic_type
    if generic.is_a?(GenericClassType)
      args = replace_list(inst.type_args, tv_map)
      return inst if same_types?(args, inst.type_args)
      if hook = inst.program.merge_hook
        return hook.instantiate_type(generic, args)
      end
    end
    inst
  end

  # Hosted reference_like?: a single pointer represents the value. Nil and the
  # reference unions always do; a class does unless it is a struct; a virtual
  # type does unless its base is a struct. Primitive classes, procs and tuples
  # do not, even though some are classes in the port.
  def self.reference_like?(type : Type) : Bool
    if type.nil_type? || type.is_a?(NilableType) || type.is_a?(NilableReferenceUnionType) || type.is_a?(ReferenceUnionType)
      return true
    end
    if type.is_a?(NonGenericClassType) || type.is_a?(GenericClassType) || type.is_a?(GenericClassInstanceType) || type.is_a?(VirtualType)
      return !type.struct?
    end
    false
  end

  # Hosted subclasses: the direct subclasses of a class type, none otherwise.
  def self.subclasses(type : Type) : Array(Type)
    if type.is_a?(ClassType)
      return type.as(ClassType).subclasses
    end
    if type.is_a?(GenericClassInstanceType)
      return type.as(GenericClassInstanceType).subclasses
    end
    [] of Type
  end

  # Hosted all_subclasses: every descendant, depth first, direct ones in order.
  def self.all_subclasses(type : Type) : Array(Type)
    result = [] of Type
    append_subclasses(type, result)
    result
  end

  private def self.append_subclasses(type : Type, result : Array(Type)) : Nil
    subclasses(type).each do |sub|
      result << sub
      append_subclasses(sub, result)
    end
  end

  def self.leaf?(type : Type) : Bool
    subclasses(type).size == 0
  end

  # Hosted instance_type: the type a metaclass describes. Any other type is its own.
  def self.instance_type(type : Type) : Type
    if type.is_a?(VirtualMetaclassType)
      return type.as(VirtualMetaclassType).instance_type
    end
    if type.is_a?(MetaclassType)
      return type.as(MetaclassType).instance_type
    end
    type
  end

  # Hosted virtual_type!, named virtual_type_bang because iyi names have no `!`.
  # The virtual type over a class, made once and kept on the class (hosted
  # `@virtual_type ||=`), so two calls give the same object. A non-generic class
  # and a generic instance keep one, as the hosted classes that define it do.
  def self.virtual_type_bang(type : Type) : Type
    if type.is_a?(NonGenericClassType)
      cls = type.as(NonGenericClassType)
      if made = cls.virtual_type_cache
        return made
      end
      fresh = VirtualType.new(type.program, type)
      cls.virtual_type_cache = fresh
      return fresh
    end
    if type.is_a?(GenericClassInstanceType)
      inst = type.as(GenericClassInstanceType)
      if made = inst.virtual_type_cache
        return made
      end
      fresh = VirtualType.new(type.program, type)
      inst.virtual_type_cache = fresh
      return fresh
    end
    VirtualType.new(type.program, type)
  end

  # Hosted virtual_type_made?: whether a virtual type over this type was ever made.
  # Asking does not make one.
  def self.virtual_type_made?(type : Type) : Bool
    if type.is_a?(NonGenericClassType)
      return !type.as(NonGenericClassType).virtual_type_cache.nil?
    end
    if type.is_a?(GenericClassInstanceType)
      return !type.as(GenericClassInstanceType).virtual_type_cache.nil?
    end
    false
  end

  # Hosted virtual_type: a class that is a leaf and not abstract stands for
  # itself; an abstract struct with subclasses is its virtual type; any other
  # struct stands for itself; any other class is its virtual type. Non-class
  # types stand for themselves.
  def self.virtual_type(type : Type) : Type
    if type.is_a?(GenericClassType)
      # A generic type stands for itself, as the hosted GenericType does.
      return type
    end
    if type.is_a?(MetaclassType)
      # The metaclass of a virtual type is the virtual metaclass (Animal+.class).
      inst = virtual_type(type.as(MetaclassType).instance_type)
      if inst.is_a?(VirtualType)
        return VirtualMetaclassType.new(type.program, inst.as(VirtualType))
      end
      return type
    end
    if type.is_a?(ClassType)
      is_leaf = leaf?(type)
      is_abstract = type.abstract?
      is_struct = type.struct?
      return type if is_leaf && !is_abstract
      return virtual_type_bang(type) if is_struct && is_abstract && !is_leaf
      return type if is_struct
      return virtual_type_bang(type)
    end
    if type.is_a?(GenericClassInstanceType)
      is_leaf = leaf?(type.as(GenericClassInstanceType).generic_type)
      is_abstract = type.abstract?
      is_struct = type.struct?
      return type if is_leaf && !is_abstract
      return virtual_type_bang(type) if is_struct && is_abstract && !is_leaf
      return type if is_struct
      return virtual_type_bang(type)
    end
    type
  end

  # Hosted splat_index: the position of a splatted type parameter in a generic
  # class or module, nil when there is none.
  def self.splat_index(type : Type) : Int32?
    if type.is_a?(GenericClassType)
      return type.as(GenericClassType).splat_index
    end
    if type.is_a?(GenericModuleType)
      return type.as(GenericModuleType).splat_index
    end
    nil
  end

  # Hosted unbound?: the type still holds a free type parameter. A type parameter
  # is unbound; a generic instance, tuple, named tuple or union is unbound when one
  # of its arguments is; a virtual type is unbound when its base is. Anything else
  # is bound.
  def self.unbound?(type : Type) : Bool
    if type.is_a?(TypeParameter)
      return true
    end
    if type.is_a?(VirtualType)
      return unbound?(type.as(VirtualType).base_type)
    end
    if type.is_a?(NamedTupleInstanceType)
      return any_unbound?(type.as(NamedTupleInstanceType).entries.map(&.type))
    end
    if type.is_a?(TupleInstanceType)
      return any_unbound?(type.as(TupleInstanceType).tuple_types)
    end
    if type.is_a?(GenericInstanceType)
      return any_unbound?(type.as(GenericInstanceType).type_vars.values)
    end
    if type.is_a?(UnionType)
      return any_unbound?(type.as(UnionType).union_types)
    end
    false
  end

  private def self.any_unbound?(types : Array(Type)) : Bool
    i = 0
    while i < types.size
      return true if unbound?(types[i])
      i = i + 1
    end
    false
  end

  # Hosted extern?, extern_union? and packed?: true only for an extern C struct or
  # union, or one marked packed. The port builds no such type: lib struct and union
  # definitions are not visited (top_level.iyi has no CStructOrUnionDef visit), so
  # every type answers false, as the hosted base class does.
  def self.extern?(type : Type) : Bool
    false
  end

  def self.extern_union?(type : Type) : Bool
    false
  end

  def self.packed?(type : Type) : Bool
    false
  end

  # Hosted sizeof_type is computed from layouts, which the port does not build yet.
  # It is refused by name, so no caller receives a wrong size.
  def self.sizeof_type(type : Type) : Int32
    refuse_port("sizeof_type: layouts are not ported yet")
  end
end
