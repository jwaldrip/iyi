  end
end

# Queries the code generator reads from a type (CONTRACT.md rows for types.cr).
# Each function is the hosted member of the same name in src/compiler/iyi/types.cr.
# Hosted methods reopen classes from other files, which iyi cannot do, so the
# port carries them as functions taking the receiver as their first argument.
pub class TypeQueries
  def self.pointer?(type : Type) : Bool
    type.is_a?(PointerInstanceType)
  end

  def self.proc?(type : Type) : Bool
    type.is_a?(ProcInstanceType)
  end

  # The port builds Void and NoReturn as NonGenericClassType (top_level.iyi), so
  # these match the built-in by its full name, as nil_type? does for Nil.
  def self.void?(type : Type) : Bool
    type.is_a?(VoidType) || type.full_name == "Void"
  end

  def self.no_return?(type : Type) : Bool
    type.is_a?(NoReturnType) || type.full_name == "NoReturn"
  end

  def self.virtual?(type : Type) : Bool
    type.is_a?(VirtualType)
  end

  def self.virtual_metaclass?(type : Type) : Bool
    type.is_a?(VirtualMetaclassType)
  end

  # Hosted metaclass?: a MetaclassType of any kind, or a virtual metaclass.
  # The generic instance metaclasses derive from MetaclassType here.
  def self.metaclass?(type : Type) : Bool
    type.is_a?(MetaclassType) || type.is_a?(VirtualMetaclassType)
  end

  # Hosted reference_like?: a single pointer represents the value. Nil and the
  # reference unions always do; a class does unless it is a struct; a virtual
  # type does unless its base is a struct. Primitive classes, procs and tuples
  # do not, even though some are classes in the port.
  def self.reference_like?(type : Type) : Bool
    if type.nil_type? || type.is_a?(NilableType) || type.is_a?(NilableReferenceUnionType) || type.is_a?(ReferenceUnionType)
      return true
    end
    if type.is_a?(NonGenericClassType) || type.is_a?(GenericClassType) || type.is_a?(GenericClassInstanceType) || type.is_a?(VirtualType)
      return !type.struct?
    end
    false
  end

  # Hosted subclasses: the direct subclasses of a class type, none otherwise.
  def self.subclasses(type : Type) : Array(Type)
    if type.is_a?(ClassType)
      return type.as(ClassType).subclasses
    end
    if type.is_a?(GenericClassInstanceType)
      return type.as(GenericClassInstanceType).subclasses
    end
    [] of Type
  end

  # Hosted all_subclasses: every descendant, depth first, direct ones in order.
  def self.all_subclasses(type : Type) : Array(Type)
    result = [] of Type
    append_subclasses(type, result)
    result
  end

  private def self.append_subclasses(type : Type, result : Array(Type)) : Nil
    subclasses(type).each do |sub|
      result << sub
      append_subclasses(sub, result)
    end
  end

  def self.leaf?(type : Type) : Bool
    subclasses(type).size == 0
  end

  # Hosted instance_type: the type a metaclass describes. Any other type is its own.
  def self.instance_type(type : Type) : Type
    if type.is_a?(VirtualMetaclassType)
      return type.as(VirtualMetaclassType).instance_type
    end
    if type.is_a?(MetaclassType)
      return type.as(MetaclassType).instance_type
    end
    type
  end

  # Hosted virtual_type!, named virtual_type_bang because iyi names have no `!`.
  # The virtual type over a class. The port does not cache it, so two calls give
  # equal but distinct objects.
  def self.virtual_type_bang(type : Type) : Type
    VirtualType.new(type.program, type)
  end

  # Hosted virtual_type: a class that is a leaf and not abstract stands for
  # itself; an abstract struct with subclasses is its virtual type; any other
  # struct stands for itself; any other class is its virtual type. Non-class
  # types stand for themselves.
  def self.virtual_type(type : Type) : Type
    if type.is_a?(ClassType)
      is_leaf = leaf?(type)
      is_abstract = type.abstract?
      is_struct = type.struct?
      return type if is_leaf && !is_abstract
      return virtual_type_bang(type) if is_struct && is_abstract && !is_leaf
      return type if is_struct
      return virtual_type_bang(type)
    end
    type
  end

  # Hosted splat_index: the position of a splatted type parameter in a generic
  # class or module, nil when there is none.
  def self.splat_index(type : Type) : Int32?
    if type.is_a?(GenericClassType)
      return type.as(GenericClassType).splat_index
    end
    if type.is_a?(GenericModuleType)
      return type.as(GenericModuleType).splat_index
    end
    nil
  end
end
