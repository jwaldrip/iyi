  getter rank : Int32
  getter kind : NumberKind
  getter signed : Bool

  def initialize(program : SemanticProgram, namespace : ModuleType?, name : String, superclass : Type?, bytes : Int32, @rank : Int32, @kind : NumberKind, @signed : Bool)
    super(program, namespace, name, superclass, bytes)
  end
end

