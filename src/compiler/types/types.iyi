module compiler/types/types

import compiler/foundation/errors::{refuse_port}
import compiler/foundation/location::{Location}
import compiler/syntax/ast::{ASTNode, Def, Generic, Path, Visibility}
import compiler/syntax/token::{NumberKind}
import compiler/semantic/top_level::{AliasType, ClassType, Const, EnumType, GenericClassType, GenericModuleType, GenericTraitType, ImplRecord, MetaclassType, MetaTypeVar, ModuleType, NamedType, NilType, NonGenericClassType, NoReturnType, SemanticProgram, TraitType, Type, TypeException, TypeParameterType, UnionType, VoidType}

pub class VirtualType < Type
  property base_type : Type
  @metaclass : VirtualMetaclassType?

  def initialize(program : SemanticProgram, @base_type : Type)
    super(program, nil, "#{@base_type.name}+")
    @metaclass = nil
  end

  def virtual? : Bool
    true
  end

  def full_name : String
    "#{@base_type.full_name}+"
  end

  def to_s : String
    full_name
  end

  def member_name : String
    @base_type.full_name
  end

  def devirtualize : Type
    return @base_type
  end

  def type_desc : String
    "virtual"
  end

  def struct? : Bool
    @base_type.struct?
  end

  def abstract? : Bool
    @base_type.abstract?
  end

  def leaf? : Bool
    false
  end

  def metaclass : VirtualMetaclassType
    if m = @metaclass
      m
    else
      m = VirtualMetaclassType.new(@program, self)
      @metaclass = m
      m
    end
  end

  def subtypes : Array(Type)
    result = [] of Type
    collect_subtypes(@base_type, result)
    result
  end

  private def collect_subtypes(type : Type, result : Array(Type)) : Nil
    unless type.abstract?
      result << type
    end
    if type.is_a?(ClassType)
      type.as(ClassType).subclasses.each do |sub|
        collect_subtypes(sub, result)
      end
    end
  end

  def subtype_of?(other : Type) : Bool
    return true if self == other
    if other.is_a?(VirtualType)
      return @base_type.subtype_of?(other.as(VirtualType).base_type)
    end
    @base_type.subtype_of?(other)
  end

  def implements?(other : Type) : Bool
    @base_type.implements?(other)
  end
end

pub class VirtualMetaclassType < Type
  getter instance_type : VirtualType

  def initialize(program : SemanticProgram, @instance_type : VirtualType)
    super(program, nil, "#{@instance_type.name}.class")
  end

  def full_name : String
    "#{@instance_type.full_name}.class"
  end

  def to_s : String
    full_name
  end

  def member_name : String
    "#{@instance_type.base_type.full_name}.class"
  end

  # Hosted types.cr:410-415, 3958-3959: the metaclass of the virtual root.
  def devirtualize : Type
    base = @instance_type.base_type
    if base.is_a?(ModuleType)
      return base.as(ModuleType).metaclass
    elsif base.is_a?(GenericClassInstanceType)
      return base.as(GenericClassInstanceType).metaclass
    end
    self
  end

  def subtype_of?(other : Type) : Bool
    devirtualize.subtype_of?(other)
  end

  def type_desc : String
    "virtual_metaclass"
  end

  def metaclass : ClassType
    @program.types["Class"].as(ClassType)
  end
end

pub abstract class GenericInstanceType < Type
  property generic_type : Type
  property type_vars : Hash(String, Type)
  property type_args : Array(Type)

  def initialize(program : SemanticProgram, @generic_type : Type, @type_vars : Hash(String, Type), @type_args : Array(Type) = [] of Type)
    super(program, @generic_type.namespace, @generic_type.name)
  end

  def generic_instance? : Bool
    true
  end

  def full_name : String
    args_strs = @type_args.map { |a| a.devirtualize.arg_full_name }
    "#{@generic_type.base_full_name}(#{args_strs.join(", ")})"
  end

  def to_s : String
    full_name
  end

  def type_desc : String
    "generic_instance"
  end
end

pub class GenericClassInstanceType < GenericInstanceType
  property superclass : Type?
  getter subclasses : Array(Type)
  getter included_modules : Array(Type)
  @metaclass : GenericClassInstanceMetaclassType?
  property virtual_type_cache : Type? = nil

  def register_subclass(sub : Type) : Nil
    @subclasses << sub
    @generic_type.register_subclass(sub)
    nil
  end

  def initialize(program : SemanticProgram, generic_type : Type, type_vars : Hash(String, Type), type_args : Array(Type), @superclass : Type? = nil)
    super(program, generic_type, type_vars, type_args)
    @subclasses = [] of Type
    @included_modules = [] of Type
    @metaclass = nil
    @instance_vars = Hash(String, MetaTypeVar).new
    @copied_from = Hash(String, MetaTypeVar).new
    if sc = @superclass
      if sc.is_a?(ClassType)
        sc.as(ClassType).subclasses << self
      elsif sc.is_a?(GenericClassInstanceType)
        sc.as(GenericClassInstanceType).subclasses << self
      end
    end
  end

  def class? : Bool
    !@generic_type.struct?
  end

  def struct? : Bool
    @generic_type.struct?
  end

  def type_desc : String
    struct? ? "struct" : "class"
  end

  def metaclass : GenericClassInstanceMetaclassType
    if m = @metaclass
      m
    else
      m = GenericClassInstanceMetaclassType.new(@program, self)
      @metaclass = m
      m
    end
  end

  def subtype_of?(other : Type) : Bool
    return true if self == other
    target = other.devirtualize
    return subtype_of?(target) unless target == other
    if other.is_a?(GenericClassInstanceType)
      other_gi = other.as(GenericClassInstanceType)
      if @generic_type == other_gi.generic_type
        if @type_args.size == other_gi.type_args.size
          i = 0
          while i < @type_args.size
            return false unless @type_args[i] == other_gi.type_args[i]
            i = i + 1
          end
          return true
        end
      end
    elsif other.is_a?(GenericClassType)
      return @generic_type == other
    end
    @included_modules.each do |inc|
      return true if inc.subtype_of?(other)
    end
    if sc = @superclass
      return sc.subtype_of?(other)
    end
    false
  end

  def implements?(other : Type) : Bool
    subtype_of?(other)
  end

  # The instance variables this instance holds: the generic type's own, each with its type
  # parameters replaced by this instance's arguments. The hosted instantiation copies them
  # (GenericClassType#instantiate) and again when the generic declares one later
  # (each_instantiated_type). Here each read takes the copy from the generic's current table,
  # so a later declaration reaches every existing instance without a push to each one.
  def instance_vars : Hash(String, MetaTypeVar)
    generic_type = @generic_type
    if generic_type.is_a?(ModuleType)
      generic_type.as(ModuleType).instance_vars.each do |name, source|
        unless (copied = @copied_from[name]?) && copied == source
          if source_type = source.var_type
            mv = MetaTypeVar.new(name, TypeQueries.replace_type_parameters(source_type, @type_vars))
            mv.owner = self
            @instance_vars[name] = mv
            @copied_from[name] = source
          end
        end
      end
    end
    @instance_vars
  end

  # The instance variables of this instance and of its superclass, as the hosted
  # all_instance_vars: the superclass's first, then its own.
  def all_instance_vars : Hash(String, MetaTypeVar)
    all = Hash(String, MetaTypeVar).new
    if sc = @superclass
      if sc.is_a?(ModuleType)
        sc.as(ModuleType).all_instance_vars.each do |k, v|
          all[k] = v
        end
      elsif sc.is_a?(GenericClassInstanceType)
        sc.as(GenericClassInstanceType).all_instance_vars.each do |k, v|
          all[k] = v
        end
      end
    end
    instance_vars.each do |k, v|
      all[k] = v
    end
    all
  end

  def lookup_instance_var?(var_name : String) : MetaTypeVar?
    all_instance_vars[var_name]?
  end
end

pub class GenericModuleInstanceType < GenericInstanceType
  @metaclass : GenericModuleInstanceMetaclassType?

  def initialize(program : SemanticProgram, generic_type : Type, type_vars : Hash(String, Type), type_args : Array(Type))
    super(program, generic_type, type_vars, type_args)
    @metaclass = nil
  end

  def module? : Bool
    true
  end

  def trait? : Bool
    @generic_type.trait?
  end

  def type_desc : String
    "module"
  end

  def metaclass : GenericModuleInstanceMetaclassType
    if m = @metaclass
      m
    else
      m = GenericModuleInstanceMetaclassType.new(@program, self)
      @metaclass = m
      m
    end
  end
end

pub class GenericClassInstanceMetaclassType < MetaclassType
  def initialize(program : SemanticProgram, instance_type : GenericClassInstanceType)
    super(program, instance_type.namespace, "#{instance_type.name}:Class", instance_type)
    # The hosted rule: an instance's metaclass is the generic type's metaclass, so the
    # generated `new` methods the generic class has (new.iyi) are found on Box(Int32).class,
    # and that metaclass walks on to the generic's superclass. MetaclassType gave it Class,
    # since a generic instance is not a ClassType.
    parents.clear
    parents << instance_type.generic_type.as(ModuleType).metaclass
  end

  def generic_instance_type : GenericClassInstanceType
    @instance_type.as(GenericClassInstanceType)
  end

  # The class methods of a generic instance are the generic class's own (hosted
  # `delegate defs, macros, to: generic_type`, types.cr 3400).
  def defs : Hash(String, Array(Def))
    generic_instance_type.generic_type.as(GenericClassType).metaclass.defs
  end

  def full_name : String
    "#{@instance_type.full_name}.class"
  end

  def to_s : String
    full_name
  end

  def type_desc : String
    "metaclass"
  end
end

pub class GenericModuleInstanceMetaclassType < MetaclassType
  def initialize(program : SemanticProgram, instance_type : GenericModuleInstanceType)
    super(program, instance_type.namespace, "#{instance_type.name}:Class", instance_type)
  end

  def generic_instance_type : GenericModuleInstanceType
    @instance_type.as(GenericModuleInstanceType)
  end

  def full_name : String
    "#{@instance_type.full_name}.class"
  end

  def to_s : String
    full_name
  end

  def type_desc : String
    "metaclass"
  end
end

pub class TupleInstanceType < GenericClassInstanceType
  getter tuple_types : Array(Type)

  def initialize(program : SemanticProgram, @tuple_types : Array(Type))
    super(program, program.types["Tuple"], Hash(String, Type).new, @tuple_types, program.struct_type)
    @struct = true
  end

  def full_name : String
    types_s = @tuple_types.map { |t| t.devirtualize.arg_full_name }
    "Tuple(#{types_s.join(", ")})"
  end

  def to_s : String
    full_name
  end

  def type_desc : String
    "struct"
  end

  def struct? : Bool
    true
  end

  def tuple? : Bool
    true
  end

  def size : Int32
    @tuple_types.size
  end

  def subtype_of?(other : Type) : Bool
    return true if self == other
    if other.is_a?(TupleInstanceType)
      ot = other.as(TupleInstanceType)
      return false unless @tuple_types.size == ot.tuple_types.size
      i = 0
      while i < @tuple_types.size
        return false unless @tuple_types[i].subtype_of?(ot.tuple_types[i])
        i = i + 1
      end
      return true
    end
    super
  end
end

pub class NamedArgumentType
  property name : String
  property type : Type

  def initialize(@name : String, @type : Type)
  end

  def to_s : String
    "#{@name}: #{@type.to_s}"
  end
end

pub class NamedTupleInstanceType < GenericClassInstanceType
  getter entries : Array(NamedArgumentType)

  def initialize(program : SemanticProgram, @entries : Array(NamedArgumentType))
    args = @entries.map(&.type)
    super(program, program.types["NamedTuple"], Hash(String, Type).new, args, program.struct_type)
    @struct = true
  end

  def full_name : String
    entries_s = @entries.map { |e| "#{e.name}: #{e.type.devirtualize.arg_full_name}" }
    "NamedTuple(#{entries_s.join(", ")})"
  end

  def to_s : String
    full_name
  end

  def type_desc : String
    "struct"
  end

  def struct? : Bool
    true
  end

  def named_tuple? : Bool
    true
  end

  def size : Int32
    @entries.size
  end

  def name_type(name : String) : Type?
    i = 0
    while i < @entries.size
      if @entries[i].name == name
        return @entries[i].type
      end
      i = i + 1
    end
    nil
  end

  def subtype_of?(other : Type) : Bool
    return true if self == other
    if other.is_a?(NamedTupleInstanceType)
      ot = other.as(NamedTupleInstanceType)
      return false unless @entries.size == ot.entries.size
      i = 0
      while i < @entries.size
        entry = @entries[i]
        other_type = ot.name_type(entry.name)
        return false if other_type.nil?
        return false unless entry.type.subtype_of?(other_type)
        i = i + 1
      end
      return true
    end
    super
  end
end

pub class ProcInstanceType < GenericClassInstanceType
  getter arg_types : Array(Type)
  getter return_type : Type

  def initialize(program : SemanticProgram, @arg_types : Array(Type), @return_type : Type)
    all_args = [] of Type
    @arg_types.each { |a| all_args << a }
    all_args << @return_type
    # Hosted ProcInstanceType#initialize (types.cr:2758-2765) binds the
    # splatted arguments as T and the result as R.
    vars = Hash(String, Type).new
    vars["T"] = TupleInstanceType.new(program, @arg_types)
    vars["R"] = @return_type
    super(program, program.types["Proc"], vars, all_args, program.struct_type)
    @struct = true
  end

  def full_name : String
    all_parts = [] of String
    @arg_types.each { |a| all_parts << a.devirtualize.full_name }
    all_parts << @return_type.devirtualize.full_name
    "Proc(#{all_parts.join(", ")})"
  end

  def to_s : String
    full_name
  end

  def type_desc : String
    "struct"
  end

  def struct? : Bool
    true
  end

  def proc? : Bool
    true
  end

  def subtype_of?(other : Type) : Bool
    return true if self == other
    if other.is_a?(ProcInstanceType)
      ot = other.as(ProcInstanceType)
      return false unless @arg_types.size == ot.arg_types.size
      i = 0
      while i < @arg_types.size
        return false unless ot.arg_types[i].subtype_of?(@arg_types[i])
        i = i + 1
      end
      return @return_type.subtype_of?(ot.return_type)
    end
    super
  end
end

pub class PointerInstanceType < GenericClassInstanceType
  getter element_type : Type

  def initialize(program : SemanticProgram, @element_type : Type)
    vars = Hash(String, Type).new
    vars["T"] = @element_type
    super(program, program.types["Pointer"], vars, [@element_type] of Type, program.struct_type)
    @struct = true
  end

  def full_name : String
    "Pointer(#{@element_type.full_name})"
  end

  def to_s : String
    full_name
  end

  def type_desc : String
    "struct"
  end

  def struct? : Bool
    true
  end
end

