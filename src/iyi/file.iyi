# Files — README "What is not here", the thing a language that cannot
# read a file is missing.
#
# Four methods, because that is what a program needs: read the whole file,
# write the whole file, ask whether it is there, delete it. Paths are NUL-terminated
# at the call because iyi's `String` is not, and the buffer dies with the
# call. Errors panic with the path in the message; there is nothing to
# rescue with, so the message is the whole diagnostic.

class File
  def self.read(path : String) : String
    fd = __iyi_open_read(c_path(path))
    raise "cannot read #{path}" if fd < 0

    chunk = 8192_u64
    buffer = Pointer(UInt8).malloc(chunk)
    filled = 0_i64
    capacity = chunk

    while true
      if filled.to_u64 == capacity
        capacity = capacity * 2_u64
        buffer = buffer.realloc(capacity)
      end

      count = __iyi_file_read(fd, (buffer + filled).as(Void*), capacity - filled.to_u64)
      break if count <= 0_i64
      filled = filled + count
    end

    __iyi_close(fd)
    String.new(filled.to_i) do |target|
      target.copy_from(buffer, filled.to_i)
    end
  end

  def self.write(path : String, contents : String) : Nil
    fd = __iyi_open_write(c_path(path))
    raise "cannot write #{path}" if fd < 0

    written = 0_i64
    total = contents.bytesize.to_i64
    bytes = contents.to_unsafe
    while written < total
      count = __iyi_file_write(fd, (bytes + written).as(Void*), (total - written).to_u64)
      raise "cannot write #{path}" if count <= 0_i64
      written = written + count
    end
    __iyi_close(fd)
  end

  def self.exists?(path : String) : Bool
    fd = __iyi_open_read(c_path(path))
    if fd < 0
      return false
    end
    __iyi_close(fd)
    true
  end

  def self.delete(path : String) : Nil
    raise "cannot delete #{path}" if __iyi_unlink(c_path(path)) < 0
  end

  # The kernel wants a NUL it can walk. iyi's strings do not carry one.
  private def self.c_path(path : String) : UInt8*
    n = path.bytesize
    buffer = Pointer(UInt8).malloc((n + 1).to_u64)
    buffer.copy_from(path.to_unsafe, n)
    buffer[n] = 0_u8
    buffer
  end
end
