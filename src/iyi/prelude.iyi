# iyi's prelude — SPEC.md, "0.1.0", item 3.
#
#   ./bin/crystal build --prelude=iyi/prelude program.iyi
#
# Not a standard library. The prelude an iyi program gets is deliberately the
# smallest thing that runs the samples, because while an iyi program requires
# Crystal's 107,719-line prelude the benchmark measures a workaround rather
# than the thesis: the front end spends 886 ms of its 901 ms analysing it, and
# `.iyimod` saves 15 ms of the remainder (SPEC.md IV.1f).
#
# **What is in here is decided by what a sample calls.** A method enters
# because an existing program needs it, never because it belongs in a standard
# library. The ceiling is 3,551 lines — the size of Crystal's own 0.1.0 core,
# measured in the same language family and for the same purpose.
#
# `primitives.cr` below it is the compiler's own: arithmetic, conversions,
# comparisons and `Pointer` are `@[Primitive]` definitions it emits
# instructions for, so they are not this file's to write.
require "primitives"

require "./macros"
require "./object"
require "./number"
require "./string"
require "./array"
require "./hash"

lib LibC
  fun write(fd : Int32, buf : Void*, count : UInt64) : Int64
  fun exit(status : Int32) : NoReturn
end

# The collector, the way Crystal's own 0.1.0 had it. Twelve lines of binding
# buys real collection, which is what lets the samples be read as programs
# rather than as demonstrations that happen to exit before it matters.
@[Link("gc")]
lib LibGC
  fun init = GC_init
  fun malloc = GC_malloc(size : UInt64) : Void*
  fun malloc_atomic = GC_malloc_atomic(size : UInt64) : Void*
  fun realloc = GC_realloc(pointer : Void*, size : UInt64) : Void*
end

# Codegen emits calls to these by name for every allocation, so they are not
# optional and their names are not ours to choose.
fun __crystal_malloc64(size : UInt64) : Void*
  LibGC.malloc(size)
end

fun __crystal_malloc_atomic64(size : UInt64) : Void*
  LibGC.malloc_atomic(size)
end

fun __crystal_realloc64(pointer : Void*, size : UInt64) : Void*
  LibGC.realloc(pointer, size)
end

# Codegen emits a call to this on every overflowing operation, so a program
# cannot link without it. It aborts rather than raising: 0.1.0's `raise` is a
# panic (SPEC.md III.1.4) and there is no unwinder under it.
# Every function with an `ensure` names a personality function, so a program
# with a `defer` in it does not link without this symbol. It is not reachable:
# reaching it would mean something is unwinding, and nothing here unwinds.
fun __crystal_personality
  print "iyi: __crystal_personality called, which cannot happen\n"
  LibC.exit(1)
end

# Reached from the same landing pad, for the same reason, and just as
# unreachable: `ensure` compiles a path that would ask the unwinder what was
# thrown, and nothing here throws.
fun __crystal_get_exception(exception : Void*) : UInt64
  print "iyi: __crystal_get_exception called, which cannot happen\n"
  LibC.exit(1)
  0_u64
end

# Codegen emits a call to this wherever a `rescue` would re-raise. Nothing in
# this prelude can reach it either — `raise` panics rather than unwinding —
# but a program with an `ensure` in it names the symbol.
@[Raises]
fun __crystal_raise(exception : Void*) : NoReturn
  print "iyi: __crystal_raise called, which cannot happen\n"
  LibC.exit(1)
end

fun __crystal_raise_overflow : NoReturn
  print "iyi: arithmetic overflow\n"
  LibC.exit(1)
end

struct Pointer(T)
  def [](offset : Int32) : T
    (self + offset.to_i64).value
  end

  def []=(offset : Int32, value : T) : T
    (self + offset.to_i64).value = value
  end

  # Bytes, not elements: every caller here is copying string contents.
  def copy_from(source : Pointer(T), count : Int32) : Nil
    index = 0
    while index < count
      self[index] = source[index]
      index = index + 1
    end
  end
end

# 0.1.0's `raise` is a panic — it prints and exits, and nothing catches it.
#
# SPEC.md III.1.4 says that is what the language wants, and the normalizer's
# `.or_panic` says so too: it lowers to `::raise` with a comment that a panic
# is the intent and a Crystal exception the stand-in. Nothing in the samples
# rescues, so the unwinder, the personality function and the exception
# hierarchy under Crystal's `raise` buy this release nothing.
def raise(message : String) : NoReturn
  print "iyi: panic: "
  print message
  print "\n"
  LibC.exit(1)
end

def print(text : String) : Nil
  LibC.write(1, text.to_unsafe.as(Void*), text.bytesize.to_u64)
end

def print(value) : Nil
  print value.to_s
end

def puts(text : String) : Nil
  print text
  print "\n"
end

def puts(value) : Nil
  puts value.to_s
end

lib LibCrystalMain
  @[Raises]
  fun __crystal_main(argc : Int32, argv : UInt8**)
end

fun main(argc : Int32, argv : UInt8**) : Int32
  LibGC.init
  LibCrystalMain.__crystal_main(argc, argv)
  0
end
