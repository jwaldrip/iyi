# Ranges — SPEC.md, "0.1.0", item 3.
#
# `1..10` is not syntax the prelude can decline: the compiler expands a range
# literal to `Range.new(from, to, exclusive)` (literal_expander.cr), and the
# type itself is predefined so the compiler can refer to it. What was missing
# was every method on it, so `(1..10).each` answered "wrong number of arguments
# for 'Range(B, E).new' (given 3, expected 0)" — a message about a constructor
# nobody wrote, for the second loop anybody writes.
#
# What is here is what `samples/iyi/basics.iyi` calls and no more. There is no
# `Enumerable` on it, no `step`, no reverse iteration: a range in this prelude
# counts up by one and stops.
struct Range(B, E)
  getter begin : B
  getter end : E

  def initialize(@begin : B, @end : E, @exclusive : Bool)
  end

  # `1...10` excludes its end, `1..10` includes it.
  def exclusive? : Bool
    @exclusive
  end

  def each(& : B -> Nil) : Nil
    value = @begin
    if @exclusive
      while value < @end
        yield value
        value = value + 1
      end
    else
      while value <= @end
        yield value
        value = value + 1
      end
    end
  end

  def size : Int32
    count = 0
    each { |_| count = count + 1 }
    count
  end

  def to_a : Array(B)
    result = Array(B).new(size)
    each { |value| result << value }
    result
  end
end
