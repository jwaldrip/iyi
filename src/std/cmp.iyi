# Cmp, the comparison trait hierarchy.
#
# Crystal's Comparable mixin is ported as Cmp in std/traits, where it lives
# alongside Num and Hashable as the foundational scalar trait hierarchy.
#
# We keep Cmp in std/traits rather than defining a separate trait in std/cmp
# because in iyi, trait supertraits require separate impl blocks for each level.
# Having both Cmp and Comparable would force every orderable type to implement
# two traits. Furthermore, Enumerable's constraints already lean on where Elem : Cmp,
# and module exports in iyi cannot re-export imported traits via using.
# Therefore, std/traits::Cmp is the single obvious home for comparison.
#
# This module provides standalone comparison helper functions for values
# implementing Cmp.

module std/cmp

import std/traits

# Returns the lesser of a and b.
pub def min(a : T, b : T) : T forall T : Std::Traits::Cmp
  a < b ? a : b
end

# Returns the greater of a and b.
pub def max(a : T, b : T) : T forall T : Std::Traits::Cmp
  a > b ? a : b
end

# Clamps val between min_val and max_val.
pub def clamp(val : T, min_val : T, max_val : T) : T forall T : Std::Traits::Cmp
  val.clamp(min_val, max_val)
end

# Clamps val within range.
pub def clamp(val : T, range : Range) : T forall T : Std::Traits::Cmp
  val.clamp(range)
end
