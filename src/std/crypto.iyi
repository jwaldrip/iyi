  def initialize(@rounds = DEFAULT_ROUNDS)
    @p = Pointer(UInt32).malloc(18_u64)
    @s = Pointer(UInt32).malloc(1024_u64)
    i = 0
    while i < 18
      @p[i] = P_INIT[i]
      i = i + 1
    end
    i = 0
    while i < 1024
      @s[i] = S_INIT[i]
      i = i + 1
    end
    @s1 = @s + 256
    @s2 = @s + 512
    @s3 = @s + 768
  end

  def expand_key(key : Bytes) : Nil
    raise "Blowfish: key cannot be empty" if key.empty?
    pos = 0
    i = 0
    while i < 18
      word = 0_u32
      j = 0
      while j < 4
        word = (word.unsafe_shl(8_u32)) | key[pos].to_u32
        pos = (pos + 1) % key.size
        j = j + 1
      end
      @p[i] = @p[i] ^ word
      i = i + 1
    end

    l = 0_u32
    r = 0_u32
    i = 0
    while i < 18
      l, r = encrypt_pair(l, r)
      @p[i] = l
      @p[i + 1] = r
      i = i + 2
    end

    i = 0
    while i < 1024
      l, r = encrypt_pair(l, r)
      @s[i] = l
      @s[i + 1] = r
      i = i + 2
    end
  end

  def encrypt_pair(l : UInt32, r : UInt32) : Tuple(UInt32, UInt32)
    cur_l = l
    cur_r = r
    i = 0
    while i < @rounds
      cur_l = cur_l ^ @p[i]
      cur_r = cur_r ^ f(cur_l)
      temp = cur_l
      cur_l = cur_r
      cur_r = temp
      i = i + 1
    end
    temp = cur_l
    cur_l = cur_r
    cur_r = temp

    cur_r = cur_r ^ @p[@rounds]
    cur_l = cur_l ^ @p[@rounds + 1]

    {cur_l, cur_r}
  end

  def decrypt_pair(l : UInt32, r : UInt32) : Tuple(UInt32, UInt32)
    cur_l = l
    cur_r = r
    i = @rounds + 1
    while i >= 2
      cur_l = cur_l ^ @p[i]
      cur_r = cur_r ^ f(cur_l)
      temp = cur_l
      cur_l = cur_r
      cur_r = temp
      i = i - 1
    end
    temp = cur_l
    cur_l = cur_r
    cur_r = temp

    cur_r = cur_r ^ @p[1]
    cur_l = cur_l ^ @p[0]

    {cur_l, cur_r}
  end

  private def f(x : UInt32) : UInt32
    d = (x & 0xff_u32).to_i32
    c = ((x.unsafe_shr(8_u32)) & 0xff_u32).to_i32
    b = ((x.unsafe_shr(16_u32)) & 0xff_u32).to_i32
    a = ((x.unsafe_shr(24_u32)) & 0xff_u32).to_i32
    ((@s[a] &+ @s1[b]) ^ @s2[c]) &+ @s3[d]
  end
end

module BcryptBase64
  ALPHABET = "./ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"

  def self.encode(d : Bytes, len : Int32) : String
    off = 0
    chars = ALPHABET.to_unsafe

    # Max output length
    out_cap = ((len + 2) // 3) * 4 + 4
    buf = Pointer(UInt8).malloc(out_cap.to_u64)
    out_pos = 0

    while off < len
      c1 = d[off].to_i32
      off = off + 1
      buf[out_pos] = chars[(c1 >> 2) & 0x3f]
      out_pos = out_pos + 1
      c1 = (c1 & 0x03) << 4

      if off >= len
        buf[out_pos] = chars[c1 & 0x3f]
        out_pos = out_pos + 1
        break
      end

      c2 = d[off].to_i32
      off = off + 1
      c1 = c1 | ((c2 >> 4) & 0x0f)
      buf[out_pos] = chars[c1 & 0x3f]
      out_pos = out_pos + 1
      c1 = (c2 & 0x0f) << 2

      if off >= len
        buf[out_pos] = chars[c1 & 0x3f]
        out_pos = out_pos + 1
        break
      end

      c2 = d[off].to_i32
      off = off + 1
      c1 = c1 | ((c2 >> 6) & 0x03)
      buf[out_pos] = chars[c1 & 0x3f]
      out_pos = out_pos + 1
      buf[out_pos] = chars[c2 & 0x3f]
      out_pos = out_pos + 1
    end

    String.new(out_pos) do |target|
      target.copy_from(buf, out_pos)
    end
  end

  private def self.char64(c : UInt8) : Int32
    if c == 46_u8 # '.'
      0
    elsif c == 47_u8 # '/'
      1
    elsif c >= 65_u8 && c <= 90_u8 # 'A'..'Z'
      (c - 65_u8).to_i32 + 2
    elsif c >= 97_u8 && c <= 122_u8 # 'a'..'z'
      (c - 97_u8).to_i32 + 28
    elsif c >= 48_u8 && c <= 57_u8 # '0'..'9'
      (c - 48_u8).to_i32 + 54
    else
      -1
    end
  end

  def self.decode(string : String, maxolen : Int32) : Bytes
    off = 0
    slen = string.bytesize
    olen = 0
    str = Bytes.new(maxolen)
    ptr = string.to_unsafe

    while off < slen - 1 && olen < maxolen
      c1 = char64(ptr[off])
      c2 = char64(ptr[off + 1])
      break if c1 == -1 || c2 == -1
      off = off + 2

      str[olen] = (((c1 << 2) | ((c2 & 0x30) >> 4)) & 0xff).to_u8
      olen = olen + 1
      break if olen >= maxolen || off >= slen

      c3 = char64(ptr[off])
      off = off + 1
      break if c3 == -1

      str[olen] = ((((c2 & 0x0f) << 4) | ((c3 & 0x3c) >> 2)) & 0xff).to_u8
      olen = olen + 1
      break if olen >= maxolen || off >= slen

      c4 = char64(ptr[off])
      off = off + 1
      break if c4 == -1

      str[olen] = ((((c3 & 0x03) << 6) | c4) & 0xff).to_u8
      olen = olen + 1
    end
    str
  end
end

class BcryptBlowfish < Blowfish
  def enhance_key_schedule(data : Bytes, key : Bytes, cost : Int32) : Nil
    enhance_key_schedule(data, key)
    count = (1_u32.unsafe_shl(cost.to_u32))
    iter = 0_u32
    while iter < count
      expand_key(key)
      expand_key(data)
      iter = iter + 1_u32
    end
  end

  def enhance_key_schedule(data : Bytes, key : Bytes) : Nil
    pos = 0
    i = 0
    while i < 18
      word = 0_u32
      j = 0
      while j < 4
        word = (word.unsafe_shl(8_u32)) | key[pos].to_u32
        pos = (pos + 1) % key.size
        j = j + 1
      end
      @p[i] = @p[i] ^ word
      i = i + 1
    end

    l = 0_u32
    r = 0_u32
    pos = 0
    i = 0
    while i < 18
      w1 = 0_u32
      j = 0
      while j < 4
        w1 = (w1.unsafe_shl(8_u32)) | data[pos].to_u32
        pos = (pos + 1) % data.size
        j = j + 1
      end
      l = l ^ w1

      w2 = 0_u32
      j = 0
      while j < 4
        w2 = (w2.unsafe_shl(8_u32)) | data[pos].to_u32
        pos = (pos + 1) % data.size
        j = j + 1
      end
      r = r ^ w2

      pair = encrypt_pair(l, r)
      l = pair[0]
      r = pair[1]
      @p[i] = l
      @p[i + 1] = r
      i = i + 2
    end

    i = 0
    while i < 1024
      w1 = 0_u32
      j = 0
      while j < 4
        w1 = (w1.unsafe_shl(8_u32)) | data[pos].to_u32
        pos = (pos + 1) % data.size
        j = j + 1
      end
      l = l ^ w1

      w2 = 0_u32
      j = 0
      while j < 4
        w2 = (w2.unsafe_shl(8_u32)) | data[pos].to_u32
        pos = (pos + 1) % data.size
        j = j + 1
      end
      r = r ^ w2

      pair = encrypt_pair(l, r)
      l = pair[0]
      r = pair[1]
      @s[i] = l
      @s[i + 1] = r
      i = i + 2
    end
  end
end

pub class Bcrypt
  class Error < Exception
    getter message : String

    def initialize(@message : String)
    end
  end

  DEFAULT_COST   = 10
  COST_RANGE     = 4..31
  PASSWORD_RANGE = 0..72
  SALT_SIZE      = 16

  CIPHER_TEXT = [
    0x4f727068_u32, 0x65616e42_u32, 0x65686f6c_u32,
    0x64657253_u32, 0x63727944_u32, 0x6f756274_u32,
  ]

  getter cost : Int32
  getter salt : Bytes
  getter password : Bytes
  getter digest : Bytes

  def initialize(password_bytes : Bytes, @salt : Bytes, @cost : Int32 = DEFAULT_COST)
    @password = password_bytes
    @digest = hash_password
  end

  def self.new(password : String, salt_b64 : String, cost : Int32 = DEFAULT_COST) : Bcrypt
    pw_bytes = Bytes.new(password.bytesize + 1)
    i = 0
    while i < password.bytesize
      pw_bytes[i] = password.to_unsafe[i]
      i = i + 1
    end
    pw_bytes[password.bytesize] = 0_u8
    salt_bytes = BcryptBase64.decode(salt_b64, SALT_SIZE)
    new(pw_bytes, salt_bytes, cost)
  end

  private def hash_password : Bytes
    bf = BcryptBlowfish.new(16)
    bf.enhance_key_schedule(salt, password, cost)

    cdata = Pointer(UInt32).malloc(6_u64)
    i = 0
    while i < 6
      cdata[i] = CIPHER_TEXT[i]
      i = i + 1
    end

    i = 0
    while i < 6
      round = 0
      while round < 64
        pair = bf.encrypt_pair(cdata[i], cdata[i + 1])
        cdata[i] = pair[0]
        cdata[i + 1] = pair[1]
        round = round + 1
      end
      i = i + 2
    end

    ret = Bytes.new(24)
    j = 0
    i = 0
    while i < 6
      ret[j] = ((cdata[i].unsafe_shr(24_u32)) & 0xff_u32).to_u8
      ret[j + 1] = ((cdata[i].unsafe_shr(16_u32)) & 0xff_u32).to_u8
      ret[j + 2] = ((cdata[i].unsafe_shr(8_u32)) & 0xff_u32).to_u8
      ret[j + 3] = (cdata[i] & 0xff_u32).to_u8
      j = j + 4
      i = i + 1
    end
    ret
  end

  def to_s : String
    salt64 = BcryptBase64.encode(salt, salt.size)
    digest64 = BcryptBase64.encode(digest, digest.size - 1)
    cost_str = cost < 10 ? "0" + cost.to_s : cost.to_s
    "$2a$" + cost_str + "$" + salt64 + digest64
  end
end

pub class Password
  getter version : String
  getter cost : Int32
  getter salt : String
  getter digest : String

  def initialize(@raw_hash : String)
    parts = @raw_hash.split('$')
    raise "Invalid hash string" unless parts.size == 4
    @version = parts[1]
    @cost = parts[2].to_i
    @salt = parts[3][0, 22]
    @digest = parts[3][22, parts[3].bytesize - 22]
  end

  def verify(password : String) : Bool
    hashed = Bcrypt.new(password, @salt, @cost)
    hashed_digest = BcryptBase64.encode(hashed.digest, hashed.digest.size - 1)
    @digest == hashed_digest
  end

  def to_s : String
    @raw_hash
  end
end

alias ::Crypto::Blowfish = Std::Crypto::Blowfish
alias ::Crypto::Bcrypt = Std::Crypto::Bcrypt
alias ::Crypto::Bcrypt::Password = Std::Crypto::Password
alias ::Crypto::HMAC = Std::Crypto::HMAC
alias ::Crypto::HKDF = Std::Crypto::HKDF
