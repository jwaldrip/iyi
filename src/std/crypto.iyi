    0x47_u8, 0xf1_u8, 0x1a_u8, 0x71_u8, 0x1d_u8, 0x29_u8, 0xc5_u8, 0x89_u8, 0x6f_u8, 0xb7_u8, 0x62_u8, 0x0e_u8, 0xaa_u8, 0x18_u8, 0xbe_u8, 0x1b_u8,
    0xfc_u8, 0x56_u8, 0x3e_u8, 0x4b_u8, 0xc6_u8, 0xd2_u8, 0x79_u8, 0x20_u8, 0x9a_u8, 0xdb_u8, 0xc0_u8, 0xfe_u8, 0x78_u8, 0xcd_u8, 0x5a_u8, 0xf4_u8,
    0x1f_u8, 0xdd_u8, 0xa8_u8, 0x33_u8, 0x88_u8, 0x07_u8, 0xc7_u8, 0x31_u8, 0xb1_u8, 0x12_u8, 0x10_u8, 0x59_u8, 0x27_u8, 0x80_u8, 0xec_u8, 0x5f_u8,
    0x60_u8, 0x51_u8, 0x7f_u8, 0xa9_u8, 0x19_u8, 0xb5_u8, 0x4a_u8, 0x0d_u8, 0x2d_u8, 0xe5_u8, 0x7a_u8, 0x9f_u8, 0x93_u8, 0xc9_u8, 0x9c_u8, 0xef_u8,
    0xa0_u8, 0xe0_u8, 0x3b_u8, 0x4d_u8, 0xae_u8, 0x2a_u8, 0xf5_u8, 0xb0_u8, 0xc8_u8, 0xeb_u8, 0xbb_u8, 0x3c_u8, 0x83_u8, 0x53_u8, 0x99_u8, 0x61_u8,
    0x17_u8, 0x2b_u8, 0x04_u8, 0x7e_u8, 0xba_u8, 0x77_u8, 0xd6_u8, 0x26_u8, 0xe1_u8, 0x69_u8, 0x14_u8, 0x63_u8, 0x55_u8, 0x21_u8, 0x0c_u8, 0x7d_u8,
  ]

  def self.mul(a : UInt8, b : Int32) : UInt8
    res = 0_u8
    cur = a
    val = b
    while val > 0
      res = res ^ cur if (val & 1) != 0
      cur = xtime(cur)
      val = val >> 1
    end
    res
  end

  def self.decrypt_block(nr : Int32, rk : Pointer(UInt64), input : Pointer(UInt8), output : Pointer(UInt8)) : Nil
    state = Pointer(UInt8).malloc(16_u64)
    i = 0
    while i < 16
      state[i] = input[i]
      i = i + 1
    end

    # AddRoundKey nr
    c = 0
    while c < 4
      k = rk[4 * nr + c]
      state[4 * c] = state[4 * c] ^ ((k.unsafe_shr(24_u64)) & 0xff_u64).to_u8
      state[4 * c + 1] = state[4 * c + 1] ^ ((k.unsafe_shr(16_u64)) & 0xff_u64).to_u8
      state[4 * c + 2] = state[4 * c + 2] ^ ((k.unsafe_shr(8_u64)) & 0xff_u64).to_u8
      state[4 * c + 3] = state[4 * c + 3] ^ (k & 0xff_u64).to_u8
      c = c + 1
    end

    r = nr - 1
    while r >= 1
      # InvShiftRows
      t1 = state[13]; t5 = state[1]; t9 = state[5]; t13 = state[9]
      state[1] = t1; state[5] = t5; state[9] = t9; state[13] = t13
      t2 = state[10]; t6 = state[14]; t10 = state[2]; t14 = state[6]
      state[2] = t2; state[6] = t6; state[10] = t10; state[14] = t14
      t3 = state[7]; t7 = state[11]; t11 = state[15]; t15 = state[3]
      state[3] = t3; state[7] = t7; state[11] = t11; state[15] = t15

      # InvSubBytes
      i = 0
      while i < 16
        state[i] = INV_SBOX[state[i].to_i32]
        i = i + 1
      end

      # AddRoundKey r
      c = 0
      while c < 4
        k = rk[4 * r + c]
        state[4 * c] = state[4 * c] ^ ((k.unsafe_shr(24_u64)) & 0xff_u64).to_u8
        state[4 * c + 1] = state[4 * c + 1] ^ ((k.unsafe_shr(16_u64)) & 0xff_u64).to_u8
        state[4 * c + 2] = state[4 * c + 2] ^ ((k.unsafe_shr(8_u64)) & 0xff_u64).to_u8
        state[4 * c + 3] = state[4 * c + 3] ^ (k & 0xff_u64).to_u8
        c = c + 1
      end

      # InvMixColumns
      c = 0
      while c < 4
        s0 = state[4 * c]
        s1 = state[4 * c + 1]
        s2 = state[4 * c + 2]
        s3 = state[4 * c + 3]
        state[4 * c] = mul(s0, 0x0e) ^ mul(s1, 0x0b) ^ mul(s2, 0x0d) ^ mul(s3, 0x09)
        state[4 * c + 1] = mul(s0, 0x09) ^ mul(s1, 0x0e) ^ mul(s2, 0x0b) ^ mul(s3, 0x0d)
        state[4 * c + 2] = mul(s0, 0x0d) ^ mul(s1, 0x09) ^ mul(s2, 0x0e) ^ mul(s3, 0x0b)
        state[4 * c + 3] = mul(s0, 0x0b) ^ mul(s1, 0x0d) ^ mul(s2, 0x09) ^ mul(s3, 0x0e)
        c = c + 1
      end

      r = r - 1
    end

    # Final round
    # InvShiftRows
    t1 = state[13]; t5 = state[1]; t9 = state[5]; t13 = state[9]
    state[1] = t1; state[5] = t5; state[9] = t9; state[13] = t13
    t2 = state[10]; t6 = state[14]; t10 = state[2]; t14 = state[6]
    state[2] = t2; state[6] = t6; state[10] = t10; state[14] = t14
    t3 = state[7]; t7 = state[11]; t11 = state[15]; t15 = state[3]
    state[3] = t3; state[7] = t7; state[11] = t11; state[15] = t15

    # InvSubBytes
    i = 0
    while i < 16
      state[i] = INV_SBOX[state[i].to_i32]
      i = i + 1
    end

    # AddRoundKey 0
    c = 0
    while c < 4
      k = rk[c]
      output[4 * c] = state[4 * c] ^ ((k.unsafe_shr(24_u64)) & 0xff_u64).to_u8
      output[4 * c + 1] = state[4 * c + 1] ^ ((k.unsafe_shr(16_u64)) & 0xff_u64).to_u8
      output[4 * c + 2] = state[4 * c + 2] ^ ((k.unsafe_shr(8_u64)) & 0xff_u64).to_u8
      output[4 * c + 3] = state[4 * c + 3] ^ (k & 0xff_u64).to_u8
      c = c + 1
    end
  end

  # GHASH multiplication in GF(2^128)
  def self.ghash_mult(x : Pointer(UInt8), y_hi : UInt64, y_lo : UInt64, out_hi : Pointer(UInt64), out_lo : Pointer(UInt64)) : Nil
    v_hi = y_hi
    v_lo = y_lo
    z_hi = 0_u64
    z_lo = 0_u64

    i = 0
    while i < 16
      byte = x[i].to_i32
      bit = 7
      while bit >= 0
        if ((byte >> bit) & 1) != 0
          z_hi = z_hi ^ v_hi
          z_lo = z_lo ^ v_lo
        end
        low_bit = v_lo & 1_u64
        carry = (v_hi & 1_u64).unsafe_shl(63_u64)
        v_lo = (v_lo.unsafe_shr(1_u64)) | carry
        v_hi = v_hi.unsafe_shr(1_u64)
        if low_bit != 0_u64
          v_hi = v_hi ^ 0xe100000000000000_u64
        end
        bit = bit - 1
      end
      i = i + 1
    end

    out_hi[0] = z_hi
    out_lo[0] = z_lo
  end

  def self.ghash(h_bytes : Bytes, aad : Bytes, ct : Bytes) : Bytes
    h_hi = (h_bytes[0].to_u64.unsafe_shl(56_u64)) | (h_bytes[1].to_u64.unsafe_shl(48_u64)) | (h_bytes[2].to_u64.unsafe_shl(40_u64)) | (h_bytes[3].to_u64.unsafe_shl(32_u64)) |
           (h_bytes[4].to_u64.unsafe_shl(24_u64)) | (h_bytes[5].to_u64.unsafe_shl(16_u64)) | (h_bytes[6].to_u64.unsafe_shl(8_u64)) | h_bytes[7].to_u64
    h_lo = (h_bytes[8].to_u64.unsafe_shl(56_u64)) | (h_bytes[9].to_u64.unsafe_shl(48_u64)) | (h_bytes[10].to_u64.unsafe_shl(40_u64)) | (h_bytes[11].to_u64.unsafe_shl(32_u64)) |
           (h_bytes[12].to_u64.unsafe_shl(24_u64)) | (h_bytes[13].to_u64.unsafe_shl(16_u64)) | (h_bytes[14].to_u64.unsafe_shl(8_u64)) | h_bytes[15].to_u64

    y_buf = Pointer(UInt8).malloc(16_u64)
    i = 0
    while i < 16
      y_buf[i] = 0_u8; i = i + 1
    end

    block = Pointer(UInt8).malloc(16_u64)
    res_hi = Pointer(UInt64).malloc(1_u64)
    res_lo = Pointer(UInt64).malloc(1_u64)

    # Process AAD
    offset = 0
    remaining = aad.size
    while remaining > 0
      chunk = remaining > 16 ? 16 : remaining
      i = 0
      while i < chunk
        block[i] = y_buf[i] ^ aad[offset + i]; i = i + 1
      end
      while i < 16
        block[i] = y_buf[i]; i = i + 1
      end
      ghash_mult(block, h_hi, h_lo, res_hi, res_lo)
      # Put into y_buf
      j = 0
      while j < 8
        y_buf[j] = ((res_hi[0].unsafe_shr(((7 - j) * 8).to_u64)) & 0xff_u64).to_u8
        y_buf[8 + j] = ((res_lo[0].unsafe_shr(((7 - j) * 8).to_u64)) & 0xff_u64).to_u8
        j = j + 1
      end
      offset = offset + chunk
      remaining = remaining - chunk
    end

    # Process CT
    offset = 0
    remaining = ct.size
    while remaining > 0
      chunk = remaining > 16 ? 16 : remaining
      i = 0
      while i < chunk
        block[i] = y_buf[i] ^ ct[offset + i]; i = i + 1
      end
      while i < 16
        block[i] = y_buf[i]; i = i + 1
      end
      ghash_mult(block, h_hi, h_lo, res_hi, res_lo)
      j = 0
      while j < 8
        y_buf[j] = ((res_hi[0].unsafe_shr(((7 - j) * 8).to_u64)) & 0xff_u64).to_u8
        y_buf[8 + j] = ((res_lo[0].unsafe_shr(((7 - j) * 8).to_u64)) & 0xff_u64).to_u8
        j = j + 1
      end
      offset = offset + chunk
      remaining = remaining - chunk
    end

    # Process lengths: len(AAD) in bits as 64-bit BE || len(CT) in bits as 64-bit BE
    aad_bits = aad.size.to_u64.unsafe_shl(3_u64)
    ct_bits = ct.size.to_u64.unsafe_shl(3_u64)
    j = 0
    while j < 8
      block[j] = y_buf[j] ^ (((aad_bits.unsafe_shr(((7 - j) * 8).to_u64)) & 0xff_u64).to_u8)
      block[8 + j] = y_buf[8 + j] ^ (((ct_bits.unsafe_shr(((7 - j) * 8).to_u64)) & 0xff_u64).to_u8)
      j = j + 1
    end
    ghash_mult(block, h_hi, h_lo, res_hi, res_lo)
    out = Bytes.new(16)
    ptr = out.to_unsafe
    j = 0
    while j < 8
      ptr[j] = ((res_hi[0].unsafe_shr(((7 - j) * 8).to_u64)) & 0xff_u64).to_u8
      ptr[8 + j] = ((res_lo[0].unsafe_shr(((7 - j) * 8).to_u64)) & 0xff_u64).to_u8
      j = j + 1
    end
    out
  end

  # Core AES-GCM engine
  def self.gcm_encrypt_detached(key : Bytes, nonce : Bytes, plaintext : Bytes, ad : Bytes) : {Bytes, Bytes}
    raise "AES-GCM: key must be 16 or 32 bytes" if key.size != 16 && key.size != 32
    raise "AES-GCM: nonce must be 12 bytes" if nonce.size != 12

    nr, rk = expand_key(key)

    # Compute H = AES_K(0^16)
    zero_block = Pointer(UInt8).malloc(16_u64)
    h_ptr = Pointer(UInt8).malloc(16_u64)
    i = 0; while i < 16
      zero_block[i] = 0_u8; i = i + 1
    end
    encrypt_block(nr, rk, zero_block, h_ptr)
    h_bytes = Bytes.new(h_ptr, 16)

    # J0 = nonce || 0x00000001
    j0_ptr = Pointer(UInt8).malloc(16_u64)
    i = 0; while i < 12
      j0_ptr[i] = nonce[i]; i = i + 1
    end
    j0_ptr[12] = 0_u8; j0_ptr[13] = 0_u8; j0_ptr[14] = 0_u8; j0_ptr[15] = 1_u8

    # CTR encryption of plaintext with J1, J2, ...
    ciphertext = Bytes.new(plaintext.size)
    ct_ptr = ciphertext.to_unsafe
    cb = Pointer(UInt8).malloc(16_u64)
    ks = Pointer(UInt8).malloc(16_u64)
    i = 0; while i < 12
      cb[i] = nonce[i]; i = i + 1
    end

    num_blocks = (plaintext.size + 15) // 16
    blk = 0
    while blk < num_blocks
      ctr_val = (blk + 2).to_u64
      cb[12] = ((ctr_val.unsafe_shr(24_u64)) & 0xff_u64).to_u8
      cb[13] = ((ctr_val.unsafe_shr(16_u64)) & 0xff_u64).to_u8
      cb[14] = ((ctr_val.unsafe_shr(8_u64)) & 0xff_u64).to_u8
      cb[15] = (ctr_val & 0xff_u64).to_u8
      encrypt_block(nr, rk, cb, ks)

      chunk = plaintext.size - blk * 16
      chunk = 16 if chunk > 16
      j = 0
      while j < chunk
        ct_ptr[blk * 16 + j] = plaintext[blk * 16 + j] ^ ks[j]
        j = j + 1
      end
      blk = blk + 1
    end

    # S = GHASH(H, AAD, CT)
    s = ghash(h_bytes, ad, ciphertext)

    # Tag = S ^ AES_K(J0)
    e_j0 = Pointer(UInt8).malloc(16_u64)
    encrypt_block(nr, rk, j0_ptr, e_j0)
    tag = Bytes.new(16)
    t_ptr = tag.to_unsafe
    i = 0
    while i < 16
      t_ptr[i] = s[i] ^ e_j0[i]
      i = i + 1
    end

    {ciphertext, tag}
  end

  def self.gcm_decrypt_detached(key : Bytes, nonce : Bytes, ciphertext : Bytes, tag : Bytes, ad : Bytes) : Bytes?
    raise "AES-GCM: key must be 16 or 32 bytes" if key.size != 16 && key.size != 32
    raise "AES-GCM: nonce must be 12 bytes" if nonce.size != 12
    return nil if tag.size != 16

    nr, rk = expand_key(key)

    # Compute H = AES_K(0^16)
    zero_block = Pointer(UInt8).malloc(16_u64)
    h_ptr = Pointer(UInt8).malloc(16_u64)
    i = 0; while i < 16
      zero_block[i] = 0_u8; i = i + 1
    end
    encrypt_block(nr, rk, zero_block, h_ptr)
    h_bytes = Bytes.new(h_ptr, 16)

    # S = GHASH(H, AAD, CT)
    s = ghash(h_bytes, ad, ciphertext)

    # Expected Tag = S ^ AES_K(J0)
    j0_ptr = Pointer(UInt8).malloc(16_u64)
    i = 0; while i < 12
      j0_ptr[i] = nonce[i]; i = i + 1
    end
    j0_ptr[12] = 0_u8; j0_ptr[13] = 0_u8; j0_ptr[14] = 0_u8; j0_ptr[15] = 1_u8
    e_j0 = Pointer(UInt8).malloc(16_u64)
    encrypt_block(nr, rk, j0_ptr, e_j0)

    expected_tag = Bytes.new(16)
    t_ptr = expected_tag.to_unsafe
    i = 0
    while i < 16
      t_ptr[i] = s[i] ^ e_j0[i]
      i = i + 1
    end

    # Constant-time comparison
    return nil unless Std::Crypto.constant_time_compare(tag, expected_tag)

    # Decrypt ciphertext
    plaintext = Bytes.new(ciphertext.size)
    pt_ptr = plaintext.to_unsafe
    cb = Pointer(UInt8).malloc(16_u64)
    ks = Pointer(UInt8).malloc(16_u64)
    i = 0; while i < 12
      cb[i] = nonce[i]; i = i + 1
    end

    num_blocks = (ciphertext.size + 15) // 16
    blk = 0
    while blk < num_blocks
      ctr_val = (blk + 2).to_u64
      cb[12] = ((ctr_val.unsafe_shr(24_u64)) & 0xff_u64).to_u8
      cb[13] = ((ctr_val.unsafe_shr(16_u64)) & 0xff_u64).to_u8
      cb[14] = ((ctr_val.unsafe_shr(8_u64)) & 0xff_u64).to_u8
      cb[15] = (ctr_val & 0xff_u64).to_u8
      encrypt_block(nr, rk, cb, ks)

      chunk = ciphertext.size - blk * 16
      chunk = 16 if chunk > 16
      j = 0
      while j < chunk
        pt_ptr[blk * 16 + j] = ciphertext[blk * 16 + j] ^ ks[j]
        j = j + 1
      end
      blk = blk + 1
    end

    plaintext
  end
end

# -----------------------------------------------------------------------------
# AES-128-GCM and AES-256-GCM AEAD Ciphers
# -----------------------------------------------------------------------------
pub class AES128GCM
  def self.encrypt_detached(key : Bytes, nonce : Bytes, plaintext : Bytes, ad : Bytes = Bytes.empty) : {Bytes, Bytes}
    raise "AES128GCM: key must be 16 bytes" if key.size != 16
    AES.gcm_encrypt_detached(key, nonce, plaintext, ad)
  end

  def self.encrypt(key : Bytes, nonce : Bytes, plaintext : Bytes, ad : Bytes = Bytes.empty) : Bytes
    ct, tag = encrypt_detached(key, nonce, plaintext, ad)
    out = Bytes.new(ct.size + 16)
    i = 0; while i < ct.size
      out[i] = ct[i]; i = i + 1
    end
    i = 0; while i < 16
      out[ct.size + i] = tag[i]; i = i + 1
    end
    out
  end

  def self.decrypt_detached(key : Bytes, nonce : Bytes, ciphertext : Bytes, tag : Bytes, ad : Bytes = Bytes.empty) : Bytes?
    raise "AES128GCM: key must be 16 bytes" if key.size != 16
    AES.gcm_decrypt_detached(key, nonce, ciphertext, tag, ad)
  end

  def self.decrypt(key : Bytes, nonce : Bytes, ciphertext_and_tag : Bytes, ad : Bytes = Bytes.empty) : Bytes?
    return nil if ciphertext_and_tag.size < 16
    ct_len = ciphertext_and_tag.size - 16
    ct = ciphertext_and_tag[0, ct_len]
    tag = ciphertext_and_tag[ct_len, 16]
    decrypt_detached(key, nonce, ct, tag, ad)
  end
end

pub class AES256GCM
  def self.encrypt_detached(key : Bytes, nonce : Bytes, plaintext : Bytes, ad : Bytes = Bytes.empty) : {Bytes, Bytes}
    raise "AES256GCM: key must be 32 bytes" if key.size != 32
    AES.gcm_encrypt_detached(key, nonce, plaintext, ad)
  end

  def self.encrypt(key : Bytes, nonce : Bytes, plaintext : Bytes, ad : Bytes = Bytes.empty) : Bytes
    ct, tag = encrypt_detached(key, nonce, plaintext, ad)
    out = Bytes.new(ct.size + 16)
    i = 0; while i < ct.size
      out[i] = ct[i]; i = i + 1
    end
    i = 0; while i < 16
      out[ct.size + i] = tag[i]; i = i + 1
    end
    out
  end

  def self.decrypt_detached(key : Bytes, nonce : Bytes, ciphertext : Bytes, tag : Bytes, ad : Bytes = Bytes.empty) : Bytes?
    raise "AES256GCM: key must be 32 bytes" if key.size != 32
    AES.gcm_decrypt_detached(key, nonce, ciphertext, tag, ad)
  end

  def self.decrypt(key : Bytes, nonce : Bytes, ciphertext_and_tag : Bytes, ad : Bytes = Bytes.empty) : Bytes?
    return nil if ciphertext_and_tag.size < 16
    ct_len = ciphertext_and_tag.size - 16
    ct = ciphertext_and_tag[0, ct_len]
    tag = ciphertext_and_tag[ct_len, 16]
    decrypt_detached(key, nonce, ct, tag, ad)
  end
end

# -----------------------------------------------------------------------------
# QUIC Header Protection (RFC 9001 sections 5.4.3 and 5.4.4)
# -----------------------------------------------------------------------------
# QUIC masks the packet number and the low header bits with five keystream
# bytes derived from a sample of the packet's ciphertext. The AES form is a
# single ECB block encryption of the sample, and the ChaCha20 form is one
# block with the counter and nonce read out of the sample.
#
# This lives here rather than in `std/quic` because it is a use of the block
# cipher this module already implements, and a second AES in another module
# would be a second thing to get right, review and keep correct. The raw key
# schedule stays private: a caller gets the mask, not a pointer.
pub class HeaderProtection
  # RFC 9001 section 5.4.3: mask = AES-ECB(hp_key, sample)[0..4]
  def self.aes_mask(hp_key : Bytes, sample : Bytes) : Bytes
    raise "HeaderProtection: AES key must be 16 or 32 bytes" if hp_key.size != 16 && hp_key.size != 32
    raise "HeaderProtection: sample must be 16 bytes" if sample.size != 16
    nr, rk = AES.expand_key(hp_key)
    block = Pointer(UInt8).malloc(16_u64)
    AES.encrypt_block(nr, rk, sample.to_unsafe, block)
    mask = Bytes.new(5)
    i = 0
    while i < 5
      mask[i] = block[i]
      i = i + 1
    end
    mask
  end

  # RFC 9001 section 5.4.4: the counter is the first four bytes of the sample
  # read little-endian, the nonce is the remaining twelve, and the mask is the
  # first five bytes of that ChaCha20 block.
  def self.chacha_mask(hp_key : Bytes, sample : Bytes) : Bytes
    raise "HeaderProtection: ChaCha20 key must be 32 bytes" if hp_key.size != 32
    raise "HeaderProtection: sample must be 16 bytes" if sample.size != 16
    counter = 0_u64
    i = 0
    while i < 4
      counter = counter | sample[i].to_u64.unsafe_shl((8 * i).to_u64)
      i = i + 1
    end
    nonce = sample[4, 12]
    block = Pointer(UInt8).malloc(64_u64)
    ChaCha20.block(hp_key, counter, nonce, block)
    mask = Bytes.new(5)
    j = 0
    while j < 5
      mask[j] = block[j]
      j = j + 1
    end
    mask
  end
end

# -----------------------------------------------------------------------------
# Blowfish & Bcrypt (Bruce Schneier 1993, Provos & Mazières 1999)
# -----------------------------------------------------------------------------

pub class Blowfish
  DEFAULT_ROUNDS = 16

  @rounds : Int32
  @p : Pointer(UInt32)
  @s : Pointer(UInt32)
  @s1 : Pointer(UInt32)
  @s2 : Pointer(UInt32)
  @s3 : Pointer(UInt32)

  P_INIT = [
    0x243f6a88_u32,
    0x85a308d3_u32,
    0x13198a2e_u32,
    0x03707344_u32,
    0xa4093822_u32,
    0x299f31d0_u32,
    0x082efa98_u32,
    0xec4e6c89_u32,
    0x452821e6_u32,
    0x38d01377_u32,
    0xbe5466cf_u32,
    0x34e90c6c_u32,
