# Standard MIME media type parsing and registry for iyi.
#
# Answers RFC 1521, RFC 2045, RFC 2046 media type representation:
# type/subtype with optional parameters (e.g. text/html; charset=utf-8),
# supporting quoted values with escape sequences and case-insensitive keys.
#
# System mime.types decision:
# We do not automatically load /etc/mime.types or OS database files on startup.
# In iyi, programs adhere to minimal dependency and footprint floors (SPEC III.9).
# Reading an OS file unconditionally creates non-deterministic cross-target behavior
# (macOS, Linux, Alpine, Windows, wasm32-wasi) and requires filesystem access during
# type initialization. We embed a rich standard table of common media types directly,
# and provide MIME.load_mime_database(content) and MIME.register(ext, type) for
# applications that explicitly want to load custom or host-provided databases.

module std/mime

import std/text
import std/io
import std/file
import std/slice
using std/slice::{Bytes}

pub class Error < ::Exception
  getter message : String?
  getter cause : Exception?

  def initialize(@message : String? = nil, @cause : Exception? = nil)
  end
end

pub struct MediaType
  @media_type : String
  @params : Hash(String, String)

  getter media_type : String
  getter params : Hash(String, String)

  def initialize(@media_type : String, @params : Hash(String, String))
  end

  def initialize(media_type : String)
    @media_type = media_type.downcase
    @params = Hash(String, String).new
  end

  def self.new(media_type : String, params : Hash(String, String)? = nil) : MediaType
    if params
      new(media_type, params)
    else
      new(media_type)
    end
  end

  # Returns the top-level type (before the slash), e.g. "text" from "text/html".
  def type : String
    idx = @media_type.index('/')
    idx ? @media_type[0, idx] : @media_type
  end

  # Returns the subtype (after the slash), e.g. "html" from "text/html".
  def sub_type : String
    idx = @media_type.index('/')
    idx ? @media_type[idx + 1, @media_type.bytesize - idx - 1] : ""
  end

  # Returns parameter value for *key*, or raises if not found.
  def [](key : String) : String
    val = @params[key.downcase]?
    if val
      val
    else
      raise "missing media type parameter: " + key
    end
  end

  # Returns parameter value for *key*, or nil if not found.
  def []?(key : String) : String?
    @params[key.downcase]?
  end

  def has_key?(key : String) : Bool
    @params.has_key?(key.downcase)
  end

  def fetch(key : String, default_value : String) : String
    val = @params[key.downcase]?
    val ? val : default_value
  end

  def fetch(key : String, &block : String -> String) : String
    val = @params[key.downcase]?
    val ? val : yield(key)
  end

  def []=(key : String, value : String) : Nil
    @params[key.downcase] = value
  end

  def each_parameter(& : (String, String) -> Nil) : Nil
    @params.each do |k, v|
      yield k, v
    end
  end

  # Returns true if *byte* is a valid RFC 2045 / RFC 2616 token character.
  def self.token_byte?(b : UInt8) : Bool
    (b >= 97_u8 && b <= 122_u8) ||  # a-z
      (b >= 65_u8 && b <= 90_u8) || # A-Z
      (b >= 48_u8 && b <= 57_u8) || # 0-9
      b == 33_u8 ||                 # !
      b == 35_u8 ||                 # #
      b == 36_u8 ||                 # $
      b == 37_u8 ||                 # %
      b == 38_u8 ||                 # &
      b == 39_u8 ||                 # '
      b == 42_u8 ||                 # *
      b == 43_u8 ||                 # +
      b == 45_u8 ||                 # -
      b == 46_u8 ||                 # .
      b == 94_u8 ||                 # ^
      b == 95_u8 ||                 # _
      b == 96_u8 ||                 # `
      b == 124_u8 ||                # |
      b == 126_u8                   # ~
  end

  def self.token_string?(str : String) : Bool
    return false if str.empty?
    raw = str.to_unsafe
    len = str.bytesize
    i = 0
    while i < len
      return false unless token_byte?(raw[i])
      i = i + 1
    end
    true
  end

  # Parses a media type string with optional parameters, e.g.:
  # "text/html; charset=utf-8" or "multipart/form-data; boundary=\"---123\""
  def self.parse?(string : String) : MediaType?
    s = string.strip
    return nil if s.empty?

    # Separate media_type from parameters at first ';'
    semi = s.index(';')
    raw_type = ""
    raw_params = ""
    if semi
      raw_type = s[0, semi].strip.downcase
      raw_params = s[semi + 1, s.bytesize - semi - 1]
    else
      raw_type = s.downcase
    end

    # Validate type/subtype format
    slash = raw_type.index('/')
    return nil unless slash
    return nil if slash == 0 || slash == raw_type.bytesize - 1

    params = Hash(String, String).new

    # Parse parameters if present
    unless raw_params.empty?
      raw = raw_params.to_unsafe
      len = raw_params.bytesize
      ptr = 0

      while ptr < len
        # Skip leading whitespace and semicolons
        while ptr < len && (raw[ptr] == 32_u8 || raw[ptr] == 9_u8 || raw[ptr] == 10_u8 || raw[ptr] == 13_u8 || raw[ptr] == 59_u8)
          ptr = ptr + 1
        end
        break if ptr >= len

        # Read parameter name until '='
        key_start = ptr
        while ptr < len && raw[ptr] != 61_u8 && raw[ptr] != 59_u8 # '=' or ';'
          ptr = ptr + 1
        end
        return nil if ptr >= len || raw[ptr] != 61_u8 # must find '='

        key_str = raw_params[key_start, ptr - key_start].strip.downcase
        return nil if key_str.empty?

        ptr = ptr + 1 # skip '='

        # Skip whitespace before value
        while ptr < len && (raw[ptr] == 32_u8 || raw[ptr] == 9_u8)
          ptr = ptr + 1
        end
        return nil if ptr >= len

        val_str = ""
        if raw[ptr] == 34_u8 # '"' (quoted value)
          ptr = ptr + 1      # skip opening quote
          val_bytes = [] of UInt8
          closed = false
          while ptr < len
            if raw[ptr] == 92_u8 # '\\'
              if ptr + 1 < len
                val_bytes << raw[ptr + 1]
                ptr = ptr + 2
              else
                val_bytes << raw[ptr]
                ptr = ptr + 1
              end
            elsif raw[ptr] == 34_u8 # '"'
              closed = true
              ptr = ptr + 1
              break
            else
              val_bytes << raw[ptr]
              ptr = ptr + 1
            end
          end
          return nil unless closed

          val_str = String.new(val_bytes.size) do |buf|
            buf.copy_from(val_bytes.to_unsafe, val_bytes.size)
          end

          # Skip whitespace after closing quote until ';' or end
          while ptr < len && raw[ptr] != 59_u8
            ptr = ptr + 1
          end
        else
          # Unquoted token value
          val_start = ptr
          while ptr < len && raw[ptr] != 59_u8
            ptr = ptr + 1
          end
          val_str = raw_params[val_start, ptr - val_start].strip
        end

        params[key_str] = val_str
        ptr = ptr + 1 if ptr < len && raw[ptr] == 59_u8
      end
    end

    MediaType.new(raw_type, params)
  end

  def self.parse(string : String) : MediaType
    res = parse?(string)
    if res
      res
    else
      raise "invalid media type: " + string
    end
  end

  def to_s : String
    parts = [] of String
    parts << @media_type
    @params.each do |k, v|
      if MediaType.token_string?(v)
        parts << ("; " + k + "=" + v)
      else
        escaped_bytes = [] of UInt8
        v_raw = v.to_unsafe
        v_len = v.bytesize
        vi = 0
        while vi < v_len
          vb = v_raw[vi]
          if vb == 34_u8 || vb == 92_u8 # '"' or '\\'
            escaped_bytes << 92_u8
          end
          escaped_bytes << vb
          vi = vi + 1
        end
        v_esc = String.new(escaped_bytes.size) do |buf|
          buf.copy_from(escaped_bytes.to_unsafe, escaped_bytes.size)
        end
        parts << ("; " + k + "=\"" + v_esc + "\"")
      end
    end
    parts.join("")
  end

  def to_s(io : IO) : Nil
    str = to_s
    io.write(str.to_unsafe, str.bytesize)
  end
end

pub struct Multipart
  class Error < Std::Mime::Error
  end

  @@boundary_counter : UInt64 = 0_u64

  # Generates a unique multipart boundary conforming to RFC 2046.
  def self.generate_boundary : String
    @@boundary_counter = @@boundary_counter + 1_u64
    "---------------------------iyi" + @@boundary_counter.to_s + "b" + (@@boundary_counter * 6364136223846793005_u64).to_s(16)
  end

  # Extracts the boundary parameter from a Content-Type header string.
  def self.parse_boundary(content_type : String) : String?
    mt = MediaType.parse?(content_type)
    return nil unless mt
    mt["boundary"]?
  end

  def self.build(io : IO, boundary : String = generate_boundary, &block : Builder -> Nil) : Nil
    builder = Builder.new(io, boundary)
    yield builder
    builder.finish
  end

  def self.build(boundary : String = generate_boundary, &block : Builder -> Nil) : String
    io = IO::Memory.new
    build(io, boundary, &block)
    io.to_s
  end

  def self.parse(io : IO, boundary : String) : Parser
    Parser.new(io, boundary)
  end

  pub class Builder
    getter boundary : String

    def initialize(@io : IO, @boundary : String = Std::Mime::Multipart.generate_boundary)
      @finished = false
    end

    def content_type(subtype : String = "form-data") : String
      "multipart/#{subtype}; boundary=\"#{@boundary}\""
    end

    def preamble(string : String) : Nil
      @io.write(string.to_unsafe, string.bytesize)
      @io.write("\r\n".to_unsafe, 2)
    end

    def preamble(data : Bytes) : Nil
      @io.write(data.to_unsafe, data.size)
      @io.write("\r\n".to_unsafe, 2)
    end

    def preamble(preamble_io : IO) : Nil
      content = preamble_io.read_all
      @io.write(content.to_unsafe, content.bytesize)
      @io.write("\r\n".to_unsafe, 2)
    end

    def epilogue(string : String) : Nil
      @io.write(string.to_unsafe, string.bytesize)
    end

    def epilogue(data : Bytes) : Nil
      @io.write(data.to_unsafe, data.size)
    end

    def epilogue(epilogue_io : IO) : Nil
      content = epilogue_io.read_all
      @io.write(content.to_unsafe, content.bytesize)
    end

    def body_part(headers : Hash(String, String), string : String) : Nil
      write_boundary
      write_headers(headers)
      @io.write(string.to_unsafe, string.bytesize)
      @io.write("\r\n".to_unsafe, 2)
    end

    def body_part(headers : Hash(String, String), data : Bytes) : Nil
      write_boundary
      write_headers(headers)
      @io.write(data.to_unsafe, data.size)
      @io.write("\r\n".to_unsafe, 2)
    end

    def body_part(headers : Hash(String, String), body_io : IO) : Nil
      write_boundary
      write_headers(headers)
      content = body_io.read_all
      @io.write(content.to_unsafe, content.bytesize)
      @io.write("\r\n".to_unsafe, 2)
    end

    def body_part(headers : Hash(String, String), &block : IO -> Nil) : Nil
      write_boundary
      write_headers(headers)
      yield @io
      @io.write("\r\n".to_unsafe, 2)
    end

    def finish : Nil
      return if @finished
      @finished = true
      end_bound = "--#{@boundary}--\r\n"
      @io.write(end_bound.to_unsafe, end_bound.bytesize)
    end

    private def write_boundary : Nil
      bound = "--#{@boundary}\r\n"
      @io.write(bound.to_unsafe, bound.bytesize)
    end

    private def write_headers(headers : Hash(String, String)) : Nil
      headers.each do |k, v|
        line = "#{k}: #{v}\r\n"
        @io.write(line.to_unsafe, line.bytesize)
      end
      @io.write("\r\n".to_unsafe, 2)
    end
  end

  pub class Parser
    getter boundary : String
    @io : IO
    @delimiter : String
    @end_delimiter : String
    @finished : Bool
    @has_peeked : Bool
    @peeked_headers : Hash(String, String)?
    @peeked_body : String?

    def initialize(@io : IO, @boundary : String)
      @delimiter = "--" + @boundary
      @end_delimiter = "--" + @boundary + "--"
      @finished = false
      @has_peeked = false
      @peeked_headers = nil
      @peeked_body = nil
      read_preamble
    end

    private def read_preamble : Nil
      while line = read_line_trimmed
        if line == @delimiter
          return
        elsif line == @end_delimiter
          @finished = true
          return
        end
      end
      @finished = true
    end

    private def read_line_trimmed : String?
      s = @io.read_line(chomp: true)
      return nil unless s
      if s.ends_with?('\r')
        s[0, s.bytesize - 1]
      else
        s
      end
    end

    def has_next? : Bool
      return false if @finished
      unless @has_peeked
        step_next
      end
      @peeked_headers != nil
    end

    def next : Tuple(Hash(String, String), String)?
      if has_next?
        if h = @peeked_headers
          b = @peeked_body || ""
          @has_peeked = false
          @peeked_headers = nil
          @peeked_body = nil
          return {h, b}
        end
      end
      nil
    end

    def next(&block : (Hash(String, String), IO) -> Nil) : Bool
      part = self.next
      return false unless part
      h, b = part
      mem = IO::Memory.new(b)
      yield h, mem
      true
    end

    private def step_next : Nil
      return if @finished
      headers = Hash(String, String).new

      # Read headers until empty line
      while line = read_line_trimmed
        break if line.empty?
        colon = line.index(':')
        if colon
          h_name = line[0, colon].strip
          h_val = line[colon + 1, line.bytesize - colon - 1].strip
          headers[h_name] = h_val
        end
      end

      # Read body until next delimiter
      body_lines = [] of String
      boundary_found = false
      while line = read_line_trimmed
        if line == @delimiter
          boundary_found = true
          break
        elsif line == @end_delimiter
          boundary_found = true
          @finished = true
          break
        else
          body_lines << line
        end
      end

      @finished = true unless boundary_found
      @peeked_headers = headers
      @peeked_body = body_lines.join("\r\n")
      @has_peeked = true
    end
  end
end

pub struct MIME
  alias Error = ::Std::Mime::Error
  alias MediaType = ::Std::Mime::MediaType
  alias Multipart = ::Std::Mime::Multipart

  DEFAULT_TYPES = {
    ".css"  => "text/css; charset=utf-8",
    ".gif"  => "image/gif",
    ".htm"  => "text/html; charset=utf-8",
    ".html" => "text/html; charset=utf-8",
    ".jpg"  => "image/jpeg",
    ".jpeg" => "image/jpeg",
    ".js"   => "text/javascript; charset=utf-8",
    ".json" => "application/json",
    ".pdf"  => "application/pdf",
    ".png"  => "image/png",
    ".svg"  => "image/svg+xml",
    ".txt"  => "text/plain; charset=utf-8",
    ".xml"  => "text/xml; charset=utf-8",
    ".wasm" => "application/wasm",
    ".webp" => "image/webp",
  }

  @@custom_extensions : Hash(String, String) = Hash(String, String).new
  @@custom_reverse : Hash(String, Array(String)) = Hash(String, Array(String)).new

  # Registers or overrides an extension to media type mapping.
  # Extension can be specified with or without leading dot (e.g. ".cr" or "cr").
  def self.register(ext : String, media_type : String) : Nil
    normalized_ext = ext.starts_with?('.') ? ext.downcase : ("." + ext.downcase)
    normalized_type = media_type.downcase
    @@custom_extensions[normalized_ext] = normalized_type

    list = @@custom_reverse[normalized_type]?
    if list
      unless list.includes?(normalized_ext)
        list << normalized_ext
      end
    else
      new_list = [] of String
      new_list << normalized_ext
      @@custom_reverse[normalized_type] = new_list
    end
  end

  # Returns the media type for *ext*, or nil if not registered.
  def self.from_extension?(ext : String) : String?
    normalized = ext.starts_with?('.') ? ext.downcase : ("." + ext.downcase)

    # Check custom overrides first
    custom = @@custom_extensions[normalized]?
    return custom if custom

    # Check DEFAULT_TYPES constant
    def_val = DEFAULT_TYPES[normalized]?
    return def_val if def_val

    # Common built-in table
    case normalized
    when ".mjs"
      "text/javascript; charset=utf-8"
    when ".text"
      "text/plain; charset=utf-8"
    when ".csv"
      "text/csv; charset=utf-8"
    when ".md", ".markdown"
      "text/markdown; charset=utf-8"
    when ".ico"
      "image/x-icon"
    when ".avif"
      "image/avif"
    when ".bmp"
      "image/bmp"
    when ".tif", ".tiff"
      "image/tiff"
    when ".zip"
      "application/zip"
    when ".gz"
      "application/gzip"
    when ".tar"
      "application/x-tar"
    when ".bin"
      "application/octet-stream"
    when ".mp3"
      "audio/mpeg"
    when ".wav"
      "audio/wav"
    when ".ogg"
      "audio/ogg"
    when ".flac"
      "audio/flac"
    when ".mp4"
      "video/mp4"
    when ".webm"
      "video/webm"
    when ".woff"
      "font/woff"
    when ".woff2"
      "font/woff2"
    when ".ttf"
      "font/ttf"
    when ".otf"
      "font/otf"
    when ".epub"
      "application/epub+zip"
    else
      nil
    end
  end

  # Returns the media type for *ext*, or raises if not found.
  def self.from_extension(ext : String) : String
    res = from_extension?(ext)
    if res
      res
    else
      raise "unknown mime extension: " + ext
    end
  end

  def self.from_extension(ext : String, default : String) : String
    from_extension?(ext) || default
  end

  # Returns media type from file path or file name.
  def self.from_filename?(filename : String) : String?
    # Extract file extension after last dot, after last slash
    slash = filename.rindex('/')
    name = slash ? filename[slash + 1, filename.bytesize - slash - 1] : filename
    dot = name.rindex('.')
    return nil unless dot
    ext = name[dot, name.bytesize - dot]
    from_extension?(ext)
  end

  def self.from_filename(filename : String) : String
    res = from_filename?(filename)
    if res
      res
    else
      raise "unknown mime filename: " + filename
    end
  end

  def self.from_filename(filename : String, default : String) : String
    from_filename?(filename) || default
  end

  # Returns extensions registered for the given media type.
  def self.extensions(media_type : String) : Array(String)
    t = media_type.downcase
    custom = @@custom_reverse[t]?
    result = [] of String
    if custom
      i = 0
      while i < custom.size
        result << custom[i]
        i = i + 1
      end
    end

    # Built-in reverse mappings
    case t
    when "text/html", "text/html; charset=utf-8"
      result << ".html" unless result.includes?(".html")
      result << ".htm" unless result.includes?(".htm")
    when "text/css", "text/css; charset=utf-8"
      result << ".css" unless result.includes?(".css")
    when "text/javascript", "text/javascript; charset=utf-8"
      result << ".js" unless result.includes?(".js")
      result << ".mjs" unless result.includes?(".mjs")
    when "application/json"
      result << ".json" unless result.includes?(".json")
    when "text/plain", "text/plain; charset=utf-8"
      result << ".txt" unless result.includes?(".txt")
    when "image/png"
      result << ".png" unless result.includes?(".png")
    when "image/jpeg"
      result << ".jpg" unless result.includes?(".jpg")
      result << ".jpeg" unless result.includes?(".jpeg")
    when "image/gif"
      result << ".gif" unless result.includes?(".gif")
    when "image/svg+xml"
      result << ".svg" unless result.includes?(".svg")
    when "application/pdf"
      result << ".pdf" unless result.includes?(".pdf")
    when "application/wasm"
      result << ".wasm" unless result.includes?(".wasm")
    end

    result
  end

  def self.init(load_defaults : Bool = true) : Nil
    @@custom_extensions.clear
    @@custom_reverse.clear
    if load_defaults
      DEFAULT_TYPES.each do |ext, type|
        register(ext, type)
      end
    end
  end

  def self.init(filename : String) : Nil
    if File.exists?(filename)
      content = File.read(filename)
      load_mime_database(content)
    else
      raise "MIME database file not found: #{filename}"
    end
  end

  def self.load_mime_database(io : IO) : Nil
    lines = [] of String
    while line = io.read_line(chomp: true)
      lines << line
    end
    load_mime_database(lines.join("\n"))
  end

  # Loads a mime database from mime.types format content.
  # Each line: media/type ext1 ext2 ...
  # Lines starting with # and blank lines are ignored.
  def self.load_mime_database(content : String) : Nil
    lines = content.split('\n')
    line_idx = 0
    while line_idx < lines.size
      raw_line = lines[line_idx].strip
      unless raw_line.empty? || raw_line.starts_with?('#')
        # Strip comment if present
        hash_idx = raw_line.index('#')
        line = hash_idx ? raw_line[0, hash_idx].strip : raw_line
        unless line.empty?
          tokens = line.split(' ')
          clean_tokens = [] of String
          ti = 0
          while ti < tokens.size
            t = tokens[ti].strip
            clean_tokens << t unless t.empty?
            ti = ti + 1
          end

          if clean_tokens.size >= 2
            media_type = clean_tokens[0]
            ext_idx = 1
            while ext_idx < clean_tokens.size
              register(clean_tokens[ext_idx], media_type)
              ext_idx = ext_idx + 1
            end
          end
        end
      end
      line_idx = line_idx + 1
    end
  end
end
