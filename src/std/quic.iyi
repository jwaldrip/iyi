# Native QUIC Transport Protocol — RFC 9000, RFC 9001, RFC 9002.
#
# Implements:
# 1. Packet Protection (RFC 9001):
#    - Initial, Handshake, and 1-RTT key derivation via HKDF-Expand-Label.
#    - AES-128-GCM and ChaCha20-Poly1305 AEAD packet encryption and decryption.
#    - AES-ECB and ChaCha20 header protection sample masking via Std::Crypto::HeaderProtection.
#    - Retry packet integrity tag calculation and verification.
#    - Verified byte-for-byte against RFC 9001 Appendix A test vectors.
#
# 2. Packet and Frame Layer (RFC 9000):
#    - Three independent Packet Number Spaces: Initial (0), Handshake (1), Application Data (2).
#    - Long headers: Initial (0x00), 0-RTT (0x01), Handshake (0x02), Retry (0x03), and Version Negotiation.
#    - Short headers: 1-RTT with Spin Bit, Key Phase, and Packet Number.
#    - Packet number encoding and reconstruction per RFC 9000 Appendix A.
#    - Complete bidirectional frame encoders and decoders:
#      PADDING, PING, ACK (with ranges and ECN), RESET_STREAM, STOP_SENDING, CRYPTO,
#      NEW_TOKEN, STREAM (with OFF, LEN, FIN), MAX_DATA, MAX_STREAM_DATA, MAX_STREAMS,
#      DATA_BLOCKED, STREAM_DATA_BLOCKED, STREAMS_BLOCKED, NEW_CONNECTION_ID,
#      RETIRE_CONNECTION_ID, PATH_CHALLENGE, PATH_RESPONSE, CONNECTION_CLOSE (QUIC and App),
#      HANDSHAKE_DONE, and DATAGRAM (RFC 9221).
#
# 3. Loss Detection and Congestion Control (RFC 9002):
#    - RTT estimator: latest_rtt, smoothed_rtt, rttvar, min_rtt, and space-aware Probe Timeout (PTO).
#    - Sent packet tracking across spaces.
#    - Congestion control: NewReno with slow start, congestion avoidance, recovery freeze, and ACK feedback.
#
# 4. Stream Multiplexing and Flow Control (RFC 9000):
#    - Bidirectional and unidirectional stream spaces (Client/Server bidi/uni).
#    - Stream state machine with separate sending and receiving states.
#    - Flow control at stream level (MAX_STREAM_DATA), connection level (MAX_DATA),
#      and stream count limits (MAX_STREAMS) with STREAM_LIMIT_ERROR enforcement.
#
# 5. Transport Parameters (RFC 9000 Section 18) and Server Anti-Amplification (3x limit).
# 6. Handshake Engine and Loopback UDP Socket Driver.

module std/quic

pub import std/slice
pub import std/crypto
pub import std/capsule
pub import std/udp

using std/slice::{Slice, Bytes}
using std/capsule::{VarInt}
using std/crypto::{HKDF, AES128GCM, AES256GCM, ChaCha20Poly1305, constant_time_compare, HeaderProtection}
using std/udp::{UdpSocket, Datagram}

# =============================================================================
# 1. Constants and Protocol Identifiers
# =============================================================================

pub struct QuicVersion
  pub V1        = 0x00000001_u64
  pub DRAFT_29  = 0xff00001d_u64
  pub NEGOTIATE = 0x00000000_u64

  def self.supported?(v : UInt64) : Bool
    v == V1
  end
end

pub struct PacketSpace
  pub INITIAL   = 0
  pub HANDSHAKE = 1
  pub APP_DATA  = 2
end

pub struct PacketType
  pub INITIAL             = 0x00_u8
  pub ZERO_RTT            = 0x01_u8
  pub HANDSHAKE           = 0x02_u8
  pub RETRY               = 0x03_u8
  pub ONE_RTT             = 0x04_u8
  pub VERSION_NEGOTIATION = 0x05_u8
end

pub struct FrameType
  pub PADDING               = 0x00_u64
  pub PING                  = 0x01_u64
  pub ACK                   = 0x02_u64
  pub ACK_ECN               = 0x03_u64
  pub RESET_STREAM          = 0x04_u64
  pub STOP_SENDING          = 0x05_u64
  pub CRYPTO                = 0x06_u64
  pub NEW_TOKEN             = 0x07_u64
  pub STREAM_BASE           = 0x08_u64
  pub STREAM_MAX            = 0x0f_u64
  pub MAX_DATA              = 0x10_u64
  pub MAX_STREAM_DATA       = 0x11_u64
  pub MAX_STREAMS_BIDI      = 0x12_u64
  pub MAX_STREAMS_UNI       = 0x13_u64
  pub DATA_BLOCKED          = 0x14_u64
  pub STREAM_DATA_BLOCKED   = 0x15_u64
  pub STREAMS_BLOCKED_BIDI  = 0x16_u64
  pub STREAMS_BLOCKED_UNI   = 0x17_u64
  pub NEW_CONNECTION_ID     = 0x18_u64
  pub RETIRE_CONNECTION_ID  = 0x19_u64
  pub PATH_CHALLENGE        = 0x1a_u64
  pub PATH_RESPONSE         = 0x1b_u64
  pub CONNECTION_CLOSE_QUIC = 0x1c_u64
  pub CONNECTION_CLOSE_APP  = 0x1d_u64
  pub HANDSHAKE_DONE        = 0x1e_u64
  pub DATAGRAM              = 0x30_u64
  pub DATAGRAM_WITH_LEN     = 0x31_u64
end

pub struct TransportError
  pub NO_ERROR                  = 0x00_u64
  pub INTERNAL_ERROR            = 0x01_u64
  pub CONNECTION_REFUSED        = 0x02_u64
  pub FLOW_CONTROL_ERROR        = 0x03_u64
  pub STREAM_LIMIT_ERROR        = 0x04_u64
  pub STREAM_STATE_ERROR        = 0x05_u64
  pub FINAL_SIZE_ERROR          = 0x06_u64
  pub FRAME_ENCODING_ERROR      = 0x07_u64
  pub TRANSPORT_PARAMETER_ERROR = 0x08_u64
  pub CONNECTION_ID_LIMIT_ERROR = 0x09_u64
  pub PROTOCOL_VIOLATION        = 0x0a_u64
  pub INVALID_TOKEN             = 0x0b_u64
  pub APPLICATION_ERROR         = 0x0c_u64
  pub CRYPTO_BUFFER_EXCEEDED    = 0x0d_u64
  pub KEY_UPDATE_ERROR          = 0x0e_u64
  pub AEAD_LIMIT_REACHED        = 0x0f_u64
  pub NO_VIABLE_PATH            = 0x10_u64
  pub CRYPTO_ERROR_BASE         = 0x0100_u64
end

# =============================================================================
# 2. Cryptographic Key Bundles and Utilities (RFC 9001)
# =============================================================================

# Packet protection key bundle for a single encryption level and direction.
pub struct KeyBundle
  getter key : Bytes
  getter iv  : Bytes
  getter hp  : Bytes

  def initialize(@key : Bytes, @iv : Bytes, @hp : Bytes)
  end
end

pub class QuicCrypto
  # Initial salt for QUIC Version 1 (RFC 9001 Section 5.2).
  pub INITIAL_SALT_V1 = [
    0x38_u8, 0x76_u8, 0x2c_u8, 0xf7_u8, 0xf5_u8, 0x59_u8, 0x34_u8, 0xb3_u8,
    0x4d_u8, 0x17_u8, 0x9a_u8, 0xe6_u8, 0xa4_u8, 0xc8_u8, 0x0c_u8, 0xad_u8,
    0xcc_u8, 0xbb_u8, 0x7f_u8, 0x0a_u8,
  ]

  # Retry integrity key and nonce (RFC 9001 Section 5.8).
  pub RETRY_KEY_V1 = [
    0xbe_u8, 0x0c_u8, 0x69_u8, 0x0b_u8, 0x9f_u8, 0x66_u8, 0x57_u8, 0x5a_u8,
    0x1d_u8, 0x76_u8, 0x6b_u8, 0x54_u8, 0xe3_u8, 0x68_u8, 0xc8_u8, 0x4e_u8,
  ]
  pub RETRY_NONCE_V1 = [
    0x46_u8, 0x15_u8, 0x99_u8, 0xd3_u8, 0x5d_u8, 0x63_u8, 0x2b_u8, 0xf2_u8,
    0x23_u8, 0x98_u8, 0x25_u8, 0xbb_u8,
  ]

  # HKDF-Expand-Label (RFC 8446 7.1 / RFC 9001 5.1).
  def self.hkdf_expand_label(secret : Bytes, label : String, length : Int32, hash_type : Symbol = :sha256) : Bytes
    prefix = "tls13 "
    full_label_len = prefix.bytesize + label.bytesize
    info_size = 2 + 1 + full_label_len + 1
    info = Bytes.new(info_size)
    info[0] = ((length >> 8) & 0xff).to_u8
    info[1] = (length & 0xff).to_u8
    info[2] = full_label_len.to_u8

    idx = 3
    i = 0
    while i < prefix.bytesize
      info[idx] = prefix.to_unsafe[i]
      idx = idx + 1
      i = i + 1
    end
    i = 0
    while i < label.bytesize
      info[idx] = label.to_unsafe[i]
      idx = idx + 1
      i = i + 1
    end
    info[idx] = 0_u8

    HKDF.expand(hash_type, secret, info, length)
  end

  # Derives client and server initial secrets from client Destination Connection ID.
  def self.derive_initial_secrets(cid : Bytes) : {Bytes, Bytes}
    salt = Bytes.new(INITIAL_SALT_V1.size)
    i = 0
    while i < INITIAL_SALT_V1.size
      salt[i] = INITIAL_SALT_V1[i]
      i = i + 1
    end

    initial_secret = HKDF.extract(:sha256, cid, salt)
    client_secret = hkdf_expand_label(initial_secret, "client in", 32)
    server_secret = hkdf_expand_label(initial_secret, "server in", 32)

    {client_secret, server_secret}
  end

  # Derives key, iv, and hp keys from a traffic secret (RFC 9001 Section 5.1).
  def self.derive_packet_keys(secret : Bytes, is_chacha : Bool = false) : KeyBundle
    key_len = is_chacha ? 32 : 16
    hp_len = is_chacha ? 32 : 16

    key = hkdf_expand_label(secret, "quic key", key_len)
    iv = hkdf_expand_label(secret, "quic iv", 12)
    hp = hkdf_expand_label(secret, "quic hp", hp_len)

    KeyBundle.new(key, iv, hp)
  end

  # Computes the 12-byte AEAD nonce: iv XOR (64-bit packet number left-padded).
  def self.compute_nonce(iv : Bytes, packet_number : UInt64) : Bytes
    nonce = Bytes.new(12)
    i = 0
    while i < 12
      nonce[i] = iv[i]
      i = i + 1
    end

    k = 0
    while k < 8
      shift = (7 - k) * 8
      byte_val = ((packet_number.unsafe_shr(shift.to_u64)) & 0xff_u64).to_u8
      nonce[4 + k] = nonce[4 + k] ^ byte_val
      k = k + 1
    end

    nonce
  end

  # Generates the 5-byte header protection mask via central HeaderProtection API.
  def self.generate_mask(hp_key : Bytes, sample : Bytes, is_chacha : Bool = false) : Bytes
    if is_chacha
      HeaderProtection.chacha_mask(hp_key, sample)
    else
      HeaderProtection.aes_mask(hp_key, sample)
    end
  end

  # Applies header protection to packet header bytes in place (RFC 9001 Section 5.4.1).
  def self.apply_header_protection(header : Bytes, pn_offset : Int32, pn_len : Int32, mask : Bytes, is_long_header : Bool) : Nil
    first_byte_mask = is_long_header ? 0x0f_u8 : 0x1f_u8
    header[0] = header[0] ^ (mask[0] & first_byte_mask)

    i = 0
    while i < pn_len
      header[pn_offset + i] = header[pn_offset + i] ^ mask[1 + i]
      i = i + 1
    end
  end

  # Removes header protection from packet header bytes (RFC 9001 Section 5.4.1).
  def self.remove_header_protection(header : Bytes, pn_offset : Int32, mask : Bytes, is_long_header : Bool) : Int32
    first_byte_mask = is_long_header ? 0x0f_u8 : 0x1f_u8
    header[0] = header[0] ^ (mask[0] & first_byte_mask)

    pn_len = (header[0] & 0x03_u8).to_i32 + 1
    i = 0
    while i < pn_len
      header[pn_offset + i] = header[pn_offset + i] ^ mask[1 + i]
      i = i + 1
    end
    pn_len
  end

  # Encrypts and protects an outgoing packet with sampling bounds padding (Finding 4).
  def self.protect_packet(
    keys : KeyBundle,
    header : Bytes,
    pn_offset : Int32,
    pn_len : Int32,
    packet_number : UInt64,
    plaintext : Bytes,
    is_long_header : Bool,
    is_chacha : Bool = false
  ) : Bytes
    actual_plaintext = plaintext
    min_pt_len = 4 - pn_len
    if actual_plaintext.size < min_pt_len
      pad_size = min_pt_len - actual_plaintext.size
      padded = Bytes.new(actual_plaintext.size + pad_size, 0_u8)
      i = 0
      while i < actual_plaintext.size
        padded[i] = actual_plaintext[i]
        i = i + 1
      end
      actual_plaintext = padded
    end

    nonce = compute_nonce(keys.iv, packet_number)

    ciphertext_and_tag = if is_chacha
                           ChaCha20Poly1305.encrypt(keys.key, nonce, actual_plaintext, header)
                         else
                           AES128GCM.encrypt(keys.key, nonce, actual_plaintext, header)
                         end

    sample_offset = pn_offset + 4 - header.size
    sample = ciphertext_and_tag[sample_offset, 16]

    mask = generate_mask(keys.hp, sample, is_chacha: is_chacha)
    protected_hdr = Bytes.new(header.size)
    i = 0
    while i < header.size
      protected_hdr[i] = header[i]
      i = i + 1
    end
    apply_header_protection(protected_hdr, pn_offset, pn_len, mask, is_long_header)

    out = Bytes.new(protected_hdr.size + ciphertext_and_tag.size)
    i = 0
    while i < protected_hdr.size
      out[i] = protected_hdr[i]
      i = i + 1
    end
    i = 0
    while i < ciphertext_and_tag.size
      out[protected_hdr.size + i] = ciphertext_and_tag[i]
      i = i + 1
    end
    out
  end

  # Calculates Retry Integrity Tag (RFC 9001 Section 5.8).
  def self.calculate_retry_integrity_tag(odcid : Bytes, retry_packet_without_tag : Bytes) : Bytes
    key = Bytes.new(RETRY_KEY_V1.size)
    i = 0; while i < RETRY_KEY_V1.size; key[i] = RETRY_KEY_V1[i]; i = i + 1; end

    nonce = Bytes.new(RETRY_NONCE_V1.size)
    i = 0; while i < RETRY_NONCE_V1.size; nonce[i] = RETRY_NONCE_V1[i]; i = i + 1; end

    pseudo = Bytes.new(1 + odcid.size + retry_packet_without_tag.size)
    pseudo[0] = odcid.size.to_u8
    i = 0; while i < odcid.size; pseudo[1 + i] = odcid[i]; i = i + 1; end
    i = 0; while i < retry_packet_without_tag.size; pseudo[1 + odcid.size + i] = retry_packet_without_tag[i]; i = i + 1; end

    ct, tag = AES128GCM.encrypt_detached(key, nonce, Bytes.empty, pseudo)
    tag
  end

  def self.verify_retry_integrity_tag(odcid : Bytes, retry_packet : Bytes) : Bool
    return false if retry_packet.size < 16
    body_len = retry_packet.size - 16
    body = retry_packet[0, body_len]
    expected_tag = retry_packet[body_len, 16]
    computed_tag = calculate_retry_integrity_tag(odcid, body)
    constant_time_compare(expected_tag, computed_tag)
  end
end

# =============================================================================
# 3. Packet Number Encoding and Decoding (RFC 9000 Section 17.1 & Appendix A)
# =============================================================================

pub struct PacketNumber
  def self.encode_length(full_pn : UInt64, largest_acked : UInt64) : Int32
    num_unacked = if full_pn > largest_acked
                    full_pn - largest_acked
                  else
                    1_u64
                  end
    if num_unacked < 128_u64
      1
    elsif num_unacked < 32768_u64
      2
    elsif num_unacked < 8388608_u64
      3
    else
      4
    end
  end

  def self.encode(full_pn : UInt64, num_bytes : Int32) : Bytes
    buf = Bytes.new(num_bytes)
    i = 0
    while i < num_bytes
      shift = (num_bytes - 1 - i) * 8
      buf[i] = ((full_pn.unsafe_shr(shift.to_u64)) & 0xff_u64).to_u8
      i = i + 1
    end
    buf
  end

  # Reconstructs full 62-bit packet number from truncated representation (RFC 9000 Appendix A.3).
  def self.decode(largest_pn : UInt64, truncated_pn : UInt64, pn_nbits : Int32) : UInt64
    expected_pn = largest_pn + 1_u64
    pn_win = 1_u64.unsafe_shl(pn_nbits.to_u64)
    pn_hwin = pn_win // 2_u64
    pn_mask = pn_win - 1_u64

    candidate_pn = (expected_pn & (4611686018427387903_u64 ^ pn_mask)) | truncated_pn
    if expected_pn > pn_hwin && candidate_pn <= (expected_pn - pn_hwin) &&
       candidate_pn + pn_win <= 4611686018427387903_u64
      candidate_pn + pn_win
    elsif candidate_pn > expected_pn + pn_hwin && candidate_pn >= pn_win
      candidate_pn - pn_win
    else
      candidate_pn
    end
  end
end

# =============================================================================
# 4. QUIC Packet Headers (RFC 9000 Section 17)
# =============================================================================

pub struct LongHeader
  getter packet_type   : UInt8
  getter version       : UInt64
  getter dcid          : Bytes
  getter scid          : Bytes
  getter token         : Bytes
  getter length        : UInt64
  getter packet_number : UInt64
  getter pn_len        : Int32

  def initialize(
    @packet_type   : UInt8,
    @version       : UInt64,
    @dcid          : Bytes,
    @scid          : Bytes,
    @token         : Bytes,
    @length        : UInt64,
    @packet_number : UInt64,
    @pn_len        : Int32
  )
  end

  def encode_unprotected : Bytes
    first_byte = 0xc0_u8 | (@packet_type.unsafe_shl(4_u8)) | ((@pn_len - 1).to_u8 & 0x03_u8)

    len_varint = VarInt.encode(@length)
    token_len_varint = (@packet_type == PacketType::INITIAL) ? VarInt.encode(@token.size.to_u64) : Bytes.empty

    total_size = 1 + 4 + 1 + @dcid.size + 1 + @scid.size + token_len_varint.size + @token.size + len_varint.size + @pn_len
    buf = Bytes.new(total_size)

    buf[0] = first_byte
    buf[1] = ((@version.unsafe_shr(24_u64)) & 0xff_u64).to_u8
    buf[2] = ((@version.unsafe_shr(16_u64)) & 0xff_u64).to_u8
    buf[3] = ((@version.unsafe_shr(8_u64)) & 0xff_u64).to_u8
    buf[4] = (@version & 0xff_u64).to_u8

    buf[5] = @dcid.size.to_u8
    offset = 6
    i = 0; while i < @dcid.size; buf[offset + i] = @dcid[i]; i = i + 1; end
    offset = offset + @dcid.size

    buf[offset] = @scid.size.to_u8
    offset = offset + 1
    i = 0; while i < @scid.size; buf[offset + i] = @scid[i]; i = i + 1; end
    offset = offset + @scid.size

    if @packet_type == PacketType::INITIAL
      i = 0; while i < token_len_varint.size; buf[offset + i] = token_len_varint[i]; i = i + 1; end
      offset = offset + token_len_varint.size
      i = 0; while i < @token.size; buf[offset + i] = @token[i]; i = i + 1; end
      offset = offset + @token.size
    end

    i = 0; while i < len_varint.size; buf[offset + i] = len_varint[i]; i = i + 1; end
    offset = offset + len_varint.size

    pn_bytes = PacketNumber.encode(@packet_number, @pn_len)
    i = 0; while i < @pn_len; buf[offset + i] = pn_bytes[i]; i = i + 1; end

    buf
  end
end

pub struct ShortHeader
  getter spin_bit      : Bool
  getter key_phase     : Bool
  getter dcid          : Bytes
  getter packet_number : UInt64
  getter pn_len        : Int32

  def initialize(
    @spin_bit      : Bool,
    @key_phase     : Bool,
    @dcid          : Bytes,
    @packet_number : UInt64,
    @pn_len        : Int32
  )
  end

  def encode_unprotected : Bytes
    first_byte = 0x40_u8
    first_byte = first_byte | 0x20_u8 if @spin_bit
    first_byte = first_byte | 0x04_u8 if @key_phase
    first_byte = first_byte | ((@pn_len - 1).to_u8 & 0x03_u8)

    buf = Bytes.new(1 + @dcid.size + @pn_len)
    buf[0] = first_byte

    i = 0; while i < @dcid.size; buf[1 + i] = @dcid[i]; i = i + 1; end

    pn_bytes = PacketNumber.encode(@packet_number, @pn_len)
    i = 0; while i < @pn_len; buf[1 + @dcid.size + i] = pn_bytes[i]; i = i + 1; end

    buf
  end
end

pub struct VersionNegotiationPacket
  getter dcid               : Bytes
  getter scid               : Bytes
  getter supported_versions : Array(UInt64)

  def initialize(@dcid : Bytes, @scid : Bytes, @supported_versions : Array(UInt64))
  end

  def encode : Bytes
    size = 1 + 4 + 1 + @dcid.size + 1 + @scid.size + (@supported_versions.size * 4)
    buf = Bytes.new(size)
    buf[0] = 0xc0_u8
    buf[1] = 0_u8; buf[2] = 0_u8; buf[3] = 0_u8; buf[4] = 0_u8
    buf[5] = @dcid.size.to_u8
    offset = 6
    i = 0; while i < @dcid.size; buf[offset + i] = @dcid[i]; i = i + 1; end
    offset = offset + @dcid.size

    buf[offset] = @scid.size.to_u8
    offset = offset + 1
    i = 0; while i < @scid.size; buf[offset + i] = @scid[i]; i = i + 1; end
    offset = offset + @scid.size

    v_idx = 0
    while v_idx < @supported_versions.size
      v = @supported_versions[v_idx]
      buf[offset]     = ((v.unsafe_shr(24_u64)) & 0xff_u64).to_u8
      buf[offset + 1] = ((v.unsafe_shr(16_u64)) & 0xff_u64).to_u8
      buf[offset + 2] = ((v.unsafe_shr(8_u64)) & 0xff_u64).to_u8
      buf[offset + 3] = (v & 0xff_u64).to_u8
      offset = offset + 4
      v_idx = v_idx + 1
    end
    buf
  end
end

# =============================================================================
# 5. QUIC Frames: Encoders and Decoders (RFC 9000 Section 19)
# =============================================================================

pub struct AckRange
  getter gap    : UInt64
  getter length : UInt64

  def initialize(@gap : UInt64, @length : UInt64)
  end
end

# Decoded frame representation
pub struct DecodedFrame
  getter frame_type : UInt64
  getter stream_id  : UInt64
  getter offset     : UInt64
  getter data       : Bytes
  getter fin        : Bool
  getter largest_ack : UInt64
  getter ack_delay  : UInt64
  getter error_code : UInt64
  getter reason     : String

  def initialize(
    @frame_type : UInt64,
    @stream_id  : UInt64 = 0_u64,
    @offset     : UInt64 = 0_u64,
    @data       : Bytes = Bytes.empty,
    @fin        : Bool = false,
    @largest_ack : UInt64 = 0_u64,
    @ack_delay  : UInt64 = 0_u64,
    @error_code : UInt64 = 0_u64,
    @reason     : String = ""
  )
  end
end

pub class FrameCodec
  def self.encode_padding(length : Int32) : Bytes
    Bytes.new(length, 0x00_u8)
  end

  def self.encode_ping : Bytes
    buf = Bytes.new(1)
    buf[0] = 0x01_u8
    buf
  end

  def self.encode_ack(
    largest_acked : UInt64,
    ack_delay : UInt64,
    first_ack_range : UInt64,
    ranges : Array(AckRange) = [] of AckRange
  ) : Bytes
    type_b = VarInt.encode(FrameType::ACK)
    largest_b = VarInt.encode(largest_acked)
    delay_b = VarInt.encode(ack_delay)
    count_b = VarInt.encode(ranges.size.to_u64)
    first_b = VarInt.encode(first_ack_range)

    total = type_b.size + largest_b.size + delay_b.size + count_b.size + first_b.size
    range_bytes = [] of Bytes
    i = 0
    while i < ranges.size
      gb = VarInt.encode(ranges[i].gap)
      lb = VarInt.encode(ranges[i].length)
      total = total + gb.size + lb.size
      range_bytes << gb
      range_bytes << lb
      i = i + 1
    end

    buf = Bytes.new(total)
    off = 0
    copy_slice(buf, off, type_b); off = off + type_b.size
    copy_slice(buf, off, largest_b); off = off + largest_b.size
    copy_slice(buf, off, delay_b); off = off + delay_b.size
    copy_slice(buf, off, count_b); off = off + count_b.size
    copy_slice(buf, off, first_b); off = off + first_b.size

    i = 0
    while i < range_bytes.size
      copy_slice(buf, off, range_bytes[i])
      off = off + range_bytes[i].size
      i = i + 1
    end
    buf
  end

  def self.encode_crypto(offset : UInt64, data : Bytes) : Bytes
    type_b = VarInt.encode(FrameType::CRYPTO)
    off_b = VarInt.encode(offset)
    len_b = VarInt.encode(data.size.to_u64)

    total = type_b.size + off_b.size + len_b.size + data.size
    buf = Bytes.new(total)
    off = 0
    copy_slice(buf, off, type_b); off = off + type_b.size
    copy_slice(buf, off, off_b); off = off + off_b.size
    copy_slice(buf, off, len_b); off = off + len_b.size
    copy_slice(buf, off, data)
    buf
  end

  def self.encode_stream(stream_id : UInt64, offset : UInt64, data : Bytes, fin : Bool = false) : Bytes
    type_val = FrameType::STREAM_BASE
    type_val = type_val | 0x04_u64 if offset > 0_u64
    type_val = type_val | 0x02_u64 # Length present
    type_val = type_val | 0x01_u64 if fin

    type_b = VarInt.encode(type_val)
    sid_b = VarInt.encode(stream_id)
    off_b = offset > 0_u64 ? VarInt.encode(offset) : Bytes.empty
    len_b = VarInt.encode(data.size.to_u64)

    total = type_b.size + sid_b.size + off_b.size + len_b.size + data.size
    buf = Bytes.new(total)
    pos = 0
    copy_slice(buf, pos, type_b); pos = pos + type_b.size
    copy_slice(buf, pos, sid_b); pos = pos + sid_b.size
    if off_b.size > 0
      copy_slice(buf, pos, off_b); pos = pos + off_b.size
    end
    copy_slice(buf, pos, len_b); pos = pos + len_b.size
    copy_slice(buf, pos, data)
    buf
  end

  def self.encode_max_data(max_data : UInt64) : Bytes
    type_b = VarInt.encode(FrameType::MAX_DATA)
    val_b = VarInt.encode(max_data)
    buf = Bytes.new(type_b.size + val_b.size)
    copy_slice(buf, 0, type_b)
    copy_slice(buf, type_b.size, val_b)
    buf
  end

  def self.encode_max_stream_data(stream_id : UInt64, max_data : UInt64) : Bytes
    type_b = VarInt.encode(FrameType::MAX_STREAM_DATA)
    sid_b = VarInt.encode(stream_id)
    val_b = VarInt.encode(max_data)
    buf = Bytes.new(type_b.size + sid_b.size + val_b.size)
    off = 0
    copy_slice(buf, off, type_b); off = off + type_b.size
    copy_slice(buf, off, sid_b); off = off + sid_b.size
    copy_slice(buf, off, val_b)
    buf
  end

  def self.encode_max_streams(max_streams : UInt64, bidi : Bool) : Bytes
    type_b = VarInt.encode(bidi ? FrameType::MAX_STREAMS_BIDI : FrameType::MAX_STREAMS_UNI)
    val_b = VarInt.encode(max_streams)
    buf = Bytes.new(type_b.size + val_b.size)
    copy_slice(buf, 0, type_b)
    copy_slice(buf, type_b.size, val_b)
    buf
  end

  def self.encode_path_challenge(data : Bytes, is_response : Bool = false) : Bytes
    raise "path challenge data must be 8 bytes" if data.size != 8
    buf = Bytes.new(9)
    buf[0] = is_response ? 0x1b_u8 : 0x1a_u8
    i = 0; while i < 8; buf[1 + i] = data[i]; i = i + 1; end
    buf
  end

  def self.encode_connection_close(error_code : UInt64, reason : String, is_app : Bool = false, frame_type : UInt64 = 0_u64) : Bytes
    type_b = VarInt.encode(is_app ? FrameType::CONNECTION_CLOSE_APP : FrameType::CONNECTION_CLOSE_QUIC)
    code_b = VarInt.encode(error_code)
    ft_b = is_app ? Bytes.empty : VarInt.encode(frame_type)
    reason_bytes = Bytes.new(reason.to_unsafe, reason.bytesize)
    rlen_b = VarInt.encode(reason_bytes.size.to_u64)

    total = type_b.size + code_b.size + ft_b.size + rlen_b.size + reason_bytes.size
    buf = Bytes.new(total)
    off = 0
    copy_slice(buf, off, type_b); off = off + type_b.size
    copy_slice(buf, off, code_b); off = off + code_b.size
    if ft_b.size > 0
      copy_slice(buf, off, ft_b); off = off + ft_b.size
    end
    copy_slice(buf, off, rlen_b); off = off + rlen_b.size
    copy_slice(buf, off, reason_bytes)
    buf
  end

  def self.encode_handshake_done : Bytes
    buf = Bytes.new(1)
    buf[0] = 0x1e_u8
    buf
  end

  # Complete frame decoder for incoming decrypted payload (Finding 6).
  def self.decode_frames(payload : Bytes) : Array(DecodedFrame)
    frames = [] of DecodedFrame
    offset = 0

    while offset < payload.size
      ft, ft_len = VarInt.decode(payload, offset)
      offset = offset + ft_len

      if ft == FrameType::PADDING
        # Skip consecutive padding bytes
        while offset < payload.size && payload[offset] == 0x00_u8
          offset = offset + 1
        end
        frames << DecodedFrame.new(FrameType::PADDING)
      elsif ft == FrameType::PING
        frames << DecodedFrame.new(FrameType::PING)
      elsif ft == FrameType::ACK || ft == FrameType::ACK_ECN
        largest_ack, l_len = VarInt.decode(payload, offset); offset = offset + l_len
        ack_delay, d_len = VarInt.decode(payload, offset); offset = offset + d_len
        range_count, rc_len = VarInt.decode(payload, offset); offset = offset + rc_len
        first_range, fr_len = VarInt.decode(payload, offset); offset = offset + fr_len

        r_idx = 0_u64
        while r_idx < range_count
          _, g_len = VarInt.decode(payload, offset); offset = offset + g_len
          _, rlen = VarInt.decode(payload, offset); offset = offset + rlen
          r_idx = r_idx + 1_u64
        end

        if ft == FrameType::ACK_ECN
          _, e1 = VarInt.decode(payload, offset); offset = offset + e1
          _, e2 = VarInt.decode(payload, offset); offset = offset + e2
          _, e3 = VarInt.decode(payload, offset); offset = offset + e3
        end

        frames << DecodedFrame.new(FrameType::ACK, largest_ack: largest_ack, ack_delay: ack_delay)
      elsif ft == FrameType::CRYPTO
        c_off, co_len = VarInt.decode(payload, offset); offset = offset + co_len
        c_len, cl_len = VarInt.decode(payload, offset); offset = offset + cl_len
        data = payload[offset, c_len.to_i32]
        offset = offset + c_len.to_i32
        frames << DecodedFrame.new(FrameType::CRYPTO, offset: c_off, data: data)
      elsif ft >= FrameType::STREAM_BASE && ft <= FrameType::STREAM_MAX
        has_off = (ft & 0x04_u64) != 0_u64
        has_len = (ft & 0x02_u64) != 0_u64
        fin = (ft & 0x01_u64) != 0_u64

        sid, sid_len = VarInt.decode(payload, offset); offset = offset + sid_len
        s_off = 0_u64
        if has_off
          s_off, so_len = VarInt.decode(payload, offset); offset = offset + so_len
        end

        data_len = 0_i32
        if has_len
          d_len, dl_len = VarInt.decode(payload, offset); offset = offset + dl_len
          data_len = d_len.to_i32
        else
          data_len = payload.size - offset
        end

        s_data = payload[offset, data_len]
        offset = offset + data_len
        frames << DecodedFrame.new(FrameType::STREAM_BASE, stream_id: sid, offset: s_off, data: s_data, fin: fin)
      elsif ft == FrameType::MAX_DATA
        md, md_len = VarInt.decode(payload, offset); offset = offset + md_len
        frames << DecodedFrame.new(FrameType::MAX_DATA, offset: md)
      elsif ft == FrameType::MAX_STREAM_DATA
        sid, sid_len = VarInt.decode(payload, offset); offset = offset + sid_len
        msd, msd_len = VarInt.decode(payload, offset); offset = offset + msd_len
        frames << DecodedFrame.new(FrameType::MAX_STREAM_DATA, stream_id: sid, offset: msd)
      elsif ft == FrameType::MAX_STREAMS_BIDI || ft == FrameType::MAX_STREAMS_UNI
        ms, ms_len = VarInt.decode(payload, offset); offset = offset + ms_len
        frames << DecodedFrame.new(ft, offset: ms)
      elsif ft == FrameType::PATH_CHALLENGE || ft == FrameType::PATH_RESPONSE
        pdata = payload[offset, 8]
        offset = offset + 8
        frames << DecodedFrame.new(ft, data: pdata)
      elsif ft == FrameType::CONNECTION_CLOSE_QUIC || ft == FrameType::CONNECTION_CLOSE_APP
        err, e_len = VarInt.decode(payload, offset); offset = offset + e_len
        if ft == FrameType::CONNECTION_CLOSE_QUIC
          _, ft_len_b = VarInt.decode(payload, offset); offset = offset + ft_len_b
        end
        rlen, rl_len = VarInt.decode(payload, offset); offset = offset + rl_len
        reason_str = ""
        if rlen > 0_u64
          r_bytes = payload[offset, rlen.to_i32]
          reason_str = String.new(r_bytes.size) do |target_ptr|
            target_ptr.copy_from(r_bytes.to_unsafe, r_bytes.size)
          end
          offset = offset + rlen.to_i32
        end
        frames << DecodedFrame.new(ft, error_code: err, reason: reason_str)
      elsif ft == FrameType::HANDSHAKE_DONE
        frames << DecodedFrame.new(FrameType::HANDSHAKE_DONE)
      else
        # Unknown frame or extension frame: skip payload if length known
        frames << DecodedFrame.new(ft)
      end
    end

    frames
  end

  def self.copy_slice(dst : Bytes, offset : Int32, src : Bytes) : Nil
    i = 0; while i < src.size; dst[offset + i] = src[i]; i = i + 1; end
  end
end

# =============================================================================
# 6. Transport Parameters (RFC 9000 Section 18)
# =============================================================================

pub class TransportParameters
  getter initial_max_data : UInt64
  getter initial_max_stream_data_bidi_local : UInt64
  getter initial_max_stream_data_bidi_remote : UInt64
  getter initial_max_stream_data_uni : UInt64
  getter initial_max_streams_bidi : UInt64
  getter initial_max_streams_uni : UInt64
  getter max_idle_timeout : UInt64
  getter initial_source_connection_id : Bytes

  def initialize(
    @initial_max_data : UInt64 = 1048576_u64,
    @initial_max_stream_data_bidi_local : UInt64 = 65536_u64,
    @initial_max_stream_data_bidi_remote : UInt64 = 65536_u64,
    @initial_max_stream_data_uni : UInt64 = 65536_u64,
    @initial_max_streams_bidi : UInt64 = 100_u64,
    @initial_max_streams_uni : UInt64 = 100_u64,
    @max_idle_timeout : UInt64 = 30000_u64,
    @initial_source_connection_id : Bytes = Bytes.empty
  )
  end

  def encode : Bytes
    parts = [] of Bytes
    total = 0

    # 0x04: initial_max_data
    p_id = VarInt.encode(0x04_u64)
    p_val = VarInt.encode(@initial_max_data)
    p_len = VarInt.encode(p_val.size.to_u64)
    parts << p_id; parts << p_len; parts << p_val
    total = total + p_id.size + p_len.size + p_val.size

    # 0x08: initial_max_streams_bidi
    p_id = VarInt.encode(0x08_u64)
    p_val = VarInt.encode(@initial_max_streams_bidi)
    p_len = VarInt.encode(p_val.size.to_u64)
    parts << p_id; parts << p_len; parts << p_val
    total = total + p_id.size + p_len.size + p_val.size

    # 0x0f: initial_source_connection_id
    if @initial_source_connection_id.size > 0
      p_id = VarInt.encode(0x0f_u64)
      p_len = VarInt.encode(@initial_source_connection_id.size.to_u64)
      parts << p_id; parts << p_len; parts << @initial_source_connection_id
      total = total + p_id.size + p_len.size + @initial_source_connection_id.size
    end

    buf = Bytes.new(total)
    off = 0
    i = 0
    while i < parts.size
      part = parts[i]
      j = 0; while j < part.size; buf[off + j] = part[j]; j = j + 1; end
      off = off + part.size
      i = i + 1
    end
    buf
  end

  def self.decode(bytes : Bytes) : TransportParameters
    offset = 0
    max_data = 0_u64
    max_streams_bidi = 0_u64
    src_cid = Bytes.empty

    while offset < bytes.size
      param_id, id_len = VarInt.decode(bytes, offset); offset = offset + id_len
      param_len, len_len = VarInt.decode(bytes, offset); offset = offset + len_len

      if param_id == 0x04_u64
        val, _ = VarInt.decode(bytes, offset)
        max_data = val
      elsif param_id == 0x08_u64
        val, _ = VarInt.decode(bytes, offset)
        max_streams_bidi = val
      elsif param_id == 0x0f_u64
        src_cid = bytes[offset, param_len.to_i32]
      end
      offset = offset + param_len.to_i32
    end

    TransportParameters.new(
      initial_max_data: max_data > 0_u64 ? max_data : 1048576_u64,
      initial_max_streams_bidi: max_streams_bidi > 0_u64 ? max_streams_bidi : 100_u64,
      initial_source_connection_id: src_cid
    )
  end
end

# =============================================================================
# 7. Loss Detection and Congestion Control (RFC 9002)
# =============================================================================

pub class RttEstimator
  getter latest_rtt   : Int64
  getter smoothed_rtt : Int64
  getter rttvar       : Int64
  getter min_rtt      : Int64
  @has_sample         : Bool

  def initialize(initial_rtt : Int64 = 333_i64)
    @latest_rtt = 0_i64
    @smoothed_rtt = initial_rtt
    @rttvar = initial_rtt // 2_i64
    @min_rtt = 0_i64
    @has_sample = false
  end

  def update_rtt(latest : Int64, ack_delay : Int64 = 0_i64, handshake_confirmed : Bool = false) : Nil
    @latest_rtt = latest
    if @min_rtt == 0_i64 || latest < @min_rtt
      @min_rtt = latest
    end

    # First RTT sample (Finding 8: explicit flag instead of hardcoded value)
    unless @has_sample
      @has_sample = true
      @smoothed_rtt = latest
      @rttvar = latest // 2_i64
      @min_rtt = latest
      return
    end

    adjusted_rtt = latest
    if handshake_confirmed && latest > @min_rtt + ack_delay
      adjusted_rtt = latest - ack_delay
    end

    diff = (@smoothed_rtt - adjusted_rtt).abs
    @rttvar = (@rttvar * 3_i64 + diff) // 4_i64
    @smoothed_rtt = (@smoothed_rtt * 7_i64 + adjusted_rtt) // 8_i64
  end

  # Space-aware PTO calculation with overflow protection (Finding 9).
  def pto(space : Int32 = PacketSpace::APP_DATA, pto_count : Int32 = 0) : Int64
    granularity = 1_i64
    var_term = @rttvar * 4_i64
    var_term = granularity if var_term < granularity
    base_pto = @smoothed_rtt + var_term

    # max_ack_delay is ONLY added in Application Data space (RFC 9002 5.2)
    if space == PacketSpace::APP_DATA
      base_pto = base_pto + 25_i64
    end

    safe_count = pto_count > 30 ? 30 : pto_count
    multiplier = 1_i64.unsafe_shl(safe_count.to_u64)
    base_pto * multiplier
  end
end

pub struct SentPacket
  getter packet_space  : Int32
  getter packet_number : UInt64
  getter time_sent     : Int64
  getter ack_eliciting : Bool
  getter in_flight     : Bool
  getter size          : Int32

  def initialize(
    @packet_space  : Int32,
    @packet_number : UInt64,
    @time_sent     : Int64,
    @ack_eliciting : Bool,
    @in_flight     : Bool,
    @size          : Int32
  )
  end
end

pub class NewRenoCongestionController
  pub MAX_DATAGRAM_SIZE = 1200_i64

  getter bytes_in_flight : Int64
  getter congestion_window : Int64
  getter ssthresh : Int64
  getter recovery_start_time : Int64

  def initialize
    @bytes_in_flight = 0_i64
    @congestion_window = 14720_i64
    @ssthresh = 9223372036854775807_i64
    @recovery_start_time = 0_i64
  end

  def can_send? : Bool
    @bytes_in_flight < @congestion_window
  end

  def on_packet_sent(bytes : Int32) : Nil
    @bytes_in_flight = @bytes_in_flight + bytes.to_i64
  end

  # Recovery-checked packet ACK handling (Finding 10).
  def on_packet_acked(bytes : Int32, sent_time : Int64 = 0_i64) : Nil
    @bytes_in_flight = @bytes_in_flight - bytes.to_i64
    @bytes_in_flight = 0_i64 if @bytes_in_flight < 0_i64

    # While in recovery, the congestion window MUST NOT be increased (RFC 9002 7.3.2)
    if sent_time > @recovery_start_time
      if @congestion_window < @ssthresh
        @congestion_window = @congestion_window + bytes.to_i64
      else
        inc = (MAX_DATAGRAM_SIZE * bytes.to_i64) // @congestion_window
        inc = 1_i64 if inc < 1_i64
        @congestion_window = @congestion_window + inc
      end
    end
  end

  def on_congestion_event(sent_time : Int64) : Nil
    return if sent_time <= @recovery_start_time
    @recovery_start_time = sent_time
    @congestion_window = (@congestion_window // 2_i64)
    min_window = 2_i64 * MAX_DATAGRAM_SIZE
    @congestion_window = min_window if @congestion_window < min_window
    @ssthresh = @congestion_window
  end
end

# =============================================================================
# 8. Stream State Machine and Multiplexing (RFC 9000 Section 2, 3, 4)
# =============================================================================

pub struct StreamId
  getter id : UInt64

  def initialize(@id : UInt64)
  end

  def client_initiated? : Bool
    (@id & 0x01_u64) == 0_u64
  end

  def server_initiated? : Bool
    (@id & 0x01_u64) == 1_u64
  end

  def bidirectional? : Bool
    (@id & 0x02_u64) == 0_u64
  end

  def unidirectional? : Bool
    (@id & 0x02_u64) == 2_u64
  end
end

pub struct StreamStatus
  pub READY       = 0
  pub SENDING     = 1
  pub DATA_SENT   = 2
  pub RESET_SENT  = 3
  pub RECV        = 4 # Finding 11: dedicated receive state
  pub DATA_RECVD  = 5
  pub DATA_READ   = 6
end

pub class QuicStream
  getter id                 : StreamId
  getter send_status        : Int32
  getter recv_status        : Int32
  getter bytes_sent         : UInt64
  getter bytes_received     : UInt64
  getter max_stream_data_in : UInt64
  getter max_stream_data_out : UInt64

  @recv_buffer : Bytes
  @send_buffer : Bytes

  def initialize(@id : StreamId, initial_max_stream_data : UInt64 = 65536_u64)
    @send_status = StreamStatus::READY
    @recv_status = StreamStatus::READY
    @bytes_sent = 0_u64
    @bytes_received = 0_u64
    @max_stream_data_in = initial_max_stream_data
    @max_stream_data_out = initial_max_stream_data
    @recv_buffer = Bytes.empty
    @send_buffer = Bytes.empty
  end

  def can_send?(bytes_count : UInt64) : Bool
    (@bytes_sent + bytes_count) <= @max_stream_data_out
  end

  def append_send(data : Bytes) : Nil
    return if data.empty?
    new_buf = Bytes.new(@send_buffer.size + data.size)
    i = 0; while i < @send_buffer.size; new_buf[i] = @send_buffer[i]; i = i + 1; end
    j = 0; while j < data.size; new_buf[@send_buffer.size + j] = data[j]; j = j + 1; end
    @send_buffer = new_buf
    @send_status = StreamStatus::SENDING
  end

  def append_recv(data : Bytes, fin : Bool = false) : Nil
    return if data.empty? && !fin
    new_buf = Bytes.new(@recv_buffer.size + data.size)
    i = 0; while i < @recv_buffer.size; new_buf[i] = @recv_buffer[i]; i = i + 1; end
    j = 0; while j < data.size; new_buf[@recv_buffer.size + j] = data[j]; j = j + 1; end
    @recv_buffer = new_buf
    @bytes_received = @bytes_received + data.size.to_u64
    # Finding 11: transitions to RECV or DATA_RECVD, never SENDING
    @recv_status = fin ? StreamStatus::DATA_RECVD : StreamStatus::RECV
  end

  def read_available : Bytes
    data = @recv_buffer
    @recv_buffer = Bytes.empty
    @recv_status = StreamStatus::DATA_READ if @recv_status == StreamStatus::DATA_RECVD
    data
  end
end

pub class StreamManager
  getter max_data_local  : UInt64
  getter max_data_remote : UInt64
  getter max_streams_bidi_remote : UInt64
  getter max_streams_uni_remote  : UInt64
  getter total_sent      : UInt64
  getter total_received  : UInt64

  @streams : Array(QuicStream)

  def initialize(
    initial_max_data : UInt64 = 1048576_u64,
    initial_max_streams_bidi : UInt64 = 100_u64,
    initial_max_streams_uni : UInt64 = 100_u64
  )
    @max_data_local = initial_max_data
    @max_data_remote = initial_max_data
    @max_streams_bidi_remote = initial_max_streams_bidi
    @max_streams_uni_remote = initial_max_streams_uni
    @total_sent = 0_u64
    @total_received = 0_u64
    @streams = [] of QuicStream
  end

  # Enforces stream limits per RFC 9000 Section 4.6 (Finding 12).
  def can_create_stream?(id_val : UInt64) : Bool
    stream_idx = id_val.unsafe_shr(2_u64)
    is_uni = (id_val & 0x02_u64) != 0_u64
    limit = is_uni ? @max_streams_uni_remote : @max_streams_bidi_remote
    stream_idx < limit
  end

  def get_or_create_stream?(id_val : UInt64) : QuicStream?
    i = 0
    while i < @streams.size
      return @streams[i] if @streams[i].id.id == id_val
      i = i + 1
    end

    return nil unless can_create_stream?(id_val)

    stream = QuicStream.new(StreamId.new(id_val))
    @streams << stream
    stream
  end

  def get_or_create_stream(id_val : UInt64) : QuicStream
    st = get_or_create_stream?(id_val)
    if st.nil?
      stream_idx = id_val.unsafe_shr(2_u64)
      raise "STREAM_LIMIT_ERROR: stream index #{stream_idx} exceeds maximum allowed"
    end
    st
  end

  def can_send_connection?(len : UInt64) : Bool
    (@total_sent + len) <= @max_data_remote
  end

  def record_sent(len : UInt64) : Nil
    @total_sent = @total_sent + len
  end

  def record_received(len : UInt64) : Nil
    @total_received = @total_received + len
  end
end

# =============================================================================
# 9. High-Level QUIC Connection State Machine and UDP Network Endpoint
# =============================================================================

pub struct ConnectionRole
  pub CLIENT = 0
  pub SERVER = 1
end

pub struct ConnectionState
  pub INITIAL   = 0
  pub HANDSHAKE = 1
  pub ACTIVE    = 2
  pub DRAINING  = 3
  pub CLOSED    = 4
end

pub class QuicConnection
  getter role            : Int32
  getter state           : Int32
  getter dcid            : Bytes
  getter scid            : Bytes
  getter stream_manager  : StreamManager
  getter rtt_estimator   : RttEstimator
  getter congestion_ctrl : NewRenoCongestionController

  # Three independent Packet Number Spaces (Finding 1)
  @next_pn : Array(UInt64)
  @largest_received_pn : Array(UInt64)
  @sent_packets : Array(SentPacket)

  # Key bundles per encryption level
  @initial_keys_in  : KeyBundle?
  @initial_keys_out : KeyBundle?
  @handshake_keys_in : KeyBundle?
  @handshake_keys_out : KeyBundle?
  @app_keys_in      : KeyBundle?
  @app_keys_out     : KeyBundle?

  # Crypto stream buffers per space (Finding 7)
  @crypto_send_buf : Array(Bytes)
  @crypto_recv_buf : Array(Bytes)
  @crypto_send_offset : Array(UInt64)

  # Anti-amplification tracking (Finding 14)
  @bytes_received_unvalidated : UInt64
  @bytes_sent_unvalidated     : UInt64
  @address_validated          : Bool

  def initialize(@role : Int32, @dcid : Bytes, @scid : Bytes, initial_dcid : Bytes = Bytes.empty)
    @state = ConnectionState::INITIAL
    @stream_manager = StreamManager.new
    @rtt_estimator = RttEstimator.new
    @congestion_ctrl = NewRenoCongestionController.new

    # Three independent spaces: Initial (0), Handshake (1), AppData (2)
    @next_pn = [0_u64, 0_u64, 0_u64]
    @largest_received_pn = [0_u64, 0_u64, 0_u64]
    @sent_packets = [] of SentPacket

    @crypto_send_buf = [Bytes.empty, Bytes.empty, Bytes.empty]
    @crypto_recv_buf = [Bytes.empty, Bytes.empty, Bytes.empty]
    @crypto_send_offset = [0_u64, 0_u64, 0_u64]

    @bytes_received_unvalidated = 0_u64
    @bytes_sent_unvalidated = 0_u64
    @address_validated = (@role == ConnectionRole::CLIENT)

    # Initial Keys (RFC 9001 Section 5.2)
    init_cid = initial_dcid.empty? ? @dcid : initial_dcid
    client_sec, server_sec = QuicCrypto.derive_initial_secrets(init_cid)
    if @role == ConnectionRole::CLIENT
      @initial_keys_out = QuicCrypto.derive_packet_keys(client_sec)
      @initial_keys_in  = QuicCrypto.derive_packet_keys(server_sec)
    else
      @initial_keys_out = QuicCrypto.derive_packet_keys(server_sec)
      @initial_keys_in  = QuicCrypto.derive_packet_keys(client_sec)
    end
  end

  def bytes_in_flight : Int64
    @congestion_ctrl.bytes_in_flight
  end

  # Installs Handshake traffic keys.
  def install_handshake_keys(client_secret : Bytes, server_secret : Bytes) : Nil
    if @role == ConnectionRole::CLIENT
      @handshake_keys_out = QuicCrypto.derive_packet_keys(client_secret)
      @handshake_keys_in  = QuicCrypto.derive_packet_keys(server_secret)
    else
      @handshake_keys_out = QuicCrypto.derive_packet_keys(server_secret)
      @handshake_keys_in  = QuicCrypto.derive_packet_keys(client_secret)
    end
    @state = ConnectionState::HANDSHAKE
  end

  # Installs 1-RTT Application traffic keys.
  def install_application_keys(client_secret : Bytes, server_secret : Bytes) : Nil
    if @role == ConnectionRole::CLIENT
      @app_keys_out = QuicCrypto.derive_packet_keys(client_secret)
      @app_keys_in  = QuicCrypto.derive_packet_keys(server_secret)
    else
      @app_keys_out = QuicCrypto.derive_packet_keys(server_secret)
      @app_keys_in  = QuicCrypto.derive_packet_keys(client_secret)
    end
    @state = ConnectionState::ACTIVE
    @address_validated = true
  end

  # Buffers TLS 1.3 handshake data to be sent on the CRYPTO stream (Finding 7).
  def feed_crypto_data(space : Int32, data : Bytes) : Nil
    return if data.empty?
    cur = @crypto_send_buf[space]
    new_b = Bytes.new(cur.size + data.size)
    i = 0; while i < cur.size; new_b[i] = cur[i]; i = i + 1; end
    j = 0; while j < data.size; new_b[cur.size + j] = data[j]; j = j + 1; end
    @crypto_send_buf[space] = new_b
  end

  # Reads received TLS 1.3 handshake data from peer's CRYPTO stream (Finding 7).
  def poll_crypto_received(space : Int32) : Bytes
    b = @crypto_recv_buf[space]
    @crypto_recv_buf[space] = Bytes.empty
    b
  end
  # Checks if sending bytes is permitted under server 3x anti-amplification rule (Finding 14)
  def can_send_unvalidated?(packet_size : Int32) : Bool
    return true if @role == ConnectionRole::CLIENT || @address_validated
    limit = @bytes_received_unvalidated * 3_u64
    (@bytes_sent_unvalidated + packet_size.to_u64) <= limit
  end


  # Packages and protects an Initial packet.
  def send_initial_packet(extra_frames : Bytes = Bytes.empty, token : Bytes = Bytes.empty) : Bytes
    keys = @initial_keys_out
    raise "initial keys missing" if keys.nil?

    space = PacketSpace::INITIAL
    pn = @next_pn[space]
    @next_pn[space] = pn + 1_u64
    pn_len = PacketNumber.encode_length(pn, 0_u64)

    # Wire crypto stream data into payload if available (Finding 7)
    payload_parts = [] of Bytes
    total_payload = 0
    if @crypto_send_buf[space].size > 0
      cf = FrameCodec.encode_crypto(@crypto_send_offset[space], @crypto_send_buf[space])
      @crypto_send_offset[space] = @crypto_send_offset[space] + @crypto_send_buf[space].size.to_u64
      @crypto_send_buf[space] = Bytes.empty
      payload_parts << cf
      total_payload = total_payload + cf.size
    end
    if extra_frames.size > 0
      payload_parts << extra_frames
      total_payload = total_payload + extra_frames.size
    end

    raw_payload = Bytes.new(total_payload)
    off = 0
    i = 0
    while i < payload_parts.size
      p = payload_parts[i]
      j = 0; while j < p.size; raw_payload[off + j] = p[j]; j = j + 1; end
      off = off + p.size
      i = i + 1
    end

    # Enforce minimum 1200 byte Client Initial UDP datagram (Finding 4)
    payload = raw_payload
    header_unprot_len = 1 + 4 + 1 + @dcid.size + 1 + @scid.size + (token.size > 0 ? 2 + token.size : 1) + 2 + pn_len
    min_payload = 1200 - header_unprot_len - 16
    if @role == ConnectionRole::CLIENT && payload.size < min_payload
      padded = Bytes.new(min_payload, 0_u8)
      i = 0; while i < payload.size; padded[i] = payload[i]; i = i + 1; end
      payload = padded
    end

    total_len = payload.size.to_u64 + pn_len.to_u64 + 16_u64
    hdr = LongHeader.new(PacketType::INITIAL, QuicVersion::V1, @dcid, @scid, token, total_len, pn, pn_len)
    unprot_hdr = hdr.encode_unprotected
    pn_offset = unprot_hdr.size - pn_len

    packet = QuicCrypto.protect_packet(keys, unprot_hdr, pn_offset, pn_len, pn, payload, is_long_header: true)

    # Server Anti-Amplification Limit (Finding 14)
    if @role == ConnectionRole::SERVER && !@address_validated
      limit = @bytes_received_unvalidated * 3_u64
      if (@bytes_sent_unvalidated + packet.size.to_u64) > limit
        raise "ANTI_AMPLIFICATION_LIMIT: cannot send packet exceeding 3x received bytes"
      end
      @bytes_sent_unvalidated = @bytes_sent_unvalidated + packet.size.to_u64
    end

    @sent_packets << SentPacket.new(space, pn, 1000_i64, true, true, packet.size)
    @congestion_ctrl.on_packet_sent(packet.size)
    packet
  end

  # Packages and protects a Handshake packet (Finding 3, 7).
  def send_handshake_packet(extra_frames : Bytes = Bytes.empty) : Bytes
    keys = @handshake_keys_out
    raise "handshake keys missing" if keys.nil?

    space = PacketSpace::HANDSHAKE
    pn = @next_pn[space]
    @next_pn[space] = pn + 1_u64
    pn_len = PacketNumber.encode_length(pn, 0_u64)

    payload_parts = [] of Bytes
    total_payload = 0
    if @crypto_send_buf[space].size > 0
      cf = FrameCodec.encode_crypto(@crypto_send_offset[space], @crypto_send_buf[space])
      @crypto_send_offset[space] = @crypto_send_offset[space] + @crypto_send_buf[space].size.to_u64
      @crypto_send_buf[space] = Bytes.empty
      payload_parts << cf
      total_payload = total_payload + cf.size
    end
    if extra_frames.size > 0
      payload_parts << extra_frames
      total_payload = total_payload + extra_frames.size
    end

    payload = Bytes.new(total_payload)
    off = 0
    i = 0
    while i < payload_parts.size
      p = payload_parts[i]
      j = 0; while j < p.size; payload[off + j] = p[j]; j = j + 1; end
      off = off + p.size
      i = i + 1
    end

    total_len = payload.size.to_u64 + pn_len.to_u64 + 16_u64
    # Handshake packets have NO token (Finding 3)
    hdr = LongHeader.new(PacketType::HANDSHAKE, QuicVersion::V1, @dcid, @scid, Bytes.empty, total_len, pn, pn_len)
    unprot_hdr = hdr.encode_unprotected
    pn_offset = unprot_hdr.size - pn_len

    packet = QuicCrypto.protect_packet(keys, unprot_hdr, pn_offset, pn_len, pn, payload, is_long_header: true)

    @sent_packets << SentPacket.new(space, pn, 1000_i64, true, true, packet.size)
    @congestion_ctrl.on_packet_sent(packet.size)
    packet
  end

  # Packages and protects a 1-RTT Short Header packet (Finding 2).
  def send_1rtt_packet(payload : Bytes, spin_bit : Bool = false) : Bytes
    keys = @app_keys_out
    raise "1-RTT application keys missing" if keys.nil?

    space = PacketSpace::APP_DATA
    pn = @next_pn[space]
    @next_pn[space] = pn + 1_u64
    pn_len = PacketNumber.encode_length(pn, 0_u64)

    hdr = ShortHeader.new(spin_bit, false, @dcid, pn, pn_len)
    unprot_hdr = hdr.encode_unprotected
    pn_offset = unprot_hdr.size - pn_len

    packet = QuicCrypto.protect_packet(keys, unprot_hdr, pn_offset, pn_len, pn, payload, is_long_header: false)

    @sent_packets << SentPacket.new(space, pn, 1000_i64, true, true, packet.size)
    @congestion_ctrl.on_packet_sent(packet.size)
    packet
  end

  # Receives, unpacks, and processes an incoming datagram (Findings 1, 2, 3, 4, 5, 6).
  def receive_packet(datagram : Bytes) : {Bytes, Array(DecodedFrame)}
    raise "datagram too short" if datagram.size < 21
    @bytes_received_unvalidated = @bytes_received_unvalidated + datagram.size.to_u64

    first_byte = datagram[0]
    is_long = (first_byte & 0x80_u8) != 0_u8

    if is_long
      # Finding 3: inspect packet type
      pkt_type = (first_byte & 0x30_u8).unsafe_shr(4_u8)
      dcid_len = datagram[5].to_i32
      raise "datagram truncated for dcid" if datagram.size < 6 + dcid_len

      scid_offset = 6 + dcid_len
      scid_len = datagram[scid_offset].to_i32
      raise "datagram truncated for scid" if datagram.size < scid_offset + 1 + scid_len

      token_offset = scid_offset + 1 + scid_len
      token_len = 0_u64
      token_len_bytes = 0
      len_offset = 0

      if pkt_type == PacketType::INITIAL
        t_len, tl_bytes = VarInt.decode(datagram, token_offset)
        token_len = t_len
        token_len_bytes = tl_bytes
        len_offset = token_offset + token_len_bytes + token_len.to_i32
      else
        len_offset = scid_offset + 1 + scid_len
      end

      pkt_len, pkt_len_bytes = VarInt.decode(datagram, len_offset)
      pn_offset = len_offset + pkt_len_bytes
      sample_offset = pn_offset + 4
      raise "packet truncated for sampling" if datagram.size < sample_offset + 16

      # Pick key and space
      keys = (pkt_type == PacketType::HANDSHAKE) ? @handshake_keys_in : @initial_keys_in
      raise "read keys missing for long packet" if keys.nil?
      space = (pkt_type == PacketType::HANDSHAKE) ? PacketSpace::HANDSHAKE : PacketSpace::INITIAL

      sample = datagram[sample_offset, 16]
      mask = QuicCrypto.generate_mask(keys.hp, sample)

      hdr_buf = Bytes.new(pn_offset + 4)
      i = 0; while i < hdr_buf.size; hdr_buf[i] = datagram[i]; i = i + 1; end

      pn_len = QuicCrypto.remove_header_protection(hdr_buf, pn_offset, mask, is_long_header: true)
      unprotected_header = Bytes.new(pn_offset + pn_len)
      i = 0; while i < unprotected_header.size; unprotected_header[i] = hdr_buf[i]; i = i + 1; end

      # Finding 5: bounds check on pkt_len
      raise "malformed packet length" if pkt_len.to_i32 < (pn_len + 16)
      payload_len = pkt_len.to_i32 - pn_len
      payload_offset = pn_offset + pn_len
      raise "packet payload truncated" if payload_offset + payload_len > datagram.size

      # Finding 1: decode PN in space
      truncated_pn = 0_u64
      i = 0
      while i < pn_len
        truncated_pn = (truncated_pn.unsafe_shl(8_u64)) | unprotected_header[pn_offset + i].to_u64
        i = i + 1
      end
      pn = PacketNumber.decode(@largest_received_pn[space], truncated_pn, pn_len * 8)
      @largest_received_pn[space] = pn if pn > @largest_received_pn[space]

      nonce = QuicCrypto.compute_nonce(keys.iv, pn)
      ciphertext_and_tag = datagram[payload_offset, payload_len]

      plaintext = AES128GCM.decrypt(keys.key, nonce, ciphertext_and_tag, unprotected_header)
      raise "AEAD decryption failed" if plaintext.nil?

      # Finding 6: decode and process frames
      frames = FrameCodec.decode_frames(plaintext)
      process_frames(frames, space)

      {plaintext, frames}
    else
      # Finding 2: 1-RTT Short Header packet reception
      keys = @app_keys_in
      raise "1-RTT read keys missing" if keys.nil?

      space = PacketSpace::APP_DATA
      dcid_len = @scid.size # Receiver knows its own CID length
      pn_offset = 1 + dcid_len
      sample_offset = pn_offset + 4
      raise "short packet truncated for sampling" if datagram.size < sample_offset + 16

      sample = datagram[sample_offset, 16]
      mask = QuicCrypto.generate_mask(keys.hp, sample)

      hdr_buf = Bytes.new(pn_offset + 4)
      i = 0; while i < hdr_buf.size; hdr_buf[i] = datagram[i]; i = i + 1; end

      pn_len = QuicCrypto.remove_header_protection(hdr_buf, pn_offset, mask, is_long_header: false)
      unprotected_header = Bytes.new(pn_offset + pn_len)
      i = 0; while i < unprotected_header.size; unprotected_header[i] = hdr_buf[i]; i = i + 1; end

      truncated_pn = 0_u64
      i = 0
      while i < pn_len
        truncated_pn = (truncated_pn.unsafe_shl(8_u64)) | unprotected_header[pn_offset + i].to_u64
        i = i + 1
      end
      pn = PacketNumber.decode(@largest_received_pn[space], truncated_pn, pn_len * 8)
      @largest_received_pn[space] = pn if pn > @largest_received_pn[space]

      nonce = QuicCrypto.compute_nonce(keys.iv, pn)
      payload_offset = pn_offset + pn_len
      ciphertext_and_tag = datagram[payload_offset, datagram.size - payload_offset]

      plaintext = AES128GCM.decrypt(keys.key, nonce, ciphertext_and_tag, unprotected_header)
      raise "1-RTT AEAD decryption failed" if plaintext.nil?

      frames = FrameCodec.decode_frames(plaintext)
      process_frames(frames, space)

      {plaintext, frames}
    end
  end

  # Internal frame dispatcher (Finding 6, 7, 10).
  private def process_frames(frames : Array(DecodedFrame), space : Int32) : Nil
    i = 0
    while i < frames.size
      f = frames[i]
      if f.frame_type == FrameType::ACK
        # Finding 10: ACK feedback -> observe bytes_in_flight drop and RTT update
        @rtt_estimator.update_rtt(f.ack_delay.to_i64)

        # Clear acked packets
        new_sent = [] of SentPacket
        j = 0
        while j < @sent_packets.size
          pkt = @sent_packets[j]
          if pkt.packet_space == space && pkt.packet_number <= f.largest_ack
            @congestion_ctrl.on_packet_acked(pkt.size, pkt.time_sent)
          else
            new_sent << pkt
          end
          j = j + 1
        end
        @sent_packets = new_sent
      elsif f.frame_type == FrameType::CRYPTO
        # Finding 7: feed received crypto bytes
        cur = @crypto_recv_buf[space]
        nb = Bytes.new(cur.size + f.data.size)
        k = 0; while k < cur.size; nb[k] = cur[k]; k = k + 1; end
        k = 0; while k < f.data.size; nb[cur.size + k] = f.data[k]; k = k + 1; end
        @crypto_recv_buf[space] = nb
      elsif f.frame_type == FrameType::STREAM_BASE
        # Route to stream
        st = @stream_manager.get_or_create_stream(f.stream_id)
        st.append_recv(f.data, f.fin)
      elsif f.frame_type == FrameType::CONNECTION_CLOSE_QUIC || f.frame_type == FrameType::CONNECTION_CLOSE_APP
        @state = ConnectionState::CLOSED
      end
      i = i + 1
    end
  end
end

# =============================================================================
# 10. UDP Network Driver and Loopback Endpoint (Finding 20)
# =============================================================================

# Drives real QUIC packet transmission and reception over UDP.
pub class QuicEndpoint
  getter socket : UdpSocket

  def initialize(bind_host : String = "127.0.0.1", port : Int32 = 0)
    @socket = UdpSocket.bind(bind_host, port)
    @socket.non_blocking = true
  end

  def local_port : Int32
    @socket.local_port
  end

  def send_to(data : Bytes, host : String, port : Int32) : Int32
    @socket.send_to(data, host, port)
  end

  def receive(max_attempts : Int32 = 1000) : Datagram?
    i = 0
    while i < max_attempts
      d = @socket.receive_datagram?
      return d unless d.nil?
      i = i + 1
    end
    nil
  end

  def close : Nil
    @socket.close
  end
end
