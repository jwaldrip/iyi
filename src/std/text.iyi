# Standard text processing library for iyi.
#
# Answers the two architectural questions:
#
# 1. UTF-8 and byte indexing convention:
#    iyi's `String#size` counts UTF-8 code points (decoded in
#    `src/iyi/string.iyi`, a byte that begins none counted as one U+FFFD),
#    while `bytesize` counts raw bytes.
#    Following the prelude's established convention, all string indexing
#    (`[]`, `[start, count]`), slice operations, and search offsets
#    (`index`, `rindex`, `sub`, `gsub`, `split`) are strictly
#    BYTE-INDEXED.
#    For example, with `s = "héllo"`, `s.size` is 5, `s.bytesize` is 6,
#    `s[1]` is byte 195 (0xC3), `s[2]` is byte 169 (0xA9), and `s.index('l')`
#    returns byte offset 3. This guarantees O(1) indexing and byte-slice
#    alignment without hidden multi-byte traversals.
#    Multi-byte UTF-8 awareness is preserved where character boundaries
#    matter: `Char#to_s` encodes multi-byte Unicode code points into 1 to 4
#    valid UTF-8 bytes rather than truncating to a single byte; `chars`
#    and `each_char` decode full Unicode code points so `"héllo".chars.size`
#    equals `"héllo".size` (5); and `reverse` reverses decoded characters
#    so `"héllo".reverse` produces `"olléh"` rather than invalid byte sequences.
#
# 2. Garbage collector and allocation safety:
#    Every string constructed in this library allocates through
#    `String.new(bytesize) { |buffer| ... }`. This routes directly to
#    `String.memory`, ensuring `IyiHeap.new_object` is called with the
#    canonical `String` type ID, headed=true, atomic=true, and that the
#    object header words (byte length and scanned character count) are
#    properly initialized. No headless buffers, raw pointer arithmetic, or
#    out-of-band allocations are used.
#
# 3. Regular expressions:
#    `sub` and `gsub` here take exact string and character patterns. A
#    pattern is `std/regex`'s `Regex`, iyi's own linear-time engine, which
#    adds `match`, `=~`, `index`, `sub`, `gsub` and `scan` taking a `Regex`
#    to `String`; import both and each call takes the one its argument names.
#
# 4. Scope and omissions from Crystal's string.cr (5,922 lines):
#    Normalization (NFC, NFD, NFKC, NFKD), case folding, the Unicode
#    categories and grapheme clusters are `std/unicode`'s, and regex
#    matching is `std/regex`'s. What neither module nor this one carries:
#    iconv encoding conversions, C string null-byte guards, and decades of
#    legacy Ruby compatibility aliases. This library provides the core operations
#    that real programs reach for: whitespace stripping, splitting, joining,
#    indexing, substitutions, transformations (tr, squeeze, delete, count,
#    center), character inspection, and robust conversions with nilable
#    failure paths.
#
# Written against iyi's own prelude, and only that one. Its `index`, `split`
# and `sub` are byte-indexed by the convention above, which is not Crystal's,
# and the names it gives `::String` and `::Char` are names Crystal has — so
# `import std/text` in a `--crystal` program is refused rather than replacing
# the library's methods under the whole program (SPEC.md III.6).

module std/text

import std/slice
using std/slice::{Slice, Bytes}
pub alias Bytes = Std::Slice::Bytes
alias ::Bytes = Std::Slice::Bytes

struct ::Char
  def ascii_letter? : Bool
    (self >= 'a' && self <= 'z') || (self >= 'A' && self <= 'Z')
  end

  def ascii_number? : Bool
    self >= '0' && self <= '9'
  end

  def ascii_lowercase? : Bool
    self >= 'a' && self <= 'z'
  end

  def ascii_uppercase? : Bool
    self >= 'A' && self <= 'Z'
  end

  def ascii_alphanumeric? : Bool
    ascii_letter? || ascii_number?
  end

  def ascii_whitespace? : Bool
    self == ' ' || self == '\t' || self == '\n' || self == '\r' || self == '\v' || self == '\f'
  end

  def upcase : Char
    (self >= 'a' && self <= 'z') ? (ord - 32).unsafe_chr : self
  end

  def downcase : Char
    (self >= 'A' && self <= 'Z') ? (ord + 32).unsafe_chr : self
  end

  def to_i : Int32
    to_i(10)
  end

  def to_i? : Int32?
    to_i?(10)
  end

  def to_i(base : Int32) : Int32
    to_i?(base) || raise "not a digit in base #{base}: #{inspect}"
  end

  def to_i?(base : Int32) : Int32?
    raise "base #{base} out of range (2..36)" if base < 2 || base > 36
    o = ord
    digit = -1
    if o >= 48 && o <= 57
      digit = o - 48
    elsif o >= 97 && o <= 122
      digit = o - 97 + 10
    elsif o >= 65 && o <= 90
      digit = o - 65 + 10
    else
      return nil
    end
    return nil if digit >= base
    digit
  end
end

class ::String
  # The whitespace `blank?`, `lstrip` and `rstrip` look through is the
  # prelude's `Char#whitespace?`, decoded, so `strip` with no argument agrees
  # with these and with the other library: `"\u3000".blank?` was false.
  def blank? : Bool
    space_end == bytesize
  end

  def presence : String?
    blank? ? nil : self
  end

  def lstrip : String
    first = space_end
    byte_slice(first, bytesize - first)
  end

  # A `Char` above ASCII is more than one byte, and this family narrowed it
  # to one with a checked convert: `"a☃b".index('☃', 0)` panicked with
  # "arithmetic overflow", and so did nine of its siblings. Each asks the
  # character's own bytes now, which is what the string holds.
  def lstrip(char : Char) : String
    text = char.to_s
    at = 0
    while at + text.bytesize <= bytesize && byte_run?(at, text)
      at = at + text.bytesize
    end
    byte_slice(at, bytesize - at)
  end

  # Characters of *chars*, not bytes: a byte mask built from `"©"` (C2 A9)
  # took the last byte of `é` (C3 A9) with it and answered a lone C3, which
  # is not a string. ASCII is the mask; a wider character is looked up whole.
  def lstrip(chars : String) : String
    return self if chars.empty?
    mask = ascii_mask(chars)
    at = 0
    while at < bytesize
      width = point_width(at)
      break unless named_at?(at, width, mask, chars)
      at = at + width
    end
    byte_slice(at, bytesize - at)
  end

  # The ASCII bytes of *chars*, as a 256-entry mask.
  private def ascii_mask(chars : String) : Pointer(Bool)
    mask = Pointer(Bool).malloc(256_u64)
    i = 0
    while i < 256
      mask[i] = false
      i = i + 1
    end
    i = 0
    while i < chars.bytesize
      mask[chars.to_unsafe[i].to_i] = true if chars.to_unsafe[i] < 0x80_u8
      i = i + 1
    end
    mask
  end

  # Whether the *width* bytes at *at*, one character, are one of *chars*. A
  # whole character's bytes are found in well-formed UTF-8 only where that
  # character starts, so the byte search is a character search. A byte that
  # begins no character is U+FFFD, as `each_char` reads it and as `delete`
  # looks it up, and so is one in *chars*: neither was ever named, even by a
  # set holding that very byte.
  private def named_at?(at : Int32, width : Int32, mask : Pointer(Bool), chars : String) : Bool
    return mask[to_unsafe[at].to_i] if to_unsafe[at] < 0x80_u8
    return chars.chars.includes?('\uFFFD') if width == 1 || (width == 3 && byte_run?(at, "\uFFFD"))
    !chars.index(byte_slice(at, width)).nil?
  end

  # The bytes of the character at *at*, by `each_char`'s rule: one for a
  # byte that begins no character. Counting the `10xxxxxx` bytes after a
  # lead instead read an overlong form, a surrogate or a stray continuation
  # byte as part of the character before it.
  private def point_width(at : Int32) : Int32
    lead = to_unsafe[at].to_i32
    width = lead < 0xC2 || lead > 0xF4 ? 1 : lead < 0xE0 ? 2 : lead < 0xF0 ? 3 : 4
    return 1 if width == 1 || at + width > bytesize
    point = lead & (0x7F >> width)
    k = 1
    while k < width
      byte = to_unsafe[at + k].to_i32
      return 1 unless (byte & 0xC0) == 0x80
      point = (point << 6) | (byte & 0x3F)
      k = k + 1
    end
    return 1 if point < (1 << (5 * width - 4)) || point > 0x10FFFF || (point >= 0xD800 && point < 0xE000)
    width
  end

  # Where the character that ends at *stop* starts, by the same rule: a
  # lead whose own width reaches exactly to *stop*, or else the last byte
  # alone.
  private def char_start(stop : Int32) : Int32
    start = stop - 1
    while start > 0 && stop - start < 4 && (to_unsafe[start] & 0xC0_u8) == 0x80_u8
      start = start - 1
    end
    point_width(start) == stop - start ? start : stop - 1
  end

  # Whether every byte is part of a character.
  private def well_formed? : Bool
    each_point { |point| return false if point < 0 }
    true
  end

  def rstrip : String
    byte_slice(0, space_start(0))
  end

  def rstrip(char : Char) : String
    text = char.to_s
    last = bytesize
    while last >= text.bytesize && byte_run?(last - text.bytesize, text)
      last = last - text.bytesize
    end
    byte_slice(0, last)
  end

  # *text*'s bytes at *at*, which is the one question the family shares.
  private def byte_run?(at : Int32, text : String) : Bool
    return false if at < 0 || at + text.bytesize > bytesize
    matched = 0
    while matched < text.bytesize && to_unsafe[at + matched] == text.to_unsafe[matched]
      matched = matched + 1
    end
    matched == text.bytesize
  end

  def rstrip(chars : String) : String
    return self if chars.empty?
    mask = ascii_mask(chars)
    last = bytesize
    while last > 0
      start = char_start(last)
      break unless named_at?(start, last - start, mask, chars)
      last = start
    end
    byte_slice(0, last)
  end

  def strip(char : Char) : String
    lstrip(char).rstrip(char)
  end

  def strip(chars : String) : String
    lstrip(chars).rstrip(chars)
  end

  def chomp : String
    if bytesize >= 2 && to_unsafe[bytesize - 2] == 13_u8 && to_unsafe[bytesize - 1] == 10_u8
      return byte_slice(0, bytesize - 2)
    elsif bytesize >= 1 && (to_unsafe[bytesize - 1] == 10_u8 || to_unsafe[bytesize - 1] == 13_u8)
      return byte_slice(0, bytesize - 1)
    end
    self
  end

  # `"\n"` is every line ending, as `chomp` with no argument reads it and as
  # the other library answers: `"a\r\n".chomp("\n")` is `"a"`.
  def chomp(suffix : String) : String
    return chomp if suffix == "\n"
    return self unless ends_with?(suffix)
    byte_slice(0, bytesize - suffix.bytesize)
  end

  def chop : String
    return "" if empty?
    if bytesize >= 2 && to_unsafe[bytesize - 2] == 13_u8 && to_unsafe[bytesize - 1] == 10_u8
      return byte_slice(0, bytesize - 2)
    end
    # The last character, not the last byte: `"hé".chop` cut `é` in half
    # and answered two bytes that are not a string. The character is the
    # one `each_char` ends with.
    cut = char_start(bytesize)
    byte_slice(0, cut)
  end

  def ends_with?(char : Char) : Bool
    ends_with?(char.to_s)
  end

  # No limit is `nil`, and one of 1 or less is the string whole, as the
  # other library answers both. A negative limit split everything, and 0
  # stood for none: `"a,b".split(",", -1)` was `["a", "b"]` here and
  # `["a,b"]` there. An empty string is one empty piece whatever the
  # limit, as it is without one: `"".split(",", -1)` was `[]`.
  def split(separator : String, limit : Int32? = nil) : Array(String)
    return [self] if empty? || (limit && limit <= 1)
    limit = limit || 0

    # Characters, and the limit counts them as it counts any other piece:
    # `"abc".split("", 2)` is `["a", "bc"]`. A byte that begins no
    # character is a U+FFFD piece and the rest starts at the byte after it:
    # it moved on by the bytes of the character written, and 80 61 62 split
    # in two was C2 80 and `b`, the `a` lost.
    if separator.empty?
      pieces = [] of String
      each_point do |point, at|
        return pieces << byte_slice(at, bytesize - at) if limit > 1 && pieces.size == limit - 1
        pieces << (point < 0 ? '\uFFFD' : point.unsafe_chr).to_s
      end
      return pieces
    end

    pieces = [] of String
    sep_size = separator.bytesize
    start = 0
    while (idx = index(separator, start))
      pieces << byte_slice(start, idx - start)
      start = idx + sep_size
      if limit > 1 && pieces.size == limit - 1
        break
      end
    end
    pieces << byte_slice(start, bytesize - start)
    pieces
  end

  def split(separator : Char, limit : Int32?) : Array(String)
    split(separator.to_s, limit)
  end

  def split : Array(String)
    split(nil)
  end

  def split(limit : Int32?) : Array(String)
    return [self] if limit && limit <= 1
    limit = limit || 0
    pieces = [] of String
    in_token = false
    token_start = 0
    i = 0
    while i < bytesize
      b = to_unsafe[i].unsafe_chr
      if b.ascii_whitespace?
        if in_token
          pieces << byte_slice(token_start, i - token_start)
          in_token = false
          if limit > 1 && pieces.size == limit - 1
            j = i + 1
            while j < bytesize && to_unsafe[j].unsafe_chr.ascii_whitespace?
              j = j + 1
            end
            if j < bytesize
              pieces << byte_slice(j, bytesize - j)
            end
            return pieces
          end
        end
      else
        unless in_token
          token_start = i
          in_token = true
        end
      end
      i = i + 1
    end
    if in_token
      pieces << byte_slice(token_start, bytesize - token_start)
    end
    pieces
  end

  def index(char : Char, offset : Int32) : Int32?
    index(char.to_s, offset)
  end

  def index(search : String, offset : Int32 = 0) : Int32?
    offset = bytesize + offset if offset < 0
    return nil if offset < 0
    return offset if search.bytesize == 0 && offset <= bytesize
    # Room left, not an end: `offset + search.bytesize` overflowed for an
    # offset near the top of `Int32` and panicked where the answer is nil.
    return nil if offset > bytesize - search.bytesize
    byte_index(search, offset)
  end

  def rindex(char : Char, offset : Int32) : Int32?
    rindex(char.to_s, offset)
  end

  def rindex(char : Char) : Int32?
    rindex(char.to_s)
  end

  def rindex(search : String, offset : Int32) : Int32?
    offset = bytesize + offset if offset < 0
    return nil if offset < 0
    s_len = search.bytesize
    return offset if s_len == 0 && offset <= bytesize
    return nil if bytesize < s_len

    max_start = bytesize - s_len
    i = offset > max_start ? max_start : offset

    s_ptr = to_unsafe
    t_ptr = search.to_unsafe

    # Backwards, the way `byte_index` goes forwards: naive while that is
    # cheap, a rolling hash once more than four bytes a position have been
    # compared, so a needle that keeps almost matching is not n * m - 477
    # ms for 1,000 `a` and a `b` in a megabyte of `a`.
    start = i
    spent = 0
    while i >= 0
      j = 0
      while j < s_len && s_ptr[i + j] == t_ptr[j]
        j = j + 1
      end
      return i if j == s_len
      spent = spent + j
      break if spent > 4 * (start - i) + 64
      i = i - 1
    end
    return nil if i < 0

    # The window's hash with its first byte as the lowest power, so that a
    # step left drops the top byte and brings one in at the bottom.
    prime = 16777619_u64
    scale = 1_u64
    top = 1_u64
    want = 0_u64
    have = 0_u64
    k = 0
    while k < s_len
      want = want &+ t_ptr[k].to_u64 &* scale
      have = have &+ s_ptr[i + k].to_u64 &* scale
      top = scale
      scale = scale &* prime
      k = k + 1
    end
    while true
      if have == want
        j = 0
        while j < s_len && s_ptr[i + j] == t_ptr[j]
          j = j + 1
        end
        return i if j == s_len
      end
      return nil if i == 0
      have = (have &- s_ptr[i + s_len - 1].to_u64 &* top) &* prime &+ s_ptr[i - 1].to_u64
      i = i - 1
    end
  end

  def rindex(search : String) : Int32?
    rindex(search, bytesize - search.bytesize)
  end

  def sub(search : String, replacement : String) : String
    idx = index(search)
    return self unless idx
    byte_slice(0, idx) + replacement + byte_slice(idx + search.bytesize, bytesize - idx - search.bytesize)
  end

  def sub(search : Char, replacement : Char) : String
    sub(search.to_s, replacement.to_s)
  end

  def sub(search : Char, replacement : String) : String
    sub(search.to_s, replacement)
  end

  def sub(search : String, & : String -> String) : String
    idx = index(search)
    return self unless idx
    repl = yield search
    byte_slice(0, idx) + repl + byte_slice(idx + search.bytesize, bytesize - idx - search.bytesize)
  end

  # The character's own bytes, as the non-block form asks: narrowed to one
  # byte, `'☃'` panicked with "arithmetic overflow" and `'é'` matched nothing.
  def sub(search : Char, & : Char -> String) : String
    text = search.to_s
    idx = index(text)
    return self unless idx
    repl = yield search
    byte_slice(0, idx) + repl + byte_slice(idx + text.bytesize, bytesize - idx - text.bytesize)
  end

  # An empty search matches before every character and at the end, as
  # `sub` matches it at the start: `"abc".gsub("", "-")` is `"-a-b-c-"`, the
  # other library's answer, where it was `"abc"`. A byte that begins no
  # character is kept, a unit of its own.
  def gsub(search : String, replacement : String) : String
    return gsub(search) { replacement } if search.empty?
    pieces = split(search)
    pieces.join(replacement)
  end

  def gsub(search : Char, replacement : Char) : String
    gsub(search.to_s, replacement.to_s)
  end

  def gsub(search : Char, replacement : String) : String
    gsub(search.to_s, replacement)
  end

  def gsub(search : String, & : String -> String) : String
    # The empty search of `gsub("", replacement)` above.
    if search.empty?
      return String.build(bytesize + 16) do |io|
        start = 0
        each_point do |_, at|
          io.write(to_unsafe + start, at - start)
          io << yield search
          start = at
        end
        io.write(to_unsafe + start, bytesize - start)
        io << yield search
      end
    end
    idx = index(search)
    return self unless idx

    start = 0
    s_len = search.bytesize
    String.build(bytesize) do |io|
      while (idx = index(search, start))
        io.write(to_unsafe + start, idx - start)
        io << yield search
        start = idx + s_len
      end
      io.write(to_unsafe + start, bytesize - start)
    end
  end

  def gsub(search : Char, & : Char -> String) : String
    text = search.to_s
    idx = index(text)
    return self unless idx

    start = 0
    s_len = text.bytesize
    String.build(bytesize) do |io|
      while (idx = index(text, start))
        io.write(to_unsafe + start, idx - start)
        io << yield search
        start = idx + s_len
      end
      io.write(to_unsafe + start, bytesize - start)
    end
  end

  def capitalize : String
    return "" if empty?
    String.new(bytesize) do |buffer|
      b0 = to_unsafe[0]
      buffer[0] = (b0 >= 97_u8 && b0 <= 122_u8) ? (b0 - 32_u8) : b0
      i = 1
      while i < bytesize
        b = to_unsafe[i]
        buffer[i] = (b >= 65_u8 && b <= 90_u8) ? (b + 32_u8) : b
        i = i + 1
      end
    end
  end

  # Mapped per character. The 256-entry byte table this used could not hold
  # a character above ASCII: `"a☃".tr("☃", "x")` answered `"axxx"`, one `x`
  # per byte of the character it was asked to replace once. Both sets name
  # runs: `a-z` is the twenty-six letters, and a `-` at either end is
  # itself, as the other library's `delete` sets read them. Its `tr` pairs
  # the characters positionally, a `-` among them, so
  # `"bab".tr("a-c", "A-C")` is `"bAb"` there and `"BAB"` here.
  #
  # Both sets in ASCII - the common case, and a DNA complement's - are one
  # 256-entry byte table built once and one pass over the bytes, which a
  # character above ASCII passes through untouched because none of its
  # bytes is under 0x80. A byte that begins no character is not one of
  # those: the table kept it as it stood where the per-character map
  # writes U+FFFD, so text holding one takes that map too. Otherwise the
  # map is per character. A `to` shorter than `from` repeats its last
  # character, which is the rule the other library follows; an empty one
  # deletes the character. Each character was looked up in an array of
  # one-character strings and the answer appended to a string rebuilt every
  # time, and a 130 MB `tr` did not finish.
  def tr(from : String, to : String) : String
    return self if from.empty?
    sources = tr_set(from)
    targets = tr_set(to)
    return tr_bytes(sources, targets) if sources.all? { |c| c.ord < 0x80 } && targets.all? { |c| c.ord < 0x80 } && well_formed?

    String.build(bytesize) do |io|
      each_char do |c|
        at = sources.index(c)
        if at.nil?
          io << c
        elsif !targets.empty?
          io << (at < targets.size ? targets[at] : targets[targets.size - 1])
        end
      end
    end
  end

  # The byte table: -1 keeps a byte, -2 deletes it, anything else is the
  # byte it becomes. The first time a source names a byte is the one that
  # counts, as `index` found it before.
  private def tr_bytes(sources : Array(Char), targets : Array(Char)) : String
    table = Pointer(Int32).malloc(256_u64)
    i = 0
    while i < 256
      table[i] = -1
      i = i + 1
    end
    i = sources.size - 1
    while i >= 0
      table[sources[i].ord] = if targets.empty?
                                -2
                              elsif i < targets.size
                                targets[i].ord
                              else
                                targets[targets.size - 1].ord
                              end
      i = i - 1
    end
    source = to_unsafe
    if targets.empty?
      return String.build(bytesize) do |io|
        at = 0
        while at < bytesize
          byte = source[at]
          io.write_byte(byte) unless table[byte.to_i32] == -2
          at = at + 1
        end
      end
    end
    String.new(bytesize) do |buffer|
      at = 0
      while at < bytesize
        byte = source[at]
        mapped = table[byte.to_i32]
        buffer[at] = mapped < 0 ? byte : mapped.to_u8
        at = at + 1
      end
    end
  end

  # The characters *set* names, one string each: a `-` between two of them
  # is the run from the first to the second, and one that runs backwards
  # is a mistake rather than an empty run.
  private def tr_set(set : String) : Array(Char)
    chars = set.chars
    named = [] of Char
    i = 0
    while i < chars.size
      if chars[i] == '-' && i > 0 && i + 1 < chars.size
        low = chars[i - 1].ord
        high = chars[i + 1].ord
        if high < low
          raise "text: tr range #{chars[i - 1]}-#{chars[i + 1]} runs backwards"
        end
        cp = low + 1
        # A surrogate is not a character, and written it is three bytes
        # that read back as three U+FFFD.
        while cp <= high
          named << cp.unsafe_chr unless cp >= 0xD800 && cp < 0xE000
          cp = cp + 1
        end
        i = i + 2
      else
        named << chars[i]
        i = i + 1
      end
    end
    named
  end

  def delete(char : Char) : String
    deleted { |c| c == char }
  end

  # The characters in every one of *sets*, as `count` reads them. Characters,
  # not bytes: a 256-entry byte mask cannot hold a character above ASCII,
  # and deleting one byte of one leaves the rest behind.
  def delete(*sets : String) : String
    compiled = compiled_sets(sets)
    deleted { |c| in_sets?(c.ord, compiled) }
  end

  private def deleted(& : Char -> Bool) : String
    String.build(bytesize) do |io|
      each_char { |c| io << c unless yield c }
    end
  end

  # A run of one character becomes one of it, a character being what
  # `each_char` yields, so a run of bytes that begin none is one U+FFFD, as
  # in the other library; grouped by their `10xxxxxx` bytes, C3 41 came back
  # as it was. A byte at a time, `"耀".squeeze` (E8 80 80) dropped a
  # continuation byte and answered two bytes that are not a string, and
  # `"éé"` stayed two.
  def squeeze : String
    String.build(bytesize) do |io|
      previous = -1
      each_point do |point|
        point = 0xFFFD if point < 0
        io << point.unsafe_chr unless point == previous
        previous = point
      end
    end
  end

  def squeeze(char : Char) : String
    squeezed { |c| c == char }
  end

  # A run of the same character in every one of *sets* becomes one of it.
  # Compared per character, so a multi-byte one is a run rather than three
  # bytes that never match.
  def squeeze(*sets : String) : String
    compiled = compiled_sets(sets)
    squeezed { |c| in_sets?(c.ord, compiled) }
  end

  private def squeezed(& : Char -> Bool) : String
    String.build(bytesize) do |io|
      started = false
      previous = ' '
      each_char do |c|
        next if started && c == previous && (yield c)
        io << c
        previous = c
        started = true
      end
    end
  end

  def count(char : Char) : Int32
    total = 0
    each_char { |c| total = total + 1 if c == char }
    total
  end

  # The characters in every one of *sets*, a set read as the other
  # library's `Char#in_set?` reads one: `"hello world".count("a-z")` is 10
  # and `"hello".count("^l")` is 3. This counted *sets* as a substring, so
  # `"banana".count("an")` was 2 here and 5 there, and a range or a `^`
  # was text: `count("a-z")` was 0, and `delete` and `squeeze` took the
  # set as a list of the characters written.
  def count(*sets : String) : Int32
    compiled = compiled_sets(sets)
    total = 0
    each_char { |c| total = total + 1 if in_sets?(c.ord, compiled) }
    total
  end

  private def compiled_sets(sets : Tuple) : Array(Array(Int32))
    compiled = Array(Array(Int32)).new(sets.size)
    i = 0
    while i < sets.size
      compiled << set_runs(sets[i])
      i = i + 1
    end
    compiled
  end

  # A set compiled once, as runs of code points `low, high, answer` in the
  # order the set names them, and last the answer for a character in none.
  # The reading is the other library's: a `^` first negates the set, `a-z`
  # is a run and one that runs backwards a mistake, a `-` first or last is
  # itself, and a `\` makes the `^` or `-` after it itself. That reader
  # answers at the first spelling a character matches, which is why the
  # order is kept: `"^-a"` is the run `^-a`, not a negation.
  private def set_runs(set : String) : Array(Int32)
    runs = [] of Int32
    kept = 1
    ranging = false
    previous = -1
    set.each_char do |char|
      point = char.ord
      if point == 94 && previous < 0
        kept = 0
        previous = point
        next
      end
      if point == 45
        if previous >= 0 && previous != 92
          ranging = true
          kept = 1 if previous == 94
          next
        end
        runs << point << point << kept
      end
      if ranging
        raise "text: set range #{previous.unsafe_chr}-#{char} runs backwards" if previous > point
        runs << previous << point << kept
        ranging = false
      elsif point != 92
        runs << point << point << kept
      end
      previous = point
    end
    runs << 45 << 45 << kept if ranging
    runs << 92 << 92 << kept if previous == 92
    runs << 1 - kept
    runs
  end

  # Whether *point* is in every compiled set: the first run holding it
  # answers for its set, and the set's last entry answers otherwise.
  private def in_sets?(point : Int32, compiled : Array(Array(Int32))) : Bool
    s = 0
    while s < compiled.size
      runs = compiled[s]
      last = runs.size - 1
      answer = runs[last]
      i = 0
      while i < last
        if runs[i] <= point && point <= runs[i + 1]
          answer = runs[i + 2]
          break
        end
        i = i + 3
      end
      return false if answer == 0
      s = s + 1
    end
    true
  end

  # The width is in characters, because `size` is and because a centred
  # column is a visual claim: padded by bytes, `"héllo".center(9, '.')` came
  # back seven characters wide on one side and eight long in all. The pad
  # travels as its own bytes, so a multi-byte one is a character rather than
  # its first byte three times.
  def center(width : Int32, pad : Char = ' ') : String
    center(width, pad.to_s)
  end

  def center(width : Int32, pad : String) : String
    raise "empty padding" if pad.empty?
    count = size
    return self if width <= count
    extra = width - count
    left = extra // 2
    cycled(pad, left) + self + cycled(pad, extra - left)
  end

  # *count* characters of *pad*, repeating: `"hello".center(12, "-=")` is
  # `"-=-hello-=-="`, which is the pad cycled rather than whole copies of it.
  # Characters, so a multi-byte pad is one unit of width.
  private def cycled(pad : String, count : Int32) : String
    return "" if count <= 0
    String.build do |io|
      taken = 0
      while taken < count
        pad.each_char do |c|
          if taken < count
            io << c
            taken = taken + 1
          end
        end
      end
    end
  end

  def chars : Array(Char)
    arr = [] of Char
    each_char do |c|
      arr << c
    end
    arr
  end

  def bytes : Array(UInt8)
    arr = [] of UInt8
    i = 0
    while i < bytesize
      arr << to_unsafe[i]
      i = i + 1
    end
    arr
  end

  def each_byte(& : UInt8 -> Nil) : Nil
    i = 0
    while i < bytesize
      yield to_unsafe[i]
      i = i + 1
    end
  end

  # Scanned, a line at a time: `lines` first built the whole array - 2.4
  # million strings for a 143 MB text - and `chomp` a second string for each.
  # The same lines, a final newline closing the last rather than opening an
  # empty one, and a `\r` before a newline left off.
  def each_line(& : String -> Nil) : Nil
    source = to_unsafe
    start = 0
    at = 0
    while at < bytesize
      if source[at] == 10_u8
        stop = at > start && source[at - 1] == 13_u8 ? at - 1 : at
        yield byte_slice(start, stop - start)
        start = at + 1
      end
      at = at + 1
    end
    if start < bytesize
      # No newline after it, so a `\r` here is text: `"b\r"` is `"b\r"`.
      yield byte_slice(start, bytesize - start)
    end
  end

  def to_i(base : Int32) : Int32
    to_i?(base) || raise "not a number in base #{base}: #{inspect}"
  end

  # Whitespace before and after the number is not part of it, as the other
  # library reads one (`Char#whitespace?`, so a no-break space too); inside
  # it is still refused. `" 42".to_i64?`, `"ff ".to_i?(16)` and a line
  # read with its `\n` were nil here, and 42 and 255 there.
  def to_i?(base : Int32) : Int32?
    raise "base #{base} out of range (2..36)" if base < 2 || base > 36
    index = space_end
    stop = space_start(index)
    return nil if index == stop

    negative = to_unsafe[index] == 45_u8
    if negative || to_unsafe[index] == 43_u8
      return nil if index + 1 == stop
      index = index + 1
    end

    # Accumulated as a negative magnitude, because that is the range that
    # holds every value: `Int32::MIN` has no positive twin, so a parser that
    # builds `2147483648` first cannot read what `Int32::MIN.to_s` wrote, and
    # with checked arithmetic it panicked rather than answering the `nil` a
    # `?` promises. The two bounds below are that limit divided by the base
    # and what is left of it, so the last digit is checked before it is used.
    limit = -2147483648
    bound = limit // base
    cutoff = 0 - (limit - bound * base)

    value = 0
    while index < stop
      b = to_unsafe[index]
      digit = -1
      if b >= 48_u8 && b <= 57_u8
        digit = (b - 48_u8).to_i
      elsif b >= 97_u8 && b <= 122_u8
        digit = (b - 97_u8).to_i + 10
      elsif b >= 65_u8 && b <= 90_u8
        digit = (b - 65_u8).to_i + 10
      else
        return nil
      end
      return nil if digit >= base
      return nil if value < bound || (value == bound && digit > cutoff)
      value = value * base - digit
      index = index + 1
    end

    return value if negative
    return nil if value == limit
    0 - value
  end

  # The unsigned 64-bit reading, for the checksums and hashes a port keeps
  # in `UInt64`: digits in *base*, an optional `+`, and nil for a sign,
  # anything that is not a digit, or a value past 18446744073709551615.
  def to_u64 : UInt64
    to_u64? || raise "not a number: #{inspect}"
  end

  def to_u64(base : Int32) : UInt64
    to_u64?(base) || raise "not a number in base #{base}: #{inspect}"
  end

  def to_u64? : UInt64?
    to_u64?(10)
  end

  def to_u64?(base : Int32) : UInt64?
    raise "base #{base} out of range (2..36)" if base < 2 || base > 36
    index = space_end
    stop = space_start(index)
    index = index + 1 if index < stop && to_unsafe[index] == 43_u8
    return nil if index == stop
    radix = base.to_u64
    value = 0_u64
    while index < stop
      b = to_unsafe[index]
      digit = if b >= 48_u8 && b <= 57_u8
                (b - 48_u8).to_u64
              elsif b >= 97_u8 && b <= 122_u8
                (b - 97_u8).to_u64 + 10_u64
              elsif b >= 65_u8 && b <= 90_u8
                (b - 65_u8).to_u64 + 10_u64
              else
                return nil
              end
      return nil if digit >= radix
      return nil if value > (18446744073709551615_u64 - digit).unsafe_div(radix)
      value = value * radix + digit
      index = index + 1
    end
    value
  end

  # `s[1..3]`, `s[-3..-1]`: the bytes a range names, its ends counted from
  # the back when negative, as `[](start, count)` counts them.
  def [](range : Range(Int32, Int32)) : String
    # In 64 bits: `0..Int32::MAX` overflowed counting its bytes, and so did
    # an exclusive end of `Int32::MIN`.
    first = (range.begin < 0 ? bytesize + range.begin : range.begin).to_i64
    last = (range.end < 0 ? bytesize + range.end : range.end).to_i64
    last = last - 1 if range.exclusive?
    count = last - first + 1
    self[range.begin, count < 0 ? 0 : (count > bytesize ? bytesize : count.to_i32)]
  end

  def to_i64 : Int64
    to_i64? || raise "not a number: #{inspect}"
  end

  def to_i64(base : Int32) : Int64
    to_i64?(base) || raise "not a number in base #{base}: #{inspect}"
  end

  def to_i64? : Int64?
    to_i64?(10)
  end

  def to_i64?(base : Int32) : Int64?
    raise "base #{base} out of range (2..36)" if base < 2 || base > 36
    index = space_end
    stop = space_start(index)
    return nil if index == stop

    negative = to_unsafe[index] == 45_u8
    if negative || to_unsafe[index] == 43_u8
      return nil if index + 1 == stop
      index = index + 1
    end

    # The same negative accumulation, for the type whose own `MIN` a program
    # is most likely to read back: a nanosecond timestamp is an `Int64`.
    radix = base.to_i64
    limit = -9223372036854775808_i64
    bound = limit // radix
    cutoff = 0_i64 - (limit - bound * radix)

    value = 0_i64
    while index < stop
      b = to_unsafe[index]
      digit = -1_i64
      if b >= 48_u8 && b <= 57_u8
        digit = (b - 48_u8).to_i64
      elsif b >= 97_u8 && b <= 122_u8
        digit = (b - 97_u8).to_i64 + 10_i64
      elsif b >= 65_u8 && b <= 90_u8
        digit = (b - 65_u8).to_i64 + 10_i64
      else
        return nil
      end
      return nil if digit >= radix
      return nil if value < bound || (value == bound && digit > cutoff)
      value = value * radix - digit
      index = index + 1
    end

    return value if negative
    return nil if value == limit
    0_i64 - value
  end

  # The other library's reading, whitespace around it aside: a sign, then
  # `inf`, `infinity` or `nan` in any case (a `nan` may close with a `(...)`
  # of letters, digits and `_`), or decimal digits. Text whose value leaves
  # the range is nil, as that reader's ERANGE makes it: nonzero digits that
  # round to zero, or digits that round past the largest double. Here
  # `"1e400".to_f?` was Infinity, `"1e-400".to_f?` 0.0, and only `Infinity`
  # and `NaN` spelled so were words: `"inf".to_f?` was nil.
  def to_f? : Float64?
    bytes = to_unsafe
    first = space_end
    stop = space_start(first)
    at = first
    negative = at < stop && bytes[at] == 45_u8
    at = at + 1 if negative || (at < stop && bytes[at] == 43_u8)
    return nil if at >= stop

    if word_at?(at, stop, "nan")
      return nil unless at + 3 == stop || nan_payload?(at + 3, stop)
      return 0.0 / 0.0
    end
    if word_at?(at, stop, "inf")
      return nil unless at + 3 == stop || (at + 8 == stop && word_at?(at + 3, stop, "inity"))
      return negative ? -1.0 / 0.0 : 1.0 / 0.0
    end

    seen_point = false
    any_digit = false
    nonzero = false

    while at < stop
      b = bytes[at]
      if b >= 48_u8 && b <= 57_u8
        any_digit = true
        nonzero = true if b != 48_u8
      elsif b == 46_u8 && !seen_point
        seen_point = true
      elsif (b == 101_u8 || b == 69_u8) && any_digit
        at = at + 1
        return nil if at >= stop
        if bytes[at] == 45_u8 || bytes[at] == 43_u8
          at = at + 1
        end
        return nil if at >= stop
        while at < stop
          eb = bytes[at]
          return nil if eb < 48_u8 || eb > 57_u8
          at = at + 1
        end
        break
      else
        return nil
      end
      at = at + 1
    end

    return nil unless any_digit
    value = IyiFloatText.parse(first == 0 && stop == bytesize ? self : byte_slice(first, stop - first))
    return nil if nonzero && value == 0.0
    return nil if value * 0.0 != 0.0
    value
  end

  # Whether the bytes at *at* spell *word*, which is lower-case, in any case.
  private def word_at?(at : Int32, stop : Int32, word : String) : Bool
    return false if at + word.bytesize > stop
    i = 0
    while i < word.bytesize
      return false unless (to_unsafe[at + i] | 0x20_u8) == word.to_unsafe[i]
      i = i + 1
    end
    true
  end

  # A `(...)` of letters, digits and `_` running to *stop*.
  private def nan_payload?(at : Int32, stop : Int32) : Bool
    return false unless stop - at >= 2 && to_unsafe[at] == 40_u8 && to_unsafe[stop - 1] == 41_u8
    i = at + 1
    while i < stop - 1
      b = to_unsafe[i]
      letter = (b | 0x20_u8) >= 97_u8 && (b | 0x20_u8) <= 122_u8
      return false unless letter || (b >= 48_u8 && b <= 57_u8) || b == 95_u8
      i = i + 1
    end
    true
  end

  # The characters in reverse, found from the back by `each_char`'s rule,
  # so each character's bytes are copied as they stand and a byte that
  # begins no character is one of its own: taking every `10xxxxxx` byte
  # with the lead before it kept `C0 80` and a stray byte after `é` whole.
  # It decoded the whole string into an array of `Char`s first - four
  # bytes each, 520 MB to reverse 130 MB of ASCII.
  def reverse : String
    source = to_unsafe
    String.new(bytesize) do |buffer|
      at = 0
      stop = bytesize
      while stop > 0
        start = char_start(stop)
        k = start
        while k < stop
          buffer[at] = source[k]
          at = at + 1
          k = k + 1
        end
        stop = start
      end
    end
  end

  def partition(separator : String) : Tuple(String, String, String)
    idx = index(separator)
    if idx
      {byte_slice(0, idx), separator, byte_slice(idx + separator.bytesize, bytesize - idx - separator.bytesize)}
    else
      {self, "", ""}
    end
  end

  def partition(separator : Char) : Tuple(String, String, String)
    partition(separator.to_s)
  end

  def rpartition(separator : String) : Tuple(String, String, String)
    idx = rindex(separator)
    if idx
      {byte_slice(0, idx), separator, byte_slice(idx + separator.bytesize, bytesize - idx - separator.bytesize)}
    else
      {"", "", self}
    end
  end

  def rpartition(separator : Char) : Tuple(String, String, String)
    rpartition(separator.to_s)
  end

  def self.join(items : Array(String), separator : String = "") : String
    items.join(separator)
  end

  # Into one builder, as `Enumerable#join` is and for its reason.
  def self.join(items, separator : String = "") : String
    String.build do |io|
      first = true
      items.each do |item|
        io << separator unless first
        io << item.to_s
        first = false
      end
    end
  end

  def byte_slice?(start : Int32, count : Int32) : String?
    return nil if count < 0
    start = bytesize + start if start < 0
    return nil if start < 0 || start > bytesize
    available = bytesize - start
    taken = count < available ? count : available
    String.new(taken) do |buffer|
      buffer.copy_from(to_unsafe + start, taken)
    end
  end

  def byte_slice(range : Range(Int32, Int32)) : String
    byte_slice?(range) || raise "Range #{range.begin}..#{range.end} out of bounds for bytesize #{bytesize}"
  end

  def byte_slice?(range : Range(Int32, Int32)) : String?
    b = range.begin
    e = range.end
    b = bytesize + b if b < 0
    e = bytesize + e if e < 0
    return nil if b < 0 || b > bytesize
    e = bytesize if e > bytesize
    count = range.exclusive? ? e - b : e - b + 1
    count = 0 if count < 0
    byte_slice?(b, count)
  end

  def ascii_only? : Bool
    bytesize == size
  end

  def present? : Bool
    !blank?
  end

  def same?(other : String) : Bool
    to_unsafe.address == other.to_unsafe.address
  end

  def <=>(other : String) : Int32
    return 0 if same?(other)
    min_len = bytesize < other.bytesize ? bytesize : other.bytesize
    p1 = to_unsafe
    p2 = other.to_unsafe
    i = 0
    while i < min_len
      b1 = p1[i]
      b2 = p2[i]
      if b1 != b2
        return b1 < b2 ? -1 : 1
      end
      i += 1
    end
    bytesize < other.bytesize ? -1 : (bytesize > other.bytesize ? 1 : 0)
  end

  def compare(other : String, case_insensitive : Bool = false) : Int32
    unless case_insensitive
      return self <=> other
    end
    s1 = downcase
    s2 = other.downcase
    s1 <=> s2
  end

  def to_slice : Bytes
    Bytes.new(to_unsafe, bytesize)
  end

  def char_at(index : Int32) : Char
    char_at?(index) || raise "Index #{index} out of range for string of size #{size}"
  end

  def char_at?(index : Int32) : Char?
    index = size + index if index < 0
    return nil if index < 0 || index >= size
    if single_byte_optimizable?
      return to_unsafe[index].unsafe_chr
    end
    ch = chars
    index < ch.size ? ch[index] : nil
  end

  def byte_at(index : Int32) : UInt8
    byte_at?(index) || raise "Index #{index} out of range for string of bytesize #{bytesize}"
  end

  def byte_at?(index : Int32) : UInt8?
    index = bytesize + index if index < 0
    return nil if index < 0 || index >= bytesize
    to_unsafe[index]
  end

  def codepoint_at(index : Int32) : Int32
    char_at(index).ord
  end

  def char_index_to_byte_index(index : Int32) : Int32?
    return nil if index < 0
    return index if single_byte_optimizable? && index <= bytesize
    if index == 0
      return 0
    end
    byte_idx = 0
    char_idx = 0
    ptr = to_unsafe
    b_size = bytesize
    while byte_idx < b_size
      if char_idx == index
        return byte_idx
      end
      b = ptr[byte_idx].to_i
      if (b & 0x80) == 0
        byte_idx += 1
      elsif (b & 0xE0) == 0xC0
        byte_idx += 2
      elsif (b & 0xF0) == 0xE0
        byte_idx += 3
      elsif (b & 0xF8) == 0xF0
        byte_idx += 4
      else
        byte_idx += 1
      end
      char_idx += 1
    end
    char_idx == index ? byte_idx : nil
  end

  def byte_index_to_char_index(index : Int32) : Int32?
    return nil if index < 0 || index > bytesize
    return index if single_byte_optimizable?
    if index == 0
      return 0
    end
    byte_idx = 0
    char_idx = 0
    ptr = to_unsafe
    while byte_idx < index
      b = ptr[byte_idx].to_i
      if (b & 0x80) == 0
        byte_idx += 1
      elsif (b & 0xE0) == 0xC0
        byte_idx += 2
      elsif (b & 0xF0) == 0xE0
        byte_idx += 3
      elsif (b & 0xF8) == 0xF0
        byte_idx += 4
      else
        byte_idx += 1
      end
      char_idx += 1
    end
    byte_idx == index ? char_idx : nil
  end

  def delete_at(index : Int32) : String
    delete_at(index, 1)
  end

  def delete_at(start : Int32, count : Int32) : String
    raise "negative count: #{count}" if count < 0
    start = size + start if start < 0
    raise "start #{start} out of bounds for size #{size}" if start < 0 || start > size
    if single_byte_optimizable?
      b_start = start
      b_count = count < (bytesize - b_start) ? count : (bytesize - b_start)
      byte_slice(0, b_start) + byte_slice(b_start + b_count, bytesize - b_start - b_count)
    else
      ch = chars
      res = ""
      i = 0
      while i < ch.size
        res = res + ch[i].to_s unless i >= start && i < start + count
        i += 1
      end
      res
    end
  end

  def delete_at(range : Range(Int32, Int32)) : String
    b = range.begin
    e = range.end
    b = size + b if b < 0
    e = size + e if e < 0
    count = range.exclusive? ? e - b : e - b + 1
    count = 0 if count < 0
    delete_at(b, count)
  end

  def insert(index : Int32, other : String) : String
    index = size + 1 + index if index < 0
    raise "index #{index} out of bounds for size #{size}" if index < 0 || index > size
    if single_byte_optimizable?
      byte_slice(0, index) + other + byte_slice(index, bytesize - index)
    else
      ch = chars
      res = ""
      i = 0
      while i <= ch.size
        if i == index
          res = res + other
        end
        if i < ch.size
          res = res + ch[i].to_s
        end
        i += 1
      end
      res
    end
  end

  def insert(index : Int32, other : Char) : String
    insert(index, other.to_s)
  end

  def rchop : String
    return "" if empty?
    if single_byte_optimizable?
      byte_slice(0, bytesize - 1)
    else
      ch = chars
      res = ""
      i = 0
      while i < ch.size - 1
        res = res + ch[i].to_s
        i += 1
      end
      res
    end
  end

  def rchop(suffix : String) : String
    return self unless ends_with?(suffix)
    byte_slice(0, bytesize - suffix.bytesize)
  end

  def rchop(suffix : Char) : String
    rchop(suffix.to_s)
  end

  def hexbytes? : Bytes?
    return nil unless bytesize.even?
    b_len = bytesize // 2
    slice = Bytes.new(b_len)
    i = 0
    while i < b_len
      c1 = to_unsafe[i * 2]
      c2 = to_unsafe[i * 2 + 1]
      h1 = hex_val(c1)
      h2 = hex_val(c2)
      return nil if h1 < 0 || h2 < 0
      slice[i] = ((h1 << 4) | h2).to_u8
      i += 1
    end
    slice
  end

  def hexbytes : Bytes
    hexbytes? || raise "Invalid hex string: #{inspect}"
  end

  private def hex_val(b : UInt8) : Int32
    if b >= 48_u8 && b <= 57_u8
      (b - 48_u8).to_i
    elsif b >= 97_u8 && b <= 102_u8
      (b - 97_u8).to_i + 10
    elsif b >= 65_u8 && b <= 70_u8
      (b - 65_u8).to_i + 10
    else
      -1
    end
  end

  def to_hex : String
    String.new(bytesize * 2) do |buf|
      digits = "0123456789abcdef".to_unsafe
      i = 0
      while i < bytesize
        b = to_unsafe[i].to_i
        buf[i * 2] = digits[(b >> 4) & 0xF]
        buf[i * 2 + 1] = digits[b & 0xF]
        i += 1
      end
    end
  end

  def count(&block : Char -> Bool) : Int32
    c = 0
    each_char do |ch|
      c += 1 if yield ch
    end
    c
  end

  def delete(&block : Char -> Bool) : String
    res = ""
    each_char do |ch|
      res = res + ch.to_s unless yield ch
    end
    res
  end

  def squeeze(&block : Char -> Bool) : String
    return self if empty?
    res = ""
    has_prev = false
    prev = ' '
    each_char do |ch|
      if has_prev && prev == ch && (yield ch)
        # skip duplicate
      else
        res = res + ch.to_s
        prev = ch
        has_prev = true
      end
    end
    res
  end

  def underscore : String
    return "" if empty?
    res = ""
    last_is_separator = true
    each_char_with_index do |c, i|
      if c >= 'A' && c <= 'Z'
        if i > 0 && !last_is_separator
          res = res + "_"
        end
        res = res + (c.ord + 32).unsafe_chr.to_s
        last_is_separator = false
      elsif c == '-' || c == ' ' || c == '_'
        unless last_is_separator
          res = res + "_"
        end
        last_is_separator = true
      else
        res = res + c.to_s
        last_is_separator = false
      end
    end
    res
  end

  def camelcase(lower : Bool = false) : String
    return "" if empty?
    res = ""
    next_upper = !lower
    each_char do |c|
      if c == '_' || c == '-' || c == ' '
        next_upper = true
      elsif next_upper
        res = res + ((c >= 'a' && c <= 'z') ? (c.ord - 32).unsafe_chr.to_s : c.to_s)
        next_upper = false
      else
        res = res + c.to_s
      end
    end
    res
  end

  def titleize : String
    return "" if empty?
    res = ""
    next_upper = true
    each_char do |c|
      if c == '_' || c == '-' || c == ' '
        res = res + " "
        next_upper = true
      elsif next_upper
        res = res + ((c >= 'a' && c <= 'z') ? (c.ord - 32).unsafe_chr.to_s : c.to_s)
        next_upper = false
      else
        res = res + ((c >= 'A' && c <= 'Z') ? (c.ord + 32).unsafe_chr.to_s : c.to_s)
      end
    end
    res
  end

  def each_char_with_index(&block : Char, Int32 -> Nil) : Nil
    i = 0
    each_char do |c|
      yield c, i
      i += 1
    end
  end

  def each_codepoint(&block : Int32 -> Nil) : Nil
    each_char do |c|
      yield c.ord
    end
  end

  # `byte_slice` and `Array#join` with no separator are the prelude's, and
  # `each_char` and `Char#to_s` are too now that they decode and encode
  # UTF-8 there: this module writes what the prelude does not have (R-3).
end

class ::Array(T)
  def join(separator : Char) : String
    join(separator.to_s)
  end
end

class ::String::Builder
  getter bytesize : Int32
  getter capacity : Int32
  @buffer : Pointer(UInt8)
  @finished : Bool

  def initialize(initial_capacity : Int32 = 64)
    initial_capacity = 16 if initial_capacity < 16
    @capacity = initial_capacity
    @buffer = Pointer(UInt8).malloc(@capacity.to_u64 + 1)
    @bytesize = 0
    @finished = false
  end

  def self.build(capacity : Int32 = 64, &block : Builder -> Nil) : String
    builder = new(capacity)
    yield builder
    builder.to_s
  end

  def self.new(string : String) : Builder
    b = new(string.bytesize)
    b << string
    b
  end

  def <<(str : String) : self
    write_string(str.to_unsafe, str.bytesize)
    self
  end

  def <<(char : Char) : self
    cp = char.ord
    if cp < 0x80
      write_byte(cp.to_u8)
    elsif cp < 0x800
      write_byte((0xC0 | (cp >> 6)).to_u8)
      write_byte((0x80 | (cp & 0x3F)).to_u8)
    elsif cp < 0x10000
      write_byte((0xE0 | (cp >> 12)).to_u8)
      write_byte((0x80 | ((cp >> 6) & 0x3F)).to_u8)
      write_byte((0x80 | (cp & 0x3F)).to_u8)
    elsif cp <= 0x10FFFF
      write_byte((0xF0 | (cp >> 18)).to_u8)
      write_byte((0x80 | ((cp >> 12) & 0x3F)).to_u8)
      write_byte((0x80 | ((cp >> 6) & 0x3F)).to_u8)
      write_byte((0x80 | (cp & 0x3F)).to_u8)
    else
      write_byte('?'.ord.to_u8)
    end
    self
  end

  def <<(obj) : self
    self << obj.to_s
    self
  end

  def print(obj) : Nil
    self << obj
  end

  def puts(obj) : Nil
    self << obj
    self << '\n'
  end

  def puts : Nil
    self << '\n'
  end

  def write(slice : Bytes) : Nil
    write_string(slice.to_unsafe, slice.size)
  end

  def write_byte(byte : UInt8) : Nil
    ensure_capacity(@bytesize + 1)
    @buffer[@bytesize] = byte
    @bytesize += 1
  end

  def buffer : Pointer(UInt8)
    @buffer
  end

  def empty? : Bool
    @bytesize == 0
  end

  def chomp(byte : UInt8) : self
    if @bytesize > 0 && @buffer[@bytesize - 1] == byte
      @bytesize -= 1
      if byte == 10_u8 && @bytesize > 0 && @buffer[@bytesize - 1] == 13_u8
        @bytesize -= 1
      end
    end
    self
  end

  def back(amount : Int32) : Int32
    raise "Invalid back amount #{amount}" if amount < 0 || amount > @bytesize
    @bytesize -= amount
    amount
  end

  def to_s : String
    raise "String::Builder already finished" if @finished
    @finished = true
    String.new(@bytesize) do |buf|
      buf.copy_from(@buffer, @bytesize)
    end
  end

  private def write_string(ptr : Pointer(UInt8), len : Int32) : Nil
    return if len <= 0
    ensure_capacity(@bytesize + len)
    (@buffer + @bytesize).copy_from(ptr, len)
    @bytesize += len
  end

  private def ensure_capacity(needed : Int32) : Nil
    return if needed <= @capacity
    new_cap = @capacity * 2
    new_cap = needed if new_cap < needed
    new_buf = Pointer(UInt8).malloc(new_cap.to_u64 + 1)
    new_buf.copy_from(@buffer, @bytesize)
    @buffer = new_buf
    @capacity = new_cap
  end
end

class ::IyiIO
  def <<(obj) : self
    print(obj.to_s)
    self
  end
end
