module std/traits

pub trait Cmp
  abstract def cmp(other : self) : Int32

  def <(other : self) : Bool
    cmp(other) < 0
  end

  def <=(other : self) : Bool
    cmp(other) <= 0
  end

  def >(other : self) : Bool
    cmp(other) > 0
  end

  def >=(other : self) : Bool
    cmp(other) >= 0
  end

  def ==(other : self) : Bool
    cmp(other) == 0
  end

  def clamp(min : self, max : self) : self
    return max if self > max
    return min if self < min
    self
  end

  def clamp(range : Range) : self
    raise "Can't clamp an exclusive range" if range.exclusive?
    clamp(range.begin, range.end)
  end

  def between?(min : self, max : self) : Bool
    min <= self && self <= max
  end

  def lt(other : self) : Bool
    cmp(other) < 0
  end

  def gt(other : self) : Bool
    cmp(other) > 0
  end
end

pub trait Num : Cmp
  # Class-level requirements. `Enumerable#sum` and `#product` need an additive
  # and a multiplicative identity, and an identity belongs to the type, not to
  # any value of it — there is no element to ask when the collection is empty.
  abstract def self.zero : self
  abstract def self.one : self

  abstract def add(other : self) : self
  abstract def mul(other : self) : self
end

pub trait Hashable
  abstract def hash_key : Int32
end

impl Cmp for Int32
  # Compared, not subtracted: a difference is only a comparison while it
  # fits, and `2000000000.cmp(-2000000000)` left `Int32` and panicked with
  # "arithmetic overflow" - so every `Enumerable` method that reads `cmp`
  # (`sorted`, `min`, `max`, `includes?`, `clamp`) refused two numbers that
  # `<` answers for.
  def cmp(other : self) : Int32
    self < other ? -1 : (self == other ? 0 : 1)
  end
end

impl Num for Int32
  def self.zero : self
    0
  end

  def self.one : self
    1
  end

  def add(other : self) : self
    self + other
  end

  def mul(other : self) : self
    self * other
  end
end

impl Hashable for Int32
  def hash_key : Int32
    self
  end
end

impl Cmp for String
  # `<=>` is not a method the prelude's `String` has, so this was a call
  # nobody could make; `<` and `==` are what it does have.
  def cmp(other : self) : Int32
    self < other ? -1 : (self == other ? 0 : 1)
  end
end

impl Hashable for String
  def hash_key : Int32
    size
  end
end
