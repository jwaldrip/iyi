# Standard URI library for iyi according to RFC 3986.
#
# Provides parsing, building, percent-encoding/decoding, parameter handling,
# normalization, and relative reference resolution (RFC 3986 Section 5).

module std/uri

import std/text

pub class Error < ::Exception
  def initialize(message : String? = nil, cause : Exception? = nil)
    super(message, cause)
  end
end

pub class SerializableError < Error
end

pub class Punycode
  private BASE         = 36
  private TMIN         = 1
  private TMAX         = 26
  private SKEW         = 38
  private DAMP         = 700
  private INITIAL_BIAS = 72
  private INITIAL_N    = 128
  private DELIMITER    = '-'
  private BASE36       = "abcdefghijklmnopqrstuvwxyz0123456789"

  private def self.adapt(delta : Int32, numpoints : Int32, firsttime : Bool) : Int32
    d = firsttime ? (delta // DAMP) : (delta // 2)
    d = d + (d // numpoints)
    k = 0
    while d > (((BASE - TMIN) * TMAX) // 2)
      d = d // (BASE - TMIN)
      k = k + BASE
    end
    k + (((BASE - TMIN + 1) * d) // (d + SKEW))
  end

  def self.encode(string : String) : String
    io = IO::Memory.new
    encode(string, io)
    io.to_s
  end

  def self.encode(string : String, io : IO) : Nil
    others = [] of Char
    string.each_char do |c|
      if c.ord < 128
        io << c
      else
        others.push(c)
      end
    end
    return if others.empty?
    others.sort!

    h = string.size - others.size + 1
    delta = 0
    n = INITIAL_N
    bias = INITIAL_BIAS
    firsttime = true
    prev : Char? = nil

    io << DELIMITER if h > 1

    others.each do |m|
      next if prev && m == prev
      prev = m

      delta = delta + (m.ord - n) * h
      n = m.ord + 1

      string.each_char do |c|
        if c < m
          delta = delta + 1
        elsif c == m
          q = delta
          k = BASE
          while true
            t = if k <= bias
                  TMIN
                elsif k >= bias + TMAX
                  TMAX
                else
                  k - bias
                end
            break if q < t
            b36_idx = t + ((q - t) % (BASE - t))
            io << BASE36[b36_idx]
            q = (q - t) // (BASE - t)
            k = k + BASE
          end
          io << BASE36[q]

          bias = adapt(delta, h, firsttime)
          delta = 0
          h = h + 1
          firsttime = false
        end
      end
      delta = delta + 1
    end
  end

  def self.decode(string : String) : String
    delim_idx = string.rindex(DELIMITER)
    output = [] of Char
    rest = string
    if delim_idx
      prefix = string[0, delim_idx]
      prefix.each_char { |c| output << c }
      rest = string[delim_idx + 1, string.bytesize - delim_idx - 1]
    end

    n = INITIAL_N
    bias = INITIAL_BIAS
    i = 0
    init = true
    w = 0
    oldi = 0
    k = 0

    rest.each_char do |c|
      if init
        w = 1
        oldi = i
        k = BASE
        init = false
      end

      ch_ord = c.ord
      digit = if ch_ord >= 97 && ch_ord <= 122 # 'a'..'z'
                ch_ord - 97
              elsif ch_ord >= 65 && ch_ord <= 90 # 'A'..'Z'
                ch_ord - 65
              elsif ch_ord >= 48 && ch_ord <= 57 # '0'..'9'
                ch_ord - 48 + 26
              else
                raise "Invalid input for Punycode: #{c}"
              end

      i = i + digit * w
      t = if k <= bias
            TMIN
          elsif k >= bias + TMAX
            TMAX
          else
            k - bias
          end

      if digit >= t
        w = w * (BASE - t)
        k = k + BASE
      else
        outsize = output.size + 1
        bias = adapt(i - oldi, outsize, oldi == 0)
        n = n + (i // outsize)
        i = i % outsize
        output.insert(i, n.chr)
        i = i + 1
        init = true
      end
    end

    chars_str = [] of String
    output.each { |c| chars_str << c.to_s }
    chars_str.join("")
  end

  def self.to_ascii(string : String) : String
    has_non_ascii = false
    string.each_char do |c|
      if c.ord > 127
        has_non_ascii = true
        break
      end
    end
    return string unless has_non_ascii

    parts = string.split('.')
    encoded_parts = [] of String
    parts.each do |part|
      part_non_ascii = false
      part.each_char do |c|
        if c.ord > 127
          part_non_ascii = true
          break
        end
      end
      if part_non_ascii
        encoded_parts << ("xn--" + encode(part))
      else
        encoded_parts << part
      end
    end
    encoded_parts.join(".")
  end
end

pub class ParamsBuilder
  @io : IO
  @space_to_plus : Bool
  @first : Bool

  def initialize(@io : IO, *, @space_to_plus : Bool = true)
    @first = true
  end

  def add(key : String, value : String?) : self
    @io << '&' unless @first
    @first = false
    URI.encode_www_form(key, @io, space_to_plus: @space_to_plus)
    @io << '='
    if value
      URI.encode_www_form(value, @io, space_to_plus: @space_to_plus)
    end
    self
  end

  def add(key : String, values : Array(String)) : self
    values.each { |v| add(key, v) }
    self
  end
end

# An ordered multi-value collection representing URI query parameters
# or application/x-www-form-urlencoded form data.
pub struct Params
  alias Builder = ::Std::Uri::ParamsBuilder

  @keys : Array(String)
  @values : Array(String)

  def initialize
    @keys = [] of String
    @values = [] of String
  end

  def initialize(keys : Array(String), values : Array(String))
    @keys = keys
    @values = values
  end

  def self.build(io : IO, *, space_to_plus : Bool = true, &block : Builder -> Nil) : Nil
    builder = Builder.new(io, space_to_plus: space_to_plus)
    yield builder
  end

  def self.build(*, space_to_plus : Bool = true, &block : Builder -> Nil) : String
    io = IO::Memory.new
    build(io, space_to_plus: space_to_plus, &block)
    io.to_s
  end

  def self.encode(io : IO, hash : Hash(String, String)) : Nil
    first = true
    hash.each do |k, v|
      io << '&' unless first
      first = false
      URI.encode_www_form(k, io, space_to_plus: true)
      io << '='
      URI.encode_www_form(v, io, space_to_plus: true)
    end
  end

  def self.encode(hash : Hash(String, String)) : String
    io = IO::Memory.new
    encode(io, hash)
    io.to_s
  end

  def empty? : Bool
    @keys.empty?
  end

  def size : Int32
    @keys.size
  end

  def has_key?(key : String) : Bool
    i = 0
    while i < @keys.size
      return true if @keys[i] == key
      i = i + 1
    end
    false
  end

  # Returns the first value for *key*, or raises if not found.
  def [](key : String) : String
    val = self[key]?
    if val
      val
    else
      raise "missing parameter key: " + key
    end
  end

  # Returns the first value for *key*, or nil if not found.
  def []?(key : String) : String?
    i = 0
    while i < @keys.size
      return @values[i] if @keys[i] == key
      i = i + 1
    end
    nil
  end

  # Returns all values associated with *key*.
  def fetch_all(key : String) : Array(String)
    result = [] of String
    i = 0
    while i < @keys.size
      if @keys[i] == key
        result << @values[i]
      end
      i = i + 1
    end
    result
  end

  def fetch(key : String, default : String) : String
    self[key]? || default
  end

  def fetch(key : String, &block : String -> String) : String
    val = self[key]?
    val ? val : yield(key)
  end

  # Appends a key-value pair, preserving duplicate keys.
  def add(key : String, value : String) : Nil
    @keys << key
    @values << value
  end

  # Sets the value for *key*, replacing all previous occurrences.
  def []=(key : String, value : String) : Nil
    new_keys = [] of String
    new_values = [] of String
    replaced = false
    i = 0
    while i < @keys.size
      if @keys[i] == key
        if !replaced
          new_keys << key
          new_values << value
          replaced = true
        end
      else
        new_keys << @keys[i]
        new_values << @values[i]
      end
      i = i + 1
    end
    if !replaced
      new_keys << key
      new_values << value
    end
    @keys = new_keys
    @values = new_values
  end

  def set_all(key : String, values : Array(String)) : Nil
    delete(key)
    values.each do |v|
      add(key, v)
    end
  end

  # Deletes all entries for *key*, returning the removed values or nil.
  def delete(key : String) : Array(String)?
    new_keys = [] of String
    new_values = [] of String
    removed = [] of String
    i = 0
    while i < @keys.size
      if @keys[i] == key
        removed << @values[i]
      else
        new_keys << @keys[i]
        new_values << @values[i]
      end
      i = i + 1
    end
    @keys = new_keys
    @values = new_values
    removed.empty? ? nil : removed
  end

  def delete_all(key : String) : Nil
    delete(key)
    nil
  end

  def clone : Params
    Params.new(@keys.dup, @values.dup)
  end

  def dup : Params
    Params.new(@keys.dup, @values.dup)
  end

  def merge(other : Params, replace : Bool = false) : Params
    res = clone
    res.merge_in_place(other, replace: replace)
    res
  end

  def merge_in_place(other : Params, replace : Bool = false) : self
    if replace
      other.each do |k, v|
        self[k] = v
      end
    else
      other.each do |k, v|
        add(k, v)
      end
    end
    self
  end

  def each(&block : (String, String) -> Nil) : Nil
    i = 0
    while i < @keys.size
      yield @keys[i], @values[i]
      i = i + 1
    end
  end

  def ==(other : Params) : Bool
    return false unless @keys.size == other.size
    i = 0
    while i < @keys.size
      return false unless @keys[i] == other.@keys[i] && @values[i] == other.@values[i]
      i = i + 1
    end
    true
  end

  def hash : UInt64
    h = 0_u64
    i = 0
    while i < @keys.size
      h = h ^ (@keys[i].hash * 31_u64 + @values[i].hash)
      i = i + 1
    end
    h
  end

  # Parses query string according to application/x-www-form-urlencoded rules.
  # Supports both '&' and ';' as parameter separators.
  def self.parse(query : String) : Params
    params = Params.new
    q = query.starts_with?('?') ? query[1, query.bytesize - 1] : query
    return params if q.empty?

    pairs = q.split('&')
    p_idx = 0
    while p_idx < pairs.size
      pair = pairs[p_idx]
      unless pair.empty?
        # Support semicolon separator as well
        sub_pairs = pair.split(';')
        sp_idx = 0
        while sp_idx < sub_pairs.size
          item = sub_pairs[sp_idx]
          unless item.empty?
            eq_idx = item.index('=')
            if eq_idx
              raw_k = item[0, eq_idx]
              raw_v = item[eq_idx + 1, item.bytesize - eq_idx - 1]
              params.add(URI.decode_www_form(raw_k), URI.decode_www_form(raw_v))
            else
              params.add(URI.decode_www_form(item), "")
            end
          end
          sp_idx = sp_idx + 1
        end
      end
      p_idx = p_idx + 1
    end
    params
  end

  def to_s : String
    to_s(space_to_plus: true)
  end

  def to_s(space_to_plus : Bool = true) : String
    parts = [] of String
    i = 0
    while i < @keys.size
      k_enc = URI.encode_www_form(@keys[i], space_to_plus: space_to_plus)
      v_enc = URI.encode_www_form(@values[i], space_to_plus: space_to_plus)
      parts << (k_enc + "=" + v_enc)
      i = i + 1
    end
    parts.join("&")
  end

  def to_s(io : IO, space_to_plus : Bool = true) : Nil
    str = to_s(space_to_plus: space_to_plus)
    io.write(str.to_unsafe, str.bytesize)
  end
end

pub class URI
  alias Error = ::Std::Uri::Error
  alias SerializableError = ::Std::Uri::SerializableError
  alias Punycode = ::Std::Uri::Punycode
  alias Params = ::Std::Uri::Params

  @@custom_ports : Hash(String, Int32) = Hash(String, Int32).new

  @scheme : String?
  @user : String?
  @password : String?
  @host : String?
  @port : Int32?
  @path : String
  @query : String?
  @fragment : String?
  property scheme : String?
  property user : String?
  property password : String?
  property port : Int32?
  property path : String
  property query : String?
  property fragment : String?

  def initialize(
    scheme : String? = nil,
    host : String? = nil,
    port : Int32? = nil,
    path : String = "",
    query : String? = nil,
    user : String? = nil,
    password : String? = nil,
    fragment : String? = nil,
  )
    @scheme = scheme
    @port = port
    @path = path
    @query = query
    @user = user
    @password = password
    @fragment = fragment
    self.host = host
  end

  def host : String?
    @host
  end

  def host=(h : String?) : Nil
    if h
      # Wrap IPv6 address in brackets if contains colon and not already wrapped
      if h.includes?(":") && !h.starts_with?('[')
        @host = "[" + h + "]"
      else
        @host = h
      end
    else
      @host = nil
    end
  end

  # Returns the host part unwrapping square brackets for IPv6 addresses.
  def hostname : String?
    h = @host
    h ? URI.unwrap_ipv6(h) : nil
  end

  def self.unwrap_ipv6(h : String) : String
    if h.starts_with?('[') && h.ends_with?("]") && h.bytesize >= 2
      h[1, h.bytesize - 2]
    else
      h
    end
  end

  def self.from_json_object_key?(key : String) : URI?
    URI.parse(key)
  end

  def self.set_default_port(scheme : String, port : Int32?) : Nil
    s = scheme.downcase
    if port
      @@custom_ports[s] = port
    else
      @@custom_ports.delete(s)
    end
  end

  def userinfo : String?
    u = @user
    return nil unless u
    p = @password
    p ? (u + ":" + p) : u
  end

  def userinfo=(info : String?) : Nil
    if info
      colon = info.index(':')
      if colon
        @user = info[0, colon]
        @password = info[colon + 1, info.bytesize - colon - 1]
      else
        @user = info
        @password = nil
      end
    else
      @user = nil
      @password = nil
    end
  end

  def absolute? : Bool
    !@scheme.nil?
  end

  def relative? : Bool
    @scheme.nil?
  end

  def opaque? : Bool
    !@scheme.nil? && @host.nil? && !@path.starts_with?('/')
  end

  def query_params : Params
    Params.parse(@query || "")
  end

  def query_params=(params : Params) : Nil
    @query = params.empty? ? nil : params.to_s
  end

  def update_query_params(&block : Params -> Nil) : Nil
    p = query_params
    yield p
    self.query_params = p
  end

  def authority : String?
    return nil unless @host || @user || @port

    parts = [] of String
    if u = @user
      u_enc = URI.encode_www_form(u)
      if p = @password
        p_enc = URI.encode_www_form(p)
        parts << (u_enc + ":" + p_enc + "@")
      else
        parts << (u_enc + "@")
      end
    end

    if h = @host
      parts << h
    end

    if prt = @port
      parts << (":" + prt.to_s)
    end

    parts.join("")
  end

  def authority(io : IO) : Nil
    if a = authority
      io.write(a.to_unsafe, a.bytesize)
    end
  end

  # RFC 7230 section 5.3: Request Target for HTTP requests
  def request_target : String
    p = @path.empty? ? "/" : @path
    q = @query
    q ? (p + "?" + q) : p
  end

  def ==(other : URI) : Bool
    @scheme == other.scheme &&
      @user == other.user &&
      @password == other.password &&
      @host == other.host &&
      @port == other.port &&
      @path == other.path &&
      @query == other.query &&
      @fragment == other.fragment
  end

  def hash : UInt64
    h = 0_u64
    if s = @scheme; h = h ^ s.hash; end
    if u = @user; h = h ^ (u.hash * 31_u64); end
    if p = @password; h = h ^ (p.hash * 37_u64); end
    if ho = @host; h = h ^ (ho.hash * 41_u64); end
    if pr = @port; h = h ^ (pr.to_u64 * 43_u64); end
    h = h ^ (@path.hash * 47_u64)
    if q = @query; h = h ^ (q.hash * 53_u64); end
    if f = @fragment; h = h ^ (f.hash * 59_u64); end
    h
  end

  def to_s : String
    parts = [] of String

    if s = @scheme
      parts << (s + ":")
    end

    auth = authority
    if auth
      parts << ("//" + auth)
    end

    parts << @path

    if q = @query
      parts << ("?" + q)
    end

    if f = @fragment
      parts << ("#" + f)
    end

    parts.join("")
  end

  def to_s(io : IO) : Nil
    str = to_s
    io.write(str.to_unsafe, str.bytesize)
  end

  def to_json : String
    "\"" + to_s + "\""
  end

  def to_yaml : String
    to_s
  end

  def dup : URI
    URI.new(
      @scheme,
      @host,
      @port,
      @path,
      @query,
      @user,
      @password,
      @fragment
    )
  end

  # =========================================================================
  # Percent-Encoding and Decoding (RFC 3986 Section 2)
  # =========================================================================

  # RFC 3986 section 2.3: Unreserved Characters
  # unreserved = ALPHA / DIGIT / "-" / "." / "_" / "~"
  def self.unreserved?(b : UInt8) : Bool
    (b >= 97_u8 && b <= 122_u8) ||  # a-z
      (b >= 65_u8 && b <= 90_u8) || # A-Z
      (b >= 48_u8 && b <= 57_u8) || # 0-9
      b == 45_u8 ||                 # -
      b == 46_u8 ||                 # .
      b == 95_u8 ||                 # _
      b == 126_u8                   # ~
  end

  # Gen-delims: ":" / "/" / "?" / "#" / "[" / "]" / "@"
  def self.gen_delim?(byte : UInt8) : Bool
    byte == 58_u8 ||   # :
      byte == 47_u8 || # /
      byte == 63_u8 || # ?
      byte == 35_u8 || # #
      byte == 91_u8 || # [
      byte == 93_u8 || # ]
      byte == 64_u8    # @
  end

  # Sub-delims: "!" / "$" / "&" / "'" / "(" / ")" / "*" / "+" / "," / ";" / "="
  def self.sub_delim?(byte : UInt8) : Bool
    byte == 33_u8 ||   # !
      byte == 36_u8 || # $
      byte == 38_u8 || # &
      byte == 39_u8 || # '
      byte == 40_u8 || # (
      byte == 41_u8 || # )
      byte == 42_u8 || # *
      byte == 43_u8 || # +
      byte == 44_u8 || # ,
      byte == 59_u8 || # ;
      byte == 61_u8    # =
  end

  def self.reserved?(byte : UInt8) : Bool
    gen_delim?(byte) || sub_delim?(byte)
  end

  private def self.hex_digit?(byte : UInt8) : Bool
    (byte >= 48_u8 && byte <= 57_u8) ||   # 0-9
      (byte >= 65_u8 && byte <= 70_u8) || # A-F
      (byte >= 97_u8 && byte <= 102_u8)   # a-f
  end

  # Characters permitted unencoded in a path segment (pchar = unreserved | sub-delims | ":" | "@")
  def self.pchar?(b : UInt8) : Bool
    unreserved?(b) ||
      b == 33_u8 || b == 36_u8 || b == 38_u8 || b == 39_u8 || # ! $ & '
      b == 40_u8 || b == 41_u8 || b == 42_u8 || b == 43_u8 || # ( ) * +
      b == 44_u8 || b == 59_u8 || b == 61_u8 ||              # , ; =
      b == 58_u8 || b == 64_u8                              # : @
  end

  # Characters permitted unencoded in a query or fragment (query = pchar | "/" | "?")
  def self.query_char?(b : UInt8) : Bool
    pchar?(b) || b == 47_u8 || b == 63_u8
  end

  private def self.hex_char(val : Int32) : UInt8
    val < 10 ? (48 + val).to_u8 : (65 + (val - 10)).to_u8
  end

  private def self.hex_value(b : UInt8) : Int32
    if b >= 48_u8 && b <= 57_u8
      b.to_i - 48
    elsif b >= 65_u8 && b <= 70_u8
      b.to_i - 65 + 10
    elsif b >= 97_u8 && b <= 102_u8
      b.to_i - 97 + 10
    else
      -1
    end
  end

  # Encodes a string according to RFC 3986 URI component rules.
  # Escapes everything except unreserved characters.
  def self.encode(str : String, space_to_plus : Bool = false) : String
    bytes = [] of UInt8
    raw = str.to_unsafe
    len = str.bytesize
    i = 0
    while i < len
      b = raw[i]
      if b == 32_u8 # space
        if space_to_plus
          bytes << 43_u8 # '+'
        else
          bytes << 37_u8 # '%'
          bytes << 50_u8 # '2'
          bytes << 48_u8 # '0'
        end
        i = i + 1
      elsif b == 37_u8 # '%'
        # Trap: check if already a valid percent escape (%XX)
        if i + 2 < len && hex_digit?(raw[i + 1]) && hex_digit?(raw[i + 2])
          bytes << 37_u8
          bytes << raw[i + 1]
          bytes << raw[i + 2]
          i = i + 3
        else
          # Not already encoded, encode % as %25
          bytes << 37_u8
          bytes << 50_u8 # '2'
          bytes << 53_u8 # '5'
          i = i + 1
        end
      elsif unreserved?(b) || reserved?(b)
        bytes << b
        i = i + 1
      else
        # Multi-byte UTF-8 or control character: encode each byte
        bytes << 37_u8
        high = (b.to_i >> 4) & 0xF
        low = b.to_i & 0xF
        bytes << hex_char(high)
        bytes << hex_char(low)
        i = i + 1
      end
    end

    String.new(bytes.size) do |buf|
      buf.copy_from(bytes.to_unsafe, bytes.size)
    end
  end

  def self.encode(str : String, io : IO, space_to_plus : Bool = false) : Nil
    s = encode(str, space_to_plus: space_to_plus)
    io.write(s.to_unsafe, s.bytesize)
  end

  # Encodes a URI path: preserves '/' and pchar, escapes other characters.
  # Traps:
  # - Must not double-encode existing valid percent escapes (%20 -> %20, not %2520).
  def self.encode_path(str : String) : String
    bytes = [] of UInt8
    raw = str.to_unsafe
    len = str.bytesize
    i = 0
    while i < len
      b = raw[i]
      if b == 47_u8 || pchar?(b) # '/' or pchar
        bytes << b
        i = i + 1
      elsif b == 37_u8 # '%' check for existing valid escape
        if i + 2 < len && hex_value(raw[i + 1]) >= 0 && hex_value(raw[i + 2]) >= 0
          bytes << 37_u8
          bytes << raw[i + 1]
          bytes << raw[i + 2]
          i = i + 3
        else
          bytes << 37_u8
          bytes << 50_u8
          bytes << 53_u8
          i = i + 1
        end
      else
        bytes << 37_u8
        high = (b.to_i >> 4) & 0xF
        low = b.to_i & 0xF
        bytes << hex_char(high)
        bytes << hex_char(low)
        i = i + 1
      end
    end

    String.new(bytes.size) do |buf|
      buf.copy_from(bytes.to_unsafe, bytes.size)
    end
  end

  def self.encode_path(io : IO, str : String) : Nil
    s = encode_path(str)
    io.write(s.to_unsafe, s.bytesize)
  end

  # Encodes a single path segment: preserves pchar but escapes '/'
  def self.encode_path_segment(str : String) : String
    bytes = [] of UInt8
    raw = str.to_unsafe
    len = str.bytesize
    i = 0
    while i < len
      b = raw[i]
      if b == 37_u8 # '%'
        if i + 2 < len && hex_value(raw[i + 1]) >= 0 && hex_value(raw[i + 2]) >= 0
          bytes << 37_u8
          bytes << raw[i + 1]
          bytes << raw[i + 2]
          i = i + 3
        else
          bytes << 37_u8
          bytes << 50_u8
          bytes << 53_u8
          i = i + 1
        end
      elsif unreserved?(b)
        bytes << b
        i = i + 1
      else
        bytes << 37_u8
        high = (b.to_i >> 4) & 0xF
        low = b.to_i & 0xF
        bytes << hex_char(high)
        bytes << hex_char(low)
        i = i + 1
      end
    end

    String.new(bytes.size) do |buf|
      buf.copy_from(bytes.to_unsafe, bytes.size)
    end
  end

  def self.encode_path_segment(io : IO, str : String) : Nil
    s = encode_path_segment(str)
    io.write(s.to_unsafe, s.bytesize)
  end

  def self.encode_www_form(str : String, space_to_plus : Bool = true) : String
    bytes = [] of UInt8
    raw = str.to_unsafe
    len = str.bytesize
    i = 0
    while i < len
      b = raw[i]
      if b == 32_u8 # space
        if space_to_plus
          bytes << 43_u8 # '+'
        else
          bytes << 37_u8
          bytes << 50_u8
          bytes << 48_u8
        end
        i = i + 1
      elsif unreserved?(b)
        bytes << b
        i = i + 1
      else
        bytes << 37_u8
        high = (b.to_i >> 4) & 0xF
        low = b.to_i & 0xF
        bytes << hex_char(high)
        bytes << hex_char(low)
        i = i + 1
      end
    end

    String.new(bytes.size) do |buf|
      buf.copy_from(bytes.to_unsafe, bytes.size)
    end
  end

  def self.encode_www_form(str : String, io : IO, space_to_plus : Bool = true) : Nil
    s = encode_www_form(str, space_to_plus: space_to_plus)
    io.write(s.to_unsafe, s.bytesize)
  end

  # Decodes percent-encoded string.
  # Traps:
  # - Must reject truncated % escape (raises exception)
  # - Must reject invalid hex digits following % (raises exception)
  # - Multi-byte UTF-8 bytes are decoded and reconstruct valid UTF-8 string.
  def self.decode?(str : String, plus_to_space : Bool = false) : String?
    bytes = [] of UInt8
    raw = str.to_unsafe
    len = str.bytesize
    i = 0
    while i < len
      b = raw[i]
      if b == 43_u8 && plus_to_space # '+'
        bytes << 32_u8
        i = i + 1
      elsif b == 37_u8 # '%'
        if i + 2 >= len
          return nil
        end
        h1 = hex_value(raw[i + 1])
        h2 = hex_value(raw[i + 2])
        if h1 < 0 || h2 < 0
          return nil
        end
        val = ((h1 << 4) | h2).to_u8
        bytes << val
        i = i + 3
      else
        bytes << b
        i = i + 1
      end
    end

    String.new(bytes.size) do |buf|
      buf.copy_from(bytes.to_unsafe, bytes.size)
    end
  end

  def self.decode_www_form?(str : String, plus_to_space : Bool = true) : String?
    decode?(str, plus_to_space: plus_to_space)
  end

  def self.decode(str : String, plus_to_space : Bool = false) : String
    res = decode?(str, plus_to_space: plus_to_space)
    if res
      res
    else
      raise "malformed percent escape"
    end
  end

  def self.decode(str : String, io : IO, plus_to_space : Bool = false) : Nil
    s = decode(str, plus_to_space: plus_to_space)
    io.write(s.to_unsafe, s.bytesize)
  end

  def self.decode_www_form(str : String, plus_to_space : Bool = true) : String
    decode(str, plus_to_space: plus_to_space)
  end

  def self.decode_www_form(str : String, io : IO, plus_to_space : Bool = true) : Nil
    s = decode_www_form(str, plus_to_space: plus_to_space)
    io.write(s.to_unsafe, s.bytesize)
  end

  # =========================================================================
  # RFC 3986 Section 3 & 4: URI Parsing
  # =========================================================================

  def self.parse(raw_url : String) : URI
    uri = URI.new
    s = raw_url.strip
    return uri if s.empty?

    raw = s.to_unsafe
    len = s.bytesize
    ptr = 0

    # Parse scheme if present: alpha *(alpha | digit | "+" | "-" | ".") ":"
    has_scheme = false
    if (raw[0] >= 97_u8 && raw[0] <= 122_u8) || (raw[0] >= 65_u8 && raw[0] <= 90_u8)
      colon = -1
      i = 1
      while i < len
        c = raw[i]
        if c == 58_u8 # ':'
          colon = i
          break
        elsif (c >= 97_u8 && c <= 122_u8) || (c >= 65_u8 && c <= 90_u8) ||
              (c >= 48_u8 && c <= 57_u8) || c == 43_u8 || c == 45_u8 || c == 46_u8
          i = i + 1
        else
          break
        end
      end

      if colon > 0
        uri.scheme = s[0, colon]
        ptr = colon + 1
        has_scheme = true
      end
    end

    # Parse authority if starts with "//"
    if ptr + 1 < len && raw[ptr] == 47_u8 && raw[ptr + 1] == 47_u8
      ptr = ptr + 2
      auth_start = ptr
      while ptr < len && raw[ptr] != 47_u8 && raw[ptr] != 63_u8 && raw[ptr] != 35_u8
        ptr = ptr + 1
      end
      auth_str = s[auth_start, ptr - auth_start]
      parse_authority(auth_str, uri)
    end

    # Parse path until '?' or '#' or end
    path_start = ptr
    while ptr < len && raw[ptr] != 63_u8 && raw[ptr] != 35_u8
      ptr = ptr + 1
    end
    uri.path = s[path_start, ptr - path_start]

    # Parse query if '?' present
    if ptr < len && raw[ptr] == 63_u8
      ptr = ptr + 1
      query_start = ptr
      while ptr < len && raw[ptr] != 35_u8
        ptr = ptr + 1
      end
      uri.query = s[query_start, ptr - query_start]
    end

    # Parse fragment if '#' present
    if ptr < len && raw[ptr] == 35_u8
      ptr = ptr + 1
      uri.fragment = s[ptr, len - ptr]
    end

    uri
  end

  private def self.parse_authority(auth : String, uri : URI) : Nil
    return if auth.empty?

    # Check for userinfo before '@'
    at_idx = auth.rindex('@')
    host_port = ""
    if at_idx
      userinfo = auth[0, at_idx]
      colon = userinfo.index(':')
      if colon
        uri.user = URI.decode_www_form(userinfo[0, colon])
        uri.password = URI.decode_www_form(userinfo[colon + 1, userinfo.bytesize - colon - 1])
      else
        uri.user = URI.decode_www_form(userinfo)
      end
      host_port = auth[at_idx + 1, auth.bytesize - at_idx - 1]
    else
      host_port = auth
    end

    # Check for IPv6 host enclosed in brackets "[...]"
    if host_port.starts_with?('[')
      close_bracket = host_port.index(']')
      if close_bracket
        uri.host = host_port[0, close_bracket + 1]
        after_bracket = host_port[close_bracket + 1, host_port.bytesize - close_bracket - 1]
        if after_bracket.starts_with?(':')
          port_str = after_bracket[1, after_bracket.bytesize - 1]
          port_val = port_str.to_i?
          uri.port = port_val if port_val
        end
        return
      end
    end

    # Non-IPv6 host: check for port after last ':'
    colon = host_port.rindex(':')
    if colon
      uri.host = host_port[0, colon]
      port_str = host_port[colon + 1, host_port.bytesize - colon - 1]
      port_val = port_str.to_i?
      uri.port = port_val if port_val
    else
      uri.host = host_port
    end
  end

  # =========================================================================
  # RFC 3986 Section 5.2.4: Remove Dot Segments
  # =========================================================================

  def self.remove_dot_segments(path : String) : String
    return "" if path.empty?

    input = path
    output = [] of String

    while !input.empty?
      # A: If the input buffer begins with a prefix of "../" or "./",
      # then remove that prefix from the input buffer; otherwise,
      if input.starts_with?("../")
        input = input[3, input.bytesize - 3]
      elsif input.starts_with?("./")
        input = input[2, input.bytesize - 2]
      # B: if the input buffer begins with a prefix of "/./" or "/.",
      # where "." is a complete path segment, then replace that
      # prefix with "/" in the input buffer; otherwise,
      elsif input.starts_with?("/./")
        input = "/" + input[3, input.bytesize - 3]
      elsif input == "/."
        input = "/"
      # C: if the input buffer begins with a prefix of "/../" or "/..",
      # where ".." is a complete path segment, then replace that
      # prefix with "/" in the input buffer and remove the last
      # segment and its preceding "/" (if any) from the output buffer;
      elsif input.starts_with?("/../")
        input = "/" + input[4, input.bytesize - 4]
        output.pop unless output.empty?
      elsif input == "/.."
        input = "/"
        output.pop unless output.empty?
      # D: if the input buffer consists only of "." or "..",
      # then remove that from the input buffer; otherwise,
      elsif input == "." || input == ".."
        input = ""
      # E: move the first path segment in the input buffer to the end of
      # the output buffer, including the initial "/" character (if any)
      # and any subsequent characters up to, but not including, the next
      # "/" character or the end of the input buffer.
      else
        seg_end = -1
        raw = input.to_unsafe
        len = input.bytesize
        i = 0
        if raw[0] == 47_u8 # starts with '/'
          i = 1
        end
        while i < len
          if raw[i] == 47_u8
            seg_end = i
            break
          end
          i = i + 1
        end

        if seg_end > 0
          output << input[0, seg_end]
          input = input[seg_end, len - seg_end]
        else
          output << input
          input = ""
        end
      end
    end

    res = output.join("")
    res
  end

  # =========================================================================
  # RFC 3986 Section 5: Reference Resolution
  # =========================================================================

  def resolve(ref : URI | String) : URI
    r = ref.is_a?(String) ? URI.parse(ref) : ref
    # RFC 3986 Section 5.2.2: Transform References
    t = URI.new

    if r.scheme
      t.scheme = r.scheme
      t.host = r.host
      t.port = r.port
      t.user = r.user
      t.password = r.password
      t.path = URI.remove_dot_segments(r.path)
      t.query = r.query
    else
      t.scheme = @scheme

      if r.host || r.user || r.port
        t.host = r.host
        t.port = r.port
        t.user = r.user
        t.password = r.password
        t.path = URI.remove_dot_segments(r.path)
        t.query = r.query
      else
        t.host = @host
        t.port = @port
        t.user = @user
        t.password = @password

        if r.path.empty?
          t.path = @path
          if r.query
            t.query = r.query
          else
            t.query = @query
          end
        else
          if r.path.starts_with?('/')
            t.path = URI.remove_dot_segments(r.path)
          else
            t.path = URI.remove_dot_segments(merge_paths(@path, r.path))
          end
          t.query = r.query
        end
      end
    end

    t.fragment = r.fragment
    t
  end

  # RFC 3986 Section 5.2.3: Merge Paths
  private def merge_paths(base_path : String, ref_path : String) : String
    has_auth = !@host.nil? || !@user.nil? || !@port.nil?
    if has_auth && base_path.empty?
      "/" + ref_path
    else
      slash_idx = base_path.rindex('/')
      if slash_idx
        base_path[0, slash_idx + 1] + ref_path
      else
        ref_path
      end
    end
  end

  # Relative to base URI
  def relativize(other : URI | String) : URI
    target = other.is_a?(String) ? URI.parse(other) : other
    return target if @scheme != target.scheme || @host != target.host || @port != target.port
    rel = URI.new
    rel.path = target.path
    rel.query = target.query
    rel.fragment = target.fragment
    rel
  end

  # =========================================================================
  # Normalization
  # =========================================================================

  def self.default_port(scheme : String) : Int32?
    s = scheme.downcase
    custom = @@custom_ports[s]?
    return custom if custom
    if s == "http" || s == "ws"
      80
    elsif s == "https" || s == "wss"
      443
    elsif s == "ftp"
      21
    elsif s == "ssh"
      22
    elsif s == "telnet"
      23
    else
      nil
    end
  end

  def normalize : URI
    dup.normalize_in_place
  end

  def normalize_in_place : URI
    if s = @scheme
      @scheme = s.downcase
    end
    if h = @host
      @host = h.downcase
    end

    if s = @scheme
      if prt = @port
        def_p = URI.default_port(s)
        if def_p && prt == def_p
          @port = nil
        end
      end
    end

    @path = URI.remove_dot_segments(@path)
    self
  end
end
